(* распознавание ключевого слова: индекс или 0 *)
function detect(var s: carty; ln: integer): integer;
var
  i, j, res: integer;
  ok: boolean;
begin
  res := 0;
  i := 1;
  while (i <= DTKW) and (res = 0) do begin
    if (ln > 0) and (ln >= kwl[i]) then begin
      ok := true;
      j := 1;
      while (j <= kwl[i]) and ok do begin
        if s[j] <> kw[i][j] then
          ok := false;
        j := j + 1
      end;
      if ok then
        res := i
    end;
    i := i + 1
  end;
  detect := res
end;

(* новый узел схемы с привязкой к дереву по отступам *)
procedure newnode(k: integer; var s: carty; sl, ind, ln: integer);
var
  i: integer;
  done: boolean;
begin
  if ncnt >= NDMAX then
    ncnt := NDMAX;
  ncnt := ncnt + 1;
  nkind[ncnt] := k;
  ntl[ncnt] := ln;
  for i := 1 to ln do ntext[ncnt][i] := s[sl + i - 1];
  nkid[ncnt] := 0;
  nbro[ncnt] := 0;
  nbr[ncnt] := 0;
  nxt[ncnt] := 0;
  done := false;
  while (stn > 0) and (not done) do begin
    if sti[stn] >= ind then
      stn := stn - 1
    else
      done := true
  end;
  if stn = 0 then begin
    if nroot = 0 then
      nroot := ncnt
    else
      nbro[last0] := ncnt;
    last0 := ncnt
  end else begin
    if nkid[st[stn]] = 0 then
      nkid[st[stn]] := ncnt
    else
      nbro[stl[stn]] := ncnt;
    stl[stn] := ncnt
  end;
  (* контейнеры: ЕСЛИ ЦИКЛ ВЫБОР ВАРИАНТ ТО ИНАЧЕ ДЛЯ *)
  if (k = 5) or (k = 6) or (k = 7) or (k = 8) or
     (k = 11) or (k = 12) or (k = 15) then begin
    stn := stn + 1;
    st[stn] := ncnt;
    sti[stn] := ind
  end
end;

(* длина значимой части карты *)
function linelen: integer;
var
  i: integer;
begin
  linelen := 0;
  for i := 1 to CW do
    if card[i] <> ' ' then
      linelen := i
end;

(* число ведущих пробелов карты.
   Результат функции нельзя читать в выражениях (ошибка
   компилятора 15.1 - порча стека), счёт в локальной j *)
function indent: integer;
var
  j: integer;
begin
  j := 0;
  while (j < CW) and (card[j + 1] = ' ') do
    j := j + 1;
  indent := j
end;

(* пропуск пробелов и двоеточия после ключевого слова *)
procedure skiphead(var p: integer; ln: integer; var s: carty);
begin
  while (p <= ln) and (s[p] = ' ') do
    p := p + 1;
  if (p <= ln) and (s[p] = ':') then begin
    p := p + 1;
    while (p <= ln) and (s[p] = ' ') do
      p := p + 1
  end
end;

(* разбор текущей карты исходника (как parse в drakon.pas, но
   одна карта: карты подаёт главный цикл блока *DRK) *)
procedure drkcard;
var
  i, ind, k, p, ln, tl: integer;
  txt: carty;
begin
  ind := indent;
  ln := linelen;
  if (ln > 0) and (card[ind + 1] <> '*') then begin
    for i := 1 to ln do txt[i] := card[ind + i];
    k := detect(txt, ln);
    if k > 0 then begin
      p := kwl[k] + 1;
      skiphead(p, ln, txt);
      tl := 0;
      for i := p to ln do
        if txt[i] <> ' ' then
          tl := i - p + 1;
      newnode(k, txt, p, ind, tl)
    end else begin
      (* неизвестное слово: текст после первого слова *)
      p := 1;
      while (p <= ln) and (txt[p] <> ' ') and
            (txt[p] <> ':') do
        p := p + 1;
      skiphead(p, ln, txt);
      tl := 0;
      for i := p to ln do
        if txt[i] <> ' ' then
          tl := i - p + 1;
      newnode(0, txt, p, ind, tl)
    end
  end
end;

(* ---------------- иконы ---------------- *)

(* вид иконы по рис. 4 книги Паронджанова:
   0 действие (прямоугольник), 1 заголовок (полуовал), 2 имя ветки
   (щит), 3 вопрос (шестиугольник), 4 конец (полуовал), 5 адрес
   (домик), 6 выбор (параллелограмм), 7 вариант (прямоугольник
   с клином), 8 комментарий (двойная рамка с полуовалом), 9 полка,
   10 формальные параметры, 11 начало цикла ДЛЯ, 12 конец цикла ДЛЯ,
   13 вывод, 14 ввод, 15 пауза, 16 период, 17 пуск таймера,
   18 синхронизатор, 19 параллельный процесс, 20 правый
   комментарий, 21 левый комментарий, 22 петля цикла, 23 петля
   силуэта (гребёнка), 24 вставка *)
function kindof(n: integer): integer;
var
  k, res: integer;
begin
  k := nkind[n];
  res := 0;
  if k = 1 then
    res := 1
  else if k = 2 then
    res := 2
  else if (k = 5) or (k = 6) then
    res := 3
  else if k = 10 then
    res := 4
  else if k = 9 then
    res := 5
  else if k = 7 then
    res := 6
  else if k = 8 then
    res := 7
  else if k = 4 then
    res := 8
  else if k = 13 then
    res := 9
  else if k = 14 then
    res := 10
  else if k = 15 then
    res := 11
  else if k = 16 then
    res := 12
  else if k = 17 then
    res := 13
  else if k = 18 then
    res := 14
  else if k = 19 then
    res := 15
  else if k = 20 then
    res := 16
  else if k = 21 then
    res := 17
  else if k = 22 then
    res := 18
  else if k = 23 then
    res := 19
  else if k = 24 then
    res := 20
  else if k = 25 then
    res := 21
  else if k = 26 then
    res := 22
  else if k = 27 then
    res := 23
  else if k = 28 then
    res := 24;
  kindof := res
end;

procedure put(x, y: integer; c: char);
begin
  if (y >= 1) and (y <= DRMAX) and (x >= 1) and (x <= DCMAX) then
    dmem.pic[y][x] := c
end;

(* текст в поле ширины fw с позиции x, строка r; центрирование
   как в эталоне: лишний пробел при нечётных поле и остатке
   ставится слева *)
procedure ctext(x, fw, r: integer; var t: p80; tl: integer);
var
  i, left: integer;
begin
  left := (fw - tl) div 2;
  if (odd(fw - tl)) and (odd(fw)) then
    left := left + 1;
  for i := 1 to tl do
    put(x + left + i - 1, r, t[i])
end;

procedure dash(x, y, ln: integer; c: char);
var
  i: integer;
begin
  for i := 1 to ln do
    put(x + i - 1, y, c)
end;

(* горизонтальная грань: угол, тире, угол *)
procedure hrun(x, y, ln: integer; lc, rc: char);
begin
  put(x, y, lc);
  dash(x + 1, y, ln - 2, '-');
  put(x + ln - 1, y, rc)
end;

(* разложить подпись gtxt длиной tl на строки wtx/wln;
   ширина поля - wwd *)
procedure wraptl(tl: integer);
var
  i, j, cur: integer;
  nl: boolean;
begin
  nwl := 0;
  cur := 0;
  for i := 1 to nwd do begin
    (* НЕ писать «(cur = 0) or (wln[cur] + ... > wwd)»: компилятор 15.1
       не гарантирует короткое замыкание, при cur = 0 читается и
       пишется wln[0]/wtx[0] вне массива - портятся соседние
       переменные, слова подписи теряются *)
    nl := true;
    if cur > 0 then
      if wln[cur] + 1 + wwp[i] <= wwd then
        nl := false;
    if nl then begin
      cur := cur + 1;
      wln[cur] := 0
    end else begin
      wln[cur] := wln[cur] + 1;
      wtx[cur][wln[cur]] := ' '
    end;
    for j := 1 to wwp[i] do begin
      wtx[cur][wln[cur] + j] := gtxt[wsp[i] + j - 1];
    end;
    wln[cur] := wln[cur] + wwp[i]
  end;
  nwl := cur;
  if nwl = 0 then begin
    nwl := 1;
    wln[1] := 0
  end
end;

(* слова подписи: wsp/wwp, самое длинное слово -> wwd *)
procedure splitw(tl: integer);
var
  i: integer;
begin
  nwd := 0;
  i := 1;
  while i <= tl do begin
    while (i <= tl) and (gtxt[i] = ' ') do
      i := i + 1;
    if i <= tl then begin
      nwd := nwd + 1;
      wsp[nwd] := i;
      while (i <= tl) and (gtxt[i] <> ' ') do
        i := i + 1;
      wwp[nwd] := i - wsp[nwd];
      if wwp[nwd] > wwd then
        wwd := wwp[nwd]
    end
  end
end;

(* подпись узла в gtxt, разбор на слова, ширина поля wwd:
   АДАПТИВНО к количеству текста - короткая подпись даёт узкую
   икону (поле от 5 знаков), подпись до WMAXLINE держится в одну
   строку, длинная делится на равные доли; поле всегда нечётное:
   у каждой иконы одна средняя колонка, вершины клиньев и острия
   прилегают к оси шампура ровно *)
procedure settext(n: integer);
var
  i, tl, L, tg: integer;
begin
  tl := ntl[n];
  for i := 1 to tl do gtxt[i] := ntext[n][i];
  wwd := MINW;
  splitw(tl);
  if tl > WMAXLINE then begin
    (* длинная подпись: строки равных долей *)
    L := (tl + WMAXLINE - 1) div WMAXLINE;
    tg := (tl + L - 1) div L;
    if tg > wwd then
      wwd := tg
  end else if tl > wwd then
    wwd := tl;
  if (wwd mod 2) = 0 then
    wwd := wwd + 1
end;

(* подогнать поле под подпись: слова могут не упаковаться в
   намеченные строки - расширять поле, пока перенос не уложится *)
procedure fittext(n: integer);
var
  tl, L: integer;
begin
  settext(n);
  tl := ntl[n];
  L := 1;
  if tl > WMAXLINE then
    L := (tl + WMAXLINE - 1) div WMAXLINE;
  wraptl(tl);
  while (nwl > L) and (wwd < WMAXLINE + 12) do begin
    wwd := wwd + 2;
    wraptl(tl)
  end
end;

(* полная ширина иконы узла n *)
function iconw(n: integer): integer;
var
  k, tl, wd: integer;
begin
  k := kindof(n);
  tl := ntl[n];
  if k = 4 then begin
    (* конец: маленький полуовал *)
    wd := tl + 2;
    if wd < 7 then
      wd := 7;
    if (wd mod 2) = 0 then
      wd := wd + 1;
    iconw := wd
  end else if k = 22 then
    iconw := 18
  else if k = 23 then
    iconw := 30
  else begin
    fittext(n);
    if k = 3 then
      wd := wwd + 4
    else if k = 6 then
      (* параллелограмм: сдвиг верха равен числу строк + 1 *)
      wd := wwd + 3 + nwl
    else if (k = 8) or (k = 17) or (k = 21) or (k = 24) then
      wd := wwd + 4
    else if (k = 10) or (k = 16) or (k = 18) then
      wd := wwd + 6
    else if (k = 13) or (k = 14) then
      wd := wwd + 10
    else if k = 19 then
      wd := wwd + 12
    else if k = 20 then
      wd := wwd + 3
    else
      wd := wwd + 2;
    iconw := wd
  end
end;

(* формы икон: ДЕЙСТВИЕ, ЗАГОЛОВОК, ВОПРОС, КОНЕЦ *)
procedure picon1(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 0 then begin
    (* ДЕЙСТВИЕ: прямоугольник *)
    ih[n] := nwl + 2;
    hrun(x, y, w, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, wwd, r, wtx[i], wln[i]);
      put(x + w - 1, r, '|')
    end;
    hrun(x, y + nwl + 1, w, '+', '+')
  end else if k = 1 then begin
    (* ЗАГОЛОВОК: полуовал И1 *)
    ih[n] := nwl + 2;
    hrun(x, y, w, '.', '.');
    for i := 1 to nwl do begin
      r := y + i;
      put(x, r, '(');
      ctext(x + 1, wwd, r, wtx[i], wln[i]);
      put(x + w - 1, r, ')')
    end;
    hrun(x, y + nwl + 1, w, '''', '''')
  end else if k = 3 then begin
    (* ВОПРОС: шестиугольник И4, валентная точка справа -
       линия плеча примыкает к стене на середине высоты *)
    ih[n] := nwl + 4;
    hrun(x + 2, y, wwd, '+', '+');
    put(x + 1, y + 1, '/');
    put(x + w - 2, y + 1, '(');
    for i := 1 to nwl do begin
      r := y + 1 + i;
      put(x, r, '|');
      ctext(x + 1, wwd + 2, r, wtx[i], wln[i]);
      put(x + w - 1, r, '|')
    end;
    put(x + 1, y + nwl + 2, '(');
    put(x + w - 2, y + nwl + 2, ')');
    hrun(x + 2, y + nwl + 3, wwd, '+', '+')
  end else if k = 4 then begin
    (* КОНЕЦ: малый полуовал И2 *)
    ih[n] := 3;
    hrun(x, y, w, '.', '.');
    put(x, y + 1, '(');
    ctext(x + 1, w - 2, y + 1, wtx[1], wln[1]);
    put(x + w - 1, y + 1, ')');
    hrun(x, y + 2, w, '''', '''')
  end
end;

(* формы икон: ВЕТКА, ВЫБОР, ВАРИАНТ *)
procedure picon2(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 2 then begin
    (* ИМЯ ВЕТКИ: щит И7 - стены сходятся к нижней вершине *)
    ih[n] := nwl + 3;
    hrun(x, y, w, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, wwd, r, wtx[i], wln[i]);
      put(x + w - 1, r, '|')
    end;
    put(x + 1, y + nwl + 1, '(');
    put(x + w - 2, y + nwl + 1, ')');
    put(x + 2, y + nwl + 2, '(');
    put(x + w - 3, y + nwl + 2, ')');
    dash(x + 3, y + nwl + 2, w - 6, '_')
  end else if k = 6 then begin
    (* ВЫБОР: параллелограмм И5, верх сдвинут вправо *)
    s := nwl + 1;
    ih[n] := nwl + 2;
    hrun(x + s, y, wwd + 2, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      f := s - i;
      put(x + f, r, '/');
      ctext(x + f + 1, wwd, r, wtx[i], wln[i]);
      put(x + f + wwd + 1, r, '/')
    end;
    hrun(x, y + nwl + 1, wwd + 2, '+', '+')
  end else if k = 7 then begin
    (* ВАРИАНТ: прямоугольник с клином И6 *)
    ih[n] := nwl + 4;
    hrun(x, y, w, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, wwd, r, wtx[i], wln[i]);
      put(x + w - 1, r, '|')
    end;
    hrun(x, y + nwl + 1, w, '+', '+');
    put(x + 1, y + nwl + 2, '(');
    put(x + w - 2, y + nwl + 2, ')');
    put(x + 2, y + nwl + 3, '(');
    put(x + w - 3, y + nwl + 3, ')');
    dash(x + 3, y + nwl + 3, w - 6, '_')
  end
end;

(* формы икон: АДРЕС, КОММЕНТАРИЙ, ПОЛКА *)
procedure picon3(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 5 then begin
    (* АДРЕС: домик И8 с треугольной крышей *)
    m := w div 2;
    ih[n] := nwl + 4;
    put(x + m - 1, y, '/');
    put(x + m, y, '(');
    put(x + m - 2, y + 1, '/');
    put(x + m + 1, y + 1, '(');
    hrun(x, y + 2, w, '+', '+');
    for i := 1 to nwl do begin
      r := y + 2 + i;
      put(x, r, '|');
      ctext(x + 1, wwd, r, wtx[i], wln[i]);
      put(x + w - 1, r, '|')
    end;
    hrun(x, y + nwl + 3, w, '+', '+')
  end else if k = 8 then begin
    (* КОММЕНТАРИЙ И21: двойная рамка, внутри полуовал *)
    ih[n] := nwl + 4;
    hrun(x, y, w, '+', '+');
    put(x, y + 1, '|');
    put(x + 1, y + 1, '.');
    dash(x + 2, y + 1, wwd, '-');
    put(x + wwd + 2, y + 1, '.');
    put(x + w - 1, y + 1, '|');
    for i := 1 to nwl do begin
      r := y + 1 + i;
      put(x, r, '|');
      put(x + 1, r, '(');
      ctext(x + 2, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 2, r, ')');
      put(x + w - 1, r, '|')
    end;
    put(x, y + nwl + 2, '|');
    put(x + 1, y + nwl + 2, '''');
    dash(x + 2, y + nwl + 2, wwd, '-');
    put(x + wwd + 2, y + nwl + 2, '''');
    put(x + w - 1, y + nwl + 2, '|');
    hrun(x, y + nwl + 3, w, '+', '+')
  end else if k = 10 then begin
    (* ФОРМАЛЬНЫЕ ПАРАМЕТРЫ И11: прямоугольник, точка слева *)
    ih[n] := nwl + 2;
    hrun(x + 2, y, wwd + 2, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x + 2, r, '|');
      ctext(x + 3, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 3, r, '|')
    end;
    hrun(x + 2, y + nwl + 1, wwd + 2, '+', '+');
    r := y + (nwl + 2) div 2;
    put(x, r, '-');
    put(x + 1, r, '-')
  end else if k = 9 then begin
    (* ПОЛКА И10: прямоугольник с горизонтальной серединой *)
    ih[n] := nwl + 4;
    hrun(x, y, w, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, wwd, r, wtx[i], wln[i]);
      put(x + w - 1, r, '|')
    end;
    hrun(x, y + nwl + 1, w, '+', '+');
    put(x, y + nwl + 2, '|');
    put(x + w - 1, y + nwl + 2, '|');
    hrun(x, y + nwl + 3, w, '+', '+')
  end
end;

(* формы икон: ЦИКЛ ДЛЯ, КДЛ, ВЫВОД, ВВОД *)
procedure picon4(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 11 then begin
    (* НАЧАЛО ЦИКЛА ДЛЯ И12: срезаны верхние угла *)
    ih[n] := nwl + 2;
    hrun(x + 1, y, wwd, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      if i = 1 then begin
        put(x, r, '/');
        put(x + w - 1, r, '(')
      end else begin
        put(x, r, '|');
        put(x + w - 1, r, '|')
      end;
      ctext(x + 1, wwd, r, wtx[i], wln[i])
    end;
    hrun(x, y + nwl + 1, w, '+', '+')
  end else if k = 12 then begin
    (* КОНЕЦ ЦИКЛА ДЛЯ И13: срезаны нижние угла *)
    ih[n] := nwl + 2;
    hrun(x, y, w, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      if i = nwl then begin
        put(x, r, '(');
        put(x + w - 1, r, ')')
      end else begin
        put(x, r, '|');
        put(x + w - 1, r, '|')
      end;
      ctext(x + 1, wwd, r, wtx[i], wln[i])
    end;
    hrun(x + 1, y + nwl + 1, wwd, '+', '+')
  end else if k = 13 then begin
    (* ВЫВОД И14: прямоугольник, справа полая стрелка наружу *)
    ih[n] := nwl + 2;
    hrun(x + 4, y, wwd + 2, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x + 4, r, '|');
      ctext(x + 5, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 5, r, '|')
    end;
    hrun(x + 4, y + nwl + 1, wwd + 2, '+', '+');
    r := y + (nwl + 2) div 2;
    dash(x + wwd + 6, r, 3, '=');
    put(x + wwd + 9, r, '>')
  end else if k = 14 then begin
    (* ВВОД И15: прямоугольник, справа стрелка внутрь *)
    ih[n] := nwl + 2;
    hrun(x + 4, y, wwd + 2, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x + 4, r, '|');
      ctext(x + 5, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 5, r, '|')
    end;
    hrun(x + 4, y + nwl + 1, wwd + 2, '+', '+');
    r := y + (nwl + 2) div 2;
    put(x + wwd + 6, r, '<');
    dash(x + wwd + 7, r, 3, '=')
  end
end;

(* формы икон: ПАУЗА, ПЕРИОД, ПУСК, СИНХРОНИЗАТОР *)
procedure picon5(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 15 then begin
    (* ПАУЗА И16: трапеция, сужающаяся вниз *)
    ih[n] := nwl + 3;
    hrun(x, y, w, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, wwd, r, wtx[i], wln[i]);
      put(x + w - 1, r, '|')
    end;
    put(x + 1, y + nwl + 1, '(');
    put(x + w - 2, y + nwl + 1, ')');
    hrun(x + 2, y + nwl + 2, wwd - 2, '+', '+')
  end else if k = 16 then begin
    (* ПЕРИОД И17: трапеция вниз, валентные точки по бокам *)
    ih[n] := nwl + 3;
    hrun(x + 2, y, wwd + 2, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x + 2, r, '|');
      ctext(x + 3, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 3, r, '|')
    end;
    put(x + 3, y + nwl + 1, '(');
    put(x + wwd + 2, y + nwl + 1, ')');
    hrun(x + 4, y + nwl + 2, wwd - 2, '+', '+');
    r := y + (nwl + 3) div 2;
    put(x, r, '-');
    put(x + 1, r, '-');
    put(x + wwd + 4, r, '-');
    put(x + wwd + 5, r, '-')
  end else if k = 17 then begin
    (* ПУСК ТАЙМЕРА И18: трапеция вниз с двойными стенками *)
    ih[n] := nwl + 3;
    hrun(x, y, w, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x, r, '|');
      put(x + 1, r, '|');
      ctext(x + 2, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 2, r, '|');
      put(x + wwd + 3, r, '|')
    end;
    put(x + 1, y + nwl + 1, '(');
    put(x + 2, y + nwl + 1, '(');
    put(x + wwd + 1, y + nwl + 1, ')');
    put(x + wwd + 2, y + nwl + 1, ')');
    hrun(x + 3, y + nwl + 2, wwd - 2, '+', '+')
  end else if k = 18 then begin
    (* СИНХРОНИЗАТОР И19: трапеция вниз, точка справа *)
    ih[n] := nwl + 3;
    hrun(x + 2, y, wwd + 2, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x + 2, r, '|');
      ctext(x + 3, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 3, r, '|')
    end;
    put(x + 3, y + nwl + 1, '(');
    put(x + wwd + 2, y + nwl + 1, ')');
    hrun(x + 4, y + nwl + 2, wwd - 2, '+', '+');
    r := y + (nwl + 3) div 2;
    put(x + wwd + 4, r, '-');
    put(x + wwd + 5, r, '-')
  end
end;

(* формы икон: ПАРАЛПРОЦЕСС, БОКОВЫЕ КОММЕНТАРИИ, ПЕТЛИ, ВСТАВКА *)
procedure picon6(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 19 then begin
    (* ПАРАЛЛЕЛЬНЫЙ ПРОЦЕСС И20: прямоугольник со сдвинутым
       вверх-вправо вторым *)
    ih[n] := nwl + 3;
    hrun(x + wwd + 8, y, 4, '+', '+');
    hrun(x + 5, y + 1, wwd + 2, '+', '+');
    put(x + w - 1, y + 1, '|');
    for i := 1 to nwl do begin
      r := y + 1 + i;
      put(x + 5, r, '|');
      ctext(x + 6, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 6, r, '|')
    end;
    put(x + w - 1, y + 2, '+');
    dash(x + wwd + 7, y + 2, 4, '-');
    hrun(x + 5, y + nwl + 2, wwd + 2, '+', '+')
  end else if k = 20 then begin
    (* ПРАВЫЙ КОММЕНТАРИЙ И22: скобка слева от текста *)
    ih[n] := nwl;
    for i := 1 to nwl do begin
      r := y + i - 1;
      put(x, r, '(');
      ctext(x + 2, wwd, r, wtx[i], wln[i])
    end
  end else if k = 21 then begin
    (* ЛЕВЫЙ КОММЕНТАРИЙ И23: текст, скобка справа *)
    ih[n] := nwl;
    for i := 1 to nwl do begin
      r := y + i - 1;
      ctext(x + 2, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 2, r, ')')
    end
  end else if k = 22 then begin
    (* ПЕТЛЯ ЦИКЛА И24: остриё упирается в вертикаль *)
    ih[n] := 2;
    put(x + 9, y, '|');
    put(x + 10, y, '<');
    dash(x + 11, y, 7, '-');
    put(x + w - 1, y, '+');
    put(x + 9, y + 1, '|');
    put(x + w - 1, y + 1, '|')
  end else if k = 23 then begin
    (* ПЕТЛЯ СИЛУЭТА И25: остриё в вертикаль, зубцы гребёнки *)
    ih[n] := 2;
    put(x + 15, y, '|');
    put(x + 16, y, '<');
    dash(x + 17, y, 13, '-');
    put(x + 15, y + 1, '|');
    put(x + 19, y + 1, '|');
    put(x + 23, y + 1, '|');
    put(x + 27, y + 1, '|');
    put(x + 29, y + 1, '|')
  end else if k = 24 then begin
    (* ВСТАВКА И9: прямоугольник с двойными стенками *)
    ih[n] := nwl + 2;
    hrun(x, y, w, '+', '+');
    for i := 1 to nwl do begin
      r := y + i;
      put(x, r, '|');
      put(x + 1, r, '|');
      ctext(x + 2, wwd, r, wtx[i], wln[i]);
      put(x + wwd + 2, r, '|');
      put(x + wwd + 3, r, '|')
    end;
    hrun(x, y + nwl + 1, w, '+', '+')
  end
end;

(* рисование иконы узла n с центром на колонке col, верх row;
   формы разбиты на picon1..picon6: у компилятора 15.1 предел
   числа команд в блоке *)
procedure makeicon(n, col, row: integer);
var
  k, w, tl, i, x, y: integer;
begin
  k := kindof(n);
  tl := ntl[n];
  if (k = 4) and (tl = 0) then begin
    (* конец без подписи печатает слово КОНЕЦ *)
    gtxt[1] := 'к'; gtxt[2] := 'о'; gtxt[3] := 'н';
    gtxt[4] := 'е'; gtxt[5] := 'ц'
  end;
  w := iconw(n);
  (* строки подписи: поле и перенос подогнаны в iconw/fittext;
     у конца - одна строка *)
  if k = 4 then begin
    tl := ntl[n];
    if tl = 0 then
      tl := 5;
    nwl := 1;
    wln[1] := tl;
    for i := 1 to tl do wtx[1][i] := gtxt[i]
  end;
  x := col - w div 2;
  ix[n] := x;
  iw[n] := w;
  iy[n] := row;
  y := row;
  if (k = 2) or (k = 6) or (k = 7) then
    picon2(k, n, x, y, w)
  else if (k = 5) or (k = 8) or (k = 9) or (k = 10) then
    picon3(k, n, x, y, w)
  else if (k = 11) or (k = 12) or (k = 13) or (k = 14) then
    picon4(k, n, x, y, w)
  else if (k = 15) or (k = 16) or (k = 17) or (k = 18) then
    picon5(k, n, x, y, w)
  else if k >= 19 then
    picon6(k, n, x, y, w)
  else
    picon1(k, n, x, y, w)
end;

function mainkids(n: integer): integer;
var
  ch, res: integer;
  done: boolean;
begin
  res := 0;
  ch := 0;
  if (nkind[n] = 6) or (nkind[n] = 15) then
    res := nkid[n]
  else
    ch := nkid[n];
  done := false;
  while (ch <> 0) and (not done) do begin
    if nkind[ch] = 11 then begin
      res := nkid[ch];
      done := true
    end else
      ch := nbro[ch]
  end;
  mainkids := res
end;

(* строка бокового выхода иконы: у вопроса - валентная точка
   на середине высоты (правая стена), у остальных - нижняя грань *)
function exrow(n: integer): integer;
var
  r: integer;
begin
  r := iy[n] + ih[n] - 1;
  if (nkind[n] = 5) or (nkind[n] = 6) then
    r := iy[n] + ih[n] div 2;
  exrow := r
end;

(* собрать правые плечи: ИНАЧЕ (минус - начало с потомков),
   ВАРИАНТ (плюс - икона и потомки) *)
procedure sidebranches(n: integer);
var
  ch: integer;
begin
  nbr[n] := 0;
  ch := nkid[n];
  while ch <> 0 do begin
    if nkind[ch] = 12 then begin
      if nkid[ch] <> 0 then begin
        nbr[n] := nbr[n] + 1;
        brx[n, nbr[n]] := -nkid[ch]
      end
    end else if nkind[ch] = 8 then begin
      if (ntl[ch] > 0) or (nkid[ch] <> 0) then begin
        nbr[n] := nbr[n] + 1;
        brx[n, nbr[n]] := ch
      end
    end;
    ch := nbro[ch]
  end
end;

(* ширина самой широкой иконы цепочки *)
function chainw(first: integer): integer;
var
  ch, w, mw: integer;
begin
  mw := 0;
  ch := first;
  while ch <> 0 do begin
    w := iconw(ch);
    if w > mw then
      mw := w;
    ch := nbro[ch]
  end;
  chainw := mw
end;

(* разложить цепочку по шампуру col от строки row;
   gy - нижняя свободная строка, gtail - последний узел цепочки;
   one <> 0 - разложить только первый узел, без братьев
   (икона ВАРИАНТа раскладывается отдельно от своих потомков) *)
procedure layout(first, col, row, tail, one: integer);
var
  node, y, rx, rail, wmax, ry, row0, mk, b, k, yb: integer;
  f0: integer;
begin
  y := row;
  node := first;
  while node <> 0 do begin
    if tail <> 0 then
      nxt[tail] := node;
    nfl := nfl + 1;
    flat[nfl] := node;
    makeicon(node, col, y);
    y := y + ih[node] + GAPR;
    mk := mainkids(node);
    if mk <> 0 then begin
      layout(mk, col, y, node, 0);
      if gy > y then
        y := gy;
      mainb[node] := gy - GAPR;
      tail := gtail
    end else begin
      mainb[node] := iy[node] + ih[node];
      tail := node
    end;
    sidebranches(node);
    if nbr[node] > 0 then begin
      row0 := exrow(node);
      rx := col + iw[node] div 2 + GAPS;
      ry := row0 + 1;
      for b := 1 to nbr[node] do begin
        if brx[node, b] < 0 then begin
          f0 := -brx[node, b];
          wmax := chainw(f0)
        end else begin
          f0 := brx[node, b];
          wmax := iconw(f0);
          if nkid[f0] <> 0 then begin
            k := chainw(nkid[f0]);
            if k > wmax then
              wmax := k
          end
        end;
        rail := rx + wmax div 2;
        if brx[node, b] < 0 then
          layout(f0, rail, ry, 0, 0)
        else begin
          layout(f0, rail, ry, 0, 1);
          if nkid[f0] <> 0 then
            layout(nkid[f0], rail, gy, f0, 0)
        end;
        brx[node, b] := rail;
        bry[node, b] := ry;
        yb := gy - GAPR;
        brb[node, b] := yb;
        if yb + GAPR > y then
          y := yb + GAPR;
        rx := rail + (wmax + 1) div 2 + GAPS
      end
    end;
    node := nbro[node];
    if one <> 0 then
      node := 0
  end;
  gtail := tail;
  gy := y
end;

(* ---------------- рисунок ---------------- *)

(* вертикальные линии между иконами одной цепочки *)
procedure connectors;
var
  i, a, b, cl, r: integer;
begin
  for i := 1 to nfl do begin
    a := flat[i];
    if nxt[a] <> 0 then begin
      b := nxt[a];
      cl := ix[a] + iw[a] div 2;
      for r := iy[a] + ih[a] to iy[b] - 1 do
        put(cl, r, '|')
    end
  end
end;

(* шина выхода вправо к осям плеч; линия начинается от самой
   правой литеры иконы в строке выхода (у параллелограмма низ
   уже верха, у вопроса стена на середине высоты) *)
procedure busout;
var
  i, a, b, r, cl, x, row0, lastr, wx: integer;
begin
  for i := 1 to nfl do begin
    a := flat[i];
    if nbr[a] > 0 then begin
      cl := ix[a] + iw[a] div 2;
      row0 := exrow(a);
      lastr := brx[a, 1];
      for b := 2 to nbr[a] do
        if brx[a, b] > lastr then
          lastr := brx[a, b];
      wx := ix[a];
      for x := ix[a] to ix[a] + iw[a] - 1 do
        if dmem.pic[row0][x] <> ' ' then
          wx := x;
      for x := wx + 1 to lastr - 1 do
        put(x, row0, '-');
      for b := 1 to nbr[a] do begin
        put(brx[a, b], row0, '+');
        for r := row0 + 1 to bry[a, b] - 1 do
          put(brx[a, b], r, '|')
      end
    end
  end
end;
(* возврат правых плеч на основную вертикаль *)
procedure mergeback;
var
  i, a, b, r, x, cl, base, mr: integer;
  stop: boolean;
begin
  for i := 1 to nfl do begin
    a := flat[i];
    if nbr[a] > 0 then begin
      cl := ix[a] + iw[a] div 2;
      base := mainb[a];
      for b := 1 to nbr[a] do
        if brb[a, b] > base then
          base := brb[a, b];
      (* слияние не рисуется, если икона основной цепочки
         начинается ровно на строке base *)
      stop := false;
      for r := 1 to nfl do
        if flat[r] <> a then
          if (ix[flat[r]] + iw[flat[r]] div 2 = cl) and
             (iy[flat[r]] = base) then
            stop := true;
      if not stop then begin
        for b := 1 to nbr[a] do
          for r := brb[a, b] to base - 1 do
            put(brx[a, b], r, '|');
        mr := brx[a, 1];
        for b := 2 to nbr[a] do
          if brx[a, b] > mr then
            mr := brx[a, b];
        for x := cl + 1 to mr - 1 do
          put(x, base, '-');
        for b := 1 to nbr[a] do
          put(brx[a, b], base, '+');
        put(cl, base, '+')
      end
    end
  end
end;

(* ---------------- выдача средствами редактора ---------------- *)

(* начать блок *DRK: чистое состояние схемы; рамка и широкий
   формат немедленно - как *RG*RU первой картой блока *RED *)
(* петля цикла ДЛЯ: возврат от КДЛ к вертикали под ДЛЯ (икона
   И24): от правой стены КДЛ на середине высоты - вправо, вверх
   и остриём в вертикаль между ДЛЯ и телом цикла *)
procedure forloop;
var
  i, nd, kd, ch, cl, ax, r1, r2, wx, xx, rr: integer;
begin
  for i := 1 to nfl do
    if nkind[flat[i]] = 15 then begin
      nd := flat[i];
      (* последний ребёнок-КДЛ *)
      kd := 0;
      ch := nkid[nd];
      while ch <> 0 do begin
        if nkind[ch] = 16 then
          kd := ch;
        ch := nbro[ch]
      end;
      if kd <> 0 then begin
        cl := ix[nd] + iw[nd] div 2;
        (* ось правее всех икон тела (от первого ребёнка до КДЛ) *)
        ax := cl;
        ch := nkid[nd];
        while ch <> 0 do begin
          if ix[ch] + iw[ch] > ax then
            ax := ix[ch] + iw[ch];
          ch := nbro[ch]
        end;
        ax := ax + 2;
        r1 := iy[nd] + ih[nd] + 1;
        r2 := iy[kd] + ih[kd] div 2;
        wx := ix[kd];
        for xx := ix[kd] to ix[kd] + iw[kd] - 1 do
          if dmem.pic[r2][xx] <> ' ' then
            wx := xx;
        put(cl + 1, r1, '<');
        for xx := cl + 2 to ax - 1 do
          put(xx, r1, '-');
        put(ax, r1, '+');
        for rr := r1 + 1 to r2 - 1 do
          put(ax, rr, '|');
        put(ax, r2, '+');
        for xx := wx + 1 to ax - 1 do
          put(xx, r2, '-')
      end
    end
end;

(* ---------------- силуэт (как в drakon.pas) ---------------- *)

(* раскладка силуэта по рис. 9 книги: заголовок, под ним ветки
   РЯДОМИ в колонки; верхняя шина от заголовка к щитам, снизу
   петля с возвратом в заголовок; ветка с КОНЦОМ - выход вниз.
   Если колонки не умещаются в ширину АЦПУ - общий шампур *)
procedure silout;
var
  h, b, p, sav, f0, j, nn1, kk, mn, mx, bot, prevr, d,
  minall, gsh: integer;
begin
  silnb := 0;
  h := nroot;
  layout(h, 1, 1, 0, 1);
  silhb := iy[h] + ih[h] + 1;
  b := nbro[h];
  while b <> 0 do begin
    p := b;
    while (nbro[p] <> 0) and (nkind[nbro[p]] <> 2) do
      p := nbro[p];
    sav := nbro[p];
    nbro[p] := 0;
    silnb := silnb + 1;
    silb[silnb] := b;
    f0 := nfl + 1;
    silf0[silnb] := f0;
    layout(b, 1, silhb + 2, 0, 0);
    silf1[silnb] := nfl;
    siltail[silnb] := gtail;
    nbro[p] := sav;
    mn := ix[b];
    mx := ix[b] + iw[b] - 1;
    bot := iy[b] + ih[b] - 1;
    for j := f0 to nfl do begin
      nn1 := flat[j];
      if ix[nn1] < mn then
        mn := ix[nn1];
      if ix[nn1] + iw[nn1] - 1 > mx then
        mx := ix[nn1] + iw[nn1] - 1;
      if iy[nn1] + ih[nn1] - 1 > bot then
        bot := iy[nn1] + ih[nn1] - 1
    end;
    if silnb > 1 then begin
      d := prevr + GAPB + 1 - mn;
      for j := silf0[silnb] to nfl do begin
        nn1 := flat[j];
        ix[nn1] := ix[nn1] + d;
        for kk := 1 to nbr[nn1] do
          brx[nn1, kk] := brx[nn1, kk] + d
      end;
      mx := mx + d
    end;
    prevr := mx;
    silbot[silnb] := bot;
    b := sav
  end;
  for j := 1 to silnb do
    silax[j] := ix[silb[j]] + iw[silb[j]] div 2;
  ix[h] := silax[1] - iw[h] div 2;
  minall := ix[h];
  for j := 1 to nfl do
    if ix[flat[j]] < minall then
      minall := ix[flat[j]];
  sillc := minall - 2;
  gsh := 0;
  if sillc < 1 then
    gsh := 1 - sillc;
  if prevr + gsh > DCMAX - 1 then begin
    silmd := false;
    for j := 1 to nfl do
      nxt[flat[j]] := 0;
    nfl := 0
  end else if gsh > 0 then begin
    for j := 1 to nfl do begin
      nn1 := flat[j];
      ix[nn1] := ix[nn1] + gsh;
      for kk := 1 to nbr[nn1] do
        brx[nn1, kk] := brx[nn1, kk] + gsh
    end;
    for j := 1 to silnb do
      silax[j] := silax[j] + gsh;
    sillc := 1
  end;
  if not silmd then
    exit;
  bot := 0;
  for j := 1 to silnb do
    if silbot[j] > bot then
      bot := silbot[j];
  silbb := bot + 2
end;

(* линии силуэта, верхняя часть: вертикаль заголовка, верхняя
   шина с остриём петли и спуски к щитам (разбивка на две
   процедуры - у компилятора 15.1 предел числа команд в блоке) *)
procedure silconnect;
var
  i, r, x, lasta: integer;
begin
  for r := iy[nroot] + ih[nroot] to silhb - 1 do
    put(silax[1], r, '|');
  lasta := silax[silnb];
  put(sillc, silhb, '+');
  for x := sillc + 1 to lasta - 1 do
    put(x, silhb, '-');
  for i := 1 to silnb do
    put(silax[i], silhb, '+');
  if silax[1] - 1 > sillc then
    put(silax[1] - 1, silhb, '>');
  for i := 1 to silnb do
    put(silax[i], silhb + 1, '|')
end;

(* линии силуэта, нижняя часть: вертикаль петли слева и нижняя
   шина (гребёнка): спуски веток, не кончающихся КОНЦОМ *)
procedure silloop;
var
  i, r, x, lasta: integer;
begin
  for r := silhb + 1 to silbb - 1 do
    put(sillc, r, '|');
  put(sillc, silbb, '+');
  lasta := sillc;
  for i := 1 to silnb do
    if nkind[siltail[i]] <> 10 then begin
      if silax[i] > lasta then
        lasta := silax[i]
    end;
  for x := sillc + 1 to lasta - 1 do
    put(x, silbb, '-');
  for i := 1 to silnb do
    if nkind[siltail[i]] <> 10 then begin
      for r := iy[siltail[i]] + ih[siltail[i]] to silbb - 1 do
        put(silax[i], r, '|');
      put(silax[i], silbb, '+')
    end
end;

procedure drkstart;
var
  i, j: integer;
begin
  initkw;
  ncnt := 0;
  nroot := 0;
  nfl := 0;
  gtail := 0;
  stn := 0;
  last0 := 0;
  for i := 1 to DRMAX do
    for j := 1 to DCMAX do
      dmem.pic[i][j] := ' ';
  fir := true;
  rgon := true;
  newfmt(1, false);
  fir := false;
  posmode := false
end;

(* перевести собранную схему в строки листа редактора:
   каждая строка рисунка проходит тот же путь, что карта
   разметки * /*D (очередь пуста, литеры как есть), и сдвигается
   на лист commit'ом - рамки и границы страниц ведёт редактор *)
procedure drkemit;
var
  i, j, ln, m2, q2: integer;
begin
  if ncnt = 0 then
    exit;
  (* силуэт: корневая цепочка - заголовок, за ним ветки-щиты;
     веток больше SM - общий шампур *)
  silmd := (nkind[nroot] = 1) and (nbro[nroot] <> 0) and
           (nkind[nbro[nroot]] = 2);
  if silmd then begin
    qq := 0;
    nn1 := nbro[nroot];
    while nn1 <> 0 do begin
      if nkind[nn1] = 2 then
        qq := qq + 1;
      nn1 := nbro[nn1]
    end;
    if qq > SM then
      silmd := false
  end;
  if silmd then
    silout;
  (* silout может отменить силуэт: колонки не уместились *)
  if not silmd then
    layout(nroot, 1, 1, 0, 0);
  (* сдвиг рисунка: левый край икон к колонке 1; оси плеч
     не сдвигаются - они уже отсчитаны от шампура *)
  m2 := 1;
  for i := 1 to nfl do
    if ix[flat[i]] < m2 then
      m2 := ix[flat[i]];
  if m2 < 1 then begin
    q2 := 1 - m2;
    for i := 1 to nfl do
      ix[flat[i]] := ix[flat[i]] + q2;
    (* оси плеч - те же абсолютные колонки рисунка *)
    for i := 1 to ncnt do
      for j := 1 to NBMAX do
        if brx[i, j] <> 0 then
          brx[i, j] := brx[i, j] + q2
  end;
  (* число строк рисунка: самая низкая занятая строка; выше DRMAX
     строки не рисовались (put обрезает) - не читать и их *)
  rws := 0;
  for i := 1 to nfl do
    if iy[flat[i]] + ih[flat[i]] - 1 > rws then
      rws := iy[flat[i]] + ih[flat[i]] - 1;
  if rws > DRMAX then
    rws := DRMAX;
  j := 0;
  while (rws > 0) and (j = 0) do begin
    ln := 0;
    for i := 1 to DCMAX do
      if dmem.pic[rws][i] <> ' ' then
        ln := i;
    if ln > 0 then
      j := 1
    else
      rws := rws - 1
  end;
  (* у силуэта ниже икон ещё нижняя шина петли; выше DRMAX
     строки не рисовались (put обрезает) *)
  if silmd then begin
    if silbb > rws then
      rws := silbb;
    if rws > DRMAX then
      rws := DRMAX
  end;
  (* перерисовка со сдвигом *)
  for i := 1 to DRMAX do
    for j := 1 to DCMAX do
      dmem.pic[i][j] := ' ';
  for i := 1 to nfl do
    makeicon(flat[i], ix[flat[i]] + iw[flat[i]] div 2,
             iy[flat[i]]);
  connectors;
  busout;
  mergeback;
  forloop;
  if silmd then begin
    silconnect;
    silloop
  end;
  (* строки рисунка - в текущую строку как есть и на лист; за
     128-й позицией литеры теряются, как на АЦПУ и в разметке *)
  posmode := false;
  for i := 1 to rws do begin
    flushq(false);
    clrrow(cur);
    curpos := curflda;
    ln := 0;
    for j := 1 to DCMAX do
      if dmem.pic[i][j] <> ' ' then
        ln := j;
    for j := 1 to ln do
      if curflda + j - 1 <= 128 then
        cur[curflda + j - 1] := dmem.pic[i][j];
    commit(true)
  end
end;

(* ---------------- сканер команд ---------------- *)

(* обработка команды после звездочки *)
procedure command;
var
  c, c2, c3: char;
  hasnum: boolean;
  a, b, i: integer;
begin
  nn1 := 1;
  hasnum := false;
  if (cpos <= cwv) and (card[cpos] >= '0') and (card[cpos] <= '9')
     then begin
    nn1 := 0;
    while (cpos <= cwv) and (card[cpos] >= '0') and (card[cpos] <=
       '9') do begin
      nn1 := nn1 * 10 + (ord(card[cpos]) - 48);
      cpos := cpos + 1
    end;
    hasnum := true
  end;
  if cpos > cwv then exit;
  c := card[cpos];
  cpos := cpos + 1;
  if c = 'F' then begin
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      if nn1 > 0 then fillrest(c2, nn1);
      posmode := true
    end
  end else if c = 'T' then begin
    flushq(false);
    commit(true);
    posmode := false;
    centerrest(cpos);
    cpos := cwv + 1;
    empties(2)
  end else if c = 'M' then begin
    if (cpos <= cwv) and (card[cpos] = 'F') then begin
      cpos := cpos + 1;
      (* текст перед *MF выводится своей строкой *)
      if (nw > 0) or (curpos > curflda) then begin
        flushq(false);
        commit(true)
      end;
      listing := true;
      cpos := cwv + 1
    end else if (cpos <= cwv) and (card[cpos] = 'C') then begin
      cpos := cpos + 1;
      if (cpos <= cwv) and (card[cpos] = 'S') then begin
        cpos := cpos + 1;
        if not readnum(a) then klaida(20);
        if not readnum(b) then klaida(20);
        setmcs(a, b)
      end else if (cpos <= cwv) and (card[cpos] = 'P') then begin
        cpos := cpos + 1;
        if not readnum(a) then klaida(20);
        if not readnum(b) then klaida(20);
        if (a > 127) or (b > 127) then klaida(40)
      end else
        klaida(10)
    end else if (cpos <= cwv) and (card[cpos] = 'D') then begin
      cpos := cpos + 1;
      flushq(false);
      commit(true);
      posmode := false;
      centerrest(cpos);
      cpos := cwv + 1
    end else if (cpos <= cwv) and (card[cpos] = '=') then begin
      cpos := cpos + 1;
      macdef
    end else
      macins
  end else if c = 'S' then begin
    if (cpos <= cwv) and (card[cpos] = 'T') then begin
      if (cpos + 1 <= cwv) and (card[cpos + 1] >= '0') and
         (card[cpos + 1] <= '9') then
        tabledef(false)
      else begin
        cpos := cpos + 1;
        if cpos > cwv then klaida(10);
        c2 := card[cpos];
        cpos := cpos + 1;
        if c2 = 'A' then
          newfmt(2, hasnum and (nn1 = 1))
        else if c2 = 'O' then
          newfmt(0, hasnum and (nn1 = 1))
        else if c2 = 'P' then begin
          stpon := true;
          stponly := (nn1 = 1);
          stpl := 0;
          for i := cpos to cwv do
            if card[i] <> ' ' then stpl := i - cpos + 1;
          for i := 1 to stpl do stp[i] := card[cpos + i - 1];
          cpos := cwv + 1;
          (* страница ещё пуста - штамп ставится сразу, иначе он
             появился бы только со следующей *)
          stpend := true
        end else if c2 = 'G' then begin
          stgon := true;
          stgonly := (nn1 = 1);
          stgl := 0;
          for i := cpos to cwv do
            if card[i] <> ' ' then stgl := i - cpos + 1;
          for i := 1 to stgl do stg[i] := card[cpos + i - 1];
          cpos := cwv + 1
        end else if c2 = 'N' then begin
          (* сдвиг штампа - принимается без действия *)
        end else
          klaida(10)
      end
    end else if (cpos <= cwv) and (card[cpos] = 'L') then begin
      cpos := cpos + 1;
      tabledef(true)
    end else begin
      (* новый абзац: перевод строки (пустая строка не выводится),
         n-1 пустых строк, отступ 3 *)
      if (nw > 0) or (curpos > curflda) then begin
        flushq(false);
        commit(true)
      end;
      if nn1 > 1 then empties(nn1 - 1);
      indon := true
    end
  end else if c = 'L' then begin
    (* SL - таблица с линейками *)
    tabledef(true)
  end else if c = '/' then begin
    flushq(false);
    (* пустая текущая строка не сдвигается на лист: первая карта
       */ *D рисунка не должна давать пустую текстовую строку *)
    if curpos > curflda then
      commit(true)
    else
      curpos := curflda;
    posmode := false;
    if nn1 > 1 then empties(nn1 - 1)
  end else if c = 'P' then begin
    flushq(false);
    (* на свежей странице без текста *P не пишет пустую строку
       и не тратит номер страницы *)
    if (not freshpg) or (curpos > curflda) then
      commit(true);
    posmode := false;
    for i := 1 to nn1 do pageend
  end else if c = 'E' then begin
    endtxt := true;
    posmode := false;
    cpos := cwv + 1
  end else if c = 'G' then begin
    flushq(false);
    posmode := true;
    pp := curflda + nn1 - 1;
    if pp > curpos then curpos := pp
  end else if c = 'C' then begin
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      putrep(c2, nn1);
      posmode := true
    end
  end else if c = 'H' then begin
    hword(nn1)
  end else if c = 'D' then begin
    verbatim;
    posmode := true;
    cpos := cwv + 1
  end else if c = 'N' then begin
    (* *nN: номер следующей страницы; перед знаком команды пробел
       не обязателен - *254N*1RL задаёт номер так же, как *254N_.
       На свежей странице (ничего не напечатано) номер действует
       на неё сразу, иначе - на следующую (pnext) *)
    if cpos <= cwv then begin
      c2 := card[cpos];
      if c2 = ' ' then begin
        if rowno = 0 then begin
          pageno := nn1;
          hpno[side] := nn1
        end else
          pnext := nn1;
        cpos := cpos + 1
      end else begin
        (* номер регистрируется в первой карте блока (FIRCAR) или
           перед пробелом; *7N*P номер не задаёт *)
        if hasnum and fir then begin
          if rowno = 0 then begin
            pageno := nn1;
            hpno[side] := nn1
          end else
            pnext := nn1
        end;
        if c2 = 'N' then begin
          numon := false;
          cpos := cpos + 1
        end else if (c2 = 'L') or (c2 = 'R') or (c2 = 'U') or (c2 =
           'D') then begin
          cpos := cpos + 1;
          if tabon then begin
            if c2 = 'L' then cnol := true;
            if c2 = 'R' then cnr := true;
            if c2 = 'U' then cnu := true;
            if c2 = 'D' then cnd := true
          end else
            addch(c2)
        end else if (c2 >= 'A') and (c2 <= 'Z') then begin
          (* N поглощается, буква остаётся текстом *)
          addch(c2);
          cpos := cpos + 1
        end
        (* перед не-буквой N просто опускается *)
      end
    end else if hasnum and fir then begin
      if rowno = 0 then begin
        pageno := nn1;
        hpno[side] := nn1
      end else
        pnext := nn1
    end
  end else if c = 'O' then begin
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      if c2 = 'L' then begin
        if (cpos <= cwv) and (card[cpos] = 'R') then cpos := cpos + 1;
        flushq(false);
        fillon := false
      end else if c2 = 'R' then begin
        if (cpos <= cwv) and (card[cpos] = 'U') then cpos := cpos + 1;
        newfmt(0, hasnum and (nn1 = 1))
      end else
        klaida(10)
    end
  end else if c = 'W' then begin
    group(nn1, true)
  end else if c = '(' then begin
    group(nn1, false)
  end else if c = 'R' then begin
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      if c2 = 'T' then begin
        flushq(false);
        fillon := true
      end else if c2 = 'L' then begin
        (* новый интервал действует со следующей строки *)
        if (nw > 0) or (curpos > curflda) then begin
          flushq(false);
          commit(true)
        end;
        rln := nn1
      end else if c2 = 'C' then begin
        rcn := nn1
      end else if c2 = 'G' then begin
        rgon := true
      end else if c2 = 'U' then begin
        newfmt(1, hasnum and (nn1 = 1))
      end else if c2 = 'F' then begin
        if cpos <= cwv then begin
          c2 := card[cpos];
          cpos := cpos + 1;
          fillto(nn1, c2);
          posmode := true
        end
      end else
        klaida(10)
    end
  end else if c = 'K' then begin
    if not readnum(a) then klaida(10);
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      putrep(c2, a);
      posmode := true
    end
  end else if hasnum then begin
    (* число без команды - режим листинга *)
    if (nw > 0) or (curpos > curflda) then begin
      flushq(false);
      commit(true)
    end;
    listing := true;
    cpos := cwv + 1
  end else
    klaida(10)
end;

(* просмотр карты: команды и текст *)
procedure scancard;
var
  c: char;
  lpos: integer;      (* последняя значимая позиция карты *)
begin
  (* хвостовые пробелы карты не значимы: в позиционном режиме они
     сдвигали бы позицию набора *)
  lpos := cwv;
  while (lpos > 0) and (card[lpos] = ' ') do lpos := lpos - 1;
  (* текст карты значим до 72-й позиции; остальное - только для *D *)
  if lpos > CW then lpos := CW;
  while cpos <= lpos do begin
    c := card[cpos];
    cpos := cpos + 1;
    if c = '*' then begin
      if (cpos <= cwv) and (card[cpos] <> ' ') then
        command
      else
        (* '*' перед пробелом или в конце карты опускается *)
        spcnt := spcnt
    end else
      addch(c)
  end;
  (* граница карты: слово продолжается, если 72-я позиция занята *)
  if wleng > 0 then begin
    if (mksp > 0) or (cwv < CW) then
      addword
    else if card[CW] = ' ' then
      addword
  end;
  (* хвостовые пробелы карты отбрасываются, граница карты - один пробел *)
  spcnt := 1
end;

(* ---------------- главная программа ---------------- *)

begin
  setfmt(0);
  (* бланк упакованной строки: разовая заливка, дальше строки листа
     чистятся присваиванием целиком *)
  for ii := 1 to 128 do бланкp[ii] := ' ';
  рпмск.м := [40..47];    (* маска младшего байта слова *)
  (* статическая память чистых упакованных строк листа содержит нули,
     а не пробелы: первый newsheet заливает пробелами весь htxt, дальше
     достаточно чистить занятые строки (пишутся только непробельные) *)
  hrows[0] := 66;
  hrows[1] := 66;
  newsheet;
  pageno := 0;
  pnext := 0;
  numon := true;
  hnum[0] := true;
  hnum[1] := true;
  mcsset := false;
  pgfirst := true;
  stpend := false;
  rgon := false;
  rln := 0;
  rcn := 0;
  fillon := true;
  indon := false;
  listing := false;
  endtxt := false;
  stpon := false;
  stgon := false;
  stponly := false;
  stgonly := false;
  stpl := 0;
  stgl := 0;
  tabon := false;
  incell := false;
  trows := 0;
  tcol := 0;
  mkcnt := 0;
  mksp := 0;
  for ii := 1 to TCDEEP do mknest[ii] := false;
  fmpending := -1;
  fir := false;
  nw := 0;
  natq := 0;
  spcnt := 0;
  wbrk := false;
  wleng := 0;
  wrcl := 0;
  cwv := 72;
  pagestart;

1: (* ключевое слово блока *)
  getcard;
  if eofin then goto 9;
  if (card[1] = '*') and (card[2] = 'R') and (card[3] = 'E') and
     (card[4] = 'D') then begin
    endtxt := false;
    fir := true;
    while not endtxt do begin
      getcard;
      if eofin then
        endtxt := true
      else if listing then
        listcard
      else if tabon then
        tablecard
      else begin
        (* раскрытие макро без рекурсии: macstep докручивает куски
           тел, продолжения карт и снятие уровней *)
        scancard;
        while mksp > 0 do
          macstep;
        if stpend then begin
          stpend := false;
          if rowno = 0 then
            putstp
        end;
        (* FIRCAR действует только на первую карту блока *)
        fir := false
      end
    end;
    flushq(false);
    commit(true);
    if rowno > 0 then hused[side] := true;
    sheetprint(true);
    newsheet;
    goto 1
  end;
  if (card[1] = '*') and (card[2] = 'D') and (card[3] = 'R') and
     (card[4] = 'K') then begin
    (* блок *DRK: исходник схемы ДРАКОН до карты *E, затем
       трансляция и печать листа средствами редактора; рамка и
       широкий формат включаются самим блоком (drkstart) *)
    drkstart;
    endtxt := false;
    while not endtxt do begin
      getcard;
      if eofin then
        endtxt := true
      else if (card[1] = '*') and (card[2] = 'E') then
        endtxt := true
      else
        drkcard
    end;
    drkemit;
    (* последняя строка рисунка уже сдвинута drkemit'ом; сдвигать
       пустую текущую строку не нужно *)
    if curpos > curflda then
      commit(true);
    if rowno > 0 then hused[side] := true;
    sheetprint(true);
    newsheet;
    goto 1
  end;
  if (card[1] = '*') and (card[2] = 'E') and (card[3] = 'N') and
     (card[4] = 'D') then
    goto 9;
  klaida(100);
9: stop
end.
