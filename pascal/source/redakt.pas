(* ---------------- печать листа ---------------- *)

(* рамка страницы *MCP: охватывает узкую страницу (строки
   mrow..mrow+mchp-1, колонки mfl..mfl+mcwp-1); i - строка листа;
   на граних страницы - точки по углам и штрихи, между ними - стойки *)
procedure mcpframe(i, sd: integer);
var
  fl, fr2, pr, ph, k3: integer;
begin
  fl := mfl[sd];
  fr2 := fl + mcwp[sd] - 1;
  pr := mrow[sd];
  ph := mchp[sd];
  if (i = pr) or (i = pr + ph - 1) then begin
    пстрок[fl] := '.';
    пстрок[fr2] := '.';
    for k3 := fl + 1 to fr2 - 1 do
      пстрок[k3] := '-'
  end else if (i > pr) and (i < pr + ph - 1) then begin
    пстрок[fl] := 'I';
    пстрок[fr2] := 'I'
  end
end;

(* печать листа без сборки: массив sheet упразднён, строка листа
   составляется прямо при печати - левая страница даёт позиции 1..64,
   правая 65..128 (широкий формат и формат А занимают все 128 позиций
   левой страницы); рамка, номера страниц и подвал рисуются в печатной
   строке поверх текста, как раньше поверх собранного листа.  Строки
   шапки и незанятые строки страниц чисты.  final - окончание текста
   (*E) *)
procedure sheetprint(final: boolean);
var
  top, bot, i, s, np, k2, st2, stprow, flde, strow: integer;
  sideon: array [0..1] of boolean;
  tleft, tright: boolean;
  s1, nb: integer;
begin
  if fmt = 0 then begin
    top := 2; bot := 67; stprow := 4
  end else if fmt = 1 then begin
    top := 3; bot := 68; stprow := 5
  end else begin
    top := 3; bot := 72; stprow := 6
  end;
  (* в формате А на последней странице штамп на две строки ниже *)
  if (fmt = 2) and final then stprow := 8;
  (* строка подвала: в формате А - на две строки выше нижнего края *)
  strow := bot - 1;
  if fmt = 2 then strow := bot - 2;
  sideon[0] := hused[0];
  sideon[1] := hused[1];
  np := hpno[1];
  if (not hused[1]) and hused[0] then begin
    (* номер правой страницы листа печатается, если на листе есть
       левая страница: он на единицу больше *)
    sideon[1] := true;
    np := hpno[0] + 1
  end;
  (* строки прогона 1-2 АЦПУ: лист начинается со строки top, прогон-
     ных строк перед ним top-1 (в широком формате и формате А - две,
     в обычном - одна; сверено с эталонами) *)
  for i := 1 to top - 1 do
    прогон;
  for i := top to bot do begin
    (* текст строки: распаковка строки страницы прямо в печатную
       строку; левая (или единственная) страница - из htxt[0]; у
       страницы *MCP текст начинается на mrow+3 *)
    s := i - rowbase;
    if hmcp[0] then
      s := i - (mrow[0] + 2);
    (* конец поля страницы: если поле накрывает край страницы,
       рамка на этом краю не рисуется (в оригинале текст затирает
       стойку рамки) *)
    flde := flda + fldw - 1;
    if (s >= 1) and (s <= hrows[0]) then begin
      (* левая/полная страница: копия строки распаковывается
         машинной развёрткой (константные пары - вне циклов) *)
      копстр := htxt0[s];
      развпак1; развпак2; развпак3; развпак4;
      tleft := true
    end else begin
      clrrow(пстрок);
      tleft := false
    end;
    tright := false;
    if fmt = 0 then begin
      (* правая страница: позиции 65..128 из htxt[1]; на смешанном
         листе (обычная страница и *MCP) строки страниц не совпадают *)
      s1 := s;
      if hmcp[1] then
        s1 := i - (mrow[1] + 2);
      if (s1 >= 1) and (s1 <= hrows[1]) then begin
        for k2 := 65 to 128 do пстрок[k2] := htxt1[s1][k2];
        tright := true
      end else
        for k2 := 65 to 128 do пстрок[k2] := ' '
    end;
    (* рамка: у страницы *MCP рамка охватывает узкую страницу (если
       *RG был включён при её начале), у обычных страниц - штатная
       рамка формата; на граних листа - точки по углам и штрихи между
       ними, на остальных строках - стойки; поверх текста *)
    if fmt = 0 then begin
      if hmcp[0] then begin
        if hfr[0] then
          mcpframe(i, 0)
      end else if hfr[0] then begin
        if (i = top) or (i = bot) then begin
          пстрок[2] := '.'; пстрок[64] := '.';
          for k2 := 3 to 63 do пстрок[k2] := '-'
        end else begin
          пстрок[2] := 'I';
          if not (tleft and (flde >= 64)) then
            пстрок[64] := 'I'
        end
      end;
      if hmcp[1] then begin
        if hfr[1] then
          mcpframe(i, 1)
      end else if hfr[1] then begin
        if (i = top) or (i = bot) then begin
          пстрок[66] := '.'; пстрок[128] := '.';
          for k2 := 67 to 127 do пстрок[k2] := '-'
        end else begin
          пстрок[66] := 'I';
          if not (tright and (flde >= 64)) then
            пстрок[128] := 'I'
        end
      end
    end else if fmt = 1 then begin
      if hmcp[0] then begin
        if hfrf then
          mcpframe(i, 0)
      end else if hfrf then begin
        if (i = top) or (i = bot) then begin
          пстрок[2] := '.'; пстрок[128] := '.';
          for k2 := 3 to 127 do пстрок[k2] := '-'
        end else begin
          пстрок[2] := 'I';
          if not (tleft and (flde >= 128)) then
            пстрок[128] := 'I'
        end
      end
    end else begin
      (* формат А: рамка без изменений (узкая страница не действует) *)
      if hfrf then begin
        if (i = top) or (i = bot) then begin
          пстрок[1] := '.'; пстрок[84] := '.';
          for k2 := 2 to 83 do пстрок[k2] := '-'
        end else begin
          пстрок[1] := 'I';
          if not (tleft and (flde >= 84)) then
            пстрок[84] := 'I'
        end
      end
    end;
    (* строка номеров страниц: номер печатается, если он не выключен
       был при начале страницы (номер задаётся *nN, снимается *NN);
       у страницы *MCP номер - в строке верхней рамки + 1, по центру
       поля страницы *)
    if hnum[0] or hnum[1] or hnumf then begin
      if fmt = 0 then begin
        if (i = 3) and sideon[0] and hnum[0] and (not hmcp[0]) then begin
          пстрок[31] := '-';
          putnum(пстрок, 32, hpno[0], 3);
          пстрок[35] := ' '; пстрок[36] := '-'
        end;
        if (i = 3) and sideon[1] and hnum[1] and (not hmcp[1]) then begin
          пстрок[95] := '-';
          putnum(пстрок, 96, np, 3);
          пстрок[99] := ' '; пстрок[100] := '-'
        end;
        if hmcp[0] and (i = mrow[0] + 1) and sideon[0] and hnum[0] then
        begin
          nb := mfl[0] + 4 + (mcwp[0] - 13) div 2;
          пстрок[nb] := '-';
          putnum(пстрок, nb + 1, hpno[0], 3);
          пстрок[nb + 4] := ' '; пстрок[nb + 5] := '-'
        end;
        if hmcp[1] and (i = mrow[1] + 1) and sideon[1] and hnum[1] then
        begin
          nb := mfl[1] + 4 + (mcwp[1] - 13) div 2;
          пстрок[nb] := '-';
          putnum(пстрок, nb + 1, np, 3);
          пстрок[nb + 4] := ' '; пстрок[nb + 5] := '-'
        end
      end else if fmt = 1 then begin
        if hmcp[0] then begin
          if (i = mrow[0] + 1) and hnumf and (hused[0] or final) then
          begin
            nb := mfl[0] + 4 + (mcwp[0] - 13) div 2;
            пстрок[nb] := '-';
            putnum(пстрок, nb + 1, hpno[0], 3);
            пстрок[nb + 4] := ' '; пстрок[nb + 5] := '-'
          end
        end else if (i = 4) and hnumf and (hused[0] or final) then begin
          пстрок[63] := '-';
          putnum(пстрок, 64, hpno[0], 3);
          пстрок[67] := ' '; пстрок[68] := '-'
        end
      end else if (i = 4) and hnumf and hused[0] then begin
        пстрок[42] := '-';
        putnum(пстрок, 43, hpno[0], 3);
        пстрок[46] := ' '; пстрок[47] := '-'
      end
    end;
    (* штамп STP: строка под номером страницы, по центру поля; у
       страницы *MCP - на строке верхней рамки + 2, по центру поля
       узкой страницы *)
    if stpon and (stpl > 0) then begin
      if fmt = 0 then begin
        if stpok[0] and ((not stponly) or pgfirst) then begin
          if hmcp[0] then begin
            if i = mrow[0] + 2 then begin
              st2 := mfl[0] + 4 + (mcwp[0] - 7 - stpl) div 2;
              for k2 := 1 to stpl do пстрок[st2 + k2 - 1] := stp[k2]
            end
          end else if i = stprow then begin
            st2 := defl + (defw - stpl) div 2;
            for k2 := 1 to stpl do пстрок[st2 + k2 - 1] := stp[k2]
          end
        end;
        if stpok[1] and (not stponly) then begin
          if hmcp[1] then begin
            if i = mrow[1] + 2 then begin
              st2 := mfl[1] + 4 + (mcwp[1] - 7 - stpl) div 2;
              for k2 := 1 to stpl do пстрок[st2 + k2 - 1] := stp[k2]
            end
          end else if i = stprow then begin
            st2 := 64 + defl + (defw - stpl) div 2;
            for k2 := 1 to stpl do пстрок[st2 + k2 - 1] := stp[k2]
          end
        end
      end else if stpokf and ((not stponly) or pgfirst) then begin
        if fmt = 2 then begin
          if i = stprow then begin
            st2 := defl + (defw - stpl) div 2;
            for k2 := 1 to stpl do пстрок[st2 + k2 - 1] := stp[k2]
          end
        end else if hmcp[0] then begin
          if i = mrow[0] + 2 then begin
            st2 := mfl[0] + 4 + (mcwp[0] - 7 - stpl) div 2;
            for k2 := 1 to stpl do пстрок[st2 + k2 - 1] := stp[k2]
          end
        end else if i = stprow then begin
          st2 := defl + (defw - stpl) div 2;
          for k2 := 1 to stpl do пстрок[st2 + k2 - 1] := stp[k2]
        end
      end
    end;
    (* подвал STG: строка внизу страницы, над нижним полем; у страницы
       *MCP - на строке верхней рамки + высота - 2 *)
    if stgon and (stgl > 0) and ((not stgonly) or pgfirst) then begin
      if fmt = 0 then begin
        if sideon[0] then begin
          if hmcp[0] then begin
            if i = mrow[0] + mchp[0] - 2 then begin
              st2 := mfl[0] + 4 + (mcwp[0] - 7 - stgl) div 2;
              for k2 := 1 to stgl do пстрок[st2 + k2 - 1] := stg[k2]
            end
          end else if i = strow then begin
            st2 := defl + (defw - stgl) div 2;
            for k2 := 1 to stgl do пстрок[st2 + k2 - 1] := stg[k2]
          end
        end;
        if sideon[1] then begin
          if hmcp[1] then begin
            if i = mrow[1] + mchp[1] - 2 then begin
              st2 := mfl[1] + 4 + (mcwp[1] - 7 - stgl) div 2;
              for k2 := 1 to stgl do пстрок[st2 + k2 - 1] := stg[k2]
            end
          end else if i = strow then begin
            st2 := 64 + defl + (defw - stgl) div 2;
            for k2 := 1 to stgl do пстрок[st2 + k2 - 1] := stg[k2]
          end
        end
      end else begin
        if hmcp[0] then begin
          if i = mrow[0] + mchp[0] - 2 then begin
            st2 := mfl[0] + 4 + (mcwp[0] - 7 - stgl) div 2;
            for k2 := 1 to stgl do пстрок[st2 + k2 - 1] := stg[k2]
          end
        end else if i = strow then begin
          st2 := defl + (defw - stgl) div 2;
          for k2 := 1 to stgl do пстрок[st2 + k2 - 1] := stg[k2]
        end
      end
    end;
    outline(пстрок)
  end;
  pgfirst := false;
  pgspent := true
end;
procedure newsheet;
var
  i, s, k2: integer;
begin
  (* чистота листа: строки, не занятые на прошлом листе, не писались
     с своей последней очистки; достаточно стереть занятые *)
  k2 := hrows[0];
  if hrows[1] > k2 then k2 := hrows[1];
  (* чистка занятых строк присваиванием целой строки (дешевле цикла) *)
  for i := 1 to k2 do begin
    htxt0[i] := бланкp;
    htxt1[i] := бланкh
  end;
  hused[0] := false; hused[1] := false;
  hpno[0] := 0; hpno[1] := 0;
  hrows[0] := 0; hrows[1] := 0;
  rowno := 0;
  clrrow(cur);
  curpos := 1
end;

(* применить геометрию узкой страницы *MCP к текущей странице:
   рамка шириной mcpw по центру места страницы (полулиста в обычном
   формате, всего листа в широком), высотой mcph по центру листа;
   поле текста - внутри рамки (сверено с оригиналом и эталоном
   red-mcp) *)
procedure setmcpage;
begin
  hmcp[side] := true;
  mcwp[side] := mcpw;
  mchp[side] := mcph;
  if fmt = 0 then begin
    mrow[side] := 2 + (66 - mcph) div 2;
    mfl[side] := 64 * side + (64 - mcpw) div 2 + 1;
    flda := (64 - mcpw) div 2 + 5
  end else begin
    mrow[side] := 3 + (66 - mcph) div 2;
    mfl[side] := (128 - mcpw) div 2 + 1;
    flda := mfl[side] + 4
  end;
  fldw := mcpw - 7;
  tmax := mcph - 6;
  (* поле *MCS на узкой странице не действует *)
  mcsset := false
end;

(* начало новой страницы: номер, сторона, штамп *)
procedure pagestart;
begin
  (* отложенная смена формата: текущий лист печатается до смены *)
  if (fmpending >= 0) and (fmpending <> fmt) and
     (hused[0] or hused[1]) then begin
    sheetprint(false);
    newsheet
  end;
  (* отложенная смена формата применяется к новой странице *)
  if fmpending >= 0 then begin
    setfmt(fmpending);
    fmpending := -1
  end;
  if pnext <> 0 then pageno := pnext
  else pageno := pageno + 1;
  pnext := 0;
  (* свежий номер ещё не напечатан *)
  pgspent := false;
  if (fmt = 1) or (fmt = 2) then begin
    (* широкий формат и формат А: лист - одна страница во всю
       ширину, очередная страница печатает предыдущий лист целиком *)
    if hused[0] then begin
      sheetprint(false);
      newsheet
    end;
    side := 0
  end else begin
    side := (pageno - 1) mod 2;
    if (side = 0) and hused[0] then begin
      (* нечётная страница всегда начинает новый лист *)
      sheetprint(false);
      newsheet
    end
  end;
  tabused := false;
  hpno[side] := pageno;
  (* рамка *RG в середине текста действует со следующей страницы *)
  (* номер страницы печатается, если он не был выключен (*NN) к
     началу страницы *)
  if fmt = 0 then begin
    hfr[side] := rgon;
    hnum[side] := numon
  end else begin
    hfrf := rgon;
    hnumf := numon
  end;
  rowno := 0;
  freshpg := true;
  (* геометрия страницы: поле и число строк; узкая страница *MCP
     заменяет поле и высоту (в формате А не действует); поле *MCS
     при смене формата остаётся прежним - берётся зафиксированным
     на момент команды (mcflda), а не от текущего поля формата *)
  if (fmt <> 2) and mcpon then
    setmcpage
  else begin
    hmcp[side] := false;
    if mcson then begin
      flda := mcflda;
      fldw := mcfldw
    end else begin
      flda := defl;
      fldw := defw
    end;
    if fmt = 2 then
      tmax := TRA
    else
      tmax := TRN
  end;
  curpos := curflda;
  (* штамп печатается на странице, если он задан *)
  if fmt = 0 then
    stpok[side] := stpon and (stpl > 0)
  else
    stpokf := stpon and (stpl > 0)
end;

(* конец текущей страницы, начало следующей *)
procedure pageend;
begin
  if (rowno > 0) and (not tabused) then hused[side] := true;
  (* счётчик страниц формата А (аналог *STAND* в ENDPG): исчерпан -
     отложенный возврат к обычному формату; текущий лист ещё не
     напечатан, его допечатает pagestart перед сменой формата *)
  if fmt = 2 then
    if not standinf then
      if standcnt > 0 then begin
        standcnt := standcnt - 1;
        if standcnt = 0 then
          fmpending := 0
      end;
  (* счётчик страниц *MCP (в оригинале - слово STANN): исчерпан -
     обычная геометрия со следующей страницы; широкий формат
     заканчивается вместе с узкими страницами (по эталону red-mcp
     после *RU*2MCP идут страницы обычного формата) *)
  if hmcp[side] then
    if not mcpinf then
      if mcpcnt > 0 then begin
        mcpcnt := mcpcnt - 1;
        if mcpcnt = 0 then begin
          mcpon := false;
          fmpending := 0
        end
      end;
  pagestart
end;

(* ---------------- текущая строка ---------------- *)

(* сдвиг строки r на лист (или в ячейку таблицы) *)
procedure commitrow(var r: rowty; withrl: boolean);
var
  i, k2: integer;
  sv: rowty;   (* копия строки на время pageend: newsheet внутри
                  pageend стирает cur, а r - тот же участок памяти;
                  без копии строка, зафиксированная точно на границе
                  страниц, попадает на новый лист пустой и рамки
                  фигур ДРАКОН обрываются *)
  svd: boolean;
begin
  if incell then begin
    tcln := tcln + 1;
    if tcln <= TCMAX then
      for k2 := 1 to 128 do dmem.tline[tcol][tcln][k2] := r[k2];
    exit
  end;
  svd := false;
  if withrl and (rowno > 0) then
    for i := 1 to rln do begin
      if rowno >= tmax then begin
        if not svd then begin
          sv := r;
          svd := true
        end;
        pageend;
        r := sv
      end;
      (* строка интервала пуста; чистую строку листа писать не нужно *)
      rowno := rowno + 1
    end;
  if rowno >= tmax then begin
    if not svd then
      sv := r;
    pageend;
    r := sv
  end;
  (* строка листа чиста от очистки листа и пишется один раз, поэтому
     достаточно записать непробельные литеры - доступ к упакованной
     строке htxt дорог, а пробел там уже стоит *)
  if side = 0 then begin
    for k2 := 1 to 128 do
      if r[k2] <> ' ' then htxt0[rowno + 1][k2] := r[k2]
  end else begin
    for k2 := 65 to 128 do
      if r[k2] <> ' ' then htxt1[rowno + 1][k2] := r[k2]
  end;
  rowno := rowno + 1;
  freshpg := false;
  if rowno > hrows[side] then hrows[side] := rowno
end;

(* сдвиг текущей строки на лист *)
procedure commit(withrl: boolean);
begin
  if wbrk then begin
    (* строка с частью длинного слова уже записана *)
    wbrk := false;
    exit
  end;
  commitrow(cur, withrl);
  clrrow(cur);
  curpos := curflda;
  indon := false;
  (* новый интервал строк вступает в силу со следующей строки *)
  if rlnpend then begin
    rln := rlnnew;
    rlnpend := false
  end;
  (* новое поле *MCS действует со следующей строки *)
  if mcsset then begin
    flda := mcflda;
    fldw := mcfldw;
    mcsset := false
  end
end;

(* положить слово w длиной ln в строку r с позиции p *)
procedure putword(var r: rowty; var pp: integer; var w: pwty;
                  ln: integer);
var
  i: integer;
begin
  for i := 1 to ln do r[pp + i - 1] := w[i];
  pp := pp + ln
end;

(* выровненная постановка очереди; just - выравнивать по ширине;
   непомещающиеся слова переносятся, длинное слово рвётся *)
procedure flushq(just: boolean);
var
  p, nat, extra, effw, i, g, sh, k2: integer;
  gap: array [1..MRW] of integer;
begin
  if nw = 0 then exit;
  effw := fldw;
  if indon then effw := effw - 3;
  nat := natq;
  for i := 2 to nw do
    gap[i] := rmem.qsp[i];
  if (nat > effw) and (rmem.wl[1] > effw) then begin
    (* слово длиннее строки: разорвать, хвост остаётся в очереди *)
    for i := 1 to effw do cur[curflda + i - 1] := rmem.wt[1][i];
    commit(true);
    wbrk := true;
    sh := effw;
    for i := sh + 1 to rmem.wl[1] do rmem.wt[1][i - sh] := rmem.wt[1][i];
    rmem.wl[1] := rmem.wl[1] - sh;
    rmem.wrc[1] := 0;
    natq := rmem.wl[1];
    exit
  end;
  p := curflda;
  if indon then p := p + 3;
  extra := 0;
  if just and fillon and (nw > 1) then extra := effw - nat;
  for i := 1 to nw do begin
    putword(cur, p, rmem.wt[i], rmem.wl[i]);
    if i < nw then begin
      g := gap[i + 1];
      (* лишние пробелы выравнивания: поровну во все промежутки и
         остаток - в последние; единственный лишний пробел оригинал
         ставит во второй с конца промежуток *)
      if extra > 0 then begin
        if (extra = 1) and (nw > 2) then begin
          if i = nw - 2 then g := g + 1
        end else begin
          k2 := extra div (nw - 1);
          if k2 > 0 then g := g + k2;
          k2 := extra mod (nw - 1);
          if (k2 > 0) and (i > nw - 1 - k2) then g := g + 1
        end
      end;
      p := p + g
    end
  end;
  curpos := p + 1;
  nw := 0;
  natq := 0;
  indon := false
end;

(* конец строки: очередь без выравнивания и сдвиг *)
procedure endline;
begin
  flushq(false);
  commit(true)
end;

(* n пустых строк текста *)
procedure empties(cnt: integer);
var
  i: integer;
begin
  for i := 1 to cnt do begin
    clrrow(cur);
    curpos := curflda;
    commit(false)
  end
end;

(* очередное слово в очередь; если слово не входит в строку,
   строка закрывается с выравниванием *)
procedure addword;
var
  n2: integer;
begin
  if wleng = 0 then exit;
  (* естественная ширина: накопленная очередь и новое слово *)
  n2 := natq;
  if nw > 0 then
    n2 := n2 + spcnt + wleng
  else
    n2 := n2 + wleng;
  if indon then n2 := n2 + 3;
  if (n2 > fldw) and (nw > 0) then begin
    flushq(true);
    commit(true)
  end;
  nw := nw + 1;
  rmem.wt[nw] := rmem.word;
  rmem.wl[nw] := wleng;
  rmem.wrc[nw] := wrcl;
  if nw > 1 then begin
    (* число пробелов перед словом (в оригинале несколько пробелов
       сохраняются) *)
    rmem.qsp[nw] := spcnt;
    natq := natq + rmem.qsp[nw]
  end;
  spcnt := 0;
  natq := natq + wleng;
  wleng := 0;
  wrcl := rcn;
  if nw >= MRW then begin
    flushq(true);
    commit(true)
  end
end;

(* литера текста; без переноса по словам - прямо в строку *)
procedure addch(c: char);
var
  i: integer;
begin
  if posmode or not fillon then begin
    if (not posmode) and (curpos > curflda + fldw - 1) then begin
      (* режим *OLR: перенос по словам выключен, строка переходит
         при заполнении *)
      commit(true);
      curpos := curflda
    end;
    if (not posmode) and (curpos = curflda) and indon then
      curpos := curflda + 3;
    if curpos <= 128 then begin
      cur[curpos] := c;
      curpos := curpos + 1
    end;
    exit
  end;
  if c = ' ' then begin
    addword;
    (* разрядка добавляет пробелы после каждой литеры, в том числе
       после пробела *)
    spcnt := spcnt + 1 + rcn;
    exit
  end;
  if wleng = 0 then wrcl := rcn;
  if wleng >= 99 then addword;
  wleng := wleng + 1;
  rmem.word[wleng] := c;
  (* разрядка: n пробелов после каждой литеры слова *)
  if rcn > 0 then
    for i := 1 to rcn do begin
      if wleng >= 99 then addword;
      wleng := wleng + 1;
      rmem.word[wleng] := ' '
    end
end;

procedure scancard; forward;


(* ---------------- команды позиционирования ---------------- *)

(* числовой префикс или параметр с карты *)
function readnum(var val: integer): boolean;
var
  v: integer;
  any: boolean;
begin
  v := 0;
  any := false;
  while (cpos <= cwv) and (card[cpos] = ' ') do cpos := cpos + 1;
  while (cpos <= cwv) and (card[cpos] >= '0') and (card[cpos] <= '9')
     do begin
    v := v * 10 + (ord(card[cpos]) - 48);
    cpos := cpos + 1;
    any := true
  end;
  val := v;
  readnum := any
end;

(* *nFc: литера заполняет остаток строки и ещё n-1 строк *)
procedure fillrest(c: char; n: integer);
var
  fe, i, j: integer;
  r: rowty;
begin
  flushq(false);
  fe := curflda + fldw - 1;
  for i := curpos to fe do cur[i] := c;
  commit(true);
  for j := 2 to n do begin
    clrrow(r);
    for i := curflda to fe do r[i] := c;
    commitrow(r, true)
  end
end;

(* *nRFc: литера заполняет строку до позиции n поля *)
procedure fillto(np: integer; c: char);
var
  fe, i: integer;
begin
  flushq(false);
  fe := curflda + np - 1;
  if fe > curflda + fldw - 1 then klaida(80);
  if fe >= curpos then
    for i := curpos to fe do cur[i] := c;
  curpos := fe + 1
end;

(* *nCc / *Knc: повторить литеру n раз с текущей позиции *)
procedure putrep(c: char; n: integer);
var
  fe, i: integer;
begin
  flushq(false);
  fe := curflda + fldw - 1;
  for i := 1 to n do begin
    if curpos > fe then exit;
    cur[curpos] := c;
    curpos := curpos + 1
  end
end;

(* *n(текст) и *nWтекст): повторение текста до скобки;
   one=true - весь текст одним словом *)
procedure group(rep: integer; one: boolean);
var
  buf: carty;
  bn, i, k2: integer;
  c: char;
begin
  bn := 0;
  while cpos <= cwv do begin
    c := card[cpos];
    cpos := cpos + 1;
    if c = ')' then begin
      if one then begin
        for k2 := 1 to rep do
          for i := 1 to bn do begin
            if wleng >= 99 then addword;
            wleng := wleng + 1;
            rmem.word[wleng] := buf[i]
          end;
        wrcl := 0;
        addword
      end else begin
        (* повтор текста без разделителя *)
        for k2 := 1 to rep do
          for i := 1 to bn do addch(buf[i]);
        addword
      end;
      exit
    end;
    if bn < 72 then begin
      bn := bn + 1;
      buf[bn] := c
    end
  end
end;

(* *nH: следующие n литер как есть дописываются к слову *)
procedure hword(cnt: integer);
var
  i: integer;
begin
  for i := 1 to cnt do begin
    if cpos > cwv then exit;
    if wleng >= 99 then addword;
    wleng := wleng + 1;
    rmem.word[wleng] := card[cpos];
    cpos := cpos + 1
  end
end;

(* *D: остаток карты выводится как есть *)
procedure verbatim;
var
  i: integer;
begin
  flushq(false);
  for i := cpos to cwv do begin
    if curpos > 128 then exit;
    cur[curpos] := card[i];
    curpos := curpos + 1
  end
end;

(* центрирование остатка карты (с позиции from) в поле *)
procedure centerrest(from: integer);
var
  r: rowty;
  ln, stc, i: integer;   (* stc: st - поле оверлея rmem (статика *DRK) *)
begin
  ln := 0;
  for i := from to cwv do
    if card[i] <> ' ' then ln := i - from + 1;
  if ln > 0 then begin
    clrrow(r);
    stc := curflda + (fldw - ln) div 2;
    for i := 1 to ln do r[stc + i - 1] := card[from + i - 1];
    commitrow(r, true)
  end
end;

(* дописать текущий лист и начать новый в формате f *)
procedure newfmt(f: integer; dop: boolean);
begin
  (* *RU без единичного префикса не допечатывает текущий лист:
     пустой лист просто заменяется (SIPROD.md, таблица команд);
     *1RU - сначала допечатать (dop=true) *)
  flushq(false);
  if (rowno > 0) or (curpos > curflda) or dop then begin
    commit(true);
    hused[side] := true;
    sheetprint(false);
    (* пустая правая половина листа всё равно считается страницей *)
    if (not hused[1]) and (fmt = 0) then pageno := pageno + 1
  end else if not pgspent then
    (* лист не печатался и его номер не напечатан - номер страницы
       не тратим (*P перед сменой формата); после печатанного листа
       нумерация продолжается (границы блоков задания) *)
    pnext := pageno;
  newsheet;
  if fir then begin
    (* первая карта блока разбирается FIRCAR до начала страницы:
       формат действует немедленно *)
    setfmt(f);
    pagestart
  end else begin
    (* смена формата в середине текста - с новой страницы:
       формат применит очередной pagestart *)
    fmpending := f;
    freshpg := true;
    pagestart
  end
end;

(* ---------------- таблицы ---------------- *)

(* разбор карты *ST (колонки) или *SL (линейки) *)
procedure tabledef(withline: boolean);
var
  nums: array [1..16] of integer;
  nnums, i, v, a, b: integer;
  loop: boolean;
begin
  (* таблица внутри ячейки таблицы - ошибка 60 *)
  if incell then klaida(60);
  flushq(false);
  commit(true);
  if not withline then
    cpos := cpos + 1;   (* литера T в ST *)
  nnums := 0;
  loop := true;
  while loop do begin
    while (cpos <= cwv) and (card[cpos] = ' ') do cpos := cpos + 1;
    if cpos > cwv then loop := false
    else if (card[cpos] < '0') or (card[cpos] > '9') then
      klaida(61)
    else begin
      v := 0;
      while (cpos <= cwv) and (card[cpos] >= '0') and (card[cpos] <=
         '9') do begin
        v := v * 10 + (ord(card[cpos]) - 48);
        cpos := cpos + 1
      end;
      nnums := nnums + 1;
      if nnums <= 16 then nums[nnums] := v
    end
  end;
  if withline then begin
    (* SL: линейки в позициях, колонки между ними *)
    if nnums < 2 then klaida(62);
    tbn := nnums;
    tbn2 := nnums - 1;
    for i := 1 to nnums do begin
      if nums[i] > fldw then klaida(64);
      tslpos[i] := curflda + nums[i] - 1
    end;
    for i := 1 to nnums - 1 do begin
      tbda[i] := tslpos[i] + 1;
      tbdw[i] := tslpos[i + 1] - tslpos[i] - 1;
      if tbdw[i] <= 0 then klaida(64)
    end
  end else begin
    (* ST: пары начало-конец *)
    if nnums mod 2 <> 0 then klaida(62);
    tbn2 := nnums div 2;
    tbn := 0;
    for i := 1 to nnums div 2 do begin
      a := nums[2 * i - 1];
      b := nums[2 * i];
      if b > fldw then klaida(64);
      tbda[i] := curflda + a - 1;
      tbdw[i] := b - a + 1;
      if tbdw[i] <= 0 then klaida(64)
    end
  end;
  tabon := true;
  tabline := withline;
  tcol := 0;
  trows := 0;
  tcln := 0;
  incell := false;
  for i := 1 to 8 do begin
    tcnt[i] := 0;
    prevnd[i] := false;
    предолж[i] := false;
    предорн[i] := false
  end;
  prevrows := 0
end;

(* вертикаль на стыке j в строке из n ячеек с флагами rownol/rownr:
   на левом краю - левая линия первой ячейки, внутри - общая линия
   соседних ячеек (её убирают *NR слева и *NL справа), на правом краю -
   правая линия последней ячейки *)
function вертcur(j, n: integer): boolean;
begin
  вертcur := false;
  if (n >= 1) and (j >= 1) and (j <= n + 1) then begin
    if j = 1 then вертcur := not rownol[1]
    else if j = n + 1 then вертcur := not rownr[n]
    else вертcur := (not rownr[j - 1]) and (not rownol[j])
  end
end;

(* то же для предыдущей строки (флаги предолж/предорн) *)
function вертпред(j, n: integer): boolean;
begin
  вертпред := false;
  if (n >= 1) and (j >= 1) and (j <= n + 1) then begin
    if j = 1 then вертпред := not предолж[1]
    else if j = n + 1 then вертпред := not предорн[n]
    else вертпред := (not предорн[j - 1]) and (not предолж[j])
  end
end;

(* выдача строки таблицы: линейка сверху, затем ячейки рядом *)
procedure tablerow;
var
  r: rowty;
  h, i, k2, j: integer;
  vis: boolean;
begin
  h := 0;
  for k2 := 1 to trows do
    if tcnt[k2] > h then h := tcnt[k2];
  if tabline and (h > 0) then begin
    clrrow(r);
    for j := tslpos[1] to tslpos[tbn] do r[j] := '-';
    (* вертикаль на стыке: линейка над завершённой строкой - стык
       рисуется, если он есть в этой строке или в предыдущей (в первой
       линейке - только в завершённой); где вертикали нет, горизонт
       прерывается *)
    for j := 1 to tbn do begin
      vis := вертcur(j, trows);
      if prevrows > 0 then vis := vis or вертпред(j, prevrows);
      if vis then r[tslpos[j]] := 'I'
      else r[tslpos[j]] := ' '
    end;
    (* отрезки: *NU ячейки убирает её верхнюю линию (над строкой),
       *ND предыдущей строки - нижнюю *)
    for k2 := 1 to trows do
      if rownu[k2] or prevnd[k2] then
        for j := tslpos[k2] + 1 to tslpos[k2 + 1] - 1 do
          r[j] := ' ';
    tabused := true;
    commitrow(r, true)
  end;
  for i := 1 to h do begin
    clrrow(r);
    for k2 := 1 to trows do
      if i <= tcnt[k2] then
        for j := 1 to tbdw[k2] do
          r[tbda[k2] + j - 1] := dmem.tline[k2][i][tbda[k2] + j - 1];
    if tabline then
      for j := 1 to trows + 1 do begin
        vis := true;
        if (j <= trows) and rownol[j] then vis := false;
        if (j > 1) and rownr[j - 1] then vis := false;
        if (j <= tbn) and vis then r[tslpos[j]] := 'I'
      end;
    commitrow(r, true)
  end;
  (* флаги завершённой строки станут «верхними» для следующей линейки *)
  for k2 := 1 to trows do begin
    предолж[k2] := rownol[k2];
    предорн[k2] := rownr[k2];
    prevnd[k2] := rownd[k2]
  end;
  prevrows := trows;
  for k2 := 1 to 8 do tcnt[k2] := 0
end;

(* закрытие текущей ячейки *)
procedure cellend;
begin
  flushq(false);
  commit(true);
  incell := false;
  rownol[tcol] := cnol;
  rownr[tcol] := cnr;
  rownu[tcol] := cnu;
  rownd[tcol] := cnd;
  tcnt[tcol] := tcln;
  flda := svflda;
  fldw := svfldw
end;

(* открытие ячейки k *)
procedure cellstart(k2: integer);
begin
  if incell then cellend;
  if (k2 <= tcol) and (tcol > 0) then begin
    (* возврат к меньшему номеру колонки - новая строка таблицы *)
    tablerow;
    trows := 0;
    tcol := 0
  end;
  if k2 > trows then trows := k2;
  if k2 > tbn2 then klaida(66);
  tcol := k2;
  tcln := 0;
  incell := true;
  cnol := false; cnr := false; cnu := false; cnd := false;
  svflda := flda;
  svfldw := fldw;
  (* в таблице с линейками текст ячейки отступается от вертикали,
     в таблице без линеек - начинается с начала колонки *)
  if tabline then begin
    flda := tbda[k2] + 1;
    fldw := tbdw[k2] - 1
  end else begin
    flda := tbda[k2];
    fldw := tbdw[k2]
  end;
  indon := false;
  clrrow(cur);
  curpos := curflda
end;

(* конец таблицы по карте с долларом *)
procedure tabledone;
var
  r: rowty;
  i, j, k2: integer;
begin
  if incell then cellend;
  if trows > 0 then tablerow;
  if tabline and (tbn >= 2) and (trows > 0) then begin
    clrrow(r);
    for j := tslpos[1] to tslpos[tbn] do r[j] := '-';
    (* нижняя линейка: вертикали последней строки (снизу строки нет) *)
    for j := 1 to tbn do begin
      if вертcur(j, trows) then r[tslpos[j]] := 'I'
      else r[tslpos[j]] := ' '
    end;
    for k2 := 1 to trows do
      if rownd[k2] then
        for j := tslpos[k2] + 1 to tslpos[k2 + 1] - 1 do
          r[j] := ' ';
    commitrow(r, true)
  end else if (not tabline) and (trows > 0) then begin
    (* таблица без линеек заканчивается пустой строкой *)
    clrrow(r);
    commitrow(r, false)
  end;
  tabon := false;
  incell := false;
  trows := 0;
  tcol := 0
end;

(* маркер ячейки в середине карты: пробел, цифры, скобка; значение
   не больше числа колонок таблицы (иначе это текст ячейки).
   Возврат - позиция пробела перед маркером или 0 *)
function cellmark: integer;
var
  p, q, v: integer;
begin
  cellmark := 0;
  p := cpos;
  while p < cwv do begin
    if (card[p] = ' ') and (card[p + 1] >= '1') and
       (card[p + 1] <= '9') then begin
      v := ord(card[p + 1]) - 48;
      q := p + 2;
      if (q <= cwv) and (card[q] >= '0') and
         (card[q] <= '9') then begin
        v := v * 10 + ord(card[q]) - 48;
        q := q + 1
      end;
      if (q <= cwv) and (card[q] = ')') and (v <= tbn2) then begin
        cellmark := p;
        exit
      end
    end;
    p := p + 1
  end
end;

(* хвост карты в режиме таблицы: текст до серединного маркера
   " k)" идет в текущую ячейку, затем смена колонки (титульный
   лист записки: " 1)РУКОВОДИТЕЛЬ РАБОТЫ 2)ИСПОЛНИТЕЛЬ"); макро в
   ячейке раскрываются после смены колонки - таких ячеек в
   документе нет *)
procedure tailcells;
var
  mp, q, v, sv: integer;
begin
  mp := cellmark;
  while mp <> 0 do begin
    (* текст до маркера - текущая ячейка *)
    sv := cwv;
    cwv := mp - 1;
    scancard;
    cwv := sv;
    (* маркер: цифры и скобка с позиции mp + 1 *)
    q := mp + 1;
    v := 0;
    while (q <= cwv) and (card[q] >= '0') and
          (card[q] <= '9') do begin
      v := v * 10 + (ord(card[q]) - 48);
      q := q + 1
    end;
    cpos := q + 1;
    cellstart(v);
    mp := cellmark
  end;
  scancard
end;

(* карта в режиме таблицы: ячейка k), продолжение или доллар *)
procedure tablecard;
var
  k2, v: integer;
  iscell: boolean;
  pp: integer;
begin
  if card[1] = '$' then begin
    tabledone;
    cpos := cwv + 1;
    exit
  end;
  pp := 1;
  while (pp <= CW) and (card[pp] = ' ') do pp := pp + 1;
  iscell := false;
  k2 := 0;
  if (pp <= CW) and (card[pp] >= '0') and (card[pp] <= '9') then begin
    v := 0;
    while (pp <= CW) and (card[pp] >= '0') and (card[pp] <= '9') do
       begin
      v := v * 10 + (ord(card[pp]) - 48);
      pp := pp + 1
    end;
    if (pp <= CW) and (card[pp] = ')') then begin
      iscell := true;
      k2 := v
    end
  end;
  if iscell then begin
    cpos := pp + 1;
    cellstart(k2);
    tailcells
  end else if incell then begin
    (* продолжение ячейки *)
    cpos := 1;
    tailcells
  end else
    klaida(66)
end;

(* ---------------- макроопределения ---------------- *)

(* *nM=: тело до знака доллара, может занимать несколько карт *)
procedure macdef;
var
  c: char;
  done: boolean;
  i: integer;
begin
  if nn1 <> mkcnt + 1 then klaida(91);
  mkcnt := mkcnt + 1;
  mkbl := 0;
  done := false;
  while not done do begin
    while (cpos <= cwv) and (not done) do begin
      c := card[cpos];
      cpos := cpos + 1;
      if c = '$' then
        done := true
      else if mkbl < MKLEN then begin
        mkbl := mkbl + 1;
        rmem.mkbuf[mkbl] := c
      end
    end;
    if not done then begin
      getcard;
      if eofin then klaida(91)
    end
  end;
  for i := 1 to MKLEN do mktx[mkcnt][i] := ' ';
  for i := 1 to mkbl do mktx[mkcnt][i] := rmem.mkbuf[i];
  mkln[mkcnt] := mkbl
end;

(* *nM: вставка макро n.  Раскрытие БЕЗ рекурсии: scancard -> command
   -> macins -> scancard переполняла стек времени исполнения 15.1
   (OVERANGE).  macins лишь запоминает прерванную карту (mksav/mksl/
   mksq) и кладёт в card первый кусок тела; сканирование продолжается
   в текущем вызове scancard.  Окончание куска, продолжение
   прерванной карты и снятие уровня делает macstep из главного цикла.
   Состояние уровней: mknum/mkpp/mkres, глубина mksp <= TCDEEP. *)
procedure macins;
var
  ln, i: integer;
begin
  if (nn1 < 1) or (nn1 > mkcnt) then begin
    klaida(91);
    exit
  end;
  if mksp >= TCDEEP then begin
    klaida(91);
    exit
  end;
  if tabon or listing then begin
    (* в таблицах и листингах макросы не раскрываются *)
    klaida(91);
    exit
  end;
  mksp := mksp + 1;
  (* вложенный макрос: продолжение внешней карты после раскрытия
     теряется - как в оригинале *)
  if mksp > 1 then rmem.mknest[mksp - 1] := true;
  rmem.mknest[mksp] := false;
  rmem.mksav[mksp] := card;
  rmem.mksl[mksp] := cwv;
  rmem.mksq[mksp] := cpos;
  rmem.mknum[mksp] := nn1;
  rmem.mkpp[mksp] := 1;
  rmem.mkres[mksp] := false;
  (* первый кусок тела - в card, сканирует текущий вызов scancard *)
  ln := mkln[nn1];
  if ln > CW then ln := CW;
  for i := 1 to 80 do card[i] := ' ';
  for i := 1 to ln do card[i] := mktx[nn1][i];
  cwv := ln;
  cpos := 1;
  rmem.mkpp[mksp] := ln + 1
end;

(* шаг раскрытия макро из главного цикла: очередной кусок тела,
   продолжение прерванной карты или снятие уровня *)
procedure macstep;
var
  ln, i: integer;
begin
  if rmem.mkpp[mksp] <= mkln[rmem.mknum[mksp]] then begin
    (* следующий кусок тела макро *)
    ln := mkln[rmem.mknum[mksp]] - rmem.mkpp[mksp] + 1;
    if ln > CW then ln := CW;
    for i := 1 to 80 do card[i] := ' ';
    for i := 1 to ln do
      card[i] := mktx[rmem.mknum[mksp]][rmem.mkpp[mksp] + i - 1];
    cwv := ln;
    cpos := 1;
    rmem.mkpp[mksp] := rmem.mkpp[mksp] + ln;
    scancard
  end else if not rmem.mkres[mksp] then begin
    (* тело исчерпано: продолжить прерванную карту *)
    rmem.mkres[mksp] := true;
    card := rmem.mksav[mksp];
    cwv := rmem.mksl[mksp];
    cpos := rmem.mksq[mksp];
    (* хвостовые пробелы тела макроса отбрасываются *)
    spcnt := 0;
    if rmem.mknest[mksp] then
      (* после вложенного макроса продолжение карты теряется *)
      cwv := cpos - 1;
    scancard
  end else begin
    rmem.mknest[mksp] := false;
    mksp := mksp - 1
  end
end;

(* ---------------- листинг программ ---------------- *)

(* карта режима *MF: печать как есть с позиции c+3 *)
procedure listcard;
var
  r: rowty;
  i: integer;
  isend: boolean;
begin
  if (card[1] = '/') and (card[2] = '/') and (card[3] = '/') then begin
    listing := false;
    (* конец листинга - пустая строка *)
    clrrow(r);
    commitrow(r, false);
    exit
  end;
  clrrow(r);
  for i := 1 to CW do
    if card[i] <> ' ' then r[i + 3] := card[i];
  commitrow(r, false);
  isend := false;
  i := 1;
  while (i <= CW - 2) and (card[i] = ' ') do i := i + 1;
  if (card[i] = 'E') and (card[i + 1] = 'N') and (card[i + 2] = 'D') and
     ((i + 2 = CW) or (card[i + 3] = ' ') or (card[i + 3] = '.')) then
    isend := true;
  if isend then begin
    clrrow(r);
    commitrow(r, false);
    commitrow(r, false)
  end
end;

(* ================= схема ДРАКОН, блок *DRK ================= *)

(* Трансляция схем ДРАКОН встроена в редактор как режим верхнего
   уровня: ключ блока *DRK стоит наравне с *RED в диспетчере (в
   оригинальном СИПРОДе - таблица SCHEMA /0747B).  Алгоритм тот же,
   что в standalone-трансляторе drakon.pas и эталонном генераторе
   tools/drakon_markup.py: разбор текста по отступам, перенос
   подписей, компоновка икон по колонкам, рисование шести видов
   икон с соединениями.  Отличие - выдача: не карты разметки
   * /*D, а строки рисунка прямо через механизм листа редактора
   (commitrow), поэтому рамки на границах страниц, номера и штампы
