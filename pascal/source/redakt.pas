(* распознавание ключевого слова: индекс или 0; ml - длина
   совпавшего слова (полного или краткого) - по ней отрезается
   подпись, для краткой формы она не равна kwl[индекса] *)
function detect(var s: carty; ln: integer; var ml: integer): integer;
var
  i, j, res: integer;
  ok: boolean;
begin
  res := 0;
  i := 1;
  while (i <= DTKW) and (res = 0) do begin
    if (ln > 0) and (ln >= rmem.kwl[i]) then begin
      ok := true;
      j := 1;
      while (j <= rmem.kwl[i]) and ok do begin
        if s[j] <> rmem.kw[i][j] then
          ok := false;
        j := j + 1
      end;
      if ok then begin
        res := i;
        ml := rmem.kwl[i]
      end
    end;
    i := i + 1
  end;
  (* краткие формы - после полных: полная форма всегда понимается
     как полная *)
  i := 1;
  while (i <= NAK) and (res = 0) do begin
    if (ln >= 2) and (s[1] = rmem.ali[i][1]) and
       (s[2] = rmem.ali[i][2]) then begin
      res := rmem.almap[i];
      ml := 2
    end;
    i := i + 1
  end;
  detect := res
end;

(* новый узел схемы с привязкой к дереву по отступам *)
procedure newnode(k: integer; var s: carty; sl, ind, ln: integer);
var
  i: integer;
  done: boolean;
begin
  if rmem.ncnt >= NDMAX then
    rmem.ncnt := NDMAX;
  rmem.ncnt := rmem.ncnt + 1;
  rmem.nkind[rmem.ncnt] := k;
  rmem.ntl[rmem.ncnt] := ln;
  for i := 1 to ln do rmem.ntext[rmem.ncnt][i] := s[sl + i - 1];
  rmem.nkid[rmem.ncnt] := 0;
  rmem.nbro[rmem.ncnt] := 0;
  rmem.nbr[rmem.ncnt] := 0;
  rmem.nxt[rmem.ncnt] := 0;
  done := false;
  while (rmem.stn > 0) and (not done) do begin
    if rmem.sti[rmem.stn] >= ind then
      rmem.stn := rmem.stn - 1
    else
      done := true
  end;
  if rmem.stn = 0 then begin
    if rmem.nroot = 0 then
      rmem.nroot := rmem.ncnt
    else
      rmem.nbro[rmem.last0] := rmem.ncnt;
    rmem.last0 := rmem.ncnt
  end else begin
    if rmem.nkid[rmem.st[rmem.stn]] = 0 then
      rmem.nkid[rmem.st[rmem.stn]] := rmem.ncnt
    else
      rmem.nbro[rmem.stl[rmem.stn]] := rmem.ncnt;
    rmem.stl[rmem.stn] := rmem.ncnt
  end;
  (* контейнеры: ЕСЛИ ЦИКЛ ВЫБОР ВАРИАНТ ТО ИНАЧЕ ДЛЯ *)
  if (k = 5) or (k = 6) or (k = 7) or (k = 8) or
     (k = 11) or (k = 12) or (k = 15) then begin
    rmem.stn := rmem.stn + 1;
    rmem.st[rmem.stn] := rmem.ncnt;
    rmem.sti[rmem.stn] := ind
  end
end;

(* длина значимой части карты *)
function linelen: integer;
var
  i: integer;
begin
  linelen := 0;
  for i := 1 to CW do
    if card[i] <> ' ' then
      linelen := i
end;

(* число ведущих пробелов карты.
   Результат функции нельзя читать в выражениях (ошибка
   компилятора 15.1 - порча стека), счёт в локальной j *)
function indent: integer;
var
  j: integer;
begin
  j := 0;
  while (j < CW) and (card[j + 1] = ' ') do
    j := j + 1;
  indent := j
end;

(* пропуск пробелов и двоеточия после ключевого слова *)
procedure skiphead(var p: integer; ln: integer; var s: carty);
begin
  while (p <= ln) and (s[p] = ' ') do
    p := p + 1;
  if (p <= ln) and (s[p] = ':') then begin
    p := p + 1;
    while (p <= ln) and (s[p] = ' ') do
      p := p + 1
  end
end;

(* разбор текущей карты исходника (как parse в drakon.pas, но
   одна карта: карты подаёт главный цикл блока *DRK) *)
procedure drkcard;
var
  i, ind, k, p, ln, tl, ml: integer;
  txt: carty;
begin
  ind := indent;
  ln := linelen;
  if (ln > 0) and (card[ind + 1] <> '*') then begin
    for i := 1 to ln do txt[i] := card[ind + i];
    k := detect(txt, ln, ml);
    if k > 0 then begin
      p := ml + 1;
      skiphead(p, ln, txt);
      tl := 0;
      for i := p to ln do
        if txt[i] <> ' ' then
          tl := i - p + 1;
      newnode(k, txt, p, ind, tl)
    end else begin
      (* неизвестное слово: текст после первого слова *)
      p := 1;
      while (p <= ln) and (txt[p] <> ' ') and
            (txt[p] <> ':') do
        p := p + 1;
      skiphead(p, ln, txt);
      tl := 0;
      for i := p to ln do
        if txt[i] <> ' ' then
          tl := i - p + 1;
      newnode(0, txt, p, ind, tl)
    end
  end
end;

(* ---------------- иконы ---------------- *)

(* вид иконы по рис. 4 книги Паронджанова:
   0 действие (прямоугольник), 1 заголовок (полуовал), 2 имя ветки
   (щит), 3 вопрос (шестиугольник), 4 конец (полуовал), 5 адрес
   (домик), 6 выбор (параллелограмм), 7 вариант (прямоугольник
   с клином), 8 комментарий (двойная рамка с полуовалом), 9 полка,
   10 формальные параметры, 11 начало цикла ДЛЯ, 12 конец цикла ДЛЯ,
   13 вывод, 14 ввод, 15 пауза, 16 период, 17 пуск таймера,
   18 синхронизатор, 19 параллельный процесс, 20 правый
   комментарий, 21 левый комментарий, 22 петля цикла, 23 петля
   силуэта (гребёнка), 24 вставка *)
function kindof(n: integer): integer;
var
  k, res: integer;
begin
  k := rmem.nkind[n];
  res := 0;
  if k = 1 then
    res := 1
  else if k = 2 then
    res := 2
  else if (k = 5) or (k = 6) then
    res := 3
  else if k = 10 then
    res := 4
  else if k = 9 then
    res := 5
  else if k = 7 then
    res := 6
  else if k = 8 then
    res := 7
  else if k = 4 then
    res := 8
  else if k = 13 then
    res := 9
  else if k = 14 then
    res := 10
  else if k = 15 then
    res := 11
  else if k = 16 then
    res := 12
  else if k = 17 then
    res := 13
  else if k = 18 then
    res := 14
  else if k = 19 then
    res := 15
  else if k = 20 then
    res := 16
  else if k = 21 then
    res := 17
  else if k = 22 then
    res := 18
  else if k = 23 then
    res := 19
  else if k = 24 then
    res := 20
  else if k = 25 then
    res := 21
  else if k = 26 then
    res := 22
  else if k = 27 then
    res := 23
  else if k = 28 then
    res := 24;
  kindof := res
end;

procedure put(x, y: integer; c: char);
begin
  if (y >= 1) and (y <= DRMAX) and (x >= 1) and (x <= DCMAX) then
    dmem.pic[y][x] := c
end;

(* текст в поле ширины fw с позиции x, строка r; центрирование
   как в эталоне: лишний пробел при нечётных поле и остатке
   ставится слева *)
procedure ctext(x, fw, r: integer; var t: p80; tl: integer);
var
  i, left: integer;
begin
  left := (fw - tl) div 2;
  if (odd(fw - tl)) and (odd(fw)) then
    left := left + 1;
  for i := 1 to tl do
    put(x + left + i - 1, r, t[i])
end;

procedure dash(x, y, ln: integer; c: char);
var
  i: integer;
begin
  for i := 1 to ln do
    put(x + i - 1, y, c)
end;

(* горизонтальная грань: угол, тире, угол *)
procedure hrun(x, y, ln: integer; lc, rc: char);
begin
  put(x, y, lc);
  dash(x + 1, y, ln - 2, '-');
  put(x + ln - 1, y, rc)
end;

(* разложить подпись gtxt длиной tl на строки wtx/wln;
   ширина поля - wwd *)
procedure wraptl(tl: integer);
var
  i, j, cur: integer;
  nl: boolean;
begin
  rmem.nwl := 0;
  cur := 0;
  for i := 1 to rmem.nwd do begin
    (* НЕ писать «(cur = 0) or (wln[cur] + ... > wwd)»: компилятор 15.1
       не гарантирует короткое замыкание, при cur = 0 читается и
       пишется wln[0]/wtx[0] вне массива - портятся соседние
       переменные, слова подписи теряются *)
    nl := true;
    if cur > 0 then
      if rmem.wln[cur] + 1 + rmem.wwp[i] <= rmem.wwd then
        nl := false;
    if nl then begin
      cur := cur + 1;
      rmem.wln[cur] := 0
    end else begin
      rmem.wln[cur] := rmem.wln[cur] + 1;
      rmem.wtx[cur][rmem.wln[cur]] := ' '
    end;
    for j := 1 to rmem.wwp[i] do begin
      rmem.wtx[cur][rmem.wln[cur] + j] := rmem.gtxt[rmem.wsp[i] + j - 1];
    end;
    rmem.wln[cur] := rmem.wln[cur] + rmem.wwp[i]
  end;
  rmem.nwl := cur;
  if rmem.nwl = 0 then begin
    rmem.nwl := 1;
    rmem.wln[1] := 0
  end
end;

(* слова подписи: wsp/wwp, самое длинное слово -> wwd *)
procedure splitw(tl: integer);
var
  i: integer;
begin
  rmem.nwd := 0;
  i := 1;
  while i <= tl do begin
    while (i <= tl) and (rmem.gtxt[i] = ' ') do
      i := i + 1;
    if i <= tl then begin
      rmem.nwd := rmem.nwd + 1;
      rmem.wsp[rmem.nwd] := i;
      while (i <= tl) and (rmem.gtxt[i] <> ' ') do
        i := i + 1;
      rmem.wwp[rmem.nwd] := i - rmem.wsp[rmem.nwd];
      if rmem.wwp[rmem.nwd] > rmem.wwd then
        rmem.wwd := rmem.wwp[rmem.nwd]
    end
  end
end;

(* подпись узла в gtxt, разбор на слова, ширина поля wwd:
   АДАПТИВНО к количеству текста - короткая подпись даёт узкую
   икону (поле от 5 знаков), подпись до WMAXLINE держится в одну
   строку, длинная делится на равные доли.  Поле однострочной
   подписи той же чётности, что и подпись: пробелов слева и
   справа от надписи поровну (ctext при нечётном остатке кладёт
   лишний пробел влево - при нечётном поле неравенство было бы
   в каждой второй иконе).  Поле многострочной подписи нечётное:
   одна средняя колонка, вершины клиньев и острия прилегают к
   оси шампура ровно *)
procedure settext(n: integer);
var
  i, tl, L, tg: integer;
begin
  tl := rmem.ntl[n];
  for i := 1 to tl do rmem.gtxt[i] := rmem.ntext[n][i];
  rmem.wwd := MINW;
  splitw(tl);
  if tl > WMAXLINE then begin
    (* длинная подпись: строки равных долей *)
    L := (tl + WMAXLINE - 1) div WMAXLINE;
    tg := (tl + L - 1) div L;
    if tg > rmem.wwd then
      rmem.wwd := tg
  end else if tl > rmem.wwd then
    rmem.wwd := tl;
  if tl <= WMAXLINE then begin
    if odd(rmem.wwd - tl) then
      rmem.wwd := rmem.wwd + 1
  end else if (rmem.wwd mod 2) = 0 then
    rmem.wwd := rmem.wwd + 1
end;

(* подогнать поле под подпись: слова могут не упаковаться в
   намеченные строки - расширять поле, пока перенос не уложится *)
procedure fittext(n: integer);
var
  tl, L: integer;
begin
  settext(n);
  tl := rmem.ntl[n];
  L := 1;
  if tl > WMAXLINE then
    L := (tl + WMAXLINE - 1) div WMAXLINE;
  wraptl(tl);
  while (rmem.nwl > L) and (rmem.wwd < WMAXLINE + 12) do begin
    rmem.wwd := rmem.wwd + 2;
    wraptl(tl)
  end
end;

(* полная ширина иконы узла n *)
function iconw(n: integer): integer;
var
  k, tl, wd: integer;
begin
  k := kindof(n);
  tl := rmem.ntl[n];
  if k = 4 then begin
    (* конец: маленький полуовал; без подписи печатается слово
       КОНЕЦ - мерим его 5 литер.  Поле той же чётности, что и
       подпись: пробелов слева и справа поровну *)
    if tl = 0 then
      tl := 5;
    wd := tl + 2;
    if wd < 7 then
      wd := 7;
    if odd(wd - tl) then
      wd := wd + 1;
    iconw := wd
  end else if k = 22 then
    iconw := 18
  else if k = 23 then
    iconw := 30
  else begin
    fittext(n);
    if k = 3 then
      wd := rmem.wwd + 4
    else if k = 6 then
      (* параллелограмм: сдвиг верха равен числу строк + 1 *)
      wd := rmem.wwd + 3 + rmem.nwl
    else if (k = 8) or (k = 17) or (k = 21) or (k = 24) then
      wd := rmem.wwd + 4
    else if (k = 10) or (k = 16) or (k = 18) then
      wd := rmem.wwd + 6
    else if (k = 13) or (k = 14) then
      wd := rmem.wwd + 10
    else if k = 19 then
      wd := rmem.wwd + 12
    else if k = 20 then
      wd := rmem.wwd + 3
    else
      wd := rmem.wwd + 2;
    iconw := wd
  end
end;

(* формы икон: ДЕЙСТВИЕ, ЗАГОЛОВОК, ВОПРОС, КОНЕЦ *)
procedure picon1(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 0 then begin
    (* ДЕЙСТВИЕ: прямоугольник *)
    rmem.ih[n] := rmem.nwl + 2;
    hrun(x, y, w, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + w - 1, r, '|')
    end;
    hrun(x, y + rmem.nwl + 1, w, '+', '+')
  end else if k = 1 then begin
    (* ЗАГОЛОВОК: полуовал И1 *)
    rmem.ih[n] := rmem.nwl + 2;
    hrun(x, y, w, '.', '.');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x, r, '(');
      ctext(x + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + w - 1, r, ')')
    end;
    hrun(x, y + rmem.nwl + 1, w, '''', '''')
  end else if k = 3 then begin
    (* ВОПРОС: шестиугольник И4, валентная точка справа -
       линия плеча примыкает к стене на середине высоты *)
    rmem.ih[n] := rmem.nwl + 4;
    hrun(x + 2, y, rmem.wwd, '+', '+');
    put(x + 1, y + 1, '(');
    put(x + w - 2, y + 1, ')');
    for i := 1 to rmem.nwl do begin
      r := y + 1 + i;
      put(x, r, '|');
      ctext(x + 1, rmem.wwd + 2, r, rmem.wtx[i], rmem.wln[i]);
      put(x + w - 1, r, '|')
    end;
    put(x + 1, y + rmem.nwl + 2, '(');
    put(x + w - 2, y + rmem.nwl + 2, ')');
    hrun(x + 2, y + rmem.nwl + 3, rmem.wwd, '+', '+')
  end else if k = 4 then begin
    (* КОНЕЦ: малый полуовал И2 *)
    rmem.ih[n] := 3;
    hrun(x, y, w, '.', '.');
    put(x, y + 1, '(');
    ctext(x + 1, w - 2, y + 1, rmem.wtx[1], rmem.wln[1]);
    put(x + w - 1, y + 1, ')');
    hrun(x, y + 2, w, '''', '''')
  end
end;

(* формы икон: ВЕТКА, ВЫБОР, ВАРИАНТ *)
procedure picon2(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 2 then begin
    (* ИМЯ ВЕТКИ: щит И7 - стены сходятся к нижней вершине *)
    rmem.ih[n] := rmem.nwl + 3;
    hrun(x, y, w, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + w - 1, r, '|')
    end;
    put(x + 1, y + rmem.nwl + 1, '(');
    put(x + w - 2, y + rmem.nwl + 1, ')');
    put(x + 2, y + rmem.nwl + 2, '(');
    put(x + w - 3, y + rmem.nwl + 2, ')');
    dash(x + 3, y + rmem.nwl + 2, w - 6, '_')
  end else if k = 6 then begin
    (* ВЫБОР: параллелограмм И5, верх сдвинут вправо *)
    s := rmem.nwl + 1;
    rmem.ih[n] := rmem.nwl + 2;
    hrun(x + s, y, rmem.wwd + 2, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      f := s - i;
      put(x + f, r, '/');
      ctext(x + f + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + f + rmem.wwd + 1, r, '/')
    end;
    hrun(x, y + rmem.nwl + 1, rmem.wwd + 2, '+', '+')
  end else if k = 7 then begin
    (* ВАРИАНТ: прямоугольник с клином И6 *)
    rmem.ih[n] := rmem.nwl + 4;
    hrun(x, y, w, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + w - 1, r, '|')
    end;
    hrun(x, y + rmem.nwl + 1, w, '+', '+');
    put(x + 1, y + rmem.nwl + 2, '(');
    put(x + w - 2, y + rmem.nwl + 2, ')');
    put(x + 2, y + rmem.nwl + 3, '(');
    put(x + w - 3, y + rmem.nwl + 3, ')');
    dash(x + 3, y + rmem.nwl + 3, w - 6, '_')
  end
end;

(* формы икон: АДРЕС, КОММЕНТАРИЙ, ПОЛКА *)
procedure picon3(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 5 then begin
    (* АДРЕС: домик И8 с треугольной крышей *)
    m := w div 2;
    rmem.ih[n] := rmem.nwl + 4;
    put(x + m - 1, y, '(');
    put(x + m + 1, y, ')');
    put(x + m - 2, y + 1, '(');
    put(x + m + 2, y + 1, ')');
    hrun(x, y + 2, w, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + 2 + i;
      put(x, r, '|');
      ctext(x + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + w - 1, r, '|')
    end;
    hrun(x, y + rmem.nwl + 3, w, '+', '+')
  end else if k = 8 then begin
    (* КОММЕНТАРИЙ И21: двойная рамка, внутри полуовал *)
    rmem.ih[n] := rmem.nwl + 4;
    hrun(x, y, w, '+', '+');
    put(x, y + 1, '|');
    put(x + 1, y + 1, '.');
    dash(x + 2, y + 1, rmem.wwd, '-');
    put(x + rmem.wwd + 2, y + 1, '.');
    put(x + w - 1, y + 1, '|');
    for i := 1 to rmem.nwl do begin
      r := y + 1 + i;
      put(x, r, '|');
      put(x + 1, r, '(');
      ctext(x + 2, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 2, r, ')');
      put(x + w - 1, r, '|')
    end;
    put(x, y + rmem.nwl + 2, '|');
    put(x + 1, y + rmem.nwl + 2, '''');
    dash(x + 2, y + rmem.nwl + 2, rmem.wwd, '-');
    put(x + rmem.wwd + 2, y + rmem.nwl + 2, '''');
    put(x + w - 1, y + rmem.nwl + 2, '|');
    hrun(x, y + rmem.nwl + 3, w, '+', '+')
  end else if k = 10 then begin
    (* ФОРМАЛЬНЫЕ ПАРАМЕТРЫ И11: прямоугольник, точка слева *)
    rmem.ih[n] := rmem.nwl + 2;
    hrun(x + 2, y, rmem.wwd + 2, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x + 2, r, '|');
      ctext(x + 3, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 3, r, '|')
    end;
    hrun(x + 2, y + rmem.nwl + 1, rmem.wwd + 2, '+', '+');
    r := y + (rmem.nwl + 2) div 2;
    put(x, r, '-');
    put(x + 1, r, '-')
  end else if k = 9 then begin
    (* ПОЛКА И10: прямоугольник с горизонтальной серединой *)
    rmem.ih[n] := rmem.nwl + 4;
    hrun(x, y, w, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + w - 1, r, '|')
    end;
    hrun(x, y + rmem.nwl + 1, w, '+', '+');
    put(x, y + rmem.nwl + 2, '|');
    put(x + w - 1, y + rmem.nwl + 2, '|');
    hrun(x, y + rmem.nwl + 3, w, '+', '+')
  end
end;

(* формы икон: ЦИКЛ ДЛЯ, КДЛ, ВЫВОД, ВВОД *)
procedure picon4(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 11 then begin
    (* НАЧАЛО ЦИКЛА ДЛЯ И12: срезаны верхние угла *)
    rmem.ih[n] := rmem.nwl + 2;
    hrun(x + 1, y, rmem.wwd, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      if i = 1 then begin
        put(x, r, '(');
        put(x + w - 1, r, ')')
      end else begin
        put(x, r, '|');
        put(x + w - 1, r, '|')
      end;
      ctext(x + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i])
    end;
    hrun(x, y + rmem.nwl + 1, w, '+', '+')
  end else if k = 12 then begin
    (* КОНЕЦ ЦИКЛА ДЛЯ И13: срезаны нижние угла *)
    rmem.ih[n] := rmem.nwl + 2;
    hrun(x, y, w, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      if i = rmem.nwl then begin
        put(x, r, '(');
        put(x + w - 1, r, ')')
      end else begin
        put(x, r, '|');
        put(x + w - 1, r, '|')
      end;
      ctext(x + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i])
    end;
    hrun(x + 1, y + rmem.nwl + 1, rmem.wwd, '+', '+')
  end else if k = 13 then begin
    (* ВЫВОД И14: прямоугольник, справа полая стрелка наружу *)
    rmem.ih[n] := rmem.nwl + 2;
    hrun(x + 4, y, rmem.wwd + 2, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x + 4, r, '|');
      ctext(x + 5, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 5, r, '|')
    end;
    hrun(x + 4, y + rmem.nwl + 1, rmem.wwd + 2, '+', '+');
    r := y + (rmem.nwl + 2) div 2;
    dash(x + rmem.wwd + 6, r, 3, '=');
    put(x + rmem.wwd + 9, r, '>')
  end else if k = 14 then begin
    (* ВВОД И15: прямоугольник, справа стрелка внутрь *)
    rmem.ih[n] := rmem.nwl + 2;
    hrun(x + 4, y, rmem.wwd + 2, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x + 4, r, '|');
      ctext(x + 5, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 5, r, '|')
    end;
    hrun(x + 4, y + rmem.nwl + 1, rmem.wwd + 2, '+', '+');
    r := y + (rmem.nwl + 2) div 2;
    put(x + rmem.wwd + 6, r, '<');
    dash(x + rmem.wwd + 7, r, 3, '=')
  end
end;

(* формы икон: ПАУЗА, ПЕРИОД, ПУСК, СИНХРОНИЗАТОР *)
procedure picon5(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 15 then begin
    (* ПАУЗА И16: трапеция, сужающаяся вниз *)
    rmem.ih[n] := rmem.nwl + 3;
    hrun(x, y, w, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x, r, '|');
      ctext(x + 1, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + w - 1, r, '|')
    end;
    put(x + 1, y + rmem.nwl + 1, '(');
    put(x + w - 2, y + rmem.nwl + 1, ')');
    hrun(x + 2, y + rmem.nwl + 2, rmem.wwd - 2, '+', '+')
  end else if k = 16 then begin
    (* ПЕРИОД И17: трапеция вниз, валентные точки по бокам *)
    rmem.ih[n] := rmem.nwl + 3;
    hrun(x + 2, y, rmem.wwd + 2, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x + 2, r, '|');
      ctext(x + 3, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 3, r, '|')
    end;
    put(x + 3, y + rmem.nwl + 1, '(');
    put(x + rmem.wwd + 2, y + rmem.nwl + 1, ')');
    hrun(x + 4, y + rmem.nwl + 2, rmem.wwd - 2, '+', '+');
    r := y + (rmem.nwl + 3) div 2;
    put(x, r, '-');
    put(x + 1, r, '-');
    put(x + rmem.wwd + 4, r, '-');
    put(x + rmem.wwd + 5, r, '-')
  end else if k = 17 then begin
    (* ПУСК ТАЙМЕРА И18: трапеция вниз с двойными стенками *)
    rmem.ih[n] := rmem.nwl + 3;
    hrun(x, y, w, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x, r, '|');
      put(x + 1, r, '|');
      ctext(x + 2, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 2, r, '|');
      put(x + rmem.wwd + 3, r, '|')
    end;
    put(x + 1, y + rmem.nwl + 1, '(');
    put(x + 2, y + rmem.nwl + 1, '(');
    put(x + rmem.wwd + 1, y + rmem.nwl + 1, ')');
    put(x + rmem.wwd + 2, y + rmem.nwl + 1, ')');
    hrun(x + 3, y + rmem.nwl + 2, rmem.wwd - 2, '+', '+')
  end else if k = 18 then begin
    (* СИНХРОНИЗАТОР И19: трапеция вниз, точка справа *)
    rmem.ih[n] := rmem.nwl + 3;
    hrun(x + 2, y, rmem.wwd + 2, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x + 2, r, '|');
      ctext(x + 3, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 3, r, '|')
    end;
    put(x + 3, y + rmem.nwl + 1, '(');
    put(x + rmem.wwd + 2, y + rmem.nwl + 1, ')');
    hrun(x + 4, y + rmem.nwl + 2, rmem.wwd - 2, '+', '+');
    r := y + (rmem.nwl + 3) div 2;
    put(x + rmem.wwd + 4, r, '-');
    put(x + rmem.wwd + 5, r, '-')
  end
end;

(* формы икон: ПАРАЛПРОЦЕСС, БОКОВЫЕ КОММЕНТАРИИ, ПЕТЛИ, ВСТАВКА *)
procedure picon6(k, n, x, y, w: integer);
var
  i, r, f, s, m: integer;
begin
  if k = 19 then begin
    (* ПАРАЛЛЕЛЬНЫЙ ПРОЦЕСС И20: прямоугольник со сдвинутым
       вверх-вправо вторым *)
    rmem.ih[n] := rmem.nwl + 3;
    hrun(x + rmem.wwd + 8, y, 4, '+', '+');
    hrun(x + 5, y + 1, rmem.wwd + 2, '+', '+');
    put(x + w - 1, y + 1, '|');
    for i := 1 to rmem.nwl do begin
      r := y + 1 + i;
      put(x + 5, r, '|');
      ctext(x + 6, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 6, r, '|')
    end;
    put(x + w - 1, y + 2, '+');
    dash(x + rmem.wwd + 7, y + 2, 4, '-');
    hrun(x + 5, y + rmem.nwl + 2, rmem.wwd + 2, '+', '+')
  end else if k = 20 then begin
    (* ПРАВЫЙ КОММЕНТАРИЙ И22: скобка слева от текста *)
    rmem.ih[n] := rmem.nwl;
    for i := 1 to rmem.nwl do begin
      r := y + i - 1;
      put(x, r, '(');
      ctext(x + 2, rmem.wwd, r, rmem.wtx[i], rmem.wln[i])
    end
  end else if k = 21 then begin
    (* ЛЕВЫЙ КОММЕНТАРИЙ И23: текст, скобка справа *)
    rmem.ih[n] := rmem.nwl;
    for i := 1 to rmem.nwl do begin
      r := y + i - 1;
      ctext(x + 2, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 2, r, ')')
    end
  end else if k = 22 then begin
    (* ПЕТЛЯ ЦИКЛА И24: остриё упирается в вертикаль *)
    rmem.ih[n] := 2;
    put(x + 9, y, '|');
    put(x + 10, y, '<');
    dash(x + 11, y, 7, '-');
    put(x + w - 1, y, '+');
    put(x + 9, y + 1, '|');
    put(x + w - 1, y + 1, '|')
  end else if k = 23 then begin
    (* ПЕТЛЯ СИЛУЭТА И25: остриё в вертикаль, зубцы гребёнки *)
    rmem.ih[n] := 2;
    put(x + 15, y, '|');
    put(x + 16, y, '<');
    dash(x + 17, y, 13, '-');
    put(x + 15, y + 1, '|');
    put(x + 19, y + 1, '|');
    put(x + 23, y + 1, '|');
    put(x + 27, y + 1, '|');
    put(x + 29, y + 1, '|')
  end else if k = 24 then begin
    (* ВСТАВКА И9: прямоугольник с двойными стенками *)
    rmem.ih[n] := rmem.nwl + 2;
    hrun(x, y, w, '+', '+');
    for i := 1 to rmem.nwl do begin
      r := y + i;
      put(x, r, '|');
      put(x + 1, r, '|');
      ctext(x + 2, rmem.wwd, r, rmem.wtx[i], rmem.wln[i]);
      put(x + rmem.wwd + 2, r, '|');
      put(x + rmem.wwd + 3, r, '|')
    end;
    hrun(x, y + rmem.nwl + 1, w, '+', '+')
  end
end;

(* рисование иконы узла n с центром на колонке col, верх row;
   формы разбиты на picon1..picon6: у компилятора 15.1 предел
   числа команд в блоке *)
procedure makeicon(n, col, row: integer);
var
  k, w, tl, i, x, y: integer;
begin
  k := kindof(n);
  tl := rmem.ntl[n];
  if (k = 4) and (tl = 0) then begin
    (* конец без подписи печатает слово КОНЕЦ *)
    rmem.gtxt[1] := 'к'; rmem.gtxt[2] := 'о'; rmem.gtxt[3] := 'н';
    rmem.gtxt[4] := 'е'; rmem.gtxt[5] := 'ц'
  end;
  w := iconw(n);
  (* строки подписи: поле и перенос подогнаны в iconw/fittext;
     у конца - одна строка *)
  if k = 4 then begin
    tl := rmem.ntl[n];
    if tl = 0 then
      tl := 5;
    rmem.nwl := 1;
    rmem.wln[1] := tl;
    for i := 1 to tl do rmem.wtx[1][i] := rmem.gtxt[i]
  end;
  x := col - w div 2;
  rmem.ix[n] := x;
  rmem.iw[n] := w;
  rmem.iy[n] := row;
  y := row;
  if (k = 2) or (k = 6) or (k = 7) then
    picon2(k, n, x, y, w)
  else if (k = 5) or (k = 8) or (k = 9) or (k = 10) then
    picon3(k, n, x, y, w)
  else if (k = 11) or (k = 12) or (k = 13) or (k = 14) then
    picon4(k, n, x, y, w)
  else if (k = 15) or (k = 16) or (k = 17) or (k = 18) then
    picon5(k, n, x, y, w)
  else if k >= 19 then
    picon6(k, n, x, y, w)
  else
    picon1(k, n, x, y, w)
end;

function mainkids(n: integer): integer;
var
  ch, res: integer;
  done: boolean;
begin
  res := 0;
  ch := 0;
  if (rmem.nkind[n] = 6) or (rmem.nkind[n] = 15) then
    res := rmem.nkid[n]
  else
    ch := rmem.nkid[n];
  done := false;
  while (ch <> 0) and (not done) do begin
    if rmem.nkind[ch] = 11 then begin
      res := rmem.nkid[ch];
      done := true
    end else
      ch := rmem.nbro[ch]
  end;
  mainkids := res
end;

(* строка бокового выхода иконы: у вопроса - валентная точка
   на середине высоты (правая стена), у остальных - нижняя грань *)
function exrow(n: integer): integer;
var
  r: integer;
begin
  r := rmem.iy[n] + rmem.ih[n] - 1;
  if (rmem.nkind[n] = 5) or (rmem.nkind[n] = 6) then
    r := rmem.iy[n] + rmem.ih[n] div 2;
  exrow := r
end;

(* собрать правые плечи: ИНАЧЕ (минус - начало с потомков),
   ВАРИАНТ (плюс - икона и потомки) *)
procedure sidebranches(n: integer);
var
  ch: integer;
begin
  rmem.nbr[n] := 0;
  ch := rmem.nkid[n];
  while ch <> 0 do begin
    if rmem.nkind[ch] = 12 then begin
      if rmem.nkid[ch] <> 0 then begin
        rmem.nbr[n] := rmem.nbr[n] + 1;
        rmem.brx[n, rmem.nbr[n]] := -rmem.nkid[ch]
      end
    end else if rmem.nkind[ch] = 8 then begin
      if (rmem.ntl[ch] > 0) or (rmem.nkid[ch] <> 0) then begin
        rmem.nbr[n] := rmem.nbr[n] + 1;
        rmem.brx[n, rmem.nbr[n]] := ch
      end
    end;
    ch := rmem.nbro[ch]
  end
end;

(* ширина самой широкой иконы цепочки *)
function chainw(first: integer): integer;
var
  ch, w, mw: integer;
begin
  mw := 0;
  ch := first;
  while ch <> 0 do begin
    w := iconw(ch);
    if w > mw then
      mw := w;
    ch := rmem.nbro[ch]
  end;
  chainw := mw
end;

(* разложить цепочку по шампуру col от строки row;
   gy - нижняя свободная строка, gtail - последний узел цепочки;
   one <> 0 - разложить только первый узел, без братьев
   (икона ВАРИАНТа раскладывается отдельно от своих потомков) *)
procedure layout(first, col, row, tail, one: integer);
var
  node, y, rx, rail, wmax, ry, row0, mk, b, k, yb: integer;
  f0: integer;
begin
  y := row;
  node := first;
  while node <> 0 do begin
    if tail <> 0 then
      rmem.nxt[tail] := node;
    rmem.nfl := rmem.nfl + 1;
    rmem.flat[rmem.nfl] := node;
    makeicon(node, col, y);
    y := y + rmem.ih[node] + GAPR;
    mk := mainkids(node);
    if mk <> 0 then begin
      layout(mk, col, y, node, 0);
      if rmem.gy > y then
        y := rmem.gy;
      rmem.mainb[node] := rmem.gy - GAPR;
      tail := rmem.gtail
    end else begin
      rmem.mainb[node] := rmem.iy[node] + rmem.ih[node];
      tail := node
    end;
    sidebranches(node);
    if rmem.nbr[node] > 0 then begin
      row0 := exrow(node);
      rx := col + rmem.iw[node] div 2 + GAPS;
      ry := row0 + 1;
      for b := 1 to rmem.nbr[node] do begin
        if rmem.brx[node, b] < 0 then begin
          f0 := -rmem.brx[node, b];
          wmax := chainw(f0)
        end else begin
          f0 := rmem.brx[node, b];
          wmax := iconw(f0);
          if rmem.nkid[f0] <> 0 then begin
            k := chainw(rmem.nkid[f0]);
            if k > wmax then
              wmax := k
          end
        end;
        rail := rx + wmax div 2;
        if rmem.brx[node, b] < 0 then
          layout(f0, rail, ry, 0, 0)
        else begin
          layout(f0, rail, ry, 0, 1);
          if rmem.nkid[f0] <> 0 then
            layout(rmem.nkid[f0], rail, rmem.gy, f0, 0)
        end;
        rmem.brx[node, b] := rail;
        rmem.bry[node, b] := ry;
        yb := rmem.gy - GAPR;
        rmem.brb[node, b] := yb;
        if yb + GAPR > y then
          y := yb + GAPR;
        rx := rail + (wmax + 1) div 2 + GAPS
      end
    end;
    node := rmem.nbro[node];
    if one <> 0 then
      node := 0
  end;
  rmem.gtail := tail;
  rmem.gy := y
end;

(* ---------------- рисунок ---------------- *)

(* вертикальные линии между иконами одной цепочки *)
procedure connectors;
var
  i, a, b, cl, r: integer;
begin
  for i := 1 to rmem.nfl do begin
    a := rmem.flat[i];
    if rmem.nxt[a] <> 0 then begin
      b := rmem.nxt[a];
      cl := rmem.ix[a] + rmem.iw[a] div 2;
      for r := rmem.iy[a] + rmem.ih[a] to rmem.iy[b] - 1 do
        put(cl, r, '|')
    end
  end
end;

(* шина выхода вправо к осям плеч; линия начинается от самой
   правой литеры иконы в строке выхода (у параллелограмма низ
   уже верха, у вопроса стена на середине высоты) *)
procedure busout;
var
  i, a, b, r, cl, x, row0, lastr, wx: integer;
begin
  for i := 1 to rmem.nfl do begin
    a := rmem.flat[i];
    if rmem.nbr[a] > 0 then begin
      cl := rmem.ix[a] + rmem.iw[a] div 2;
      row0 := exrow(a);
      lastr := rmem.brx[a, 1];
      for b := 2 to rmem.nbr[a] do
        if rmem.brx[a, b] > lastr then
          lastr := rmem.brx[a, b];
      wx := rmem.ix[a];
      for x := rmem.ix[a] to rmem.ix[a] + rmem.iw[a] - 1 do
        if dmem.pic[row0][x] <> ' ' then
          wx := x;
      for x := wx + 1 to lastr - 1 do
        put(x, row0, '-');
      for b := 1 to rmem.nbr[a] do begin
        put(rmem.brx[a, b], row0, '+');
        for r := row0 + 1 to rmem.bry[a, b] - 1 do
          put(rmem.brx[a, b], r, '|')
      end
    end
  end
end;
(* возврат правых плеч на основную вертикаль *)
procedure mergeback;
var
  i, a, b, r, x, cl, base, mr: integer;
  stop: boolean;
begin
  for i := 1 to rmem.nfl do begin
    a := rmem.flat[i];
    if rmem.nbr[a] > 0 then begin
      cl := rmem.ix[a] + rmem.iw[a] div 2;
      base := rmem.mainb[a];
      for b := 1 to rmem.nbr[a] do
        if rmem.brb[a, b] > base then
          base := rmem.brb[a, b];
      (* слияние не рисуется, если икона основной цепочки
         начинается ровно на строке base *)
      stop := false;
      for r := 1 to rmem.nfl do
        if rmem.flat[r] <> a then
          if (rmem.ix[rmem.flat[r]] + rmem.iw[rmem.flat[r]] div 2 = cl) and
             (rmem.iy[rmem.flat[r]] = base) then
            stop := true;
      if not stop then begin
        for b := 1 to rmem.nbr[a] do
          for r := rmem.brb[a, b] to base - 1 do
            put(rmem.brx[a, b], r, '|');
        mr := rmem.brx[a, 1];
        for b := 2 to rmem.nbr[a] do
          if rmem.brx[a, b] > mr then
            mr := rmem.brx[a, b];
        for x := cl + 1 to mr - 1 do
          put(x, base, '-');
        for b := 1 to rmem.nbr[a] do
          put(rmem.brx[a, b], base, '+');
        put(cl, base, '+')
      end
    end
  end
end;

(* ---------------- выдача средствами редактора ---------------- *)

(* начать блок *DRK: чистое состояние схемы; рамка и широкий
   формат немедленно - как *RG*RU первой картой блока *RED *)
(* петля цикла ДЛЯ: возврат от КДЛ к вертикали под ДЛЯ (икона
   И24): от правой стены КДЛ на середине высоты - вправо, вверх
   и остриём в вертикаль между ДЛЯ и телом цикла *)
procedure forloop;
var
  i, nd, kd, ch, cl, ax, r1, r2, wx, xx, rr: integer;
begin
  for i := 1 to rmem.nfl do
    if rmem.nkind[rmem.flat[i]] = 15 then begin
      nd := rmem.flat[i];
      (* последний ребёнок-КДЛ *)
      kd := 0;
      ch := rmem.nkid[nd];
      while ch <> 0 do begin
        if rmem.nkind[ch] = 16 then
          kd := ch;
        ch := rmem.nbro[ch]
      end;
      if kd <> 0 then begin
        cl := rmem.ix[nd] + rmem.iw[nd] div 2;
        (* ось правее всех икон тела (от первого ребёнка до КДЛ) *)
        ax := cl;
        ch := rmem.nkid[nd];
        while ch <> 0 do begin
          if rmem.ix[ch] + rmem.iw[ch] > ax then
            ax := rmem.ix[ch] + rmem.iw[ch];
          ch := rmem.nbro[ch]
        end;
        ax := ax + 2;
        r1 := rmem.iy[nd] + rmem.ih[nd] + 1;
        r2 := rmem.iy[kd] + rmem.ih[kd] div 2;
        wx := rmem.ix[kd];
        for xx := rmem.ix[kd] to rmem.ix[kd] + rmem.iw[kd] - 1 do
          if dmem.pic[r2][xx] <> ' ' then
            wx := xx;
        put(cl + 1, r1, '<');
        for xx := cl + 2 to ax - 1 do
          put(xx, r1, '-');
        put(ax, r1, '+');
        for rr := r1 + 1 to r2 - 1 do
          put(ax, rr, '|');
        put(ax, r2, '+');
        for xx := wx + 1 to ax - 1 do
          put(xx, r2, '-')
      end
    end
end;

(* ---------------- силуэт (как в drakon.pas) ---------------- *)

(* раскладка силуэта по рис. 9 книги: заголовок, под ним ветки
   РЯДОМИ в колонки; верхняя шина от заголовка к щитам, снизу
   петля с возвратом в заголовок; ветка с КОНЦОМ - выход вниз.
   Если колонки не умещаются в ширину АЦПУ - общий шампур *)
procedure silout;
var
  h, b, p, sav, f0, j, nn1, kk, mn, mx, bot, prevr, d,
  minall, gsh: integer;
begin
  rmem.silnb := 0;
  h := rmem.nroot;
  layout(h, 1, 1, 0, 1);
  rmem.silhb := rmem.iy[h] + rmem.ih[h] + 1;
  b := rmem.nbro[h];
  while b <> 0 do begin
    p := b;
    while (rmem.nbro[p] <> 0) and (rmem.nkind[rmem.nbro[p]] <> 2) do
      p := rmem.nbro[p];
    sav := rmem.nbro[p];
    rmem.nbro[p] := 0;
    rmem.silnb := rmem.silnb + 1;
    rmem.silb[rmem.silnb] := b;
    f0 := rmem.nfl + 1;
    rmem.silf0[rmem.silnb] := f0;
    layout(b, 1, rmem.silhb + 2, 0, 0);
    rmem.silf1[rmem.silnb] := rmem.nfl;
    rmem.siltail[rmem.silnb] := rmem.gtail;
    rmem.nbro[p] := sav;
    mn := rmem.ix[b];
    mx := rmem.ix[b] + rmem.iw[b] - 1;
    bot := rmem.iy[b] + rmem.ih[b] - 1;
    for j := f0 to rmem.nfl do begin
      nn1 := rmem.flat[j];
      if rmem.ix[nn1] < mn then
        mn := rmem.ix[nn1];
      if rmem.ix[nn1] + rmem.iw[nn1] - 1 > mx then
        mx := rmem.ix[nn1] + rmem.iw[nn1] - 1;
      if rmem.iy[nn1] + rmem.ih[nn1] - 1 > bot then
        bot := rmem.iy[nn1] + rmem.ih[nn1] - 1
    end;
    if rmem.silnb > 1 then begin
      d := prevr + GAPB + 1 - mn;
      for j := rmem.silf0[rmem.silnb] to rmem.nfl do begin
        nn1 := rmem.flat[j];
        rmem.ix[nn1] := rmem.ix[nn1] + d;
        for kk := 1 to rmem.nbr[nn1] do
          rmem.brx[nn1, kk] := rmem.brx[nn1, kk] + d
      end;
      mx := mx + d
    end;
    prevr := mx;
    rmem.silbot[rmem.silnb] := bot;
    b := sav
  end;
  for j := 1 to rmem.silnb do
    rmem.silax[j] := rmem.ix[rmem.silb[j]] + rmem.iw[rmem.silb[j]] div 2;
  rmem.ix[h] := rmem.silax[1] - rmem.iw[h] div 2;
  minall := rmem.ix[h];
  for j := 1 to rmem.nfl do
    if rmem.ix[rmem.flat[j]] < minall then
      minall := rmem.ix[rmem.flat[j]];
  rmem.sillc := minall - 2;
  gsh := 0;
  if rmem.sillc < 1 then
    gsh := 1 - rmem.sillc;
  if prevr + gsh > DCMAX - 1 then begin
    rmem.silmd := false;
    for j := 1 to rmem.nfl do
      rmem.nxt[rmem.flat[j]] := 0;
    rmem.nfl := 0
  end else if gsh > 0 then begin
    for j := 1 to rmem.nfl do begin
      nn1 := rmem.flat[j];
      rmem.ix[nn1] := rmem.ix[nn1] + gsh;
      for kk := 1 to rmem.nbr[nn1] do
        rmem.brx[nn1, kk] := rmem.brx[nn1, kk] + gsh
    end;
    for j := 1 to rmem.silnb do
      rmem.silax[j] := rmem.silax[j] + gsh;
    rmem.sillc := 1
  end;
  if not rmem.silmd then
    exit;
  bot := 0;
  for j := 1 to rmem.silnb do
    if rmem.silbot[j] > bot then
      bot := rmem.silbot[j];
  rmem.silbb := bot + 2
end;

(* линии силуэта, верхняя часть: вертикаль заголовка, верхняя
   шина с остриём петли и спуски к щитам (разбивка на две
   процедуры - у компилятора 15.1 предел числа команд в блоке) *)
procedure silconnect;
var
  i, r, x, lasta: integer;
begin
  for r := rmem.iy[rmem.nroot] + rmem.ih[rmem.nroot] to rmem.silhb - 1 do
    put(rmem.silax[1], r, '|');
  lasta := rmem.silax[rmem.silnb];
  put(rmem.sillc, rmem.silhb, '+');
  for x := rmem.sillc + 1 to lasta - 1 do
    put(x, rmem.silhb, '-');
  for i := 1 to rmem.silnb do
    put(rmem.silax[i], rmem.silhb, '+');
  if rmem.silax[1] - 1 > rmem.sillc then
    put(rmem.silax[1] - 1, rmem.silhb, '>');
  for i := 1 to rmem.silnb do
    put(rmem.silax[i], rmem.silhb + 1, '|')
end;

(* линии силуэта, нижняя часть: вертикаль петли слева и нижняя
   шина (гребёнка): спуски веток, не кончающихся КОНЦОМ *)
procedure silloop;
var
  i, r, x, lasta: integer;
begin
  for r := rmem.silhb + 1 to rmem.silbb - 1 do
    put(rmem.sillc, r, '|');
  put(rmem.sillc, rmem.silbb, '+');
  lasta := rmem.sillc;
  for i := 1 to rmem.silnb do
    if rmem.nkind[rmem.siltail[i]] <> 10 then begin
      if rmem.silax[i] > lasta then
        lasta := rmem.silax[i]
    end;
  for x := rmem.sillc + 1 to lasta - 1 do
    put(x, rmem.silbb, '-');
  for i := 1 to rmem.silnb do
    if rmem.nkind[rmem.siltail[i]] <> 10 then begin
      for r := rmem.iy[rmem.siltail[i]] + rmem.ih[rmem.siltail[i]]
          to rmem.silbb - 1 do
        put(rmem.silax[i], r, '|');
      put(rmem.silax[i], rmem.silbb, '+')
    end
end;

procedure drkstart;
var
  i, j: integer;
begin
  initkw;
  rmem.ncnt := 0;
  rmem.nroot := 0;
  rmem.nfl := 0;
  rmem.gtail := 0;
  rmem.stn := 0;
  rmem.last0 := 0;
  for i := 1 to DRMAX do
    for j := 1 to DCMAX do
      dmem.pic[i][j] := ' ';
  fir := true;
  rgon := true;
  (* широкий формат с первой страницы, строка текста - прежняя:
     как *RU на первой карте блока, чтобы печать *DRK совпадала
     с печатью разметки * /*D *)
  fmtkeep := true;
  newfmt(1, false);
  fir := false;
  posmode := false
end;

(* перевести собранную схему в строки листа редактора:
   каждая строка рисунка проходит тот же путь, что карта
   разметки * /*D (очередь пуста, литеры как есть), и сдвигается
   на лист commit'ом - рамки и границы страниц ведёт редактор *)
procedure drkemit;
var
  i, j, ln, m2, q2, e, need: integer;
  keep: array [1..DRMAX] of boolean;
begin
  if rmem.ncnt = 0 then
    exit;
  (* силуэт: корневая цепочка - заголовок, за ним ветки-щиты;
     веток больше SM - общий шампур *)
  rmem.silmd := (rmem.nkind[rmem.nroot] = 1) and
    (rmem.nbro[rmem.nroot] <> 0) and (rmem.nkind[rmem.nbro[rmem.nroot]] = 2);
  if rmem.silmd then begin
    qq := 0;
    nn1 := rmem.nbro[rmem.nroot];
    while nn1 <> 0 do begin
      if rmem.nkind[nn1] = 2 then
        qq := qq + 1;
      nn1 := rmem.nbro[nn1]
    end;
    if qq > SM then
      rmem.silmd := false
  end;
  if rmem.silmd then
    silout;
  (* silout может отменить силуэт: колонки не уместились *)
  if not rmem.silmd then
    layout(rmem.nroot, 1, 1, 0, 0);
  (* сдвиг рисунка: левый край икон к колонке 1; оси плеч
     не сдвигаются - они уже отсчитаны от шампура *)
  m2 := 1;
  for i := 1 to rmem.nfl do
    if rmem.ix[rmem.flat[i]] < m2 then
      m2 := rmem.ix[rmem.flat[i]];
  if m2 < 1 then begin
    q2 := 1 - m2;
    for i := 1 to rmem.nfl do
      rmem.ix[rmem.flat[i]] := rmem.ix[rmem.flat[i]] + q2;
    (* оси плеч - те же абсолютные колонки рисунка *)
    for i := 1 to rmem.ncnt do
      for j := 1 to NBMAX do
        if rmem.brx[i, j] <> 0 then
          rmem.brx[i, j] := rmem.brx[i, j] + q2
  end;
  (* число строк рисунка: самая низкая занятая строка; выше DRMAX
     строки не рисовались (put обрезает) - не читать и их *)
  rmem.rws := 0;
  for i := 1 to rmem.nfl do
    if rmem.iy[rmem.flat[i]] + rmem.ih[rmem.flat[i]] - 1 > rmem.rws then
      rmem.rws := rmem.iy[rmem.flat[i]] + rmem.ih[rmem.flat[i]] - 1;
  if rmem.rws > DRMAX then
    rmem.rws := DRMAX;
  j := 0;
  while (rmem.rws > 0) and (j = 0) do begin
    ln := 0;
    for i := 1 to DCMAX do
      if dmem.pic[rmem.rws][i] <> ' ' then
        ln := i;
    if ln > 0 then
      j := 1
    else
      rmem.rws := rmem.rws - 1
  end;
  (* у силуэта ниже икон ещё нижняя шина петли; выше DRMAX
     строки не рисовались (put обрезает) *)
  if rmem.silmd then begin
    if rmem.silbb > rmem.rws then
      rmem.rws := rmem.silbb;
    if rmem.rws > DRMAX then
      rmem.rws := DRMAX
  end;
  (* перерисовка со сдвигом *)
  for i := 1 to DRMAX do
    for j := 1 to DCMAX do
      dmem.pic[i][j] := ' ';
  for i := 1 to rmem.nfl do
    makeicon(rmem.flat[i], rmem.ix[rmem.flat[i]] + rmem.iw[rmem.flat[i]] div 2,
             rmem.iy[rmem.flat[i]]);
  connectors;
  busout;
  mergeback;
  forloop;
  if rmem.silmd then begin
    silconnect;
    silloop
  end;
  (* строки рисунка - в текущую строку как есть и на лист; за
     128-й позицией литеры теряются, как на АЦПУ и в разметке.
     Икона переносится на новую страницу только целиком: строки,
     накрытые одной иконой, связаны в пробег (keep); пробег, не
     умещающийся на текущей странице, начинается на новой -
     страница обрывается перед ним тем же pageend, что и в
     commitrow.  Пробег длиннее страницы рвётся: икона бывает
     выше листа.  Маршрут разметки делает то же командой *P
     (emit drakon.pas) - печать *DRK совпадает с разметкой *)
  posmode := false;
  for i := 1 to rmem.rws do
    keep[i] := false;
  for i := 1 to rmem.nfl do
    for j := rmem.iy[rmem.flat[i]] + 1 to
             rmem.iy[rmem.flat[i]] + rmem.ih[rmem.flat[i]] - 1 do
      if j <= rmem.rws then
        keep[j] := true;
  i := 1;
  while i <= rmem.rws do begin
    e := i;
    while (e < rmem.rws) and keep[e + 1] do
      e := e + 1;
    if (e > i) and (rowno > 0) then begin
      need := (e - i + 1) * (rln + 1);
      if rowno + need > tmax then
        pageend
    end;
    for j := i to e do begin
      flushq(false);
      clrrow(cur);
      curpos := curflda;
      ln := 0;
      for m2 := 1 to DCMAX do
        if dmem.pic[j][m2] <> ' ' then
          ln := m2;
      for m2 := 1 to ln do
        if curflda + m2 - 1 <= 128 then
          cur[curflda + m2 - 1] := dmem.pic[j][m2];
      commit(true)
    end;
    i := e + 1
  end
end;

(* ---------------- сканер команд ---------------- *)

(* обработка команды после звездочки *)
procedure command;
var
  c, c2, c3: char;
  hasnum: boolean;
  a, b, i: integer;
begin
  nn1 := 1;
  hasnum := false;
  if (cpos <= cwv) and (card[cpos] >= '0') and (card[cpos] <= '9')
     then begin
    nn1 := 0;
    while (cpos <= cwv) and (card[cpos] >= '0') and (card[cpos] <=
       '9') do begin
      nn1 := nn1 * 10 + (ord(card[cpos]) - 48);
      cpos := cpos + 1
    end;
    hasnum := true
  end;
  if cpos > cwv then exit;
  c := card[cpos];
  cpos := cpos + 1;
  if c = 'F' then begin
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      if nn1 > 0 then fillrest(c2, nn1);
      posmode := true
    end
  end else if c = 'T' then begin
    flushq(false);
    commit(true);
    posmode := false;
    centerrest(cpos);
    cpos := cwv + 1;
    empties(2)
  end else if c = 'M' then begin
    if (cpos <= cwv) and (card[cpos] = 'F') then begin
      cpos := cpos + 1;
      (* текст перед *MF выводится своей строкой *)
      if (nw > 0) or (curpos > curflda) then begin
        flushq(false);
        commit(true)
      end;
      listing := true;
      cpos := cwv + 1
    end else if (cpos <= cwv) and (card[cpos] = 'C') then begin
      cpos := cpos + 1;
      if (cpos <= cwv) and (card[cpos] = 'S') then begin
        cpos := cpos + 1;
        if not readnum(a) then klaida(20);
        if not readnum(b) then klaida(20);
        setmcs(a, b)
      end else if (cpos <= cwv) and (card[cpos] = 'P') then begin
        cpos := cpos + 1;
        (* узкая страница внутри ячейки таблицы - ошибка 60 *)
        if incell then klaida(60);
        if not readnum(a) then klaida(20);
        if not readnum(b) then klaida(20);
        (* размеры за пределами листа - ошибка 40; в обычном формате
           страница не шире полу листа, высота не больше листа
           (проверено на живом оригинале) *)
        if (a > 127) or (b > 127) then klaida(40);
        if (fmt = 0) and (a > 64) then klaida(40);
        if b > 66 then klaida(40);
        mcpon := true;
        mcpw := a;
        mcph := b;
        if hasnum and (nn1 = 0) then begin
          (* *0MCP - до отмены *)
          mcpcnt := 0;
          mcpinf := true
        end else begin
          mcpcnt := nn1;
          mcpinf := false
        end;
        (* на первой карте блока страница ещё не набрана - геометрия
           действует на неё сразу; в середине текста - со следующей
           страницы (pagestart); в формате А не действует *)
        if fir and (fmt <> 2) then begin
          kk := curflda;
          setmcpage;
          if (nw = 0) and (not posmode) and (curpos = kk) then
            curpos := curflda
        end
      end else
        klaida(10)
    end else if (cpos <= cwv) and (card[cpos] = 'D') then begin
      cpos := cpos + 1;
      flushq(false);
      commit(true);
      posmode := false;
      centerrest(cpos);
      cpos := cwv + 1
    end else if (cpos <= cwv) and (card[cpos] = '=') then begin
      cpos := cpos + 1;
      macdef
    end else
      macins
  end else if c = 'S' then begin
    if (cpos <= cwv) and (card[cpos] = 'T') then begin
      if (cpos + 1 <= cwv) and (card[cpos + 1] >= '0') and
         (card[cpos + 1] <= '9') then
        tabledef(false)
      else begin
        cpos := cpos + 1;
        if cpos > cwv then klaida(10);
        c2 := card[cpos];
        cpos := cpos + 1;
        if c2 = 'A' then begin
          newfmt(2, hasnum and (nn1 = 1));
          (* счётчик страниц формата А (в оригинале - слово STAND):
             n страниц, затем обычный формат; *0STA - до отмены;
             без числа n=1; повторная *STA перезапускает счётчик *)
          if hasnum and (nn1 = 0) then begin
            standcnt := 0;
            standinf := true
          end else begin
            standcnt := nn1;
            standinf := false
          end;
          stsp := true
        end else if c2 = 'O' then begin
          (* обычный формат - со следующей страницы; текущая страница
             не прерывается; счётчик формата А снимается *)
          fmpending := 0;
          standcnt := 0;
          standinf := false;
          stsp := true
        end
        else if c2 = 'P' then begin
          stpon := true;
          stponly := (nn1 = 1);
          stpl := 0;
          for i := cpos to cwv do
            if card[i] <> ' ' then stpl := i - cpos + 1;
          for i := 1 to stpl do stp[i] := card[cpos + i - 1];
          cpos := cwv + 1;
          (* штамп печатается и на текущей странице *)
          if stpl > 0 then begin
            if fmt = 0 then
              stpok[side] := true
            else
              stpokf := true
          end
        end else if c2 = 'G' then begin
          stgon := true;
          stgonly := (nn1 = 1);
          stgl := 0;
          for i := cpos to cwv do
            if card[i] <> ' ' then stgl := i - cpos + 1;
          for i := 1 to stgl do stg[i] := card[cpos + i - 1];
          cpos := cwv + 1
        end else if c2 = 'N' then begin
          (* отмена штампа/подвала с текущей страницы (SIPROD.md, 4.8):
             страница собирается целиком до печати, лист ещё не
             напечатан и флаги читаются в момент sheetprint, поэтому
             отмена действует на текущую страницу; *1STN (и *STN) -
             шапка STP, *2STN - подвал STG, *0STN - ничего; хвост
             карты после STN остаётся текстом (проверено на оригинале) *)
          if nn1 = 1 then
            stpon := false
          else if nn1 = 2 then
            stgon := false
        end else if c2 = ' ' then begin
          (* ST с числами после пробела: колонки без линеек парами
             начало-конец (SIPROD.md, 4.9); tabledef пропустит пробел *)
          cpos := cpos - 1;
          tabledef(false)
        end else
          klaida(10)
      end
    end else if (cpos <= cwv) and (card[cpos] = 'L') then begin
      cpos := cpos + 1;
      tabledef(true)
    end else begin
      (* новый абзац: перевод строки (пустая строка не выводится),
         n-1 пустых строк, отступ 3 *)
      if (nw > 0) or (curpos > curflda) then begin
        flushq(false);
        commit(true)
      end;
      if nn1 > 1 then empties(nn1 - 1);
      indon := true
    end
  end else if c = 'L' then begin
    (* SL - таблица с линейками *)
    tabledef(true)
  end else if c = '/' then begin
    flushq(false);
    (* пустая текущая строка не сдвигается на лист: первая карта
       */ *D рисунка не должна давать пустую текстовую строку *)
    if curpos > curflda then
      commit(true)
    else
      curpos := curflda;
    posmode := false;
    if nn1 > 1 then empties(nn1 - 1)
  end else if c = 'P' then begin
    flushq(false);
    (* на свежей странице без текста *P не пишет пустую строку
       и не тратит номер страницы *)
    if (not freshpg) or (curpos > curflda) then
      commit(true);
    posmode := false;
    for i := 1 to nn1 do pageend
  end else if c = 'E' then begin
    endtxt := true;
    posmode := false;
    cpos := cwv + 1
  end else if c = 'G' then begin
    flushq(false);
    posmode := true;
    pp := curflda + nn1 - 1;
    if pp > curpos then curpos := pp
  end else if c = 'C' then begin
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      putrep(c2, nn1);
      posmode := true
    end
  end else if c = 'H' then begin
    hword(nn1)
  end else if c = 'D' then begin
    verbatim;
    posmode := true;
    cpos := cwv + 1
  end else if c = 'N' then begin
    (* *nN: номер следующей страницы; перед знаком команды пробел
       не обязателен - *254N*1RL задаёт номер так же, как *254N_.
       На свежей странице (ничего не напечатано) номер действует
       на неё сразу, иначе - на следующую (pnext) *)
    if cpos <= cwv then begin
      c2 := card[cpos];
      if c2 = ' ' then begin
        if rowno = 0 then begin
          pageno := nn1;
          hpno[side] := nn1;
          pgspent := false   (* свежий номер ещё не напечатан *)
        end else
          pnext := nn1;
        cpos := cpos + 1
      end else begin
        (* номер регистрируется в первой карте блока (FIRCAR) или
           перед пробелом; *7N*P номер не задаёт *)
        if hasnum and fir then begin
          if rowno = 0 then begin
            pageno := nn1;
            hpno[side] := nn1;
            pgspent := false   (* свежий номер ещё не напечатан *)
          end else
            pnext := nn1
        end;
        if c2 = 'N' then begin
          numon := false;
          (* на пустой странице номер снимается сразу *)
          if (rowno = 0) and (nw = 0) and (curpos = curflda) then begin
            if fmt = 0 then
              hnum[side] := false
            else
              hnumf := false
          end;
          cpos := cpos + 1
        end else if (c2 = 'L') or (c2 = 'R') or (c2 = 'U') or (c2 =
           'D') then begin
          cpos := cpos + 1;
          if tabon then begin
            if c2 = 'L' then cnol := true;
            if c2 = 'R' then cnr := true;
            if c2 = 'U' then cnu := true;
            if c2 = 'D' then cnd := true
          end else
            addch(c2)
        end else if (c2 >= 'A') and (c2 <= 'Z') then begin
          (* N поглощается, буква остаётся текстом *)
          addch(c2);
          cpos := cpos + 1
        end
        (* перед не-буквой N просто опускается *)
      end
    end else if hasnum and fir then begin
      if rowno = 0 then begin
        pageno := nn1;
        hpno[side] := nn1;
        pgspent := false   (* свежий номер ещё не напечатан *)
      end else
        pnext := nn1
    end
  end else if c = 'O' then begin
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      if c2 = 'L' then begin
        if (cpos <= cwv) and (card[cpos] = 'R') then cpos := cpos + 1;
        flushq(false);
        fillon := false
      end else if c2 = 'R' then begin
        if (cpos <= cwv) and (card[cpos] = 'U') then cpos := cpos + 1;
        (* возврат из широкого формата: строка текста остаётся *)
        fmtkeep := true;
        newfmt(0, hasnum and (nn1 = 1))
      end else
        klaida(10)
    end
  end else if c = 'W' then begin
    group(nn1, true)
  end else if c = '(' then begin
    group(nn1, false)
  end else if c = 'R' then begin
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      if c2 = 'T' then begin
        flushq(false);
        fillon := true
      end else if c2 = 'L' then begin
        (* новый интервал действует со следующей строки *)
        rlnnew := nn1;
        rlnpend := true
      end else if c2 = 'C' then begin
        rcn := nn1
      end else if c2 = 'G' then begin
        rgon := true;
        (* рамка на текущей странице, если страница ещё пуста *)
        if (rowno = 0) and (nw = 0) and (curpos = curflda) then begin
          if fmt = 0 then
            hfr[side] := true
          else
            hfrf := true
        end
      end else if c2 = 'U' then begin
        (* на первой карте блока широкий формат начинается с первой
           страницы, строка текста остаётся (проверено на живом
           оригинале); с числовым префиксом текущий лист дописывается *)
        if fir then
          fmtkeep := true;
        if fir and hasnum then
          newfmt(1, true)
        else
          newfmt(1, hasnum and (nn1 = 1))
      end else if c2 = 'F' then begin
        if cpos <= cwv then begin
          c2 := card[cpos];
          cpos := cpos + 1;
          fillto(nn1, c2);
          posmode := true
        end
      end else
        klaida(10)
    end
  end else if c = 'K' then begin
    if not readnum(a) then klaida(10);
    if cpos <= cwv then begin
      c2 := card[cpos];
      cpos := cpos + 1;
      putrep(c2, a);
      posmode := true
    end
  end else if hasnum then begin
    (* число без команды - режим листинга *)
    if (nw > 0) or (curpos > curflda) then begin
      flushq(false);
      commit(true)
    end;
    listing := true;
    cpos := cwv + 1
  end else
    klaida(10)
end;

(* просмотр карты: команды и текст *)
procedure scancard;
var
  c: char;
  lpos: integer;      (* последняя значимая позиция карты *)
begin
  (* хвостовые пробелы карты не значимы: в позиционном режиме они
     сдвигали бы позицию набора *)
  (* в режиме без переноса по словам граница карты - пробел в строке *)
  if (not fillon) and (spcnt > 0) then begin
    for jj := 1 to spcnt do addch(' ');
    spcnt := 0
  end;
  lpos := cwv;
  while (lpos > 0) and (card[lpos] = ' ') do lpos := lpos - 1;
  (* текст карты значим до 72-й позиции; остальное - только для *D *)
  if lpos > CW then lpos := CW;
  while cpos <= lpos do begin
    c := card[cpos];
    cpos := cpos + 1;
    if c = '*' then begin
      if (cpos <= cwv) and (card[cpos] <> ' ') then begin
        (* литера * завершает слово (в том числе слово-продолжение с
           предыдущей карты, дошедшее до 72-й позиции: карта *P после
           такого слова печатает его на текущей странице) *)
        if wleng > 0 then
          addword;
        command
      end else
        (* '*' перед пробелом или в конце карты опускается *)
        spcnt := spcnt
    end else
      addch(c)
  end;
  (* граница карты: слово продолжается, если 72-я позиция занята *)
  if wleng > 0 then begin
    if (mksp > 0) or (cwv < CW) then
      addword
    else if card[CW] = ' ' then
      addword
  end;
  (* хвостовые пробелы карты отбрасываются, граница карты - один
     пробел; после команды ST - два *)
  spcnt := 1;
  if stsp then begin
    spcnt := 2;
    stsp := false
  end
end;

(* ---------------- главная программа ---------------- *)

begin
  setfmt(0);
  (* бланк упакованной строки: разовая заливка, дальше строки листа
     чистятся присваиванием целиком *)
  for ii := 1 to 128 do бланкp[ii] := ' ';
  for ii := 65 to 128 do бланкh[ii] := ' ';
  рпмск.м := [40..47];    (* маска младшего байта слова *)
  (* статическая память чистых упакованных строк листа содержит нули,
     а не пробелы: первый newsheet заливает пробелами весь htxt, дальше
     достаточно чистить занятые строки (пишутся только непробельные) *)
  hrows[0] := 66;
  hrows[1] := 66;
  newsheet;
  pageno := 0;
  pnext := 0;
  pgspent := false;
  numon := true;
  hnum[0] := true;
  hnum[1] := true;
  hnumf := true;
  hfrf := false;
  stpok[0] := false;
  stpok[1] := false;
  stpokf := false;
  mcson := false;
  fmtkeep := false;
  mcsset := false;
  standcnt := 0;
  standinf := false;
  mcpon := false;
  mcpinf := false;
  mcpw := 0;
  mcph := 0;
  mcpcnt := 0;
  hmcp[0] := false;
  hmcp[1] := false;
  pgfirst := true;
  rgon := false;
  rln := 0;
  rlnnew := 0;
  rlnpend := false;
  rcn := 0;
  fillon := true;
  indon := false;
  listing := false;
  endtxt := false;
  stpon := false;
  stgon := false;
  stsp := false;
  stponly := false;
  stgonly := false;
  stpl := 0;
  stgl := 0;
  tabon := false;
  incell := false;
  trows := 0;
  tcol := 0;
  mkcnt := 0;
  mksp := 0;
  for ii := 1 to TCDEEP do rmem.mknest[ii] := false;
  fmpending := -1;
  fir := false;
  nw := 0;
  natq := 0;
  spcnt := 0;
  wbrk := false;
  wleng := 0;
  wrcl := 0;
  cwv := 72;
  pagestart;

1: (* ключевое слово блока *)
  getcard;
  if eofin then goto 9;
  if (card[1] = '*') and (card[2] = 'R') and (card[3] = 'E') and
     (card[4] = 'D') then begin
    endtxt := false;
    fir := true;
    while not endtxt do begin
      getcard;
      if eofin then
        endtxt := true
      else if listing then
        listcard
      else if tabon then
        tablecard
      else begin
        (* раскрытие макро без рекурсии: macstep докручивает куски
           тел, продолжения карт и снятие уровней *)
        scancard;
        while mksp > 0 do
          macstep;
        (* FIRCAR действует только на первую карту блока *)
        fir := false
      end
    end;
    flushq(false);
    commit(true);
    if (rowno > 0) and (not tabused) then hused[side] := true;
    (* пустой лист не печатается: страница без текста в конце текста
       не тратит номер и лист не выводит (проверено на живом
       оригинале); номер ещё не напечатан - pgspent остаётся false и
       номер достаётся следующему блоку *)
    if hused[0] or hused[1] or tabused then
      sheetprint(true);
    newsheet;
    goto 1
  end;
  if (card[1] = '*') and (card[2] = 'D') and (card[3] = 'R') and
     (card[4] = 'K') then begin
    (* блок *DRK: исходник схемы ДРАКОН до карты *E, затем
       трансляция и печать листа средствами редактора; рамка и
       широкий формат включаются самим блоком (drkstart) *)
    drkstart;
    endtxt := false;
    while not endtxt do begin
      getcard;
      if eofin then
        endtxt := true
      else if (card[1] = '*') and (card[2] = 'E') then
        endtxt := true
      else
        drkcard
    end;
    drkemit;
    (* последняя строка рисунка уже сдвинута drkemit'ом; сдвигать
       пустую текущую строку не нужно *)
    if curpos > curflda then
      commit(true);
    if rowno > 0 then hused[side] := true;
    sheetprint(true);
    newsheet;
    goto 1
  end;
  if (card[1] = '*') and (card[2] = 'E') and (card[3] = 'N') and
     (card[4] = 'D') then
    goto 9;
  klaida(100);
9: stop
end.
