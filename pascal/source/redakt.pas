(* РЕДАКТОР СИПРОД-П: реализация режима *RED системы СИПРОД (БЭСМ-6)
   на языке Паскаль-Монитор (МС «Дубна»).
   Реализовано: заполнение и выравнивание строк; команды
   *nS *n/ *nP *E *D *nH *nG *nCc *Knc *nFc *nRFc *n(...), *nW...),
   *T *MD *nRL *nRC *OLR *RT *RU *ORU *nMCS *nMCP *nN *NN *RG,
   *nSTA *nSTO *nSTP *nSTG *nSTN, таблицы *ST *SL (*NL *NR *NU *ND),
   макроопределения *nM=...$ и вставки *nM, листинг *MF и ///,
   печать на АЦПУ-128 (две страницы по 64 поз., формат А 84,
   широкий формат, узкая страница *MCP w h), рамки, номера страниц,
   штамп ЕСПД, ошибки 10 20 30 40 60 61 62 64 66 80 91 100.
   Блок *DRK - свой режим схем ДРАКОН на верхнем уровне (наравне с
   *RED в таблице диспетчера): исходник схемы до *E транслируется и
   печатается средствами самого редактора, без карт разметки * /*D.
   Ключевые слова схемы понимаются и в краткой форме (2 литеры -
   см. initkw), краткие распознаются после полных.
   Вход: карты после *EXECUTE (*RED ... *E, *DRK ... *E, *END).
   Выход: АЦПУ.
   Прогон страницы (код 0201) выполняется прямым вызовом экстракода
   64 (системная процедура besm + REF): стандартный вывод Паскаля
   6-битный и этот ГОСТ-байт через него не передать. *)
program redakt(input, output)(*=u-*,p-*);

label 1, 9;

const
  CW = 72;        (* значимых позиций карты *)
  TRN = 60;       (* строк текста: обычный и широкий формат *)
  TRA = 65;       (* строк текста: формат А *)
  MRW = 44;       (* макс. слов в строке *)
  MKMAX = 20;     (* макроопределений *)
  MKLEN = 400;    (* длина тела макро *)
  TCDEEP = 6;     (* глубина вложения макро *)
  TCMAX = 30;      (* строк в ячейке таблицы *)

  (* схема ДРАКОН, блок *DRK - алгоритм как в drakon.pas; ёмкости
     меньше (задача ~32К слов, редактор+транслятор в одном образе):
     55 узлов, 240 строк рисунка, 4 плеча (максимум схем - 44 узла
     и 4 варианта у выбора; узел сэкономлен ради памяти задачи:
     экстракодный прогон страницы добавил ~15 слов кода) *)
  NDMAX = 55;     (* узлов схемы *)
  DTKW = 28;      (* число ключевых слов *)
  NAK = 23;       (* кратких форм ключевых слов (2 литеры) *)
  DRMAX = 240;    (* строк рисунка *)
  NBMAX = 4;      (* плеч у узла (ВАРИАНТ + ИНАЧЕ) *)
  DKST = 24;      (* глубина стека разбора *)
  DCMAX = 128;    (* колонок рисунка: широкий формат АЦПУ-128 *)
  GAPR = 2;       (* зазор по вертикали *)
  GAPS = 4;       (* зазор между шампуром и плечом *)
  GAPB = 3;       (* пустых колонок между ветками силуэта *)
  MINW = 5;       (* минимальная ширина поля текста *)
  WMAXLINE = 30;  (* поле, до которого подпись держится в одну строку *)
  MXL = 12;       (* строк текста в иконе *)
  MXW = 40;       (* слов в подписи *)
  SM = 12;        (* веток силуэта не более *)

type
  rowty = array [1..128] of char;    (* строка печати, по слову на
  * литеру *)
  carty = array [1..80] of char;
  prow = packed array [1..128] of char; (* строка в хранении, 6
  * литер/слово *)
  prowh = packed array [65..128] of char; (* правая половина строки,
  * 64 литеры - 11 слов вместо 22: правая страница хранит только
  * позиции 65..128, чтение и запись ведутся теми же индексами *)
  pwty = packed array [1..100] of char; (* слово в хранении *)
  mkty = packed array [1..MKLEN] of char; (* тело макроопределения *)
  p80 = packed array [1..80] of char;  (* строка в хранении,
  * 6 литер/слово *)
  p72 = packed array [1..72] of char;  (* подпись узла *DRK: не длиннее
  * значимой части карты (CW) - 12 слов вместо 14 *)
  (* машинное слово для прямого вызова экстракодов: элемент i
     множества м соответствует биту 47-i слова; ц - тот же word
     как целое *)
  слово = record case integer of
    0: (ц: integer);
    1: (м: set of 0..47)
  end;

var
  card: carty;            (* текущая карта *)
  cpos: integer;          (* позиция на карте *)
  eofin: boolean;

  (* буф посылки прогона (экстракод 64) - ГЛОБАЛЬНЫЙ: REF локальной
     переменной кодируется через УТЦ (перебазировка М15) и портит
     стек вызывающей процедуры; REF глобальной - прямой адрес *)
  пбуф: array [0..2] of слово;
  падр: ^слово;

  (* формат страницы *)
  fmt: integer;           (* 0 обычный, 1 широкий, 2 формат А *)
  rowbase: integer;       (* листовая строка первой текстовой минус 1 *)
  txtrow: integer;        (* строка листа, с которой начинается текст *)
  tmax: integer;          (* текстовых строк на странице *)
  defl, defw: integer;    (* поле по умолчанию: центровка и номера *)
  flda, fldw: integer;    (* текущее поле левой страницы *)
  mcflda, mcfldw: integer; (* поле, заданное *MCS: действует со
                              следующей строки *)
  mcsset: boolean;        (* поле изменено, ждёт следующей строки *)
  mcsa, mcsw: integer;    (* параметры *MCS *)
  mcson: boolean;         (* поле задано *MCS - при смене формата
                             остаётся прежним *)

  (* счётчики страниц и узкая страница *)
  standcnt: integer;      (* счётчик страниц формата А (в оригинале -
                             слово STAND): >0 - осталось страниц,
                             0 - счётчик не активен; уменьшается в pageend *)
  standinf: boolean;      (* формат А до отмены (*0STA) *)
  mcpon: boolean;         (* задана узкая страница *MCP *)
  mcpinf: boolean;        (* узкая страница до отмены (*0MCP) *)
  mcpw, mcph: integer;    (* размеры страницы *MCP: ширина и высота *)
  mcpcnt: integer;        (* счётчик страниц *MCP (в оригинале - слово
                             STANN); уменьшается в pageend *)
  hmcp: array [0..1] of boolean;  (* страница набрана в геометрии *MCP
                             (захватывается в pagestart) *)
  mcwp: array [0..1] of integer;  (* ширина страницы *MCP на листе *)
  mchp: array [0..1] of integer;  (* высота страницы *MCP на листе *)
  mrow: array [0..1] of integer;  (* строка листа, с которой начинается
                             страница *MCP (верхняя рамка) *)
  mfl: array [0..1] of integer;   (* колонка левой стойки рамки *MCP,
                             абсолютно *)

  (* лист и страницы *)
  (* страницы листа: упакованные строки (6 литер/слово); левая
     страница занимает позиции 1..64 строки, правая - 65..128
     (широкий формат и формат А - всю строку 1..128); печатаются
     напрямую, без сборки листа.  Левая хранится строками целиком
     (нужны все 128 позиций в широком формате и формате А), правая -
     только позициями 65..128: экономит 66*11 = 726 слов статики -
     модуль снова входит в потолок памяти пуска с тома (см.
     ЗАПИСЬ-2150.md) *)
  htxt0: array [1..66] of prow;
  htxt1: array [1..66] of prowh;
  hused: array [0..1] of boolean;
  tabused: boolean;        (* на странице строки таблицы *)
  hfr: array [0..1] of boolean;   (* на странице рисуется рамка *)
  hfrf: boolean;           (* рамка на полноширинной странице *)
  hnum: array [0..1] of boolean;  (* на странице печатается номер *)
  hnumf: boolean;          (* номер на полноширинной странице *)
  hpno: array [0..1] of integer;
  hrows: array [0..1] of integer;   (* занятых текстовых строк *)
  пстрок: rowty;          (* печатная строка листа *)
  копстр: prow;           (* копия упакованной строки *)
  рпмск: слово;           (* маска байта для развёртки *)
  pageno, pnext: integer; (* счётчик страниц и номер от *N *)
  numon, rgon: boolean;

  (* текущая строка *)
  cur: rowty;
  curpos: integer;        (* следующая свободная позиция *)
  rowno: integer;         (* занято текстовых строк на странице *)
  side: integer;          (* 0 левая страница, 1 правая *)
  posmode: boolean;       (* позиционный набор после G/C/K/F/RF/D *)
  indon: boolean;         (* абзацный отступ *)
  rln, rcn: integer;      (* интервал и разрядка *)
  stpok: array [0..1] of boolean;  (* штамп печатается на странице *)
  stpokf: boolean;         (* штамп на полноширинной странице *)
  rlnnew: integer;        (* новый интервал строк: действует со
                              следующей строки *)
  rlnpend: boolean;
  fillon: boolean;        (* перенос по словам *)

  (* очередь слов строки: массивы wt/wl/wrc/qsp/word - в оверлее rmem
     (случай 1); скаляры-стражи остаются здесь - их значения на
     границах блоков определены (ПЛАН-ОЗУ, п. 3) *)
  nw: integer;
  natq: integer;          (* естественная ширина очереди слов *)
  wbrk: boolean;          (* длинное слово уже записано строкой *)
  spcnt: integer;         (* накопленных пробелов перед словом *)
  wleng: integer;
  wrcl: integer;          (* разрядка слова при наборе *)

  (* режимы *)
  listing: boolean;       (* *MF *)
  endtxt: boolean;        (* *E *)
  stpon, stgon: boolean;
  pgfirst: boolean;       (* ещё не напечатан первый лист (для *1STP/*1STG) *)
  pgspent: boolean;       (* номер pageno напечатан: на свежем листе после
     печатанного листа номер не используется повторно - нумерация
     идёт сквозь все блоки задания, как в оригинальном СИПРОДе *)
  freshpg: boolean;       (* страница начата, но текста на ней нет *)
  fmpending: integer;     (* сменa формата, ждущая следующей страницы *)
  fmtkeep: boolean;       (* при смене формата строка текста не меняется *)
  fir: boolean;           (* первая карта блока *RED - разбор FIRCAR *)
  stponly, stgonly: boolean;
  stsp: boolean;           (* команда ST оставила лишний пробел *)
  stp, stg: p80;          (* упакованно: 28 вместо 160 слов *)
  stpl, stgl: integer;

  (* таблицы *)
  tabon: boolean;         (* режим таблицы *)
  tabline: boolean;       (* с линейками (SL) *)
  tbda: array [1..8] of integer;   (* старт колонки, абсолютно *)
  tbdw: array [1..8] of integer;   (* ширина колонки *)
  tbn: integer;           (* число колонок *)
  tslpos: array [1..8] of integer; (* позиции линеек SL, абсолютно *)
  tcol: integer;          (* номер текущей колонки *)
  tbn2: integer;          (* число колонок таблицы *)
  svflda, svfldw: integer; (* сохранённое поле на время ячейки *)
  prevnd: array [1..8] of boolean; (* нижние линии предыдущей строки *)
  (* оверлей: ячейки таблиц и рисунок ДРАКОН (блок *DRK) никогда
     не живут одновременно (режим таблиц прерывается картой $ до
     любого блока, внутри *DRK команды не разбираются) - общая
     память экономит ~4.6К слов *)
  dmem: record
          case integer of
            0: (tline: array [1..8] of array [1..TCMAX] of prow);
            1: (pic: array [1..DRMAX] of prow)
        end;   (* строки ячеек таблиц / строки рисунка схемы *)
  tcnt: array [1..8] of integer;
  tcln: integer;          (* строк в текущей ячейке *)
  incell: boolean;        (* накопление ячейки *)
  cnol, cnr, cnu, cnd: boolean;    (* убранные линии ячейки *)
  rownol, rownr: array [1..8] of boolean;
  rownu, rownd: array [1..8] of boolean;
  (* флаги предыдущей строки таблицы: для линеек - вертикаль рисуется
     на стыке, если она есть в завершённой строке или в предыдущей
     (у ячейки *NR убирает правую линию, *NL - левую); сверено с
     оригиналом по red-table *)
  предолж, предорн: array [1..8] of boolean;
  prevrows: integer;         (* ячеек в предыдущей строке (0 - нет) *)
  trows: integer;         (* колонок в текущей строке таблицы *)

  (* макроопределения: mktx/mkln/mkcnt живут весь журнал - вне оверлея;
     рабочие массивы раскрытия (mkbuf/mksav/mksl/mksq/mknest/mknum/
     mkpp/mkres) - в оверлее rmem (случай 1); mkbl/mksp - стражи *)
  mktx: array [1..MKMAX] of mkty;
  mkln: array [1..MKMAX] of integer;
  mkcnt: integer;
  mkbl: integer;
  mksp: integer;

  cwv: integer;           (* конец текущей карты или тела макро *)
  ii, jj, kk, nn1, pp, qq: integer;
  c2, c3: char;

  (* бланк упакованной строки для целостного присваивания: заливка
     строки целиком в двадцать раз дешевле цикла по литерам
     (компилятор копирует слова, а не упаковывает каждую литеру);
     неупакованный бланк не заведён ради памяти задачи *)
  бланкp: prow;           (* 128 пробелов, упакованно *)
  бланкh: prowh;          (* пробелы 65..128 для правой страницы *)

  (* ---- оверлей резидента: статика *DRK и рабочие массивы ветви
     *RED не живут одновременно - общая память (ПЛАН-ОЗУ, п. 3;
     образец - dmem выше). Экономия ~1.5К слов ----
     случай 0: статика *DRK (kw..silmd) - в блоке *RED мертва, всё
       пересоздаётся на каждом блоке (drkstart: ncnt:=0, initkw
       перезаполняет kw);
     случай 1: очередь слов и раскрытие макро (wt..mkres) - в блоке
       *DRK мертвы: очередь пуста на границе блоков (flushq при nw=0
       массивов не читает, конец *RED - flushq+commit), макро
       раскрывается только в *RED главного цикла (карта *DRK внутри
       *RED - команда *D, verbatim, не вход в движок).
     Ограничение: раскрытие макро, прерванное *E с mksp>0, после *DRK
     не продолжается (стек раскрытия затёрт); эталонами не задевается.
     Скаляры-стражи (nw, natq, spcnt, wbrk, wleng, wrcl, mksp, mkbl) -
     вне записи. *)
  rmem: record
          case integer of
            0: (kw: array [1..DTKW] of packed array [1..12] of char;
                kwl: array [1..DTKW] of integer;
                ali: array [1..NAK] of packed array [1..2] of char;
                almap: array [1..NAK] of 1..DTKW;
                nkind: array [1..NDMAX] of integer;
                ntext: array [1..NDMAX] of p72;
                ntl: array [1..NDMAX] of integer;
                nkid: array [1..NDMAX] of integer;
                nbro: array [1..NDMAX] of integer;
                ncnt: integer;
                nroot: integer;
                ix, iy, iw, ih: array [1..NDMAX] of integer;
                nxt: array [1..NDMAX] of integer;
                mainb: array [1..NDMAX] of integer;
                brx: array [1..NDMAX, 1..NBMAX] of integer;
                bry: array [1..NDMAX, 1..NBMAX] of integer;
                brb: array [1..NDMAX, 1..NBMAX] of integer;
                nbr: array [1..NDMAX] of integer;
                flat: array [1..NDMAX] of integer;
                nfl: integer;
                rws: integer;
                gtail, gy: integer;
                st: array [1..DKST] of integer;
                sti: array [1..DKST] of integer;
                stl: array [1..DKST] of integer;
                stn: integer;
                last0: integer;
                wsp: array [1..MXW] of integer;
                wwp: array [1..MXW] of integer;
                nwd: integer;
                gtxt: p80;              (* упакованно: 14 вместо 80 *)
                wtx: array [1..MXL] of p80;
                wln: array [1..MXL] of integer;
                nwl: integer;
                wwd: integer;
                silnb: integer;
                silb: array [1..SM] of integer;
                silf0: array [1..SM] of integer;
                silf1: array [1..SM] of integer;
                silax: array [1..SM] of integer;
                siltail: array [1..SM] of integer;
                silbot: array [1..SM] of integer;
                silhb: integer;
                silbb: integer;
                sillc: integer;
                silmd: boolean);
            1: (wt: array [1..MRW] of pwty;
                wl: array [1..MRW] of integer;
                wrc: array [1..MRW] of integer;
                qsp: array [1..MRW] of integer;
                word: pwty;
                mkbuf: mkty;
                mksav: array [1..TCDEEP] of carty;
                mksl: array [1..TCDEEP] of integer;
                mksq: array [1..TCDEEP] of integer;
                mknest: array [1..TCDEEP] of boolean;
                mknum: array [1..TCDEEP] of integer;
                mkpp: array [1..TCDEEP] of integer;
                mkres: array [1..TCDEEP] of boolean)
        end;   (* статика *DRK (случай 0) / очередь слов + раскрытие
                  макро (случай 1) *)

procedure pasout(var a, b: char); fortran;

(* ---------------- ввод ---------------- *)

(* чтение следующей карты *)
procedure getcard;
var
  i: integer;
begin
  if eof(input) then begin
    eofin := true;
    exit
  end;
  for i := 1 to 80 do card[i] := ' ';
  readln(card);
  cpos := 1;
  (* карты значимы до 80-й позиции: разметка *D несёт текст
     и за 72-й (SIPROD.md, 2.1; каталог разметки ДРАКОНа) *)
  cwv := 80;
  eofin := false
end;

(* ---------------- утилиты печати ---------------- *)

(* печать строки листа: 128 позиций, хвостовые пробелы срезает Э64 *)
procedure outline(var r: rowty);
begin
  pasout(r[1], r[128])
end;

(* пустая строка печати *)
procedure blankl;
var
  r: rowty;
  i: integer;
begin
  for i := 1 to 128 do r[i] := ' ';
  outline(r)
end;

(* прогон страницы АЦПУ: прямой вызов экстракода 64.  Стандартный
   вывод Паскаля 6-битный, код 0201 через него не передать; данные
   Э64 - ГОСТ-байты по 6 на слово, старший байт первым.  УПР-слово
   и слово формата построены множествами (элемент i = бит 47-i),
   адрес буфа кладётся в М14 системной функцией REF, команда
   besm(70640000B) = Э64 с М14 (АИСП = 0+М14 = адрес буф).
   УПР: левая половина М14+2 (начало данных буф[2]), правая М14+2
   (печать до конца информации).  Формат: текст ГОСТ (0) с позиции
   0, final 8 - конец списка форматов.  Посылка: 0201 (прогон),
   0214 (конец строки), 0172 (конец информации) - печать получает
   отдельную строку с прогоном, как строки прогона оригинала. *)
procedure прогон;
begin
  пбуф[0].м := [0..2,22,24..26,46];
  пбуф[1].м := [24];
  пбуф[2].м := [0,7..8,12..13,17..20,22];
  падр := REF(пбуф);
  besm(70640000B)
end;

(* очистка строки *)
procedure clrrow(var r: rowty);
var
  i: integer;
begin
  for i := 1 to 128 do r[i] := ' '
end;

(* число вправо в поле шириной w с позиции pos строки r *)
procedure putnum(var r: rowty; pos, val, w: integer);
var
  d: array [1..8] of char;
  nd, i, v: integer;
begin
  v := val;
  nd := 0;
  repeat
    nd := nd + 1;
    d[nd] := chr(60B + v mod 10);
    v := v div 10
  until v = 0;
  for i := 1 to w do r[pos + i - 1] := ' ';
  i := 0;
  while (i < nd) and (i < w) do begin
    r[pos + w - 1 - i] := d[i + 1];
    i := i + 1
  end
end;

(* ---------------- ошибки ---------------- *)

(* печать ошибки и останов задачи, как KLAIDA оригинала *)
procedure klaida(num: integer);
var
  r: rowty;
  i: integer;
begin
  blankl; blankl;
  clrrow(r);
  r[20] := 'Е'; r[21] := ' '; r[22] := 'R'; r[23] := ' ';
  r[24] := 'R'; r[25] := ' '; r[26] := 'О'; r[27] := ' ';
  r[28] := 'R';
  r[33] := 'N'; r[34] := 'R'; r[35] := '.';
  putnum(r, 36, num, 7);
  outline(r);
  blankl;
  clrrow(r);
  r[20] := 'О'; r[21] := ' '; r[22] := 'Б'; r[23] := ' ';
  r[24] := 'Р'; r[25] := ' '; r[26] := 'А'; r[27] := ' ';
  r[28] := 'З'; r[31] := 'П'; r[32] := ' '; r[33] := 'Е';
  r[34] := ' '; r[35] := 'Р'; r[36] := ' '; r[37] := 'Ф';
  r[38] := ' '; r[39] := 'О'; r[40] := ' '; r[41] := 'К';
  r[42] := ' '; r[43] := 'А'; r[44] := ' '; r[45] := 'Р';
  r[46] := ' '; r[47] := 'Т'; r[48] := ' '; r[49] := 'Ы';
  r[51] := ':';
  outline(r);
  blankl;
  clrrow(r);
  for i := 1 to CW do
    if card[i] <> ' ' then r[i + 2] := card[i];
  outline(r);
  blankl;
  stop
end;

(* ---------------- формат страницы ---------------- *)

(* установить параметры формата; f: 0 обычный, 1 широкий, 2 А *)
procedure setfmt(f: integer);
var
  t: integer;
begin
  fmt := f;
  if f = 0 then begin
    t := 2; tmax := TRN;
    defl := 6; defw := 56
  end else if f = 1 then begin
    t := 3; tmax := TRN;
    defl := 6; defw := 120
  end else begin
    t := 3; tmax := TRA;
    defl := 12; defw := 67
  end;
  if not fmtkeep then begin
    if f = 0 then txtrow := 4
    else if f = 1 then txtrow := 5
    else txtrow := 7
  end;
  fmtkeep := false;
  rowbase := t + txtrow - 2;
  if not mcson then begin
    mcsa := 1; mcsw := defw;
    flda := defl; fldw := defw
  end
end;

(* поле текущей страницы: правая сдвинута на 64 позиции *)
function curflda: integer;
begin
  if fmt = 0 then curflda := flda + 64 * side
  else curflda := flda
end;

(* применить *MCS a w; ошибка 30 - поле или ширина за страницей *)
procedure setmcs(a, w: integer);
begin
  if (w <= 0) or (a <= 0) then klaida(30);
  if defl + a - 1 + w - 1 > defl + defw - 1 then klaida(30);
  mcsa := a; mcsw := w;
  mcson := true;
  (* новое поле действует со следующей строки: строка, на которой
     команда встретилась, набирается по старому полю *)
  mcflda := defl + a - 1; mcfldw := w;
  mcsset := true;
  (* если строка ещё пуста, новое поле действует сразу *)
  if (curpos = curflda) and (nw = 0) then begin
    flda := mcflda;
    fldw := mcfldw;
    mcsset := false
  end
end;
