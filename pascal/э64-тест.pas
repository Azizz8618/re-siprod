(*=u-*,p+*)
(* ТЕСТ Э64: печать на АЦПУ прямым вызовом экстракода 64 из Паскаля.
   УПР-слово и слово формата построены множествами (без арифметики
   над 48-битными словами); адрес данных - через М14 из REF.
   М=14 в половинах УПР: М14+2 = начало данных (буф[2]),
   М14+6 = последний адрес данных (буф[6]); формат 0 = текст ГОСТ,
   final 8 = конец списка.
   Данные: Э64 работает, прогон страницы, после прогона.
   Команда: besm(70640000B) = Э64 с М14 (АИСП = адрес буф). *)
program e64test(input, output);
type
  слово = record case integer of
    0: (ц: integer);
    1: (м: set of 0..47)
  end;
  указ = ^слово;
var
  буф: array [0..6] of слово;
  адр: указ;
begin
    буф[0].м := [0..2,22,24..26,45..46];
  буф[1].м := [24];
  буф[2].м := [2..5,13..14,21,28..31,34..35,42];
  буф[3].м := [2,7,10,12..14,18..19,22,26,34,37,39,42..43,46];
  буф[4].м := [0,7,10,12..15,18,20..22,26..27,31,34,36,38..39,42,45,47];
  буф[5].м := [4..7,10,12..15,18..19,26,28..30,34,38..39,42,44..46];
  буф[6].м := [2,4..5,7,10,17..20,22,28..31,36..39,44..47];
  writeln('* до Э64');
  адр := REF(буф);
  besm(70640000B);
  writeln('* после Э64');
end.
