CDRAKON - ИНТЕРПРЕТАТОР СХЕМ ДРАКОН (АВТОКОД МАДЛЕН, МОНИТОР-80)
C=====================================================================
C Читает текст схемы ДРАКОН из входного потока и печатает разметку
C СИПРОДА *RED для вывода на АЦПУ (DRAKON.md, разделы 1 и 4).
C
C РАЗБОР: строка входа - одна икона.  Ключевое слово стоит в начале
C строки (шесть первых знаков); по нему выбирается вид иконы.
C Печатаются заголовок блока *RED/*RG*RU, иконы и конец *E/*END.
C
C ВИДЫ ИКОН (DRAKON.md, раздел 3):
C   0 ПРЯМОУГОЛЬНИК  ДЕЙСТВИЕ, КОММЕНТАРИЙ, ВАРИАНТ
C   1 СКРУГЛЁННАЯ    ЗАГОЛОВОК, КОНЕЦ
C   2 ТРАПЕЦИЯ       ВЕТКА, АДРЕС, ВЫБОР
C   3 ШЕСТИУГОЛЬНИК  ЕСЛИ, ЦИКЛ
C
C СОГЛАШЕНИЕ ВЫЗОВА МОНИТОР-80: М16 - адрес блока данных, М15 - адрес
C возврата; возврат в монитор через М12.  М16 затирается вызовом GETSTR,
C поэтому в начале он сохраняется в М12.
C ВНЕШНИЕ: GETSTR, WRIKOR, ENDKOR.
C=====================================================================
 DRAKON :,NAME, NEW DTRAN
C---------------------------------------------------------------------
C РЕГИСТРЫ МАШИНЫ (ВОСЬМЕРИЧНЫЕ КОДЫ)
C---------------------------------------------------------------------
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
C---------------------------------------------------------------------
C ВНЕШНИЕ ОБЩИЕ ОБЛАСТИ ПАМЯТИ
C---------------------------------------------------------------------
C INS: ВХОДНОЙ ПОТОК: УКАЗАТЕЛИ И ТЕКСТ СТРОКИ (27 СЛОВ)
 INS :,LC,27
C---------------------------------------------------------------------
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
C---------------------------------------------------------------------
 GETSTR:,SUBP,
 WRIKOR:,SUBP,
 ENDKOR:,SUBP,
C---------------------------------------------------------------------
C ТОЧКА ВХОДА: СОХРАНИТЬ М16, НАПЕЧАТАТЬ ЗАГОЛОВОК БЛОКА
C---------------------------------------------------------------------
 DRAKON:M16,MTJ,10
 ,NTR,3
 ,NTR,22B
 M15,VJM,HEADER
C---------------------------------------------------------------------
C ГЛАВНЫЙ ЦИКЛ: СТРОКА -> РАЗБОР -> ИКОНА, ПОКА ПОТОК НЕ КОНЧИЛСЯ
C---------------------------------------------------------------------
 LOOP:M16,VTM,PARM17
 ,ITS,14
 M15,VJM,GETSTR
 ,UTC,INS+24
 ,NTR,3
 ,UZA,FINISH
 M15,VJM,DETECT
 M15,VJM,ICON
 M15,VJM,EMPTY
 ,UJ,LOOP
C---------------------------------------------------------------------
C КОНЕЦ ПОТОКА: ЗАКРЫТЬ БЛОК И ВЕРНУТЬСЯ В МОНИТОР
C---------------------------------------------------------------------
 FINISH:M15,VJM,TRAIL
 M12,UJ,
C---------------------------------------------------------------------
C РАСПОЗНАВАНИЕ КЛЮЧЕВОГО СЛОВА: IKIND := ВИД ИКОНЫ (0..3)
C Сравниваются первые шесть знаков строки с началом ключевого слова.
C---------------------------------------------------------------------
 DETECT:,UTC,ZERO
 ,XTA,
 ,UTC,IKIND
 ,ATX,
 M16,VTM,INS
 ,XTA,
 ,UTC,KW_ZAG
 ,A-X,
 ,NTR,3
 ,UZA,IS_ROUND
 M16,VTM,INS
 ,XTA,
 ,UTC,KW_KON
 ,A-X,
 ,NTR,3
 ,UZA,IS_ROUND
 M16,VTM,INS
 ,XTA,
 ,UTC,KW_VET
 ,A-X,
 ,NTR,3
 ,UZA,IS_TRAP
 M16,VTM,INS
 ,XTA,
 ,UTC,KW_ADR
 ,A-X,
 ,NTR,3
 ,UZA,IS_TRAP
 M16,VTM,INS
 ,XTA,
 ,UTC,KW_VYB
 ,A-X,
 ,NTR,3
 ,UZA,IS_TRAP
 M16,VTM,INS
 ,XTA,
 ,UTC,KW_ESL
 ,A-X,
 ,NTR,3
 ,UZA,IS_HEX
 M16,VTM,INS
 ,XTA,
 ,UTC,KW_TSI
 ,A-X,
 ,NTR,3
 ,UZA,IS_HEX
 ,UJ,DET_END
C ЗАГОЛОВОК И КОНЕЦ: СКРУГЛЁННАЯ ИКОНА (ВИД 1)
 IS_ROUND:,UTC,ONE
 ,XTA,
 ,UTC,IKIND
 ,ATX,
 ,UJ,DET_END
C ВЕТКА, АДРЕС, ВЫБОР: ТРАПЕЦИЯ (ВИД 2)
 IS_TRAP:,UTC,TWO
 ,XTA,
 ,UTC,IKIND
 ,ATX,
 ,UJ,DET_END
C ЕСЛИ, ЦИКЛ: ШЕСТИУГОЛЬНИК (ВИД 3)
 IS_HEX:,UTC,THREE
 ,XTA,
 ,UTC,IKIND
 ,ATX,
 DET_END:M15,UJ,
C---------------------------------------------------------------------
C ИКОНА: РАМКА СВЕРХУ, ТЕКСТ СТРОКИ, РАМКА СНИЗУ
C---------------------------------------------------------------------
 ICON:M15,VJM,TOPLIN
 M15,VJM,TEXTLN
 M15,VJM,BOTLIN
 M15,UJ,
C---------------------------------------------------------------------
C ВЕРХНЯЯ РАМКА: ВИД ИКОНЫ ИЗ IKIND
C---------------------------------------------------------------------
 TOPLIN:,UTC,IKIND
 ,XTA,
 ,UTC,ZERO
 ,A-X,
 ,NTR,3
 ,UZA,TOP_RECT
 ,UTC,IKIND
 ,XTA,
 ,UTC,ONE
 ,A-X,
 ,NTR,3
 ,UZA,TOP_ROUND
 ,UTC,IKIND
 ,XTA,
 ,UTC,TWO
 ,A-X,
 ,NTR,3
 ,UZA,TOP_TRAP
 ,UJ,TOP_HEX
 TOP_RECT:M16,VTM,T_RECT
 ,UJ,TOP_OUT
 TOP_ROUND:M16,VTM,T_ROUND
 ,UJ,TOP_OUT
 TOP_TRAP:M16,VTM,T_TRAP
 ,UJ,TOP_OUT
 TOP_HEX:M16,VTM,T_HEX
 TOP_OUT:,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,SIX
 ,ITS,14
 M15,VJM,WRIKOR
 M15,VJM,ENDKOR
 M15,UJ,
C---------------------------------------------------------------------
C НИЖНЯЯ РАМКА: ВИД ИКОНЫ ИЗ IKIND
C---------------------------------------------------------------------
 BOTLIN:,UTC,IKIND
 ,XTA,
 ,UTC,ZERO
 ,A-X,
 ,NTR,3
 ,UZA,BOT_RECT
 ,UTC,IKIND
 ,XTA,
 ,UTC,ONE
 ,A-X,
 ,NTR,3
 ,UZA,BOT_ROUND
 ,UTC,IKIND
 ,XTA,
 ,UTC,TWO
 ,A-X,
 ,NTR,3
 ,UZA,BOT_TRAP
 ,UJ,BOT_HEX
 BOT_RECT:M16,VTM,T_RECT
 ,UJ,BOT_OUT
 BOT_ROUND:M16,VTM,T_ROUND
 ,UJ,BOT_OUT
 BOT_TRAP:M16,VTM,T_TRAP
 ,UJ,BOT_OUT
 BOT_HEX:M16,VTM,T_HEX
 BOT_OUT:,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,SIX
 ,ITS,14
 M15,VJM,WRIKOR
 M15,VJM,ENDKOR
 M15,UJ,
C---------------------------------------------------------------------
C СТРОКА ТЕКСТА ИКОНЫ: ЧЕРТА, ВОСЕМЬ ЗНАКОВ СТРОКИ, ЧЕРТА
C---------------------------------------------------------------------
 TEXTLN:M16,VTM,T_BAR
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M15,VJM,WRIKOR
 M16,VTM,INS
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,EIGHT
 ,ITS,14
 M15,VJM,WRIKOR
 M16,VTM,T_BAR
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M15,VJM,WRIKOR
 M15,VJM,ENDKOR
 M15,UJ,
C---------------------------------------------------------------------
C ПУСТАЯ СТРОКА МЕЖДУ ИКОНАМИ
C---------------------------------------------------------------------
 EMPTY:M16,VTM,T_EMPTY
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,ZERO
 ,ITS,14
 M15,VJM,WRIKOR
 M15,VJM,ENDKOR
 M15,UJ,
C---------------------------------------------------------------------
C ЗАГОЛОВОК БЛОКА РАЗМЕТКИ: *RED И *RG*RU
C---------------------------------------------------------------------
 HEADER:M16,VTM,T_RED
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,FOUR
 ,ITS,14
 M15,VJM,WRIKOR
 M15,VJM,ENDKOR
 M16,VTM,T_FMT
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,SIX
 ,ITS,14
 M15,VJM,WRIKOR
 M15,VJM,ENDKOR
 M15,UJ,
C---------------------------------------------------------------------
C КОНЕЦ БЛОКА РАЗМЕТКИ: *E И *END
C---------------------------------------------------------------------
 TRAIL:M16,VTM,T_E
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,TWO
 ,ITS,14
 M15,VJM,WRIKOR
 M15,VJM,ENDKOR
 M16,VTM,T_END
 ,ITS,14
 M16,VTM,ONE
 ,ITS,14
 M16,VTM,FOUR
 ,ITS,14
 M15,VJM,WRIKOR
 M15,VJM,ENDKOR
 M15,UJ,
C=====================================================================
C ДАННЫЕ: КОНСТАНТЫ
C=====================================================================
 ,DATA,
C ЗНАЧЕНИЕ 0; ВИД ИКОНЫ ПО УМОЛЧАНИЮ (ПРЯМОУГОЛЬНИК) И КОД ПЕРВОГО ВИДА
 ZERO:,INT,0
C ЗНАЧЕНИЕ 1; СКРУГЛЁННАЯ ИКОНА, НАЧАЛЬНАЯ ПОЗИЦИЯ ВЫВОДА
 ONE:,INT,1
C ЗНАЧЕНИЕ 2; ТРАПЕЦИЯ, ДЛИНА СТРОКИ '*E'
 TWO:,INT,2
C ЗНАЧЕНИЕ 3; ШЕСТИУГОЛЬНИК
 THREE:,INT,3
C ЗНАЧЕНИЕ 4; ДЛИНА СТРОК '*RED' И '*END'
 FOUR:,INT,4
C ЗНАЧЕНИЕ 6; ДЛИНА СТРОКИ '*RG*RU' И РАМКИ ИКОНЫ
 SIX:,INT,6
C ЗНАЧЕНИЕ 8; ЧИСЛО ЗНАКОВ ТЕКСТА ИКОНЫ
 EIGHT:,INT,8
C ЗНАЧЕНИЕ 17; ПАРАМЕТР ВЫЗОВА GETSTR
 PARM17:,INT,17
C=====================================================================
C ДАННЫЕ: НАЧАЛА КЛЮЧЕВЫХ СЛОВ ДРАКОН, ПО ШЕСТЬ ЗНАКОВ
C=====================================================================
C ЗАГОЛОВОК
 KW_ZAG:,ISO,6HЗАГОЛО
C ВЕТКА
 KW_VET:,ISO,6HВЕТКА
C АДРЕС
 KW_ADR:,ISO,6HАДРЕС
C ДЕЙСТВИЕ
 KW_DEI:,ISO,6HДЕЙСТВ
C ЕСЛИ
 KW_ESL:,ISO,6HЕСЛИ
C ВЫБОР
 KW_VYB:,ISO,6HВЫБОР
C ВАРИАНТ
 KW_VAR:,ISO,6HВАРИАН
C ЦИКЛ
 KW_TSI:,ISO,6HЦИКЛ
C КОММЕНТАРИЙ
 KW_KOM:,ISO,6HКОММЕН
C КОНЕЦ
 KW_KON:,ISO,6HКОНЕЦ
C=====================================================================
C ДАННЫЕ: СТРОКИ РАЗМЕТКИ, ПО ШЕСТЬ ЗНАКОВ
C=====================================================================
C НАЧАЛО БЛОКА *RED
 T_RED:,ISO,6H*RED
C РАМКА И ШИРОКИЙ ФОРМАТ
 T_FMT:,ISO,6H*RG*RU
C КОНЕЦ БЛОКА *E
 T_E:,ISO,6H*E
C КОНЕЦ ПОТОКА *END
 T_END:,ISO,6H*END
C ПРЯМОУГОЛЬНИК: УГОЛ И ЧЕРТА
 T_RECT:,ISO,6H+-----
C СКРУГЛЁННАЯ ИКОНА
 T_ROUND:,ISO,6H.-----
C ТРАПЕЦИЯ: СДВИГ ВПРАВО И ЧЕРТА
 T_TRAP:,ISO,6H +----
C ШЕСТИУГОЛЬНИК: СДВИГ И ЧЕРТА
 T_HEX:,ISO,6H  +---
C ЧЕРТА ТЕКСТА ИКОНЫ
 T_BAR:,ISO,6H/
C ПУСТАЯ СТРОКА
 T_EMPTY:,ISO,6H
C=====================================================================
C ПЕРЕМЕННЫЕ
C=====================================================================
 ,BSS,
C IKIND: ВИД ТЕКУЩЕЙ ИКОНЫ (0 ПРЯМОУГОЛЬНИК, 1 СКРУГЛЁННАЯ,
C 2 ТРАПЕЦИЯ, 3 ШЕСТИУГОЛЬНИК)
 IKIND:,BSS,1
 ,END,
