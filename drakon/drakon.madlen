 ,A-X,
 ,UZA,В_ПРЯМ
 ,UTC,КВ_ДЕЙСТВ                         .ДЕЙСТВИЕ?
 ,A-X,
 ,UZA,В_ПРЯМ
 ,UJ,В_ПРЯМ                             .прочее - прямоугольник
C
 В_ГЕКСА:,UTC,Т_ГЕКСА
 ,XTA,
 ,UJ,ИКОНА
 В_ТРАПЕЦ:,UTC,Т_ТРАПЕЦ
 ,XTA,
 ,UJ,ИКОНА
 В_ПРЯМ:,UTC,Т_ПРЯМ
