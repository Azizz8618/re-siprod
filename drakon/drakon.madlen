C=====================================================================
C DRAKON - ТРАНСЛЯТОР СХЕМ ЯЗЫКА ДРАКОН (СИПРОД, МОНИТОР-80)
C=====================================================================
C Читает текст схемы ДРАКОН из входного потока (GETSTR) и печатает
C блок-схему на АЦПУ (WRIKOR + ENDKOR).
C
C Входной язык (карты схемы):
C   ЗАГОЛОВОК: текст   - икона заголовка (скруглённая)
C   ВЕТКА: текст       - имя ветки (трапеция)
C   ДЕЙСТВИЕ: текст    - икона действия (прямоугольник)
C   КОММЕНТАРИЙ: текст - икона комментария (прямоугольник)
C   ЕСЛИ: текст        - икона вопроса (шестиугольная рамка)
C   ЦИКЛ: текст        - икона цикла (шестиугольная рамка)
C   ВЫБОР: текст       - икона выбора (трапеция)
C   ВАРИАНТ: текст     - икона варианта (прямоугольник)
C   АДРЕС: текст       - икона адреса (трапеция)
C   КОНЕЦ              - икона конца; режим завершается
C   прочая карта       - икона действия (по умолчанию)
C
C Каждая икона = вертикальная линия соединения (кроме первой) +
C верхняя грань + строка текста + нижняя грань.  Карта печати:
C WRIKOR(адрес, число слов, число знаков) + ENDKOR.
C Пролог, кадр и шаблоны возврата - как у модуля SCHEMA.
C
C Внешние: *BLO*, *RUSIS*, *INS*, *NUSTA*, *EGO*, *NDAB*, *TXT*, *PAGE*,
C *STR*, *STAND*, *STANN*, *STV*, *MKR*, *SCANER*, *NUST*, *REGIM*,
C *FOP*, *RPT*, *GOT*, *FIN*, GETSTR, START, WRIKOR, ENDKOR
C Смещения в кадре (М7): общие 0-10, свои 12-15, 18, 21, 24-34
C Регистры: М1 (индекс), М2 (рабочий), М7 (указатель кадра),
C М10 (блок вызывающего), М12 (магазин), М15 (адрес возврата),
C М16 (модифицированный адрес), М17 (контекст задачи)
C Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C=====================================================================
 DRAKON  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M1:,EQU,1B
 M2:,EQU,2B
 M4:,EQU,4B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M14:,EQU,14B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
 *BLO*   :,LC,1
 *RUSIS* :,LC,1
 *INS*   :,LC,27
 *NUSTA* :,LC,1
 *EGO*   :,LC,13401
 *NDAB*  :,LC,4
 *TXT*   :,LC,4
 *PAGE*  :,LC,6
 *STR*   :,LC,27
 *STAND* :,LC,6
 *STANN* :,LC,1
 *STV*   :,LC,1
 *MKR*   :,LC,502
 *SCANER*:,LC,3
 *NUST*  :,LC,10
 *REGIM* :,LC,16
 *FOP*   :,LC,1
 *RPT*   :,LC,1
 *GOT*   :,LC,1
 *FIN*   :,LC,1
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 ENDKOR  :,SUBP,
 WRIKOR  :,SUBP,
 GETSTR  :,SUBP,
 START   :,SUBP,
C КОНСТАНТЫ: СМЕЩЕНИЯ В ОБЩИХ ОБЛАСТЯХ И ДРУГИЕ КОНСТАНТЫ
C КОНСТАНТА, ВЫРАЖЕНИЕ: *REGIM* -32767
 REGIM32767:,EQU,*REGIM* -32767
C КОНСТАНТА, ВЫРАЖЕНИЕ: *INS*   -32767
 INS32767:,EQU,*INS*   -32767
C КОНСТАНТА, ВЫРАЖЕНИЕ: *PAGE*  -32767
 PAGE32767:,EQU,*PAGE*  -32767
C КОНСТАНТА, ВЫРАЖЕНИЕ: *EGO*   -32767
 EGO32767:,EQU,*EGO*   -32767
C СМЕЩЕНИЕ 7200 В ОБЛАСТИ *EGO*
 EGO39967:,EQU,*EGO*+7200-32767
C=====================================================================
C ВХОД: ШАБЛОН СОПРОГРАММЫ И УСТАНОВКА ОС-ПРОГРАММ (КАК У SCHEMA)
C=====================================================================
 M16,VTM,REGIM3                         .М16 := адрес REGIM3
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на шаблон входа
C
 REGIM3:M7,XTA,1                        .СМ := слот кадра 1
 M7,ATX,31B                             .слот кадра 25 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 REGIMA:M7,XTA,1                        .СМ := слот кадра 1
 ,WTC,КОД_21                            .мод.адрес := код из V1
 M1,VTM,                                .М1 := код из V1
 M1,UTC,REGIM32767                      .мод.адрес := REGIM32767(М1)
 ,ATX,                                  .по адресу REGIM32767+М1 := СМ
  :7,XTA,31B                            .СМ := слот кадра 25
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,31B                             .слот кадра 25 := СМ
 M7,X-A,15B                             .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,REGIMA                            .если СМ=0 → REGIMA
 M7,XTA,11B                             .СМ := слот кадра 9
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,ATX,                                  .по адресу REGIM := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,1                               .СМ := слот кадра 1
 M7,ATX,32B                             .слот кадра 26 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ЧТЕНИЕ_РЕЖИМА:M7,XTA,-3                .СМ := каталог задачи: элемент 51
 ,WTC,КОД_22                            .мод.адрес := код из V2
 M1,VTM,                                .М1 := код из V2
 M1,UTC,INS32767                        .мод.адрес := INS32767(М1)
 ,ATX,                                  .по адресу INS32767+М1 := СМ
  :7,XTA,32B                            .СМ := слот кадра 26
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,32B                             .слот кадра 26 := СМ
 M7,X-A,17B                             .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ЧТЕНИЕ_РЕЖИМА                     .если СМ=0 → ЧТЕНИЕ_РЕЖИМА
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*FOP*                             .мод.адрес := FOP
 ,ATX,                                  .по адресу FOP := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*RPT*                             .мод.адрес := RPT
 ,ATX,                                  .по адресу RPT := СМ
 M7,XTA,                                .СМ := слот кадра 0
 M7,ATX,33B                             .слот кадра 27 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,ATX,                                  .по адресу INS26 := СМ
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*RUSIS*                           .мод.адрес := RUSIS
 ,ATX,                                  .по адресу RUSIS := СМ
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*GOT*                             .мод.адрес := GOT
 ,ATX,                                  .по адресу GOT := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,START                          .вызов через М15
 GOTA:,UTC,*GOT*                        .мод.адрес := GOT
 ,XTA,                                  .СМ := слово по адресу GOT
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*GOT*                             .мод.адрес := GOT
 ,ATX,                                  .по адресу GOT := СМ
 M7,XTA,                                .СМ := слот кадра 0
 M7,ATX,34B                             .слот кадра 28 := СМ
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A-X,                                  .СМ -= слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,ЦИКЛ_ПЕРЕХОД                      .если СМ≠0 → разбор
 ,UJ,ЗАПРОС_СТРОКИ                      .переход на чтение карты
C
 ЦИКЛ_ПЕРЕХОД:,UJ,РАЗБОР_КОМАНДЫ        .переход на разбор слова
C=====================================================================
C ГЛАВНЫЙ ЦИКЛ ТРАНСЛЯТОРА
C=====================================================================
 ЗАПРОС_СТРОКИ:M16,VTM,КОД_32           .М16 := адрес ячейки ИЗУ
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,GETSTR                         .чтение карты
 ,UTC,*INS*+25                          .мод.адрес := INS25
 ,XTA,                                  .СМ := число знаков карты
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,UTC,*INS*+24                          .мод.адрес := INS24
 ,XTA,                                  .СМ := признак конца потока
 ,UZA,ЗАВЕРШЕНИЕ                        .поток кончился -> завершение
C
C РАЗБОР КЛЮЧЕВОГО СЛОВА: СЛОВО 0 КАРТЫ (6 ЗНАКОВ), ЗАГРУЗКА АДРЕСА
C ОБРАБОТЧИКА ИКОНЫ
 РАЗБОР_КОМАНДЫ:,UTC,*INS*              .мод.адрес := INS
 ,XTA,                                  .СМ := слово 0 карты
 ,UTC,КВ_ЕСЛИ                           .ЕСЛИ?
 ,A-X,
 ,UZA,В_ГЕКСА
 ,UTC,КВ_ЦИКЛ                           .ЦИКЛ?
