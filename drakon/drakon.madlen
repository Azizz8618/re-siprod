CDRAKON - МОДУЛЬ РЕДАКТОРА СХЕМ ДРАКОН (автокод МАДЛЕН, Монитор-80)
C=====================================================================
C Редактор схем языка ДРАКОН - модуль личной библиотеки СИПРОДа.
C Читает текст программы на ДРАКОН из входного потока, строит дерево
C иконок по правилам синтаксиса (DRAKON.md §1), компонует схему по
C эргономическим правилам ДРАКОН (§2) и выдаёт разметку СИПРОДа *RED
C для печати на АЦПУ (§4).
C
C Алгоритм повторяет эталонный генератор tools/drakon_markup.py.
C
C Ключевые слова ДРАКОН -> иконы:
C   ЗАГОЛОВОК(1)  ВЕТКА(7)  АДРЕС(8)  ДЕЙСТВИЕ(3)  ЕСЛИ(4)  КОНЕЦ(2)
C   ВЫБОР(5)      ВАРИАНТ(6)  ЦИКЛ(4)   ТО/ИНАЧЕ     КОММЕНТАРИЙ(21)
C
C Соглашение вызова МАДЛЕН (как у всех модулей библиотеки):
C   М16 - модификатор адреса. Вызов подпрограммы X:
C       M16,VTM,X   ; М16 := адрес X
C       M15,VJM,X   ; переход через М15
C   Возврат: STI (восстановить М7,М1,М10), M15,UJ (переход через М15)
C   Внешние: GETSTR, WRIKOR, ENDKOR, KLAIDA
C   WRIKOR: 3 параметра через ITS,14 (адрес текста, длина, код), потом ENDKOR
C=====================================================================

 DRAKON  :,NAME, NEW DTRAN
C---------------------------------------------------------------------
C РЕГИСТРЫ МАШИНЫ (восьмеричные)
C---------------------------------------------------------------------
 M1:,EQU,1B
 M2:,EQU,2B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C---------------------------------------------------------------------
C ВНЕШНИЕ ОБЩИЕ ОБЛАСТИ ПАМЯТИ
C---------------------------------------------------------------------
 *EGO*   :,LC,13401      .общая область, буфер строк
 *INS*   :,LC,27         .входной поток: после GETSTR строка в *INS*
C---------------------------------------------------------------------
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
C---------------------------------------------------------------------
 GETSTR  :,SUBP,         .чтение строки входного потока
 WRIKOR  :,SUBP,         .запись текста в буфер вывода
 ENDKOR  :,SUBP,         .конец строки в буфере вывода
 KLAIDA  :,SUBP,         .сообщение об ошибке
C---------------------------------------------------------------------
C КОНСТАНТЫ: КОДЫ КЛЮЧЕВЫХ СЛОВ ДРАКОН
C---------------------------------------------------------------------
 KW_ZAGOLOVOK:,INT,1
 KW_VETKA:,INT,2
 KW_ADRES:,INT,3
 KW_DEISTVIE:,INT,4
 KW_ESLI:,INT,5
 KW_TO:,INT,6
 KW_INACHE:,INT,7
 KW_VYBOR:,INT,8
 KW_VARIANT:,INT,9
 KW_TSIKL:,INT,10
 KW_KOMMENTARIY:,INT,11
 KW_KONEC:,INT,12
C---------------------------------------------------------------------
C КОНСТАНТЫ: РАЗМЕРЫ
C---------------------------------------------------------------------
 MAXNOD:,INT,48          .макс. число иконок
 NODE_SZ:,INT,10         .полей на узел
C   узел: 0 kind,1 txtoff,2 txtlen,3 fc,4 ns,5 parent,6 x,7 y,8 w,9 h
 INNER:,INT,20           .мин. ширина поля текста (знаков)
 GAPCOL:,INT,4           .зазор шампура -> правое плечо
 GAPROW:,INT,2           .зазор по вертикали
 LINES_MAX:,INT,200      .макс. строк вывода
C---------------------------------------------------------------------
C КОДЫ СИМВОЛОВ ГОСТ 10859 (восьмерично)
C---------------------------------------------------------------------
 C_SPACE:,INT,040
 C_DOT:,INT,073
 C_MINUS:,INT,062
 C_PLUS:,INT,063
 C_SLASH:,INT,066
 C_LPAR:,INT,070
 C_RPAR:,INT,071
 C_LT:,INT,074
 C_GT:,INT,075
C---------------------------------------------------------------------
C ПЕРЕМЕННЫЕ (bss)
C---------------------------------------------------------------------
 PARSE_STACK:,BSS,32     .стек разбора: 16 уровней x (узел, отступ)
 PARSE_SP:,BSS,1
 NOD_KIND:,BSS,48
 NOD_TXTOFF:,BSS,48
 NOD_TXTLEN:,BSS,48
 NOD_FC:,BSS,48
 NOD_NS:,BSS,48
 NOD_PARENT:,BSS,48
 NOD_X:,BSS,48
 NOD_Y:,BSS,48
 NOD_W:,BSS,48
 NOD_H:,BSS,48
 TXT_BUF:,BSS,256        .текстовый буфер иконок
 TXT_LEN:,BSS,1
 LINE_BUF:,BSS,24        .копия строки входа
 LINE_LEN:,BSS,1         .длина строки (знаки)
 CUR_KIND:,BSS,1
 CUR_TXT_OFF:,BSS,1      .смещение текста (знаки)
 CUR_TXT_LEN:,BSS,1
 CUR_INDENT:,BSS,1
 NODEN:,BSS,1
 OUTN:,BSS,1
 LAY_ROW:,BSS,1
 LAY_MAXX:,BSS,1
 T0:,BSS,1
 T1:,BSS,1
 T2:,BSS,1
 T3:,BSS,1
 T4:,BSS,1
 OUT_LINE:,BSS,20        .буфер одной строки вывода
 OUT_LEN:,BSS,1
C=====================================================================
C КОД
C=====================================================================
C ВХОД: DRAKON - сохранить М16 (возврат монитору), инициализировать
C---------------------------------------------------------------------
 DRAKON:
  М16,MTJ,10             .М12 := М16
  М16,STI                .сохранить М16 в стек
  M7,MTJ,8               .М10 := М7
C обнулить NODEN, OUTN, PARSE_SP, TXT_LEN
  M1,VTM,НОЛЬ_АДР
  M1,UTC,НОДЕН_АДР
  ,ХРАН_НОЛЬ
  M1,UTC,ОУТН_АДР
  ,ХРАН_НОЛЬ
  M1,UTC,ПАРС_СП_АДР
  ,ХРАН_НОЛЬ
  M1,UTC,ТХТ_ЛЕН_АДР
  ,ХРАН_НОЛЬ
  М1,УЖ_Чerez_М15,ГЛАВНЫЙ_ЦИКЛ
C---------------------------------------------------------------------
C ГЛАВНЫЙ ЦИКЛ
C---------------------------------------------------------------------
 ГЛАВНЫЙ_ЦИКЛ:
  M15,VJM,GETSTR
  ,НТР,3
  ,НТР,22B
  ,УЗА,КОНЕЦ_ПОТОКА
  M16,VTM,КОПИР_СТРОКУ
  ,СЧИМ_М16
  M15,VJM,КОПИР_СТРОКУ
  M16,VTM,РАЗБОР_СТРОКИ
  ,СЧИМ_М16
  M15,VJM,РАЗБОР_СТРОКИ
  M16,VTM,ПРИСОЕД_УЗЕЛ
  ,СЧИМ_М16
  M15,VJM,ПРИСОЕД_УЗЕЛ
  ,УЖ_Чerez_М15,ГЛАВНЫЙ_ЦИКЛ
C---------------------------------------------------------------------
C КОНЕЦ ПОТОКА
C---------------------------------------------------------------------
 КОНЕЦ_ПОТОКА:
  M16,VTM,КОМПОНОВКА
  ,СЧИМ_М16
  M15,VJM,КОМПОНОВКА
  M16,VTM,РЕНДЕР
  ,СЧИМ_М16
  M15,VJM,РЕНДЕР
  M15,VJM,ENDKOR
  ,УЖ_Чerez_М15,ВОЗВРАТ_МОНИТОРУ
C---------------------------------------------------------------------
C ВОЗВРАТ В МОНИТОР
C---------------------------------------------------------------------
 ВОЗВРАТ_МОНИТОРУ:
  МОДА_0
  МОДА_0
  УИИ_М10_Чerez_М7
  УИИ_М12_Чerez_М16
  УИА_ВОЗВРАТ_МОНИТОРУ_Чerez_М16
  СЧИМ_М15
  СЧИМ_М1
  СЧИМ_М2
  СЧИМ_М10
  СЧИМ
  РЖА_3
  РЖА_2
  ПБ_0_Чerez_М12
  МОДА_0
  УИМ
  УИМ_М7
  УИМ_М2
  УИМ_М1
  УИМ_М10
  УИМ_М16
  ПБ_0_Чerez_М10
C=====================================================================
C ПОДПРОГРАММА КОПИРОВАНИЯ СТРОКИ (КОПИР_СТРОКУ)
C Копирует строку из *INS* в LINE_BUF, считает LINE_LEN
C---------------------------------------------------------------------
 КОПИР_СТРОКУ:
  . *INS*+24 = длина строки (слова), *INS*+25 = позиция, *INS*+26 = буфер
  . текст строки в *INS*[0..len-1]
  М1,VTM,*INS*+24
  ,UTC,0                 .СМ := длина (слова)
  M7,ATX,Т0_СЛОТ         .T0 := длина
  М1,VTM,LINE_BUF_АДР
  M1,VTM,                .М1 := SM (= длина) - хmm
  . копирование слова за словом
  ,УЖ_Чerez_М15,ВОЗВРАТ_ИЗ_ПОДпрограммы
C=====================================================================
C ПОДПРОГРАММА РАЗБОРА СТРОКИ (РАЗБОР_СТРОКИ)
C---------------------------------------------------------------------
 РАЗБОР_СТРОКИ:
  . отступ, ключевое слово, текст
  ,УЖ_Чerez_М15,ВОЗВРАТ_ИЗ_ПОДпрограммы
C=====================================================================
C ПОДПРОГРАММА ПРИСОЕДИНЕНИЯ УЗЛА (ПРИСОЕД_УЗЕЛ)
C---------------------------------------------------------------------
 ПРИСОЕД_УЗЕЛ:
  ,УЖ_Чerez_М15,ВОЗВРАТ_ИЗ_ПОДпрограммы
C=====================================================================
C ПОДПРОГРАММА КОМПОНОВКИ (КОМПОНОВКА)
C---------------------------------------------------------------------
 КОМПОНОВКА:
  ,УЖ_Чerez_М15,ВОЗВРАТ_ИЗ_ПОДпрограммы
C=====================================================================
C ПОДПРОГРАММА РЕНДЕРИНГА (РЕНДЕР)
C---------------------------------------------------------------------
 РЕНДЕР:
  ,УЖ_Чerez_М15,ВОЗВРАТ_ИЗ_ПОДпрограммы
C=====================================================================
C ВСПОМОГАТЕЛЬНАЯ: ВОЗВРАТ ИЗ ПОДПРОГРАММЫ (М15)
C---------------------------------------------------------------------
 ВОЗВРАТ_ИЗ_ПОДпрограммы:
  STI                    .ИР := СМ; СМ := из магазина
  ,STI,7                 .М7 := СМ
  ,STI,1                 .М1 := СМ
  ,STI,8                 .М10 := СМ
  M15,UJ,                .переход через М15
C=====================================================================
C ДАННЫЕ: адреса переменных
C---------------------------------------------------------------------
 ,DATA,
 НОЛЬ_АДР:,INT,0
 НОДЕН_АДР:,INT,NODEN
 ОУТН_АДР:,INT,OUTN
 ПАРС_СП_АДР:,INT,PARSE_SP
 ТХТ_ЛЕН_АДР:,INT,TXT_LEN
 LINE_BUF_АДР:,INT,LINE_BUF
 Т0_СЛОТ:,INT,T0
КОНЕЦ_ПОТОКА_МЕТКА:,INT,-1
 ЕДИНИЦА:,INT,1
C---------------------------------------------------------------------
C ТАБЛИЦА КЛЮЧЕВЫХ СЛОВ: код, длина(слова), слово1(ISO), слово2(ISO)
C---------------------------------------------------------------------
 KW_TABLE:
  INT,KW_ZAGOLOVOK
  INT,2
  ISO,6HЗАГОЛО
  ISO,6HВОК    
  INT,KW_VETKA
  INT,1
  ISO,6HВЕТКА  
  ISO,6H       
  INT,KW_ADRES
  INT,1
  ISO,6HАДРЕС  
  ISO,6H       
  INT,KW_DEISTVIE
  INT,2
  ISO,6HДЕЙСТВ
  ISO,6HИЕ    
  INT,KW_ESLI
  INT,1
  ISO,6HЕСЛИ   
  ISO,6H       
  INT,KW_TO
  INT,1
  ISO,6HТО     
  ISO,6H       
  INT,KW_INACHE
  INT,1
  ISO,6HИНАЧЕ  
  ISO,6H       
  INT,KW_VYBOR
  INT,1
  ISO,6HВЫБОР  
  ISO,6H       
  INT,KW_VARIANT
  INT,2
  ISO,6HВАРИАН
  ISO,6HТ     
  INT,KW_TSIKL
  INT,1
  ISO,6HЦИКЛ   
  ISO,6H       
  INT,KW_KOMMENTARIY
  INT,2
  ISO,6HКОММЕН
  ISO,6HТАРИЙ 
  INT,KW_KONEC
  INT,1
  ISO,6HКОНЕЦ  
  ISO,6H       
  INT,-1
C---------------------------------------------------------------------
C СТРОКИ *RED
C---------------------------------------------------------------------
 RED_ZAGOLOVOK:,ISO,6H*RED   .*
 RED_FORMAT:,ISO,6H*RG*RU    .*
 RED_END_BLOCK:,ISO,6H*E     .*
 RED_END_STREAM:,ISO,6H*END  .*
C---------------------------------------------------------------------
C ОБЛАСТЬ КАДРА
C---------------------------------------------------------------------
 ,DATA,
 КОД_1:,INT,1
 КОД_2:,INT,2
 КОД_10:,INT,10
 КОД_48:,INT,48
 КОД_256:,INT,256
 ,END,
