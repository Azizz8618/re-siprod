C ОБЩИЙ ВХОД ИКОНЫ: СМ = АДРЕС ОБРАБОТЧИКА.
C ПЕРЕД ИКОНОЙ - ВЕРТИКАЛЬНАЯ ЛИНИЯ (КРОМЕ ПЕРВОЙ ИКОНЫ СХЕМЫ)
 ИКОНА:,ATX,ЦЕЛЬ                        .[ЦЕЛЬ] := адрес обработчика
 ,UTC,ПЕРВАЯ                            .признак первой иконы
 ,XTA,
 ,UZA,ПЕЧВЕРТ                           .0 - линия нужна
 ,UTC,КОД_1                             .1 - первая икона: линию пропустить
 ,ATX,ПЕРВАЯ
 ,UJ,ИДТИ
 ПЕЧВЕРТ:M16,VTM,СВР1                .печать вертикали
 ,ITS,14
 M16,VTM,СЛОВ4
 ,ITS,14
 M16,VTM,ЗНАК24
 ,ITS,14
 M15,VJM,WRIKOR
 ,UTC,
 ,NTR,3
 ,NTR,22B
 M15,VJM,ENDKOR
 ,NTR,3
 ,NTR,22B
 ИДТИ:,UTC,ЦЕЛЬ                         .переход на обработчик иконы
 ,XTA,
 M16,ATI,
 M16,UJ,
