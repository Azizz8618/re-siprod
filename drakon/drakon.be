* Редактор языка ДРАКОН - модуль личной библиотеки (PERSO, том 2248).
*
*   Читает входной поток (текст программы на ДРАКОН) и строит разметку
*   СИПРОДа *RED для печати схемы на АЦПУ.
*
*   Выход из модуля - как у главной программы SCHEMA.
*
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 BLO
*   002 RUSIS
*   003 INS
*   004 INS24
*   005 INS25
*   006 INS26
*   007 NUSTA
*   008 EGO
*   009 EGO7200
*   010 EGO8600
*   011 EGO8601
*   012 NDAB
*   013 NDAB1
*   014 NDAB2
*   015 TXT
*   016 TXT3
*   017 PAGE
*   018 STR
*   019 STR24
*   020 STAND
*   021 STAND1
*   022 STANN
*   023 STV
*   024 MKR
*   025 MKR500
*   026 MKR501
*   027 SCANER
*   028 SCANER1
*   029 SCANER2
*   030 NUST
*   031 REGIM
*   032 FOP
*   033 RPT
