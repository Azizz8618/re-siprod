* PROBE - ПРОБА ПРОТОКОЛА: GETSTR (вход) + WRIKOR/ENDKOR (печать).
*
*   Читает строки входного потока, копирует слова 0-2 области INS
*   в свой буфер TBUF и печатает их одной картой (3 слова, 24 знака).
*   Цель: сверить кодировку входного потока и соглашение вызова
*   WRIKOR (адрес текста, адрес числа слов, адрес числа знаков).
*
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   003 INS
*   004 INS24
*   039 ENDKOR
*   040 WRIKOR
*   048 GETSTR
*** КОД МОДУЛЯ
*
PROBE    СТАРТ  0
         СЧИМ   М16                    ,сохранить М16 монитора в магазине
         МОДА   0
         МОДА   0
         УИА    PROBE1(М16)            ,М16 := адрес PROBE1
PROBE1   СЧИМ   М16                    ,в магазин; СМ := М16
         ПВ     GETSTR(М15)            ,чтение строки входного потока
         МОДА   0
         МОДА   INS24                  ,М16 := &INS24 (слово 24 области INS)
         РЖА    '3'                    ,РЖ := 3 (переходы по нулю)
         СЧ     0                      ,СМ := INS24: признак конца потока
         ПО     PROBEX                 ,поток кончился -> выход
         МОДА   0
*
* TBUF[0..2] := INS[0..2] - первые 24 знака строки
*
         УИА    INS(М1)                ,М1 := адрес INS
         СЧ     0(М1)                  ,СМ := слово 0 строки
         МОДА   TBUF                   ,М16 := &TBUF
         ЗП     0                      ,TBUF[0] := СМ
         МОДА   0
         СЧ     1(М1)                  ,СМ := слово 1 строки
         МОДА   TBUF1                  ,М16 := &TBUF1
         ЗП     0                      ,TBUF1[0] := СМ
         МОДА   0
         СЧ     2(М1)                  ,СМ := слово 2 строки
         МОДА   TBUF2                  ,М16 := &TBUF2
         ЗП     0                      ,TBUF2[0] := СМ
         МОДА   0
*
* печать буфера: WRIKOR(TBUF, NW3, NC24); ENDKOR
*
         УИА    TBUF(М16)              ,М16 := адрес TBUF
         СЧИМ   М16                    ,в магазин: адрес текста
         УИА    NW3(М16)               ,М16 := адрес числа слов
         СЧИМ   М16                    ,в магазин
         УИА    NC24(М16)              ,М16 := адрес числа знаков
         СЧИМ   М16                    ,в магазин
         ПВ     WRIKOR(М15)            ,запись карты в буфер вывода
         ПВ     ENDKOR(М15)            ,конец карты
         МОДА   0
         ПБ     PROBE1                 ,следующая строка
         МОДА   0                      ,выравнивание метки по границе слова
*
* выход в монитор (шаблон SKELDRAKON/SCHEMA)
*
PROBEX   МОДА   0
         МОДА   0
         УИИ    М10(М7)
         УИИ    М12(М16)
PROBEY   УИА    PROBEY(М16)
         СЧИМ   М15
         СЧИМ   М1
         СЧИМ   М2
         СЧИМ   М10
         СЧИМ
         РЖА    '3'
         РЖА    '2'
         ПБ     0(М12)
*
         МОДА   0
         УИМ
         УИМ    М7
         УИМ    М2
         УИМ    М1
         УИМ    М10
         УИМ    М16
         ПБ     0(М10)
         МОДА   0                      ,выравнивание данных по границе слова
*
*** ДАННЫЕ МОДУЛЯ
*
NW3      КОНД   В'0000000000000003'    ,число слов карты
NC24     КОНД   В'0000000000000030'    ,число знаков карты (24 = 0o30)
TBUF     ПАМ    1                      ,буфер: слово 0 строки
TBUF1    ПАМ    1                      ,слово 1 строки
TBUF2    ПАМ    1                      ,слово 2 строки
        ФИНИШ
