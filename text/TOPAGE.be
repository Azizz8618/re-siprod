STR25A   МОДА   STR25                   ,мод.адрес := STR25
         СЧ     0                       ,СМ := слово по адресу STR25
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     STR26A                  ,переход на STR26A
*
LOOP     УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К1(М16)                 ,М16 := адрес К1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    STR(М16)                ,М16 := адрес STR
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V3(М16)                 ,М16 := адрес V3
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     7(М7)                   ,СМ := слот кадра 7
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR26A   МОДА   STR26                   ,мод.адрес := STR26
         ВЧОБ   0                       ,СМ := слово по адресу STR26 - СМ
         ПО     LOOP                    ,если СМ=0 → LOOP
         МОДА   REGIM1                  ,мод.адрес := REGIM1
         СЧ     0                       ,СМ := слово по адресу REGIM1
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     0(М7)                   ,СМ += слот кадра 0
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     NDABB                   ,если СМ≠0 → NDABB
         ПБ     NDABC                   ,переход на NDABC
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
