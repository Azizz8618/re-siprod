***************************************************
* TOPAGE - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 14304 образа SIPROD.BIN
*   Длина при загрузке: 94 слов, 170 команд
*   Вход: TOPAGE
*   Выход: ENDPG:STANDC, ENDSTR:JMPA, SCHEMA:TXT3A, SPAUD:LOOPA, 
*   VIAPUZ:STANDA, VIAPUZ:STANDC, F7 (возврат через М12), 
*   POP (возврат через М10)
*   НАЧАЛО НОВОЙ СТРАНИЦЫ.
*   Внешние: REGIM, SEK, TXT, EGO, NUST, STR, NDAB, RSYMB, RNSYMB, IMUI
*   Смещения в EGO: 2400, 4800, 7200
*   Смещения в NDAB: 1, 2, 3
*   Смещения в REGIM: 1
*   Смещения в SEK: 3
*   Смещения в STR: 24, 25, 26
*   Смещения в TXT: 3
*   Смещения в кадре (М7): общие 0-2, 5-7, 10
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес), 
*   М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 REGIM
*   002 SEK
*   003 TXT
*   004 TXT3
*   005 EGO
*   006 EGO2400
*   007 EGO4800
*   008 EGO7200
*   009 NUST
*   010 STR
*   011 STR24
*   012 STR25
*   013 STR26
*   014 NDAB
*   015 NDAB1
*   016 NDAB2
*   017 NDAB3
*   018 RSYMB
*   019 RNSYMB
*   020 IMUI
*   021 SEK3
*   022 EGO35167
*   023 EGO37567
*   024 EGO32767
*   025 REGIM1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     125    1002004010020040
*   К1     126    6400000000000001
*   К4     131    6400000000000026
*   V1     133
*   V2     134
*   V3     135
*
*** КОД МОДУЛЯ
*
TOPAGE   СТАРТ  0
         УИА    NDABA(М16)              ,М16 := адрес NDABA
         ПБ     F7                      ,переход на F7
*
NDABA    МОДА   NDAB                    ,мод.адрес := NDAB
         СЧ     0                       ,СМ := слово по адресу NDAB
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     0(М7)                   ,СМ -= слот кадра 0
         УИА    К4(М16)                 ,М16 := адрес К4
         ПВ     IMUI(М15)               ,вызов через М15
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         МОДА   STR26                   ,мод.адрес := STR26
         СЧ     0                       ,СМ := слово по адресу STR26
         МОДА   STR25                   ,мод.адрес := STR25
         ВЧ     0                       ,СМ -= слово по адресу STR25
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         СЧ     2(М7)                   ,СМ := слот кадра 2
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   TXT3                    ,мод.адрес := TXT3
         СЧ     0                       ,СМ := слово по адресу TXT3
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     SEK3A                   ,если СМ=0 → SEK3A
         ПБ     SEK3B                   ,переход на SEK3B
*
SEK3A    ПБ     EGO327                  ,переход на EGO327
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK3B    СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SEK3                    ,мод.адрес := SEK3
         СЧ     0                       ,СМ := слово по адресу SEK3
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     SEK3C                   ,если СМ≠0 → SEK3C
         ПБ     SEK3E                   ,переход на SEK3E
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK3C    СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SEK3                    ,мод.адрес := SEK3
         СЧ     0                       ,СМ := слово по адресу SEK3
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
