         МОДА   SEK3                    ,мод.адрес := SEK3
         СЧ     0                       ,СМ := слово по адресу SEK3
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     EGO351                  ,если СМ≠0 → EGO351
         ПБ     EGO35A                  ,переход на EGO35A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO351   ПБ     EGO375                  ,переход на EGO375
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO35A   УИА    STR(М16)                ,М16 := адрес STR
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    STR25(М16)              ,М16 := адрес STR25
         СЧИМ   М16                     ,в магазин; СМ := М16
         МОД    V1                      ,мод.адрес := код из V1
         УИА    0(М1)                   ,М1 := код из V1
         МОДА   EGO35167(М1)            ,мод.адрес := EGO35167(М1)
         УИА    0(М16)                  ,М16 := адрес EGO35167+М1
         СЧИМ   М16                     ,в магазин; СМ := М16
