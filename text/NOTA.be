***************************************************
* NOTA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5920 образа SIPROD.BIN
*   Длина при загрузке: 12 слов, 20 команд
*   Вход: NOTA
*   Выход: GET (возврат через М15)
*   Регистры: М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), 
*   М13 (счётчик), М15 (адрес возврата)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     12
*   К1     13
*
*** КОД МОДУЛЯ
*
NOTA     СТАРТ  0
         УИ     М11                     ,М11 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М11)                  ,СМ := смещение в буфере 0
         МОДА   К0                      ,мод.адрес := К0
         ВЧОБ   0                       ,СМ := слово по адресу К0 - СМ
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИМ    М12                     ,М12 := СМ; СМ := из магазина
         УИ     М13                     ,М13 := СМ
         СЛИА   1(М11)                  ,М11 += 1
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
GET      СЧ     0(М13)                  ,СМ := смещение в буфере 0
         МОДА   К1                      ,мод.адрес := К1
         НТЖ    0                       ,СМ ^= слово по адресу К1
         СЛИА   1(М13)                  ,М13 += 1
         ЗП     0(М12)                  ,параметр вызова ОС 0 := СМ
         СЛИА   1(М12)                  ,М12 += 1
         ЦИКЛ   GET(М11)                ,М11-- и если ≠0 → повтор
         ЗПМ    0                       ,ЗП + магазин: 0
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         ПБ     0(М15)                  ,переход через М15
*
К0       КОНД   В'6400000000000000'
К1       КОНД   В'7777777777777777'
	ФИНИШ

