***************************************************
* COMANN - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 11584 образа SIPROD.BIN
*   Длина при загрузке: 46 слов, 82 команд
*   Вход: COMANN
*   Выход: SPAUD:SCAN08, F0 (возврат через М12), F0A (возврат через М10)
*   Внешние: INS, SCANER, LRE
*   Смещения в INS: 24, 25, 26
*   Смещения в LRE: 2, 3, 4, 5
*   Смещения в SCANER: 1, 2
*   Смещения в кадре (М7): общие 0-4, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 SCANER
*   006 SCANER1
*   007 SCANER2
*   008 LRE
*   009 LRE5
*   010 LRE3
*   011 LRE4
*   012 LRE2
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     51
*
*** КОД МОДУЛЯ
*
COMANN   СТАРТ  0
         УИА    SCANEA(М16)             ,М16 := адрес SCANEA
         ПБ     F0                      ,переход на F0
*
SCANEA   СЧ     2(М7)                   ,СМ := слот кадра 2
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     LRE5A                   ,если СМ≠0 → LRE5A
         ПБ     LRE5B                   ,переход на LRE5B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LRE5A    ПБ     SCANEB                  ,переход на SCANEB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LRE5B    СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   LRE5                    ,мод.адрес := LRE5
         ЗП     0                       ,по адресу LRE5 := СМ
         ПБ     SCANEF                  ,переход на SCANEF
*
SCANEB   СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     LRE3A                   ,если СМ≠0 → LRE3A
         ПБ     LRE3B                   ,переход на LRE3B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LRE3A    ПБ     SCANEC                  ,переход на SCANEC
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LRE3B    СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   LRE3                    ,мод.адрес := LRE3
         ЗП     0                       ,по адресу LRE3 := СМ
         ПБ     SCANEF                  ,переход на SCANEF
*
SCANEC   СЧ     3(М7)                   ,СМ := слот кадра 3
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     LRE4A                   ,если СМ≠0 → LRE4A
         ПБ     LRE4B                   ,переход на LRE4B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LRE4A    ПБ     SCANED                  ,переход на SCANED
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LRE4B    СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   LRE4                    ,мод.адрес := LRE4
         ЗП     0                       ,по адресу LRE4 := СМ
         ПБ     SCANEF                  ,переход на SCANEF
*
SCANED   СЧ     4(М7)                   ,СМ := слот кадра 4
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     LRE2A                   ,если СМ≠0 → LRE2A
         ПБ     LRE2B                   ,переход на LRE2B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LRE2A    ПБ     SCANEE                  ,переход на SCANEE
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LRE2B    СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   LRE2                    ,мод.адрес := LRE2
         ЗП     0                       ,по адресу LRE2 := СМ
         ПБ     SCANEF                  ,переход на SCANEF
*
SCANEE   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     0(М7)                   ,СМ -= слот кадра 0
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEF   ПБ     F0A                     ,переход на F0A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0A      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'6400000000000001'
	ФИНИШ

