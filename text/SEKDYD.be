***************************************************
* SEKDYD - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 11488 образа SIPROD.BIN
*   Длина при загрузке: 60 слов, 112 команд
*   Вход: SEKDYD
*   Внешние: SEK, LYG, DYD, REGIM, IMUI
*   Смещения в DYD: 1, 2
*   Смещения в LYG: 1, 2
*   Смещения в SEK: 2, 3
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 SEK
*   002 LYG
*   003 LYG1
*   004 LYG2
*   005 DYD
*   006 DYD1
*   007 DYD2
*   008 REGIM
*   009 SEK3
*   010 SEK2
*   011 LYG4
*   012 IMUI
*
SEKDYD   СТАРТ  0
         УИА    SEK3A(М16)              ,М16 := SEK3A
SEK3A    ПБ     V1A                     ,переход на V1A
         СЧ     0(М7)                   ,СМ := 0(М7)
         ЗП     3(М7)                   ,3 := СМ
         РЖА    '3'                     ,РЖ := '3'
         МОДА   SEK3                    ,мод.адрес +1: SEK3
         СЧ     0                       ,СМ := 0
L0007    СЧИМ                           ,СЧИ + магазин
LYG2A    МОДА   LYG2                    ,мод.адрес +1: LYG2
         СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     L0007                   ,если СМ=0 → L0007
         ПБ     LYG2A                   ,переход на LYG2A
         ПБ     SEK3B                   ,переход на SEK3B
V0       МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
SEK3B    ЗП     3(М7)                   ,3 := СМ
         РЖА    '3'                     ,РЖ := '3'
         МОДА   SEK3                    ,мод.адрес +1: SEK3
         СЧ     0                       ,СМ := 0
L0025    СЧИМ                           ,СЧИ + магазин
LYG2B    МОДА   LYG2                    ,мод.адрес +1: LYG2
         СЧ     0                       ,СМ := 0
         СЛ     1(М7)                   ,СМ += 1(М7)
         РЖА    '22'                    ,РЖ := '22'
L0032    НТЖ    0(М17)                  ,СМ ^= 0(М17)
V1       ПЕ     V0                      ,если СМ≠0 → V0
         ПБ     SEK3B                   ,переход на SEK3B
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     2(М7)                   ,СМ := 2(М7)
         ЗП     3(М7)                   ,3 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         СЧ     1(М7)                   ,СМ := 1(М7)
REGIMA   СЧИМ                           ,СЧИ + магазин
         МОДА   REGIM                   ,мод.адрес +1: REGIM
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
L0047    ПЕ     L0025                   ,если СМ≠0 → L0025
SEK2A    ПБ     LYG2B                   ,переход на LYG2B
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     LYG4A                   ,переход на LYG4A
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   SEK2                    ,мод.адрес +1: SEK2
LYG4A    СЧ     0                       ,СМ := 0
         СЧИМ                           ,СЧИ + магазин
         МОДА   LYG4                    ,мод.адрес +1: LYG4
L0060    СЧ     0                       ,СМ := 0
V1A      НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     L0032                   ,если СМ=0 → L0032
         ПБ     V1                      ,переход на V1
         ПБ     SEK2A                   ,переход на SEK2A
         МОДА   0                       ,мод.адрес +1: 0
L0066    СЧ     2(М7)                   ,СМ := 2(М7)
         УИА    IMUIB(М16)              ,М16 := IMUIB
IMUIA    ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
IMUIB    СЛ     2(М7)                   ,СМ += 2(М7)
         МОДА   DYD                     ,мод.адрес +1: DYD
         ЗП     0                       ,0 := СМ
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   LYG4                    ,мод.адрес +1: LYG4
         СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     REGIMA                  ,если СМ=0 → REGIMA
         ПБ     L0047                   ,переход на L0047
         СЧ     2(М7)                   ,СМ := 2(М7)
         УИА    IMUIB(М16)              ,М16 := IMUIB
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   DYD                     ,мод.адрес +1: DYD
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     L0060                   ,переход на L0060
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     2(М7)                   ,СМ := 2(М7)
         УИА    IMUIB(М16)              ,М16 := IMUIB
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         МОДА   DYD                     ,мод.адрес +1: DYD
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     L0060                   ,переход на L0060
         СЧ     3(М7)                   ,СМ := 3(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         МОДА   DYD                     ,мод.адрес +1: DYD
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     L0066                   ,переход на L0066
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    IMUIA(М7)               ,М7 := IMUIA
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

