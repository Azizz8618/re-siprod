***************************************************
* SEKDYD - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 11488 образа SIPROD.BIN
*   Длина при загрузке: 60 слов, 112 команд
*   Вход: SEKDYD
*   Выход: RASTXT:NDAB1E, SEGTAB:TAB3A, SEKGIR:DYDA, 
*   F3 (возврат через М12), F3A (возврат через М10)
*   Внешние: SEK, LYG, DYD, REGIM, IMUI
*   Смещения в DYD: 1, 2
*   Смещения в LYG: 1, 2
*   Смещения в SEK: 2, 3
*   Смещения в кадре (М7): общие 0-3, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 SEK
*   002 LYG
*   003 LYG1
*   004 LYG2
*   005 DYD
*   006 DYD1
*   007 DYD2
*   008 REGIM
*   009 SEK3
*   010 SEK2
*   011 LYG4
*   012 IMUI
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     70
*   V0     73
*
*** КОД МОДУЛЯ
*
SEKDYD   СТАРТ  0
         УИА    SEK3A(М16)              ,М16 := адрес SEK3A
         ПБ     F3                      ,переход на F3
*
SEK3A    СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   SEK3                    ,мод.адрес := SEK3
         СЧ     0                       ,СМ := слово по адресу SEK3
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   LYG2                    ,мод.адрес := LYG2
         СЧ     0                       ,СМ := слово по адресу LYG2
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     SEK3B                   ,если СМ=0 → SEK3B
         ПБ     SEK3C                   ,переход на SEK3C
*
SEK3B    ПБ     REGIMB                  ,переход на REGIMB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK3C    СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   SEK3                    ,мод.адрес := SEK3
         СЧ     0                       ,СМ := слово по адресу SEK3
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   LYG2                    ,мод.адрес := LYG2
         СЧ     0                       ,СМ := слово по адресу LYG2
         СЛ     1(М7)                   ,СМ += слот кадра 1
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     REGIMA                  ,если СМ≠0 → REGIMA
         ПБ     REGIMB                  ,переход на REGIMB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
REGIMA   СЧ     2(М7)                   ,СМ := слот кадра 2
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
REGIMB   СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   REGIM                   ,мод.адрес := REGIM
         СЧ     0                       ,СМ := слово по адресу REGIM
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     SEK2A                   ,если СМ≠0 → SEK2A
         ПБ     SEK2B                   ,переход на SEK2B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK2A    ПБ     DYDB                    ,переход на DYDB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK2B    МОДА   SEK2                    ,мод.адрес := SEK2
         СЧ     0                       ,СМ := слово по адресу SEK2
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   LYG4                    ,мод.адрес := LYG4
         СЧ     0                       ,СМ := слово по адресу LYG4
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F1                      ,если СМ=0 → F1
         ПБ     F2                      ,переход на F2
*
F1       ПБ     F2B                     ,переход на F2B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2       СЧ     2(М7)                   ,СМ := слот кадра 2
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     2(М7)                   ,СМ += слот кадра 2
         МОДА   DYD                     ,мод.адрес := DYD
         ЗП     0                       ,по адресу DYD := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   LYG4                    ,мод.адрес := LYG4
         СЧ     0                       ,СМ := слово по адресу LYG4
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F2A                     ,если СМ=0 → F2A
         ПБ     DYDA                    ,переход на DYDA
*
F2A      СЧ     2(М7)                   ,СМ := слот кадра 2
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         МОДА   DYD                     ,мод.адрес := DYD
         ЗП     0                       ,по адресу DYD := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
DYDA     ПБ     DYDC                    ,переход на DYDC
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2B      СЧ     2(М7)                   ,СМ := слот кадра 2
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         МОДА   DYD                     ,мод.адрес := DYD
         ЗП     0                       ,по адресу DYD := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     DYDC                    ,переход на DYDC
*
DYDB     СЧ     3(М7)                   ,СМ := слот кадра 3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         МОДА   DYD                     ,мод.адрес := DYD
         ЗП     0                       ,по адресу DYD := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
DYDC     ПБ     F3A                     ,переход на F3A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3A      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

