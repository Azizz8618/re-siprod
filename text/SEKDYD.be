***************************************************
* SEKDYD - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 11488 образа SIPROD.BIN
*   Длина при загрузке: 60 слов, 112 команд
*   Вход: SEKDYD
*   Внешние: SEK, LYG, DYD, REGIM, IMUI
*   Смещения в DYD: 1, 2
*   Смещения в LYG: 1, 2
*   Смещения в SEK: 2, 3
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 SEK
*   002 LYG
*   003 LYG1
*   004 LYG2
*   005 DYD
*   006 DYD1
*   007 DYD2
*   008 REGIM
*   009 SEK3
*   010 SEK2
*   011 LYG4
*   012 IMUI
*
SEKDYD   СТАРТ  0
         УИА    SEK3A(М16)              ,М16 := SEK3A
SEK3A    ПБ     SEK2C                   ,переход на SEK2C
         СЧ     0(М7)                   ,СМ := 0(М7)
         ЗП     3(М7)                   ,3 := СМ
         РЖА    '3'                     ,РЖ := '3'
         МОДА   SEK3                    ,мод.адрес +1: SEK3
         СЧ     0                       ,СМ := 0
SEK3B    СЧИМ                           ,СЧИ + магазин
SEK3C    МОДА   LYG2                    ,мод.адрес +1: LYG2
         СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     SEK3B                   ,если СМ=0 → SEK3B
         ПБ     SEK3C                   ,переход на SEK3C
         ПБ     SEK3E                   ,переход на SEK3E
SEK3D    МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
SEK3E    ЗП     3(М7)                   ,3 := СМ
         РЖА    '3'                     ,РЖ := '3'
         МОДА   SEK3                    ,мод.адрес +1: SEK3
         СЧ     0                       ,СМ := 0
SEK3F    СЧИМ                           ,СЧИ + магазин
SEK3G    МОДА   LYG2                    ,мод.адрес +1: LYG2
         СЧ     0                       ,СМ := 0
         СЛ     1(М7)                   ,СМ += 1(М7)
         РЖА    '22'                    ,РЖ := '22'
SEK3H    НТЖ    0(М17)                  ,СМ ^= 0(М17)
SEK3I    ПЕ     SEK3D                   ,если СМ≠0 → SEK3D
         ПБ     SEK3E                   ,переход на SEK3E
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     2(М7)                   ,СМ := 2(М7)
         ЗП     3(М7)                   ,3 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         СЧ     1(М7)                   ,СМ := 1(М7)
REGIMA   СЧИМ                           ,СЧИ + магазин
         МОДА   REGIM                   ,мод.адрес +1: REGIM
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
REGIMB   ПЕ     SEK3F                   ,если СМ≠0 → SEK3F
REGIMC   ПБ     SEK3G                   ,переход на SEK3G
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     SEK2A                   ,переход на SEK2A
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   SEK2                    ,мод.адрес +1: SEK2
SEK2A    СЧ     0                       ,СМ := 0
         СЧИМ                           ,СЧИ + магазин
         МОДА   LYG4                    ,мод.адрес +1: LYG4
SEK2B    СЧ     0                       ,СМ := 0
SEK2C    НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     SEK3H                   ,если СМ=0 → SEK3H
         ПБ     SEK3I                   ,переход на SEK3I
         ПБ     REGIMC                  ,переход на REGIMC
         МОДА   0                       ,мод.адрес +1: 0
V2       СЧ     2(М7)                   ,СМ := 2(М7)
         УИА    DYDA(М16)               ,М16 := DYDA
IMUIA    ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
DYDA     СЛ     2(М7)                   ,СМ += 2(М7)
         МОДА   DYD                     ,мод.адрес +1: DYD
         ЗП     0                       ,0 := СМ
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   LYG4                    ,мод.адрес +1: LYG4
         СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     REGIMA                  ,если СМ=0 → REGIMA
         ПБ     REGIMB                  ,переход на REGIMB
         СЧ     2(М7)                   ,СМ := 2(М7)
         УИА    DYDA(М16)               ,М16 := DYDA
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   DYD                     ,мод.адрес +1: DYD
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     SEK2B                   ,переход на SEK2B
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     2(М7)                   ,СМ := 2(М7)
         УИА    DYDA(М16)               ,М16 := DYDA
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         МОДА   DYD                     ,мод.адрес +1: DYD
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     SEK2B                   ,переход на SEK2B
         СЧ     3(М7)                   ,СМ := 3(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         МОДА   DYD                     ,мод.адрес +1: DYD
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     V2                      ,переход на V2
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    IMUIA(М7)               ,М7 := IMUIA
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

