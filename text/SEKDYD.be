***************************************************
* SEKDYD - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 11488 образа SIPROD.BIN
*   Длина при загрузке: 60 слов, 112 команд
*   Вход: SEKDYD
*   Внешние: *SEK*, *LYG*, *DYD*, *REGIM*, I*MU*I
*   Смещения в *DYD*: 1, 2
*   Смещения в *LYG*: 1, 2
*   Смещения в *SEK*: 2, 3
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
SEKDYD  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     V12                      ,переход на V12
SEK3    СЧ     SEKDYD(М7)               ,СМ := SEKDYD(М7)
        ЗП     3(М7)                    ,3 := СМ
        РЖА    '3'                      ,РЖ := '3'
        МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
        СЧ     SEKDYD                   ,СМ := SEKDYD
L0007   СЧИМ                            ,СЧИ + магазин
LYG2    МОДА   *LYG*+2                  ,мод.адрес +1: *LYG*+2
        СЧ     SEKDYD                   ,СМ := SEKDYD
L0012   РЖА    '22'                     ,РЖ := '22'
        НТЖ    SEKDYD(М17)              ,СМ ^= SEKDYD(М17)
        ПО     L0007                    ,если СМ=0 → L0007
        ПБ     LYG2                     ,переход на LYG2
        ПБ     SEK32                    ,переход на SEK32
L0017   МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        СЧ     1(М7)                    ,СМ := 1(М7)
SEK32   ЗП     3(М7)                    ,3 := СМ
        РЖА    '3'                      ,РЖ := '3'
        МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
        СЧ     SEKDYD                   ,СМ := SEKDYD
L0025   СЧИМ                            ,СЧИ + магазин
LYG22   МОДА   *LYG*+2                  ,мод.адрес +1: *LYG*+2
        СЧ     SEKDYD                   ,СМ := SEKDYD
        СЛ     L0001(М7)                ,СМ += L0001(М7)
        РЖА    '22'                     ,РЖ := '22'
L0032   НТЖ    SEKDYD(М17)              ,СМ ^= SEKDYD(М17)
V1      ПЕ     L0017                    ,если СМ≠0 → L0017
        ПБ     SEK32                    ,переход на SEK32
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        СЧ     2(М7)                    ,СМ := 2(М7)
        ЗП     3(М7)                    ,3 := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        СЧ     1(М7)                    ,СМ := 1(М7)
REGIM   СЧИМ                            ,СЧИ + магазин
        МОДА   *REGIM*                  ,мод.адрес +1: *REGIM*
        СЧ     SEKDYD                   ,СМ := SEKDYD
        НТЖ    SEKDYD(М17)              ,СМ ^= SEKDYD(М17)
L0047   ПЕ     L0025                    ,если СМ≠0 → L0025
SEK2    ПБ     LYG22                    ,переход на LYG22
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        ПБ     СИМ13                    ,переход на СИМ13
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        МОДА   *SEK*+2                  ,мод.адрес +1: *SEK*+2
СИМ13   СЧ     SEKDYD                   ,СМ := SEKDYD
        СЧИМ                            ,СЧИ + магазин
        МОДА   СИМ13                    ,мод.адрес +1: СИМ13
L0060   СЧ     SEKDYD                   ,СМ := SEKDYD
V12     НТЖ    SEKDYD(М17)              ,СМ ^= SEKDYD(М17)
        ПО     L0032                    ,если СМ=0 → L0032
        ПБ     V1                       ,переход на V1
        ПБ     SEK2                     ,переход на SEK2
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
L0066   СЧ     2(М7)                    ,СМ := 2(М7)
        УИА    IMUI2(М16)               ,М16 := IMUI2
IMUI    ПВ     I*MU*I(М15)              ,вызов через М15
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        РЖА    '3'                      ,РЖ := '3'
IMUI2   СЛ     SEK3(М7)                 ,СМ += SEK3(М7)
        МОДА   *DYD*                    ,мод.адрес +1: *DYD*
        ЗП     SEKDYD                   ,SEKDYD := СМ
        СЧ     1(М7)                    ,СМ := 1(М7)
        СЧИМ                            ,СЧИ + магазин
        МОДА   СИМ13                    ,мод.адрес +1: СИМ13
        СЧ     SEKDYD                   ,СМ := SEKDYD
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    SEKDYD(М17)              ,СМ ^= SEKDYD(М17)
        ПО     REGIM                    ,если СМ=0 → REGIM
        ПБ     L0047                    ,переход на L0047
        СЧ     2(М7)                    ,СМ := 2(М7)
        УИА    IMUI2(М16)               ,М16 := IMUI2
        ПВ     I*MU*I(М15)              ,вызов через М15
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        МОДА   *DYD*                    ,мод.адрес +1: *DYD*
        ЗП     SEKDYD                   ,SEKDYD := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПБ     L0060                    ,переход на L0060
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        СЧ     2(М7)                    ,СМ := 2(М7)
        УИА    IMUI2(М16)               ,М16 := IMUI2
        ПВ     I*MU*I(М15)              ,вызов через М15
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        РЖА    '3'                      ,РЖ := '3'
        СЛ     L0001(М7)                ,СМ += L0001(М7)
        МОДА   *DYD*                    ,мод.адрес +1: *DYD*
        ЗП     SEKDYD                   ,SEKDYD := СМ
        РЖА    '22'                     ,РЖ := '22'
        ПБ     L0060                    ,переход на L0060
        СЧ     3(М7)                    ,СМ := 3(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     L0001(М7)                ,СМ += L0001(М7)
        МОДА   *DYD*                    ,мод.адрес +1: *DYD*
        ЗП     SEKDYD                   ,SEKDYD := СМ
        РЖА    '22'                     ,РЖ := '22'
        ПБ     L0066                    ,переход на L0066
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    IMUI(М7)                 ,М7 := IMUI
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     SEKDYD(М12)              ,переход через М12
        МОДА   SEKDYD                   ,мод.адрес +1: SEKDYD
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     SEKDYD(М10)              ,переход через М10

