L0030    ВЧОБ   3(М7)                   ,СМ := (адрес) - СМ
         ПО     L0006                   ,если СМ=0 → L0006
         УИА    V5A(М16)                ,М16 := V5A
         СЧИМ   М16                     ,стек := М16, СМ := М16
RMAKRA   ПВ     RMAKR(М15)              ,вызов через М15
V5A      МОДА   0                       ,мод.адрес +1: 0
L0036    УИА    L0036(М16)              ,М16 := L0036
         СЧИМ   М16                     ,стек := М16, СМ := М16
RMAKRB   ПВ     RMAKR(М15)              ,вызов через М15
PAPRAA   МОДА   0                       ,мод.адрес +1: 0
         ПВ     PAPRAP(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     L0030                   ,переход на L0030
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
