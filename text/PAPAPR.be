         ПВ     IMUI(М15)               ,вызов через М15
V4       РЖА    '3'                     ,РЖ := '3'
         СЛ     0(М7)                   ,СМ += 0(М7)
         ЗП     4(М7)                   ,4 := СМ
         ЗП     5(М7)                   ,5 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     EGO399                  ,переход на EGO399
*
EGO399   СЧ     '4020'(М7)              ,СМ := '4020'(М7)
         МОД    V5B                     ,мод.адрес по коду: V5B
         УИА    0(М1)                   ,М1 := 0
         МОДА   EGO39967(М1)            ,мод.адрес +1: EGO39967(М1)
         ЗП     0                       ,0 := СМ
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     5(М7)                   ,СМ := 5(М7)
EGO39A   РЖА    '3'                     ,РЖ := '3'
         СЛ     0(М7)                   ,СМ += 0(М7)
         ЗП     5(М7)                   ,5 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
EGO39B   ВЧОБ   3(М7)                   ,СМ := (адрес) - СМ
         ПО     V4                      ,если СМ=0 → V4
         УИА    V5(М16)                 ,М16 := V5
         СЧИМ   М16                     ,стек := М16, СМ := М16
RMAKRA   ПВ     RMAKR(М15)              ,вызов через М15
V5       МОДА   0                       ,мод.адрес +1: 0
V5A      УИА    V5A(М16)                ,М16 := V5A
         СЧИМ   М16                     ,стек := М16, СМ := М16
RMAKRB   ПВ     RMAKR(М15)              ,вызов через М15
V5B      МОДА   0                       ,мод.адрес +1: 0
         ПВ     PAPRAP(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     EGO39B                  ,переход на EGO39B
*
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    RMAKRA(М7)              ,М7 := RMAKRA
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М1                      ,стек := М1, СМ := М1
         СЧИМ   М10                     ,стек := М10, СМ := М10
V5C      СЧИМ                           ,СЧИ + магазин
V5D      РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
*
