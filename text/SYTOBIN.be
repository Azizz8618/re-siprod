***************************************************
* SYTOBIN - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5696 образа SIPROD.BIN
*   Длина при загрузке: 59 слов, 116 команд
*   Вход: SYTOBIN
*   Выход: RINT:L9, PUT (возврат через М15), CMP (возврат через М15), 
*   CMP (возврат через М15), L58C (возврат через М15), 
*   WAIT (возврат через М15), WAIT (возврат через М15), 
*   WAIT (возврат через М15), WAIT (возврат через М15)
*   Регистры: М7, М10, М11, М12, М13, М14, М15, М16, М17
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 СИМ1
*   002 СИМ2
*   003 СИМ3
*   004 СИМ4
*   005 СИМ5
*
*** КОД МОДУЛЯ
*
SYTOBI   СТАРТ  0
         ПБ     JMP                     ,переход на JMP
*
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     ADD                     ,переход на ADD
*
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     L58A                    ,переход на L58A
*
         МОДА   0                       ,мод.адрес +1: 0
JMP      ПБ     L58C                    ,переход на L58C
*
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     FRAME                   ,переход на FRAME
*
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     CMP                     ,переход на CMP
*
FRAME    МОДА   0                       ,мод.адрес +1: 0
         СЧ     8(М12)                  ,СМ := 8(М12)
         И      5(М10)                  ,СМ &= 5(М10)
         СЧМ    7(М12)                  ,магазин + СЧ: 7(М12)
         СДА    64-2                    ,сдвиг СМ влево на 2
         СЛЦ    7(М12)                  ,СМ += 7(М12) [цикли.]
SHL      СДА    64-1                    ,сдвиг СМ влево на 1
ADD      СЛЦ    0(М17)                  ,СМ += 0(М17) [цикли.]
PUT      ЗП     7(М12)                  ,7 := СМ
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес +1: 0
         УИ     М7                      ,М7 := СМ
         СЛИА   СИМ1(М7)                ,М7 += СИМ1
GETR     СЧИ    М7                      ,СМ := М7
         И      4(М10)                  ,СМ &= 4(М10)
CMP      ПЕ     SHL                     ,если СМ≠0 → SHL
         СЛИА   СИМ2(М7)                ,М7 += СИМ2
         СЧИ    М7                      ,СМ := М7
         И      4(М10)                  ,СМ &= 4(М10)
         ПО     SHL                     ,если СМ=0 → SHL
         УИА    0(М7)                   ,М7 := 0
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес +1: 0
         УИА    1(М7)                   ,М7 := 1
         ПБ     0(М15)                  ,переход через М15
*
L58      СЛИА   7(М11)                  ,М11 += 7
L58A     ПИО    GETR(М11)               ,если ИР=0 → GETR(М11)
         СЧ     0(М14)                  ,СМ := 0(М14)
         СЛИА   СИМ3(М11)               ,М11 += СИМ3
         МОДА   58(М10)                 ,мод.адрес +1: 58(М10)
         СД     6(М11)                  ,сдвиг СМ на М11
         СЧМР   64-64                   ,СМ := РМР (результат мантиссы)
         И      1(М10)                  ,СМ &= 1(М10)
L58B     СЛИА   СИМ4(М11)               ,М11 += СИМ4
         ЗП     8(М12)                  ,8 := СМ
L58C     ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес +1: 0
         УИА    6(М11)                  ,М11 := 6
INC      СЛИА   1(М14)                  ,М14 += 1
         ПБ     PUT                     ,переход на PUT
*
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     3(М10)                  ,СМ += 3(М10)
PUTA     ЗП     0(М17)                  ,0 := СМ
         УИ     М11                     ,М11 := СМ
         ПЕ     L58                     ,если СМ≠0 → L58
         ПИО    L58(М11)                ,если ИР=0 → L58(М11)
WAIT     РЖА    '6'                     ,РЖ := '6'
         МОДА   WAIT                    ,мод.адрес +1: WAIT
         ВЧ     0                       ,СМ -= 0
         ДЕЛ    '114'(М10)              ,СМ /= '114'(М10)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     3(М10)                  ,СМ += 3(М10)
         УИ     М7                      ,М7 := СМ
         РЖА    '6'                     ,РЖ := '6'
         УМН    '114'(М10)              ,СМ *= '114'(М10)
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   '4004'(М17)             ,СМ := (адрес) - СМ
         УИМ    М11                     ,М11 := СМ + стек
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес +1: 0
         УИА    СИМ4(М7)                ,М7 := СИМ4
         ПБ     0(М15)                  ,переход через М15
*
         ПИО    L58B(М13)               ,если ИР=0 → L58B(М13)
         СЧ     1(М10)                  ,СМ := 1(М10)
         МОДА   58(М10)                 ,мод.адрес +1: 58(М10)
         СД     7(М13)                  ,сдвиг СМ на М13
         НТЖ    2(М10)                  ,СМ ^= 2(М10)
         И      0(М16)                  ,СМ &= 0(М16)
         СЧМ    8(М12)                  ,магазин + СЧ: 8(М12)
         МОДА   58(М10)                 ,мод.адрес +1: 58(М10)
         СД     7(М13)                  ,сдвиг СМ на М13
         СЛИА   1(М13)                  ,М13 += 1
         ИЛИ    0(М17)                  ,СМ |= 0(М17)
         ЗП     0(М16)                  ,0 := СМ
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес +1: 0
         УИА    СИМ5(М13)               ,М13 := СИМ5
         СЛИА   1(М16)                  ,М16 += 1
         ПБ     L58A                    ,переход на L58A
*
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   '101'(М10)              ,мод.адрес +1: '101'(М10)
         УИА    0(М11)                  ,М11 := 0
         РЖА    '2'                     ,РЖ := '2'
         СЛ     0                       ,СМ += 0
         ВЧПА   64+32                   ,порядок -= 64+32
         МОДА   0                       ,мод.адрес +1: 0
         ЗП     0(М17)                  ,0 := СМ
         ДЕЛ    '115'(М10)              ,СМ /= '115'(М10)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     0(М11)                  ,СМ += 0(М11)
         РЖА    '2'                     ,РЖ := '2'
         УМН    '114'(М10)              ,СМ *= '114'(М10)
         РЖА    '7'                     ,РЖ := '7'
         ПО     PUTA                    ,если СМ=0 → PUTA
         СЛ     0(М17)                  ,СМ += 0(М17)
         ЦИКЛ   INC(М11)                ,М11-- и если ≠0 → повтор
         СЧ     0(М17)                  ,СМ := 0(М17)
         СЛПА   64+32                   ,порядок += 64+32
         РЖА    '3'                     ,РЖ := '3'
         СЛ     3(М10)                  ,СМ += 3(М10)
         И      8(М10)                  ,СМ &= 8(М10)
