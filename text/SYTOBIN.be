***************************************************
* SYTOBIN - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5696 образа SIPROD.BIN
*   Длина при загрузке: 59 слов, 116 команд
*   Вход: SYTOBIN
*   Выход: RINT:L9, GET (возврат через М15), SETR (возврат через М15), 
*   ADDR (возврат через М15), L58A (возврат через М15), 
*   WAIT (возврат через М15), ADDRB (возврат через М15), 
*   L58B (возврат через М15), L101B (возврат через М15)
*   Абсолютные символы: N1 = -1, N10 = -10, N48 = -48, N6 = -6, N7 = -7
*   Смещения в кадре (М7): общие 0-1, 10, свои 48
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), М13 (счётчик), 
*   М14 (смещение в буфере), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 N48
*   002 N10
*   003 N7
*   004 N1
*   005 N6
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     72
*
*** КОД МОДУЛЯ
*
SYTOBI   СТАРТ  0
         ПБ     GET                     ,переход на GET
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     L58                     ,переход на L58
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     L58B                    ,переход на L58B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     L101                    ,переход на L101
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     SETR                    ,переход на SETR
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     WAIT                    ,переход на WAIT
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
GET      СЧ     8(М12)                  ,СМ := параметр вызова ОС 8
         И      5(М10)                  ,СМ &= поле блока вызывающего 5
         СЧМ    7(М12)                  ,магазин + СЧ: 7(М12)
         СДА    64-2
         СЛЦ    7(М12)                  ,СМ += параметр вызова ОС 7 [цикли.]
         СДА    64-1
         СЛЦ    0(М17)                  ,СМ += поле контекста 0 [цикли.]
         ЗП     7(М12)                  ,параметр вызова ОС 7 := СМ
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SETR     УИ     М7                      ,М7 := СМ
         СЛИА   N48(М7)                 ,М7 += N48
         СЧИ    М7                      ,СМ := М7
         И      4(М10)                  ,СМ &= поле блока вызывающего 4
         ПЕ     ADDR                    ,если СМ≠0 → ADDR
         СЛИА   N10(М7)                 ,М7 += N10
         СЧИ    М7                      ,СМ := М7
         И      4(М10)                  ,СМ &= поле блока вызывающего 4
         ПО     ADDR                    ,если СМ=0 → ADDR
         УИА    0(М7)                   ,М7 := база модуля
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ADDR     УИА    1(М7)                   ,М7 := адрес 1
         ПБ     0(М15)                  ,переход через М15
*
L58      СЛИА   7(М11)                  ,М11 += 7
         ПИО    ADDRA(М11)              ,если ИР=0 → ADDRA(М11)
L58A     СЧ     0(М14)                  ,СМ := смещение в буфере 0
         СЛИА   N7(М11)                 ,М11 += N7
         МОДА   58(М10)                 ,мод.адрес := 58(М10)
         СД     6(М11)                  ,сдвиг СМ на М11
         СЧМР   64-64                   ,СМ := РМР (результат мантиссы)
         И      1(М10)                  ,СМ &= поле блока вызывающего 1
         СЛИА   N1(М11)                 ,М11 += N1
         ЗП     8(М12)                  ,параметр вызова ОС 8 := СМ
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ADDRA    УИА    6(М11)                  ,М11 := адрес 6
         СЛИА   1(М14)                  ,М14 += 1
         ПБ     L58A                    ,переход на L58A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
WAIT     РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     3(М10)                  ,СМ += поле блока вызывающего 3
         ЗП     0(М17)                  ,поле контекста 0 := СМ
         УИ     М11                     ,М11 := СМ
         ПЕ     ADDRB                   ,если СМ≠0 → ADDRB
         ПИО    ADDRB(М11)              ,если ИР=0 → ADDRB(М11)
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОДА   К0                      ,мод.адрес := К0
         ВЧ     0                       ,СМ -= слово по адресу К0
         ДЕЛ    '114'(М10)              ,СМ /= поле блока вызывающего 76
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     3(М10)                  ,СМ += поле блока вызывающего 3
         УИ     М7                      ,М7 := СМ
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         УМН    '114'(М10)              ,СМ *= поле блока вызывающего 76
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   '4004'(М17)             ,СМ := (адрес) - СМ
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ADDRB    УИА    N1(М7)                  ,М7 := адрес N1
         ПБ     0(М15)                  ,переход через М15
*
L58B     ПИО    ADDRC(М13)              ,если ИР=0 → ADDRC(М13)
         СЧ     1(М10)                  ,СМ := поле блока вызывающего 1
         МОДА   58(М10)                 ,мод.адрес := 58(М10)
         СД     7(М13)                  ,сдвиг СМ на М13
         НТЖ    2(М10)                  ,СМ ^= поле блока вызывающего 2
         И      0(М16)                  ,СМ &= ячейка мод.адреса 0
         СЧМ    8(М12)                  ,магазин + СЧ: 8(М12)
         МОДА   58(М10)                 ,мод.адрес := 58(М10)
         СД     7(М13)                  ,сдвиг СМ на М13
         СЛИА   1(М13)                  ,М13 += 1
         ИЛИ    0(М17)                  ,СМ |= поле контекста 0
         ЗП     0(М16)                  ,ячейка мод.адреса 0 := СМ
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ADDRC    УИА    N6(М13)                 ,М13 := адрес N6
         СЛИА   1(М16)                  ,М16 += 1
         ПБ     L58B                    ,переход на L58B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L101     МОДА   '101'(М10)              ,мод.адрес := '101'(М10)
         УИА    0(М11)                  ,М11 := адрес '101'+М10
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         СЛ     0                       ,СМ += 0
         ВЧПА   64+32                   ,порядок -= 64+32
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L101A    ЗП     0(М17)                  ,поле контекста 0 := СМ
         ДЕЛ    '115'(М10)              ,СМ /= поле блока вызывающего 77
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М11)                  ,СМ += смещение в буфере 0
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         УМН    '114'(М10)              ,СМ *= поле блока вызывающего 76
         РЖА    '7'                     ,РЖ := 7 (исключение, нормализация)
         ПО     L101B                   ,если СМ=0 → L101B
         СЛ     0(М17)                  ,СМ += поле контекста 0
         ЦИКЛ   L101A(М11)              ,М11-- и если ≠0 → повтор
L101B    СЧ     0(М17)                  ,СМ := поле контекста 0
         СЛПА   64+32                   ,порядок += 64+32
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     3(М10)                  ,СМ += поле блока вызывающего 3
         И      8(М10)                  ,СМ &= поле блока вызывающего 8
         ЗП     8(М12)                  ,параметр вызова ОС 8 := СМ
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

