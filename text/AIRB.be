***************************************************
* AIRB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5824 образа SIPROD.BIN
*   Длина при загрузке: 75 слов, 150 команд
*   Вход: AIRB
*   Выход: L9 (возврат через ячейка 0), L9A (возврат через ячейка 0), 
*   L0172 (возврат через М15), L12D (возврат через ячейка 0)
*   Внешние: KONSTA
*   Абсолютные символы: N1 = -1, N16 = -16, N2 = -2, N47 = -47, N5 = -5
*   Смещения в кадре (М7): общие 0, 5-6, свои 16, 48, 64, 172
*   Регистры: М1 (индекс: база модуля), М2 (рабочий регистр), 
*   М3 (рабочий регистр), М4 (рабочий регистр), М5 (рабочий регистр), 
*   М6 (рабочий регистр), М7 (указатель кадра), М10 (блок вызывающего), 
*   М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), М13 (счётчик), 
*   М14 (смещение в буфере), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 KONSTA
*   002 N5
*   003 N47
*   004 N2
*   005 N1
*   006 N16
*
*** КОД МОДУЛЯ
*
AIRB     СТАРТ  0
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         УИМ    М16                     ,М16 := СМ; СМ := из магазина
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИ     М14                     ,М14 := СМ
         СЧ     0                       ,СМ := 0
         СЧМ    0(М13)                  ,магазин + СЧ: 0(М13)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         СЛИА   1(М13)                  ,М13 += 1
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L9       СЧМ    0(М14)                  ,магазин + СЧ: 0(М14)
         И      0(М11)                  ,СМ &= смещение в буфере 0
         СЛИА   1(М14)                  ,М14 += 1
         ЧЕД    0(М17)                  ,СМ := кол-во единиц в поле контекста 
         СЛИА   1(М11)                  ,М11 += 1
         ЦИКЛ   L9(М13)                 ,М13-- и если ≠0 → повтор
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         УИМ    М16                     ,М16 := СМ; СМ := из магазина
         УИ     М13                     ,М13 := СМ
         СЧ     0(М13)                  ,СМ := смещение в буфере 0
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         УИМ    М15                     ,М15 := СМ; СМ := из магазина
         СЛИА   1(М13)                  ,М13 += 1
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИ     М14                     ,М14 := СМ
         СЧ     0                       ,СМ := 0
L9A      СЧМ    0(М14)                  ,магазин + СЧ: 0(М14)
         И      0(М11)                  ,СМ &= смещение в буфере 0
         СЛИА   1(М14)                  ,М14 += 1
         ЗП     0(М15)                  ,смещение в магазине 0 := СМ
         СЛИА   1(М11)                  ,М11 += 1
         ЧЕД    0(М17)                  ,СМ := кол-во единиц в поле контекста 
         СЛИА   1(М15)                  ,М15 += 1
         ЦИКЛ   L9A(М13)                ,М13-- и если ≠0 → повтор
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М7                      ,в магазин; СМ := М7
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         ЗПМ    20(М12)                 ,ЗП + магазин: 20(М12)
         УИМ    М2                      ,М2 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИ     М13                     ,М13 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М13)                  ,СМ := смещение в буфере 0
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         УИМ    М14                     ,М14 := СМ; СМ := из магазина
         УИА    N5(М7)                  ,М7 := адрес N5
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUSH     СЧИМ   М6(М7)                  ,в магазин; СМ := М6
         ЦИКЛ   PUSH(М7)                ,М7-- и если ≠0 → повтор
         СЛИА   1(М13)                  ,М13 += 1
         УИА    48(М7)                  ,М7 := адрес 48
         УИА    0(М16)                  ,М16 := база модуля
         СЧМ    0(М11)                  ,магазин + СЧ: 0(М11)
         УИА    0(М5)                   ,М5 := база модуля
         СЛИА   1(М11)                  ,М11 += 1
         СЛИА   1(М17)                  ,М17 += 1
         СДА    64+32
         ПЕ     L0124                   ,если СМ≠0 → L0124
         ПБ     L12A                    ,переход на L12A
*
L0124    ПВ     INCA(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ADDR     УИА    N47(М6)                 ,М6 := адрес N47
         СЧ     0(М14)                  ,СМ := смещение в буфере 0
         СЛИА   1(М14)                  ,М14 += 1
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧМ    0                       ,магазин + СЧ: 0
         ЗП     '4004'(М17)             ,каталог задачи: элемент 4 := СМ
INC      СЛИА   N1(М5)                  ,М5 += N1
         УИИ    М4(М5)                  ,М4 := М5
         СЛИ    М4(М3)                  ,М4 += М3
         ПИО    GET(М4)                 ,если ИР=0 → GET(М4)
LOOP     ЦИКЛ   INC(М6)                 ,М6-- и если ≠0 → повтор
         ПБ     GETA                    ,переход на GETA
*
GET      СЧ     0(М10)                  ,СМ := поле блока вызывающего 0
         ПВ     INCA(М15)               ,вызов через М15
         СДА    64(М6)
         И      '4005'(М17)             ,СМ &= каталог задачи: элемент 5
         ПО     LOOP                    ,если СМ=0 → LOOP
         ИЛИ    '4004'(М17)             ,СМ |= каталог задачи: элемент 4
         ЗП     '4004'(М17)             ,каталог задачи: элемент 4 := СМ
         СЛИА   1(М16)                  ,М16 += 1
         ПБ     LOOP                    ,переход на LOOP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
GETA     СЧ     '4004'(М17)             ,СМ := каталог задачи: элемент 4
         СЛИА   1(М1)                   ,М1 += 1
         ЗП     '4005'(М1)              ,каталог задачи: элемент 5 := СМ
         СЛИА   N1(М17)                 ,М17 += N1
         ЦИКЛ   ADDR(М13)               ,М13-- и если ≠0 → повтор
         ПБ     L12C                    ,переход на L12C
*
INCA     СЛИА   N16(М7)                 ,М7 += N16
         СЧМ    0(М11)                  ,магазин + СЧ: 0(М11)
         СДА    64(М7)
         УИМ    М3                      ,М3 := СМ; СМ := из магазина
         ПИНО   L0172(М7)               ,если ИР≠0 → L0172(М7)
         СЛИА   1(М11)                  ,М11 += 1
         УИА    48(М7)                  ,М7 := адрес 48
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L0172    ПИО    L12(М3)                 ,если ИР=0 → L12(М3)
         ПБ     0(М15)                  ,переход через М15
*
L12      СЧ     '4004'(М17)             ,СМ := каталог задачи: элемент 4
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L12A     ЗП     0(М1)                   ,смещение в базе 0 := СМ
         СЛИА   N1(М17)                 ,М17 += N1
         ПИО    L12C(М13)               ,если ИР=0 → L12C(М13)
         СЧ     0                       ,СМ := 0
L12B     СЛИА   1(М1)                   ,М1 += 1
         ЗП     0(М1)                   ,смещение в базе 0 := СМ
         ЦИКЛ   L12B(М13)               ,М13-- и если ≠0 → повтор
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L12C     СЧИ    М16                     ,СМ := М16
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ЗП     0(М2)                   ,смещение 0 := СМ
         СЛИА   N1(М17)                 ,М17 += N1
         СЧ     0(М17)                  ,СМ := поле контекста 0
         УИА    6(М15)                  ,М15 := адрес 6
L12D     УИМ    (М15)                   ,М15 := СМ; СМ := из магазина
         СЛИА   N1(М15)                 ,М15 += N1
         ПИНО   L12D(М15)               ,если ИР≠0 → L12D(М15)
         МОД    12(М12)                 ,мод.адрес := код из 12(М12)
         УИА    0(М7)                   ,М7 := код из 12+М12
         МОД    20(М12)                 ,мод.адрес := код из 20(М12)
         УИА    0(М1)                   ,М1 := код из 20+М12
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*

