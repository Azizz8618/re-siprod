         СЛИА   1(М13)                  ,М13 += 1
         УИА    48(М7)                  ,М7 := 48
         УИА    0(М16)                  ,М16 := 0
         СЧМ    0(М11)                  ,магазин + СЧ: 0(М11)
         УИА    0(М5)                   ,М5 := 0
         СЛИА   1(М11)                  ,М11 += 1
         СЛИА   1(М17)                  ,М17 += 1
         СДА    64+32                   ,сдвиг СМ вправо на 32
         ПЕ     L9C                     ,если СМ≠0 → L9C
         ПБ     POPB                    ,переход на POPB
         ПВ     KONSTB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         УИА    СИМ3(М6)                ,М6 := СИМ3
         СЧ     0(М14)                  ,СМ := 0(М14)
         СЛИА   1(М14)                  ,М14 += 1
         МОДА   0                       ,мод.адрес +1: 0
         СЧМ    0                       ,магазин + СЧ: 0
         ЗП     '4004'(М17)             ,'4004' := СМ
         СЛИА   СИМ5(М5)                ,М5 += СИМ5
         УИИ    М4(М5)                  ,М4 := М5
         СЛИ    М4(М3)                  ,М4 += М3
         ПИО    L9G(М4)                 ,если ИР=0 → L9G(М4)
         ЦИКЛ   L9E(М6)                 ,М6-- и если ≠0 → повтор
         ПБ     PUSH                    ,переход на PUSH
         СЧ     0(М10)                  ,СМ := 0(М10)
         ПВ     KONSTB(М15)             ,вызов через М15
         СДА    64(М6)                  ,сдвиг СМ на 64(М6)
         И      '4005'(М17)             ,СМ &= '4005'(М17)
         ПО     L9F                     ,если СМ=0 → L9F
         ИЛИ    '4004'(М17)             ,СМ |= '4004'(М17)
         ЗП     '4004'(М17)             ,'4004' := СМ
         СЛИА   1(М16)                  ,М16 += 1
         ПБ     L9F                     ,переход на L9F
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     '4004'(М17)             ,СМ := '4004'(М17)
         СЛИА   1(М1)                   ,М1 += 1
         ЗП     '4005'(М1)              ,'4005' := СМ
         СЛИА   СИМ5(М17)               ,М17 += СИМ5
         ЦИКЛ   L9D(М13)                ,М13-- и если ≠0 → повтор
         ПБ     SUB                     ,переход на SUB
         СЛИА   СИМ6(М7)                ,М7 += СИМ6
         СЧМ    0(М11)                  ,магазин + СЧ: 0(М11)
         СДА    64(М7)                  ,сдвиг СМ на 64(М7)
         УИМ    М3                      ,М3 := СМ + стек
         ПИНО   POP(М7)                 ,если ИР≠0 → POP(М7)
         СЛИА   1(М11)                  ,М11 += 1
         УИА    48(М7)                  ,М7 := 48
         МОДА   0                       ,мод.адрес +1: 0
         ПИО    POPA(М3)                ,если ИР=0 → POPA(М3)
         ПБ     0(М15)                  ,переход через М15
         СЧ     '4004'(М17)             ,СМ := '4004'(М17)
         МОДА   0                       ,мод.адрес +1: 0
         ЗП     0(М1)                   ,0 := СМ
         СЛИА   СИМ5(М17)               ,М17 += СИМ5
         ПИО    SUB(М13)                ,если ИР=0 → SUB(М13)
         СЧ     0                       ,СМ := 0
         СЛИА   1(М1)                   ,М1 += 1
         ЗП     0(М1)                   ,0 := СМ
         ЦИКЛ   WAIT(М13)               ,М13-- и если ≠0 → повтор
         МОДА   0                       ,мод.адрес +1: 0
         СЧИ    М16                     ,СМ := М16
         ИЛИ    3(М10)                  ,СМ |= 3(М10)
         ЗП     0(М2)                   ,0 := СМ
         СЛИА   СИМ5(М17)               ,М17 += СИМ5
         СЧ     0(М17)                  ,СМ := 0(М17)
         УИА    6(М15)                  ,М15 := 6
         УИМ    (М15)                   ,М15 := СМ + стек
         СЛИА   СИМ5(М15)               ,М15 += СИМ5
         ПИНО   ADDR(М15)               ,если ИР≠0 → ADDR(М15)
         МОД    12(М12)                 ,мод.адрес по коду: 12(М12)
         УИА    0(М7)                   ,М7 := 0
