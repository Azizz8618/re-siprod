***************************************************
* AIRB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5824 образа SIPROD.BIN
*   Длина при загрузке: 75 слов, 150 команд
*   Вход: AIRB
*   Внешние: KONSTA
*   Регистры: М1, М2, М3, М4, М5, М6, М7, М10, М11, М12, М13, М14, М15, 
*   М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 KONSTA
*   002 СИМ2
*   003 СИМ3
*   005 СИМ5
*   006 СИМ6
*
AIRB     СТАРТ  0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         УИМ    М16                     ,М16 := СМ + стек
         УИМ    М13                     ,М13 := СМ + стек
         УИМ    М11                     ,М11 := СМ + стек
         УИ     М14                     ,М14 := СМ
L9       СЧ     0                       ,СМ := 0
         СЧМ    0(М13)                  ,магазин + СЧ: 0(М13)
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ + стек
         СЛИА   1(М13)                  ,М13 += 1
         МОДА   0                       ,мод.адрес +1: 0
         СЧМ    0(М14)                  ,магазин + СЧ: 0(М14)
         И      0(М11)                  ,СМ &= 0(М11)
         СЛИА   1(М14)                  ,М14 += 1
         ЧЕД    0(М17)                  ,СМ := кол-во единиц в 0(М17)
         СЛИА   1(М11)                  ,М11 += 1
         ЦИКЛ   L9(М13)                 ,М13-- и если ≠0 → повтор
L9A      ИЛИ    3(М10)                  ,СМ |= 3(М10)
         ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := '6'
         МОД    9(М12)                  ,мод.адрес по коду: 9(М12)
         ПБ     0                       ,переход на 0
         МОДА   0                       ,мод.адрес +1: 0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         УИМ    М16                     ,М16 := СМ + стек
         УИ     М13                     ,М13 := СМ
         СЧ     0(М13)                  ,СМ := 0(М13)
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ + стек
         УИМ    М15                     ,М15 := СМ + стек
L9B      СЛИА   1(М13)                  ,М13 += 1
         УИМ    М11                     ,М11 := СМ + стек
         УИ     М14                     ,М14 := СМ
         СЧ     0                       ,СМ := 0
         СЧМ    0(М14)                  ,магазин + СЧ: 0(М14)
         И      0(М11)                  ,СМ &= 0(М11)
L9C      СЛИА   1(М14)                  ,М14 += 1
L9D      ЗП     0(М15)                  ,0 := СМ
         СЛИА   1(М11)                  ,М11 += 1
         ЧЕД    0(М17)                  ,СМ := кол-во единиц в 0(М17)
L9E      СЛИА   1(М15)                  ,М15 += 1
         ЦИКЛ   L9A(М13)                ,М13-- и если ≠0 → повтор
L9F      ИЛИ    3(М10)                  ,СМ |= 3(М10)
L9G      ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := '6'
         МОД    9(М12)                  ,мод.адрес по коду: 9(М12)
         ПБ     0                       ,переход на 0
         МОДА   0                       ,мод.адрес +1: 0
PUSH     СЧИМ   М1                      ,стек := М1, СМ := М1
         СЧИМ   М7                      ,стек := М7, СМ := М7
         СЧИМ   М15                     ,стек := М15, СМ := М15
KONSTB   ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         ЗПМ    20(М12)                 ,ЗП + магазин: 20(М12)
POP      УИМ    М2                      ,М2 := СМ + стек
POPA     УИМ    М1                      ,М1 := СМ + стек
POPB     УИМ    М11                     ,М11 := СМ + стек
         УИ     М13                     ,М13 := СМ
WAIT     РЖА    '3'                     ,РЖ := '3'
         СЧ     0(М13)                  ,СМ := 0(М13)
SUB      ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ + стек
         УИМ    М14                     ,М14 := СМ + стек
ADDR     УИА    СИМ2(М7)                ,М7 := СИМ2
         МОДА   0                       ,мод.адрес +1: 0
         СЧИМ   М6(М7)                  ,стек := М6, СМ := М6
