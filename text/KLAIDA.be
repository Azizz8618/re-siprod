***************************************************
* KLAIDA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 15104 образа SIPROD.BIN
*   Длина при загрузке: 48 слов, 60 команд
*   Вход: KLAIDA
*   Внешние: INS, FT571, FT002, FT003, STOP
*   Смещения в INS: 24, 25, 26
*   Регистры: М1, М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 FT571
*   006 FT002
*   007 FT003
*   008 STOP
*   009 INS32767
*
KLAIDA   СТАРТ  0
         УИА    FT571A(М16)             ,М16 := FT571A
FT571A   ПБ     L0056                   ,переход на L0056
         УИА    L0036(М16)              ,М16 := L0036
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     FT571(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         МОД    V2                      ,мод.адрес по коду: V2
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     FT002(М15)              ,вызов через М15
         МОД    V2                      ,мод.адрес по коду: V2
         СЧ     0                       ,СМ := 0
FT003A   РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПВ     FT003(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         УИА    FT003B(М16)             ,М16 := FT003B
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     FT571(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М7)                   ,СМ := 0(М7)
L0056    ЗП     2(М7)                   ,2 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОД    L0056A                  ,мод.адрес по коду: L0056A
         УИА    0(М1)                   ,М1 := 0
         МОДА   INS32767(М1)            ,мод.адрес +1: INS32767(М1)
FT002A   УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     FT002(М15)              ,вызов через М15
L0036    СЧ     2(М7)                   ,СМ := 2(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     0(М7)                   ,СМ += 0(М7)
         ЗП     2(М7)                   ,2 := СМ
         ВЧОБ   1(М7)                   ,СМ := (адрес) - СМ
FT003B   РЖА    '22'                    ,РЖ := '22'
         ПО     FT003A                  ,если СМ=0 → FT003A
         ПВ     FT003(М15)              ,вызов через М15
         ПВ     STOP(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     FT002A                  ,переход на FT002A
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
L0054    УИА    L0054(М7)               ,М7 := L0054
         ЗПМ    3(М7)                   ,ЗП + магазин: 3(М7)
L0056A   СЧИМ   М15                     ,стек := М15, СМ := М15
V2       СЧИМ   М1                      ,стек := М1, СМ := М1
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М1                      ,М1 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10
         МОДА   0                       ,мод.адрес +1: 0

