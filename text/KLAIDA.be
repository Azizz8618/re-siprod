***************************************************
* KLAIDA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 15104 образа SIPROD.BIN
*   Длина при загрузке: 48 слов, 60 команд
*   Вход: KLAIDA
*   Внешние: *INS*, FT*571, FT*002, FT*003, STOP*
*   Смещения в *INS*: 24, 25, 26
*   Регистры: М1, М7, М10, М12, М15, М16
***************************************************
KLAIDA  СТАРТ  0
        УИА    FT571(М16)               ,М16 := FT571
FT571   ПБ     L0056                    ,переход на L0056
        УИА    L0036(М16)               ,М16 := L0036
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     FT*571(М15)              ,вызов через М15
        МОДА   KLAIDA                   ,мод.адрес +1: KLAIDA
        МОД    V2                       ,мод.адрес по коду: V2
        УИА    KLAIDA(М16)              ,М16 := KLAIDA
FT002   СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     FT*002(М15)              ,вызов через М15
L0057   МОД    V2                       ,мод.адрес по коду: V2
        СЧ     KLAIDA                   ,СМ := KLAIDA
FT003   РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПВ     FT*003(М15)              ,вызов через М15
        МОДА   KLAIDA                   ,мод.адрес +1: KLAIDA
        УИА    FT0032(М16)              ,М16 := FT0032
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     FT*571(М15)              ,вызов через М15
        МОДА   KLAIDA                   ,мод.адрес +1: KLAIDA
        СЧ     KLAIDA(М7)               ,СМ := KLAIDA(М7)
L0056   ЗП     2(М7)                    ,2 := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОД    L00562                   ,мод.адрес по коду: L00562
        УИА    KLAIDA(М1)               ,М1 := KLAIDA
        МОДА   *INS*+77777(М1)          ,мод.адрес +1: *INS*+77777(
FT0022  УИА    KLAIDA(М16)              ,М16 := KLAIDA
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     FT*002(М15)              ,вызов через М15
L0036   СЧ     2(М7)                    ,СМ := 2(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     KLAIDA(М7)               ,СМ += KLAIDA(М7)
        ЗП     2(М7)                    ,2 := СМ
        ВЧОБ   1(М7)                    ,СМ := (адрес) - СМ
FT0032  РЖА    '22'                     ,РЖ := '22'
        ПО     FT003                    ,если СМ=0 → FT003
        ПВ     FT*003(М15)              ,вызов через М15
        ПВ     STOP*(М15)               ,вызов через М15
        МОДА   KLAIDA                   ,мод.адрес +1: KLAIDA
        ПБ     FT0022                   ,переход на FT0022
        МОДА   KLAIDA                   ,мод.адрес +1: KLAIDA
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
L0054   УИА    L0054(М7)                ,М7 := L0054
        ЗПМ    3(М7)                    ,ЗП + магазин: 3(М7)
L00562  СЧИМ   М15                      ,стек := М15, СМ := М15
V2      СЧИМ   М1                       ,стек := М1, СМ := М1
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     KLAIDA(М12)              ,переход через М12
        МОДА   KLAIDA                   ,мод.адрес +1: KLAIDA
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М1                       ,М1 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     KLAIDA(М10)              ,переход через М10
        МОДА   KLAIDA                   ,мод.адрес +1: KLAIDA

