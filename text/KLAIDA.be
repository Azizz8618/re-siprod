***************************************************
* KLAIDA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 15104 образа SIPROD.BIN
*   Длина при загрузке: 48 слов, 60 команд
*   Вход: KLAIDA
*   Выход: BEGPUS:FORA, BEGSTR:NDAB1A, CHAPAG:SCANEA, CHAPAG:SCANEB, 
*   ENDKOR:EGO86B, ENDPG:SEK3C, HEADIN:HEDB, PAPRAP:F15, RASTXT:TXT2A, 
*   READMK:F2B, READNB:F1B, SCAN:F9A, SCHEMA:SCANEB, SEGTAB:STR327, 
*   SEKLYG:SEK3A, SPAUD:SCANEQ, SPAUD:SCANES, SPAUD:SCANET, SPAUD:SCANEU, 
*   SPAUD:F1B, SPAUD:SEGTAA, SPAUD:SCANE1, SPAUD:SCAN00, SPAUD:SCAN01, 
*   SPAUD:SCAN02, SPAUD:REGIMH, SPAUD:TITLEJ, SPAUD:REGIMI, SPAUD:SCAN18, 
*   SPAUD:SCAN19, SPAUD:NUST1A, SPAUD:REGIMM, SPAUD:SCAN23, SPAUD:SCAN24, 
*   SPAUD:STR24C, SPAUD:REGIMV, SPAUD:L5544, TOKREZ:F6A, WRIIPO:F11B, 
*   WRILIN:F7C, WRIMAK:F1D, F2 (возврат через М12), 
*   F2A (возврат через М10)
*   ВЫВОД СООБЩЕНИЯ ОБ ОШИБКЕ: 'ERROR NR. N' И ОБРАЗ
*   ПЕРФОКАРТЫ, ПОСЛЕ ЧЕГО ЗАДАЧА ОСТАНАВЛИВАЕТСЯ.
*   Внешние: INS, FT571, FT002, FT003, STOP
*   Смещения в INS: 24, 25, 26
*   Смещения в кадре (М7): общие 0-3, 10, свои 14
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 FT571
*   006 FT002
*   007 FT003
*   008 STOP
*   009 INS32767
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     36
*   К5     43
*   К14    54
*   V0     56
*   V1     57
*
*** КОД МОДУЛЯ
*
* ВЫВОД 'ERROR NR. N' И ОБРАЗА ПЕРФОКАРТЫ.
KLAIDA   СТАРТ  0
         УИА    ADDR(М16)               ,М16 := адрес ADDR
         ПБ     F2                      ,переход на F2
*
ADDR     УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     FT571(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         МОД    V1                      ,мод.адрес := код из V1
         УИА    0(М16)                  ,М16 := код из V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     FT002(М15)              ,вызов через М15
         МОД    V1                      ,мод.адрес := код из V1
         СЧ     0                       ,СМ := слово по адресу V1
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     FT003(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         УИА    К5(М16)                 ,М16 := адрес К5
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     FT571(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     2(М7)                   ,слот кадра 2 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
INS327   МОД    V0                      ,мод.адрес := код из V0
         УИА    0(М1)                   ,М1 := код из V0
         МОДА   INS32767(М1)            ,мод.адрес := INS32767(М1)
         УИА    0(М16)                  ,М16 := адрес INS32767+М1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     FT002(М15)              ,вызов через М15
         СЧ     2(М7)                   ,СМ := слот кадра 2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     2(М7)                   ,слот кадра 2 := СМ
         ВЧОБ   1(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     INS327                  ,если СМ=0 → INS327
         ПВ     FT003(М15)              ,вызов через М15
         ПВ     STOP(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     F2A                     ,переход на F2A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К14(М7)                 ,М7 := адрес К14
         ЗПМ    3(М7)                   ,ЗП + магазин: 3(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2A      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

