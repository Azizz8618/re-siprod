***************************************************
* KLAIDA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 15104 образа SIPROD.BIN
*   Длина при загрузке: 48 слов, 60 команд
*   Вход: KLAIDA
*   Выход: BEGPUS:FORB, BEGSTR:FORMA1, CHAPAG:SCANEA, CHAPAG:NUST5C+1, 
*   ENDKOR:KORT32, ENDPG:SEK3E, HEADIN:INS26B+1, PAPRAP:PUSH+1, 
*   RASTXT:TXT2A, READMK:MKR50P+1, READNB:NUM2H+1, SCAN:V9, SCHEMA:SCANEG, 
*   SEGTAB:V26A+1, SEKLYG:LYG4F+1, SPAUD:SCANE5, SPAUD:SCANE7, 
*   SPAUD:SCANE9, SPAUD:SCAN01, SPAUD:V1H, SPAUD:SEGTAA, SPAUD:V15A, 
*   SPAUD:SCAN39, SPAUD:SCAN41, SPAUD:SCAN41, SPAUD:REGIMH, SPAUD:V12A, 
*   SPAUD:REGIMK, SPAUD:SCAN79, SPAUD:SCAN86, SPAUD:SCAN90+1, 
*   SPAUD:SCAN90+1, SPAUD:SCAN90+1, SPAUD:SCAN90+1, SPAUD:SCAN90+1, 
*   SPAUD:SCAN90+1, SPAUD:SCAN90+1, TOKREZ:SCANEP+1, WRIIPO:V11C+1, 
*   WRILIN:V7N+1, WRIMAK:V1H+1, V2D (возврат через М12), 
*   V2D (возврат через М10)
*   ВЫВОД СООБЩЕНИЯ ОБ ОШИБКЕ: 'ERROR NR. N' И ОБРАЗ
*   ПЕРФОКАРТЫ, ПОСЛЕ ЧЕГО ЗАДАЧА ОСТАНАВЛИВАЕТСЯ.
*   Внешние: INS, FT571, FT002, FT003, STOP
*   Смещения в INS: 24, 25, 26
*   Регистры: М1, М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 FT571
*   006 FT002
*   007 FT003
*   008 STOP
*   009 INS32767
*
* ВЫВОД 'ERROR NR. N' И ОБРАЗА ПЕРФОКАРТЫ.
KLAIDA   СТАРТ  0
* ВЫВОД 'ERROR NR. N' И ОБРАЗА ПЕРФОКАРТЫ.
         УИА    JMP(М16)                ,М16 := JMP
JMP      ПБ     INS327                  ,переход на INS327
         УИА    V2(М16)                 ,М16 := V2
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     FT571(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         МОД    V2D                     ,мод.адрес по коду: V2D
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     FT002(М15)              ,вызов через М15
         МОД    V2D                     ,мод.адрес по коду: V2D
         СЧ     0                       ,СМ := 0
WAIT     РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПВ     FT003(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         УИА    V2A(М16)                ,М16 := V2A
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     FT571(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М7)                   ,СМ := 0(М7)
INS327   ЗП     2(М7)                   ,2 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОД    V2C                     ,мод.адрес по коду: V2C
         УИА    0(М1)                   ,М1 := 0
         МОДА   INS32767(М1)            ,мод.адрес +1: INS32767(М1)
INS32A   УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     FT002(М15)              ,вызов через М15
V2       СЧ     2(М7)                   ,СМ := 2(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     0(М7)                   ,СМ += 0(М7)
         ЗП     2(М7)                   ,2 := СМ
         ВЧОБ   1(М7)                   ,СМ := (адрес) - СМ
V2A      РЖА    '22'                    ,РЖ := '22'
         ПО     WAIT                    ,если СМ=0 → WAIT
         ПВ     FT003(М15)              ,вызов через М15
         ПВ     STOP(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     INS32A                  ,переход на INS32A
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
V2B      УИА    V2B(М7)                 ,М7 := V2B
         ЗПМ    3(М7)                   ,ЗП + магазин: 3(М7)
V2C      СЧИМ   М15                     ,стек := М15, СМ := М15
V2D      СЧИМ   М1                      ,стек := М1, СМ := М1
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М1                      ,М1 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10
         МОДА   0                       ,мод.адрес +1: 0

