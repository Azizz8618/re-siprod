***************************************************
* ENDTUR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 20256 образа SIPROD.BIN
*   Длина при загрузке: 77 слов, 128 команд
*   Вход: ENDTUR
*   Внешние: *EGO*, *FOR*, *JAU*, FT*571, FT*002, FT*003, I*DI*I, I*MU*I
*   Смещения в *EGO*: 8601
*   Смещения в *FOR*: 1
*   Смещения в *JAU*: 1
*   Регистры: М1, М7, М10, М12, М15, М16, М17
***************************************************
ENDTUR  СТАРТ  0
        УИА    FOR(М16)                 ,М16 := FOR
FOR     ПБ     IMUI3                    ,переход на IMUI3
        МОДА   *FOR*                    ,мод.адрес +1: *FOR*
        СЧ     ENDTUR                   ,СМ := ENDTUR
        ЗП     5(М7)                    ,5 := СМ
        РЖА    '3'                      ,РЖ := '3'
        СЧ     ENDTUR(М7)               ,СМ := ENDTUR(М7)
L0007   СЧИМ                            ,СЧИ + магазин
JAU1    МОДА   *JAU*+1                  ,мод.адрес +1: *JAU*+1
        СЧ     ENDTUR                   ,СМ := ENDTUR
FOR2    РЖА    '22'                     ,РЖ := '22'
        НТЖ    ENDTUR(М17)              ,СМ ^= ENDTUR(М17)
        ПЕ     L0007                    ,если СМ≠0 → L0007
        ПБ     JAU1                     ,переход на JAU1
        ПБ     IMUI                     ,переход на IMUI
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        МОДА   *FOR*                    ,мод.адрес +1: *FOR*
IDII    СЧ     ENDTUR                   ,СМ := ENDTUR
        УИА    L0102(М16)               ,М16 := L0102
        ПВ     I*DI*I(М15)              ,вызов через М15
IMUI    ЗП     5(М7)                    ,5 := СМ
        РЖА    '3'                      ,РЖ := '3'
        УИА    L0102(М16)               ,М16 := L0102
        ПВ     I*MU*I(М15)              ,вызов через М15
        ЗП     6(М7)                    ,6 := СМ
        МОДА   *FOR*                    ,мод.адрес +1: *FOR*
        СЧ     ENDTUR                   ,СМ := ENDTUR
L0033   СЧИМ                            ,СЧИ + магазин
        СЧ     6(М7)                    ,СМ := 6(М7)
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    ENDTUR(М17)              ,СМ ^= ENDTUR(М17)
        ПЕ     IDII                     ,если СМ≠0 → IDII
        ПБ     IMUI                     ,переход на IMUI
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        СЧ     5(М7)                    ,СМ := 5(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     ENDTUR(М7)               ,СМ += ENDTUR(М7)
        ЗП     5(М7)                    ,5 := СМ
        РЖА    '22'                     ,РЖ := '22'
СИМ14   МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        МОДА   СИМ14                    ,мод.адрес +1: СИМ14
        СЧ     ENDTUR                   ,СМ := ENDTUR
        РЖА    '3'                      ,РЖ := '3'
        МОДА   СИМ15                    ,мод.адрес +1: СИМ15
        СЛ     ENDTUR                   ,СМ += ENDTUR
IMUI2   МОДА   СИМ16                    ,мод.адрес +1: СИМ16
        СЛ     ENDTUR                   ,СМ += ENDTUR
        УИА    L0103(М16)               ,М16 := L0103
        ПВ     I*MU*I(М15)              ,вызов через М15
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        ЗП     7(М7)                    ,7 := СМ
        СЧ     ENDTUR(М7)               ,СМ := ENDTUR(М7)
        ЗП     8(М7)                    ,8 := СМ
        РЖА    '22'                     ,РЖ := '22'
L0066   СЧ     8(М7)                    ,СМ := 8(М7)
L0067   РЖА    '3'                      ,РЖ := '3'
IMUI3   ВЧ     ENDTUR(М7)               ,СМ -= ENDTUR(М7)
        ЗП     4(М7)                    ,4 := СМ
        СЧ     3(М7)                    ,СМ := 3(М7)
        УИА    FT571(М16)               ,М16 := FT571
        ПВ     I*MU*I(М15)              ,вызов через М15
V3      МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        СЛ     ENDTUR(М7)               ,СМ += ENDTUR(М7)
        ЗП     9(М7)                    ,9 := СМ
L0100   СЛ     L0007(М7)                ,СМ += L0007(М7)
L0101   ВЧ     ENDTUR(М7)               ,СМ -= ENDTUR(М7)
L0102   ЗП     10(М7)                   ,10 := СМ
L0103   УИА    L0100(М16)               ,М16 := L0100
        СЧИМ   М16                      ,стек := М16, СМ := М16
FT571   РЖА    '22'                     ,РЖ := '22'
        ПВ     FT*571(М15)              ,вызов через М15
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        СЧ     9(М7)                    ,СМ := 9(М7)
        ЗП     11(М7)                   ,11 := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
FT002   ПБ     IMUI2                    ,переход на IMUI2
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        МОД    FT002                    ,мод.адрес по коду: FT002
        УИА    ENDTUR(М1)               ,М1 := ENDTUR
        МОДА   СИМ17(М1)                ,мод.адрес +1: СИМ17(М1)
        УИА    ENDTUR(М16)              ,М16 := ENDTUR
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     FT*002(М15)              ,вызов через М15
        СЧ     11(М7)                   ,СМ := 11(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     ENDTUR(М7)               ,СМ += ENDTUR(М7)
        ЗП     11(М7)                   ,11 := СМ
        РЖА    '22'                     ,РЖ := '22'
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        ВЧОБ   10(М7)                   ,СМ := (адрес) - СМ
        ПО     СИМ14                    ,если СМ=0 → СИМ14
        ПВ     FT*003(М15)              ,вызов через М15
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        СЧ     8(М7)                    ,СМ := 8(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     ENDTUR(М7)               ,СМ += ENDTUR(М7)
        ЗП     8(М7)                    ,8 := СМ
