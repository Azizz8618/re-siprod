***************************************************
* ENDTUR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 20256 образа SIPROD.BIN
*   Длина при загрузке: 77 слов, 128 команд
*   Вход: ENDTUR
*   Выход: F5B (возврат через М12), POP (возврат через М10)
*   Внешние: EGO, FOR, JAU, FT571, FT002, FT003, IDII, IMUI
*   Смещения в EGO: 8601
*   Смещения в FOR: 1
*   Смещения в JAU: 1
*   Смещения в кадре (М7): общие 0-1, 3-10, свои 11
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес), 
*   М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 EGO
*   002 EGO8601
*   003 FOR
*   004 FOR1
*   005 JAU
*   006 JAU1
*   007 FT571
*   008 FT002
*   009 FT003
*   010 IDII
*   011 IMUI
*   012 FOR3
*   013 FOR4
*   014 FOR7
*   015 EGO41368
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     100    1203106220233051
*   К1     101    6400000000000001
*   К2     102    6400000000000002
*   К3     103    6400000000000026
*   V0     105
*   V7     114
*
*** КОД МОДУЛЯ
*
ENDTUR   СТАРТ  0
         УИА    FORA(М16)               ,М16 := адрес FORA
         ПБ     F5B                     ,переход на F5B
*
FORA     МОДА   FOR                     ,мод.адрес := FOR
         СЧ     0                       ,СМ := слово по адресу FOR
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   JAU1                    ,мод.адрес := JAU1
         СЧ     0                       ,СМ := слово по адресу JAU1
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     FORB                    ,если СМ≠0 → FORB
         ПБ     FORC                    ,переход на FORC
*
FORB     ПБ     FOR3B                   ,переход на FOR3B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
FORC     МОДА   FOR                     ,мод.адрес := FOR
         СЧ     0                       ,СМ := слово по адресу FOR
         УИА    К2(М16)                 ,М16 := адрес К2
         ПВ     IDII(М15)               ,вызов через М15
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         УИА    К2(М16)                 ,М16 := адрес К2
         ПВ     IMUI(М15)               ,вызов через М15
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         МОДА   FOR                     ,мод.адрес := FOR
         СЧ     0                       ,СМ := слово по адресу FOR
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     6(М7)                   ,СМ := слот кадра 6
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     FOR3A                   ,если СМ≠0 → FOR3A
         ПБ     FOR3B                   ,переход на FOR3B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
FOR3A    СЧ     5(М7)                   ,СМ := слот кадра 5
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
FOR3B    МОДА   FOR3                    ,мод.адрес := FOR3
         СЧ     0                       ,СМ := слово по адресу FOR3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   FOR4                    ,мод.адрес := FOR4
         СЛ     0                       ,СМ += слово по адресу FOR4
         МОДА   FOR7                    ,мод.адрес := FOR7
         СЛ     0                       ,СМ += слово по адресу FOR7
         УИА    К3(М16)                 ,М16 := адрес К3
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F8       СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     0(М7)                   ,СМ -= слот кадра 0
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         СЧ     3(М7)                   ,СМ := слот кадра 3
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         СЛ     7(М7)                   ,СМ += слот кадра 7
         ВЧ     0(М7)                   ,СМ -= слот кадра 0
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     FT571(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     9(М7)                   ,СМ := слот кадра 9
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F11                     ,переход на F11
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO413   МОД    V7                      ,мод.адрес := код из V7
         УИА    0(М1)                   ,М1 := код из V7
         МОДА   EGO41368(М1)            ,мод.адрес := EGO41368(М1)
         УИА    0(М16)                  ,М16 := адрес EGO41368+М1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     FT002(М15)              ,вызов через М15
         СЧ     11(М7)                  ,СМ := слот кадра 11
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F11      ВЧОБ   10(М7)                  ,СМ := (адрес) - СМ
         ПО     EGO413                  ,если СМ=0 → EGO413
         ПВ     FT003(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         СЧ     5(М7)                   ,СМ := слот кадра 5
         ВЧ     0(М7)                   ,СМ -= слот кадра 0
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     5(М7)                   ,СМ := слот кадра 5
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F5                      ,если СМ=0 → F5
         ПБ     F5A                     ,переход на F5A
*
F5       ПБ     F8                      ,переход на F8
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F5A      ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F5B      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

