        ЗП     5(М7)                    ,5 := СМ
        СЧ     ENDTUR(М7)               ,СМ := ENDTUR(М7)
        СЧИМ                            ,СЧИ + магазин
        СЧ     5(М7)                    ,СМ := 5(М7)
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    ENDTUR(М17)              ,СМ ^= ENDTUR(М17)
        ПО     L0066                    ,если СМ=0 → L0066
        ПБ     L0067                    ,переход на L0067
        ПБ     L0033                    ,переход на L0033
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        ПБ     V3                       ,переход на V3
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0101(М7)                ,М7 := L0101
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М1                       ,стек := М1, СМ := М1
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     ENDTUR(М12)              ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М1                       ,М1 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     ENDTUR(М10)              ,переход через М10
        МОДА   ENDTUR                   ,мод.адрес +1: ENDTUR

