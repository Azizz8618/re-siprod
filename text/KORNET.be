***************************************************
* KORNET - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 10592 образа SIPROD.BIN
*   Длина при загрузке: 41 слов, 70 команд
*   Вход: KORNET
*   Выход: PAPRAP:EGO39A, PAPRAP:INS26A, PAPRAP:F32, PAPRAP:Б7ЗФA, 
*   PAPRAP:EGO86L, F5 (возврат через М12), F2 (возврат через М10)
*   Внешние: INS, SCANER, GETSTR, ZDЮCЖ
*   Смещения в INS: 24, 25, 26
*   Смещения в SCANER: 1, 2
*   Смещения в кадре (М7): общие 0-2, 4-5, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 SCANER
*   006 SCANER1
*   007 SCANER2
*   008 GETSTR
*   009 ZDЮCЖ
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     43    6400000000000001
*   V1     46
*   V2     47
*   V3     50
*
*** КОД МОДУЛЯ
*
KORNET   СТАРТ  0
         УИА    SCANEA(М16)             ,М16 := адрес SCANEA
         ПБ     F5                      ,переход на F5
*
SCANEA   МОД    V2                      ,мод.адрес := код из V2
         СЧ     0                       ,СМ := слово по адресу V2
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОД    V2                      ,мод.адрес := код из V2
         СЧ     0                       ,СМ := слово по адресу V2
         ЗП     2(М7)                   ,слот кадра 2 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     INS26C                  ,переход на INS26C
*
ZDЮCЖA   ПВ     ZDЮCЖ(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     INS26A                  ,если СМ≠0 → INS26A
         ПБ     INS26B                  ,переход на INS26B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
INS26A   ПБ     SCANEB                  ,переход на SCANEB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
INS26B   СЧ     2(М7)                   ,СМ := слот кадра 2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     2(М7)                   ,слот кадра 2 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
INS26C   МОДА   INS26                   ,мод.адрес := INS26
         ВЧОБ   0                       ,СМ := слово по адресу INS26 - СМ
         ПО     ZDЮCЖA                  ,если СМ=0 → ZDЮCЖA
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     GETSTR(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   INS25                   ,мод.адрес := INS25
         СЧ     0                       ,СМ := слово по адресу INS25
         МОД    V3                      ,мод.адрес := код из V3
         ЗП     0                       ,по адресу V3 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F2                      ,переход на F2
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEB   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     0(М7)                   ,СМ -= слот кадра 0
         МОД    V3                      ,мод.адрес := код из V3
         ЗП     0                       ,по адресу V3 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F2                      ,переход на F2
*
F5       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         ЗПМ    5(М7)                   ,ЗП + магазин: 5(М7)
         ЗПМ    4(М7)                   ,ЗП + магазин: 4(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2       УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

