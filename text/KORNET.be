***************************************************
* KORNET - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 10592 образа SIPROD.BIN
*   Длина при загрузке: 41 слов, 70 команд
*   Вход: KORNET
*   Выход: PAPRAP:INS26A, PAPRAP:PUSH+1, PAPRAP:PUSH+1, PAPRAP:PUSH+1, 
*   PAPRAP:PUSH+1, INS25C (возврат через М12), INS25C (возврат через М10)
*   Внешние: INS, SCANER, GETSTR, ZDЮCЖ
*   Смещения в INS: 24, 25, 26
*   Смещения в SCANER: 1, 2
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 SCANER
*   006 SCANER1
*   007 SCANER2
*   008 GETSTR
*   009 ZDЮCЖ
*
KORNET   СТАРТ  0
         УИА    SCANEA(М16)             ,М16 := SCANEA
SCANEA   ПБ     INS26B                  ,переход на INS26B
         МОД    INS25B                  ,мод.адрес по коду: INS25B
         СЧ     0                       ,СМ := 0
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         ЗП     0                       ,0 := СМ
SCANEB   РЖА    '3'                     ,РЖ := '3'
         МОД    INS25B                  ,мод.адрес по коду: INS25B
         СЧ     0                       ,СМ := 0
         ЗП     2(М7)                   ,2 := СМ
         РЖА    '22'                    ,РЖ := '22'
SCANEC   ПБ     SCANED                  ,переход на SCANED
ZDЮCЖA   ПВ     ZDЮCЖ(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
SCANED   СЧИМ                           ,СЧИ + магазин
         МОДА   SCANER1                 ,мод.адрес +1: SCANER1
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     SCANEC                  ,если СМ≠0 → SCANEC
         ПБ     ZDЮCЖA                  ,переход на ZDЮCЖA
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     INS26A                  ,переход на INS26A
INS26A   МОДА   0                       ,мод.адрес +1: 0
         СЧ     2(М7)                   ,СМ := 2(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     0(М7)                   ,СМ += 0(М7)
INS26B   ЗП     2(М7)                   ,2 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   INS26                   ,мод.адрес +1: INS26
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         ПО     SCANEB                  ,если СМ=0 → SCANEB
INS26C   УИА    INS25A(М16)             ,М16 := INS25A
         СЧИМ   М16                     ,стек := М16, СМ := М16
GETSTA   ПВ     GETSTR(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
INS25A   МОДА   INS25                   ,мод.адрес +1: INS25
INS25B   СЧ     0                       ,СМ := 0
INS25C   МОД    INS25C                  ,мод.адрес по коду: INS25C
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     INS26C                  ,переход на INS26C
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         ВЧ     0(М7)                   ,СМ -= 0(М7)
         МОД    INS25C                  ,мод.адрес по коду: INS25C
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     INS26C                  ,переход на INS26C
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    GETSTA(М7)              ,М7 := GETSTA
         ЗПМ    5(М7)                   ,ЗП + магазин: 5(М7)
         ЗПМ    4(М7)                   ,ЗП + магазин: 4(М7)
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

