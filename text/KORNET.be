***************************************************
* KORNET - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 10592 образа SIPROD.BIN
*   Длина при загрузке: 41 слов, 70 команд
*   Вход: KORNET
*   Внешние: INS, SCANER, GETSTR, ZDЮCЖ
*   Смещения в INS: 24, 25, 26
*   Смещения в SCANER: 1, 2
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 SCANER
*   006 SCANER1
*   007 SCANER2
*   008 GETSTR
*   009 ZDЮCЖ
*
KORNET   СТАРТ  0
         УИА    L0047(М16)              ,М16 := L0047
L0047    ПБ     INS26A                  ,переход на INS26A
         МОД    L0047B                  ,мод.адрес по коду: L0047B
         СЧ     0                       ,СМ := 0
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         ЗП     0                       ,0 := СМ
L0047A   РЖА    '3'                     ,РЖ := '3'
         МОД    L0047B                  ,мод.адрес по коду: L0047B
         СЧ     0                       ,СМ := 0
         ЗП     2(М7)                   ,2 := СМ
         РЖА    '22'                    ,РЖ := '22'
L0013    ПБ     SCANEA                  ,переход на SCANEA
ZDЮCЖA   ПВ     ZDЮCЖ(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
SCANEA   СЧИМ                           ,СЧИ + магазин
         МОДА   SCANER1                 ,мод.адрес +1: SCANER1
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     L0013                   ,если СМ≠0 → L0013
         ПБ     ZDЮCЖA                  ,переход на ZDЮCЖA
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     V1                      ,переход на V1
V1       МОДА   0                       ,мод.адрес +1: 0
         СЧ     2(М7)                   ,СМ := 2(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     0(М7)                   ,СМ += 0(М7)
INS26A   ЗП     2(М7)                   ,2 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   INS26                   ,мод.адрес +1: INS26
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         ПО     L0047A                  ,если СМ=0 → L0047A
L0041    УИА    INS25A(М16)             ,М16 := INS25A
         СЧИМ   М16                     ,стек := М16, СМ := М16
GETSTA   ПВ     GETSTR(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
INS25A   МОДА   INS25                   ,мод.адрес +1: INS25
L0047B   СЧ     0                       ,СМ := 0
L0050    МОД    L0050                   ,мод.адрес по коду: L0050
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     L0041                   ,переход на L0041
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         ВЧ     0(М7)                   ,СМ -= 0(М7)
         МОД    L0050                   ,мод.адрес по коду: L0050
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     L0041                   ,переход на L0041
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    GETSTA(М7)              ,М7 := GETSTA
         ЗПМ    5(М7)                   ,ЗП + магазин: 5(М7)
         ЗПМ    4(М7)                   ,ЗП + магазин: 4(М7)
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

