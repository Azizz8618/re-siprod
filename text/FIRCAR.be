         СЧ     0                       ,СМ := слово по адресу SCANER
         МОДА   INS26                   ,мод.адрес := INS26
         ВЧ     0                       ,СМ -= слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     SCANEQ                  ,если СМ≠0 → SCANEQ
         ПБ     SCANES                  ,переход на SCANES
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEQ   ПБ     WЗЛБ0A                  ,переход на WЗЛБ0A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANES   СЧ     10(М7)                  ,СМ := слот кадра 10
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F10                     ,переход на F10
*
L0456    УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К2(М7)                  ,М7 := адрес К2
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F10      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

