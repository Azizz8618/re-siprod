         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     NUST7A                  ,если СМ≠0 → NUST7A
         ПБ     NUST7B                  ,переход на NUST7B
*
NUST7A   МОДА   NUST7                   ,мод.адрес := NUST7
         СЧ     0                       ,СМ := слово по адресу NUST7
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         МОДА   NUST7                   ,мод.адрес := NUST7
         ЗП     0                       ,по адресу NUST7 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NUST7B   СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
NEWMAA   ПВ     NEWMAX(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     3(М7)                   ,СМ := слот кадра 3
