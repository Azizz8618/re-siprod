***************************************************
* NAMENF - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 8608 образа SIPROD.BIN
*   Длина при загрузке: 78 слов, 104 команд
*   Вход: NAMENF
*   Выход: APNOTF:F1C, F1A (возврат через М12), F1B (возврат через М10)
*   Внешние: INS, SCANER, PAGE, WHO, ENDKOR, GETSTR, WRIKOR, CSTRIN
*   Смещения в INS: 24, 25, 26
*   Смещения в PAGE: 1
*   Смещения в SCANER: 1, 2
*   Смещения в WHO: 1
*   Смещения в кадре (М7): общие 0-1, 4, 6-10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 SCANER
*   006 SCANER1
*   007 SCANER2
*   008 PAGE
*   009 WHO
*   010 WHO1
*   011 ENDKOR
*   012 GETSTR
*   013 WRIKOR
*   014 CSTRIN
*   015 PAGE1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     64
*   К1     65
*   К2     66
*   К3     67
*   К4     70
*   К6     72
*   V1     75
*   V2     76
*   V3     77
*   V4     100
*
*** КОД МОДУЛЯ
*
NAMENF   СТАРТ  0
         УИА    PAGE1A(М16)             ,М16 := адрес PAGE1A
         ПБ     F1A                     ,переход на F1A
*
PAGE1A   СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     4(М7)                   ,СМ := слот кадра 4
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         МОДА   PAGE1                   ,мод.адрес := PAGE1
         СЧ     0                       ,СМ := слово по адресу PAGE1
         ВЧ     6(М7)                   ,СМ -= слот кадра 6
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         СЧ     9(М7)                   ,СМ := слот кадра 9
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     6(М7)                   ,СМ += слот кадра 6
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F9                      ,если СМ=0 → F9
         ПБ     F9A                     ,переход на F9A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F9       ПБ     F9B                     ,переход на F9B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F9A      УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     CSTRIN(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F9B      УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     7(М7)                   ,СМ := слот кадра 7
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F7                      ,если СМ=0 → F7
         ПБ     F7A                     ,переход на F7A
*
F7       ПБ     F1                      ,переход на F1
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F7A      УИА    V4(М16)                 ,М16 := адрес V4
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     GETSTR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         МОДА   INS26                   ,мод.адрес := INS26
         СЧ     0                       ,СМ := слово по адресу INS26
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS25                   ,мод.адрес := INS25
         ВЧ     0                       ,СМ -= слово по адресу INS25
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К4(М16)                 ,М16 := адрес К4
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К6(М16)                 ,М16 := адрес К6
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     WRIKOR(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    INS(М16)                ,М16 := адрес INS
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    INS25(М16)              ,М16 := адрес INS25
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V3(М16)                 ,М16 := адрес V3
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ENDKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   PAGE1                   ,мод.адрес := PAGE1
         СЧ     0                       ,СМ := слово по адресу PAGE1
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F9A                     ,переход на F9A
*
F1       ПБ     F1B                     ,переход на F1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1A      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1B      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'1243105712452040'
К1       КОНД   В'6400000000000000'
К2       КОНД   В'6400000000000001'
К3       КОНД   В'6400000000000003'
К4       КОНД   В'6400000000000004'
К6       КОНД   В'6400000000000002'
V0       ПАМ    1
V1       ПАМ    1
