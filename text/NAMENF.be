***************************************************
* NAMENF - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 8608 образа SIPROD.BIN
*   Длина при загрузке: 78 слов, 104 команд
*   Вход: NAMENF
*   Выход: APNOTF:PAGE1G+1, WAIT (возврат через М12), 
*   WAIT (возврат через М10)
*   Внешние: INS, SCANER, PAGE, WHO, ENDKOR, GETSTR, WRIKOR, CSTRIN
*   Смещения в INS: 24, 25, 26
*   Смещения в PAGE: 1
*   Смещения в SCANER: 1, 2
*   Смещения в WHO: 1
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 SCANER
*   006 SCANER1
*   007 SCANER2
*   008 PAGE
*   009 WHO
*   010 WHO1
*   011 ENDKOR
*   012 GETSTR
*   013 WRIKOR
*   014 CSTRIN
*   015 PAGE1
*
NAMENF   СТАРТ  0
         УИА    PAGE1A(М16)             ,М16 := PAGE1A
PAGE1A   ПБ     V7A                     ,переход на V7A
         СЧ     0(М7)                   ,СМ := 0(М7)
         ЗП     7(М7)                   ,7 := СМ
         РЖА    '3'                     ,РЖ := '3'
         СЧ     4(М7)                   ,СМ := 4(М7)
         ЗП     8(М7)                   ,8 := СМ
         МОДА   PAGE1                   ,мод.адрес +1: PAGE1
         СЧ     0                       ,СМ := 0
PAGE1B   ВЧ     6(М7)                   ,СМ -= 6(М7)
PAGE1C   ЗП     9(М7)                   ,9 := СМ
         СЧ     9(М7)                   ,СМ := 9(М7)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     6(М7)                   ,СМ += 6(М7)
PAGE1D   РЖА    '22'                    ,РЖ := '22'
         ПО     PAGE1B                  ,если СМ=0 → PAGE1B
         ПБ     PAGE1C                  ,переход на PAGE1C
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     PAGE1D                  ,переход на PAGE1D
         МОДА   0                       ,мод.адрес +1: 0
         УИА    INS26H(М16)             ,М16 := INS26H
         СЧИМ   М16                     ,стек := М16, СМ := М16
V9       УИА    INS26I(М16)             ,М16 := INS26I
V9A      СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     CSTRIN(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         УИА    INS26B(М16)             ,М16 := INS26B
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    INS26D(М16)             ,М16 := INS26D
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    INS26E(М16)             ,М16 := INS26E
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         СЧ     7(М7)                   ,СМ := 7(М7)
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     V9                      ,если СМ=0 → V9
         ПБ     V9A                     ,переход на V9A
V7       ПБ     V7                      ,переход на V7
V7A      МОДА   0                       ,мод.адрес +1: 0
         УИА    WAIT(М16)               ,М16 := WAIT
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     GETSTR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
INS26A   МОДА   INS26                   ,мод.адрес +1: INS26
         СЧ     0                       ,СМ := 0
INS26B   РЖА    '3'                     ,РЖ := '3'
INS26C   МОДА   INS25                   ,мод.адрес +1: INS25
INS26D   ВЧ     0                       ,СМ -= 0
INS26E   ЗП     10(М7)                  ,10 := СМ
INS26F   УИА    INS26B(М16)             ,М16 := INS26B
         СЧИМ   М16                     ,стек := М16, СМ := М16
INS26G   УИА    INS26F(М16)             ,М16 := INS26F
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    INS26G(М16)             ,М16 := INS26G
INS26H   СЧИМ   М16                     ,стек := М16, СМ := М16
INS26I   РЖА    '22'                    ,РЖ := '22'
WRIKOA   ПВ     WRIKOR(М15)             ,вызов через М15
WAIT     РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         УИА    INS(М16)                ,М16 := INS
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    INS25(М16)              ,М16 := INS25
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WRIKOA(М16)             ,М16 := WRIKOA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПВ     ENDKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
         ЗП     8(М7)                   ,8 := СМ
         РЖА    '3'                     ,РЖ := '3'
         МОДА   PAGE1                   ,мод.адрес +1: PAGE1
         СЧ     0                       ,СМ := 0
         ЗП     9(М7)                   ,9 := СМ
         СЧ     1(М7)                   ,СМ := 1(М7)
         ЗП     7(М7)                   ,7 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     PAGE1C                  ,переход на PAGE1C
         ПБ     INS26A                  ,переход на INS26A
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    INS26C(М7)              ,М7 := INS26C
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

