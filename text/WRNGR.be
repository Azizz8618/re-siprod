***************************************************
* WRNGR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5568 образа SIPROD.BIN
*   Длина при загрузке: 88 слов, 176 команд
*   Вход: WRNGR
*   Выход: L12 (возврат через ячейка 0), L19 (возврат через М15), 
*   L14B (возврат через ячейка 0), L14B (возврат через ячейка 0), 
*   ADDR (возврат через М15)
*   Внешние: KONSTA, SYTOBI
*   Смещения в SYTOBI: 1, 2, 3, 4
*   Абсолютные символы: N1 = -1, N2 = -2, N48 = -48
*   Смещения в кадре (М7): общие 0-1, свои 11-14, 16
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), М13 (счётчик), 
*   М14 (смещение в буфере), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 KONSTA
*   002 SYTOBI
*   003 SYTOBI1
*   004 SYTOBI2
*   005 SYTOBI3
*   006 SYTOBI4
*   007 N48
*   008 N1
*   009 N2
*
*** КОД МОДУЛЯ
*
WRNGR    СТАРТ  0
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    14(М12)                 ,ЗП + магазин: 14(М12)
         ЗПМ    21(М12)                 ,ЗП + магазин: 21(М12)
         ЗПМ    17(М12)                 ,ЗП + магазин: 17(М12)
         ЗПМ    20(М12)                 ,ЗП + магазин: 20(М12)
         УИМ    М16                     ,М16 := СМ; СМ := из магазина
         ЗПМ    18(М12)                 ,ЗП + магазин: 18(М12)
         УИМ    М14                     ,М14 := СМ; СМ := из магазина
         СЧИМ   М7                      ,в магазин; СМ := М7
         ЗП     12(М12)                 ,параметр вызова ОС 12 := СМ
         СЧ     3(М10)                  ,СМ := поле блока вызывающего 3
         МОД    14(М12)                 ,мод.адрес := код из 14(М12)
         ЗП     0                       ,по адресу 14+М12 := СМ
         МОД    17(М12)                 ,мод.адрес := код из 17(М12)
         СЧ     0                       ,СМ := слово по адресу 17+М12
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         ПО     L14A                    ,если СМ=0 → L14A
         ЗП     11(М12)                 ,параметр вызова ОС 11 := СМ
         МОД    21(М12)                 ,мод.адрес := код из 21(М12)
         СЧ     0                       ,СМ := слово по адресу 21+М12
         СЛ     3(М10)                  ,СМ += поле блока вызывающего 3
         ПЕ     GETA                    ,если СМ≠0 → GETA
         ЗП     10(М12)                 ,параметр вызова ОС 10 := СМ
         И      8(М10)                  ,СМ &= поле блока вызывающего 8
         УИА    0(М13)                  ,М13 := база модуля
         УИ     М11                     ,М11 := СМ
         УИА    0(М7)                   ,М7 := база модуля
L14      СЛИ    М13(М11)                ,М13 += М11
         СЛИА   1(М7)                   ,М7 += 1
         СЛИА   N48(М13)                ,М13 += N48
         ПИО    L18(М13)                ,если ИР=0 → L18(М13)
         СЧИ    М13                     ,СМ := М13
         И      4(М10)                  ,СМ &= поле блока вызывающего 4
         ПО     GETA                    ,если СМ=0 → GETA
         СЛИА   48(М13)                 ,М13 += 48
         ПБ     L14                     ,переход на L14
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L18      СЧИ    М7                      ,СМ := М7
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ЗП     19(М12)                 ,параметр вызова ОС 19 := СМ
         СЧ     19(М12)                 ,СМ := параметр вызова ОС 19
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         ЗП     17(М12)                 ,параметр вызова ОС 17 := СМ
         МОД    18(М12)                 ,мод.адрес := код из 18(М12)
         СЧ     0                       ,СМ := слово по адресу 18+М12
         ПВ     L17(М15)                ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЛИА   1(М7)                   ,М7 += 1
         ПИО    GET(М7)                 ,если ИР=0 → GET(М7)
         СЛИА   N1(М7)                  ,М7 += N1
         УИИ    М11(М13)                ,М11 := М13
         МОД    20(М12)                 ,мод.адрес := код из 20(М12)
         СЧ     0                       ,СМ := слово по адресу 20+М12
         СЛИ    М14(М7)                 ,М14 += М7
         ПВ     L17(М15)                ,вызов через М15
         СЛИА   1(М7)                   ,М7 += 1
         ПИО    GET(М7)                 ,если ИР=0 → GET(М7)
         СЛИА   N1(М7)                  ,М7 += N1
         СЛИ    М16(М7)                 ,М16 += М7
         УИА    0(М7)                   ,М7 := база модуля
         СЧ     10(М12)                 ,СМ := параметр вызова ОС 10
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         ЗП     15(М12)                 ,параметр вызова ОС 15 := СМ
L10      ПИО    L10A(М11)               ,если ИР=0 → L10A(М11)
         МОД    10(М12)                 ,мод.адрес := код из 10(М12)
         СЛИА   0(М7)                   ,М7 += 0
         СЛИА   N1(М11)                 ,М11 += N1
         ПБ     L10                     ,переход на L10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L10A     УИИ    М11(М7)                 ,М11 := М7
         УИА    0(М7)                   ,М7 := база модуля
L10B     ПИО    L10C(М13)               ,если ИР=0 → L10C(М13)
         МОД    10(М12)                 ,мод.адрес := код из 10(М12)
         СЛИА   0(М7)                   ,М7 += 0
         СЛИА   N1(М13)                 ,М13 += N1
         ПБ     L10B                    ,переход на L10B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L10C     УИИ    М13(М7)                 ,М13 := М7
         МОД    10(М12)                 ,мод.адрес := код из 10(М12)
         СЧ     9(М10)                  ,СМ := поле блока вызывающего 9
         ЗП     22(М12)                 ,параметр вызова ОС 22 := СМ
         СЧ     11(М12)                 ,СМ := параметр вызова ОС 11
         УИ     М7                      ,М7 := СМ
         СЧИ    М11                     ,СМ := М11
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИ     М11                     ,М11 := СМ
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L10D     ПИО    L12(М7)                 ,если ИР=0 → L12(М7)
         СЧ     22(М12)                 ,СМ := параметр вызова ОС 22
         СЧМ    0(М14)                  ,магазин + СЧ: 0(М14)
         СДА    64+48(М11)
         И      0(М17)                  ,СМ &= поле контекста 0
         СДА    64-48(М13)
         СЧМ    22(М12)                 ,магазин + СЧ: 22(М12)
         СДА    64-48(М13)
         НТЖ    2(М10)                  ,СМ ^= поле блока вызывающего 2
         И      0(М16)                  ,СМ &= ячейка мод.адреса 0
         ИЛИ    0(М17)                  ,СМ |= поле контекста 0
         ЗП     0(М16)                  ,ячейка мод.адреса 0 := СМ
         СЛИА   1(М7)                   ,М7 += 1
         СЛИА   48(М11)                 ,М11 += 48
         ПИО    L10E(М11)               ,если ИР=0 → L10E(М11)
         СЛИА   N48(М11)                ,М11 += N48
L10E     МОД    15(М12)                 ,мод.адрес := код из 15(М12)
         СЛИА   0(М11)                  ,М11 += 0
         СЛИА   N48(М13)                ,М13 += N48
         ПИО    L10F(М13)               ,если ИР=0 → L10F(М13)
         СЛИА   48(М13)                 ,М13 += 48
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L10F     МОД    10(М12)                 ,мод.адрес := код из 10(М12)
         СЛИА   0(М13)                  ,М13 += 0
         ПБ     L10D                    ,переход на L10D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L12      МОД    12(М12)                 ,мод.адрес := код из 12(М12)
         УИА    0(М7)                   ,М7 := код из 12+М12
         СЧ     0(М17)                  ,СМ := поле контекста 0
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
L17      РЖА    '7'                     ,РЖ := 7 (исключение, нормализация)
         СЛ     3(М10)                  ,СМ += поле блока вызывающего 3
         ПЕ     ADDR                    ,если СМ≠0 → ADDR
         УИ     М13                     ,М13 := СМ
         УИА    0(М7)                   ,М7 := база модуля
         ПИО    ADDR(М13)               ,если ИР=0 → ADDR(М13)
L17A     МОД    17(М12)                 ,мод.адрес := код из 17(М12)
         СЛИА   0(М13)                  ,М13 += 0
         ПИО    L19(М13)                ,если ИР=0 → L19(М13)
         СЧИ    М13                     ,СМ := М13
         И      4(М10)                  ,СМ &= поле блока вызывающего 4
         ПЕ     L19                     ,если СМ≠0 → L19
         СЛИА   1(М7)                   ,М7 += 1
         ПБ     L17A                    ,переход на L17A
*
L19      МОД    19(М12)                 ,мод.адрес := код из 19(М12)
         СЛИА   0(М13)                  ,М13 += 0
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
GET      СЧ     8(М10)                  ,СМ := поле блока вызывающего 8
         НТЖ    0(М10)                  ,СМ ^= поле блока вызывающего 0
         ПБ     L14B                    ,переход на L14B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     10(М12)                 ,СМ := параметр вызова ОС 10
         УИ     М11                     ,М11 := СМ
         СЛИ    М13(М11)                ,М13 += М11
         СЧИ    М13                     ,СМ := М13
         ПБ     L14B                    ,переход на L14B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
GETA     СЧ     8(М10)                  ,СМ := поле блока вызывающего 8
         НТЖ    7(М10)                  ,СМ ^= поле блока вызывающего 7
         ПБ     L14B                    ,переход на L14B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L14A     СЧ     8(М10)                  ,СМ := поле блока вызывающего 8
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L14B     ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         МОД    14(М12)                 ,мод.адрес := код из 14(М12)
         ЗПМ    0                       ,по адресу 14+М12 := СМ (в магазин)
         МОД    12(М12)                 ,мод.адрес := код из 12(М12)
         УИА    0(М7)                   ,М7 := код из 12+М12
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         СЛИА   N2(М17)                 ,М17 += N2
         СЧ     8(М10)                  ,СМ := поле блока вызывающего 8
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         МОД    15(М12)                 ,мод.адрес := код из 15(М12)
         ЗПМ    0                       ,по адресу 15+М12 := СМ (в магазин)
         МОД    12(М12)                 ,мод.адрес := код из 12(М12)
         УИА    0(М7)                   ,М7 := код из 12+М12
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
ADDR     УИА    N1(М7)                  ,М7 := адрес N1
         ПБ     0(М15)                  ,переход через М15
*

