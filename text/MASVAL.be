***************************************************
* MASVAL - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 10656 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 44 команд
*   Вход: MASVAL
*   Выход: PAPRAP:EGO86F, PAPRAP:F0, F4 (возврат через М12), 
*   F1A (возврат через М10)
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-4, 10
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 N1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     26    6400000000000001
*   V0     27
*   V1     30
*   V2     31
*   V3     32
*
*** КОД МОДУЛЯ
*
MASVAL   СТАРТ  0
         УИА    F0(М16)                 ,М16 := адрес F0
         ПБ     F4                      ,переход на F4
*
F0       СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     1(М7)                   ,слот кадра 1 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F1                      ,переход на F1
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0A      МОД    V3                      ,мод.адрес := код из V3
         СЧ     0                       ,СМ := слово по адресу V3
         МОД    V0                      ,мод.адрес := код из V0
         УИА    0(М1)                   ,М1 := код из V0
         МОД    V1                      ,мод.адрес := код из V1
         ЗП     '4001'(М1)              ,каталог задачи: нулевое слово := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     1(М7)                   ,слот кадра 1 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1       МОД    V2                      ,мод.адрес := код из V2
         ВЧОБ   0                       ,СМ := слово по адресу V2 - СМ
         ПО     F0A                     ,если СМ=0 → F0A
         ПБ     F1A                     ,переход на F1A
*
F4       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         ЗПМ    4(М7)                   ,ЗП + магазин: 4(М7)
         ЗПМ    3(М7)                   ,ЗП + магазин: 3(М7)
         ЗПМ    2(М7)                   ,ЗП + магазин: 2(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1A      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

