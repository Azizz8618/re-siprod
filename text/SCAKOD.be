***************************************************
* SCAKOD - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19680 образа SIPROD.BIN
*   Длина при загрузке: 82 слов, 130 команд
*   Вход: SCAKOD
*   Выход: KODKOD:L0074, REGA (возврат через М14), F14 (возврат через М15), 
*   REGB (возврат через М15), L0160 (возврат через М12), 
*   F11A (возврат через М10)
*   Внешние: NEW, REG, IMA, IMUI, IDII, IPOI
*   Смещения в IMA: 32762
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-4, 6, 8-10, свои 11-15, вне кадра 2057
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М14 (смещение в буфере), М15 (адрес возврата), 
*   М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 NEW
*   002 REG
*   003 IMA
*   004 IMUI
*   005 IDII
*   006 IMUIA
*   007 IMA32762
*   008 IPOI
*   009 N1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     101    6400000000000000
*   К1     102    6400000000000001
*   К2     103    6400000000000002
*   К6     107    6400000000000010
*   К8     111    6400000000002000
*   V0     112
*   V1     113
*   V5     117
*
*** КОД МОДУЛЯ
*
SCAKOD   СТАРТ  0
         УИА    NEWA(М16)               ,М16 := адрес NEWA
         ПБ     L0160                   ,переход на L0160
*
NEWA     МОДА   NEW                     ,мод.адрес := NEW
         СЧ     0                       ,СМ := слово по адресу NEW
         УИА    К6(М16)                 ,М16 := адрес К6
         ПВ     IDII(М15)               ,вызов через М15
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     9(М7)                   ,СМ := слот кадра 9
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИА    К6(М16)                 ,М16 := адрес К6
         ПВ     IMUIA(М15)              ,вызов через М15
         МОДА   NEW                     ,мод.адрес := NEW
         СЛ     0                       ,СМ += слово по адресу NEW
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         УИА    V1(М16)                 ,М16 := адрес V1
         ПВ     IMUIA(М15)              ,вызов через М15
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         ПВ     F14(М15)                ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     10(М7)                  ,СМ := слот кадра 10
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     2(М7)                   ,СМ += слот кадра 2
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F10                     ,если СМ=0 → F10
         ПБ     F11                     ,переход на F11
*
F10      ПБ     IMA327                  ,переход на IMA327
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F11      СЧ     11(М7)                  ,СМ := слот кадра 11
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         ПВ     F14(М15)                ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     10(М7)                  ,СМ := слот кадра 10
         ВЧ     3(М7)                   ,СМ -= слот кадра 3
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
IMA327   МОД    К0                      ,мод.адрес := код из К0
         УИА    0(М1)                   ,М1 := код из К0
         МОДА   IMA32762(М1)            ,мод.адрес := IMA32762(М1)
         СЧ     0                       ,СМ := слово по адресу IMA32762+М1
         ЗП     12(М7)                  ,слот кадра 12 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     3(М7)                   ,СМ := слот кадра 3
         ВЧ     10(М7)                  ,СМ -= слот кадра 10
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         СЧ     6(М7)                   ,СМ := слот кадра 6
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IMUIA(М15)              ,вызов через М15
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИ    М16                     ,СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IPOI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗП     13(М7)                  ,слот кадра 13 := СМ
         СЧ     12(М7)                  ,СМ := слот кадра 12
         УИА    V5(М16)                 ,М16 := адрес V5
         ПВ     IDII(М15)               ,вызов через М15
         МОДА   NEW                     ,мод.адрес := NEW
         ЗП     0                       ,по адресу NEW := СМ
         МОДА   NEW                     ,мод.адрес := NEW
         СЧ     0                       ,СМ := слово по адресу NEW
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИА    V5(М16)                 ,М16 := адрес V5
         ПВ     IMUIA(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЛ     12(М7)                  ,СМ += слот кадра 12
         МОДА   NEW                     ,мод.адрес := NEW
         ЗП     0                       ,по адресу NEW := СМ
         СЧ     13(М7)                  ,СМ := слот кадра 13
         УИА    К8(М16)                 ,М16 := адрес К8
         ПВ     IDII(М15)               ,вызов через М15
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         МОДА   NEW                     ,мод.адрес := NEW
         СЧ     0                       ,СМ := слово по адресу NEW
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IDII(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         МОДА   NEW                     ,мод.адрес := NEW
         ЗП     0                       ,по адресу NEW := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F11A                    ,переход на F11A
*
REGA     УИИ    М14(М15)                ,М14 := М15
         МОДА   REG                     ,мод.адрес := REG
         СЧ     0                       ,СМ := слово по адресу REG
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ПВ     REGB(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     0(М14)                  ,переход через М14
*
F14      ВЧ     14(М7)                  ,СМ -= слот кадра 14
         ЗП     14(М7)                  ,слот кадра 14 := СМ
         СЧМ    4(М7)                   ,магазин + СЧ: 4(М7)
         ПВ     IMUI(М16)               ,вызов через М16
         СЛ     '4011'(М7)              ,СМ += каталог задачи: элемент 9
         ЗП     '4011'(М7)              ,каталог задачи: элемент 9 := СМ
         СЧ     11(М7)                  ,СМ := слот кадра 11
         ЗП     14(М7)                  ,слот кадра 14 := СМ
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
REGB     ВЧ     15(М7)                  ,СМ -= слот кадра 15
         ЗП     15(М7)                  ,слот кадра 15 := СМ
         СЛ     '4011'(М7)              ,СМ += каталог задачи: элемент 9
         ЗП     '4011'(М7)              ,каталог задачи: элемент 9 := СМ
         МОДА   REG                     ,мод.адрес := REG
         СЧ     0                       ,СМ := слово по адресу REG
         ЗП     15(М7)                  ,слот кадра 15 := СМ
         ПБ     0(М15)                  ,переход через М15
*
L0160    УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         ПВ     REGA(М15)               ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F11A     УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

