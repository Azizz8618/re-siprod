***************************************************
* KOKSEK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18592 образа SIPROD.BIN
*   Длина при загрузке: 35 слов, 62 команд
*   Вход: KOKSEK
*   Выход: RASTXT:INS25A, SEKGIR:F9, F1 (возврат через М12), 
*   POP (возврат через М10)
*   Внешние: SEK, SLY, LYG, TAB, NUST, NDAB, NDABL
*   Смещения в LYG: 1, 2
*   Смещения в NDAB: 1
*   Смещения в NDABL: 1
*   Смещения в SEK: 1
*   Смещения в SLY: 1
*   Смещения в TAB: 1, 3, 4
*   Смещения в кадре (М7): общие 0-3, 10
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес), 
*   М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 SEK
*   002 SLY
*   003 SLY1
*   004 LYG
*   005 LYG1
*   006 LYG2
*   007 TAB
*   008 TAB1
*   009 TAB3
*   010 TAB4
*   011 NUST
*   012 NDAB
*   013 NDAB1
*   014 NDABL
*   015 NDABL1
*   016 SEK32767
*   017 SEK1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     37    6400000000000000
*   V0     42
*
*** КОД МОДУЛЯ
*
KOKSEK   СТАРТ  0
         УИА    SEK327(М16)             ,М16 := адрес SEK327
         ПБ     F1                      ,переход на F1
*
SEK327   СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
SEK32A   СЧ     0(М7)                   ,СМ := слот кадра 0
         МОД    V0                      ,мод.адрес := код из V0
         УИА    0(М1)                   ,М1 := код из V0
         МОДА   SEK32767(М1)            ,мод.адрес := SEK32767(М1)
         ЗП     0                       ,по адресу SEK32767+М1 := СМ
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     3(М7)                   ,СМ := слот кадра 3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     SEK32A                  ,если СМ=0 → SEK32A
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SLY1                    ,мод.адрес := SLY1
         СЧ     0                       ,СМ := слово по адресу SLY1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     SEKA                    ,если СМ=0 → SEKA
         ПБ     SEKB                    ,переход на SEKB
*
SEKA     СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   SEK                     ,мод.адрес := SEK
         ЗП     0                       ,по адресу SEK := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEKB     СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   TAB                     ,мод.адрес := TAB
         СЧ     0                       ,СМ := слово по адресу TAB
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     SEK1A                   ,если СМ=0 → SEK1A
         ПБ     SEK1B                   ,переход на SEK1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK1A    СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   SEK1                    ,мод.адрес := SEK1
         ЗП     0                       ,по адресу SEK1 := СМ
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK1B    ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

