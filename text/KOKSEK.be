         СЧ     1(М7)                   ,СМ := 1(М7)
SLY1A    СЧИМ                           ,СЧИ + магазин
         МОДА   SLY1                    ,мод.адрес +1: SLY1
L0026    СЧ     0                       ,СМ := 0
SEKA     НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     L0015                   ,если СМ=0 → L0015
         ПБ     L0020                   ,переход на L0020
         СЧ     1(М7)                   ,СМ := 1(М7)
