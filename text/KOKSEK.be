L0015    РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         ЗП     3(М7)                   ,3 := СМ
L0020    ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := '22'
