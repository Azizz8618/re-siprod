L0034    ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
V1       МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
TABA     МОДА   TAB                     ,мод.адрес +1: TAB
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     SLY1A                   ,если СМ=0 → SLY1A
         ПБ     L0026                   ,переход на L0026
         МОДА   0                       ,мод.адрес +1: 0
