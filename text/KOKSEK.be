KOKSEK   СТАРТ  0
         УИА    L0001(М16)              ,М16 := L0001
L0001    ПБ     SEKA                    ,переход на SEKA
         СЧ     1(М7)                   ,СМ := 1(М7)
L0042    ЗП     3(М7)                   ,3 := СМ
