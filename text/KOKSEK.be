         МОДА   0                       ,мод.адрес +1: 0
         СЧ     3(М7)                   ,СМ := 3(М7)
SEK32B   РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         ЗП     3(М7)                   ,3 := СМ
SEK32C   ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := '22'
         ПО     SEK32A                  ,если СМ=0 → SEK32A
         СЧ     1(М7)                   ,СМ := 1(М7)
SEK32D   СЧИМ                           ,СЧИ + магазин
         МОДА   SLY1                    ,мод.адрес +1: SLY1
SEK32E   СЧ     0                       ,СМ := 0
SEK32F   НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     SEK32B                  ,если СМ=0 → SEK32B
         ПБ     SEK32C                  ,переход на SEK32C
         СЧ     1(М7)                   ,СМ := 1(М7)
         МОДА   SEK                     ,мод.адрес +1: SEK
SEKA     ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
SEKB     МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
SEKC     МОДА   TAB                     ,мод.адрес +1: TAB
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     SEK32D                  ,если СМ=0 → SEK32D
         ПБ     SEK32E                  ,переход на SEK32E
         МОДА   0                       ,мод.адрес +1: 0
