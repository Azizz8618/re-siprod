        НТЖ    NEWMAX(М17)              ,СМ ^= NEWMAX(М17)
V15     ПО     L0036                    ,если СМ=0 → L0036
        ПБ     СИМ122                   ,переход на СИМ122
        МОДА   NEWMAX                   ,мод.адрес +1: NEWMAX
L0074   ПБ     L0074                    ,переход на L0074
REGIM2  МОДА   NEWMAX                   ,мод.адрес +1: NEWMAX
        СЧ     NEWMAX(М7)               ,СМ := NEWMAX(М7)
        СЧИМ                            ,СЧИ + магазин
