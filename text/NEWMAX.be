         ВЧОБ   0                       ,СМ := (адрес) - СМ
         МОДА   LYG1                    ,мод.адрес := LYG1
         СЛ     0                       ,СМ += слово по адресу LYG1
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     SEK3A                   ,если СМ=0 → SEK3A
