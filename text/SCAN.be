        ЗП     SCAN                     ,SCAN := СМ
        РЖА    '22'                     ,РЖ := '22'
        ПБ     IMUI                     ,переход на IMUI
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0074(М7)                ,М7 := L0074
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М1                       ,стек := М1, СМ := М1
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     SCAN(М12)                ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М1                       ,М1 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     SCAN(М10)                ,переход через М10
        МОДА   SCAN                     ,мод.адрес +1: SCAN

