***************************************************
* SCAN - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 14848 образа SIPROD.BIN
*   Длина при загрузке: 89 слов, 118 команд
*   Вход: SCAN
*   Выход: L0146 (возврат через М12), POP (возврат через М10)
*   РАЗБОР СТРОКИ КОМАНДЫ: ВЫДЕЛЕНИЕ СИМВОЛА ПОСЛЕ '*'
*   ИЗВЛЕЧЕНИЕ АДРЕСА, ЧИСЛА И ТЕКСТА ОПЕРАНДА.
*   Внешние: INS, SCANER, KLAIDA, RSYMB, IDII, IMUI, IPOI
*   Смещения в INS: 24, 25, 26
*   Смещения в SCANER: 1, 2
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-1, 4-5, 7-10, свои 11-12, 
*   вне кадра 2058
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 SCANER
*   006 SCANER1
*   007 SCANER2
*   008 KLAIDA
*   009 RSYMB
*   010 N1
*   011 IDII
*   012 IMUI
*   013 IPOI
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К1     74
*   К2     75
*   К3     76
*   К4     77
*   К5     100
*   К7     102
*   V0     103
*   V1     104
*   V2     105
*   V5     110
*   V6     111
*
*** КОД МОДУЛЯ
*
* РАЗБОР СИМВОЛА ПОСЛЕ '*'.
SCAN     СТАРТ  0
         УИА    F8(М16)                 ,М16 := адрес F8
         ПБ     L0146                   ,переход на L0146
*
F8       СЧ     '4012'(М7)              ,СМ := каталог задачи: элемент 10
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         УИА    INS(М16)                ,М16 := адрес INS
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SCANER(М16)             ,М16 := адрес SCANER
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К4(М16)                 ,М16 := адрес К4
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         СЧ     8(М7)                   ,СМ := слот кадра 8
         УИА    К5(М16)                 ,М16 := адрес К5
         ПВ     IDII(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         СЧ     9(М7)                   ,СМ := слот кадра 9
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     5(М7)                   ,СМ += слот кадра 5
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F9                      ,если СМ≠0 → F9
         ПБ     F9A                     ,переход на F9A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F9       УИА    К7(М16)                 ,М16 := адрес К7
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     KLAIDA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F9A      СЧ     9(М7)                   ,СМ := слот кадра 9
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИА    К5(М16)                 ,М16 := адрес К5
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЛ     8(М7)                   ,СМ += слот кадра 8
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         МОД    V2                      ,мод.адрес := код из V2
         УИА    0(М1)                   ,М1 := код из V2
         МОДА   V6(М1)                  ,мод.адрес := V6(М1)
         СЧ     0                       ,СМ := слово по адресу V6+М1
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         СЧ     4(М7)                   ,СМ := слот кадра 4
         ВЧ     10(М7)                  ,СМ -= слот кадра 10
         УИА    К3(М16)                 ,М16 := адрес К3
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИ    М16                     ,СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IPOI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗП     12(М7)                  ,слот кадра 12 := СМ
         СЧ     11(М7)                  ,СМ := слот кадра 11
         УИА    V5(М16)                 ,М16 := адрес V5
         ПВ     IDII(М15)               ,вызов через М15
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         ЗП     0                       ,по адресу SCANER1 := СМ
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИА    V5(М16)                 ,М16 := адрес V5
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЛ     11(М7)                  ,СМ += слот кадра 11
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         ЗП     0                       ,по адресу SCANER1 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         УИА    К2(М16)                 ,М16 := адрес К2
         ПВ     IMUI(М15)               ,вызов через М15
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         УИА    К2(М16)                 ,М16 := адрес К2
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IMUI(М15)               ,вызов через М15
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         СЧ     12(М7)                  ,СМ := слот кадра 12
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IDII(М15)               ,вызов через М15
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IDII(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         ЗП     0                       ,по адресу SCANER1 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     POP                     ,переход на POP
*
L0146    УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
К1       КОНД   В'6400000000000001'
К2       КОНД   В'6400000000000002'
К3       КОНД   В'6400000000000005'
К4       КОНД   В'6400000000000006'
К5       КОНД   В'6400000000000010'
К7       КОНД   В'6400000000000062'
V0       ПАМ    1
V1       ПАМ    1
V2       ПАМ    1
V3       ПАМ    1
V4       ПАМ    1
V5       ПАМ    1
V6       ПАМ    1
V7       ПАМ    1
V8       ПАМ    1
V9       ПАМ    1
V10      ПАМ    1
V11      ПАМ    1
V12      ПАМ    1
V13      ПАМ    1
V14      ПАМ    1
V15      ПАМ    1
V16      ПАМ    1
V17      ПАМ    1
V18      ПАМ    1
V19      ПАМ    1
V20      ПАМ    1
V21      ПАМ    1
	ФИНИШ

