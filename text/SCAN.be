***************************************************
* SCAN - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 14848 образа SIPROD.BIN
*   Длина при загрузке: 89 слов, 118 команд
*   Вход: SCAN
*   Внешние: *INS*, *SCANER*, KLAIDA, RSYMB, I*DI*I, I*MU*I, I*PO*I
*   Смещения в *INS*: 24, 25, 26
*   Смещения в *SCANER*: 1, 2
*   Регистры: М1, М7, М10, М12, М15, М16
***************************************************
SCAN    СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0063                    ,переход на L0063
        СЧ     '4012'(М7)               ,СМ := '4012'(М7)
        ЗП     8(М7)                    ,8 := СМ
        РЖА    '3'                      ,РЖ := '3'
L0005   УИА    *INS*(М16)               ,М16 := *INS*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SCANER*(М16)            ,М16 := *SCANER*
L0010   СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    SCANEA(М16)              ,М16 := SCANEA
L0012   СЧИМ   М16                      ,стек := М16, СМ := М16
RSYMB   УИА    V4(М16)                  ,М16 := V4
        СЧИМ   М16                      ,стек := М16, СМ := М16
        РЖА    '22'                     ,РЖ := '22'
        ПВ     RSYMB(М15)               ,вызов через М15
        МОДА   SCAN                     ,мод.адрес +1: SCAN
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
SCANER  МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
        СЧ     SCAN                     ,СМ := SCAN
IDII    РЖА    '3'                      ,РЖ := '3'
        СЛ     SCAN(М7)                 ,СМ += SCAN(М7)
        МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
        ЗП     SCAN                     ,SCAN := СМ
        СЧ     8(М7)                    ,СМ := 8(М7)
        УИА    L0100(М16)               ,М16 := L0100
        ПВ     I*DI*I(М15)              ,вызов через М15
        МОДА   SCAN                     ,мод.адрес +1: SCAN
        ЗП     9(М7)                    ,9 := СМ
        СЧ     9(М7)                    ,СМ := 9(М7)
        ВЧОБ   SCAN                     ,СМ := (адрес) - СМ
        СЛ     L0005(М7)                ,СМ += L0005(М7)
        РЖА    '22'                     ,РЖ := '22'
        ПЕ     SCANER                   ,если СМ≠0 → SCANER
        ПБ     IDII                     ,переход на IDII
        МОДА   SCAN                     ,мод.адрес +1: SCAN
        УИА    L0102(М16)               ,М16 := L0102
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     KLAIDA(М15)              ,вызов через М15
        МОДА   SCAN                     ,мод.адрес +1: SCAN
        СЧ     9(М7)                    ,СМ := 9(М7)
        РЖА    '3'                      ,РЖ := '3'
        ВЧОБ   SCAN                     ,СМ := (адрес) - СМ
        УИА    L0100(М16)               ,М16 := L0100
        ПВ     I*MU*I(М15)              ,вызов через М15
        МОДА   SCAN                     ,мод.адрес +1: SCAN
        СЛ     L0010(М7)                ,СМ += L0010(М7)
        ЗП     10(М7)                   ,10 := СМ
        МОД    SCANEB                   ,мод.адрес по коду: SCANEB
        УИА    SCAN(М1)                 ,М1 := SCAN
        МОДА   IMUI2(М1)                ,мод.адрес +1: IMUI2(М1)
L0063   СЧ     SCAN                     ,СМ := SCAN
        ЗП     11(М7)                   ,11 := СМ
        СЧ     4(М7)                    ,СМ := 4(М7)
        ВЧ     10(М7)                   ,СМ -= 10(М7)
        УИА    IPOI(М16)                ,М16 := IPOI
IMUI    ПВ     I*MU*I(М15)              ,вызов через М15
        МОДА   SCAN                     ,мод.адрес +1: SCAN
        ЗП     7(М7)                    ,7 := СМ
        УИА    L0075(М16)               ,М16 := L0075
L0074   СЧИ    М16                      ,СМ := М16
L0075   УИА    IDII2(М16)               ,М16 := IDII2
IPOI    ПВ     I*PO*I(М15)              ,вызов через М15
V4      МОДА   SCAN                     ,мод.адрес +1: SCAN
L0100   ЗП     12(М7)                   ,12 := СМ
        СЧ     11(М7)                   ,СМ := 11(М7)
L0102   УИА    L0110(М16)               ,М16 := L0110
IDII2   ПВ     I*DI*I(М15)              ,вызов через М15
SCANEA  МОДА   *SCANER*+1               ,мод.адрес +1: *SCANER*+1
SCANEB  ЗП     SCAN                     ,SCAN := СМ
        МОДА   *SCANER*+1               ,мод.адрес +1: *SCANER*+1
        СЧ     SCAN                     ,СМ := SCAN
L0110   ВЧОБ   SCAN                     ,СМ := (адрес) - СМ
IMUI2   УИА    L0110(М16)               ,М16 := L0110
        ПВ     I*MU*I(М15)              ,вызов через М15
        МОДА   SCAN                     ,мод.адрес +1: SCAN
        СЛ     RSYMB(М7)                ,СМ += RSYMB(М7)
        МОДА   *SCANER*+1               ,мод.адрес +1: *SCANER*+1
        ЗП     SCAN                     ,SCAN := СМ
        СЧ     1(М7)                    ,СМ := 1(М7)
        УИА    L0075(М16)               ,М16 := L0075
        ПВ     I*MU*I(М15)              ,вызов через М15
        ЗП     7(М7)                    ,7 := СМ
        УИА    L0075(М16)               ,М16 := L0075
        ПВ     I*MU*I(М15)              ,вызов через М15
        МОДА   SCAN                     ,мод.адрес +1: SCAN
        УИА    IDII2(М16)               ,М16 := IDII2
        ПВ     I*MU*I(М15)              ,вызов через М15
        ЗП     7(М7)                    ,7 := СМ
        СЧ     12(М7)                   ,СМ := 12(М7)
        УИА    IDII2(М16)               ,М16 := IDII2
        ПВ     I*DI*I(М15)              ,вызов через М15
        ЗП     7(М7)                    ,7 := СМ
        МОДА   *SCANER*+1               ,мод.адрес +1: *SCANER*+1
        СЧ     SCAN                     ,СМ := SCAN
        УИА    IDII2(М16)               ,М16 := IDII2
        ПВ     I*DI*I(М15)              ,вызов через М15
        МОДА   SCAN                     ,мод.адрес +1: SCAN
