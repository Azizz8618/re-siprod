***************************************************
* START - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6496 образа SIPROD.BIN
*   Длина при загрузке: 31 слов, 52 команд
*   Вход: START
*   Внешние: *KORT*, *EGO*, *FOP*, *KOMA*, *NUNU*
*   Смещения в *EGO*: 7200, 8600, 8601
*   Смещения в *KOMA*: 2, 7
*   Смещения в *KORT*: 14
*   Регистры: М1, М7, М10, М12, М15, М16
***************************************************
START   СТАРТ  0
        УИА    FOP(М16)                 ,М16 := FOP
FOP     ПБ     L0022                    ,переход на L0022
        СЧ     START(М7)                ,СМ := START(М7)
        МОДА   *FOP*                    ,мод.адрес +1: *FOP*
        ЗП     START                    ,START := СМ
L0005   РЖА    '3'                      ,РЖ := '3'
        СЧ     1(М7)                    ,СМ := 1(М7)
        ЗП     3(М7)                    ,3 := СМ
V1      РЖА    '22'                     ,РЖ := '22'
        МОДА   START                    ,мод.адрес +1: START
L0036   СЧ     '4014'(М7)               ,СМ := '4014'(М7)
        МОД    NUNU                     ,мод.адрес по коду: NUNU
        УИА    START(М1)                ,М1 := START
        МОДА   *KORT*+77777(М1)         ,мод.адрес +1: *KORT*+77777
        ЗП     START                    ,START := СМ
        МОДА   START                    ,мод.адрес +1: START
        СЧ     3(М7)                    ,СМ := 3(М7)
        РЖА    '3'                      ,РЖ := '3'
L0022   СЛ     FOP(М7)                  ,СМ += FOP(М7)
        ЗП     3(М7)                    ,3 := СМ
        ВЧОБ   2(М7)                    ,СМ := (адрес) - СМ
        РЖА    '22'                     ,РЖ := '22'
        ПО     L0005                    ,если СМ=0 → L0005
KORT16  СЧ     1(М7)                    ,СМ := 1(М7)
        МОДА   *KORT*+16                ,мод.адрес +1: *KORT*+16
        ЗП     START                    ,START := СМ
        РЖА    '3'                      ,РЖ := '3'
EGO206  СЧ     START(М7)                ,СМ := START(М7)
        МОДА   *EGO*+20630              ,мод.адрес +1: *EGO*+20630
        ЗП     START                    ,START := СМ
NUNU    СЧ     1(М7)                    ,СМ := 1(М7)
        МОДА   *NUNU*                   ,мод.адрес +1: *NUNU*
L0040   ЗП     START                    ,START := СМ
V12     РЖА    '22'                     ,РЖ := '22'
        ПБ     KORT16                   ,переход на KORT16
        МОДА   START                    ,мод.адрес +1: START
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    EGO206(М7)               ,М7 := EGO206
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М1                       ,стек := М1, СМ := М1
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     START(М12)               ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М1                       ,М1 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     START(М10)               ,переход через М10
        МОДА   START                    ,мод.адрес +1: START

