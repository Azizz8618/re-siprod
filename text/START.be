***************************************************
* START - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6496 образа SIPROD.BIN
*   Длина при загрузке: 31 слов, 52 команд
*   Вход: START
*   Выход: SCHEMA:GOTA, F1 (возврат через М12), POP (возврат через М10)
*   НАЧАЛО ОБРАБОТКИ ВХОДНОГО ПОТОКА.
*   Внешние: KORT, EGO, FOP, KOMA, NUNU
*   Смещения в EGO: 7200, 8600, 8601
*   Смещения в KOMA: 2, 7
*   Смещения в KORT: 14
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-3, 10, вне кадра 2060
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 KORT
*   002 KORT14
*   003 EGO
*   004 EGO7200
*   005 EGO8600
*   006 EGO8601
*   007 FOP
*   008 KOMA
*   009 KOMA2
*   010 KOMA7
*   011 NUNU
*   012 N1
*   013 KORT32767
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К1     33
*   V0     36
*   V2     40
*   V3     41
*
*** КОД МОДУЛЯ
*
* НАЧАЛО ОБРАБОТКИ ВХОДНОГО ПОТОКА.
START    СТАРТ  0
         УИА    FOPA(М16)               ,М16 := адрес FOPA
         ПБ     F1                      ,переход на F1
*
FOPA     СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   FOP                     ,мод.адрес := FOP
         ЗП     0                       ,по адресу FOP := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
FOPB     СЧ     '4014'(М7)              ,СМ := каталог задачи: элемент 12
         МОД    V0                      ,мод.адрес := код из V0
         УИА    0(М1)                   ,М1 := код из V0
         МОДА   KORT32767(М1)           ,мод.адрес := KORT32767(М1)
         ЗП     0                       ,по адресу KORT32767+М1 := СМ
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     3(М7)                   ,СМ := слот кадра 3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     FOPB                    ,если СМ=0 → FOPB
         СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   KORT14                  ,мод.адрес := KORT14
         ЗП     0                       ,по адресу KORT14 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   EGO8600                 ,мод.адрес := EGO8600
         ЗП     0                       ,по адресу EGO8600 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   NUNU                    ,мод.адрес := NUNU
         ЗП     0                       ,по адресу NUNU := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
К1       КОНД   В'6400000000000000'
V0       ПАМ    1
	ФИНИШ

