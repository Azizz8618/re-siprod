***************************************************
* PILDYK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18784 образа SIPROD.BIN
*   Длина при загрузке: 32 слов, 50 команд
*   Вход: PILDYK
*   Внешние: RSYMB
*   Регистры: М7, М10, М12, М15, М16
***************************************************
PILDYK  СТАРТ  0
        УИА    L0034(М16)               ,М16 := L0034
L0034   ПБ     RSYMB                    ,переход на RSYMB
        МОД    L0035                    ,мод.адрес по коду: L0035
        СЧ     PILDYK                   ,СМ := PILDYK
L0004   ЗП     1(М7)                    ,1 := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПБ     L0016                    ,переход на L0016
L0037   МОД    L00372                   ,мод.адрес по коду: L00372
        УИА    PILDYK(М16)              ,М16 := PILDYK
L0033   СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0031(М16)               ,М16 := L0031
        СЧИМ   М16                      ,стек := М16, СМ := М16
        МОД    L00332                   ,мод.адрес по коду: L00332
L0016   УИА    PILDYK(М16)              ,М16 := PILDYK
        СЧИМ   М16                      ,стек := М16, СМ := М16
RSYMB   УИА    L0032(М16)               ,М16 := L0032
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     RSYMB(М15)               ,вызов через М15
        МОДА   PILDYK                   ,мод.адрес +1: PILDYK
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        СЧ     1(М7)                    ,СМ := 1(М7)
L0036   РЖА    '3'                      ,РЖ := '3'
        МОД    L00362                   ,мод.адрес по коду: L00362
L0031   СЛ     PILDYK                   ,СМ += PILDYK
L0032   ЗП     1(М7)                    ,1 := СМ
L00332  РЖА    '22'                     ,РЖ := '22'
L0035   МОД    L00352                   ,мод.адрес по коду: L00352
L00352  ВЧОБ   PILDYK                   ,СМ := (адрес) - СМ
L00362  ПО     L0004                    ,если СМ=0 → L0004
L00372  ПБ     L0036                    ,переход на L0036
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0031(М7)                ,М7 := L0031
        ЗПМ    6(М7)                    ,ЗП + магазин: 6(М7)
        ЗПМ    5(М7)                    ,ЗП + магазин: 5(М7)
        ЗПМ    4(М7)                    ,ЗП + магазин: 4(М7)
        ЗПМ    3(М7)                    ,ЗП + магазин: 3(М7)
        ЗПМ    2(М7)                    ,ЗП + магазин: 2(М7)
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     PILDYK(М12)              ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     PILDYK(М10)              ,переход через М10

