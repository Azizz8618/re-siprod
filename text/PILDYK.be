***************************************************
* PILDYK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18784 образа SIPROD.BIN
*   Длина при загрузке: 32 слов, 50 команд
*   Вход: PILDYK
*   Выход: WRREM:SEP4B, WRREM:SEP4C, WRREM:F1, F6 (возврат через М12), 
*   POP (возврат через М10)
*   ЗАПОЛНЕНИЕ ТАБЛИЧНЫХ ПОЛЕЙ.
*   Внешние: RSYMB
*   Смещения в кадре (М7): общие 0-6, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 RSYMB
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     31
*   V0     32
*   V1     33
*   V2     34
*   V3     35
*   V4     36
*   V5     37
*
*** КОД МОДУЛЯ
*
PILDYK   СТАРТ  0
         УИА    F1(М16)                 ,М16 := адрес F1
         ПБ     F6                      ,переход на F6
*
F1       МОД    V2                      ,мод.адрес := код из V2
         СЧ     0                       ,СМ := слово по адресу V2
         ЗП     1(М7)                   ,слот кадра 1 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F1A                     ,переход на F1A
*
LOOP     МОД    V5                      ,мод.адрес := код из V5
         УИА    0(М16)                  ,М16 := код из V5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         МОД    V1                      ,мод.адрес := код из V1
         УИА    0(М16)                  ,М16 := код из V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОД    V4                      ,мод.адрес := код из V4
         СЛ     0                       ,СМ += слово по адресу V4
         ЗП     1(М7)                   ,слот кадра 1 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F1A      МОД    V3                      ,мод.адрес := код из V3
         ВЧОБ   0                       ,СМ := слово по адресу V3 - СМ
         ПО     LOOP                    ,если СМ=0 → LOOP
         ПБ     POP                     ,переход на POP
*
F6       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         ЗПМ    6(М7)                   ,ЗП + магазин: 6(М7)
         ЗПМ    5(М7)                   ,ЗП + магазин: 5(М7)
         ЗПМ    4(М7)                   ,ЗП + магазин: 4(М7)
         ЗПМ    3(М7)                   ,ЗП + магазин: 3(М7)
         ЗПМ    2(М7)                   ,ЗП + магазин: 2(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

