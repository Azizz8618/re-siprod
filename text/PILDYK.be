***************************************************
* PILDYK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18784 образа SIPROD.BIN
*   Длина при загрузке: 32 слов, 50 команд
*   Вход: PILDYK
*   Выход: WRREM:SEP4D, WRREM:SEP4F+1, WRREM:SEP4F+1, 
*   V1I (возврат через М12), V1I (возврат через М10)
*   ЗАПОЛНЕНИЕ ТАБЛИЧНЫХ ПОЛЕЙ.
*   Внешние: RSYMB
*   Регистры: М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 RSYMB
*
PILDYK   СТАРТ  0
         УИА    V1(М16)                 ,М16 := V1
V1       ПБ     ADDRA                   ,переход на ADDRA
         МОД    V1F                     ,мод.адрес по коду: V1F
         СЧ     0                       ,СМ := 0
V1A      ЗП     1(М7)                   ,1 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     ADDR                    ,переход на ADDR
         МОД    V1I                     ,мод.адрес по коду: V1I
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V1C(М16)                ,М16 := V1C
         СЧИМ   М16                     ,стек := М16, СМ := М16
         МОД    V1E                     ,мод.адрес по коду: V1E
ADDR     УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
ADDRA    УИА    V1D(М16)                ,М16 := V1D
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         СЧ     1(М7)                   ,СМ := 1(М7)
V1B      РЖА    '3'                     ,РЖ := '3'
         МОД    V1H                     ,мод.адрес по коду: V1H
V1C      СЛ     0                       ,СМ += 0
V1D      ЗП     1(М7)                   ,1 := СМ
V1E      РЖА    '22'                    ,РЖ := '22'
V1F      МОД    V1G                     ,мод.адрес по коду: V1G
V1G      ВЧОБ   0                       ,СМ := (адрес) - СМ
V1H      ПО     V1A                     ,если СМ=0 → V1A
V1I      ПБ     V1B                     ,переход на V1B
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    V1C(М7)                 ,М7 := V1C
         ЗПМ    6(М7)                   ,ЗП + магазин: 6(М7)
         ЗПМ    5(М7)                   ,ЗП + магазин: 5(М7)
         ЗПМ    4(М7)                   ,ЗП + магазин: 4(М7)
         ЗПМ    3(М7)                   ,ЗП + магазин: 3(М7)
         ЗПМ    2(М7)                   ,ЗП + магазин: 2(М7)
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

