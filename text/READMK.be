***************************************************
* READMK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19424 образа SIPROD.BIN
*   Длина при загрузке: 123 слов, 212 команд
*   Вход: READMK
*   Выход: SPAUD:INS26Q, F2C (возврат через М12), F2D (возврат через М10)
*   Внешние: INS, MKR, RMK, NRM, STV, SCANER, KLAIDA, GETSTR, RNSYMB, ЗЖWБ, 
*   IMUI
*   Смещения в INS: 24, 25, 26
*   Смещения в MKR: 500, 501
*   Смещения в SCANER: 1, 2
*   Смещения в кадре (М7): общие 0-2, 4-7, 9-10, свои 11-14, 16
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 MKR
*   006 MKR500
*   007 MKR501
*   008 RMK
*   009 NRM
*   010 STV
*   011 SCANER
*   012 SCANER1
*   013 SCANER2
*   014 KLAIDA
*   015 GETSTR
*   016 RNSYMB
*   017 ЗЖWБ
*   018 IMUI
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     152    6400000000000000
*   К2     154    6400000000000002
*   К3     155    6400000000000005
*   V1     163
*   V4     166
*   V5     167
*   V6     170
*   V7     171
*   V8     172
*
*** КОД МОДУЛЯ
*
READMK   СТАРТ  0
         УИА    STVA(М16)               ,М16 := адрес STVA
         ПБ     F2C                     ,переход на F2C
*
STVA     СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   STV                     ,мод.адрес := STV
         СЧ     0                       ,СМ := слово по адресу STV
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     MKR50A                  ,если СМ=0 → MKR50A
         ПБ     MKR50B                  ,переход на MKR50B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
MKR50A   ПБ     MKR50C                  ,переход на MKR50C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
MKR50B   СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   MKR500                  ,мод.адрес := MKR500
         ЗП     0                       ,по адресу MKR500 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   MKR501                  ,мод.адрес := MKR501
         ЗП     0                       ,по адресу MKR501 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   STV                     ,мод.адрес := STV
         ЗП     0                       ,по адресу STV := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
MKR50C   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
MKR50D   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS26                   ,мод.адрес := INS26
         ВЧ     0                       ,СМ -= слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F1                      ,если СМ=0 → F1
         ПБ     ЗЖWБA                   ,переход на ЗЖWБA
*
F1       ПБ     INS26A                  ,переход на INS26A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ЗЖWБA    ПВ     ЗЖWБ(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     4(М7)                   ,СМ := слот кадра 4
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     SCANEA                  ,если СМ≠0 → SCANEA
         ПБ     SCANEB                  ,переход на SCANEB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEA   ПБ     MKR50D                  ,переход на MKR50D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEB   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     2(М7)                   ,СМ -= слот кадра 2
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     INS26B                  ,переход на INS26B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
INS26A   МОДА   INS26                   ,мод.адрес := INS26
         СЧ     0                       ,СМ := слово по адресу INS26
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
INS26B   СЧ     10(М7)                  ,СМ := слот кадра 10
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     9(М7)                   ,СМ -= слот кадра 9
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     12(М7)                  ,слот кадра 12 := СМ
         МОДА   MKR500                  ,мод.адрес := MKR500
         СЧ     0                       ,СМ := слово по адресу MKR500
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     13(М7)                  ,слот кадра 13 := СМ
         МОДА   MKR500                  ,мод.адрес := MKR500
         СЧ     0                       ,СМ := слово по адресу MKR500
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         ВЧ     12(М7)                  ,СМ -= слот кадра 12
         СЛ     7(М7)                   ,СМ += слот кадра 7
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F10                     ,если СМ=0 → F10
         ПБ     F5                      ,переход на F5
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F10      ПБ     F5A                     ,переход на F5A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F5       СЧ     5(М7)                   ,СМ := слот кадра 5
         ЗП     14(М7)                  ,слот кадра 14 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F2A                     ,переход на F2A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F5A      УИА    INS(М16)                ,М16 := адрес INS
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    MKR(М16)                ,М16 := адрес MKR
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V5(М16)                 ,М16 := адрес V5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V4(М16)                 ,М16 := адрес V4
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RNSYMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   MKR500                  ,мод.адрес := MKR500
         СЧ     0                       ,СМ := слово по адресу MKR500
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     12(М7)                  ,СМ += слот кадра 12
         МОДА   MKR500                  ,мод.адрес := MKR500
         ЗП     0                       ,по адресу MKR500 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     11(М7)                  ,СМ := слот кадра 11
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F11                     ,если СМ=0 → F11
         ПБ     F11A                    ,переход на F11A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F11      ПБ     NRMA                    ,переход на NRMA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F11A     УИА    V7(М16)                 ,М16 := адрес V7
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     GETSTR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   INS25                   ,мод.адрес := INS25
         СЧ     0                       ,СМ := слово по адресу INS25
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     MKR50C                  ,переход на MKR50C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NRMA     МОДА   NRM                     ,мод.адрес := NRM
         СЧ     0                       ,СМ := слово по адресу NRM
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   MKR501                  ,мод.адрес := MKR501
         СЧ     0                       ,СМ := слово по адресу MKR501
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F11B                    ,если СМ=0 → F11B
         ПБ     F6                      ,переход на F6
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F11B     ПБ     F2                      ,переход на F2
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F6       СЧ     6(М7)                   ,СМ := слот кадра 6
         ЗП     14(М7)                  ,слот кадра 14 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F2A                     ,переход на F2A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2       СЧ     2(М7)                   ,СМ := слот кадра 2
         УИА    NRM(М16)                ,М16 := адрес NRM
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     16(М7)                  ,слот кадра 16 := СМ
         УИА    MKR500(М16)             ,М16 := адрес MKR500
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    RMK(М16)                ,М16 := адрес RMK
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V8(М16)                 ,М16 := адрес V8
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RNSYMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   NRM                     ,мод.адрес := NRM
         СЧ     0                       ,СМ := слово по адресу NRM
         МОДА   MKR501                  ,мод.адрес := MKR501
         ЗП     0                       ,по адресу MKR501 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F2B                     ,переход на F2B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2A      УИА    V6(М16)                 ,М16 := адрес V6
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     KLAIDA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F2B      ПБ     F2D                     ,переход на F2D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2C      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2D      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

