***************************************************
* TAMPYK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18912 образа SIPROD.BIN
*   Длина при загрузке: 53 слов, 94 команд
*   Вход: TAMPYK
*   Выход: DOUBLE:STR24J+1, V3 (возврат через М12), V3 (возврат через М10)
*   РАЗБОР ТАБЛИЧНОГО РАЗДЕЛА ПУСКОВ.
*   Внешние: REGIM, SCANER, STR, INS, BEN, DDR, TAMTXT, TARPOZ, RSYMB, 
*   ЦДRБ0
*   Смещения в BEN: 2, 14
*   Смещения в INS: 24, 25
*   Смещения в SCANER: 1, 2
*   Смещения в STR: 24, 25, 26
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 REGIM
*   002 SCANER
*   003 SCANER1
*   004 SCANER2
*   005 STR
*   006 STR24
*   007 STR25
*   008 STR26
*   009 INS
*   010 INS24
*   011 INS25
*   012 BEN
*   013 BEN14
*   014 DDR
*   015 TAMTXT
*   016 TARPOZ
*   017 RSYMB
*   018 ЦДRБ0
*   020 BEN2
*
TAMPYK   СТАРТ  0
         УИА    BEN14A(М16)             ,М16 := BEN14A
BEN14A   ПБ     BEN14H                  ,переход на BEN14H
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   BEN14                   ,мод.адрес +1: BEN14
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         СЧ     '4023'(М7)              ,СМ := '4023'(М7)
         ЗП     3(М7)                   ,3 := СМ
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         СЧ     0                       ,СМ := 0
         ЗП     4(М7)                   ,4 := СМ
         МОДА   DDR                     ,мод.адрес +1: DDR
         СЧ     0                       ,СМ := 0
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         ЗП     0                       ,0 := СМ
BEN14B   РЖА    '22'                    ,РЖ := '22'
         ПВ     ЦДRБ0(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
SCANEA   СЧ     4(М7)                   ,СМ := 4(М7)
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         СЧ     2(М7)                   ,СМ := 2(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   SCANER1                 ,мод.адрес +1: SCANER1
         СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
SCANEB   НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     BEN14B                  ,если СМ=0 → BEN14B
         ПБ     SCANEA                  ,переход на SCANEA
         СЧ     '4023'(М7)              ,СМ := '4023'(М7)
BEN14C   МОДА   BEN14                   ,мод.адрес +1: BEN14
BEN14D   ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         УИА    STR(М16)                ,М16 := STR
BEN14E   СЧИМ   М16                     ,стек := М16, СМ := М16
BEN14F   УИА    STR26(М16)              ,М16 := STR26
BEN14G   СЧИМ   М16                     ,стек := М16, СМ := М16
BEN14H   УИА    V3(М16)                 ,М16 := V3
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V2B(М16)                ,М16 := V2B
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
V2       МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
V2A      СЧ     '4023'(М7)              ,СМ := '4023'(М7)
V2B      СЧИМ                           ,СЧИ + магазин
         СЧ     3(М7)                   ,СМ := 3(М7)
V3       НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     SCANEB                  ,если СМ≠0 → SCANEB
         ПБ     BEN14D                  ,переход на BEN14D
         СЧ     '4023'(М7)              ,СМ := '4023'(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   BEN14                   ,мод.адрес +1: BEN14
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     BEN14C                  ,если СМ=0 → BEN14C
         ПБ     BEN14D                  ,переход на BEN14D
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     BEN14G                  ,переход на BEN14G
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     TARPOZ(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М7)                   ,СМ := 0(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   BEN2                    ,мод.адрес +1: BEN2
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     BEN14E                  ,если СМ=0 → BEN14E
         ПБ     BEN14F                  ,переход на BEN14F
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     BEN14G                  ,переход на BEN14G
         МОДА   0                       ,мод.адрес +1: 0
