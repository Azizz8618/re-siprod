***************************************************
* TAMPYK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18912 образа SIPROD.BIN
*   Длина при загрузке: 53 слов, 94 команд
*   Вход: TAMPYK
*   Выход: DOUBLE:NDAB1A, F0B (возврат через М12), F0C (возврат через М10)
*   РАЗБОР ТАБЛИЧНОГО РАЗДЕЛА ПУСКОВ.
*   Внешние: REGIM, SCANER, STR, INS, BEN, DDR, TAMTXT, TARPOZ, RSYMB, 
*   ЦДRБ0
*   Смещения в BEN: 2, 14
*   Смещения в INS: 24, 25
*   Смещения в SCANER: 1, 2
*   Смещения в STR: 24, 25, 26
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-4, 10, вне кадра 2067
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 REGIM
*   002 SCANER
*   003 SCANER1
*   004 SCANER2
*   005 STR
*   006 STR24
*   007 STR25
*   008 STR26
*   009 INS
*   010 INS24
*   011 INS25
*   012 BEN
*   013 BEN14
*   014 DDR
*   015 TAMTXT
*   016 TARPOZ
*   017 RSYMB
*   018 ЦДRБ0
*   019 N1
*   020 BEN2
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К1     60    6400000000000000
*   К2     61    6400000000000006
*   V0     63
*
*** КОД МОДУЛЯ
*
TAMPYK   СТАРТ  0
         УИА    BEN14A(М16)             ,М16 := адрес BEN14A
         ПБ     F0B                     ,переход на F0B
*
BEN14A   СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   BEN14                   ,мод.адрес := BEN14
         ЗП     0                       ,по адресу BEN14 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     '4023'(М7)              ,СМ := каталог задачи: элемент 19
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         МОДА   DDR                     ,мод.адрес := DDR
         СЧ     0                       ,СМ := слово по адресу DDR
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ЦДRБ0(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     4(М7)                   ,СМ := слот кадра 4
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     2(М7)                   ,СМ := слот кадра 2
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     BEN14B                  ,если СМ=0 → BEN14B
         ПБ     BEN14C                  ,переход на BEN14C
*
BEN14B   СЧ     '4023'(М7)              ,СМ := каталог задачи: элемент 19
         МОДА   BEN14                   ,мод.адрес := BEN14
         ЗП     0                       ,по адресу BEN14 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
BEN14C   УИА    STR(М16)                ,М16 := адрес STR
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    STR26(М16)              ,М16 := адрес STR26
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     '4023'(М7)              ,СМ := каталог задачи: элемент 19
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     3(М7)                   ,СМ := слот кадра 3
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     BEN14D                  ,если СМ≠0 → BEN14D
         ПБ     TARPOA                  ,переход на TARPOA
*
BEN14D   СЧ     '4023'(М7)              ,СМ := каталог задачи: элемент 19
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   BEN14                   ,мод.адрес := BEN14
         СЧ     0                       ,СМ := слово по адресу BEN14
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F3                      ,если СМ=0 → F3
         ПБ     TARPOA                  ,переход на TARPOA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3       ПБ     F0A                     ,переход на F0A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
TARPOA   ПВ     TARPOZ(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   BEN2                    ,мод.адрес := BEN2
         СЧ     0                       ,СМ := слово по адресу BEN2
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F0                      ,если СМ=0 → F0
         ПБ     TAMTXA                  ,переход на TAMTXA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0       ПБ     F0A                     ,переход на F0A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
TAMTXA   ПВ     TAMTXT(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0A      ПБ     F0C                     ,переход на F0C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0B      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0C      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

