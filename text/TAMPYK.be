***************************************************
* TAMPYK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18912 образа SIPROD.BIN
*   Длина при загрузке: 53 слов, 94 команд
*   Вход: TAMPYK
*   Внешние: REGIM, SCANER, STR, INS, BEN, DDR, TAMTXT, TARPOZ, RSYMB, 
*   ЦДRБ0
*   Смещения в BEN: 2, 14
*   Смещения в INS: 24, 25
*   Смещения в SCANER: 1, 2
*   Смещения в STR: 24, 25, 26
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 REGIM
*   002 SCANER
*   003 SCANER1
*   004 SCANER2
*   005 STR
*   006 STR24
*   007 STR25
*   008 STR26
*   009 INS
*   010 INS24
*   011 INS25
*   012 BEN
*   013 BEN14
*   014 DDR
*   015 TAMTXT
*   016 TARPOZ
*   017 RSYMB
*   018 ЦДRБ0
*   020 BEN2
*
TAMPYK   СТАРТ  0
         УИА    BEN14A(М16)             ,М16 := BEN14A
BEN14A   ПБ     RSYMBA                  ,переход на RSYMBA
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   BEN14                   ,мод.адрес +1: BEN14
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         СЧ     '4023'(М7)              ,СМ := '4023'(М7)
         ЗП     3(М7)                   ,3 := СМ
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         СЧ     0                       ,СМ := 0
         ЗП     4(М7)                   ,4 := СМ
         МОДА   DDR                     ,мод.адрес +1: DDR
         СЧ     0                       ,СМ := 0
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         ЗП     0                       ,0 := СМ
ЦДRБ0A   РЖА    '22'                    ,РЖ := '22'
         ПВ     ЦДRБ0(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
SCANEA   СЧ     4(М7)                   ,СМ := 4(М7)
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         СЧ     2(М7)                   ,СМ := 2(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   SCANER1                 ,мод.адрес +1: SCANER1
         СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
L0033    НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     ЦДRБ0A                  ,если СМ=0 → ЦДRБ0A
         ПБ     SCANEA                  ,переход на SCANEA
         СЧ     '4023'(М7)              ,СМ := '4023'(М7)
BEN14B   МОДА   BEN14                   ,мод.адрес +1: BEN14
V2       ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         УИА    STR(М16)                ,М16 := STR
L0045    СЧИМ   М16                     ,стек := М16, СМ := М16
L0046    УИА    STR26(М16)              ,М16 := STR26
L0047    СЧИМ   М16                     ,стек := М16, СМ := М16
RSYMBA   УИА    TARPOA(М16)             ,М16 := TARPOA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    L0061(М16)              ,М16 := L0061
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
V2A      МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
L0060    СЧ     '4023'(М7)              ,СМ := '4023'(М7)
L0061    СЧИМ                           ,СЧИ + магазин
         СЧ     3(М7)                   ,СМ := 3(М7)
TARPOA   НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     L0033                   ,если СМ≠0 → L0033
         ПБ     V2                      ,переход на V2
         СЧ     '4023'(М7)              ,СМ := '4023'(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   BEN14                   ,мод.адрес +1: BEN14
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     BEN14B                  ,если СМ=0 → BEN14B
         ПБ     V2                      ,переход на V2
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     L0047                   ,переход на L0047
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     TARPOZ(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М7)                   ,СМ := 0(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   BEN2                    ,мод.адрес +1: BEN2
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     L0045                   ,если СМ=0 → L0045
         ПБ     L0046                   ,переход на L0046
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     L0047                   ,переход на L0047
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     TAMTXT(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     V2A                     ,переход на V2A
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    L0060(М7)               ,М7 := L0060
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

