***************************************************
* RSYMB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5280 образа SIPROD.BIN
*   Длина при загрузке: 38 слов, 76 команд
*   Вход: RSYMB
*   Внешние: KONSTA, SYTOBIN
*   Смещения в SYTOBIN: 1, 2, 3, 4, 5
*   Регистры: М6, М7, М10, М11, М12, М13, М14, М15, М16, М17
***************************************************
RSYMB   СТАРТ  0
        СЧИМ   М7                       ,стек := М7, СМ := М7
        СЧИМ   М15                      ,стек := М15, СМ := М15
        ПВ     KONSTA(М15)              ,вызов через М15
        МОДА   RSYMB                    ,мод.адрес +1: RSYMB
        ЗПМ    9(М12)                   ,ЗП + магазин: 9(М12)
        ЗПМ    12(М12)                  ,ЗП + магазин: 12(М12)
        УИМ    М13                      ,М13 := СМ + стек
        УИ     М16                      ,М16 := СМ
        СЧ     RSYMB(М13)               ,СМ := RSYMB(М13)
SYTOBI  ПВ     SYTOBIN+5(М15)           ,вызов через М15
        СЛИ    М16(М7)                  ,М16 += М7
L0013   СЧИ    М7                       ,СМ := М7
        СЛИА   СИМ10(М11)               ,М11 += СИМ10
        И      4(М10)                   ,СМ &= 4(М10)
        ПО     SYTOBI                   ,если СМ=0 → SYTOBI
        СЛИА   СИМ11(М17)               ,М17 += СИМ11
        ПБ     SYTOBA                   ,переход на SYTOBA
SYTOBA  МОДА   RSYMB                    ,мод.адрес +1: RSYMB
        УИИ    М13(М11)                 ,М13 := М11
        СЧ     RSYMB(М17)               ,СМ := RSYMB(М17)
        УИМ    М11                      ,М11 := СМ + стек
        УИ     М14                      ,М14 := СМ
        СЧ     RSYMB(М11)               ,СМ := RSYMB(М11)
        ПВ     SYTOBIN+5(М15)           ,вызов через М15
        СЧИ    М11                      ,СМ := М11
        СЛИ    М14(М7)                  ,М14 += М7
        ВЧОБ   RSYMB                    ,СМ := (адрес) - СМ
        УИ     М11                      ,М11 := СМ
        СЧИ    М7                       ,СМ := М7
SYTOBB  И      4(М10)                   ,СМ &= 4(М10)
        ПЕ     SYTOBA                   ,если СМ≠0 → SYTOBA
        ПВ     SYTOBIN+1(М15)           ,вызов через М15
        ПВ     SYTOBIN+2(М15)           ,вызов через М15
L0041   МОДА   RSYMB                    ,мод.адрес +1: RSYMB
        СЧ     12(М12)                  ,СМ := 12(М12)
KONSTA  УИМ    М7                       ,М7 := СМ + стек
        РЖА    '6'                      ,РЖ := '6'
        МОД    9(М12)                   ,мод.адрес по коду: 9(М12)
        ПБ     RSYMB                    ,переход на RSYMB
        МОДА   RSYMB                    ,мод.адрес +1: RSYMB
        СЧИМ   М15                      ,стек := М15, СМ := М15
        ПВ     KONSTA(М15)              ,вызов через М15
        УИМ    М15                      ,М15 := СМ + стек
        РЖА    '3'                      ,РЖ := '3'
        УИ     М11                      ,М11 := СМ
        СЧ     RSYMB(М11)               ,СМ := RSYMB(М11)
        ВЧОБ   3(М10)                   ,СМ := (адрес) - СМ
        ПО     L0041                    ,если СМ=0 → L0041
        СЧИМ   М6                       ,стек := М6, СМ := М6
        СЧИМ   М15                      ,стек := М15, СМ := М15
        ЗПМ    10(М12)                  ,ЗП + магазин: 10(М12)
        ЗПМ    13(М12)                  ,ЗП + магазин: 13(М12)
        УИМ    М6                       ,М6 := СМ + стек
        СЛИА   1(М6)                    ,М6 += 1
        ПВ     RSYMB(М15)               ,вызов через М15
        МОДА   RSYMB                    ,мод.адрес +1: RSYMB
        СЛИА   1(М17)                   ,М17 += 1
        МОДА   RSYMB                    ,мод.адрес +1: RSYMB
        ПИО    KONSTA(М6)               ,если ИР=0 → KONSTA(М6)
        ПВ     SYTOBIN+1(М15)           ,вызов через М15
        СЛИА   1(М6)                    ,М6 += 1
        ПВ     SYTOBIN+2(М15)           ,вызов через М15
        ПБ     SYTOBB                   ,переход на SYTOBB
        МОДА   RSYMB                    ,мод.адрес +1: RSYMB
        ПБ     RSYMB(М15)               ,переход через М15
        МОДА   RSYMB                    ,мод.адрес +1: RSYMB
        СЛИА   СИМ12(М17)               ,М17 += СИМ12
        СЧ     RSYMB(М17)               ,СМ := RSYMB(М17)
        ПБ     RSYMB(М15)               ,переход через М15
        МОДА   RSYMB                    ,мод.адрес +1: RSYMB
        СЧМ    13(М12)                  ,магазин + СЧ: 13(М12)
        СЧМ    10(М12)                  ,магазин + СЧ: 10(М12)
        УИМ    М15                      ,М15 := СМ + стек
        УИМ    М6                       ,М6 := СМ + стек
        СЧ     RSYMB(М17)               ,СМ := RSYMB(М17)
        ПБ     RSYMB(М15)               ,переход через М15

