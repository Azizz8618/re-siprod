***************************************************
* RSYMB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5280 образа SIPROD.BIN
*   Длина при загрузке: 38 слов, 76 команд
*   Вход: RSYMB
*   Выход: ADRSEK:LYG4A, ADRSEK:LYG4A, BEGPG:EGO32D, BEGPG:EGO32D, 
*   BEGPG:PAGE3C, BEGPG:REGIMG, BEGPG:APJC, DOUBLE:F14, FILL:STR24C, 
*   GETSTR:INS26C, GETSTR:INS25A, HOWSMB:WHO1A, KODKOD:L0074, KODKOD:L0074, 
*   KOKSON:ADR1A, KOKSON:ADRC, NUSTA:NDAB1A, ONESTR:F9, PAPRAP:F28, 
*   PAPRAP:COMCOA, PAPRAP:F20A, PAPRAP:EGO86H, PAPRAP:F32, PAPRAP:SCANEC, 
*   PAPRAP:EGO86L, PAPRAP:INS26D, PILDYK:F1A, RASTXT:F2, RASTXT:F2, 
*   RASTXT:STR24C, RMAKR:F13, SCAN:F9, SEGTAB:F23, SEGTAB:STR24A, 
*   SPAUD:LOOP, SPAUD:SCAN04, SPAUD:F1E, SPAUD:F45, SPAUD:F58, 
*   SPAUD:SCAN46, SPAUD:STR26F, SPAUD:REGIMZ, STAATP:F9, STAATP:F7A, 
*   SYTINT:F2B, SYTINT:F2F, TAMPYK:BEN14D, TAMTXT:STR26A, TAMTXT:F11, 
*   TAMTXT:F11A, TAMTXT:F16, TARPOZ:F8, TARPOZ:F9, TARPOZ:STR26A, 
*   TARPOZ:BEN13A, TITLE:F9, TITLE:F9A, TITLE:F9B, TOKREZ:F10, 
*   TOPAGE:STR26A, WHATYP:F16, WRITUR:FOR6A, WRITUR:EGO413, WRITUR:FOR6B, 
*   L9 (возврат через ячейка 0), LOOP (возврат через М15), 
*   INC (возврат через М15), PUSH (возврат через М15)
*   РАЗБОР СИМВОЛА (КОД СИМВОЛА ИЗ ТЕКСТА).
*   Внешние: KONSTA, SYTOBI
*   Смещения в SYTOBI: 1, 2, 3, 4, 5
*   Абсолютные символы: N2 = -2, N4 = -4, N7 = -7
*   Смещения в кадре (М7): свои 14, 16
*   Регистры: М6 (рабочий регистр), М7 (указатель кадра), 
*   М10 (блок вызывающего), М11 (буфер, счётчик), 
*   М12 (магазин, кадр параметров ОС), М13 (счётчик), 
*   М14 (смещение в буфере), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 KONSTA
*   002 SYTOBI
*   003 SYTOBI1
*   004 SYTOBI2
*   005 SYTOBI3
*   006 SYTOBI4
*   007 SYTOBI5
*   008 N7
*   009 N2
*   010 N4
*
*** КОД МОДУЛЯ
*
RSYMB    СТАРТ  0
         СЧИМ   М7                      ,в магазин; СМ := М7
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         УИ     М16                     ,М16 := СМ
         СЧ     0(М13)                  ,СМ := смещение в буфере 0
         ПВ     SYTOBI5(М15)            ,вызов через М15
         СЛИ    М16(М7)                 ,М16 += М7
         СЧИ    М7                      ,СМ := М7
         СЛИА   N7(М11)                 ,М11 += N7
         И      4(М10)                  ,СМ &= поле блока вызывающего 4
         ПО     L0022                   ,если СМ=0 → L0022
         СЛИА   N2(М17)                 ,М17 += N2
         ПБ     L9                      ,переход на L9
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L0022    УИИ    М13(М11)                ,М13 := М11
         СЧ     0(М17)                  ,СМ := поле контекста 0
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИ     М14                     ,М14 := СМ
         СЧ     0(М11)                  ,СМ := смещение в буфере 0
         ПВ     SYTOBI5(М15)            ,вызов через М15
         СЧИ    М11                     ,СМ := М11
         СЛИ    М14(М7)                 ,М14 += М7
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИ     М11                     ,М11 := СМ
         СЧИ    М7                      ,СМ := М7
         И      4(М10)                  ,СМ &= поле блока вызывающего 4
         ПЕ     L9                      ,если СМ≠0 → L9
         ПВ     SYTOBI1(М15)            ,вызов через М15
         ПВ     SYTOBI2(М15)            ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L9       СЧ     12(М12)                 ,СМ := параметр вызова ОС 12
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         УИМ    М15                     ,М15 := СМ; СМ := из магазина
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         УИ     М11                     ,М11 := СМ
         СЧ     0(М11)                  ,СМ := смещение в буфере 0
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         ПО     INC                     ,если СМ=0 → INC
         СЧИМ   М6                      ,в магазин; СМ := М6
         СЧИМ   М15                     ,в магазин; СМ := М15
         ЗПМ    10(М12)                 ,ЗП + магазин: 10(М12)
         ЗПМ    13(М12)                 ,ЗП + магазин: 13(М12)
         УИМ    М6                      ,М6 := СМ; СМ := из магазина
         СЛИА   1(М6)                   ,М6 += 1
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЛИА   1(М17)                  ,М17 += 1
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LOOP     ПИО    PUSH(М6)                ,если ИР=0 → PUSH(М6)
         ПВ     SYTOBI1(М15)            ,вызов через М15
         СЛИА   1(М6)                   ,М6 += 1
         ПВ     SYTOBI2(М15)            ,вызов через М15
         ПБ     LOOP                    ,переход на LOOP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
INC      СЛИА   N4(М17)                 ,М17 += N4
         СЧ     0(М17)                  ,СМ := поле контекста 0
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUSH     СЧМ    13(М12)                 ,магазин + СЧ: 13(М12)
         СЧМ    10(М12)                 ,магазин + СЧ: 10(М12)
         УИМ    М15                     ,М15 := СМ; СМ := из магазина
         УИМ    М6                      ,М6 := СМ; СМ := из магазина
         СЧ     0(М17)                  ,СМ := поле контекста 0
         ПБ     0(М15)                  ,переход через М15
*

