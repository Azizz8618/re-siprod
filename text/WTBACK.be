***************************************************
* WTBACK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18816 образа SIPROD.BIN
*   Длина при загрузке: 54 слов, 98 команд
*   Вход: WTBACK
*   Внешние: PUS, REGIM, STR
*   Смещения в STR: 24, 25, 26
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 PUS
*   002 REGIM
*   003 STR
*   004 STR24
*   005 STR25
*   006 STR26
*
WTBACK   СТАРТ  0
         УИА    REGIMA(М16)             ,М16 := REGIMA
REGIMA   ПБ     STR25E                  ,переход на STR25E
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   REGIM                   ,мод.адрес +1: REGIM
REGIMB   СЧ     0                       ,СМ := 0
REGIMC   НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     REGIMB                  ,если СМ≠0 → REGIMB
         ПБ     REGIMC                  ,переход на REGIMC
         МОДА   0                       ,мод.адрес +1: 0
PUSA     ПБ     STR25D                  ,переход на STR25D
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М7)                   ,СМ := 0(М7)
         СЧИМ                           ,СЧИ + магазин
PUSB     МОДА   PUS                     ,мод.адрес +1: PUS
PUSC     СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     PUSA                    ,если СМ=0 → PUSA
         ПБ     PUSC                    ,переход на PUSC
STR25A   МОДА   0                       ,мод.адрес +1: 0
         МОДА   STR25                   ,мод.адрес +1: STR25
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
STR25B   ВЧ     3(М7)                   ,СМ -= 3(М7)
STR25C   РЖА    '22'                    ,РЖ := '22'
         ПЕ     PUSB                    ,если СМ≠0 → PUSB
         ПБ     PUSC                    ,переход на PUSC
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     STR25D                  ,переход на STR25D
         МОДА   0                       ,мод.адрес +1: 0
PUSD     СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   PUS                     ,мод.адрес +1: PUS
PUSE     СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     STR25A                  ,если СМ=0 → STR25A
         ПБ     STR25C                  ,переход на STR25C
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   STR25                   ,мод.адрес +1: STR25
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
STR25D   ВЧ     3(М7)                   ,СМ -= 3(М7)
STR25E   РЖА    '22'                    ,РЖ := '22'
         ПО     STR25B                  ,если СМ=0 → STR25B
         ПБ     STR25C                  ,переход на STR25C
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     STR25D                  ,переход на STR25D
PUSF     МОДА   0                       ,мод.адрес +1: 0
         СЧ     2(М7)                   ,СМ := 2(М7)
PUSG     ЗП     4(М7)                   ,4 := СМ
         РЖА    '3'                     ,РЖ := '3'
         СЧ     0(М7)                   ,СМ := 0(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   PUS                     ,мод.адрес +1: PUS
         СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     PUSD                    ,если СМ=0 → PUSD
         ПБ     PUSE                    ,переход на PUSE
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     2(М7)                   ,СМ := 2(М7)
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         ЗП     4(М7)                   ,4 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   STR25                   ,мод.адрес +1: STR25
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     4(М7)                   ,СМ += 4(М7)
         МОДА   STR25                   ,мод.адрес +1: STR25
         ЗП     0                       ,0 := СМ
         МОДА   STR26                   ,мод.адрес +1: STR26
         СЧ     0                       ,СМ := 0
         СЛ     4(М7)                   ,СМ += 4(М7)
         МОДА   STR26                   ,мод.адрес +1: STR26
         ЗП     0                       ,0 := СМ
         МОДА   STR25                   ,мод.адрес +1: STR25
         СЧ     0                       ,СМ := 0
         МОДА   STR24                   ,мод.адрес +1: STR24
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     PUSF                    ,переход на PUSF
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    PUSG(М7)                ,М7 := PUSG
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

