***************************************************
* WTBACK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18816 образа SIPROD.BIN
*   Длина при загрузке: 54 слов, 98 команд
*   Вход: WTBACK
*   Выход: BEGPG:PAGE3D, RASTXT:STR25A, F2 (возврат через М12), 
*   F2A (возврат через М10)
*   Внешние: PUS, REGIM, STR
*   Смещения в STR: 24, 25, 26
*   Смещения в кадре (М7): общие 0-4, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 PUS
*   002 REGIM
*   003 STR
*   004 STR24
*   005 STR25
*   006 STR26
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     61    6400000000000000
*
*** КОД МОДУЛЯ
*
WTBACK   СТАРТ  0
         УИА    REGIMA(М16)             ,М16 := адрес REGIMA
         ПБ     F2                      ,переход на F2
*
REGIMA   СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   REGIM                   ,мод.адрес := REGIM
         СЧ     0                       ,СМ := слово по адресу REGIM
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     PUSA                    ,если СМ≠0 → PUSA
         ПБ     PUSB                    ,переход на PUSB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUSA     ПБ     STR25E                  ,переход на STR25E
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUSB     СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   PUS                     ,мод.адрес := PUS
         СЧ     0                       ,СМ := слово по адресу PUS
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     STR25A                  ,если СМ=0 → STR25A
         ПБ     PUSD                    ,переход на PUSD
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR25A   МОДА   STR25                   ,мод.адрес := STR25
         СЧ     0                       ,СМ := слово по адресу STR25
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     3(М7)                   ,СМ -= слот кадра 3
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     PUSC                    ,если СМ≠0 → PUSC
         ПБ     PUSD                    ,переход на PUSD
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUSC     ПБ     STR25E                  ,переход на STR25E
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUSD     СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   PUS                     ,мод.адрес := PUS
         СЧ     0                       ,СМ := слово по адресу PUS
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     STR25B                  ,если СМ=0 → STR25B
         ПБ     PUSF                    ,переход на PUSF
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR25B   МОДА   STR25                   ,мод.адрес := STR25
         СЧ     0                       ,СМ := слово по адресу STR25
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     3(М7)                   ,СМ -= слот кадра 3
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     PUSE                    ,если СМ=0 → PUSE
         ПБ     PUSF                    ,переход на PUSF
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUSE     ПБ     STR25E                  ,переход на STR25E
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUSF     СЧ     2(М7)                   ,СМ := слот кадра 2
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   PUS                     ,мод.адрес := PUS
         СЧ     0                       ,СМ := слово по адресу PUS
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     STR25C                  ,если СМ=0 → STR25C
         ПБ     STR25D                  ,переход на STR25D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR25C   СЧ     2(М7)                   ,СМ := слот кадра 2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR25D   МОДА   STR25                   ,мод.адрес := STR25
         СЧ     0                       ,СМ := слово по адресу STR25
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     4(М7)                   ,СМ += слот кадра 4
         МОДА   STR25                   ,мод.адрес := STR25
         ЗП     0                       ,по адресу STR25 := СМ
         МОДА   STR26                   ,мод.адрес := STR26
         СЧ     0                       ,СМ := слово по адресу STR26
         СЛ     4(М7)                   ,СМ += слот кадра 4
         МОДА   STR26                   ,мод.адрес := STR26
         ЗП     0                       ,по адресу STR26 := СМ
         МОДА   STR25                   ,мод.адрес := STR25
         СЧ     0                       ,СМ := слово по адресу STR25
         МОДА   STR24                   ,мод.адрес := STR24
         ЗП     0                       ,по адресу STR24 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
STR25E   ПБ     F2A                     ,переход на F2A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2A      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

