***************************************************
* TXTRED - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 16160 образа SIPROD.BIN
*   Длина при загрузке: 38 слов, 64 команд
*   Вход: TXTRED
*   Выход: PAPRAP:EGO86F, F5 (возврат через М12), POP (возврат через М10)
*   Внешние: RPT, EGO, RUSIS, SPAUD
*   Смещения в EGO: 7200, 8600, 8601
*   Смещения в кадре (М7): общие 0-2, 5, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 RPT
*   002 EGO
*   003 EGO7200
*   004 EGO8600
*   005 EGO8601
*   006 RUSIS
*   007 SPAUD
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     40    6400000000000000
*   V0     43
*   V1     44
*   V2     45
*
*** КОД МОДУЛЯ
*
TXTRED   СТАРТ  0
         УИА    RPTA(М16)               ,М16 := адрес RPTA
         ПБ     F5                      ,переход на F5
*
RPTA     МОД    V2                      ,мод.адрес := код из V2
         СЧ     0                       ,СМ := слово по адресу V2
         МОДА   RPT                     ,мод.адрес := RPT
         ЗП     0                       ,по адресу RPT := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   RPT                     ,мод.адрес := RPT
         СЧ     0                       ,СМ := слово по адресу RPT
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     2(М7)                   ,СМ += слот кадра 2
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     RPTB                    ,если СМ≠0 → RPTB
         ПБ     RPTC                    ,переход на RPTC
*
RPTB     СЧ     2(М7)                   ,СМ := слот кадра 2
         МОДА   RPT                     ,мод.адрес := RPT
         ЗП     0                       ,по адресу RPT := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
RPTC     СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   RUSIS                   ,мод.адрес := RUSIS
         ЗП     0                       ,по адресу RUSIS := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
RPTD     УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     SPAUD(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   EGO8600                 ,мод.адрес := EGO8600
         СЧ     0                       ,СМ := слово по адресу EGO8600
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     0(М7)                   ,СМ += слот кадра 0
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     RUSISA                  ,если СМ≠0 → RUSISA
         ПБ     RUSISB                  ,переход на RUSISB
*
RUSISA   ПБ     RPTD                    ,переход на RPTD
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
RUSISB   СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   RUSIS                   ,мод.адрес := RUSIS
         ЗП     0                       ,по адресу RUSIS := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     POP                     ,переход на POP
*
F5       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         ЗПМ    5(М7)                   ,ЗП + магазин: 5(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

