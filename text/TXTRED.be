***************************************************
* TXTRED - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 16160 образа SIPROD.BIN
*   Длина при загрузке: 38 слов, 64 команд
*   Вход: TXTRED
*   Внешние: *RPT*, *EGO*, *RUSIS*, SPAUD
*   Смещения в *EGO*: 7200, 8600, 8601
*   Регистры: М7, М10, М12, М15, М16
***************************************************
TXTRED  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     V1                       ,переход на V1
L0045   МОД    RUSIS2                   ,мод.адрес по коду: RUSIS2
        СЧ     TXTRED                   ,СМ := TXTRED
        МОДА   *RPT*                    ,мод.адрес +1: *RPT*
        ЗП     TXTRED                   ,TXTRED := СМ
        РЖА    '3'                      ,РЖ := '3'
RPT     МОДА   *RPT*                    ,мод.адрес +1: *RPT*
L0010   СЧ     TXTRED                   ,СМ := TXTRED
        ВЧОБ   TXTRED                   ,СМ := (адрес) - СМ
L0012   СЛ     L0045(М7)                ,СМ += L0045(М7)
        РЖА    '22'                     ,РЖ := '22'
        ПЕ     RPT                      ,если СМ≠0 → RPT
RPT2    ПБ     L0012                    ,переход на L0012
        СЧ     2(М7)                    ,СМ := 2(М7)
        МОДА   *RPT*                    ,мод.адрес +1: *RPT*
        ЗП     TXTRED                   ,TXTRED := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОДА   TXTRED                   ,мод.адрес +1: TXTRED
        СЧ     1(М7)                    ,СМ := 1(М7)
RUSIS   МОДА   *RUSIS*                  ,мод.адрес +1: *RUSIS*
L0026   ЗП     TXTRED                   ,TXTRED := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
V1      МОДА   TXTRED                   ,мод.адрес +1: TXTRED
        УИА    L0043(М16)               ,М16 := L0043
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0044(М16)               ,М16 := L0044
        СЧИМ   М16                      ,стек := М16, СМ := М16
SPAUD   ПВ     SPAUD(М15)               ,вызов через М15
        МОДА   TXTRED                   ,мод.адрес +1: TXTRED
EGO206  РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОДА   *EGO*+20630              ,мод.адрес +1: *EGO*+20630
L0043   СЧ     TXTRED                   ,СМ := TXTRED
L0044   РЖА    '3'                      ,РЖ := '3'
RUSIS2  ВЧОБ   TXTRED                   ,СМ := (адрес) - СМ
        СЛ     TXTRED(М7)               ,СМ += TXTRED(М7)
        РЖА    '22'                     ,РЖ := '22'
        ПЕ     RUSIS                    ,если СМ≠0 → RUSIS
        ПБ     L0026                    ,переход на L0026
        ПБ     RPT2                     ,переход на RPT2
        МОДА   TXTRED                   ,мод.адрес +1: TXTRED
        СЧ     TXTRED(М7)               ,СМ := TXTRED(М7)
        МОДА   *RUSIS*                  ,мод.адрес +1: *RUSIS*
        ЗП     TXTRED                   ,TXTRED := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПБ     SPAUD                    ,переход на SPAUD
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    EGO206(М7)               ,М7 := EGO206
        ЗПМ    5(М7)                    ,ЗП + магазин: 5(М7)
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     TXTRED(М12)              ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     TXTRED(М10)              ,переход через М10

