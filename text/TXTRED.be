***************************************************
* TXTRED - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 16160 образа SIPROD.BIN
*   Длина при загрузке: 38 слов, 64 команд
*   Вход: TXTRED
*   Выход: смещение 73, через М12, смещение 77, через М10
*   Внешние: RPT, EGO, RUSIS, SPAUD
*   Смещения в EGO: 7200, 8600, 8601
*   Регистры: М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 RPT
*   002 EGO
*   003 EGO7200
*   004 EGO8600
*   005 EGO8601
*   006 RUSIS
*   007 SPAUD
*
TXTRED   СТАРТ  0
         УИА    RPTA(М16)               ,М16 := RPTA
RPTA     ПБ     RPTG                    ,переход на RPTG
         МОД    EGO86C                  ,мод.адрес по коду: EGO86C
         СЧ     0                       ,СМ := 0
         МОДА   RPT                     ,мод.адрес +1: RPT
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
RPTB     МОДА   RPT                     ,мод.адрес +1: RPT
         СЧ     0                       ,СМ := 0
         ВЧОБ   0                       ,СМ := (адрес) - СМ
RPTC     СЛ     2(М7)                   ,СМ += 2(М7)
         РЖА    '22'                    ,РЖ := '22'
         ПЕ     RPTB                    ,если СМ≠0 → RPTB
RPTD     ПБ     RPTC                    ,переход на RPTC
         СЧ     2(М7)                   ,СМ := 2(М7)
         МОДА   RPT                     ,мод.адрес +1: RPT
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
RPTE     МОДА   RUSIS                   ,мод.адрес +1: RUSIS
RPTF     ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
RPTG     МОДА   0                       ,мод.адрес +1: 0
         УИА    EGO86A(М16)             ,М16 := EGO86A
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    EGO86B(М16)             ,М16 := EGO86B
         СЧИМ   М16                     ,стек := М16, СМ := М16
SPAUDA   ПВ     SPAUD(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
EGO860   РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОДА   EGO8600                 ,мод.адрес +1: EGO8600
EGO86A   СЧ     0                       ,СМ := 0
EGO86B   РЖА    '3'                     ,РЖ := '3'
EGO86C   ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     0(М7)                   ,СМ += 0(М7)
         РЖА    '22'                    ,РЖ := '22'
         ПЕ     RPTE                    ,если СМ≠0 → RPTE
         ПБ     RPTF                    ,переход на RPTF
         ПБ     RPTD                    ,переход на RPTD
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   RUSIS                   ,мод.адрес +1: RUSIS
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     SPAUDA                  ,переход на SPAUDA
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    EGO860(М7)              ,М7 := EGO860
         ЗПМ    5(М7)                   ,ЗП + магазин: 5(М7)
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

