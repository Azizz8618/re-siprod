***************************************************
* WRILIN - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 7552 образа SIPROD.BIN
*   Длина при загрузке: 102 слов, 172 команд
*   Вход: WRILIN
*   Выход: WRITEH:F0B, F7D (возврат через М12), F7E (возврат через М10)
*   Внешние: PAGE, CEN, WHO, ONE, NUM, KOMA, KLAIDA, ENDKOR, HOWSMB, RASPS, 
*   WRIKOR, ONESTR, IDII
*   Смещения в KOMA: 2, 7
*   Смещения в NUM: 2, 3
*   Смещения в ONE: 1, 2
*   Смещения в PAGE: 3, 4, 5
*   Смещения в WHO: 1
*   Смещения в кадре (М7): общие 0-2, 7, 9-10, свои 11-12
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 PAGE
*   002 CEN
*   003 WHO
*   004 WHO1
*   005 ONE
*   006 ONE1
*   007 ONE2
*   008 NUM
*   009 NUM2
*   010 NUM3
*   011 KOMA
*   012 KOMA2
*   013 KOMA7
*   014 KLAIDA
*   015 ENDKOR
*   016 HOWSMB
*   017 RASPS
*   018 WRIKOR
*   019 ONESTR
*   020 IDII
*   021 PAGE3
*   022 PAGE4
*   023 PAGE5
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     126
*   К1     127
*   К2     130
*   К3     131
*   К4     132
*   К5     133
*   К6     134
*   К7     135
*   V3     142
*   V4     143
*   V5     144
*   V6     145
*
*** КОД МОДУЛЯ
*
WRILIN   СТАРТ  0
         УИА    ONE1A(М16)              ,М16 := адрес ONE1A
         ПБ     F7D                     ,переход на F7D
*
ONE1A    МОДА   ONE1                    ,мод.адрес := ONE1
         СЧ     0                       ,СМ := слово по адресу ONE1
         УИА    К3(М16)                 ,М16 := адрес К3
         ПВ     IDII(М15)               ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   ONE                     ,мод.адрес := ONE
         СЛ     0                       ,СМ += слово по адресу ONE
         МОДА   CEN                     ,мод.адрес := CEN
         ЗП     0                       ,по адресу CEN := СМ
         МОДА   PAGE3                   ,мод.адрес := PAGE3
         СЧ     0                       ,СМ := слово по адресу PAGE3
         МОДА   PAGE4                   ,мод.адрес := PAGE4
         СЛ     0                       ,СМ += слово по адресу PAGE4
         МОДА   PAGE5                   ,мод.адрес := PAGE5
         СЛ     0                       ,СМ += слово по адресу PAGE5
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ONESTR(М15)             ,вызов через М15
         МОДА   PAGE3                   ,мод.адрес := PAGE3
         СЧ     0                       ,СМ := слово по адресу PAGE3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   ONE2                    ,мод.адрес := ONE2
         СЛ     0                       ,СМ += слово по адресу ONE2
         СЛ     2(М7)                   ,СМ += слот кадра 2
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         СЧ     9(М7)                   ,СМ := слот кадра 9
         УИА    К3(М16)                 ,М16 := адрес К3
         ПВ     IDII(М15)               ,вызов через М15
         ВЧ     10(М7)                  ,СМ -= слот кадра 10
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         СЧ     11(М7)                  ,СМ := слот кадра 11
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     0(М7)                   ,СМ += слот кадра 0
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F11                     ,если СМ≠0 → F11
         ПБ     F7                      ,переход на F7
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F11      ПБ     F7A                     ,переход на F7A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F7       СЧ     7(М7)                   ,СМ := слот кадра 7
         ЗП     12(М7)                  ,слот кадра 12 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F7B                     ,переход на F7B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F7A      УИА    KOMA7(М16)              ,М16 := адрес KOMA7
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         УИА    V3(М16)                 ,М16 := адрес V3
         СЧИМ   М16                     ,в магазин; СМ := М16
