***************************************************
* KCOUNT - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6144 образа SIPROD.BIN
*   Длина при загрузке: 10 слов, 18 команд
*   Вход: KCOUNT
*   Выход: PUSH (возврат через М15)
*   Регистры: М11 (буфер, счётчик), М13 (счётчик), М15 (адрес возврата), 
*   М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     11    6400000000000000
*
*** КОД МОДУЛЯ
*
KCOUNT   СТАРТ  0
         УИ     М11                     ,М11 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М11)                  ,СМ := смещение в буфере 0
         МОДА   К0                      ,мод.адрес := К0
         ВЧОБ   0                       ,СМ := слово по адресу К0 - СМ
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИ     М13                     ,М13 := СМ
         СЛИА   1(М11)                  ,М11 += 1
         СЧ     0                       ,СМ := 0
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUSH     СЧМ    0(М13)                  ,магазин + СЧ: 0(М13)
         ЧЕД    0(М17)                  ,СМ := кол-во единиц в поле контекста 
         СЛИА   1(М13)                  ,М13 += 1
         ЦИКЛ   PUSH(М11)               ,М11-- и если ≠0 → повтор
         МОДА   К0                      ,мод.адрес := К0
         ИЛИ    0                       ,СМ |= слово по адресу К0
         ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

