        МОД    9(М12)                   ,мод.адрес по коду: 9(М12)
        ПБ     RINT                     ,переход на RINT
        СЛИА   СИМ10(М17)               ,М17 += СИМ10
        СЧ     8(М10)                   ,СМ := 8(М10)
        ИЛИ    3(М10)                   ,СМ |= 3(М10)
