***************************************************
* RINT - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5472 образа SIPROD.BIN
*   Длина при загрузке: 80 слов, 160 команд
*   Вход: RINT
*   Выход: AIRB:L9, AIRB:L9A, AIRB:PUSH, AORB:L9, AORB:L9A, RASPI:L20, 
*   RASPI:OR, RASPI:ORA, RASPI:L18, RINT:L17, RINT:L20, RINT:L20+1, 
*   RSYMB:L0022, RSYMB:LOOP, WRNGR:L14, SYTOBA (возврат через ячейка 0), 
*   L9 (возврат через ячейка 0), L14A (возврат через ячейка 0), 
*   L15 (возврат через ячейка 0), L20 (возврат через ячейка 0)
*   Внешние: SYTOBI, KONSTA
*   Смещения в SYTOBI: 1, 2, 3, 4, 5
*   Абсолютные символы: N2 = -2
*   Смещения в кадре (М7): общие 0, 9, свои 14, 20
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), М13 (счётчик), 
*   М14 (смещение в буфере), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 SYTOBI
*   002 KONSTA
*   003 SYTOBI1
*   004 SYTOBI2
*   005 SYTOBI3
*   006 SYTOBI4
*   007 SYTOBI5
*   008 N2
*
*** КОД МОДУЛЯ
*
RINT     СТАРТ  0
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         СЧИМ   М7                      ,в магазин; СМ := М7
         УИА    L9(М7)                  ,М7 := адрес L9
         СЧИМ   М7                      ,в магазин; СМ := М7
         ЗПМ    16(М12)                 ,ЗП + магазин: 16(М12)
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    14(М12)                 ,ЗП + магазин: 14(М12)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L17      УИ     М16                     ,М16 := СМ
         ЗПМ    22(М12)                 ,ЗП + магазин: 22(М12)
         ЗПМ    17(М12)                 ,ЗП + магазин: 17(М12)
         УИ     М11                     ,М11 := СМ
         ЗПМ    18(М12)                 ,ЗП + магазин: 18(М12)
         УИ     М14                     ,М14 := СМ
         ЗП     21(М12)                 ,параметр вызова ОС 21 := СМ
         МОД    17(М12)                 ,мод.адрес := код из 17(М12)
         СЧ     0                       ,СМ := слово по адресу 17+М12
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     3(М10)                  ,СМ += поле блока вызывающего 3
         И      8(М10)                  ,СМ &= поле блока вызывающего 8
         ЗП     10(М12)                 ,параметр вызова ОС 10 := СМ
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         ПО     L14                     ,если СМ=0 → L14
         УИ     М13                     ,М13 := СМ
         СЧ     0(М11)                  ,СМ := смещение в буфере 0
         ПВ     SYTOBI5(М15)            ,вызов через М15
         СЧИ    М7                      ,СМ := М7
         И      4(М10)                  ,СМ &= поле блока вызывающего 4
         ПЕ     GET                     ,если СМ≠0 → GET
         СЛИ    М14(М7)                 ,М14 += М7
         СЧ     3(М10)                  ,СМ := поле блока вызывающего 3
         МОД    14(М12)                 ,мод.адрес := код из 14(М12)
         ЗП     0                       ,по адресу 14+М12 := СМ
         СЧИ    М11                     ,СМ := М11
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИ     М11                     ,М11 := СМ
         СЧ     0                       ,СМ := 0
         ЗП     7(М12)                  ,параметр вызова ОС 7 := СМ
         СЛИА   1(М13)                  ,М13 += 1
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SYTOBA   ПВ     SYTOBI1(М15)            ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     8(М12)                  ,СМ := параметр вызова ОС 8
         ПВ     SYTOBI4(М15)            ,вызов через М15
         ПИНО   GETA(М7)                ,если ИР≠0 → GETA(М7)
         ПВ     SYTOBI(М15)             ,вызов через М15
         ЦИКЛ   SYTOBA(М13)             ,М13-- и если ≠0 → повтор
         СЧМ    12(М12)                 ,магазин + СЧ: 12(М12)
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         МОД    16(М12)                 ,мод.адрес := код из 16(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L9       И      9(М10)                  ,СМ &= поле блока вызывающего 9
         ПЕ     GETB                    ,если СМ≠0 → GETB
         СЧ     7(М12)                  ,СМ := параметр вызова ОС 7
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
GET      СЧ     8(М10)                  ,СМ := поле блока вызывающего 8
         НТЖ    0(М10)                  ,СМ ^= поле блока вызывающего 0
         ПБ     L14A                    ,переход на L14A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
GETA     СЧ     10(М12)                 ,СМ := параметр вызова ОС 10
         УИ     М11                     ,М11 := СМ
         СЛИ    М13(М11)                ,М13 += М11
         СЧИ    М13                     ,СМ := М13
         ПБ     L14A                    ,переход на L14A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
GETB     СЧ     8(М10)                  ,СМ := поле блока вызывающего 8
         НТЖ    7(М10)                  ,СМ ^= поле блока вызывающего 7
         ПБ     L14A                    ,переход на L14A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L14      СЧ     8(М10)                  ,СМ := поле блока вызывающего 8
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L14A     ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         МОД    14(М12)                 ,мод.адрес := код из 14(М12)
         ЗПМ    0                       ,по адресу 14+М12 := СМ (в магазин)
         МОД    12(М12)                 ,мод.адрес := код из 12(М12)
         УИА    0(М7)                   ,М7 := код из 12+М12
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
L15      СЛИА   N2(М17)                 ,М17 += N2
         СЧ     8(М10)                  ,СМ := поле блока вызывающего 8
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         МОД    15(М12)                 ,мод.адрес := код из 15(М12)
         ЗПМ    0                       ,по адресу 15+М12 := СМ (в магазин)
         МОД    12(М12)                 ,мод.адрес := код из 12(М12)
         УИА    0(М7)                   ,М7 := код из 12+М12
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    15(М12)                 ,ЗП + магазин: 15(М12)
         ЗПМ    14(М12)                 ,ЗП + магазин: 14(М12)
         ЗПМ    20(М12)                 ,ЗП + магазин: 20(М12)
         ЗП     19(М12)                 ,параметр вызова ОС 19 := СМ
         СЧИ    М7                      ,СМ := М7
         УИА    L20(М7)                 ,М7 := адрес L20
         СЧИМ   М7                      ,в магазин; СМ := М7
         ЗПМ    16(М12)                 ,ЗП + магазин: 16(М12)
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         ПБ     L17                     ,переход на L17
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L20      МОД    20(М12)                 ,мод.адрес := код из 20(М12)
         СЧ     0                       ,СМ := слово по адресу 20+М12
         СЛ     3(М10)                  ,СМ += поле блока вызывающего 3
         УИ     М13                     ,М13 := СМ
         СЧ     3(М10)                  ,СМ := поле блока вызывающего 3
         МОД    15(М12)                 ,мод.адрес := код из 15(М12)
         ЗП     0                       ,по адресу 15+М12 := СМ
         МОД    19(М12)                 ,мод.адрес := код из 19(М12)
         СЧ     0                       ,СМ := слово по адресу 19+М12
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИ     М11                     ,М11 := СМ
         МОДА   0(М13)                  ,мод.адрес := 0(М13)
         СЧ     9(М10)                  ,СМ := поле блока вызывающего 9
         МОДА   0(М13)                  ,мод.адрес := 0(М13)
         СДА    64(М11)
         НТЖ    2(М10)                  ,СМ ^= поле блока вызывающего 2
         И      0(М16)                  ,СМ &= ячейка мод.адреса 0
         СЧМ    7(М12)                  ,магазин + СЧ: 7(М12)
         СДА    64-48(М13)
         ЗП     0(М17)                  ,поле контекста 0 := СМ
         СЧМР   64-64                   ,СМ := РМР (результат мантиссы)
         ПЕ     L15                     ,если СМ≠0 → L15
         СЧ     0(М17)                  ,СМ := поле контекста 0
         СДА    64+48(М11)
         ИЛИ    0(М17)                  ,СМ |= поле контекста 0
         ЗП     0(М16)                  ,ячейка мод.адреса 0 := СМ
         СЧ     0(М17)                  ,СМ := поле контекста 0
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    15(М12)                 ,ЗП + магазин: 15(М12)
         УИ     М13                     ,М13 := СМ
         ЗПМ    20(М12)                 ,ЗП + магазин: 20(М12)
         УИ     М11                     ,М11 := СМ
         ЗП     19(М12)                 ,параметр вызова ОС 19 := СМ
         СЧИ    М7                      ,СМ := М7
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         УИ     М16                     ,М16 := СМ
         ЗПМ    22(М12)                 ,ЗП + магазин: 22(М12)
         УИ     М14                     ,М14 := СМ
         ЗП     21(М12)                 ,параметр вызова ОС 21 := СМ
         СЧ     0(М14)                  ,СМ := смещение в буфере 0
         И      8(М10)                  ,СМ &= поле блока вызывающего 8
         ЗП     7(М12)                  ,параметр вызова ОС 7 := СМ
         ПБ     L20                     ,переход на L20
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

