        ЗПМ    12(М12)                  ,ЗП + магазин: 12(М12)
        ПБ     L17                      ,переход на L17
        МОДА   RINT                     ,мод.адрес +1: RINT
        МОД    20(М12)                  ,мод.адрес по коду: 20(М12)
        СЧ     RINT                     ,СМ := RINT
        СЛ     L0003(М10)               ,СМ += L0003(М10)
        УИ     М13                      ,М13 := СМ
        СЧ     3(М10)                   ,СМ := 3(М10)
        МОД    15(М12)                  ,мод.адрес по коду: 15(М12)
        ЗП     RINT                     ,RINT := СМ
        МОД    19(М12)                  ,мод.адрес по коду: 19(М12)
        СЧ     RINT                     ,СМ := RINT
        ВЧОБ   3(М10)                   ,СМ := (адрес) - СМ
        УИ     М11                      ,М11 := СМ
        МОДА   RINT(М13)                ,мод.адрес +1: RINT(М13)
        СЧ     9(М10)                   ,СМ := 9(М10)
        МОДА   RINT(М13)                ,мод.адрес +1: RINT(М13)
        СДА    64(М11)                  ,сдвиг СМ на 64(М11)
        НТЖ    2(М10)                   ,СМ ^= 2(М10)
        И      RINT(М16)                ,СМ &= RINT(М16)
        СЧМ    7(М12)                   ,магазин + СЧ: 7(М12)
        СДА    64-48(М13)               ,сдвиг СМ влево на 48(М
        ЗП     RINT(М17)                ,RINT := СМ
        СЧМР   64-64                    ,СМ := РМР (результат мантиссы)
        ПЕ     SYTOBB                   ,если СМ≠0 → SYTOBB
        СЧ     RINT(М17)                ,СМ := RINT(М17)
