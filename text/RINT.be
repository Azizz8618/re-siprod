***************************************************
* RINT - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5472 образа SIPROD.BIN
*   Длина при загрузке: 80 слов, 160 команд
*   Вход: RINT
*   Выход: AIRB:L9, AIRB:L9B, AIRB:POP, AORB:L9, AORB:L9A+1, RASPI:L20, 
*   RASPI:PUT, RASPI:ORA+1, RASPI:ORA+1, RINT:L17, RINT:L9+1, RINT:L9+1, 
*   RSYMB:SYTOBA, RSYMB:L9A+1, WRNGR:L14, FRAME (возврат через ячейка 0), 
*   L9 (возврат через ячейка 0), L9 (возврат через ячейка 0), 
*   L9 (возврат через ячейка 0), L9 (возврат через ячейка 0)
*   Внешние: SYTOBI, KONSTA
*   Смещения в SYTOBI: 1, 2, 3, 4, 5
*   Регистры: М7, М10, М11, М12, М13, М14, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 SYTOBI
*   002 KONSTA
*   003 SYTOBI1
*   004 SYTOBI2
*   005 SYTOBI3
*   006 SYTOBI4
*   007 SYTOBI5
*   008 СИМ10
*
RINT     СТАРТ  0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         СЧИМ   М7                      ,стек := М7, СМ := М7
         УИА    SYTOBA(М7)              ,М7 := SYTOBA
         СЧИМ   М7                      ,стек := М7, СМ := М7
L17      ЗПМ    16(М12)                 ,ЗП + магазин: 16(М12)
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    14(М12)                 ,ЗП + магазин: 14(М12)
         МОДА   0                       ,мод.адрес +1: 0
         УИ     М16                     ,М16 := СМ
         ЗПМ    22(М12)                 ,ЗП + магазин: 22(М12)
         ЗПМ    17(М12)                 ,ЗП + магазин: 17(М12)
         УИ     М11                     ,М11 := СМ
         ЗПМ    18(М12)                 ,ЗП + магазин: 18(М12)
         УИ     М14                     ,М14 := СМ
         ЗП     21(М12)                 ,21 := СМ
         МОД    17(М12)                 ,мод.адрес по коду: 17(М12)
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     3(М10)                  ,СМ += 3(М10)
L17A     И      8(М10)                  ,СМ &= 8(М10)
         ЗП     10(М12)                 ,10 := СМ
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         ПО     L14C                    ,если СМ=0 → L14C
         УИ     М13                     ,М13 := СМ
         СЧ     0(М11)                  ,СМ := 0(М11)
SYTOBA   ПВ     SYTOBI5(М15)            ,вызов через М15
         СЧИ    М7                      ,СМ := М7
         И      4(М10)                  ,СМ &= 4(М10)
         ПЕ     L14                     ,если СМ≠0 → L14
L14      СЛИ    М14(М7)                 ,М14 += М7
         СЧ     3(М10)                  ,СМ := 3(М10)
L14A     МОД    14(М12)                 ,мод.адрес по коду: 14(М12)
         ЗП     0                       ,0 := СМ
         СЧИ    М11                     ,СМ := М11
L14B     ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИ     М11                     ,М11 := СМ
L14C     СЧ     0                       ,СМ := 0
L14D     ЗП     7(М12)                  ,7 := СМ
         СЛИА   1(М13)                  ,М13 += 1
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     SYTOBI1(М15)            ,вызов через М15
FRAME    МОДА   0                       ,мод.адрес +1: 0
         СЧ     8(М12)                  ,СМ := 8(М12)
         ПВ     SYTOBI4(М15)            ,вызов через М15
         ПИНО   L14A(М7)                ,если ИР≠0 → L14A(М7)
         ПВ     SYTOBI(М15)             ,вызов через М15
         ЦИКЛ   L17A(М13)               ,М13-- и если ≠0 → повтор
         СЧМ    12(М12)                 ,магазин + СЧ: 12(М12)
         УИМ    М7                      ,М7 := СМ + стек
         МОД    16(М12)                 ,мод.адрес по коду: 16(М12)
         ПБ     0                       ,переход на 0
         МОДА   0                       ,мод.адрес +1: 0
         И      9(М10)                  ,СМ &= 9(М10)
L9       ПЕ     L14B                    ,если СМ≠0 → L14B
         СЧ     7(М12)                  ,СМ := 7(М12)
         ИЛИ    3(М10)                  ,СМ |= 3(М10)
         ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := '6'
         МОД    9(М12)                  ,мод.адрес по коду: 9(М12)
         ПБ     0                       ,переход на 0
         СЧ     8(М10)                  ,СМ := 8(М10)
         НТЖ    0(М10)                  ,СМ ^= 0(М10)
         ПБ     L14D                    ,переход на L14D
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     10(М12)                 ,СМ := 10(М12)
         УИ     М11                     ,М11 := СМ
         СЛИ    М13(М11)                ,М13 += М11
         СЧИ    М13                     ,СМ := М13
         ПБ     L14D                    ,переход на L14D
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     8(М10)                  ,СМ := 8(М10)
         НТЖ    7(М10)                  ,СМ ^= 7(М10)
         ПБ     L14D                    ,переход на L14D
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     8(М10)                  ,СМ := 8(М10)
         МОДА   0                       ,мод.адрес +1: 0
         ИЛИ    3(М10)                  ,СМ |= 3(М10)
         МОД    14(М12)                 ,мод.адрес по коду: 14(М12)
         ЗПМ    0                       ,ЗП + магазин: 0
         МОД    12(М12)                 ,мод.адрес по коду: 12(М12)
         УИА    0(М7)                   ,М7 := 0
         РЖА    '6'                     ,РЖ := '6'
         МОД    9(М12)                  ,мод.адрес по коду: 9(М12)
         ПБ     0                       ,переход на 0
         СЛИА   СИМ10(М17)              ,М17 += СИМ10
         СЧ     8(М10)                  ,СМ := 8(М10)
         ИЛИ    3(М10)                  ,СМ |= 3(М10)
         МОД    15(М12)                 ,мод.адрес по коду: 15(М12)
         ЗПМ    0                       ,ЗП + магазин: 0
         МОД    12(М12)                 ,мод.адрес по коду: 12(М12)
         УИА    0(М7)                   ,М7 := 0
         РЖА    '6'                     ,РЖ := '6'
         МОД    9(М12)                  ,мод.адрес по коду: 9(М12)
         ПБ     0                       ,переход на 0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    15(М12)                 ,ЗП + магазин: 15(М12)
         ЗПМ    14(М12)                 ,ЗП + магазин: 14(М12)
         ЗПМ    20(М12)                 ,ЗП + магазин: 20(М12)
         ЗП     19(М12)                 ,19 := СМ
         СЧИ    М7                      ,СМ := М7
         УИА    L9(М7)                  ,М7 := L9
         СЧИМ   М7                      ,стек := М7, СМ := М7
         ЗПМ    16(М12)                 ,ЗП + магазин: 16(М12)
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         ПБ     L17                     ,переход на L17
         МОДА   0                       ,мод.адрес +1: 0
         МОД    20(М12)                 ,мод.адрес по коду: 20(М12)
         СЧ     0                       ,СМ := 0
         СЛ     3(М10)                  ,СМ += 3(М10)
         УИ     М13                     ,М13 := СМ
         СЧ     3(М10)                  ,СМ := 3(М10)
         МОД    15(М12)                 ,мод.адрес по коду: 15(М12)
         ЗП     0                       ,0 := СМ
         МОД    19(М12)                 ,мод.адрес по коду: 19(М12)
         СЧ     0                       ,СМ := 0
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИ     М11                     ,М11 := СМ
         МОДА   0(М13)                  ,мод.адрес +1: 0(М13)
         СЧ     9(М10)                  ,СМ := 9(М10)
         МОДА   0(М13)                  ,мод.адрес +1: 0(М13)
         СДА    64(М11)                 ,сдвиг СМ на 64(М11)
         НТЖ    2(М10)                  ,СМ ^= 2(М10)
         И      0(М16)                  ,СМ &= 0(М16)
         СЧМ    7(М12)                  ,магазин + СЧ: 7(М12)
         СДА    64-48(М13)              ,сдвиг СМ влево на 48(М
         ЗП     0(М17)                  ,0 := СМ
         СЧМР   64-64                   ,СМ := РМР (результат мантиссы)
         ПЕ     FRAME                   ,если СМ≠0 → FRAME
         СЧ     0(М17)                  ,СМ := 0(М17)
         СДА    64+48(М11)              ,сдвиг СМ вправо на 48(М
         ИЛИ    0(М17)                  ,СМ |= 0(М17)
         ЗП     0(М16)                  ,0 := СМ
         СЧ     0(М17)                  ,СМ := 0(М17)
         РЖА    '6'                     ,РЖ := '6'
         МОД    9(М12)                  ,мод.адрес по коду: 9(М12)
         ПБ     0                       ,переход на 0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    15(М12)                 ,ЗП + магазин: 15(М12)
         УИ     М13                     ,М13 := СМ
         ЗПМ    20(М12)                 ,ЗП + магазин: 20(М12)
         УИ     М11                     ,М11 := СМ
         ЗП     19(М12)                 ,19 := СМ
         СЧИ    М7                      ,СМ := М7
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         УИ     М16                     ,М16 := СМ
         ЗПМ    22(М12)                 ,ЗП + магазин: 22(М12)
         УИ     М14                     ,М14 := СМ
         ЗП     21(М12)                 ,21 := СМ
         СЧ     0(М14)                  ,СМ := 0(М14)
         И      8(М10)                  ,СМ &= 8(М10)
         ЗП     7(М12)                  ,7 := СМ
         ПБ     L9                      ,переход на L9
         МОДА   0                       ,мод.адрес +1: 0

