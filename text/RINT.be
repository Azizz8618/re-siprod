        СЛ     L0003(М10)               ,СМ += L0003(М10)
L0025   И      8(М10)                   ,СМ &= 8(М10)
        ЗП     10(М12)                  ,10 := СМ
        ВЧОБ   RINT                     ,СМ := (адрес) - СМ
        ПО     L0046                    ,если СМ=0 → L0046
        УИ     М13                      ,М13 := СМ
        СЧ     RINT(М11)                ,СМ := RINT(М11)
SYTOBI  ПВ     SYTOBIN+5(М15)           ,вызов через М15
        СЧИ    М7                       ,СМ := М7
        И      4(М10)                   ,СМ &= 4(М10)
        ПЕ     L0037                    ,если СМ≠0 → L0037
L0037   СЛИ    М14(М7)                  ,М14 += М7
        СЧ     3(М10)                   ,СМ := 3(М10)
L14     МОД    14(М12)                  ,мод.адрес по коду: 14(М12)
        ЗП     RINT                     ,RINT := СМ
        СЧИ    М11                      ,СМ := М11
L0044   ВЧОБ   RINT                     ,СМ := (адрес) - СМ
        УИ     М11                      ,М11 := СМ
L0046   СЧ     RINT                     ,СМ := RINT
SYTOBA  ЗП     7(М12)                   ,7 := СМ
        СЛИА   1(М13)                   ,М13 += 1
        МОДА   RINT                     ,мод.адрес +1: RINT
        ПВ     SYTOBIN+1(М15)           ,вызов через М15
SYTOBB  МОДА   RINT                     ,мод.адрес +1: RINT
        СЧ     8(М12)                   ,СМ := 8(М12)
        ПВ     SYTOBIN+4(М15)           ,вызов через М15
        ПИНО   L14(М7)                  ,если ИР≠0 → L14(М7)
        ПВ     SYTOBIN(М15)             ,вызов через М15
        ЦИКЛ   L0025(М13)               ,М13-- и если ≠0 → повтор
        СЧМ    12(М12)                  ,магазин + СЧ: 12(М12)
        УИМ    М7                       ,М7 := СМ + стек
        МОД    16(М12)                  ,мод.адрес по коду: 16(М12)
        ПБ     RINT                     ,переход на RINT
        МОДА   RINT                     ,мод.адрес +1: RINT
        И      9(М10)                   ,СМ &= 9(М10)
KONSTA  ПЕ     L0044                    ,если СМ≠0 → L0044
        СЧ     7(М12)                   ,СМ := 7(М12)
        ИЛИ    3(М10)                   ,СМ |= 3(М10)
        ЗПМ    RINT(М16)                ,ЗП + магазин: RINT(М16)
