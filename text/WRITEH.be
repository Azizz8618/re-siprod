***************************************************
* WRITEH - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 7488 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 48 команд
*   Вход: WRITEH
*   Выход: F0B (возврат через М12), F0C (возврат через М10)
*   ГЕНЕРАТОР РЕЖИМА *HCH: ИЕРАРХИЧЕСКАЯ СХЕМА,
*   УЗЕЛ И 2-5 ПОДЧИНЁННЫХ УЗЛОВ.
*   Внешние: NUNU, NUST, GOT, REGIM, TWOPLA, WRIVER, WRIHOR, WRILIN, 
*   ONEPLA, WRIKOR
*   Смещения в кадре (М7): общие 0-1, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 NUNU
*   002 NUST
*   003 GOT
*   004 REGIM
*   005 TWOPLA
*   006 WRIVER
*   007 WRIHOR
*   008 WRILIN
*   009 ONEPLA
*   010 WRIKOR
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     30    1245004010020040
*   К1     31    6400000000000001
*   К2     32    6400000000000002
*
*** КОД МОДУЛЯ
*
WRITEH   СТАРТ  0
         УИА    GOTA(М16)               ,М16 := адрес GOTA
         ПБ     F0B                     ,переход на F0B
*
GOTA     СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   GOT                     ,мод.адрес := GOT
         СЧ     0                       ,СМ := слово по адресу GOT
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F0                      ,если СМ=0 → F0
         ПБ     F0A                     ,переход на F0A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0       ПБ     ONEPLB                  ,переход на ONEPLB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0A      УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К1(М16)                 ,М16 := адрес К1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
ONEPLB   ПВ     ONEPLA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     WRILIN(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     WRIHOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     WRIVER(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     TWOPLA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     F0C                     ,переход на F0C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0B      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0C      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

