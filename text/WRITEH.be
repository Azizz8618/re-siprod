***************************************************
* WRITEH - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 7488 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 48 команд
*   Вход: WRITEH
*   Выход: смещение 52, через М12, смещение 57, через М10
*   ГЕНЕРАТОР РЕЖИМА *HCH: ИЕРАРХИЧЕСКАЯ СХЕМА,
*   УЗЕЛ И 2-5 ПОДЧИНЁННЫХ УЗЛОВ.
*   Внешние: NUNU, NUST, GOT, REGIM, TWOPLA, WRIVER, WRIHOR, WRILIN, 
*   ONEPLA, WRIKOR
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 NUNU
*   002 NUST
*   003 GOT
*   004 REGIM
*   005 TWOPLA
*   006 WRIVER
*   007 WRIHOR
*   008 WRILIN
*   009 ONEPLA
*   010 WRIKOR
*
WRITEH   СТАРТ  0
         УИА    GOTA(М16)               ,М16 := GOTA
GOTA     ПБ     V0A                     ,переход на V0A
         СЧ     0(М7)                   ,СМ := 0(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   GOT                     ,мод.адрес +1: GOT
GOTB     СЧ     0                       ,СМ := 0
GOTC     НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     GOTB                    ,если СМ=0 → GOTB
         ПБ     GOTC                    ,переход на GOTC
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     V0                      ,переход на V0
V0       МОДА   0                       ,мод.адрес +1: 0
         УИА    WRILIA(М16)             ,М16 := WRILIA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V0B(М16)                ,М16 := V0B
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WRIHOA(М16)             ,М16 := WRIHOA
V0A      СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
ONEPLB   ПВ     ONEPLA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
WRILIA   ПВ     WRILIN(М15)             ,вызов через М15
V0B      МОДА   0                       ,мод.адрес +1: 0
WRIHOA   ПВ     WRIHOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     WRIVER(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     TWOPLA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     ONEPLB                  ,переход на ONEPLB
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    V0B(М7)                 ,М7 := V0B
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

