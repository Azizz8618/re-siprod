         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     27(М7)                  ,слот кадра 27 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     EGO86M                  ,переход на EGO86M
*
LOOPA    УИА    V16(М16)                ,М16 := адрес V16
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V16(М16)                ,М16 := адрес V16
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     SPAUD(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     27(М7)                  ,СМ := слот кадра 27
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     27(М7)                  ,слот кадра 27 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO86M   МОДА   EGO8600                 ,мод.адрес := EGO8600
         ВЧОБ   0                       ,СМ := слово по адресу EGO8600 - СМ
         ПО     LOOPA                   ,если СМ=0 → LOOPA
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   RUSIS                   ,мод.адрес := RUSIS
         ЗП     0                       ,по адресу RUSIS := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     20(М7)                  ,СМ := слот кадра 20
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     F20B                    ,если СМ≠0 → F20B
         ПБ     F20C                    ,переход на F20C
*
F20B     ПБ     F0A                     ,переход на F0A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F20C     УИА    EGO7200(М16)            ,М16 := адрес EGO7200
         СЧИМ   М16                     ,в магазин; СМ := М16
