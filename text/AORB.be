***************************************************
* AORB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5952 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 54 команд
*   Вход: AORB
*   Выход: L9 (возврат через ячейка 0), L9A (возврат через ячейка 0)
*   Внешние: KONSTA
*   Регистры: М10 (блок вызывающего), М11 (буфер, счётчик), 
*   М12 (магазин, кадр параметров ОС), М13 (счётчик), 
*   М14 (смещение в буфере), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 KONSTA
*
*** КОД МОДУЛЯ
*
AORB     СТАРТ  0
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         УИМ    М16                     ,М16 := СМ; СМ := из магазина
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИ     М14                     ,М14 := СМ
         СЧ     0                       ,СМ := 0
         СЧМ    0(М13)                  ,магазин + СЧ: 0(М13)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         СЛИА   1(М13)                  ,М13 += 1
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L9       СЧМ    0(М14)                  ,магазин + СЧ: 0(М14)
         ИЛИ    0(М11)                  ,СМ |= смещение в буфере 0
         СЛИА   1(М14)                  ,М14 += 1
         ЧЕД    0(М17)                  ,СМ := кол-во единиц в поле контекста 
         СЛИА   1(М11)                  ,М11 += 1
         ЦИКЛ   L9(М13)                 ,М13-- и если ≠0 → повтор
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         УИМ    М16                     ,М16 := СМ; СМ := из магазина
         УИ     М13                     ,М13 := СМ
         СЧ     0(М13)                  ,СМ := смещение в буфере 0
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         УИМ    М15                     ,М15 := СМ; СМ := из магазина
         СЛИА   1(М13)                  ,М13 += 1
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИ     М14                     ,М14 := СМ
         СЧ     0                       ,СМ := 0
L9A      СЧМ    0(М14)                  ,магазин + СЧ: 0(М14)
         ИЛИ    0(М11)                  ,СМ |= смещение в буфере 0
         СЛИА   1(М14)                  ,М14 += 1
         ЗП     0(М15)                  ,смещение в магазине 0 := СМ
         СЛИА   1(М11)                  ,М11 += 1
         ЧЕД    0(М17)                  ,СМ := кол-во единиц в поле контекста 
         СЛИА   1(М15)                  ,М15 += 1
         ЦИКЛ   L9A(М13)                ,М13-- и если ≠0 → повтор
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

