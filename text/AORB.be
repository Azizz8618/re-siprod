***************************************************
* AORB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5952 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 54 команд
*   Вход: AORB
*   Внешние: KONSTA
*   Регистры: М10, М11, М12, М13, М14, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 KONSTA
*
AORB     СТАРТ  0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         УИМ    М16                     ,М16 := СМ + стек
         УИМ    М13                     ,М13 := СМ + стек
         УИМ    М11                     ,М11 := СМ + стек
         УИ     М14                     ,М14 := СМ
L0007    СЧ     0                       ,СМ := 0
         СЧМ    0(М13)                  ,магазин + СЧ: 0(М13)
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ + стек
         СЛИА   1(М13)                  ,М13 += 1
         МОДА   0                       ,мод.адрес +1: 0
         СЧМ    0(М14)                  ,магазин + СЧ: 0(М14)
         ИЛИ    0(М11)                  ,СМ |= 0(М11)
         СЛИА   1(М14)                  ,М14 += 1
         ЧЕД    0(М17)                  ,СМ := кол-во единиц в 0(М17)
         СЛИА   1(М11)                  ,М11 += 1
         ЦИКЛ   L0007(М13)              ,М13-- и если ≠0 → повтор
KONSTB   ИЛИ    3(М10)                  ,СМ |= 3(М10)
         ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := '6'
         МОД    9(М12)                  ,мод.адрес по коду: 9(М12)
         ПБ     0                       ,переход на 0
         МОДА   0                       ,мод.адрес +1: 0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         УИМ    М16                     ,М16 := СМ + стек
         УИ     М13                     ,М13 := СМ
         СЧ     0(М13)                  ,СМ := 0(М13)
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИМ    М13                     ,М13 := СМ + стек
         УИМ    М15                     ,М15 := СМ + стек
         СЛИА   1(М13)                  ,М13 += 1
         УИМ    М11                     ,М11 := СМ + стек
         УИ     М14                     ,М14 := СМ
         СЧ     0                       ,СМ := 0
         СЧМ    0(М14)                  ,магазин + СЧ: 0(М14)
         ИЛИ    0(М11)                  ,СМ |= 0(М11)
         СЛИА   1(М14)                  ,М14 += 1
         ЗП     0(М15)                  ,0 := СМ
         СЛИА   1(М11)                  ,М11 += 1
         ЧЕД    0(М17)                  ,СМ := кол-во единиц в 0(М17)
         СЛИА   1(М15)                  ,М15 += 1
         ЦИКЛ   KONSTB(М13)             ,М13-- и если ≠0 → повтор
         ИЛИ    3(М10)                  ,СМ |= 3(М10)
         ЗПМ    0(М16)                  ,ЗП + магазин: 0(М16)
         РЖА    '6'                     ,РЖ := '6'
         МОД    9(М12)                  ,мод.адрес по коду: 9(М12)
         ПБ     0                       ,переход на 0
         МОДА   0                       ,мод.адрес +1: 0

