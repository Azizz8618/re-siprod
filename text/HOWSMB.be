***************************************************
* HOWSMB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6880 образа SIPROD.BIN
*   Длина при загрузке: 37 слов, 58 команд
*   Вход: HOWSMB
*   Внешние: *WHO*, RSYMB
*   Смещения в *WHO*: 1
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
HOWSMB  СТАРТ  0
        УИА    L0044(М16)               ,М16 := L0044
L0044   ПБ     L0026                    ,переход на L0026
        СЧ     '4004'(М7)               ,СМ := '4004'(М7)
        ЗП     5(М7)                    ,5 := СМ
        РЖА    '3'                      ,РЖ := '3'
        МОД    WHO13                    ,мод.адрес по коду: WHO13
        УИА    HOWSMB(М16)              ,М16 := HOWSMB
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0010   УИА    L0040(М16)               ,М16 := L0040
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0012   УИА    V52(М16)                 ,М16 := V52
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0041(М16)               ,М16 := L0041
        СЧИМ   М16                      ,стек := М16, СМ := М16
        РЖА    '22'                     ,РЖ := '22'
RSYMB   ПВ     RSYMB(М15)               ,вызов через М15
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
WHO1    СЧ     1(М7)                    ,СМ := 1(М7)
        МОДА   *WHO*+1                  ,мод.адрес +1: *WHO*+1
        ЗП     HOWSMB                   ,HOWSMB := СМ
        РЖА    '3'                      ,РЖ := '3'
L0026   СЧ     '4004'(М7)               ,СМ := '4004'(М7)
        СЧИМ                            ,СЧИ + магазин
        СЧ     5(М7)                    ,СМ := 5(М7)
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    HOWSMB(М17)              ,СМ ^= HOWSMB(М17)
V5      ПО     RSYMB                    ,если СМ=0 → RSYMB
        ПБ     WHO1                     ,переход на WHO1
        МОДА   HOWSMB                   ,мод.адрес +1: HOWSMB
WHO12   СЧ     HOWSMB(М7)               ,СМ := HOWSMB(М7)
        МОДА   *WHO*+1                  ,мод.адрес +1: *WHO*+1
L0040   ЗП     HOWSMB                   ,HOWSMB := СМ
L0041   РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
V52     МОДА   HOWSMB                   ,мод.адрес +1: HOWSMB
WHO13   СЧ     4(М7)                    ,СМ := 4(М7)
        РЖА    '3'                      ,РЖ := '3'
        МОДА   *WHO*+1                  ,мод.адрес +1: *WHO*+1
        ВЧ     HOWSMB                   ,СМ -= HOWSMB
        МОДА   *WHO*                    ,мод.адрес +1: *WHO*
        ЗП     HOWSMB                   ,HOWSMB := СМ
        РЖА    '22'                     ,РЖ := '22'
        ПБ     V5                       ,переход на V5
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    WHO12(М7)                ,М7 := WHO12
        ЗПМ    6(М7)                    ,ЗП + магазин: 6(М7)
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     HOWSMB(М12)              ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     HOWSMB(М10)              ,переход через М10

