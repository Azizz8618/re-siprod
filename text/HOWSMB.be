***************************************************
* HOWSMB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6880 образа SIPROD.BIN
*   Длина при загрузке: 37 слов, 58 команд
*   Вход: HOWSMB
*   Выход: APNOTF:ENDKOA, CSTRIN:F8, CSTRIN:F8, GOTOPO:F5, RASKOM:F1B, 
*   TARNYB:NOTFH, TARNYB:F1, WRIHOR:L0166, WRIHOR:L0166, WRILIN:F7B, 
*   WRILIN:F7B, WRINUM:F0, WRIVER:F18, F6 (возврат через М12), 
*   POP (возврат через М10)
*   Внешние: WHO, RSYMB
*   Смещения в WHO: 1
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-1, 4-6, 10, вне кадра 2052
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 WHO
*   002 WHO1
*   003 RSYMB
*   004 N1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К1     36
*   К3     40
*   К4     41
*   V0     43
*   V1     44
*
*** КОД МОДУЛЯ
*
HOWSMB   СТАРТ  0
         УИА    F5(М16)                 ,М16 := адрес F5
         ПБ     F6                      ,переход на F6
*
F5       СЧ     '4004'(М7)              ,СМ := каталог задачи: элемент 4
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОД    V1                      ,мод.адрес := код из V1
         УИА    0(М16)                  ,М16 := код из V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К4(М16)                 ,М16 := адрес К4
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RSYMB(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   WHO1                    ,мод.адрес := WHO1
         ЗП     0                       ,по адресу WHO1 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     '4004'(М7)              ,СМ := каталог задачи: элемент 4
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     5(М7)                   ,СМ := слот кадра 5
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     WHO1A                   ,если СМ=0 → WHO1A
         ПБ     WHO1B                   ,переход на WHO1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
WHO1A    СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   WHO1                    ,мод.адрес := WHO1
         ЗП     0                       ,по адресу WHO1 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
WHO1B    СЧ     4(М7)                   ,СМ := слот кадра 4
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   WHO1                    ,мод.адрес := WHO1
         ВЧ     0                       ,СМ -= слово по адресу WHO1
         МОДА   WHO                     ,мод.адрес := WHO
         ЗП     0                       ,по адресу WHO := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     POP                     ,переход на POP
*
F6       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         ЗПМ    6(М7)                   ,ЗП + магазин: 6(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

