***************************************************
* HOWSMB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6880 образа SIPROD.BIN
*   Длина при загрузке: 37 слов, 58 команд
*   Вход: HOWSMB
*   Выход: APNOTF:PAGE1G+1, CSTRIN:PUSH, CSTRIN:PUSHD+1, GOTOPO:WAIT, 
*   RASKOM:V1F, TARNYB:V1K, TARNYB:V1P+1, WRIHOR:PUSH, WRIHOR:ADDRE+1, 
*   WRILIN:V7, WRILIN:V7N+1, WRINUM:V0B, WRIVER:V3J, 
*   WHO1H (возврат через М12), WHO1H (возврат через М10)
*   Внешние: WHO, RSYMB
*   Смещения в WHO: 1
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 WHO
*   002 WHO1
*   003 RSYMB
*
HOWSMB   СТАРТ  0
         УИА    V5(М16)                 ,М16 := V5
V5       ПБ     WHO1B                   ,переход на WHO1B
         СЧ     '4004'(М7)              ,СМ := '4004'(М7)
         ЗП     5(М7)                   ,5 := СМ
         РЖА    '3'                     ,РЖ := '3'
         МОД    WHO1H                   ,мод.адрес по коду: WHO1H
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WHO1E(М16)              ,М16 := WHO1E
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WHO1G(М16)              ,М16 := WHO1G
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WHO1F(М16)              ,М16 := WHO1F
         СЧИМ   М16                     ,стек := М16, СМ := М16
         РЖА    '22'                    ,РЖ := '22'
RSYMBA   ПВ     RSYMB(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
WHO1A    СЧ     1(М7)                   ,СМ := 1(М7)
         МОДА   WHO1                    ,мод.адрес +1: WHO1
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
WHO1B    СЧ     '4004'(М7)              ,СМ := '4004'(М7)
         СЧИМ                           ,СЧИ + магазин
         СЧ     5(М7)                   ,СМ := 5(М7)
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
WHO1C    ПО     RSYMBA                  ,если СМ=0 → RSYMBA
         ПБ     WHO1A                   ,переход на WHO1A
         МОДА   0                       ,мод.адрес +1: 0
WHO1D    СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   WHO1                    ,мод.адрес +1: WHO1
WHO1E    ЗП     0                       ,0 := СМ
WHO1F    РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
WHO1G    МОДА   0                       ,мод.адрес +1: 0
WHO1H    СЧ     4(М7)                   ,СМ := 4(М7)
         РЖА    '3'                     ,РЖ := '3'
         МОДА   WHO1                    ,мод.адрес +1: WHO1
         ВЧ     0                       ,СМ -= 0
         МОДА   WHO                     ,мод.адрес +1: WHO
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     WHO1C                   ,переход на WHO1C
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    WHO1D(М7)               ,М7 := WHO1D
         ЗПМ    6(М7)                   ,ЗП + магазин: 6(М7)
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

