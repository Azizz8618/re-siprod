***************************************************
* SYTINT - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 15168 образа SIPROD.BIN
*   Длина при загрузке: 82 слов, 132 команд
*   Вход: SYTINT
*   Выход: ANATXT:TXT1B, CHAPAG:NUST5A, FIRCAR:SCANEC, PAPRAP:F26B, 
*   READNB:F1A, SCHEMA:RPTA, SEGTAB:TXTA, SPAUD:PAGEA, SPAUD:NUST5A, 
*   SPAUD:SCAN54, SPAUD:REGIMW, TOKREZ:F10, WRIIPO:F6, 
*   F9 (возврат через М12), POP (возврат через М10)
*   СИНХРОНИЗАЦИЯ ВЫВОДА С ТЕКСТОВЫМ ПОТОКОМ.
*   Внешние: AAИ, RSYMB
*   Абсолютные символы: N4 = -4, N5 = -5, N6 = -6
*   Смещения в кадре (М7): общие 0, 2-10, вне кадра 2051-2053
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 AAИ
*   002 RSYMB
*   003 N4
*   004 N5
*   005 N6
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К6     110
*   К7     111
*   V0     112
*   V1     113
*   V2     114
*   V3     115
*   V4     116
*   V5     117
*   V6     120
*   V7     121
*
*** КОД МОДУЛЯ
*
SYTINT   СТАРТ  0
         УИА    F2(М16)                 ,М16 := адрес F2
         ПБ     F9                      ,переход на F9
*
F2       СЧ     '4003'(М7)              ,СМ := каталог задачи: элемент 3
         ЗП     2(М7)                   ,слот кадра 2 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОД    V6                      ,мод.адрес := код из V6
         СЧ     0                       ,СМ := слово по адресу V6
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2A      МОД    V5                      ,мод.адрес := код из V5
         УИА    0(М16)                  ,М16 := код из V5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К7(М16)                 ,М16 := адрес К7
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     2(М7)                   ,СМ := слот кадра 2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     '4004'(М7)              ,СМ += каталог задачи: элемент 4
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F2B                     ,если СМ≠0 → F2B
         ПБ     F2C                     ,переход на F2C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2B      ПБ     F3                      ,переход на F3
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2C      СЧ     2(М7)                   ,СМ := слот кадра 2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     '4005'(М7)              ,СМ -= каталог задачи: элемент 5
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F2D                     ,если СМ≠0 → F2D
         ПБ     F2E                     ,переход на F2E
*
F2D      ПБ     F3                      ,переход на F3
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2E      ПБ     F3A                     ,переход на F3A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3       СЧ     3(М7)                   ,СМ := слот кадра 3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F2A                     ,переход на F2A
*
F3A      СЧ     3(М7)                   ,СМ := слот кадра 3
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F3B      СЧ     4(М7)                   ,СМ := слот кадра 4
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         МОД    V5                      ,мод.адрес := код из V5
         УИА    0(М16)                  ,М16 := код из V5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К7(М16)                 ,М16 := адрес К7
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     2(М7)                   ,СМ := слот кадра 2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     '4004'(М7)              ,СМ += каталог задачи: элемент 4
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F2F                     ,если СМ≠0 → F2F
         ПБ     F2G                     ,переход на F2G
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2F      ПБ     F4                      ,переход на F4
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2G      СЧ     2(М7)                   ,СМ := слот кадра 2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     '4005'(М7)              ,СМ -= каталог задачи: элемент 5
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F2H                     ,если СМ≠0 → F2H
         ПБ     F2I                     ,переход на F2I
*
F2H      ПБ     F4                      ,переход на F4
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2I      ПБ     F3B                     ,переход на F3B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F4       СЧ     4(М7)                   ,СМ := слот кадра 4
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     3(М7)                   ,СМ -= слот кадра 3
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         МОД    V5                      ,мод.адрес := код из V5
         УИА    0(М16)                  ,М16 := код из V5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V3(М16)                 ,М16 := адрес V3
         СЧИМ   М16                     ,в магазин; СМ := М16
         МОД    V7                      ,мод.адрес := код из V7
         УИА    0(М16)                  ,М16 := код из V7
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V4(М16)                 ,М16 := адрес V4
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     AAИ(М15)                ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     4(М7)                   ,СМ := слот кадра 4
         МОД    V6                      ,мод.адрес := код из V6
         ЗП     0                       ,по адресу V6 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     POP                     ,переход на POP
*
F9       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К6(М7)                  ,М7 := адрес К6
         ЗПМ    9(М7)                   ,ЗП + магазин: 9(М7)
         ЗПМ    8(М7)                   ,ЗП + магазин: 8(М7)
         ЗПМ    7(М7)                   ,ЗП + магазин: 7(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К6       КОНД   В'6400000000000001'
К7       КОНД   В'6400000000000006'
V0       ПАМ    1
V1       ПАМ    1
V2       ПАМ    1
V3       ПАМ    1
V4       ПАМ    1
V5       ПАМ    1
V6       ПАМ    1
V7       ПАМ    1
