        МОДА   *NDAB*+1                 ,мод.адрес +1: *NDAB*+1
        СЧ     STANDA                   ,СМ := STANDA
        УИА    L0113(М16)               ,М16 := L0113
IDII    ПВ     I*DI*I(М15)              ,вызов через М15
V52     МОДА   STANDA                   ,мод.адрес +1: STANDA
        ЗП     7(М7)                    ,7 := СМ
NDAB1   МОДА   *NDAB*+1                 ,мод.адрес +1: *NDAB*+1
        СЧ     STANDA                   ,СМ := STANDA
        СЧИМ                            ,СЧИ + магазин
        СЧ     7(М7)                    ,СМ := 7(М7)
IMUI    УИА    L0113(М16)               ,М16 := L0113
        ПВ     I*MU*I(М15)              ,вызов через М15
REGIM   МОДА   STANDA                   ,мод.адрес +1: STANDA
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    STANDA(М17)              ,СМ ^= STANDA(М17)
        ПО     IDII                     ,если СМ=0 → IDII
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        СЧ     5(М7)                    ,СМ := 5(М7)
        СЧИМ                            ,СЧИ + магазин
        МОДА   *REGIM*                  ,мод.адрес +1: *REGIM*
        СЧ     STANDA                   ,СМ := STANDA
ENDPG   НТЖ    STANDA(М17)              ,СМ ^= STANDA(М17)
        ПО     IDII                     ,если СМ=0 → IDII
        ПБ     V52                      ,переход на V52
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        ПБ     NDAB1                    ,переход на NDAB1
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        ПВ     ENDPG(М15)               ,вызов через М15
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        ПВ     BEGPG(М15)               ,вызов через М15
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        ПВ     ENDPG(М15)               ,вызов через М15
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        СЧ     6(М7)                    ,СМ := 6(М7)
        МОДА   *STAND*+1                ,мод.адрес +1: *STAND*+1
        ЗП     STANDA                   ,STANDA := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        СЧ     1(М7)                    ,СМ := 1(М7)
        ЗП     8(М7)                    ,8 := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОД    L01212                   ,мод.адрес по коду: L01212
L0077   УИА    STANDA(М1)               ,М1 := STANDA
L0123   МОДА   BEGPG(М1)                ,мод.адрес +1: BEGPG(М1)
PAGE77  СЧ     STANDA                   ,СМ := STANDA
        МОДА   *PAGE*+77777(М1)         ,мод.адрес +1: *PAGE*+77777
        ЗП     STANDA                   ,STANDA := СМ
        СЧ     8(М7)                    ,СМ := 8(М7)
        РЖА    '3'                      ,РЖ := '3'
L0106   СЛ     ARPI(М7)                 ,СМ += ARPI(М7)
        ЗП     8(М7)                    ,8 := СМ
        ВЧОБ   3(М7)                    ,СМ := (адрес) - СМ
L0111   РЖА    '22'                     ,РЖ := '22'
        ПО     REGIM                    ,если СМ=0 → REGIM
L0113   СЧ     1(М7)                    ,СМ := 1(М7)
        ЗП     8(М7)                    ,8 := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0121   МОДА   STANDA                   ,мод.адрес +1: STANDA
        МОД    L01212                   ,мод.адрес по коду: L01212
L01212  УИА    STANDA(М1)               ,М1 := STANDA
L01213  МОДА   L01212(М1)               ,мод.адрес +1: L01212(М1)
BEGPG   СЧ     STANDA                   ,СМ := STANDA
        МОДА   *LOL*+77777(М1)          ,мод.адрес +1: *LOL*+77777(
        ЗП     STANDA                   ,STANDA := СМ
        МОД    L01212                   ,мод.адрес по коду: L01212
        УИА    STANDA(М1)               ,М1 := STANDA
        МОДА   L01212(М1)               ,мод.адрес +1: L01212(М1)
        СЧ     STANDA                   ,СМ := STANDA
