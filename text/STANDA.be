***************************************************
* STANDA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 21472 образа SIPROD.BIN
*   Длина при загрузке: 90 слов, 146 команд
*   Вход: STANDA
*   Внешние: *STAND*, *FORMA*, *PAGE*, *REGIM*, *LOL*, *NUST*, *NDAB*, 
*   *ARPI*, BEGPG, ENDPG, I*DI*I, I*MU*I
*   Смещения в *FORMA*: 7
*   Смещения в *LOL*: 7
*   Смещения в *NDAB*: 1, 2
*   Смещения в *STAND*: 1, 2
*   Регистры: М1, М7, М10, М12, М15, М16, М17
***************************************************
STANDA  СТАРТ  0
        УИА    ARPI(М16)                ,М16 := ARPI
ARPI    ПБ     PAGE77                   ,переход на PAGE77
        СЧ     5(М7)                    ,СМ := 5(М7)
        СЧИМ                            ,СЧИ + магазин
        МОДА   *ARPI*                   ,мод.адрес +1: *ARPI*
L0005   СЧ     STANDA                   ,СМ := STANDA
L0006   НТЖ    STANDA(М17)              ,СМ ^= STANDA(М17)
        ПО     L0005                    ,если СМ=0 → L0005
V5      ПБ     L0006                    ,переход на L0006
        МОДА   STANDA                   ,мод.адрес +1: STANDA
STAND1  ПБ     IMUI                     ,переход на IMUI
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        МОДА   *STAND*+1                ,мод.адрес +1: *STAND*+1
        СЧ     STANDA                   ,СМ := STANDA
        ЗП     6(М7)                    ,6 := СМ
        РЖА    '3'                      ,РЖ := '3'
        СЧ     STANDA(М7)               ,СМ := STANDA(М7)
        МОДА   *STAND*+1                ,мод.адрес +1: *STAND*+1
