        СЛ     ARPI(М7)                 ,СМ += ARPI(М7)
        ЗП     8(М7)                    ,8 := СМ
        ВЧОБ   4(М7)                    ,СМ := (адрес) - СМ
        РЖА    '22'                     ,РЖ := '22'
        ПО     ENDPG                    ,если СМ=0 → ENDPG
        СЧ     5(М7)                    ,СМ := 5(М7)
        МОДА   *REGIM*                  ,мод.адрес +1: *REGIM*
        ЗП     STANDA                   ,STANDA := СМ
        РЖА    '3'                      ,РЖ := '3'
        СЧ     5(М7)                    ,СМ := 5(М7)
        МОДА   *NUST*                   ,мод.адрес +1: *NUST*
        ЗП     STANDA                   ,STANDA := СМ
        СЧ     5(М7)                    ,СМ := 5(М7)
        МОДА   *STAND*                  ,мод.адрес +1: *STAND*
        ЗП     STANDA                   ,STANDA := СМ
        СЧ     5(М7)                    ,СМ := 5(М7)
        СЧИМ                            ,СЧИ + магазин
        МОДА   *ARPI*                   ,мод.адрес +1: *ARPI*
        СЧ     STANDA                   ,СМ := STANDA
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    STANDA(М17)              ,СМ ^= STANDA(М17)
        ПЕ     L0077                    ,если СМ≠0 → L0077
        ПБ     L0123                    ,переход на L0123
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        ПВ     BEGPG(М15)               ,вызов через М15
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        ПБ     L0106                    ,переход на L0106
        МОДА   STANDA                   ,мод.адрес +1: STANDA
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0111(М7)                ,М7 := L0111
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М1                       ,стек := М1, СМ := М1
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
