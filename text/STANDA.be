***************************************************
* STANDA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 21472 образа SIPROD.BIN
*   Длина при загрузке: 90 слов, 146 команд
*   Вход: STANDA
*   Выход: STAATP:F10, F5B (возврат через М12), POP (возврат через М10)
*   Внешние: STAND, FORMA, PAGE, REGIM, LOL, NUST, NDAB, ARPI, BEGPG, 
*   ENDPG, IDII, IMUI
*   Смещения в FORMA: 7
*   Смещения в LOL: 7
*   Смещения в NDAB: 1, 2
*   Смещения в STAND: 1, 2
*   Смещения в кадре (М7): общие 0-1, 3-8, 10
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес), 
*   М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 STAND
*   002 STAND1
*   003 STAND2
*   004 FORMA
*   005 PAGE
*   006 REGIM
*   007 LOL
*   008 NUST
*   009 NDAB
*   010 NDAB1
*   011 NDAB2
*   012 ARPI
*   013 BEGPG
*   014 ENDPG
*   015 IDII
*   016 IMUI
*   017 PAGE32767
*   018 LOL32767
*   019 FORMA32767
*   020 LOL7
*   021 FORMA7
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     111    6400000000000000
*   К2     113    6400000000000002
*   V0     117
*   V2     121
*   V3     122
*   V4     123
*
*** КОД МОДУЛЯ
*
STANDA   СТАРТ  0
         УИА    ARPIA(М16)              ,М16 := адрес ARPIA
         ПБ     F5B                     ,переход на F5B
*
ARPIA    СЧ     5(М7)                   ,СМ := слот кадра 5
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   ARPI                    ,мод.адрес := ARPI
         СЧ     0                       ,СМ := слово по адресу ARPI
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     STANDB                  ,если СМ=0 → STANDB
         ПБ     STANDC                  ,переход на STANDC
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STANDB   ПБ     STANDD                  ,переход на STANDD
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STANDC   МОДА   STAND1                  ,мод.адрес := STAND1
         СЧ     0                       ,СМ := слово по адресу STAND1
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   STAND1                  ,мод.адрес := STAND1
         ЗП     0                       ,по адресу STAND1 := СМ
         МОДА   NDAB1                   ,мод.адрес := NDAB1
         СЧ     0                       ,СМ := слово по адресу NDAB1
         УИА    К2(М16)                 ,М16 := адрес К2
         ПВ     IDII(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         МОДА   NDAB1                   ,мод.адрес := NDAB1
         СЧ     0                       ,СМ := слово по адресу NDAB1
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     7(М7)                   ,СМ := слот кадра 7
         УИА    К2(М16)                 ,М16 := адрес К2
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F5                      ,если СМ=0 → F5
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     5(М7)                   ,СМ := слот кадра 5
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   REGIM                   ,мод.адрес := REGIM
         СЧ     0                       ,СМ := слово по адресу REGIM
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F5                      ,если СМ=0 → F5
         ПБ     ENDPGA                  ,переход на ENDPGA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F5       ПБ     ENDPGB                  ,переход на ENDPGB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ENDPGA   ПВ     ENDPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     BEGPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ENDPGB   ПВ     ENDPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     6(М7)                   ,СМ := слот кадра 6
         МОДА   STAND1                  ,мод.адрес := STAND1
         ЗП     0                       ,по адресу STAND1 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STANDD   СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
STANDE   МОД    V2                      ,мод.адрес := код из V2
         УИА    0(М1)                   ,М1 := код из V2
         МОДА   V4(М1)                  ,мод.адрес := V4(М1)
         СЧ     0                       ,СМ := слово по адресу V4+М1
         МОДА   PAGE32767(М1)           ,мод.адрес := PAGE32767(М1)
         ЗП     0                       ,по адресу PAGE32767+М1 := СМ
         СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         ВЧОБ   3(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     STANDE                  ,если СМ=0 → STANDE
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STANDF   МОД    V2                      ,мод.адрес := код из V2
         УИА    0(М1)                   ,М1 := код из V2
         МОДА   V2(М1)                  ,мод.адрес := V2(М1)
         СЧ     0                       ,СМ := слово по адресу V2+М1
         МОДА   LOL32767(М1)            ,мод.адрес := LOL32767(М1)
         ЗП     0                       ,по адресу LOL32767+М1 := СМ
         МОД    V2                      ,мод.адрес := код из V2
         УИА    0(М1)                   ,М1 := код из V2
         МОДА   V2(М1)                  ,мод.адрес := V2(М1)
         СЧ     0                       ,СМ := слово по адресу V2+М1
         МОДА   FORMA32767(М1)          ,мод.адрес := FORMA32767(М1)
         ЗП     0                       ,по адресу FORMA32767+М1 := СМ
         МОДА   V2(М1)                  ,мод.адрес := V2(М1)
         СЧ     0                       ,СМ := слово по адресу V2+М1
         МОДА   LOL7(М1)                ,мод.адрес := LOL7(М1)
         ЗП     0                       ,по адресу LOL7+М1 := СМ
         МОДА   V2(М1)                  ,мод.адрес := V2(М1)
         СЧ     0                       ,СМ := слово по адресу V2+М1
         МОДА   FORMA7(М1)              ,мод.адрес := FORMA7(М1)
         ЗП     0                       ,по адресу FORMA7+М1 := СМ
         СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         ВЧОБ   4(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     STANDF                  ,если СМ=0 → STANDF
         СЧ     5(М7)                   ,СМ := слот кадра 5
         МОДА   REGIM                   ,мод.адрес := REGIM
         ЗП     0                       ,по адресу REGIM := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     5(М7)                   ,СМ := слот кадра 5
         МОДА   NUST                    ,мод.адрес := NUST
         ЗП     0                       ,по адресу NUST := СМ
         СЧ     5(М7)                   ,СМ := слот кадра 5
         МОДА   STAND                   ,мод.адрес := STAND
         ЗП     0                       ,по адресу STAND := СМ
         СЧ     5(М7)                   ,СМ := слот кадра 5
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   ARPI                    ,мод.адрес := ARPI
         СЧ     0                       ,СМ := слово по адресу ARPI
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     BEGPGA                  ,если СМ≠0 → BEGPGA
         ПБ     F5A                     ,переход на F5A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
BEGPGA   ПВ     BEGPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F5A      ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F5B      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

