***************************************************
* NEWSTR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 14784 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 50 команд
*   Вход: NEWSTR
*   Выход: SPAUD:INS26B, L0044 (возврат через М12), F1 (возврат через М10)
*   Внешние: STR, NDAB, BEGSTR, ENDSTR
*   Смещения в NDAB: 1, 2
*   Смещения в STR: 24, 25, 26
*   Смещения в кадре (М7): общие 0-1, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 STR
*   002 STR24
*   003 STR25
*   004 STR26
*   005 NDAB
*   006 NDAB1
*   007 NDAB2
*   008 BEGSTR
*   009 ENDSTR
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     31
*
*** КОД МОДУЛЯ
*
NEWSTR   СТАРТ  0
         УИА    STR25A(М16)             ,М16 := адрес STR25A
         ПБ     L0044                   ,переход на L0044
*
STR25A   МОДА   STR25                   ,мод.адрес := STR25
         СЧ     0                       ,СМ := слово по адресу STR25
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   STR24                   ,мод.адрес := STR24
         СЧ     0                       ,СМ := слово по адресу STR24
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     NDAB1A                  ,если СМ=0 → NDAB1A
         ПБ     NDAB1B                  ,переход на NDAB1B
*
NDAB1A   ПБ     STR25B                  ,переход на STR25B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NDAB1B   МОДА   NDAB1                   ,мод.адрес := NDAB1
         СЧ     0                       ,СМ := слово по адресу NDAB1
         ЗП     1(М7)                   ,слот кадра 1 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ENDSTR(М15)             ,вызов через М15
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   NDAB1                   ,мод.адрес := NDAB1
         СЧ     0                       ,СМ := слово по адресу NDAB1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     BEGSTA                  ,если СМ=0 → BEGSTA
         ПБ     STR25B                  ,переход на STR25B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
BEGSTA   ПВ     BEGSTR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR25B   МОДА   STR25                   ,мод.адрес := STR25
         СЧ     0                       ,СМ := слово по адресу STR25
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         МОДА   STR24                   ,мод.адрес := STR24
         ЗП     0                       ,по адресу STR24 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F1                      ,переход на F1
*
L0044    УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1       УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'6400000000000003'
V0       ПАМ    1
	ФИНИШ

