***************************************************
* SKZONA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5120 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 52 команд
*   Вход: SKZONA
*   Регистры: М11, М12, М13, М15
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 СИМ1
*   003 СИМ3
*
SKZONA   СТАРТ  0
         УИМ    М11                     ,М11 := СМ + стек
         УИМ    М13                     ,М13 := СМ + стек
         МОДА   СИМ1G                   ,мод.адрес +1: СИМ1G
СИМ1A    ЗПМ    0                       ,ЗП + магазин: 0
         УИА    0(М12)                  ,М12 := 0
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М13)                  ,СМ := 0(М13)
         УИ     М13                     ,М13 := СМ
         СЧИ    М13                     ,СМ := М13
         МОДА   СИМ1F(М12)              ,мод.адрес +1: СИМ1F(М12)
         НТЖ    0                       ,СМ ^= 0
         МОДА   СИМ1E                   ,мод.адрес +1: СИМ1E
СИМ1B    ЗП     0                       ,0 := СМ
         СЧ     0(М11)                  ,СМ := 0(М11)
         СДА    64-12                   ,сдвиг СМ влево на 12
СИМ1C    МОДА   СИМ1E                   ,мод.адрес +1: СИМ1E
         НТЖ    0                       ,СМ ^= 0
         МОДА   СИМ1E                   ,мод.адрес +1: СИМ1E
         Э75    0
СИМ1D    МОДА   0                       ,мод.адрес +1: 0
         МОДА   СИМ1E                   ,мод.адрес +1: СИМ1E
         Э70    0
         ПИНО   СИМ1C(М12)              ,если ИР≠0 → СИМ1C(М12)
СИМ1E    УИА    СИМ3(М13)               ,М13 := СИМ3
СИМ1F    МОДА   СИМ1                    ,мод.адрес +1: СИМ1
         СЧ     '1777'(М13)             ,СМ := '1777'(М13)
СИМ1G    МОД    СИМ1G                   ,мод.адрес по коду: СИМ1G
         ЗП     '1777'(М13)             ,'1777' := СМ
         ЦИКЛ   СИМ1B(М13)              ,М1-- и если ≠0 → повтор
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     0(М15)                  ,переход через М15
         МОДА   0                       ,мод.адрес +1: 0
         УИМ    М11                     ,М11 := СМ + стек
         УИМ    М13                     ,М13 := СМ + стек
         МОДА   СИМ1G                   ,мод.адрес +1: СИМ1G
         ЗПМ    0                       ,ЗП + магазин: 0
         УИА    СИМ3(М12)               ,М12 := СИМ3
         МОДА   0                       ,мод.адрес +1: 0
         МОД    СИМ1G                   ,мод.адрес по коду: СИМ1G
         СЧ     '1777'(М12)             ,СМ := '1777'(М12)
         МОДА   СИМ1                    ,мод.адрес +1: СИМ1
         ЗП     '1777'(М12)             ,'1777' := СМ
         ЦИКЛ   СИМ1D(М12)              ,М1-- и если ≠0 → повтор
         УИА    1(М12)                  ,М12 := 1
         ПБ     СИМ1A                   ,переход на СИМ1A
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     '4004'                  ,СМ := '4004'
         УИМ                            ,УИ + магазин
         СЧ     '4004'                  ,СМ := '4004'
         ЗП     0                       ,0 := СМ
         ЗП     '4004'                  ,'4004' := СМ
         ЗП     0                       ,0 := СМ

