***************************************************
* SKZONA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5120 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 52 команд
*   Вход: SKZONA
*   Регистры: М11, М12, М13, М15
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 СИМ1
*   003 СИМ3
*
SKZONA   СТАРТ  0
         УИМ    М11                     ,М11 := СМ + стек
         УИМ    М13                     ,М13 := СМ + стек
         МОДА   L0032                   ,мод.адрес +1: L0032
L0030    ЗПМ    0                       ,ЗП + магазин: 0
         УИА    0(М12)                  ,М12 := 0
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М13)                  ,СМ := 0(М13)
         УИ     М13                     ,М13 := СМ
         СЧИ    М13                     ,СМ := М13
         МОДА   СИМ1A(М12)              ,мод.адрес +1: СИМ1A(М12)
         НТЖ    0                       ,СМ ^= 0
         МОДА   L0027B                  ,мод.адрес +1: L0027B
L0014    ЗП     0                       ,0 := СМ
         СЧ     0(М11)                  ,СМ := 0(М11)
         СДА    64-12                   ,сдвиг СМ влево на 12
L0027    МОДА   L0027B                  ,мод.адрес +1: L0027B
         НТЖ    0                       ,СМ ^= 0
         МОДА   L0027B                  ,мод.адрес +1: L0027B
         Э75    0
L0027A   МОДА   0                       ,мод.адрес +1: 0
         МОДА   L0027B                  ,мод.адрес +1: L0027B
         Э70    0
         ПИНО   L0027(М12)              ,если ИР≠0 → L0027(М12)
L0027B   УИА    СИМ3(М13)               ,М13 := СИМ3
СИМ1A    МОДА   СИМ1                    ,мод.адрес +1: СИМ1
         СЧ     '1777'(М13)             ,СМ := '1777'(М13)
L0032    МОД    L0032                   ,мод.адрес по коду: L0032
         ЗП     '1777'(М13)             ,'1777' := СМ
         ЦИКЛ   L0014(М13)              ,М13-- и если ≠0 → повтор
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     0(М15)                  ,переход через М15
         МОДА   0                       ,мод.адрес +1: 0
         УИМ    М11                     ,М11 := СМ + стек
         УИМ    М13                     ,М13 := СМ + стек
         МОДА   L0032                   ,мод.адрес +1: L0032
         ЗПМ    0                       ,ЗП + магазин: 0
         УИА    СИМ3(М12)               ,М12 := СИМ3
         МОДА   0                       ,мод.адрес +1: 0
         МОД    L0032                   ,мод.адрес по коду: L0032
         СЧ     '1777'(М12)             ,СМ := '1777'(М12)
         МОДА   СИМ1                    ,мод.адрес +1: СИМ1
         ЗП     '1777'(М12)             ,'1777' := СМ
         ЦИКЛ   L0027A(М12)             ,М12-- и если ≠0 → повтор
         УИА    1(М12)                  ,М12 := 1
         ПБ     L0030                   ,переход на L0030
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     '4004'                  ,СМ := '4004'
         УИМ                            ,УИ + магазин
         СЧ     '4004'                  ,СМ := '4004'
         ЗП     0                       ,0 := СМ
         ЗП     '4004'                  ,'4004' := СМ
         ЗП     0                       ,0 := СМ

