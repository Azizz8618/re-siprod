***************************************************
* SKZONA - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5120 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 52 команд
*   Вход: SKZONA
*   Выход: SKZOND (возврат через М15)
*   Абсолютные символы: A31745 = 31745, A4096 = 4096
*   Регистры: М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), 
*   М13 (счётчик), М15 (адрес возврата)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 SKZONA1024
*   002 SKZONA1040
*   003 A31745
*   004 SKZONA2
*   005 A4096
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   V0     32
*
*** КОД МОДУЛЯ
*
SKZONA   СТАРТ  0
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         МОДА   V0                      ,мод.адрес := V0
         ЗПМ    0                       ,по адресу V0 := СМ (в магазин)
         УИА    0(М12)                  ,М12 := база модуля
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SKZONB   СЧ     0(М13)                  ,СМ := смещение в буфере 0
         УИ     М13                     ,М13 := СМ
         СЧИ    М13                     ,СМ := М13
         МОДА   GETA(М12)               ,мод.адрес := GETA(М12)
         НТЖ    0                       ,СМ ^= слово по адресу GETA+М12
         МОДА   GET                     ,мод.адрес := GET
         ЗП     0                       ,по адресу GET := СМ
         СЧ     0(М11)                  ,СМ := смещение в буфере 0
         СДА    64-12
         МОДА   GET                     ,мод.адрес := GET
         НТЖ    0                       ,СМ ^= слово по адресу GET
         МОДА   GET                     ,мод.адрес := GET
         Э75    0
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         МОДА   GET                     ,мод.адрес := GET
         Э70    0
         ПИНО   SKZOND(М12)             ,если ИР≠0 → SKZOND(М12)
         УИА    A31745(М13)             ,М13 := адрес A31745
SKZONC   МОДА   SKZONA1024              ,мод.адрес := SKZONA1024
         СЧ     '1777'(М13)             ,СМ := смещение в буфере 1023
         МОД    V0                      ,мод.адрес := код из V0
         ЗП     '1777'(М13)             ,смещение в буфере 1023 := СМ
         ЦИКЛ   SKZONC(М13)             ,М13-- и если ≠0 → повтор
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SKZOND   ПБ     0(М15)                  ,переход через М15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         УИМ    М11                     ,М11 := СМ; СМ := из магазина
         УИМ    М13                     ,М13 := СМ; СМ := из магазина
         МОДА   V0                      ,мод.адрес := V0
         ЗПМ    0                       ,по адресу V0 := СМ (в магазин)
         УИА    A31745(М12)             ,М12 := адрес A31745
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SKZONE   МОД    V0                      ,мод.адрес := код из V0
         СЧ     '1777'(М12)             ,СМ := параметр вызова ОС 1023
         МОДА   SKZONA1024              ,мод.адрес := SKZONA1024
         ЗП     '1777'(М12)             ,параметр вызова ОС 1023 := СМ
         ЦИКЛ   SKZONE(М12)             ,М12-- и если ≠0 → повтор
         УИА    1(М12)                  ,М12 := адрес 1
         ПБ     SKZONB                  ,переход на SKZONB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
GET      СЧ     '4004'                  ,СМ := '4004'
         УИМ                            ,ИР := СМ; СМ := из магазина
GETA     СЧ     '4004'                  ,СМ := '4004'
         ЗП     0                       ,по адресу 0 := СМ
         ЗП     '4004'                  ,'4004' := СМ
         ЗП     0                       ,по адресу 0 := СМ
V0       ПАМ    1
	ФИНИШ

