***************************************************
* RMAKR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 9600 образа SIPROD.BIN
*   Длина при загрузке: 402 слов, 168 команд
*   Вход: RMAKR
*   Выход: PAPAPR:F5, PAPAPR:F5, PAPRAP:EGO86F, PAPRAP:INS25C, 
*   PAPRAP:EGO86K, PAPRAP:EGO86K, PAPRAP:Б7ЗФA, F13 (возврат через М12), 
*   POP (возврат через М10)
*   ЗАГОТОВКА МАКРОСОВ 18 И 19: ШАБЛОНЫ ЗАГОЛОВКОВ И
*   ТАБЛИЦА ПАРАМЕТРОВ ДЛЯ РЕЖИМА *SUB.
*   Внешние: COMCON, EGO, PAGE, RSYMB, RASPS1, IMUI
*   Смещения в COMCON: 20
*   Смещения в EGO: 7200, 8600, 8601
*   Смещения в PAGE: 1
*   Смещения в кадре (М7): общие 0-5, 7-10, свои 11-15
*   Регистры: М1 (индекс: база модуля), М2 (рабочий регистр), 
*   М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 COMCON
*   002 COMCON20
*   003 EGO
*   004 EGO7200
*   005 EGO8600
*   006 EGO8601
*   007 PAGE
*   008 RSYMB
*   009 RASPS1
*   010 IMUI
*   011 EGO39967
*   012 PAGE1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     124
*   К1     125
*   К2     126
*   V0     134
*   V2     136
*   V4     140
*   V5     141
*   V6     142
*   V7     143
*   V8     144
*   V9     145
*   V10    146
*
*** КОД МОДУЛЯ
*
RMAKR    СТАРТ  0
         УИА    FRAME(М16)              ,М16 := адрес FRAME
         ПБ     F13                     ,переход на F13
*
FRAME    МОД    V9                      ,мод.адрес := код из V9
         СЧ     0                       ,СМ := слово по адресу V9
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     0(М7)                   ,СМ -= слот кадра 0
         УИА    COMCON20(М16)           ,М16 := адрес COMCON20
         ПВ     IMUI(М15)               ,вызов через М15
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         МОДА   EGO8600                 ,мод.адрес := EGO8600
         СЧ     0                       ,СМ := слово по адресу EGO8600
         УИА    COMCON20(М16)           ,М16 := адрес COMCON20
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     EGO39A                  ,переход на EGO39A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO399   СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     9(М7)                   ,СМ += слот кадра 9
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         СЧ     7(М7)                   ,СМ := слот кадра 7
         СЛ     9(М7)                   ,СМ += слот кадра 9
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         МОД    V5                      ,мод.адрес := код из V5
         УИА    0(М1)                   ,М1 := код из V5
         МОДА   V9(М1)                  ,мод.адрес := V9(М1)
         СЧ     0                       ,СМ := слово по адресу V9+М1
         МОД    V4                      ,мод.адрес := код из V4
         УИА    0(М2)                   ,М2 := код из V4
         МОДА   EGO39967(М2)            ,мод.адрес := EGO39967(М2)
         ЗП     0                       ,по адресу EGO39967+М2 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     9(М7)                   ,СМ := слот кадра 9
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO39A   МОДА   COMCON20                ,мод.адрес := COMCON20
         ВЧОБ   0                       ,СМ := слово по адресу COMCON20 - СМ
         ПО     EGO399                  ,если СМ=0 → EGO399
         МОДА   EGO8600                 ,мод.адрес := EGO8600
         СЧ     0                       ,СМ := слово по адресу EGO8600
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         МОДА   EGO8600                 ,мод.адрес := EGO8600
         ЗП     0                       ,по адресу EGO8600 := СМ
         МОД    V9                      ,мод.адрес := код из V9
         СЧ     0                       ,СМ := слово по адресу V9
         ВЧ     3(М7)                   ,СМ -= слот кадра 3
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F9                      ,если СМ=0 → F9
         ПБ     PAGE1A                  ,переход на PAGE1A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F9       ПБ     PAGE1B                  ,переход на PAGE1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PAGE1A   ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PAGE1B   СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         МОДА   PAGE1                   ,мод.адрес := PAGE1
         СЧ     0                       ,СМ := слово по адресу PAGE1
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     12(М7)                  ,слот кадра 12 := СМ
         СЧ     5(М7)                   ,СМ := слот кадра 5
         ЗП     13(М7)                  ,слот кадра 13 := СМ
         СЧ     3(М7)                   ,СМ := слот кадра 3
         СЧИМ                           ,в магазин; СМ := ИР
         МОД    V9                      ,мод.адрес := код из V9
         СЧ     0                       ,СМ := слово по адресу V9
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F3                      ,если СМ=0 → F3
         ПБ     F2                      ,переход на F2
*
F3       ПБ     PAGE1D                  ,переход на PAGE1D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2       СЧ     2(М7)                   ,СМ := слот кадра 2
         ЗП     13(М7)                  ,слот кадра 13 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     4(М7)                   ,СМ := слот кадра 4
         СЧИМ                           ,в магазин; СМ := ИР
         МОД    V9                      ,мод.адрес := код из V9
         СЧ     0                       ,СМ := слово по адресу V9
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     PAGE1C                  ,если СМ=0 → PAGE1C
         ПБ     PAGE1D                  ,переход на PAGE1D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PAGE1C   МОДА   PAGE1                   ,мод.адрес := PAGE1
         СЧ     0                       ,СМ := слово по адресу PAGE1
         ЗП     12(М7)                  ,слот кадра 12 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PAGE1D   УИА    V6(М16)                 ,М16 := адрес V6
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         МОД    V2                      ,мод.адрес := код из V2
         УИА    0(М1)                   ,М1 := код из V2
         МОДА   EGO39967(М1)            ,мод.адрес := EGO39967(М1)
         УИА    0(М16)                  ,М16 := адрес EGO39967+М1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V7(М16)                 ,М16 := адрес V7
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V8(М16)                 ,М16 := адрес V8
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RASPS1(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     3(М7)                   ,СМ := слот кадра 3
         СЧИМ                           ,в магазин; СМ := ИР
         МОД    V9                      ,мод.адрес := код из V9
         СЧ     0                       ,СМ := слово по адресу V9
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     EGO39B                  ,если СМ=0 → EGO39B
         ПБ     EGO39C                  ,переход на EGO39C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO39B   ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO39C   СЧ     13(М7)                  ,СМ := слот кадра 13
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     14(М7)                  ,СМ += слот кадра 14
