***************************************************
* TOKREZ - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18464 образа SIPROD.BIN
*   Длина при загрузке: 87 слов, 142 команд
*   Вход: TOKREZ
*   Выход: SPAUD:F1C, F6B (возврат через М12), POP (возврат через М10)
*   Внешние: SCANER, INS, KLAIDA, RSYMB, SYTINT, L8
*   Смещения в INS: 24, 25, 26
*   Смещения в SCANER: 1, 2
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-1, 3-6, 8-10, свои 12-14, 
*   вне кадра 2060
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес), 
*   М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 SCANER
*   002 SCANER1
*   003 SCANER2
*   004 INS
*   005 INS24
*   006 INS25
*   007 INS26
*   008 KLAIDA
*   009 RSYMB
*   010 SYTINT
*   011 L8
*   012 N1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К1     110
*   К3     112
*   V1     120
*   V3     122
*   V4     123
*   V5     124
*   V6     125
*   V7     126
*
*** КОД МОДУЛЯ
*
TOKREZ   СТАРТ  0
         УИА    F1(М16)                 ,М16 := адрес F1
         ПБ     F6B                     ,переход на F6B
*
F1       СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F1A      СЧ     '4014'(М7)              ,СМ := каталог задачи: элемент 12
         МОД    V1                      ,мод.адрес := код из V1
         УИА    0(М1)                   ,М1 := код из V1
         МОД    V6                      ,мод.адрес := код из V6
         ЗП     '4014'(М1)              ,каталог задачи: элемент 12 := СМ
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         ВЧОБ   4(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F1A                     ,если СМ=0 → F1A
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОД    V7                      ,мод.адрес := код из V7
         ЗП     0                       ,по адресу V7 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
L8A      ПВ     L8(М15)                 ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         СЧ     3(М7)                   ,СМ := слот кадра 3
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     SCANEA                  ,если СМ=0 → SCANEA
         ПБ     SCANEC                  ,переход на SCANEC
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEA   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS26                   ,мод.адрес := INS26
         ВЧ     0                       ,СМ -= слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     SCANEB                  ,если СМ≠0 → SCANEB
         ПБ     SCANEC                  ,переход на SCANEC
*
SCANEB   ПБ     L8A                     ,переход на L8A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEC   СЧ     5(М7)                   ,СМ := слот кадра 5
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     SCANED                  ,если СМ≠0 → SCANED
         ПБ     SCANEE                  ,переход на SCANEE
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANED   ПБ     F6                      ,переход на F6
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEE   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         УИА    INS(М16)                ,М16 := адрес INS
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V3(М16)                 ,М16 := адрес V3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V4(М16)                 ,М16 := адрес V4
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     SYTINT(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     10(М7)                  ,СМ := слот кадра 10
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОД    V7                      ,мод.адрес := код из V7
         СЧ     0                       ,СМ := слово по адресу V7
         СЛ     1(М7)                   ,СМ += слот кадра 1
         МОД    V7                      ,мод.адрес := код из V7
         ЗП     0                       ,по адресу V7 := СМ
         УИА    V4(М16)                 ,М16 := адрес V4
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         МОД    V6                      ,мод.адрес := код из V6
         УИА    0(М16)                  ,М16 := код из V6
         СЧИМ   М16                     ,в магазин; СМ := М16
         МОД    V7                      ,мод.адрес := код из V7
         УИА    0(М16)                  ,М16 := код из V7
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS26                   ,мод.адрес := INS26
         ВЧ     0                       ,СМ -= слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F10                     ,если СМ≠0 → F10
         ПБ     F10A                    ,переход на F10A
*
F10      ПБ     L8A                     ,переход на L8A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F10A     ПБ     F6A                     ,переход на F6A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F6       СЧ     6(М7)                   ,СМ := слот кадра 6
         ЗП     12(М7)                  ,слот кадра 12 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         УИА    V5(М16)                 ,М16 := адрес V5
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     KLAIDA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F6A      ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F6B      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         ЗПМ    14(М7)                  ,ЗП + магазин: 14(М7)
         ЗПМ    13(М7)                  ,ЗП + магазин: 13(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

