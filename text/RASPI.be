***************************************************
* RASPI - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5344 образа SIPROD.BIN
*   Длина при загрузке: 90 слов, 180 команд
*   Вход: RASPI
*   Выход: APNOTF:ENDKOA, BEGPG:APJC, CSTRIN:F8, CSTRIN:F8, GOTOPO:F5, 
*   ONEPLA:L0320, ONEPLA:L0320, PAPRAP:EGO86G, RASKOM:F1, RASKOM:F1B, 
*   RMAKR:EGO39B, TARNYB:NOTFH, TARNYB:F1, TWOPLA:NUM3A, WRIHOR:L0166, 
*   WRIHOR:L0166, WRILIN:F7B, WRILIN:F7B, WRINUM:F0, WRITUR:FOR1C, 
*   WRIVER:F18, L20 (возврат через М7), L12A (возврат через ячейка 0)
*   Внешние: SYTOBI, KONSTA
*   Смещения в SYTOBI: 1, 2, 3, 4, 5
*   Абсолютные символы: N1 = -1, N12 = -12, N7 = -7, N9 = -9
*   Смещения в кадре (М7): общие 0-1, свои 12, 16, 18
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), М13 (счётчик), 
*   М14 (смещение в буфере), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 SYTOBI
*   002 KONSTA
*   003 SYTOBI1
*   004 SYTOBI2
*   005 SYTOBI3
*   006 SYTOBI4
*   007 SYTOBI5
*   008 N7
*   009 N12
*   010 N1
*   011 N9
*
*** КОД МОДУЛЯ
*
RASPI    СТАРТ  0
         СЧИМ   М7                      ,в магазин; СМ := М7
         УИА    L12(М7)                 ,М7 := адрес L12
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L20      ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         УИ     М16                     ,М16 := СМ
         ЗПМ    22(М12)                 ,ЗП + магазин: 22(М12)
         УИ     М13                     ,М13 := СМ
         ЗПМ    20(М12)                 ,ЗП + магазин: 20(М12)
         УИ     М11                     ,М11 := СМ
         ЗПМ    19(М12)                 ,ЗП + магазин: 19(М12)
         УИ     М14                     ,М14 := СМ
         ЗП     21(М12)                 ,параметр вызова ОС 21 := СМ
         МОД    20(М12)                 ,мод.адрес := код из 20(М12)
         СЧ     0                       ,СМ := слово по адресу 20+М12
         СЛ     3(М10)                  ,СМ += поле блока вызывающего 3
         УИ     М15                     ,М15 := СМ
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИ     М13                     ,М13 := СМ
         МОД    19(М12)                 ,мод.адрес := код из 19(М12)
         СЧ     0                       ,СМ := слово по адресу 19+М12
         СЛ     3(М10)                  ,СМ += поле блока вызывающего 3
         УИ     М11                     ,М11 := СМ
         СЧ     0(М14)                  ,СМ := смещение в буфере 0
         МОДА   0(М13)                  ,мод.адрес := 0(М13)
         СДА    64(М11)
         МОДА   0(М15)                  ,мод.адрес := 0(М15)
         И      9(М10)                  ,СМ &= поле блока вызывающего 9
         ПБ     0(М7)                   ,переход через М7
*
L12      ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ЗП     0(М16)                  ,ячейка мод.адреса 0 := СМ
L12A     МОД    12(М12)                 ,мод.адрес := код из 12(М12)
         УИА    0(М7)                   ,М7 := код из 12+М12
         СЧ     0(М17)                  ,СМ := поле контекста 0
         РЖА    '6'                     ,РЖ := 6 (обращение к ОС)
         МОД    9(М12)                  ,мод.адрес := код из 9(М12)
         ПБ     0                       ,переход по адресу в мод.адресе
*
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    11(М12)                 ,ЗП + магазин: 11(М12)
         ЗПМ    18(М12)                 ,ЗП + магазин: 18(М12)
         СЧИМ   М7                      ,в магазин; СМ := М7
         УИА    OR(М7)                  ,М7 := адрес OR
         ПБ     L20                     ,переход на L20
*
OR       ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ПВ     SYTOBI3(М15)            ,вызов через М15
         МОД    18(М12)                 ,мод.адрес := код из 18(М12)
         СЧМ    0                       ,в магазин; СМ := слово по адресу 18+М
         ПВ     SYTOBI5(М15)            ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЛИ    М16(М7)                 ,М16 += М7
         УИИ    М13(М11)                ,М13 := М11
         МОД    11(М12)                 ,мод.адрес := код из 11(М12)
         СЧ     0                       ,СМ := слово по адресу 11+М12
         УИ     М11                     ,М11 := СМ
         СЛИА   N7(М13)                 ,М13 += N7
         СЧ     0                       ,СМ := 0
         ЗП     11(М12)                 ,параметр вызова ОС 11 := СМ
         СЛИА   N12(М11)                ,М11 += N12
         СЧИ    М11                     ,СМ := М11
         И      4(М10)                  ,СМ &= поле блока вызывающего 4
         ПЕ     GETR                    ,если СМ≠0 → GETR
         СЧ     '116'(М10)              ,СМ := поле блока вызывающего 78
         ЗП     8(М12)                  ,параметр вызова ОС 8 := СМ
L11      СЛИА   N1(М11)                 ,М11 += N1
         ПВ     SYTOBI2(М15)            ,вызов через М15
         ПИНО   L11(М11)                ,если ИР≠0 → L11(М11)
         УИА    12(М11)                 ,М11 := адрес 12
LOOP     СЛИА   N1(М11)                 ,М11 += N1
         СЧ     0(М17)                  ,СМ := поле контекста 0
         СДА    64-4
         ЗП     0(М17)                  ,поле контекста 0 := СМ
         СЧМР   64-64                   ,СМ := РМР (результат мантиссы)
         ЗП     8(М12)                  ,параметр вызова ОС 8 := СМ
         ИЛИ    11(М12)                 ,СМ |= параметр вызова ОС 11
         ПО     GET                     ,если СМ=0 → GET
         СЧ     8(М12)                  ,СМ := параметр вызова ОС 8
         ИЛИ    '117'(М10)              ,СМ |= поле блока вызывающего 79
         ЗП     8(М12)                  ,параметр вызова ОС 8 := СМ
         ЗП     11(М12)                 ,параметр вызова ОС 11 := СМ
         ПВ     SYTOBI2(М15)            ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПИНО   LOOP(М11)               ,если ИР≠0 → LOOP(М11)
         ПБ     LOOPA                   ,переход на LOOPA
*
GET      СЧ     '116'(М10)              ,СМ := поле блока вызывающего 78
         ПИНО   PUT(М11)                ,если ИР≠0 → PUT(М11)
         СЧ     '117'(М10)              ,СМ := поле блока вызывающего 79
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PUT      ЗП     8(М12)                  ,параметр вызова ОС 8 := СМ
         ПВ     SYTOBI2(М15)            ,вызов через М15
         ПИНО   LOOP(М11)               ,если ИР≠0 → LOOP(М11)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LOOPA    СЛИА   N1(М17)                 ,М17 += N1
         ПБ     L12A                    ,переход на L12A
*
GETR     СЧИ    М11                     ,СМ := М11
         СДА    64-2
         СЛИА   12(М11)                 ,М11 += 12
         УИМ    М15                     ,М15 := СМ; СМ := из магазина
         СДА    64(М15)
         ЗП     0(М17)                  ,поле контекста 0 := СМ
         ПБ     LOOP                    ,переход на LOOP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    11(М12)                 ,ЗП + магазин: 11(М12)
         ЗПМ    18(М12)                 ,ЗП + магазин: 18(М12)
         СЧИМ   М7                      ,в магазин; СМ := М7
         УИА    ORA(М7)                 ,М7 := адрес ORA
         ПБ     L20                     ,переход на L20
*
ORA      ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         ПВ     SYTOBI3(М15)            ,вызов через М15
         СДА    64-8
         МОД    18(М12)                 ,мод.адрес := код из 18(М12)
         СЧМ    0                       ,в магазин; СМ := слово по адресу 18+М
         ПВ     SYTOBI5(М15)            ,вызов через М15
         СЛИ    М16(М7)                 ,М16 += М7
         УИИ    М13(М11)                ,М13 := М11
         СЛИА   N7(М13)                 ,М13 += N7
         СЧ     0                       ,СМ := 0
         УИА    N9(М11)                 ,М11 := адрес N9
         ЗП     7(М12)                  ,параметр вызова ОС 7 := СМ
         УИА    0(М7)                   ,М7 := база модуля
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LOOPB    СЧ     0(М17)                  ,СМ := поле контекста 0
         СДА    64-4
         ЗП     0(М17)                  ,поле контекста 0 := СМ
         СЧМР   64-64                   ,СМ := РМР (результат мантиссы)
         ЗП     8(М12)                  ,параметр вызова ОС 8 := СМ
         ИЛИ    7(М12)                  ,СМ |= параметр вызова ОС 7
         ПО     L0224                   ,если СМ=0 → L0224
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LOOPC    СЛИА   1(М7)                   ,М7 += 1
         СЧ     8(М12)                  ,СМ := параметр вызова ОС 8
         ИЛИ    '117'(М10)              ,СМ |= поле блока вызывающего 79
         ЗП     8(М12)                  ,параметр вызова ОС 8 := СМ
         ЗП     7(М12)                  ,параметр вызова ОС 7 := СМ
         ПВ     SYTOBI2(М15)            ,вызов через М15
         ЦИКЛ   LOOPB(М11)              ,М11-- и если ≠0 → повтор
         СЧИ    М7                      ,СМ := М7
         ИЛИ    3(М10)                  ,СМ |= поле блока вызывающего 3
         МОД    11(М12)                 ,мод.адрес := код из 11(М12)
         ЗП     0                       ,по адресу 11+М12 := СМ
         ПБ     LOOPA                   ,переход на LOOPA
*
L0224    ПИО    JMP(М11)                ,если ИР=0 → JMP(М11)
         СЛИА   1(М11)                  ,М11 += 1
         ПБ     LOOPB                   ,переход на LOOPB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
JMP      ПБ     LOOPC                   ,переход на LOOPC
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧИМ   М15                     ,в магазин; СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    18(М12)                 ,ЗП + магазин: 18(М12)
         СЧИМ   М7                      ,в магазин; СМ := М7
         УИА    L18(М7)                 ,М7 := адрес L18
         ПБ     L20                     ,переход на L20
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L18      МОД    18(М12)                 ,мод.адрес := код из 18(М12)
         СЧМ    0                       ,в магазин; СМ := слово по адресу 18+М
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИ     М11                     ,М11 := СМ
         УИИ    М13(М15)                ,М13 := М15
         МОДА   0(М13)                  ,мод.адрес := 0(М13)
         СЧ     9(М10)                  ,СМ := поле блока вызывающего 9
         МОДА   0(М13)                  ,мод.адрес := 0(М13)
         СДА    64(М11)
         НТЖ    2(М10)                  ,СМ ^= поле блока вызывающего 2
         И      0(М16)                  ,СМ &= ячейка мод.адреса 0
         ЗПМ    7(М12)                  ,ЗП + магазин: 7(М12)
         МОДА   0(М13)                  ,мод.адрес := 0(М13)
         СДА    64(М11)
         ИЛИ    7(М12)                  ,СМ |= параметр вызова ОС 7
         ЗП     0(М16)                  ,ячейка мод.адреса 0 := СМ
         ПБ     L12A                    ,переход на L12A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
	ФИНИШ

