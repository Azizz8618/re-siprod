***************************************************
* RASPI - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5344 образа SIPROD.BIN
*   Длина при загрузке: 90 слов, 180 команд
*   Вход: RASPI
*   Внешние: SYTOBIN, KONSTA
*   Смещения в SYTOBIN: 1, 2, 3, 4, 5
*   Регистры: М7, М10, М11, М12, М13, М14, М15, М16, М17
***************************************************
RASPI   СТАРТ  0
        СЧИМ   М7                       ,стек := М7, СМ := М7
        УИА    L20(М7)                  ,М7 := L20
        СЧИМ   М15                      ,стек := М15, СМ := М15
KONSTA  ПВ     KONSTA(М15)              ,вызов через М15
        ЗПМ    9(М12)                   ,ЗП + магазин: 9(М12)
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        ЗПМ    12(М12)                  ,ЗП + магазин: 12(М12)
        РЖА    '3'                      ,РЖ := '3'
        УИ     М16                      ,М16 := СМ
        ЗПМ    22(М12)                  ,ЗП + магазин: 22(М12)
        УИ     М13                      ,М13 := СМ
L0013   ЗПМ    20(М12)                  ,ЗП + магазин: 20(М12)
        УИ     М11                      ,М11 := СМ
        ЗПМ    19(М12)                  ,ЗП + магазин: 19(М12)
        УИ     М14                      ,М14 := СМ
        ЗП     21(М12)                  ,21 := СМ
L20     МОД    20(М12)                  ,мод.адрес по коду: 20(М12)
L19     СЧ     RASPI                    ,СМ := RASPI
        СЛ     KONSTA(М10)              ,СМ += KONSTA(М10)
        УИ     М15                      ,М15 := СМ
        ВЧОБ   RASPI                    ,СМ := (адрес) - СМ
        УИ     М13                      ,М13 := СМ
        МОД    19(М12)                  ,мод.адрес по коду: 19(М12)
        СЧ     RASPI                    ,СМ := RASPI
L0030   СЛ     KONSTA(М10)              ,СМ += KONSTA(М10)
        УИ     М11                      ,М11 := СМ
        СЧ     RASPI(М14)               ,СМ := RASPI(М14)
        МОДА   RASPI(М13)               ,мод.адрес +1: RASPI(М13)
        СДА    64(М11)                  ,сдвиг СМ на 64(М11)
        МОДА   RASPI(М15)               ,мод.адрес +1: RASPI(М15)
        И      9(М10)                   ,СМ &= 9(М10)
        ПБ     RASPI(М7)                ,переход через М7
        ИЛИ    3(М10)                   ,СМ |= 3(М10)
        ЗП     RASPI(М16)               ,RASPI := СМ
L12     МОД    12(М12)                  ,мод.адрес по коду: 12(М12)
        УИА    RASPI(М7)                ,М7 := RASPI
KONSTB  СЧ     RASPI(М17)               ,СМ := RASPI(М17)
        РЖА    '6'                      ,РЖ := '6'
        МОД    9(М12)                   ,мод.адрес по коду: 9(М12)
        ПБ     RASPI                    ,переход на RASPI
        СЧИМ   М15                      ,стек := М15, СМ := М15
        ПВ     KONSTA(М15)              ,вызов через М15
        ЗПМ    9(М12)                   ,ЗП + магазин: 9(М12)
        ЗПМ    11(М12)                  ,ЗП + магазин: 11(М12)
L0054   ЗПМ    18(М12)                  ,ЗП + магазин: 18(М12)
        СЧИМ   М7                       ,стек := М7, СМ := М7
L0056   УИА    L0030(М7)                ,М7 := L0030
        ПБ     KONSTA                   ,переход на KONSTA
L0060   ИЛИ    3(М10)                   ,СМ |= 3(М10)
SYTOBI  ПВ     SYTOBIN+3(М15)           ,вызов через М15
        МОД    18(М12)                  ,мод.адрес по коду: 18(М12)
        СЧМ    RASPI                    ,магазин + СЧ: RASPI
        ПВ     SYTOBIN+5(М15)           ,вызов через М15
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        СЛИ    М16(М7)                  ,М16 += М7
        УИИ    М13(М11)                 ,М13 := М11
        МОД    11(М12)                  ,мод.адрес по коду: 11(М12)
L0071   СЧ     RASPI                    ,СМ := RASPI
        УИ     М11                      ,М11 := СМ
        СЛИА   СИМ10(М13)               ,М13 += СИМ10
        СЧ     RASPI                    ,СМ := RASPI
        ЗП     11(М12)                  ,11 := СМ
        СЛИА   СИМ11(М11)               ,М11 += СИМ11
        СЧИ    М11                      ,СМ := М11
L0100   И      4(М10)                   ,СМ &= 4(М10)
        ПЕ     SYTOBI                   ,если СМ≠0 → SYTOBI
        СЧ     '116'(М10)               ,СМ := '116'(М10)
        ЗП     8(М12)                   ,8 := СМ
SYTOBA  СЛИА   СИМ12(М11)               ,М11 += СИМ12
        ПВ     SYTOBIN+2(М15)           ,вызов через М15
        ПИНО   L12(М11)                 ,если ИР≠0 → L12(М11)
        УИА    12(М11)                  ,М11 := 12
        СЛИА   СИМ12(М11)               ,М11 += СИМ12
        СЧ     RASPI(М17)               ,СМ := RASPI(М17)
L0112   СДА    64-4                     ,сдвиг СМ влево на 4
        ЗП     RASPI(М17)               ,RASPI := СМ
L0114   СЧМР   64-64                    ,СМ := РМР (результат мантиссы)
        ЗП     8(М12)                   ,8 := СМ
        ИЛИ    11(М12)                  ,СМ |= 11(М12)
        ПО     L0054                    ,если СМ=0 → L0054
        СЧ     8(М12)                   ,СМ := 8(М12)
SYTOBB  ИЛИ    '117'(М10)               ,СМ |= '117'(М10)
        ЗП     8(М12)                   ,8 := СМ
        ЗП     11(М12)                  ,11 := СМ
        ПВ     SYTOBIN+2(М15)           ,вызов через М15
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        ПИНО   KONSTB(М11)              ,если ИР≠0 → KONSTB(М11)
        ПБ     L0060                    ,переход на L0060
        СЧ     '116'(М10)               ,СМ := '116'(М10)
        ПИНО   L0056(М11)               ,если ИР≠0 → L0056(М11)
        СЧ     '117'(М10)               ,СМ := '117'(М10)
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        ЗП     8(М12)                   ,8 := СМ
        ПВ     SYTOBIN+2(М15)           ,вызов через М15
        ПИНО   KONSTB(М11)              ,если ИР≠0 → KONSTB(М11)
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        СЛИА   СИМ12(М17)               ,М17 += СИМ12
        ПБ     L19                      ,переход на L19
        СЧИ    М11                      ,СМ := М11
        СДА    64-2                     ,сдвиг СМ влево на 2
        СЛИА   12(М11)                  ,М11 += 12
        УИМ    М15                      ,М15 := СМ + стек
        СДА    64(М15)                  ,сдвиг СМ на 64(М15)
        ЗП     RASPI(М17)               ,RASPI := СМ
        ПБ     KONSTB                   ,переход на KONSTB
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        СЧИМ   М15                      ,стек := М15, СМ := М15
        ПВ     KONSTA(М15)              ,вызов через М15
        ЗПМ    9(М12)                   ,ЗП + магазин: 9(М12)
        ЗПМ    11(М12)                  ,ЗП + магазин: 11(М12)
        ЗПМ    18(М12)                  ,ЗП + магазин: 18(М12)
        СЧИМ   М7                       ,стек := М7, СМ := М7
        УИА    L0071(М7)                ,М7 := L0071
        ПБ     KONSTA                   ,переход на KONSTA
        ИЛИ    3(М10)                   ,СМ |= 3(М10)
        ПВ     SYTOBIN+3(М15)           ,вызов через М15
        СДА    64-8                     ,сдвиг СМ влево на 8
        МОД    18(М12)                  ,мод.адрес по коду: 18(М12)
        СЧМ    RASPI                    ,магазин + СЧ: RASPI
        ПВ     SYTOBIN+5(М15)           ,вызов через М15
        СЛИ    М16(М7)                  ,М16 += М7
        УИИ    М13(М11)                 ,М13 := М11
        СЛИА   СИМ10(М13)               ,М13 += СИМ10
        СЧ     RASPI                    ,СМ := RASPI
        УИА    СИМ13(М11)               ,М11 := СИМ13
        ЗП     7(М12)                   ,7 := СМ
        УИА    RASPI(М7)                ,М7 := RASPI
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        СЧ     RASPI(М17)               ,СМ := RASPI(М17)
        СДА    64-4                     ,сдвиг СМ влево на 4
        ЗП     RASPI(М17)               ,RASPI := СМ
        СЧМР   64-64                    ,СМ := РМР (результат мантиссы)
        ЗП     8(М12)                   ,8 := СМ
        ИЛИ    7(М12)                   ,СМ |= 7(М12)
        ПО     L0112                    ,если СМ=0 → L0112
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        СЛИА   1(М7)                    ,М7 += 1
        СЧ     8(М12)                   ,СМ := 8(М12)
        ИЛИ    '117'(М10)               ,СМ |= '117'(М10)
        ЗП     8(М12)                   ,8 := СМ
        ЗП     7(М12)                   ,7 := СМ
        ПВ     SYTOBIN+2(М15)           ,вызов через М15
        ЦИКЛ   L0100(М11)               ,М11-- и если ≠0 → повтор
        СЧИ    М7                       ,СМ := М7
        ИЛИ    3(М10)                   ,СМ |= 3(М10)
        МОД    11(М12)                  ,мод.адрес по коду: 11(М12)
        ЗП     RASPI                    ,RASPI := СМ
        ПБ     L0060                    ,переход на L0060
        ПИО    L0114(М11)               ,если ИР=0 → L0114(М11)
        СЛИА   1(М11)                   ,М11 += 1
        ПБ     L0100                    ,переход на L0100
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        ПБ     SYTOBA                   ,переход на SYTOBA
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        СЧИМ   М15                      ,стек := М15, СМ := М15
        ПВ     KONSTA(М15)              ,вызов через М15
        ЗПМ    9(М12)                   ,ЗП + магазин: 9(М12)
        ЗПМ    18(М12)                  ,ЗП + магазин: 18(М12)
        СЧИМ   М7                       ,стек := М7, СМ := М7
        УИА    SYTOBB(М7)               ,М7 := SYTOBB
        ПБ     KONSTA                   ,переход на KONSTA
        МОДА   RASPI                    ,мод.адрес +1: RASPI
        МОД    18(М12)                  ,мод.адрес по коду: 18(М12)
        СЧМ    RASPI                    ,магазин + СЧ: RASPI
        ВЧОБ   3(М10)                   ,СМ := (адрес) - СМ
        УИ     М11                      ,М11 := СМ
        УИИ    М13(М15)                 ,М13 := М15
        МОДА   RASPI(М13)               ,мод.адрес +1: RASPI(М13)
        СЧ     9(М10)                   ,СМ := 9(М10)
        МОДА   RASPI(М13)               ,мод.адрес +1: RASPI(М13)
        СДА    64(М11)                  ,сдвиг СМ на 64(М11)
        НТЖ    2(М10)                   ,СМ ^= 2(М10)
        И      RASPI(М16)               ,СМ &= RASPI(М16)
        ЗПМ    7(М12)                   ,ЗП + магазин: 7(М12)
        МОДА   RASPI(М13)               ,мод.адрес +1: RASPI(М13)
        СДА    64(М11)                  ,сдвиг СМ на 64(М11)
        ИЛИ    7(М12)                   ,СМ |= 7(М12)
        ЗП     RASPI(М16)               ,RASPI := СМ
        ПБ     L19                      ,переход на L19
        МОДА   RASPI                    ,мод.адрес +1: RASPI

