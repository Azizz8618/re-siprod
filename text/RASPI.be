***************************************************
* RASPI - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 5344 образа SIPROD.BIN
*   Длина при загрузке: 90 слов, 180 команд
*   Вход: RASPI
*   Внешние: SYTOBI, KONSTA
*   Смещения в SYTOBI: 1, 2, 3, 4, 5
*   Регистры: М7, М10, М11, М12, М13, М14, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 SYTOBI
*   002 KONSTA
*   003 SYTOBI1
*   004 SYTOBI2
*   005 SYTOBI3
*   006 SYTOBI4
*   007 SYTOBI5
*   008 СИМ10
*   009 СИМ11
*   010 СИМ12
*   011 СИМ13
*
RASPI    СТАРТ  0
         СЧИМ   М7                      ,стек := М7, СМ := М7
         УИА    L20(М7)                 ,М7 := L20
         СЧИМ   М15                     ,стек := М15, СМ := М15
KONSTB   ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         МОДА   0                       ,мод.адрес +1: 0
         ЗПМ    12(М12)                 ,ЗП + магазин: 12(М12)
         РЖА    '3'                     ,РЖ := '3'
         УИ     М16                     ,М16 := СМ
         ЗПМ    22(М12)                 ,ЗП + магазин: 22(М12)
         УИ     М13                     ,М13 := СМ
         ЗПМ    20(М12)                 ,ЗП + магазин: 20(М12)
         УИ     М11                     ,М11 := СМ
         ЗПМ    19(М12)                 ,ЗП + магазин: 19(М12)
         УИ     М14                     ,М14 := СМ
         ЗП     21(М12)                 ,21 := СМ
L20      МОД    20(М12)                 ,мод.адрес по коду: 20(М12)
L19      СЧ     0                       ,СМ := 0
         СЛ     3(М10)                  ,СМ += 3(М10)
         УИ     М15                     ,М15 := СМ
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИ     М13                     ,М13 := СМ
         МОД    19(М12)                 ,мод.адрес по коду: 19(М12)
         СЧ     0                       ,СМ := 0
L0030    СЛ     3(М10)                  ,СМ += 3(М10)
         УИ     М11                     ,М11 := СМ
         СЧ     0(М14)                  ,СМ := 0(М14)
         МОДА   0(М13)                  ,мод.адрес +1: 0(М13)
         СДА    64(М11)                 ,сдвиг СМ на 64(М11)
         МОДА   0(М15)                  ,мод.адрес +1: 0(М15)
         И      9(М10)                  ,СМ &= 9(М10)
         ПБ     0(М7)                   ,переход через М7
         ИЛИ    3(М10)                  ,СМ |= 3(М10)
         ЗП     0(М16)                  ,0 := СМ
L12      МОД    12(М12)                 ,мод.адрес по коду: 12(М12)
         УИА    0(М7)                   ,М7 := 0
KONSTC   СЧ     0(М17)                  ,СМ := 0(М17)
         РЖА    '6'                     ,РЖ := '6'
         МОД    9(М12)                  ,мод.адрес по коду: 9(М12)
         ПБ     0                       ,переход на 0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    11(М12)                 ,ЗП + магазин: 11(М12)
L0054    ЗПМ    18(М12)                 ,ЗП + магазин: 18(М12)
         СЧИМ   М7                      ,стек := М7, СМ := М7
L0056    УИА    L0030(М7)               ,М7 := L0030
         ПБ     KONSTB                  ,переход на KONSTB
L0060    ИЛИ    3(М10)                  ,СМ |= 3(М10)
SYTOBA   ПВ     SYTOBI3(М15)            ,вызов через М15
         МОД    18(М12)                 ,мод.адрес по коду: 18(М12)
         СЧМ    0                       ,магазин + СЧ: 0
         ПВ     SYTOBI5(М15)            ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         СЛИ    М16(М7)                 ,М16 += М7
         УИИ    М13(М11)                ,М13 := М11
         МОД    11(М12)                 ,мод.адрес по коду: 11(М12)
L0071    СЧ     0                       ,СМ := 0
         УИ     М11                     ,М11 := СМ
         СЛИА   СИМ10(М13)              ,М13 += СИМ10
         СЧ     0                       ,СМ := 0
         ЗП     11(М12)                 ,11 := СМ
         СЛИА   СИМ11(М11)              ,М11 += СИМ11
         СЧИ    М11                     ,СМ := М11
L0100    И      4(М10)                  ,СМ &= 4(М10)
         ПЕ     SYTOBA                  ,если СМ≠0 → SYTOBA
         СЧ     '116'(М10)              ,СМ := '116'(М10)
         ЗП     8(М12)                  ,8 := СМ
SYTOBB   СЛИА   СИМ12(М11)              ,М11 += СИМ12
         ПВ     SYTOBI2(М15)            ,вызов через М15
         ПИНО   L12(М11)                ,если ИР≠0 → L12(М11)
         УИА    12(М11)                 ,М11 := 12
         СЛИА   СИМ12(М11)              ,М11 += СИМ12
         СЧ     0(М17)                  ,СМ := 0(М17)
L0112    СДА    64-4                    ,сдвиг СМ влево на 4
         ЗП     0(М17)                  ,0 := СМ
L0114    СЧМР   64-64                   ,СМ := РМР (результат мантиссы)
         ЗП     8(М12)                  ,8 := СМ
         ИЛИ    11(М12)                 ,СМ |= 11(М12)
         ПО     L0054                   ,если СМ=0 → L0054
         СЧ     8(М12)                  ,СМ := 8(М12)
SYTOBC   ИЛИ    '117'(М10)              ,СМ |= '117'(М10)
         ЗП     8(М12)                  ,8 := СМ
         ЗП     11(М12)                 ,11 := СМ
         ПВ     SYTOBI2(М15)            ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПИНО   KONSTC(М11)             ,если ИР≠0 → KONSTC(М11)
         ПБ     L0060                   ,переход на L0060
         СЧ     '116'(М10)              ,СМ := '116'(М10)
         ПИНО   L0056(М11)              ,если ИР≠0 → L0056(М11)
         СЧ     '117'(М10)              ,СМ := '117'(М10)
         МОДА   0                       ,мод.адрес +1: 0
         ЗП     8(М12)                  ,8 := СМ
         ПВ     SYTOBI2(М15)            ,вызов через М15
         ПИНО   KONSTC(М11)             ,если ИР≠0 → KONSTC(М11)
         МОДА   0                       ,мод.адрес +1: 0
         СЛИА   СИМ12(М17)              ,М17 += СИМ12
         ПБ     L19                     ,переход на L19
         СЧИ    М11                     ,СМ := М11
         СДА    64-2                    ,сдвиг СМ влево на 2
         СЛИА   12(М11)                 ,М11 += 12
         УИМ    М15                     ,М15 := СМ + стек
         СДА    64(М15)                 ,сдвиг СМ на 64(М15)
         ЗП     0(М17)                  ,0 := СМ
         ПБ     KONSTC                  ,переход на KONSTC
         МОДА   0                       ,мод.адрес +1: 0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    11(М12)                 ,ЗП + магазин: 11(М12)
         ЗПМ    18(М12)                 ,ЗП + магазин: 18(М12)
         СЧИМ   М7                      ,стек := М7, СМ := М7
         УИА    L0071(М7)               ,М7 := L0071
         ПБ     KONSTB                  ,переход на KONSTB
         ИЛИ    3(М10)                  ,СМ |= 3(М10)
         ПВ     SYTOBI3(М15)            ,вызов через М15
         СДА    64-8                    ,сдвиг СМ влево на 8
         МОД    18(М12)                 ,мод.адрес по коду: 18(М12)
         СЧМ    0                       ,магазин + СЧ: 0
         ПВ     SYTOBI5(М15)            ,вызов через М15
         СЛИ    М16(М7)                 ,М16 += М7
         УИИ    М13(М11)                ,М13 := М11
         СЛИА   СИМ10(М13)              ,М13 += СИМ10
         СЧ     0                       ,СМ := 0
         УИА    СИМ13(М11)              ,М11 := СИМ13
         ЗП     7(М12)                  ,7 := СМ
         УИА    0(М7)                   ,М7 := 0
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М17)                  ,СМ := 0(М17)
         СДА    64-4                    ,сдвиг СМ влево на 4
         ЗП     0(М17)                  ,0 := СМ
         СЧМР   64-64                   ,СМ := РМР (результат мантиссы)
         ЗП     8(М12)                  ,8 := СМ
         ИЛИ    7(М12)                  ,СМ |= 7(М12)
         ПО     L0112                   ,если СМ=0 → L0112
         МОДА   0                       ,мод.адрес +1: 0
         СЛИА   1(М7)                   ,М7 += 1
         СЧ     8(М12)                  ,СМ := 8(М12)
         ИЛИ    '117'(М10)              ,СМ |= '117'(М10)
         ЗП     8(М12)                  ,8 := СМ
         ЗП     7(М12)                  ,7 := СМ
         ПВ     SYTOBI2(М15)            ,вызов через М15
         ЦИКЛ   L0100(М11)              ,М11-- и если ≠0 → повтор
         СЧИ    М7                      ,СМ := М7
         ИЛИ    3(М10)                  ,СМ |= 3(М10)
         МОД    11(М12)                 ,мод.адрес по коду: 11(М12)
         ЗП     0                       ,0 := СМ
         ПБ     L0060                   ,переход на L0060
         ПИО    L0114(М11)              ,если ИР=0 → L0114(М11)
         СЛИА   1(М11)                  ,М11 += 1
         ПБ     L0100                   ,переход на L0100
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     SYTOBB                  ,переход на SYTOBB
         МОДА   0                       ,мод.адрес +1: 0
         СЧИМ   М15                     ,стек := М15, СМ := М15
         ПВ     KONSTA(М15)             ,вызов через М15
         ЗПМ    9(М12)                  ,ЗП + магазин: 9(М12)
         ЗПМ    18(М12)                 ,ЗП + магазин: 18(М12)
         СЧИМ   М7                      ,стек := М7, СМ := М7
         УИА    SYTOBC(М7)              ,М7 := SYTOBC
         ПБ     KONSTB                  ,переход на KONSTB
         МОДА   0                       ,мод.адрес +1: 0
         МОД    18(М12)                 ,мод.адрес по коду: 18(М12)
         СЧМ    0                       ,магазин + СЧ: 0
         ВЧОБ   3(М10)                  ,СМ := (адрес) - СМ
         УИ     М11                     ,М11 := СМ
         УИИ    М13(М15)                ,М13 := М15
         МОДА   0(М13)                  ,мод.адрес +1: 0(М13)
         СЧ     9(М10)                  ,СМ := 9(М10)
         МОДА   0(М13)                  ,мод.адрес +1: 0(М13)
         СДА    64(М11)                 ,сдвиг СМ на 64(М11)
         НТЖ    2(М10)                  ,СМ ^= 2(М10)
         И      0(М16)                  ,СМ &= 0(М16)
         ЗПМ    7(М12)                  ,ЗП + магазин: 7(М12)
         МОДА   0(М13)                  ,мод.адрес +1: 0(М13)
         СДА    64(М11)                 ,сдвиг СМ на 64(М11)
         ИЛИ    7(М12)                  ,СМ |= 7(М12)
         ЗП     0(М16)                  ,0 := СМ
         ПБ     L19                     ,переход на L19
         МОДА   0                       ,мод.адрес +1: 0

