***************************************************
* WRIHOR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 7712 образа SIPROD.BIN
*   Длина при загрузке: 79 слов, 132 команд
*   Вход: WRIHOR
*   Выход: WRITEH:WRIHOA+1, ADDRE (возврат через М12), 
*   ADDRE (возврат через М10)
*   Внешние: PAGE, NUM, KOMA, WHO, HOWSMB, RASPS, WRIKOR, IDII
*   Смещения в KOMA: 2, 7
*   Смещения в NUM: 2, 3
*   Смещения в PAGE: 1
*   Смещения в WHO: 1
*   Регистры: М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 PAGE
*   002 NUM
*   003 NUM2
*   004 NUM3
*   005 KOMA
*   006 KOMA2
*   007 KOMA7
*   008 WHO
*   009 WHO1
*   010 HOWSMB
*   011 RASPS
*   012 WRIKOR
*   013 PAGE1
*   014 IDII
*
WRIHOR   СТАРТ  0
         УИА    PAGE1A(М16)             ,М16 := PAGE1A
PAGE1A   ПБ     PUSH                    ,переход на PUSH
         МОДА   PAGE1                   ,мод.адрес +1: PAGE1
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИА    PUSHB(М16)              ,М16 := PUSHB
         ПВ     IDII(М15)               ,вызов через М15
         МОДА   PAGE1                   ,мод.адрес +1: PAGE1
         СЛ     0                       ,СМ += 0
         ЗП     8(М7)                   ,8 := СМ
         МОДА   PAGE1                   ,мод.адрес +1: PAGE1
         СЧ     0                       ,СМ := 0
         УИА    WRIKOB(М16)             ,М16 := WRIKOB
         ПВ     IDII(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         СЛ     0(М7)                   ,СМ += 0(М7)
         ЗП     9(М7)                   ,9 := СМ
         УИА    KOMA7(М16)              ,М16 := KOMA7
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHA(М16)              ,М16 := PUSHA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHA(М16)              ,М16 := PUSHA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         РЖА    '22'                    ,РЖ := '22'
         ПВ     WRIKOR(М15)             ,вызов через М15
         УИА    ADDRD(М16)              ,М16 := ADDRD
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    FRAME(М16)              ,М16 := FRAME
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    FRAME(М16)              ,М16 := FRAME
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHE(М16)              ,М16 := PUSHE
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHC(М16)              ,М16 := PUSHC
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADDRA(М16)              ,М16 := ADDRA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RASPS(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         УИА    PUSHE(М16)              ,М16 := PUSHE
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     HOWSMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         УИА    PUSHE(М16)              ,М16 := PUSHE
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WHO(М16)                ,М16 := WHO
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WHO1(М16)               ,М16 := WHO1
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         УИА    KOMA2(М16)              ,М16 := KOMA2
PUSH     СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADDRB(М16)              ,М16 := ADDRB
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHA(М16)              ,М16 := PUSHA
         СЧИМ   М16                     ,стек := М16, СМ := М16
WRIKOA   ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
ADDR     УИА    KOMA7(М16)              ,М16 := KOMA7
PUSHA    СЧИМ   М16                     ,стек := М16, СМ := М16
ADDRA    УИА    PUSHA(М16)              ,М16 := PUSHA
PUSHB    СЧИМ   М16                     ,стек := М16, СМ := М16
ADDRB    УИА    PUSHA(М16)              ,М16 := PUSHA
PUSHC    СЧИМ   М16                     ,стек := М16, СМ := М16
WRIKOB   ПВ     WRIKOR(М15)             ,вызов через М15
FRAME    МОДА   0                       ,мод.адрес +1: 0
ADDRC    УИА    PUSHD(М16)              ,М16 := PUSHD
PUSHD    СЧИМ   М16                     ,стек := М16, СМ := М16
ADDRD    УИА    ADDRC(М16)              ,М16 := ADDRC
PUSHE    СЧИМ   М16                     ,стек := М16, СМ := М16
ADDRE    УИА    ADDRC(М16)              ,М16 := ADDRC
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADDRE(М16)              ,М16 := ADDRE
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHC(М16)              ,М16 := PUSHC
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADDRA(М16)              ,М16 := ADDRA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RASPS(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         УИА    ADDRE(М16)              ,М16 := ADDRE
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     HOWSMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         УИА    ADDRE(М16)              ,М16 := ADDRE
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WHO(М16)                ,М16 := WHO
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WHO1(М16)               ,М16 := WHO1
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         УИА    ADDR(М16)               ,М16 := ADDR
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHA(М16)              ,М16 := PUSHA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADDRB(М16)              ,М16 := ADDRB
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     WRIKOA                  ,переход на WRIKOA
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    PUSHA(М7)               ,М7 := PUSHA
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

