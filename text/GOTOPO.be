***************************************************
* GOTOPO - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 9344 образа SIPROD.BIN
*   Длина при загрузке: 42 слов, 70 команд
*   Вход: GOTOPO
*   Выход: смещение 101, через М12, смещение 105, через М10
*   Внешние: WHO, HOWSMB, RASPS, WRIKOR
*   Смещения в WHO: 1
*   Регистры: М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 WHO
*   002 WHO1
*   003 HOWSMB
*   004 RASPS
*   005 WRIKOR
*
GOTOPO   СТАРТ  0
         УИА    JMP(М16)                ,М16 := JMP
JMP      ПБ     ADDR                    ,переход на ADDR
         УИА    PUSH(М16)               ,М16 := PUSH
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADDRA(М16)              ,М16 := ADDRA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADDRA(М16)              ,М16 := ADDRA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОД    FRAME                   ,мод.адрес по коду: FRAME
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHB(М16)              ,М16 := PUSHB
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHB(М16)              ,М16 := PUSHB
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    WRIKOA(М16)             ,М16 := WRIKOA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADDRB(М16)              ,М16 := ADDRB
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHA(М16)              ,М16 := PUSHA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RASPS(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
ADDR     УИА    WRIKOA(М16)             ,М16 := WRIKOA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     HOWSMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
WAIT     РЖА    '22'                    ,РЖ := '22'
         УИА    WRIKOA(М16)             ,М16 := WRIKOA
PUSH     СЧИМ   М16                     ,стек := М16, СМ := М16
ADDRA    УИА    WHO(М16)                ,М16 := WHO
PUSHA    СЧИМ   М16                     ,стек := М16, СМ := М16
ADDRB    УИА    WHO1(М16)               ,М16 := WHO1
PUSHB    СЧИМ   М16                     ,стек := М16, СМ := М16
WRIKOA   ПВ     WRIKOR(М15)             ,вызов через М15
FRAME    МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         УИА    PUSH(М16)               ,М16 := PUSH
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    PUSHA(М16)              ,М16 := PUSHA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADDRA(М16)              ,М16 := ADDRA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     WAIT                    ,переход на WAIT
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    ADDRA(М7)               ,М7 := ADDRA
         ЗПМ    5(М7)                   ,ЗП + магазин: 5(М7)
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

