         СЧ     0                       ,СМ := слово по адресу TAB3
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     STR25A                  ,если СМ≠0 → STR25A
         ПБ     STR25B                  ,переход на STR25B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR25A   ПБ     F15                     ,переход на F15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR25B   МОДА   STR25                   ,мод.адрес := STR25
         СЧ     0                       ,СМ := слово по адресу STR25
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   STR24                   ,мод.адрес := STR24
         СЧ     0                       ,СМ := слово по адресу STR24
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     DDRH                    ,если СМ=0 → DDRH
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   NUST1                   ,мод.адрес := NUST1
         СЧ     0                       ,СМ := слово по адресу NUST1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     DDRH                    ,если СМ≠0 → DDRH
         ПБ     DDRI                    ,переход на DDRI
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
DDRH     ПБ     F15                     ,переход на F15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
DDRI     МОДА   DDR                     ,мод.адрес := DDR
         СЧ     0                       ,СМ := слово по адресу DDR
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS26                   ,мод.адрес := INS26
         ВЧ     0                       ,СМ -= слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     NDAB1B                  ,если СМ≠0 → NDAB1B
         ПБ     NDAB1C                  ,переход на NDAB1C
*
NDAB1B   ПБ     F15                     ,переход на F15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NDAB1C   МОДА   NDAB1                   ,мод.адрес := NDAB1
         СЧ     0                       ,СМ := слово по адресу NDAB1
         ЗП     15(М7)                  ,слот кадра 15 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ENDSTR(М15)             ,вызов через М15
         СЧ     15(М7)                  ,СМ := слот кадра 15
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   NDAB1                   ,мод.адрес := NDAB1
         СЧ     0                       ,СМ := слово по адресу NDAB1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     BEGSTB                  ,если СМ=0 → BEGSTB
         ПБ     F15                     ,переход на F15
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
BEGSTB   ПВ     BEGSTR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F15      ПБ     F15B                    ,переход на F15B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F15A     УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К4(М7)                  ,М7 := адрес К4
         ЗПМ    18(М7)                  ,ЗП + магазин: 18(М7)
         ЗПМ    17(М7)                  ,ЗП + магазин: 17(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F15B     УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

