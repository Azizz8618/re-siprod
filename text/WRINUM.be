***************************************************
* WRINUM - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6752 образа SIPROD.BIN
*   Длина при загрузке: 81 слов, 136 команд
*   Вход: WRINUM
*   Выход: ONEPLA:L0320, TWOPLA:NUM3E, F0C (возврат через М12), 
*   POP (возврат через М10)
*   Внешние: NUM, KOMA, ONE, WHO, HOWSMB, RASPS, WRIKOR
*   Смещения в KOMA: 2, 7
*   Смещения в NUM: 2, 3
*   Смещения в ONE: 1, 2
*   Смещения в WHO: 1
*   Смещения в кадре (М7): общие 0-3, 6, 8-10, свои 11
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 NUM
*   002 NUM2
*   003 NUM3
*   004 KOMA
*   005 KOMA2
*   006 KOMA7
*   007 ONE
*   008 ONE1
*   009 ONE2
*   010 WHO
*   011 WHO1
*   012 HOWSMB
*   013 RASPS
*   014 WRIKOR
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     104
*   К1     105
*   К2     106
*   К3     107
*   К5     111
*   К6     112
*   К8     114
*   V1     116
*   V2     117
*   V3     120
*
*** КОД МОДУЛЯ
*
WRINUM   СТАРТ  0
         УИА    NUM2A(М16)              ,М16 := адрес NUM2A
         ПБ     F0C                     ,переход на F0C
*
NUM2A    МОДА   NUM2                    ,мод.адрес := NUM2
         СЧ     0                       ,СМ := слово по адресу NUM2
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОД    V3                      ,мод.адрес := код из V3
         СЧ     0                       ,СМ := слово по адресу V3
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     NUM2B                   ,если СМ≠0 → NUM2B
         ПБ     NUM2C                   ,переход на NUM2C
*
NUM2B    МОДА   NUM2                    ,мод.адрес := NUM2
         СЧ     0                       ,СМ := слово по адресу NUM2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     2(М7)                   ,СМ += слот кадра 2
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
NUM2C    МОДА   ONE1                    ,мод.адрес := ONE1
         СЧ     0                       ,СМ := слово по адресу ONE1
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     8(М7)                   ,СМ -= слот кадра 8
         ВЧ     3(М7)                   ,СМ -= слот кадра 3
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         УИА    KOMA7(М16)              ,М16 := адрес KOMA7
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     WRIKOR(М15)             ,вызов через М15
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К8(М16)                 ,М16 := адрес К8
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К8(М16)                 ,М16 := адрес К8
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К5(М16)                 ,М16 := адрес К5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RASPS(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     HOWSMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    WHO(М16)                ,М16 := адрес WHO
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    WHO1(М16)               ,М16 := адрес WHO1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К5(М16)                 ,М16 := адрес К5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     6(М7)                   ,СМ := слот кадра 6
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   NUM2                    ,мод.адрес := NUM2
         ВЧ     0                       ,СМ -= слово по адресу NUM2
         СЛ     1(М7)                   ,СМ += слот кадра 1
         МОДА   WHO                     ,мод.адрес := WHO
         ЗП     0                       ,по адресу WHO := СМ
         УИА    NUM(М16)                ,М16 := адрес NUM
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    WHO(М16)                ,М16 := адрес WHO
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    NUM2(М16)               ,М16 := адрес NUM2
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОД    V3                      ,мод.адрес := код из V3
         СЧ     0                       ,СМ := слово по адресу V3
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F0                      ,если СМ=0 → F0
         ПБ     F0A                     ,переход на F0A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0       ПБ     F0B                     ,переход на F0B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0A      УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К6(М16)                 ,М16 := адрес К6
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    KOMA(М16)               ,М16 := адрес KOMA
         СЧИМ   М16                     ,в магазин; СМ := М16
         МОД    V3                      ,мод.адрес := код из V3
         УИА    0(М16)                  ,М16 := код из V3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
F0B      ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0C      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         ЗПМ    11(М7)                  ,ЗП + магазин: 11(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

