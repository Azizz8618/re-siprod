***************************************************
* ENDSTR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 12032 образа SIPROD.BIN
*   Длина при загрузке: 22 слов, 42 команд
*   Вход: ENDSTR
*   Выход: BEGPG:STR25A, DOUBLE:BEGSTA, DOUBLE:BEGSTB, FILL:BEGSTA, 
*   HEADIN:F2, HEADIN:F1, NEWSTR:BEGSTA, RASTXT:BEGSTA, SEGTAB:F3, 
*   SEGTAB:BEGSTA, SPAUD:BEGSTA, SPAUD:BEGSTB, SPAUD:BEGSTC, SPAUD:BEGSTD, 
*   TITLE:STR26A, TITLE:MEDIUD, TITLE:F15B, L0034 (возврат через М12), 
*   POP (возврат через М10)
*   КОНЕЦ ТЕКСТОВОЙ СТРОКИ.
*   Внешние: NDAB, PAGE, REGIM, TOPAGE, BEGPG, ENDPG
*   Смещения в NDAB: 1
*   Смещения в PAGE: 1, 2, 3, 4, 5
*   Смещения в REGIM: 1
*   Смещения в кадре (М7): общие 0, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 NDAB
*   002 NDAB1
*   003 PAGE
*   004 PAGE1
*   005 PAGE2
*   006 PAGE3
*   007 PAGE4
*   008 PAGE5
*   009 REGIM
*   010 TOPAGE
*   011 BEGPG
*   012 ENDPG
*   013 REGIM1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     25
*
*** КОД МОДУЛЯ
*
ENDSTR   СТАРТ  0
         УИА    NDABA(М16)              ,М16 := адрес NDABA
         ПБ     L0034                   ,переход на L0034
*
NDABA    МОДА   NDAB                    ,мод.адрес := NDAB
         СЧ     0                       ,СМ := слово по адресу NDAB
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   PAGE3                   ,мод.адрес := PAGE3
         ВЧ     0                       ,СМ -= слово по адресу PAGE3
         МОДА   PAGE4                   ,мод.адрес := PAGE4
         ВЧ     0                       ,СМ -= слово по адресу PAGE4
         МОДА   REGIM1                  ,мод.адрес := REGIM1
         СЛ     0                       ,СМ += слово по адресу REGIM1
         ВЧ     0(М7)                   ,СМ -= слот кадра 0
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     JMP                     ,если СМ≠0 → JMP
         ПБ     ENDPGA                  ,переход на ENDPGA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
JMP      ПБ     TOPAGA                  ,переход на TOPAGA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ENDPGA   ПВ     ENDPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     BEGPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     JMPA                    ,переход на JMPA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
TOPAGA   ПВ     TOPAGE(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
JMPA     ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
L0034    УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'6400000000000001'
	ФИНИШ

