***************************************************
* ENDSTR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 12032 образа SIPROD.BIN
*   Длина при загрузке: 22 слов, 42 команд
*   Вход: ENDSTR
*   Выход: смещение 44, через М12, смещение 51, через М10
*   КОНЕЦ ТЕКСТОВОЙ СТРОКИ.
*   Внешние: NDAB, PAGE, REGIM, TOPAGE, BEGPG, ENDPG
*   Смещения в NDAB: 1
*   Смещения в PAGE: 1, 2, 3, 4, 5
*   Смещения в REGIM: 1
*   Регистры: М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 NDAB
*   002 NDAB1
*   003 PAGE
*   004 PAGE1
*   005 PAGE2
*   006 PAGE3
*   007 PAGE4
*   008 PAGE5
*   009 REGIM
*   010 TOPAGE
*   011 BEGPG
*   012 ENDPG
*   013 REGIM1
*
ENDSTR   СТАРТ  0
         УИА    NDABA(М16)              ,М16 := NDABA
NDABA    ПБ     NDABF                   ,переход на NDABF
         МОДА   NDAB                    ,мод.адрес +1: NDAB
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         МОДА   PAGE3                   ,мод.адрес +1: PAGE3
         ВЧ     0                       ,СМ -= 0
         МОДА   PAGE4                   ,мод.адрес +1: PAGE4
NDABB    ВЧ     0                       ,СМ -= 0
NDABC    МОДА   REGIM1                  ,мод.адрес +1: REGIM1
         СЛ     0                       ,СМ += 0
         ВЧ     0(М7)                   ,СМ -= 0(М7)
NDABD    РЖА    '22'                    ,РЖ := '22'
NDABE    ПЕ     NDABB                   ,если СМ≠0 → NDABB
NDABF    ПБ     NDABC                   ,переход на NDABC
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     NDABD                   ,переход на NDABD
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     ENDPG(М15)              ,вызов через М15
FRAME    МОДА   0                       ,мод.адрес +1: 0
         ПВ     BEGPG(М15)              ,вызов через М15
FRAMEA   МОДА   0                       ,мод.адрес +1: 0
         ПБ     NDABE                   ,переход на NDABE
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     TOPAGE(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     FRAME                   ,переход на FRAME
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    FRAMEA(М7)              ,М7 := FRAMEA
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

