***************************************************
* ENDSTR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 12032 образа SIPROD.BIN
*   Длина при загрузке: 22 слов, 42 команд
*   Вход: ENDSTR
*   Внешние: NDAB, PAGE, REGIM, TOPAGE, BEGPG, ENDPG
*   Смещения в NDAB: 1
*   Смещения в PAGE: 1, 2, 3, 4, 5
*   Смещения в REGIM: 1
*   Регистры: М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 NDAB
*   002 NDAB1
*   003 PAGE
*   004 PAGE1
*   005 PAGE2
*   006 PAGE3
*   007 PAGE4
*   008 PAGE5
*   009 REGIM
*   010 TOPAGE
*   011 BEGPG
*   012 ENDPG
*   013 REGIM1
*
ENDSTR   СТАРТ  0
         УИА    NDABA(М16)              ,М16 := NDABA
NDABA    ПБ     ENDPGA                  ,переход на ENDPGA
         МОДА   NDAB                    ,мод.адрес +1: NDAB
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         МОДА   PAGE3                   ,мод.адрес +1: PAGE3
         ВЧ     0                       ,СМ -= 0
         МОДА   PAGE4                   ,мод.адрес +1: PAGE4
L0010    ВЧ     0                       ,СМ -= 0
REGIMA   МОДА   REGIM1                  ,мод.адрес +1: REGIM1
         СЛ     0                       ,СМ += 0
         ВЧ     0(М7)                   ,СМ -= 0(М7)
L0014    РЖА    '22'                    ,РЖ := '22'
L0015    ПЕ     L0010                   ,если СМ≠0 → L0010
ENDPGA   ПБ     REGIMA                  ,переход на REGIMA
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     L0014                   ,переход на L0014
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     ENDPG(М15)              ,вызов через М15
BEGPGA   МОДА   0                       ,мод.адрес +1: 0
         ПВ     BEGPG(М15)              ,вызов через М15
TOPAGA   МОДА   0                       ,мод.адрес +1: 0
         ПБ     L0015                   ,переход на L0015
         МОДА   0                       ,мод.адрес +1: 0
         ПВ     TOPAGE(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     BEGPGA                  ,переход на BEGPGA
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    TOPAGA(М7)              ,М7 := TOPAGA
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

