***************************************************
* WCPABH - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6048 образа SIPROD.BIN
*   Длина при загрузке: 43 слов, 78 команд
*   Вход: WCPABH
*   Выход: LOOPB (возврат через М15)
*   Внешние: WДЛИHA, W24
*   Смещения в WДЛИHA: 1, 2
*   Абсолютные символы: N1 = -1, N24 = -24
*   Регистры: М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), 
*   М14 (смещение в буфере), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 WДЛИHA
*   002 W24
*   003 N1
*   004 WДЛИHA1
*   005 WДЛИHA2
*   006 N24
*
*** КОД МОДУЛЯ
*
WCPABH   СТАРТ  0
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         УИМ    М12                     ,М12 := СМ; СМ := из магазина
         УИ     М11                     ,М11 := СМ
         МОД    WДЛИHA                  ,мод.адрес := код из WДЛИHA
WДЛИHB   УИА    0(М16)                  ,М16 := код из WДЛИHA
         УИА    WДЛИHB(М14)             ,М14 := адрес WДЛИHB
WДЛИHC   СЧ     0(М11)                  ,СМ := смещение в буфере 0
         ПИО    WДЛИHD(М16)             ,если ИР=0 → WДЛИHD(М16)
         СДА    64+12
         ИЛИ    39(М14)                 ,СМ |= смещение в буфере 39
         СЧМ    0(М12)                  ,магазин + СЧ: 0(М12)
         СДА    64+12
         ИЛИ    39(М14)                 ,СМ |= смещение в буфере 39
         ВЧОБ   0(М17)                  ,СМ := (адрес) - СМ
         ПЕ     LOOP                    ,если СМ≠0 → LOOP
         НТЖ    39(М14)                 ,СМ ^= смещение в буфере 39
         ПЕ     LOOPA                   ,если СМ≠0 → LOOPA
         СЧ     0(М11)                  ,СМ := смещение в буфере 0
         И      37(М14)                 ,СМ &= смещение в буфере 37
         ИЛИ    39(М14)                 ,СМ |= смещение в буфере 39
         СЧМ    0(М12)                  ,магазин + СЧ: 0(М12)
         И      37(М14)                 ,СМ &= смещение в буфере 37
         ИЛИ    39(М14)                 ,СМ |= смещение в буфере 39
         ВЧОБ   0(М17)                  ,СМ := (адрес) - СМ
         ПЕ     LOOP                    ,если СМ≠0 → LOOP
         НТЖ    39(М14)                 ,СМ ^= смещение в буфере 39
         ПЕ     LOOPA                   ,если СМ≠0 → LOOPA
         СЛИА   1(М12)                  ,М12 += 1
         СЛИА   1(М11)                  ,М11 += 1
         СЛИА   N1(М16)                 ,М16 += N1
         ПБ     WДЛИHC                  ,переход на WДЛИHC
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LOOP     СЧ     38(М14)                 ,СМ := смещение в буфере 38
         ПБ     LOOPB                   ,переход на LOOPB
*
LOOPA    СЧ     40(М14)                 ,СМ := смещение в буфере 40
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LOOPB    РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     0(М15)                  ,переход через М15
*
WДЛИHD   МОД    WДЛИHA1                 ,мод.адрес := код из WДЛИHA1
         УИА    0(М16)                  ,М16 := код из WДЛИHA1
         ПИО    WДЛИHF(М16)             ,если ИР=0 → WДЛИHF(М16)
         СДА    64+24
         ИЛИ    39(М14)                 ,СМ |= смещение в буфере 39
         СЧМ    0(М12)                  ,магазин + СЧ: 0(М12)
         СДА    64+24
         ИЛИ    39(М14)                 ,СМ |= смещение в буфере 39
         ВЧОБ   0(М17)                  ,СМ := (адрес) - СМ
         ПЕ     LOOP                    ,если СМ≠0 → LOOP
         НТЖ    39(М14)                 ,СМ ^= смещение в буфере 39
         ПЕ     LOOPA                   ,если СМ≠0 → LOOPA
         МОД    WДЛИHA2                 ,мод.адрес := код из WДЛИHA2
         УИА    N24(М16)                ,М16 := адрес N24
         СЧ     0(М11)                  ,СМ := смещение в буфере 0
         МОДА   W24(М16)                ,мод.адрес := W24(М16)
         И      '4003'                  ,СМ &= '4003'
         ИЛИ    39(М14)                 ,СМ |= смещение в буфере 39
         СЧМ    0(М12)                  ,магазин + СЧ: 0(М12)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
WДЛИHE   МОДА   W24(М16)                ,мод.адрес := W24(М16)
         И      '4003'                  ,СМ &= '4003'
         ИЛИ    39(М14)                 ,СМ |= смещение в буфере 39
         ВЧОБ   0(М17)                  ,СМ := (адрес) - СМ
         ПЕ     LOOP                    ,если СМ≠0 → LOOP
         НТЖ    39(М14)                 ,СМ ^= смещение в буфере 39
         ПЕ     LOOPA                   ,если СМ≠0 → LOOPA
         СЧ     39(М14)                 ,СМ := смещение в буфере 39
         ПБ     LOOPB                   ,переход на LOOPB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
WДЛИHF   МОД    WДЛИHA2                 ,мод.адрес := код из WДЛИHA2
         УИА    0(М16)                  ,М16 := код из WДЛИHA2
         СЧ     0(М11)                  ,СМ := смещение в буфере 0
         СДА    64+24
         МОДА   W24(М16)                ,мод.адрес := W24(М16)
         И      '4003'                  ,СМ &= '4003'
         ИЛИ    39(М14)                 ,СМ |= смещение в буфере 39
         СЧМ    0(М12)                  ,магазин + СЧ: 0(М12)
         СДА    64+24
         ПБ     WДЛИHE                  ,переход на WДЛИHE
*

