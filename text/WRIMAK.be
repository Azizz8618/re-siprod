***************************************************
* WRIMAK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19584 образа SIPROD.BIN
*   Длина при загрузке: 62 слов, 106 команд
*   Вход: WRIMAK
*   Выход: SPAUD:SCAN30, F1E (возврат через М12), F1F (возврат через М10)
*   Внешние: MKR, RMK, NRM, VIE, KLAIDA, RNSYMB, IMUI
*   Смещения в MKR: 500, 501
*   Смещения в VIE: 1
*   Смещения в кадре (М7): общие 0-2, 4, 6-8, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 MKR
*   002 MKR500
*   003 MKR501
*   004 RMK
*   005 NRM
*   006 VIE
*   007 VIE1
*   008 KLAIDA
*   009 RNSYMB
*   010 IMUI
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     65
*   К2     67
*   К3     70
*   V1     73
*   V2     74
*   V3     75
*
*** КОД МОДУЛЯ
*
WRIMAK   СТАРТ  0
         УИА    NRMA(М16)               ,М16 := адрес NRMA
         ПБ     F1E                     ,переход на F1E
*
NRMA     МОДА   NRM                     ,мод.адрес := NRM
         СЧ     0                       ,СМ := слово по адресу NRM
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         МОДА   MKR501                  ,мод.адрес := MKR501
         СЛ     0                       ,СМ += слово по адресу MKR501
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F4                      ,если СМ=0 → F4
         ПБ     F4A                     ,переход на F4A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F4       ПБ     NRMB                    ,переход на NRMB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F4A      СЧ     4(М7)                   ,СМ := слот кадра 4
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     ADDR                    ,переход на ADDR
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NRMB     МОДА   NRM                     ,мод.адрес := NRM
         СЧ     0                       ,СМ := слово по адресу NRM
         УИА    К2(М16)                 ,М16 := адрес К2
         ПВ     IMUI(М15)               ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         ВЧ     2(М7)                   ,СМ -= слот кадра 2
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   VIE                     ,мод.адрес := VIE
         ЗП     0                       ,по адресу VIE := СМ
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   VIE1                    ,мод.адрес := VIE1
         ЗП     0                       ,по адресу VIE1 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   NRM                     ,мод.адрес := NRM
         СЧ     0                       ,СМ := слово по адресу NRM
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     F1                      ,если СМ≠0 → F1
         ПБ     F1A                     ,переход на F1A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1       ПБ     F1B                     ,переход на F1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1A      ПБ     F1C                     ,переход на F1C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1B      УИА    RMK(М16)                ,М16 := адрес RMK
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V3(М16)                 ,М16 := адрес V3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    VIE(М16)                ,М16 := адрес VIE
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RNSYMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F1C      УИА    RMK(М16)                ,М16 := адрес RMK
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    VIE1(М16)               ,М16 := адрес VIE1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RNSYMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   VIE                     ,мод.адрес := VIE
         СЧ     0                       ,СМ := слово по адресу VIE
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         МОДА   VIE                     ,мод.адрес := VIE
         ЗП     0                       ,по адресу VIE := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F1D                     ,переход на F1D
*
ADDR     УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     KLAIDA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F1D      ПБ     F1F                     ,переход на F1F
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1E      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1F      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'6400000000000000'
К2       КОНД   В'6400000000000002'
К3       КОНД   В'6400000000000005'
V0       ПАМ    1
V1       ПАМ    1
V2       ПАМ    1
V3       ПАМ    1
	ФИНИШ

