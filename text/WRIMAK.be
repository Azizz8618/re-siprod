***************************************************
* WRIMAK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19584 образа SIPROD.BIN
*   Длина при загрузке: 62 слов, 106 команд
*   Вход: WRIMAK
*   Выход: SPAUD:SCAN90+1, V1H (возврат через М12), 
*   V1H (возврат через М10)
*   Внешние: MKR, RMK, NRM, VIE, KLAIDA, RNSYMB, IMUI
*   Смещения в MKR: 500, 501
*   Смещения в VIE: 1
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 MKR
*   002 MKR500
*   003 MKR501
*   004 RMK
*   005 NRM
*   006 VIE
*   007 VIE1
*   008 KLAIDA
*   009 RNSYMB
*   010 IMUI
*
WRIMAK   СТАРТ  0
         УИА    NRMA(М16)               ,М16 := NRMA
NRMA     ПБ     V1A                     ,переход на V1A
         МОДА   NRM                     ,мод.адрес +1: NRM
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   0                       ,СМ := (адрес) - СМ
NRMB     МОДА   MKR501                  ,мод.адрес +1: MKR501
NRMC     СЛ     0                       ,СМ += 0
         РЖА    '22'                    ,РЖ := '22'
         ПО     NRMB                    ,если СМ=0 → NRMB
NRMD     ПБ     NRMC                    ,переход на NRMC
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     NRMD                    ,переход на NRMD
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     4(М7)                   ,СМ := 4(М7)
         ЗП     6(М7)                   ,6 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     VIEC                    ,переход на VIEC
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   NRM                     ,мод.адрес +1: NRM
         СЧ     0                       ,СМ := 0
NRME     УИА    V1D(М16)                ,М16 := V1D
IMUIA    ПВ     IMUI(М15)               ,вызов через М15
VIEA     РЖА    '3'                     ,РЖ := '3'
         ВЧ     1(М7)                   ,СМ -= 1(М7)
         ЗП     7(М7)                   ,7 := СМ
         ВЧ     2(М7)                   ,СМ -= 2(М7)
         ЗП     8(М7)                   ,8 := СМ
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   VIE                     ,мод.адрес +1: VIE
VIEB     ЗП     0                       ,0 := СМ
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   VIE1                    ,мод.адрес +1: VIE1
         ЗП     0                       ,0 := СМ
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   NRM                     ,мод.адрес +1: NRM
         СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     NRME                    ,если СМ≠0 → NRME
VIEC     ПБ     IMUIA                   ,переход на IMUIA
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     VIEA                    ,переход на VIEA
V1       МОДА   0                       ,мод.адрес +1: 0
V1A      ПБ     VIEB                    ,переход на VIEB
         МОДА   0                       ,мод.адрес +1: 0
         УИА    RMK(М16)                ,М16 := RMK
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V1H(М16)                ,М16 := V1H
V1B      СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    VIE(М16)                ,М16 := VIE
V1C      СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V1E(М16)                ,М16 := V1E
V1D      СЧИМ   М16                     ,стек := М16, СМ := М16
V1E      УИА    V1D(М16)                ,М16 := V1D
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RNSYMB(М15)             ,вызов через М15
V1F      МОДА   0                       ,мод.адрес +1: 0
V1G      РЖА    '3'                     ,РЖ := '3'
V1H      РЖА    '22'                    ,РЖ := '22'
         УИА    RMK(М16)                ,М16 := RMK
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V1G(М16)                ,М16 := V1G
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    VIE1(М16)               ,М16 := VIE1
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V1E(М16)                ,М16 := V1E
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V1D(М16)                ,М16 := V1D
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RNSYMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОДА   VIE                     ,мод.адрес +1: VIE
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         МОДА   VIE                     ,мод.адрес +1: VIE
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     V1                      ,переход на V1
         УИА    V1F(М16)                ,М16 := V1F
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     KLAIDA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     V1B                     ,переход на V1B
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    V1C(М7)                 ,М7 := V1C
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

