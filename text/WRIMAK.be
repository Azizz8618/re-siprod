        МОДА   *NRM*                    ,мод.адрес +1: *NRM*
        СЧ     WRIMAK                   ,СМ := WRIMAK
L0026   УИА    L0067(М16)               ,М16 := L0067
IMUI    ПВ     I*MU*I(М15)              ,вызов через М15
VIE     РЖА    '3'                      ,РЖ := '3'
        ВЧ     1(М7)                    ,СМ -= 1(М7)
        ЗП     7(М7)                    ,7 := СМ
        ВЧ     2(М7)                    ,СМ -= 2(М7)
        ЗП     8(М7)                    ,8 := СМ
        СЧ     WRIMAK(М7)               ,СМ := WRIMAK(М7)
        МОДА   *VIE*                    ,мод.адрес +1: *VIE*
VIE1    ЗП     WRIMAK                   ,WRIMAK := СМ
        СЧ     WRIMAK(М7)               ,СМ := WRIMAK(М7)
        МОДА   *VIE*+1                  ,мод.адрес +1: *VIE*+1
        ЗП     WRIMAK                   ,WRIMAK := СМ
        СЧ     1(М7)                    ,СМ := 1(М7)
        СЧИМ                            ,СЧИ + магазин
        МОДА   *NRM*                    ,мод.адрес +1: *NRM*
        СЧ     WRIMAK                   ,СМ := WRIMAK
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    WRIMAK(М17)              ,СМ ^= WRIMAK(М17)
        ПЕ     L0026                    ,если СМ≠0 → L0026
V1      ПБ     IMUI                     ,переход на IMUI
        МОДА   WRIMAK                   ,мод.адрес +1: WRIMAK
        ПБ     VIE                      ,переход на VIE
V12     МОДА   WRIMAK                   ,мод.адрес +1: WRIMAK
V13     ПБ     VIE1                     ,переход на VIE1
        МОДА   WRIMAK                   ,мод.адрес +1: WRIMAK
        УИА    *RMK*(М16)               ,М16 := *RMK*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    RNSYMA(М16)              ,М16 := RNSYMA
L0063   СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *VIE*(М16)               ,М16 := *VIE*
L0065   СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    RNSYMB(М16)              ,М16 := RNSYMB
L0067   СЧИМ   М16                      ,стек := М16, СМ := М16
RNSYMB  УИА    L0067(М16)               ,М16 := L0067
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     RNSYMB(М15)              ,вызов через М15
V14     МОДА   WRIMAK                   ,мод.адрес +1: WRIMAK
L0074   РЖА    '3'                      ,РЖ := '3'
RNSYMA  РЖА    '22'                     ,РЖ := '22'
        УИА    *RMK*(М16)               ,М16 := *RMK*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0074(М16)               ,М16 := L0074
