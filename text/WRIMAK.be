***************************************************
* WRIMAK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19584 образа SIPROD.BIN
*   Длина при загрузке: 62 слов, 106 команд
*   Вход: WRIMAK
*   Внешние: *MKR*, *RMK*, *NRM*, *VIE*, KLAIDA, RNSYMB, I*MU*I
*   Смещения в *MKR*: 500, 501
*   Смещения в *VIE*: 1
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
WRIMAK  СТАРТ  0
        УИА    NRM(М16)                 ,М16 := NRM
NRM     ПБ     V13                      ,переход на V13
        МОДА   *NRM*                    ,мод.адрес +1: *NRM*
        СЧ     WRIMAK                   ,СМ := WRIMAK
        РЖА    '3'                      ,РЖ := '3'
        ВЧОБ   WRIMAK                   ,СМ := (адрес) - СМ
MKR765  МОДА   *MKR*+765                ,мод.адрес +1: *MKR*+765
L0007   СЛ     WRIMAK                   ,СМ += WRIMAK
L0010   РЖА    '22'                     ,РЖ := '22'
        ПО     MKR765                   ,если СМ=0 → MKR765
NRM2    ПБ     L0007                    ,переход на L0007
        МОДА   WRIMAK                   ,мод.адрес +1: WRIMAK
        ПБ     NRM2                     ,переход на NRM2
