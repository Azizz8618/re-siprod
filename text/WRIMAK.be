        СЧ     WRIMAK                   ,СМ := WRIMAK
        РЖА    '3'                      ,РЖ := '3'
        СЛ     NRM(М7)                  ,СМ += NRM(М7)
        МОДА   *VIE*                    ,мод.адрес +1: *VIE*
        ЗП     WRIMAK                   ,WRIMAK := СМ
        РЖА    '22'                     ,РЖ := '22'
        ПБ     V12                      ,переход на V12
        УИА    V14(М16)                 ,М16 := V14
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     KLAIDA(М15)              ,вызов через М15
        МОДА   WRIMAK                   ,мод.адрес +1: WRIMAK
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПБ     L0063                    ,переход на L0063
        МОДА   WRIMAK                   ,мод.адрес +1: WRIMAK
        УИИ    М10(М7)                  ,М10 := М7
