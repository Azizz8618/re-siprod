***************************************************
* WRIMAK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19584 образа SIPROD.BIN
*   Длина при загрузке: 62 слов, 106 команд
*   Вход: WRIMAK
*   Внешние: MKR, RMK, NRM, VIE, KLAIDA, RNSYMB, IMUI
*   Смещения в MKR: 500, 501
*   Смещения в VIE: 1
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 MKR
*   002 MKR500
*   003 MKR501
*   004 RMK
*   005 NRM
*   006 VIE
*   007 VIE1
*   008 KLAIDA
*   009 RNSYMB
*   010 IMUI
*
WRIMAK   СТАРТ  0
         УИА    NRMA(М16)               ,М16 := NRMA
NRMA     ПБ     V1B                     ,переход на V1B
         МОДА   NRM                     ,мод.адрес +1: NRM
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   0                       ,СМ := (адрес) - СМ
MKR50A   МОДА   MKR501                  ,мод.адрес +1: MKR501
L0007    СЛ     0                       ,СМ += 0
         РЖА    '22'                    ,РЖ := '22'
         ПО     MKR50A                  ,если СМ=0 → MKR50A
NRMB     ПБ     L0007                   ,переход на L0007
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     NRMB                    ,переход на NRMB
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     4(М7)                   ,СМ := 4(М7)
         ЗП     6(М7)                   ,6 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     V1                      ,переход на V1
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   NRM                     ,мод.адрес +1: NRM
         СЧ     0                       ,СМ := 0
L0026    УИА    L0067(М16)              ,М16 := L0067
IMUIA    ПВ     IMUI(М15)               ,вызов через М15
VIEA     РЖА    '3'                     ,РЖ := '3'
         ВЧ     1(М7)                   ,СМ -= 1(М7)
         ЗП     7(М7)                   ,7 := СМ
         ВЧ     2(М7)                   ,СМ -= 2(М7)
         ЗП     8(М7)                   ,8 := СМ
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   VIE                     ,мод.адрес +1: VIE
VIE1A    ЗП     0                       ,0 := СМ
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   VIE1                    ,мод.адрес +1: VIE1
         ЗП     0                       ,0 := СМ
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   NRM                     ,мод.адрес +1: NRM
         СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     L0026                   ,если СМ≠0 → L0026
V1       ПБ     IMUIA                   ,переход на IMUIA
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     VIEA                    ,переход на VIEA
V1A      МОДА   0                       ,мод.адрес +1: 0
V1B      ПБ     VIE1A                   ,переход на VIE1A
         МОДА   0                       ,мод.адрес +1: 0
         УИА    RMK(М16)                ,М16 := RMK
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    RNSYMC(М16)             ,М16 := RNSYMC
L0063    СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    VIE(М16)                ,М16 := VIE
L0065    СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    RNSYMA(М16)             ,М16 := RNSYMA
L0067    СЧИМ   М16                     ,стек := М16, СМ := М16
RNSYMA   УИА    L0067(М16)              ,М16 := L0067
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RNSYMB(М15)             ,вызов через М15
V1C      МОДА   0                       ,мод.адрес +1: 0
L0074    РЖА    '3'                     ,РЖ := '3'
RNSYMC   РЖА    '22'                    ,РЖ := '22'
         УИА    RMK(М16)                ,М16 := RMK
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    L0074(М16)              ,М16 := L0074
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    VIE1(М16)               ,М16 := VIE1
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    RNSYMA(М16)             ,М16 := RNSYMA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    L0067(М16)              ,М16 := L0067
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RNSYMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОДА   VIE                     ,мод.адрес +1: VIE
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         МОДА   VIE                     ,мод.адрес +1: VIE
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     V1A                     ,переход на V1A
         УИА    V1C(М16)                ,М16 := V1C
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     KLAIDA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     L0063                   ,переход на L0063
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    L0065(М7)               ,М7 := L0065
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

