***************************************************
* ENDKOR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6400 образа SIPROD.BIN
*   Длина при загрузке: 54 слов, 90 команд
*   Вход: ENDKOR
*   Выход: APNOTF:F1C, CSTRIN:F8, IPONUM:F4, NAMENF:F1, NOTFOR:INS25A, 
*   NOTFOR:TYPEA, NOTFOR:F0, NOTFOR:F0A, ONEPLA:L0320, ONEPLA:L0320, 
*   ONEPLA:L0320, ONEPLA:L0320, RASKOM:F1, RASKOM:F20A, SCHEMA:FOPJ, 
*   SCHEMA:NUSTE, TARNYB:TYPEA, TARNYB:TYPE1A, TARNYB:NOTFE, TARNYB:F1A, 
*   TWOPLA:F0, TWOPLA:F13A, TWOPLA:F3, TWOPLA:NUM3F, TWOPLA:F13C, 
*   WRIIPO:IPONUA, WRIIPO:SCANEG, WRIIPO:F11A, WRIKOR:F3A, WRILIN:F7B, 
*   WRIVER:CENA, F0A (возврат через М12), F0B (возврат через М10)
*   ЗАКРЫТИЕ БУФЕРА ВЫВОДА.
*   Внешние: EGO, KORT, KLAIDA, IMUI
*   Смещения в EGO: 7200, 8600, 8601
*   Смещения в KORT: 14
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-2, 5-7, 10, вне кадра 2059
*   Регистры: М1 (индекс: база модуля), М2 (рабочий регистр), 
*   М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 EGO
*   002 EGO7200
*   003 EGO8600
*   004 EGO8601
*   005 KORT
*   006 KORT14
*   007 KLAIDA
*   008 IMUI
*   009 KORT32767
*   010 EGO39967
*   011 N1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К1     56
*   К2     57
*   К4     61
*   V2     64
*   V3     65
*
*** КОД МОДУЛЯ
*
ENDKOR   СТАРТ  0
         УИА    KORT1A(М16)             ,М16 := адрес KORT1A
         ПБ     F0A                     ,переход на F0A
*
KORT1A   СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   KORT14                  ,мод.адрес := KORT14
         СЧ     0                       ,СМ := слово по адресу KORT14
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     EGO860                  ,если СМ=0 → EGO860
         ПБ     EGO86A                  ,переход на EGO86A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO860   ПБ     KORT3A                  ,переход на KORT3A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO86A   МОДА   EGO8600                 ,мод.адрес := EGO8600
         СЧ     0                       ,СМ := слово по адресу EGO8600
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     2(М7)                   ,СМ -= слот кадра 2
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F0                      ,если СМ=0 → F0
         ПБ     EGO86B                  ,переход на EGO86B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0       УИА    К4(М16)                 ,М16 := адрес К4
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     KLAIDA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO86B   МОДА   EGO8600                 ,мод.адрес := EGO8600
         СЧ     0                       ,СМ := слово по адресу EGO8600
         УИА    К2(М16)                 ,М16 := адрес К2
         ПВ     IMUI(М15)               ,вызов через М15
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
KORT32   СЧ     5(М7)                   ,СМ := слот кадра 5
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     6(М7)                   ,СМ += слот кадра 6
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         МОД    V2                      ,мод.адрес := код из V2
         УИА    0(М1)                   ,М1 := код из V2
         МОДА   KORT32767(М1)           ,мод.адрес := KORT32767(М1)
         СЧ     0                       ,СМ := слово по адресу KORT32767+М1
         МОД    V3                      ,мод.адрес := код из V3
         УИА    0(М2)                   ,М2 := код из V3
         МОДА   EGO39967(М2)            ,мод.адрес := EGO39967(М2)
         ЗП     0                       ,по адресу EGO39967+М2 := СМ
         СЧ     '4013'(М7)              ,СМ := каталог задачи: элемент 11
         МОД    V2                      ,мод.адрес := код из V2
         УИА    0(М1)                   ,М1 := код из V2
         МОДА   KORT32767(М1)           ,мод.адрес := KORT32767(М1)
         ЗП     0                       ,по адресу KORT32767+М1 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     6(М7)                   ,СМ := слот кадра 6
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         ВЧОБ   1(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     KORT32                  ,если СМ=0 → KORT32
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   KORT14                  ,мод.адрес := KORT14
         ЗП     0                       ,по адресу KORT14 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   EGO8600                 ,мод.адрес := EGO8600
         СЧ     0                       ,СМ := слово по адресу EGO8600
         СЛ     0(М7)                   ,СМ += слот кадра 0
         МОДА   EGO8600                 ,мод.адрес := EGO8600
         ЗП     0                       ,по адресу EGO8600 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
KORT3A   ПБ     F0B                     ,переход на F0B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0A      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М2                      ,в магазин; СМ := М2
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0B      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М2                      ,М2 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

