***************************************************
* ENDKOR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6400 образа SIPROD.BIN
*   Длина при загрузке: 54 слов, 90 команд
*   Вход: ENDKOR
*   Внешние: *EGO*, *KORT*, KLAIDA, I*MU*I
*   Смещения в *EGO*: 7200, 8600, 8601
*   Смещения в *KORT*: 14
*   Регистры: М1, М2, М7, М10, М12, М15, М16, М17
***************************************************
ENDKOR  СТАРТ  0
        УИА    KORT16(М16)              ,М16 := KORT16
KORT16  ПБ     L0064                    ,переход на L0064
        СЧ     ENDKOR(М7)               ,СМ := ENDKOR(М7)
        СЧИМ                            ,СЧИ + магазин
        МОДА   *KORT*+16                ,мод.адрес +1: *KORT*+16
L0005   СЧ     ENDKOR                   ,СМ := ENDKOR
L0006   НТЖ    ENDKOR(М17)              ,СМ ^= ENDKOR(М17)
        ПО     L0005                    ,если СМ=0 → L0005
L0010   ПБ     L0006                    ,переход на L0006
        МОДА   ENDKOR                   ,мод.адрес +1: ENDKOR
L0012   ПБ     L0043                    ,переход на L0043
        МОДА   ENDKOR                   ,мод.адрес +1: ENDKOR
EGO206  МОДА   *EGO*+20630              ,мод.адрес +1: *EGO*+20630
        СЧ     ENDKOR                   ,СМ := ENDKOR
        РЖА    '3'                      ,РЖ := '3'
        ВЧ     2(М7)                    ,СМ -= 2(М7)
        РЖА    '22'                     ,РЖ := '22'
KLAIDA  ПО     L0012                    ,если СМ=0 → L0012
        ПБ     EGO206                   ,переход на EGO206
        МОДА   ENDKOR                   ,мод.адрес +1: ENDKOR
        УИА    KORT77(М16)              ,М16 := KORT77
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     KLAIDA(М15)              ,вызов через М15
        МОДА   ENDKOR                   ,мод.адрес +1: ENDKOR
        МОДА   *EGO*+20630              ,мод.адрес +1: *EGO*+20630
        СЧ     ENDKOR                   ,СМ := ENDKOR
        УИА    L00642(М16)              ,М16 := L00642
        ПВ     I*MU*I(М15)              ,вызов через М15
        ЗП     5(М7)                    ,5 := СМ
        РЖА    '3'                      ,РЖ := '3'
        СЧ     ENDKOR(М7)               ,СМ := ENDKOR(М7)
        ЗП     6(М7)                    ,6 := СМ
        РЖА    '22'                     ,РЖ := '22'
        МОДА   ENDKOR                   ,мод.адрес +1: ENDKOR
        СЧ     5(М7)                    ,СМ := 5(М7)
L0043   РЖА    '3'                      ,РЖ := '3'
L0064   СЛ     L0006(М7)                ,СМ += L0006(М7)
        ЗП     7(М7)                    ,7 := СМ
        МОД    L00643                   ,мод.адрес по коду: L00643
        УИА    ENDKOR(М1)               ,М1 := ENDKOR
        МОДА   *KORT*+77777(М1)         ,мод.адрес +1: *KORT*+77777
        СЧ     ENDKOR                   ,СМ := ENDKOR
L0065   МОД    KORT1A                   ,мод.адрес по коду: KORT1A
        УИА    ENDKOR(М2)               ,М2 := ENDKOR
        МОДА   СИМ12(М2)                ,мод.адрес +1: СИМ12(М2)
        ЗП     ENDKOR                   ,ENDKOR := СМ
L0056   СЧ     '4013'(М7)               ,СМ := '4013'(М7)
L00642  МОД    L00643                   ,мод.адрес по коду: L00643
        УИА    ENDKOR(М1)               ,М1 := ENDKOR
KORT77  МОДА   *KORT*+77777(М1)         ,мод.адрес +1: *KORT*+77777
        ЗП     ENDKOR                   ,ENDKOR := СМ
        РЖА    '22'                     ,РЖ := '22'
L00643  СЧ     6(М7)                    ,СМ := 6(М7)
KORT1A  РЖА    '3'                      ,РЖ := '3'
        СЛ     ENDKOR(М7)               ,СМ += ENDKOR(М7)
        ЗП     6(М7)                    ,6 := СМ
        ВЧОБ   1(М7)                    ,СМ := (адрес) - СМ
        РЖА    '22'                     ,РЖ := '22'
        ПО     KLAIDA                   ,если СМ=0 → KLAIDA
        СЧ     ENDKOR(М7)               ,СМ := ENDKOR(М7)
        МОДА   *KORT*+16                ,мод.адрес +1: *KORT*+16
        ЗП     ENDKOR                   ,ENDKOR := СМ
        РЖА    '3'                      ,РЖ := '3'
        МОДА   *EGO*+20630              ,мод.адрес +1: *EGO*+20630
        СЧ     ENDKOR                   ,СМ := ENDKOR
        СЛ     ENDKOR(М7)               ,СМ += ENDKOR(М7)
        МОДА   *EGO*+20630              ,мод.адрес +1: *EGO*+20630
        ЗП     ENDKOR                   ,ENDKOR := СМ
        РЖА    '22'                     ,РЖ := '22'
        МОДА   ENDKOR                   ,мод.адрес +1: ENDKOR
        ПБ     L0065                    ,переход на L0065
        МОДА   ENDKOR                   ,мод.адрес +1: ENDKOR
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0056(М7)                ,М7 := L0056
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М1                       ,стек := М1, СМ := М1
        СЧИМ   М2                       ,стек := М2, СМ := М2
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     ENDKOR(М12)              ,переход через М12
        МОДА   ENDKOR                   ,мод.адрес +1: ENDKOR
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М2                       ,М2 := СМ + стек
        УИМ    М1                       ,М1 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     ENDKOR(М10)              ,переход через М10

