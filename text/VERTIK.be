RNSYMA   ПВ     RNSYMB(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
L0104    СЧ     8(М7)                   ,СМ := 8(М7)
