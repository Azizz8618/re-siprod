         СЛ     1(М7)                   ,СМ += 1(М7)
VER4B    МОДА   VER4                    ,мод.адрес +1: VER4
         ЗП     0                       ,0 := СМ
IMUIB    СЧ     2(М7)                   ,СМ := 2(М7)
         УИА    VER4(М16)               ,М16 := VER4
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
