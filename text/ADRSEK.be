***************************************************
* ADRSEK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18656 образа SIPROD.BIN
*   Длина при загрузке: 68 слов, 118 команд
*   Вход: ADRSEK
*   Выход: SEKGIR:F9, SEKGIR:F9A, F4 (возврат через М12), 
*   F4A (возврат через М10)
*   Внешние: LYG, ADR, TAB, NRD, PAGE, NDAB, REGIM, NDABL, RSYMB, IMUI
*   Смещения в ADR: 1, 2, 3
*   Смещения в LYG: 1, 2
*   Смещения в NDAB: 1
*   Смещения в NDABL: 1
*   Смещения в NRD: 24
*   Смещения в PAGE: 1
*   Смещения в TAB: 1, 2, 3, 4
*   Смещения в кадре (М7): общие 0-1, 3-8, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 LYG
*   002 LYG1
*   003 LYG2
*   004 ADR
*   005 ADR1
*   006 ADR2
*   007 ADR3
*   008 TAB
*   009 TAB1
*   010 TAB2
*   011 TAB3
*   012 TAB4
*   013 NRD
*   014 NRD24
*   015 PAGE
*   016 PAGE1
*   017 NDAB
*   018 NDAB1
*   019 REGIM
*   020 NDABL
*   021 NDABL1
*   022 RSYMB
*   023 LYG4
*   024 IMUI
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     73
*   К2     75
*   V0     101
*   V1     102
*   V2     103
*
*** КОД МОДУЛЯ
*
ADRSEK   СТАРТ  0
         УИА    ADR2A(М16)              ,М16 := адрес ADR2A
         ПБ     F4                      ,переход на F4
*
ADR2A    СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   ADR2                    ,мод.адрес := ADR2
         ЗП     0                       ,по адресу ADR2 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   ADR3                    ,мод.адрес := ADR3
         ЗП     0                       ,по адресу ADR3 := СМ
         МОДА   TAB                     ,мод.адрес := TAB
         СЧ     0                       ,СМ := слово по адресу TAB
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         УИА    NRD(М16)                ,М16 := адрес NRD
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    TAB(М16)                ,М16 := адрес TAB
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    ADR2(М16)               ,М16 := адрес ADR2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         УИА    NRD(М16)                ,М16 := адрес NRD
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    ADR3(М16)               ,М16 := адрес ADR3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   ADR2                    ,мод.адрес := ADR2
         СЧ     0                       ,СМ := слово по адресу ADR2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   PAGE                    ,мод.адрес := PAGE
         СЛ     0                       ,СМ += слово по адресу PAGE
         МОДА   ADR2                    ,мод.адрес := ADR2
         ЗП     0                       ,по адресу ADR2 := СМ
         МОДА   ADR3                    ,мод.адрес := ADR3
         СЧ     0                       ,СМ := слово по адресу ADR3
         МОДА   PAGE                    ,мод.адрес := PAGE
         СЛ     0                       ,СМ += слово по адресу PAGE
         МОДА   ADR3                    ,мод.адрес := ADR3
         ЗП     0                       ,по адресу ADR3 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   REGIM                   ,мод.адрес := REGIM
         СЧ     0                       ,СМ := слово по адресу REGIM
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     LYG4A                   ,если СМ≠0 → LYG4A
         ПБ     LYG4B                   ,переход на LYG4B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LYG4A    ПБ     ADR2D                   ,переход на ADR2D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LYG4B    СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   LYG4                    ,мод.адрес := LYG4
         СЧ     0                       ,СМ := слово по адресу LYG4
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     ADR2B                   ,если СМ=0 → ADR2B
         ПБ     ADR2C                   ,переход на ADR2C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ADR2B    ПБ     ADR2D                   ,переход на ADR2D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ADR2C    МОДА   ADR2                    ,мод.адрес := ADR2
         СЧ     0                       ,СМ := слово по адресу ADR2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     5(М7)                   ,СМ += слот кадра 5
         МОДА   ADR2                    ,мод.адрес := ADR2
         ЗП     0                       ,по адресу ADR2 := СМ
         МОДА   ADR3                    ,мод.адрес := ADR3
         СЧ     0                       ,СМ := слово по адресу ADR3
         СЛ     5(М7)                   ,СМ += слот кадра 5
         МОДА   ADR3                    ,мод.адрес := ADR3
         ЗП     0                       ,по адресу ADR3 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
ADR2D    МОДА   LYG                     ,мод.адрес := LYG
         СЧ     0                       ,СМ := слово по адресу LYG
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   NDAB                    ,мод.адрес := NDAB
         СЧ     0                       ,СМ := слово по адресу NDAB
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         СЧ     4(М7)                   ,СМ := слот кадра 4
         УИА    V1(М16)                 ,М16 := адрес V1
         ПВ     IMUI(М15)               ,вызов через М15
         ВЧ     3(М7)                   ,СМ -= слот кадра 3
         МОДА   ADR                     ,мод.адрес := ADR
         ЗП     0                       ,по адресу ADR := СМ
         СЧ     4(М7)                   ,СМ := слот кадра 4
         УИА    V2(М16)                 ,М16 := адрес V2
         ПВ     IMUI(М15)               ,вызов через М15
         ВЧ     3(М7)                   ,СМ -= слот кадра 3
         МОДА   ADR1                    ,мод.адрес := ADR1
         ЗП     0                       ,по адресу ADR1 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F4A                     ,переход на F4A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F4       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F4A      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'6400000000000000'
К2       КОНД   В'6400000000000006'
V0       ПАМ    1
V1       ПАМ    1
V2       ПАМ    1
	ФИНИШ

