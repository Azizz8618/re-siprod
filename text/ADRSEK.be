***************************************************
* ADRSEK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18656 образа SIPROD.BIN
*   Длина при загрузке: 68 слов, 118 команд
*   Вход: ADRSEK
*   Внешние: LYG, ADR, TAB, NRD, PAGE, NDAB, REGIM, NDABL, RSYMB, IMUI
*   Смещения в ADR: 1, 2, 3
*   Смещения в LYG: 1, 2
*   Смещения в NDAB: 1
*   Смещения в NDABL: 1
*   Смещения в NRD: 24
*   Смещения в PAGE: 1
*   Смещения в TAB: 1, 2, 3, 4
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 LYG
*   002 LYG1
*   003 LYG2
*   004 ADR
*   005 ADR1
*   006 ADR2
*   007 ADR3
*   008 TAB
*   009 TAB1
*   010 TAB2
*   011 TAB3
*   012 TAB4
*   013 NRD
*   014 NRD24
*   015 PAGE
*   016 PAGE1
*   017 NDAB
*   018 NDAB1
*   019 REGIM
*   020 NDABL
*   021 NDABL1
*   022 RSYMB
*   023 LYG4
*   024 IMUI
*
ADRSEK   СТАРТ  0
         УИА    RSYMBA(М16)             ,М16 := RSYMBA
RSYMBA   ПБ     L0064                   ,переход на L0064
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   ADR2                    ,мод.адрес +1: ADR2
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   ADR3                    ,мод.адрес +1: ADR3
         ЗП     0                       ,0 := СМ
         МОДА   TAB                     ,мод.адрес +1: TAB
         СЧ     0                       ,СМ := 0
         СЛ     1(М7)                   ,СМ += 1(М7)
         ЗП     6(М7)                   ,6 := СМ
         УИА    NRD(М16)                ,М16 := NRD
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    TAB(М16)                ,М16 := TAB
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADR2(М16)               ,М16 := ADR2
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    LYG4A(М16)              ,М16 := LYG4A
         СЧИМ   М16                     ,стек := М16, СМ := М16
         РЖА    '22'                    ,РЖ := '22'
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         УИА    NRD(М16)                ,М16 := NRD
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    L0101(М16)              ,М16 := L0101
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    ADR3(М16)               ,М16 := ADR3
L0035    СЧИМ   М16                     ,стек := М16, СМ := М16
RSYMBB   УИА    LYG4A(М16)              ,М16 := LYG4A
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
L0042    РЖА    '3'                     ,РЖ := '3'
ADR2A    РЖА    '22'                    ,РЖ := '22'
         МОДА   ADR2                    ,мод.адрес +1: ADR2
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         МОДА   PAGE                    ,мод.адрес +1: PAGE
         СЛ     0                       ,СМ += 0
ADR2B    МОДА   ADR2                    ,мод.адрес +1: ADR2
         ЗП     0                       ,0 := СМ
         МОДА   ADR3                    ,мод.адрес +1: ADR3
         СЧ     0                       ,СМ := 0
         МОДА   PAGE                    ,мод.адрес +1: PAGE
         СЛ     0                       ,СМ += 0
         МОДА   ADR3                    ,мод.адрес +1: ADR3
         ЗП     0                       ,0 := СМ
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   REGIM                   ,мод.адрес +1: REGIM
L0064    СЧ     0                       ,СМ := 0
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     L0035                   ,если СМ≠0 → L0035
         ПБ     RSYMBB                  ,переход на RSYMBB
V1       МОДА   0                       ,мод.адрес +1: 0
         ПБ     ADR2B                   ,переход на ADR2B
V1A      МОДА   0                       ,мод.адрес +1: 0
         СЧ     0(М7)                   ,СМ := 0(М7)
LYG4A    СЧИМ                           ,СЧИ + магазин
         МОДА   LYG4                    ,мод.адрес +1: LYG4
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
L0101    ПО     L0042                   ,если СМ=0 → L0042
L0102    ПБ     ADR2A                   ,переход на ADR2A
IMUIA    МОДА   0                       ,мод.адрес +1: 0
         ПБ     ADR2B                   ,переход на ADR2B
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   ADR2                    ,мод.адрес +1: ADR2
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     5(М7)                   ,СМ += 5(М7)
         МОДА   ADR2                    ,мод.адрес +1: ADR2
         ЗП     0                       ,0 := СМ
         МОДА   ADR3                    ,мод.адрес +1: ADR3
         СЧ     0                       ,СМ := 0
         СЛ     5(М7)                   ,СМ += 5(М7)
         МОДА   ADR3                    ,мод.адрес +1: ADR3
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОДА   LYG                     ,мод.адрес +1: LYG
         СЧ     0                       ,СМ := 0
         ЗП     7(М7)                   ,7 := СМ
         РЖА    '3'                     ,РЖ := '3'
         МОДА   NDAB                    ,мод.адрес +1: NDAB
         СЧ     0                       ,СМ := 0
         ЗП     8(М7)                   ,8 := СМ
         СЧ     4(М7)                   ,СМ := 4(М7)
         УИА    L0102(М16)              ,М16 := L0102
         ПВ     IMUI(М15)               ,вызов через М15
         ВЧ     3(М7)                   ,СМ -= 3(М7)
         МОДА   ADR                     ,мод.адрес +1: ADR
         ЗП     0                       ,0 := СМ
         СЧ     4(М7)                   ,СМ := 4(М7)
         УИА    IMUIA(М16)              ,М16 := IMUIA
         ПВ     IMUI(М15)               ,вызов через М15
         ВЧ     3(М7)                   ,СМ -= 3(М7)
         МОДА   ADR1                    ,мод.адрес +1: ADR1
         ЗП     0                       ,0 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПБ     V1                      ,переход на V1
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    V1A(М7)                 ,М7 := V1A
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

