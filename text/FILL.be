***************************************************
* FILL - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 14976 образа SIPROD.BIN
*   Длина при загрузке: 75 слов, 128 команд
*   Вход: FILL
*   Выход: F3C (возврат через М12), F3D (возврат через М10)
*   ЗАПОЛНЕНИЕ СТРОКИ СИМВОЛОМ ПО ШИРИНЕ ПОЛЯ.
*   Внешние: STR, NDAB, BEGSTR, ENDSTR, RSYMB
*   Смещения в NDAB: 1, 2
*   Смещения в STR: 24, 25, 26
*   Смещения в кадре (М7): общие 0-1, 3-10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 STR
*   002 STR24
*   003 STR25
*   004 STR26
*   005 NDAB
*   006 NDAB1
*   007 NDAB2
*   008 BEGSTR
*   009 ENDSTR
*   010 RSYMB
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     100    6400000000000000
*   К2     102    6400000000000006
*   V3     106
*   V6     111
*   V7     112
*
*** КОД МОДУЛЯ
*
FILL     СТАРТ  0
         УИА    STR26A(М16)             ,М16 := адрес STR26A
         ПБ     F3C                     ,переход на F3C
*
STR26A   МОД    V6                      ,мод.адрес := код из V6
         СЧ     0                       ,СМ := слово по адресу V6
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR26B   МОДА   STR26                   ,мод.адрес := STR26
         СЧ     0                       ,СМ := слово по адресу STR26
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   STR24                   ,мод.адрес := STR24
         ВЧ     0                       ,СМ -= слово по адресу STR24
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         СЧ     3(М7)                   ,СМ := слот кадра 3
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         СЧ     3(М7)                   ,СМ := слот кадра 3
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     4(М7)                   ,СМ += слот кадра 4
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     STR24A                  ,если СМ≠0 → STR24A
         ПБ     STR24B                  ,переход на STR24B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR24A   СЧ     4(М7)                   ,СМ := слот кадра 4
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
STR24B   МОДА   STR24                   ,мод.адрес := STR24
         СЧ     0                       ,СМ := слово по адресу STR24
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     STR24C                  ,переход на STR24C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F6       СЧ     6(М7)                   ,СМ := слот кадра 6
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         МОД    V7                      ,мод.адрес := код из V7
         УИА    0(М16)                  ,М16 := код из V7
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    STR(М16)                ,М16 := адрес STR
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V3(М16)                 ,М16 := адрес V3
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RSYMB(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     7(М7)                   ,СМ := слот кадра 7
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
STR24C   ВЧОБ   5(М7)                   ,СМ := (адрес) - СМ
         ПО     F6                      ,если СМ=0 → F6
         МОДА   STR24                   ,мод.адрес := STR24
         СЧ     0                       ,СМ := слово по адресу STR24
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     5(М7)                   ,СМ += слот кадра 5
         МОДА   STR24                   ,мод.адрес := STR24
         ЗП     0                       ,по адресу STR24 := СМ
         СЧ     3(М7)                   ,СМ := слот кадра 3
         ВЧ     5(М7)                   ,СМ -= слот кадра 5
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         МОДА   STR24                   ,мод.адрес := STR24
         СЧ     0                       ,СМ := слово по адресу STR24
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         МОДА   STR26                   ,мод.адрес := STR26
         СЛ     0                       ,СМ += слово по адресу STR26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     NDAB1A                  ,если СМ=0 → NDAB1A
         ПБ     NDAB1B                  ,переход на NDAB1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NDAB1A   ПБ     F3                      ,переход на F3
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NDAB1B   МОДА   NDAB1                   ,мод.адрес := NDAB1
         СЧ     0                       ,СМ := слово по адресу NDAB1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ENDSTR(М15)             ,вызов через М15
         СЧ     8(М7)                   ,СМ := слот кадра 8
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   NDAB1                   ,мод.адрес := NDAB1
         СЧ     0                       ,СМ := слово по адресу NDAB1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     BEGSTA                  ,если СМ=0 → BEGSTA
         ПБ     F3                      ,переход на F3
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
BEGSTA   ПВ     BEGSTR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3       СЧ     3(М7)                   ,СМ := слот кадра 3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     0(М7)                   ,СМ += слот кадра 0
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F3A                     ,если СМ≠0 → F3A
         ПБ     F3B                     ,переход на F3B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3A      ПБ     STR26B                  ,переход на STR26B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3B      ПБ     F3D                     ,переход на F3D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3C      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         ЗПМ    10(М7)                  ,ЗП + магазин: 10(М7)
         ЗПМ    9(М7)                   ,ЗП + магазин: 9(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3D      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

