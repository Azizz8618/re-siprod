***************************************************
* GOSTAS - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 21024 образа SIPROD.BIN
*   Длина при загрузке: 32 слов, 42 команд
*   Вход: GOSTAS
*   Выход: SCHEMA:NUSTB, SCHEMA:F2B, L0032 (возврат через М12), 
*   POP (возврат через М10)
*   ПРИВЕДЕНИЕ ТЕКСТА К КОДИРОВКЕ ГОСТ.
*   Внешние: LOL
*   Смещения в LOL: 7
*   Смещения в кадре (М7): общие 0-2, 10
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 LOL
*   002 LOL32767
*   003 LOL7
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     25    6400000000000001
*   V0     27
*   V1     30
*
*** КОД МОДУЛЯ
*
GOSTAS   СТАРТ  0
         УИА    LOL327(М16)             ,М16 := адрес LOL327
         ПБ     L0032                   ,переход на L0032
*
LOL327   СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     2(М7)                   ,слот кадра 2 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
LOL32A   МОД    V0                      ,мод.адрес := код из V0
         УИА    0(М1)                   ,М1 := код из V0
         МОДА   V0(М1)                  ,мод.адрес := V0(М1)
         СЧ     0                       ,СМ := слово по адресу V0+М1
         МОДА   LOL32767(М1)            ,мод.адрес := LOL32767(М1)
         ЗП     0                       ,по адресу LOL32767+М1 := СМ
         МОД    V0                      ,мод.адрес := код из V0
         УИА    0(М1)                   ,М1 := код из V0
         МОДА   V0(М1)                  ,мод.адрес := V0(М1)
         СЧ     0                       ,СМ := слово по адресу V0+М1
         МОДА   LOL7(М1)                ,мод.адрес := LOL7(М1)
         ЗП     0                       ,по адресу LOL7+М1 := СМ
         СЧ     2(М7)                   ,СМ := слот кадра 2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     2(М7)                   ,слот кадра 2 := СМ
         ВЧОБ   1(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     LOL32A                  ,если СМ=0 → LOL32A
         ПБ     POP                     ,переход на POP
*
L0032    УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

