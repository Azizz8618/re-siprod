***************************************************
* WRIKOR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6336 образа SIPROD.BIN
*   Длина при загрузке: 55 слов, 90 команд
*   Вход: WRIKOR
*   Внешние: KORT, ENDKOR, RNSYMB
*   Смещения в KORT: 14
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 KORT
*   002 KORT14
*   003 ENDKOR
*   004 RNSYMB
*
WRIKOR   СТАРТ  0
         УИА    L0065(М16)              ,М16 := L0065
L0065    ПБ     RNSYMA                  ,переход на RNSYMA
         МОД    L0065A                  ,мод.адрес по коду: L0065A
         СЧ     0                       ,СМ := 0
         ЗП     3(М7)                   ,3 := СМ
         РЖА    '3'                     ,РЖ := '3'
L0066    МОД    ENDKOA                  ,мод.адрес по коду: ENDKOA
         СЧ     0                       ,СМ := 0
         ЗП     4(М7)                   ,4 := СМ
         СЧ     0(М7)                   ,СМ := 0(М7)
         ЗП     5(М7)                   ,5 := СМ
L0013    РЖА    '22'                    ,РЖ := '22'
         СЧ     2(М7)                   ,СМ := 2(М7)
KORT1A   РЖА    '3'                     ,РЖ := '3'
         МОДА   KORT14                  ,мод.адрес +1: KORT14
         ВЧ     0                       ,СМ -= 0
         СЛ     1(М7)                   ,СМ += 1(М7)
         ЗП     6(М7)                   ,6 := СМ
         ВЧ     4(М7)                   ,СМ -= 4(М7)
         РЖА    '22'                    ,РЖ := '22'
         ПЕ     L0013                   ,если СМ≠0 → L0013
         ПБ     KORT1A                  ,переход на KORT1A
         СЧ     6(М7)                   ,СМ := 6(М7)
         ЗП     4(М7)                   ,4 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОД    L0064                   ,мод.адрес по коду: L0064
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
L0035    УИА    L0060(М16)              ,М16 := L0060
L0036    СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    KORT(М16)               ,М16 := KORT
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    KORT14(М16)             ,М16 := KORT14
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    L0066A(М16)             ,М16 := L0066A
L0044    СЧИМ   М16                     ,стек := М16, СМ := М16
RNSYMA   ПВ     RNSYMB(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         СЧ     5(М7)                   ,СМ := 5(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     4(М7)                   ,СМ += 4(М7)
KORT1B   ЗП     5(М7)                   ,5 := СМ
         МОДА   KORT14                  ,мод.адрес +1: KORT14
KORT1C   СЧ     0                       ,СМ := 0
         СЛ     4(М7)                   ,СМ += 4(М7)
         МОДА   KORT14                  ,мод.адрес +1: KORT14
L0060    ЗП     0                       ,0 := СМ
L0066A   МОД    ENDKOA                  ,мод.адрес по коду: ENDKOA
         СЧ     0                       ,СМ := 0
         СЧИМ                           ,СЧИ + магазин
L0064    СЧ     5(М7)                   ,СМ := 5(М7)
L0065A   РЖА    '22'                    ,РЖ := '22'
ENDKOA   НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     L0035                   ,если СМ=0 → L0035
         ПБ     L0036                   ,переход на L0036
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     L0044                   ,переход на L0044
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     3(М7)                   ,СМ := 3(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     4(М7)                   ,СМ += 4(М7)
         ЗП     3(М7)                   ,3 := СМ
         МОД    ENDKOA                  ,мод.адрес по коду: ENDKOA
         СЧ     0                       ,СМ := 0
         ВЧ     5(М7)                   ,СМ -= 5(М7)
         ЗП     4(М7)                   ,4 := СМ
         РЖА    '22'                    ,РЖ := '22'
         ПВ     ENDKOR(М15)             ,вызов через М15
         ПБ     L0066                   ,переход на L0066
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     KORT1B                  ,переход на KORT1B
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    KORT1C(М7)              ,М7 := KORT1C
         ЗПМ    9(М7)                   ,ЗП + магазин: 9(М7)
         ЗПМ    8(М7)                   ,ЗП + магазин: 8(М7)
         ЗПМ    7(М7)                   ,ЗП + магазин: 7(М7)
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

