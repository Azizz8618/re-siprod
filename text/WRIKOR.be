***************************************************
* WRIKOR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6336 образа SIPROD.BIN
*   Длина при загрузке: 55 слов, 90 команд
*   Вход: WRIKOR
*   Выход: APNOTF:GOTA, APNOTF:F1B, APNOTF:F1B, APNOTF:PAGE1A, 
*   APNOTF:PAGE1A, APNOTF:PAGE1A, APNOTF:ENDKOA, APNOTF:ENDKOA, 
*   APNOTF:ENDKOA, APNOTF:ENDKOA, CSTRIN:F8, CSTRIN:F8, CSTRIN:F8, 
*   CSTRIN:F8, GOTOPO:F5, GOTOPO:F5, GOTOPO:F5, IPONUM:F4, IPONUM:F4, 
*   NAMENF:F7, NAMENF:F1, NAMENF:F1, NOTFOR:TYPEA, NOTFOR:F0, NOTFOR:F0, 
*   NOTFOR:NOTF1A, ONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320, 
*   ONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320, 
*   ONEPLA:L0320, RASKOM:F10, RASKOM:F10, RASKOM:F10, RASKOM:F1, RASKOM:F1, 
*   RASKOM:ADDRA, RASKOM:F20, RASKOM:F6, RASKOM:F6, RASKOM:F6, RASKOM:F6, 
*   RASKOM:F6, RASKOM:F20A, RASKOM:F20A, RASKOM:F20A, SCHEMA:BLOE, 
*   SCHEMA:FOPF, SCHEMA:F5, SCHEMA:BLOG, SCHEMA:ENDKOA, SCHEMA:ENDKOA, 
*   SCHEMA:NUSTE, TARNYB:TYPE1A, TARNYB:TYPE1A, TARNYB:NOTF1A, 
*   TARNYB:KORT1A, TARNYB:NOTFH, TARNYB:NOTFH, TARNYB:NOTFH, TARNYB:NOTFH, 
*   TARNYB:NOTFH, TARNYB:F1, TARNYB:F1, TARNYB:F1, TARNYB:F1, TARNYB:F1, 
*   TARNYB:F1, TARNYB:F1, TWOPLA:F0, TWOPLA:F0, TWOPLA:NUM3A, TWOPLA:NUM3A, 
*   TWOPLA:F13A, TWOPLA:F13A, TWOPLA:F3, TWOPLA:F3, TWOPLA:F3, 
*   TWOPLA:NUM3F, TWOPLA:NUM3F, TWOPLA:NUM3F, TWOPLA:F13C, WRIHOR:L0166, 
*   WRIHOR:L0166, WRIHOR:L0166, WRIHOR:L0166, WRIHOR:L0166, WRIHOR:L0166, 
*   WRIIPO:IPONUA, WRIIPO:SCANEA, WRIIPO:INS26A, WRIIPO:INS26A, 
*   WRIIPO:INS26A, WRIIPO:SCANEG, WRIIPO:F11A, WRILIN:F7B, WRILIN:F7B, 
*   WRILIN:F7B, WRILIN:F7B, WRILIN:F7B, WRILIN:F7B, WRINUM:F0, WRINUM:F0, 
*   WRINUM:F0, WRINUM:F0, WRINUM:F0B, WRINUM:F0B, WRITEH:ONEPLB, 
*   WRIVER:CENA, WRIVER:F18, WRIVER:WHO1A, WRIVER:F18A, 
*   F3B (возврат через М12), POP (возврат через М10)
*   ЗАПИСЬ В БУФЕР ВЫВОДА.
*   Внешние: KORT, ENDKOR, RNSYMB
*   Смещения в KORT: 14
*   Смещения в кадре (М7): общие 0-10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 KORT
*   002 KORT14
*   003 ENDKOR
*   004 RNSYMB
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     55
*   V0     60
*   V1     61
*   V4     64
*   V5     65
*   V6     66
*
*** КОД МОДУЛЯ
*
WRIKOR   СТАРТ  0
         УИА    KORT1A(М16)             ,М16 := адрес KORT1A
         ПБ     F3B                     ,переход на F3B
*
KORT1A   МОД    V5                      ,мод.адрес := код из V5
         СЧ     0                       ,СМ := слово по адресу V5
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОД    V6                      ,мод.адрес := код из V6
         СЧ     0                       ,СМ := слово по адресу V6
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
KORT1B   СЧ     2(М7)                   ,СМ := слот кадра 2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   KORT14                  ,мод.адрес := KORT14
         ВЧ     0                       ,СМ -= слово по адресу KORT14
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         ВЧ     4(М7)                   ,СМ -= слот кадра 4
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F6                      ,если СМ≠0 → F6
         ПБ     F6A                     ,переход на F6A
*
F6       СЧ     6(М7)                   ,СМ := слот кадра 6
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F6A      МОД    V4                      ,мод.адрес := код из V4
         УИА    0(М16)                  ,М16 := код из V4
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    KORT(М16)               ,М16 := адрес KORT
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    KORT14(М16)             ,М16 := адрес KORT14
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RNSYMB(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     5(М7)                   ,СМ := слот кадра 5
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     4(М7)                   ,СМ += слот кадра 4
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         МОДА   KORT14                  ,мод.адрес := KORT14
         СЧ     0                       ,СМ := слово по адресу KORT14
         СЛ     4(М7)                   ,СМ += слот кадра 4
         МОДА   KORT14                  ,мод.адрес := KORT14
         ЗП     0                       ,по адресу KORT14 := СМ
         МОД    V6                      ,мод.адрес := код из V6
         СЧ     0                       ,СМ := слово по адресу V6
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     5(М7)                   ,СМ := слот кадра 5
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F5                      ,если СМ=0 → F5
         ПБ     F3                      ,переход на F3
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F5       ПБ     F3A                     ,переход на F3A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3       СЧ     3(М7)                   ,СМ := слот кадра 3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     4(М7)                   ,СМ += слот кадра 4
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         МОД    V6                      ,мод.адрес := код из V6
         СЧ     0                       ,СМ := слово по адресу V6
         ВЧ     5(М7)                   ,СМ -= слот кадра 5
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ENDKOR(М15)             ,вызов через М15
         ПБ     KORT1B                  ,переход на KORT1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3A      ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3B      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         ЗПМ    9(М7)                   ,ЗП + магазин: 9(М7)
         ЗПМ    8(М7)                   ,ЗП + магазин: 8(М7)
         ЗПМ    7(М7)                   ,ЗП + магазин: 7(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

