***************************************************
* RWINF - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 17440 образа SIPROD.BIN
*   Длина при загрузке: 42 слов, 74 команд
*   Вход: RWINF
*   Выход: ANATXT:SCANEC, SEGTAB:STR25A, SEKGIR:F7D, SEKGIR:LRE32B, 
*   SEKGIR:F2B, SEKLYG:NUST8A, F1A (возврат через М12), 
*   F1B (возврат через М10)
*   Внешние: INF, RWBIT, REGIM
*   Смещения в INF: 1, 2
*   Смещения в кадре (М7): общие 0-1, 3-4, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INF
*   002 INF1
*   003 INF2
*   004 RWBIT
*   005 REGIM
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     45
*   V2     51
*
*** КОД МОДУЛЯ
*
RWINF    СТАРТ  0
         УИА    INF1A(М16)              ,М16 := адрес INF1A
         ПБ     F1A                     ,переход на F1A
*
INF1A    МОДА   INF1                    ,мод.адрес := INF1
         СЧ     0                       ,СМ := слово по адресу INF1
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     0(М7)                   ,СМ += слот кадра 0
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     JMP                     ,если СМ=0 → JMP
         ПБ     ADDR                    ,переход на ADDR
*
JMP      ПБ     INF2B                   ,переход на INF2B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ADDR     УИА    INF(М16)                ,М16 := адрес INF
         СЧИ    М16                     ,СМ := М16
         УИА    INF1(М16)               ,М16 := адрес INF1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     REGIM(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     3(М7)                   ,СМ := слот кадра 3
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F3                      ,если СМ=0 → F3
         ПБ     F1                      ,переход на F1
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3       ПБ     INF2A                   ,переход на INF2A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1       СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    INF(М16)                ,М16 := адрес INF
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    INF1(М16)               ,М16 := адрес INF1
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RWBIT(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   INF2                    ,мод.адрес := INF2
         ЗП     0                       ,по адресу INF2 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     INF2B                   ,переход на INF2B
*
INF2A    СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   INF2                    ,мод.адрес := INF2
         ЗП     0                       ,по адресу INF2 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
INF2B    ПБ     F1B                     ,переход на F1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1A      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1B      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'6400000000000000'
V0       ПАМ    1
V1       ПАМ    1
V2       ПАМ    1
	ФИНИШ

