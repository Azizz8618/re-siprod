***************************************************
* RWINF - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 17440 образа SIPROD.BIN
*   Длина при загрузке: 42 слов, 74 команд
*   Вход: RWINF
*   Внешние: INF, RWBIT, REGIM
*   Смещения в INF: 1, 2
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 INF
*   002 INF1
*   003 INF2
*   004 RWBIT
*   005 REGIM
*
RWINF    СТАРТ  0
         УИА    INF1A(М16)              ,М16 := INF1A
INF1A    ПБ     L0036                   ,переход на L0036
         МОДА   INF1                    ,мод.адрес +1: INF1
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
L0005    ВЧОБ   0                       ,СМ := (адрес) - СМ
L0006    СЛ     0(М7)                   ,СМ += 0(М7)
         РЖА    '22'                    ,РЖ := '22'
         ПО     L0005                   ,если СМ=0 → L0005
         ПБ     L0006                   ,переход на L0006
         ПБ     V3A                     ,переход на V3A
         МОДА   0                       ,мод.адрес +1: 0
         УИА    INF(М16)                ,М16 := INF
         СЧИ    М16                     ,СМ := М16
L0016    УИА    INF1(М16)               ,М16 := INF1
REGIMA   СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     REGIM(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ЗП     3(М7)                   ,3 := СМ
         РЖА    '3'                     ,РЖ := '3'
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         СЧ     3(М7)                   ,СМ := 3(М7)
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     L0016                   ,если СМ=0 → L0016
V3       ПБ     REGIMA                  ,переход на REGIMA
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     V3                      ,переход на V3
V3A      МОДА   0                       ,мод.адрес +1: 0
L0036    СЧ     1(М7)                   ,СМ := 1(М7)
         ЗП     4(М7)                   ,4 := СМ
         РЖА    '3'                     ,РЖ := '3'
         УИА    RWBITA(М16)             ,М16 := RWBITA
         СЧИМ   М16                     ,стек := М16, СМ := М16
L0043    УИА    RWBITA(М16)             ,М16 := RWBITA
         СЧИМ   М16                     ,стек := М16, СМ := М16
L0045    УИА    INF(М16)                ,М16 := INF
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    INF1(М16)               ,М16 := INF1
         СЧИМ   М16                     ,стек := М16, СМ := М16
RWBITA   РЖА    '22'                    ,РЖ := '22'
         ПВ     RWBIT(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   INF2                    ,мод.адрес +1: INF2
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     V3A                     ,переход на V3A
         СЧ     1(М7)                   ,СМ := 1(М7)
         МОДА   INF2                    ,мод.адрес +1: INF2
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     L0043                   ,переход на L0043
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    L0045(М7)               ,М7 := L0045
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

