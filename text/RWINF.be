***************************************************
* RWINF - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 17440 образа SIPROD.BIN
*   Длина при загрузке: 42 слов, 74 команд
*   Вход: RWINF
*   Внешние: *INF*, RWBIT, *REGIM*
*   Смещения в *INF*: 1, 2
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
RWINF   СТАРТ  0
        УИА    INF1(М16)                ,М16 := INF1
INF1    ПБ     L0036                    ,переход на L0036
        МОДА   *INF*+1                  ,мод.адрес +1: *INF*+1
        СЧ     RWINF                    ,СМ := RWINF
        РЖА    '3'                      ,РЖ := '3'
L0005   ВЧОБ   RWINF                    ,СМ := (адрес) - СМ
L0006   СЛ     RWINF(М7)                ,СМ += RWINF(М7)
        РЖА    '22'                     ,РЖ := '22'
L0010   ПО     L0005                    ,если СМ=0 → L0005
        ПБ     L0006                    ,переход на L0006
L0012   ПБ     V32                      ,переход на V32
        МОДА   RWINF                    ,мод.адрес +1: RWINF
        УИА    *INF*(М16)               ,М16 := *INF*
        СЧИ    М16                      ,СМ := М16
L0016   УИА    *INF*+1(М16)             ,М16 := *INF*+1
REGIM   СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     *REGIM*(М15)             ,вызов через М15
        МОДА   RWINF                    ,мод.адрес +1: RWINF
        ЗП     3(М7)                    ,3 := СМ
        РЖА    '3'                      ,РЖ := '3'
        СЧ     1(М7)                    ,СМ := 1(М7)
        СЧИМ                            ,СЧИ + магазин
        СЧ     3(М7)                    ,СМ := 3(М7)
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    RWINF(М17)               ,СМ ^= RWINF(М17)
        ПО     L0016                    ,если СМ=0 → L0016
V3      ПБ     REGIM                    ,переход на REGIM
        МОДА   RWINF                    ,мод.адрес +1: RWINF
        ПБ     V3                       ,переход на V3
V32     МОДА   RWINF                    ,мод.адрес +1: RWINF
L0036   СЧ     1(М7)                    ,СМ := 1(М7)
        ЗП     4(М7)                    ,4 := СМ
        РЖА    '3'                      ,РЖ := '3'
        УИА    RWBIT(М16)               ,М16 := RWBIT
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0043   УИА    RWBIT(М16)               ,М16 := RWBIT
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0045   УИА    *INF*(М16)               ,М16 := *INF*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *INF*+1(М16)             ,М16 := *INF*+1
        СЧИМ   М16                      ,стек := М16, СМ := М16
RWBIT   РЖА    '22'                     ,РЖ := '22'
        ПВ     RWBIT(М15)               ,вызов через М15
        МОДА   RWINF                    ,мод.адрес +1: RWINF
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        СЧ     RWINF(М7)                ,СМ := RWINF(М7)
        МОДА   *INF*+2                  ,мод.адрес +1: *INF*+2
        ЗП     RWINF                    ,RWINF := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПБ     V32                      ,переход на V32
        СЧ     1(М7)                    ,СМ := 1(М7)
        МОДА   *INF*+2                  ,мод.адрес +1: *INF*+2
        ЗП     RWINF                    ,RWINF := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОДА   RWINF                    ,мод.адрес +1: RWINF
        ПБ     L0043                    ,переход на L0043
        МОДА   RWINF                    ,мод.адрес +1: RWINF
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0045(М7)                ,М7 := L0045
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     RWINF(М12)               ,переход через М12
        МОДА   RWINF                    ,мод.адрес +1: RWINF
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     RWINF(М10)               ,переход через М10

