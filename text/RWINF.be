***************************************************
* RWINF - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 17440 образа SIPROD.BIN
*   Длина при загрузке: 42 слов, 74 команд
*   Вход: RWINF
*   Выход: ANATXT:INFA, SEGTAB:INFA, SEKGIR:INFA, SEKGIR:INFE, 
*   SEKGIR:INFE+1, SEKLYG:INFA, V1C (возврат через М12), 
*   V1C (возврат через М10)
*   Внешние: INF, RWBIT, REGIM
*   Смещения в INF: 1, 2
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INF
*   002 INF1
*   003 INF2
*   004 RWBIT
*   005 REGIM
*
*** КОД МОДУЛЯ
*
RWINF    СТАРТ  0
         УИА    INF1A(М16)              ,М16 := INF1A
INF1A    ПБ     V1                      ,переход на V1
*
         МОДА   INF1                    ,мод.адрес +1: INF1
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
INF1B    ВЧОБ   0                       ,СМ := (адрес) - СМ
INF1C    СЛ     0(М7)                   ,СМ += 0(М7)
         РЖА    '22'                    ,РЖ := '22'
         ПО     INF1B                   ,если СМ=0 → INF1B
         ПБ     INF1C                   ,переход на INF1C
*
         ПБ     V3A                     ,переход на V3A
*
         МОДА   0                       ,мод.адрес +1: 0
         УИА    INF(М16)                ,М16 := INF
         СЧИ    М16                     ,СМ := М16
ADDR     УИА    INF1(М16)               ,М16 := INF1
PUSH     СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     REGIM(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ЗП     3(М7)                   ,3 := СМ
         РЖА    '3'                     ,РЖ := '3'
         СЧ     1(М7)                   ,СМ := 1(М7)
         СЧИМ                           ,СЧИ + магазин
         СЧ     3(М7)                   ,СМ := 3(М7)
         РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     ADDR                    ,если СМ=0 → ADDR
V3       ПБ     PUSH                    ,переход на PUSH
*
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     V3                      ,переход на V3
*
V3A      МОДА   0                       ,мод.адрес +1: 0
V1       СЧ     1(М7)                   ,СМ := 1(М7)
         ЗП     4(М7)                   ,4 := СМ
         РЖА    '3'                     ,РЖ := '3'
         УИА    V1C(М16)                ,М16 := V1C
         СЧИМ   М16                     ,стек := М16, СМ := М16
V1A      УИА    V1C(М16)                ,М16 := V1C
         СЧИМ   М16                     ,стек := М16, СМ := М16
V1B      УИА    INF(М16)                ,М16 := INF
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    INF1(М16)               ,М16 := INF1
         СЧИМ   М16                     ,стек := М16, СМ := М16
V1C      РЖА    '22'                    ,РЖ := '22'
         ПВ     RWBIT(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   INF2                    ,мод.адрес +1: INF2
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПБ     V3A                     ,переход на V3A
*
         СЧ     1(М7)                   ,СМ := 1(М7)
         МОДА   INF2                    ,мод.адрес +1: INF2
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     V1A                     ,переход на V1A
*
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    V1B(М7)                 ,М7 := V1B
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10
*

