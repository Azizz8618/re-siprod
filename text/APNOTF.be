***************************************************
* APNOTF - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 8448 образа SIPROD.BIN
*   Длина при загрузке: 109 слов, 188 команд
*   Вход: APNOTF
*   Выход: NOTFOR:ENDKOA, F1C (возврат через М12), F1D (возврат через М10)
*   Внешние: PAGE, INS, SCANER, TYPE, WHO, GOT, NAMENF, ENDKOR, HOWSMB, 
*   RASPS, WRIKOR, WHATYP
*   Смещения в INS: 24, 25, 26
*   Смещения в PAGE: 1
*   Смещения в SCANER: 1, 2
*   Смещения в TYPE: 1, 11, 13
*   Смещения в WHO: 1
*   Смещения в кадре (М7): общие 0-2, 6, 8-10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 PAGE
*   002 INS
*   003 INS24
*   004 INS25
*   005 INS26
*   006 SCANER
*   007 SCANER1
*   008 SCANER2
*   009 TYPE
*   010 TYPE1
*   011 TYPE11
*   012 TYPE13
*   013 WHO
*   014 WHO1
*   015 GOT
*   016 NAMENF
*   017 ENDKOR
*   018 HOWSMB
*   019 RASPS
*   020 WRIKOR
*   021 WHATYP
*   022 PAGE1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     136
*   К1     137
*   К2     140
*   К3     141
*   К4     142
*   К5     143
*   К6     144
*   К7     145
*   К9     147
*   V1     151
*   V2     152
*
*** КОД МОДУЛЯ
*
APNOTF   СТАРТ  0
         УИА    SCANEA(М16)             ,М16 := адрес SCANEA
         ПБ     F1C                     ,переход на F1C
*
SCANEA   СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
SCANEB   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS26                   ,мод.адрес := INS26
         ВЧ     0                       ,СМ -= слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F0                      ,если СМ=0 → F0
         ПБ     WHATYA                  ,переход на WHATYA
*
F0       ПБ     ENDKOA                  ,переход на ENDKOA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
WHATYA   ПВ     WHATYP(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К7(М16)                 ,М16 := адрес К7
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     WRIKOR(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     2(М7)                   ,СМ := слот кадра 2
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     8(М7)                   ,СМ := слот кадра 8
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     GOTA                    ,если СМ=0 → GOTA
         ПБ     GOTB                    ,переход на GOTB
*
GOTA     ПБ     PAGE1A                  ,переход на PAGE1A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
GOTB     СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   GOT                     ,мод.адрес := GOT
         СЧ     0                       ,СМ := слово по адресу GOT
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F1                      ,если СМ=0 → F1
         ПБ     F1A                     ,переход на F1A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1       ПБ     F1B                     ,переход на F1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1A      УИА    К0(М16)                 ,М16 := адрес К0
