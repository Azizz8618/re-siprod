         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     SCANEB                  ,переход на SCANEB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
PAGE1A   МОДА   PAGE1                   ,мод.адрес := PAGE1
         СЧ     0                       ,СМ := слово по адресу PAGE1
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   TYPE13                  ,мод.адрес := TYPE13
         ВЧ     0                       ,СМ -= слово по адресу TYPE13
