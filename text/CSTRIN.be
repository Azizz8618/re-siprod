***************************************************
* CSTRIN - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 9248 образа SIPROD.BIN
*   Длина при загрузке: 63 слов, 106 команд
*   Вход: CSTRIN
*   Выход: NAMENF:F9B, NOTFOR:TYPEA, NOTFOR:F0, NOTFOR:ENDKOB, 
*   TARNYB:TYPEA, TARNYB:NOTFE, TARNYB:F1A, F8 (возврат через М12), 
*   POP (возврат через М10)
*   Внешние: WHO, ENDKOR, HOWSMB, RASPS, WRIKOR
*   Смещения в WHO: 1
*   Смещения в кадре (М7): общие 1, 7-8, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 WHO
*   002 WHO1
*   003 ENDKOR
*   004 HOWSMB
*   005 RASPS
*   006 WRIKOR
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля; для констант - значение):
*   К0     65    1243011520651440
*   К1     66    6400000000000001
*   К2     67    6400000000000002
*   К3     70    6400000000000005
*   К4     71    6400000000000006
*   К5     72    6400000000000020
*   V0     73
*   V1     74
*   V2     75
*   V3     76
*
*** КОД МОДУЛЯ
*
CSTRIN   СТАРТ  0
         УИА    ADDR(М16)               ,М16 := адрес ADDR
         ПБ     F8                      ,переход на F8
*
ADDR     УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К1(М16)                 ,М16 := адрес К1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОД    V2                      ,мод.адрес := код из V2
         УИА    0(М16)                  ,М16 := код из V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К5(М16)                 ,М16 := адрес К5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К5(М16)                 ,М16 := адрес К5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RASPS(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     HOWSMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    WHO(М16)                ,М16 := адрес WHO
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    WHO1(М16)               ,М16 := адрес WHO1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К4(М16)                 ,М16 := адрес К4
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К1(М16)                 ,М16 := адрес К1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОД    V3                      ,мод.адрес := код из V3
         УИА    0(М16)                  ,М16 := код из V3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К5(М16)                 ,М16 := адрес К5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К5(М16)                 ,М16 := адрес К5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RASPS(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     HOWSMB(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    WHO(М16)                ,М16 := адрес WHO
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    WHO1(М16)               ,М16 := адрес WHO1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ENDKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F8       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         ЗПМ    8(М7)                   ,ЗП + магазин: 8(М7)
         ЗПМ    7(М7)                   ,ЗП + магазин: 7(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

