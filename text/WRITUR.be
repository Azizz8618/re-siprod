         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         МОДА   FOR4                    ,мод.адрес := FOR4
         СЛ     0                       ,СМ += слово по адресу FOR4
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F4                      ,если СМ≠0 → F4
