***************************************************
* READNB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6176 образа SIPROD.BIN
*   Длина при загрузке: 115 слов, 202 команд
*   Вход: READNB
*   Выход: IPONUM:F1, ONEPLA:PAGE1A, F1C (возврат через М12), 
*   F1D (возврат через М10)
*   Внешние: INS, NUM, SCANER, NBR, KLAIDA, SYTINT, RNSYMB, ПEЖDDЙ
*   Смещения в INS: 24, 25, 26
*   Смещения в NUM: 1, 2, 3
*   Смещения в SCANER: 1, 2
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-6, 8-10, свои 11-12, вне кадра 2064
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 NUM
*   006 NUM2
*   007 NUM3
*   008 SCANER
*   009 SCANER1
*   010 SCANER2
*   011 NBR
*   012 KLAIDA
*   013 SYTINT
*   014 RNSYMB
*   015 ПEЖDDЙ
*   016 N1
*   017 NUM1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К1     146
*   V2     157
*   V3     160
*   V4     161
*   V5     162
*
*** КОД МОДУЛЯ
*
READNB   СТАРТ  0
         УИА    F0(М16)                 ,М16 := адрес F0
         ПБ     F1C                     ,переход на F1C
*
F0       СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
ПEЖDDA   ПВ     ПEЖDDЙ(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     3(М7)                   ,СМ := слот кадра 3
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     SCANEA                  ,если СМ=0 → SCANEA
         ПБ     SCANEC                  ,переход на SCANEC
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEA   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS26                   ,мод.адрес := INS26
         ВЧ     0                       ,СМ -= слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     SCANEB                  ,если СМ≠0 → SCANEB
         ПБ     SCANEC                  ,переход на SCANEC
*
SCANEB   ПБ     ПEЖDDA                  ,переход на ПEЖDDA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEC   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS26                   ,мод.адрес := INS26
         ВЧ     0                       ,СМ -= слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     SCANED                  ,если СМ≠0 → SCANED
         ПБ     SCANEE                  ,переход на SCANEE
*
SCANED   ПБ     F8                      ,переход на F8
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEE   СЧ     3(М7)                   ,СМ := слот кадра 3
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     F3                      ,если СМ≠0 → F3
         ПБ     F6                      ,переход на F6
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3       ПБ     F8                      ,переход на F8
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F6       СЧ     6(М7)                   ,СМ := слот кадра 6
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F1A                     ,переход на F1A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F8       СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         СЧ     2(М7)                   ,СМ := слот кадра 2
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     8(М7)                   ,СМ := слот кадра 8
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     NUM2A                   ,если СМ=0 → NUM2A
         ПБ     NUM2B                   ,переход на NUM2B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NUM2A    ПБ     SCANEH                  ,переход на SCANEH
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NUM2B    СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   NUM2                    ,мод.адрес := NUM2
         ЗП     0                       ,по адресу NUM2 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NUM2C    МОДА   NUM2                    ,мод.адрес := NUM2
         СЧ     0                       ,СМ := слово по адресу NUM2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         МОДА   NUM2                    ,мод.адрес := NUM2
         ЗП     0                       ,по адресу NUM2 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ПEЖDDЙ(М15)             ,вызов через М15
         СЧ     3(М7)                   ,СМ := слот кадра 3
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SCANER1                 ,мод.адрес := SCANER1
         СЧ     0                       ,СМ := слово по адресу SCANER1
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     SCANEF                  ,если СМ≠0 → SCANEF
         ПБ     NUM2E                   ,переход на NUM2E
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEF   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         МОДА   INS26                   ,мод.адрес := INS26
         СЛ     0                       ,СМ += слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     NUM2D                   ,если СМ=0 → NUM2D
         ПБ     NUM2E                   ,переход на NUM2E
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NUM2D    ПБ     NUM2C                   ,переход на NUM2C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NUM2E    МОДА   NUM2                    ,мод.адрес := NUM2
         СЧ     0                       ,СМ := слово по адресу NUM2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     4(М7)                   ,СМ += слот кадра 4
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     NUM2F                   ,если СМ≠0 → NUM2F
         ПБ     NUM2G                   ,переход на NUM2G
*
NUM2F    СЧ     4(М7)                   ,СМ := слот кадра 4
         МОДА   NUM2                    ,мод.адрес := NUM2
         ЗП     0                       ,по адресу NUM2 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NUM2G    СЧ     '4020'(М7)              ,СМ := каталог задачи: таблица страниц
         МОДА   NUM                     ,мод.адрес := NUM
         ЗП     0                       ,по адресу NUM := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     '4020'(М7)              ,СМ := каталог задачи: таблица страниц
         МОДА   NUM1                    ,мод.адрес := NUM1
         ЗП     0                       ,по адресу NUM1 := СМ
         СЧ     5(М7)                   ,СМ := слот кадра 5
         МОДА   NUM2                    ,мод.адрес := NUM2
         ВЧ     0                       ,СМ -= слово по адресу NUM2
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         УИА    INS(М16)                ,М16 := адрес INS
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V3(М16)                 ,М16 := адрес V3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    NUM(М16)                ,М16 := адрес NUM
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V4(М16)                 ,М16 := адрес V4
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    NUM2(М16)               ,М16 := адрес NUM2
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RNSYMB(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   NBR                     ,мод.адрес := NBR
         СЧ     0                       ,СМ := слово по адресу NBR
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F1                      ,если СМ=0 → F1
         ПБ     SCANEG                  ,переход на SCANEG
*
F1       ПБ     F1B                     ,переход на F1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEG   ПБ     ПEЖDDA                  ,переход на ПEЖDDA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEH   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     12(М7)                  ,слот кадра 12 := СМ
         УИА    INS(М16)                ,М16 := адрес INS
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V5(М16)                 ,М16 := адрес V5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    NUM3(М16)               ,М16 := адрес NUM3
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     SYTINT(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F1B                     ,переход на F1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1A      УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     KLAIDA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F1B      ПБ     F1D                     ,переход на F1D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1C      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1D      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

