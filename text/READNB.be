NUM23   ПБ     SCANEC                   ,переход на SCANEC
        МОДА   READNB                   ,мод.адрес +1: READNB
        МОДА   *NUM*+2                  ,мод.адрес +1: *NUM*+2
        СЧ     READNB                   ,СМ := READNB
        РЖА    '3'                      ,РЖ := '3'
        ВЧОБ   READNB                   ,СМ := (адрес) - СМ
        СЛ     ПEЖDDЙ(М7)               ,СМ += ПEЖDDЙ(М7)
        РЖА    '22'                     ,РЖ := '22'
        ПЕ     L0070                    ,если СМ≠0 → L0070
L0157   ПБ     NUM2                     ,переход на NUM2
L0160   СЧ     4(М7)                    ,СМ := 4(М7)
NUM24   МОДА   *NUM*+2                  ,мод.адрес +1: *NUM*+2
RNSYMB  ЗП     READNB                   ,READNB := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОДА   READNB                   ,мод.адрес +1: READNB
        СЧ     '4020'(М7)               ,СМ := '4020'(М7)
        МОДА   *NUM*                    ,мод.адрес +1: *NUM*
        ЗП     READNB                   ,READNB := СМ
        РЖА    '3'                      ,РЖ := '3'
        СЧ     '4020'(М7)               ,СМ := '4020'(М7)
        МОДА   *NUM*+1                  ,мод.адрес +1: *NUM*+1
        ЗП     READNB                   ,READNB := СМ
        СЧ     5(М7)                    ,СМ := 5(М7)
        МОДА   *NUM*+2                  ,мод.адрес +1: *NUM*+2
        ВЧ     READNB                   ,СМ -= READNB
        СЛ     L0001(М7)                ,СМ += L0001(М7)
        ЗП     11(М7)                   ,11 := СМ
        УИА    *INS*(М16)               ,М16 := *INS*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0160(М16)               ,М16 := L0160
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *NUM*(М16)               ,М16 := *NUM*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    NUM24(М16)               ,М16 := NUM24
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *NUM*+2(М16)             ,М16 := *NUM*+2
        СЧИМ   М16                      ,стек := М16, СМ := М16
        РЖА    '22'                     ,РЖ := '22'
        ПВ     RNSYMB(М15)              ,вызов через М15
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
        СЧ     READNB                   ,СМ := READNB
        РЖА    '3'                      ,РЖ := '3'
        ВЧ     1(М7)                    ,СМ -= 1(М7)
        МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
        ЗП     READNB                   ,READNB := СМ
        СЧ     1(М7)                    ,СМ := 1(М7)
        СЧИМ                            ,СЧИ + магазин
        МОДА   *NBR*                    ,мод.адрес +1: *NBR*
        СЧ     READNB                   ,СМ := READNB
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    READNB(М17)              ,СМ ^= READNB(М17)
        ПО     L0117                    ,если СМ=0 → L0117
        ПБ     NUM22                    ,переход на NUM22
        ПБ     L0135                    ,переход на L0135
        МОДА   READNB                   ,мод.адрес +1: READNB
