        МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
L0135   СЧ     READNB                   ,СМ := READNB
INS322  РЖА    '3'                      ,РЖ := '3'
        ВЧОБ   READNB                   ,СМ := (адрес) - СМ
        МОДА   *INS*+32                 ,мод.адрес +1: *INS*+32
        СЛ     READNB                   ,СМ += READNB
        РЖА    '22'                     ,РЖ := '22'
V33     ПО     V6                       ,если СМ=0 → V6
