L0117   СЛ     L0001(М7)                ,СМ += L0001(М7)
NUM22   МОДА   *NUM*+2                  ,мод.адрес +1: *NUM*+2
ПEЖDDA  ЗП     READNB                   ,READNB := СМ
        РЖА    '22'                     ,РЖ := '22'
        ПВ     ПE ЖDD Й(М15)            ,вызов через М15
        СЧ     3(М7)                    ,СМ := 3(М7)
