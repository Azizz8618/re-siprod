***************************************************
* READNB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6176 образа SIPROD.BIN
*   Длина при загрузке: 115 слов, 202 команд
*   Вход: READNB
*   Внешние: *INS*, *NUM*, *SCANER*, *NBR*, KLAIDA, SYTINT, RNSYMB, 
*   ПE ЖDD Й
*   Смещения в *INS*: 24, 25, 26
*   Смещения в *NUM*: 1, 2, 3
*   Смещения в *SCANER*: 1, 2
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
READNB  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     INS322                   ,переход на INS322
        СЧ     READNB(М7)               ,СМ := READNB(М7)
L0003   ЗП     8(М7)                    ,8 := СМ
ПEЖDDЙ  РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПВ     ПE ЖDD Й(М15)            ,вызов через М15
        МОДА   READNB                   ,мод.адрес +1: READNB
L0010   СЧ     3(М7)                    ,СМ := 3(М7)
        СЧИМ                            ,СЧИ + магазин
SCANER  МОДА   *SCANER*+1               ,мод.адрес +1: *SCANER*+1
        СЧ     READNB                   ,СМ := READNB
L0014   НТЖ    READNB(М17)              ,СМ ^= READNB(М17)
SCANEA  ПО     L0010                    ,если СМ=0 → L0010
        ПБ     SCANEA                   ,переход на SCANEA
        МОДА   READNB                   ,мод.адрес +1: READNB
        МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
L0021   СЧ     READNB                   ,СМ := READNB
INS32   РЖА    '3'                      ,РЖ := '3'
        МОДА   *INS*+32                 ,мод.адрес +1: *INS*+32
        ВЧ     READNB                   ,СМ -= READNB
        РЖА    '22'                     ,РЖ := '22'
L0026   ПЕ     L0014                    ,если СМ≠0 → L0014
V3      ПБ     SCANEA                   ,переход на SCANEA
        ПБ     L0003                    ,переход на L0003
        МОДА   READNB                   ,мод.адрес +1: READNB
SCANEB  МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
        СЧ     READNB                   ,СМ := READNB
        РЖА    '3'                      ,РЖ := '3'
        МОДА   *INS*+32                 ,мод.адрес +1: *INS*+32
        ВЧ     READNB                   ,СМ -= READNB
        РЖА    '22'                     ,РЖ := '22'
L0040   ПЕ     L0021                    ,если СМ≠0 → L0021
V32     ПБ     INS32                    ,переход на INS32
        ПБ     SCANEB                   ,переход на SCANEB
        МОДА   READNB                   ,мод.адрес +1: READNB
        СЧ     3(М7)                    ,СМ := 3(М7)
        СЧИМ                            ,СЧИ + магазин
SCANEC  МОДА   *SCANER*+1               ,мод.адрес +1: *SCANER*+1
        СЧ     READNB                   ,СМ := READNB
        НТЖ    READNB(М17)              ,СМ ^= READNB(М17)
        ПЕ     L0026                    ,если СМ≠0 → L0026
        ПБ     V3                       ,переход на V3
        МОДА   READNB                   ,мод.адрес +1: READNB
        ПБ     SCANEB                   ,переход на SCANEB
        МОДА   READNB                   ,мод.адрес +1: READNB
L0056   СЧ     6(М7)                    ,СМ := 6(М7)
        ЗП     9(М7)                    ,9 := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПБ     SCANED                   ,переход на SCANED
V6      МОДА   READNB                   ,мод.адрес +1: READNB
L0064   СЧ     8(М7)                    ,СМ := 8(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     L0001(М7)                ,СМ += L0001(М7)
        ЗП     8(М7)                    ,8 := СМ
L0070   СЧ     2(М7)                    ,СМ := 2(М7)
        СЧИМ                            ,СЧИ + магазин
        СЧ     8(М7)                    ,СМ := 8(М7)
NUM2    РЖА    '22'                     ,РЖ := '22'
        НТЖ    READNB(М17)              ,СМ ^= READNB(М17)
        ПО     L0040                    ,если СМ=0 → L0040
        ПБ     V32                      ,переход на V32
        МОДА   READNB                   ,мод.адрес +1: READNB
        ПБ     ПEЖDDA                   ,переход на ПEЖDDA
        МОДА   READNB                   ,мод.адрес +1: READNB
        СЧ     READNB(М7)               ,СМ := READNB(М7)
        МОДА   *NUM*+2                  ,мод.адрес +1: *NUM*+2
