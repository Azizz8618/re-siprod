***************************************************
* KODKOD - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19776 образа SIPROD.BIN
*   Длина при загрузке: 44 слов, 76 команд
*   Вход: KODKOD
*   Выход: L0074 (возврат через М12), POP (возврат через М10)
*   Внешние: NEW, NEWST, SCAKOD, RSYMB
*   Смещения в кадре (М7): общие 0-5, 10
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 NEW
*   002 NEWST
*   003 SCAKOD
*   004 RSYMB
*   005 NEWST32767
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     46
*   К2     50
*   V0     52
*   V1     53
*
*** КОД МОДУЛЯ
*
KODKOD   СТАРТ  0
         УИА    NEWA(М16)               ,М16 := адрес NEWA
         ПБ     L0074                   ,переход на L0074
*
NEWA     СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   NEW                     ,мод.адрес := NEW
         ЗП     0                       ,по адресу NEW := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NEWB     СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
NEWC     МОД    V0                      ,мод.адрес := код из V0
         УИА    0(М1)                   ,М1 := код из V0
         МОДА   NEWST32767(М1)          ,мод.адрес := NEWST32767(М1)
         УИА    0(М16)                  ,М16 := адрес NEWST32767+М1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    NEW(М16)                ,М16 := адрес NEW
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     SCAKOD(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         УИА    NEW(М16)                ,М16 := адрес NEW
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         МОД    V0                      ,мод.адрес := код из V0
         УИА    0(М1)                   ,М1 := код из V0
         МОДА   NEWST32767(М1)          ,мод.адрес := NEWST32767(М1)
         УИА    0(М16)                  ,М16 := адрес NEWST32767+М1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     5(М7)                   ,СМ := слот кадра 5
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     NEWC                    ,если СМ=0 → NEWC
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     4(М7)                   ,СМ := слот кадра 4
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         ВЧОБ   3(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     NEWB                    ,если СМ=0 → NEWB
         ПБ     POP                     ,переход на POP
*
L0074    УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
К0       КОНД   В'6400000000000000'
К2       КОНД   В'6400000000000006'
V0       ПАМ    1
V1       ПАМ    1
	ФИНИШ

