***************************************************
* KODKOD - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19776 образа SIPROD.BIN
*   Длина при загрузке: 44 слов, 76 команд
*   Вход: KODKOD
*   Внешние: NEW, NEWST, SCAKOD, RSYMB
*   Регистры: М1, М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 NEW
*   002 NEWST
*   003 SCAKOD
*   004 RSYMB
*   005 NEWST32767
*
KODKOD   СТАРТ  0
         УИА    NEWA(М16)               ,М16 := NEWA
NEWA     ПБ     L0052                   ,переход на L0052
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   NEW                     ,мод.адрес +1: NEW
         ЗП     0                       ,0 := СМ
L0005    РЖА    '3'                     ,РЖ := '3'
         СЧ     1(М7)                   ,СМ := 1(М7)
RSYMBA   ЗП     4(М7)                   ,4 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
         ЗП     5(М7)                   ,5 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОД    L0052A                  ,мод.адрес по коду: L0052A
         УИА    0(М1)                   ,М1 := 0
         МОДА   NEWST32767(М1)          ,мод.адрес +1: NEWST32767(М
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V1(М16)                 ,М16 := V1
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    NEW(М16)                ,М16 := NEW
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    RSYMBB(М16)             ,М16 := RSYMBB
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПВ     SCAKOD(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
L0052    УИА    NEW(М16)                ,М16 := NEW
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    RSYMBB(М16)             ,М16 := RSYMBB
         СЧИМ   М16                     ,стек := М16, СМ := М16
         МОД    L0052A                  ,мод.адрес по коду: L0052A
NEWST3   УИА    0(М1)                   ,М1 := 0
         МОДА   NEWST32767(М1)          ,мод.адрес +1: NEWST32767(М
         УИА    0(М16)                  ,М16 := 0
L0046    СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V1(М16)                 ,М16 := V1
RSYMBB   СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
L0052A   РЖА    '3'                     ,РЖ := '3'
V1       РЖА    '22'                    ,РЖ := '22'
         СЧ     5(М7)                   ,СМ := 5(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         ЗП     5(М7)                   ,5 := СМ
         ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := '22'
         ПО     RSYMBA                  ,если СМ=0 → RSYMBA
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     4(М7)                   ,СМ := 4(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         ЗП     4(М7)                   ,4 := СМ
         ВЧОБ   3(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := '22'
         ПО     L0005                   ,если СМ=0 → L0005
         ПБ     NEWST3                  ,переход на NEWST3
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    L0046(М7)               ,М7 := L0046
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М1                      ,стек := М1, СМ := М1
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М1                      ,М1 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10
         МОДА   0                       ,мод.адрес +1: 0

