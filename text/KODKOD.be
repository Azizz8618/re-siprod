***************************************************
* KODKOD - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19776 образа SIPROD.BIN
*   Длина при загрузке: 44 слов, 76 команд
*   Вход: KODKOD
*   Выход: смещение 105, через М12, смещение 112, через М10
*   Внешние: NEW, NEWST, SCAKOD, RSYMB
*   Регистры: М1, М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 NEW
*   002 NEWST
*   003 SCAKOD
*   004 RSYMB
*   005 NEWST32767
*
KODKOD   СТАРТ  0
         УИА    NEWA(М16)               ,М16 := NEWA
NEWA     ПБ     NEWST3                  ,переход на NEWST3
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   NEW                     ,мод.адрес +1: NEW
         ЗП     0                       ,0 := СМ
NEWB     РЖА    '3'                     ,РЖ := '3'
         СЧ     1(М7)                   ,СМ := 1(М7)
NEWC     ЗП     4(М7)                   ,4 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
         ЗП     5(М7)                   ,5 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         МОД    V5                      ,мод.адрес по коду: V5
         УИА    0(М1)                   ,М1 := 0
         МОДА   NEWST32767(М1)          ,мод.адрес +1: NEWST32767(М
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V5A(М16)                ,М16 := V5A
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    NEW(М16)                ,М16 := NEW
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    NEWSTC(М16)             ,М16 := NEWSTC
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПВ     SCAKOD(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
NEWST3   УИА    NEW(М16)                ,М16 := NEW
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    NEWSTC(М16)             ,М16 := NEWSTC
         СЧИМ   М16                     ,стек := М16, СМ := М16
         МОД    V5                      ,мод.адрес по коду: V5
NEWSTA   УИА    0(М1)                   ,М1 := 0
         МОДА   NEWST32767(М1)          ,мод.адрес +1: NEWST32767(М
         УИА    0(М16)                  ,М16 := 0
NEWSTB   СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V5A(М16)                ,М16 := V5A
NEWSTC   СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     RSYMB(М15)              ,вызов через М15
V5       РЖА    '3'                     ,РЖ := '3'
V5A      РЖА    '22'                    ,РЖ := '22'
         СЧ     5(М7)                   ,СМ := 5(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         ЗП     5(М7)                   ,5 := СМ
         ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := '22'
         ПО     NEWC                    ,если СМ=0 → NEWC
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     4(М7)                   ,СМ := 4(М7)
         РЖА    '3'                     ,РЖ := '3'
         СЛ     1(М7)                   ,СМ += 1(М7)
         ЗП     4(М7)                   ,4 := СМ
         ВЧОБ   3(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := '22'
         ПО     NEWB                    ,если СМ=0 → NEWB
         ПБ     NEWSTA                  ,переход на NEWSTA
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    NEWSTB(М7)              ,М7 := NEWSTB
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М1                      ,стек := М1, СМ := М1
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М1                      ,М1 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10
         МОДА   0                       ,мод.адрес +1: 0

