***************************************************
* FILLS - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 15072 образа SIPROD.BIN
*   Длина при загрузке: 20 слов, 34 команд
*   Вход: FILLS
*   Внешние: STR, Ы2Б0
*   Смещения в STR: 24, 25, 26
*   Регистры: М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 STR
*   002 STR24
*   003 STR25
*   004 STR26
*   005 Ы2Б0
*
FILLS    СТАРТ  0
         УИА    STR26A(М16)             ,М16 := STR26A
STR26A   ПБ     L0023                   ,переход на L0023
         МОДА   STR26                   ,мод.адрес +1: STR26
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         МОДА   STR24                   ,мод.адрес +1: STR24
         ВЧ     0                       ,СМ -= 0
         СЛ     0(М7)                   ,СМ += 0(М7)
         ЗП     1(М7)                   ,1 := СМ
         УИА    L0022(М16)              ,М16 := L0022
L0023    СЧИМ   М16                     ,стек := М16, СМ := М16
         МОД    L0023A                  ,мод.адрес по коду: L0023A
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         РЖА    '22'                    ,РЖ := '22'
Ы2Б0A    ПВ     Ы2Б0(М15)               ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
L0021    РЖА    '22'                    ,РЖ := '22'
L0022    ПБ     Ы2Б0A                   ,переход на Ы2Б0A
L0023A   МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    L0021(М7)               ,М7 := L0021
         ЗПМ    2(М7)                   ,ЗП + магазин: 2(М7)
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

