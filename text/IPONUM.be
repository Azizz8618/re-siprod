***************************************************
* IPONUM - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 9408 образа SIPROD.BIN
*   Длина при загрузке: 52 слов, 88 команд
*   Вход: IPONUM
*   Выход: WRIIPO:V0A, NUM2A (возврат через М12), 
*   NUM2A (возврат через М10)
*   Внешние: NUM, SCANER, INS, PAGE, NBR, ENDKOR, WRIKOR, GOTOPO, READNB
*   Смещения в INS: 24, 25, 26
*   Смещения в NUM: 2, 3
*   Смещения в PAGE: 1
*   Смещения в SCANER: 1, 2
*   Регистры: М7, М10, М12, М15, М16
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 NUM
*   002 NUM2
*   003 NUM3
*   004 SCANER
*   005 SCANER1
*   006 SCANER2
*   007 INS
*   008 INS24
*   009 INS25
*   010 INS26
*   011 PAGE
*   012 NBR
*   013 ENDKOR
*   014 WRIKOR
*   015 GOTOPO
*   016 READNB
*   017 PAGE1
*
IPONUM   СТАРТ  0
         УИА    SCANEA(М16)             ,М16 := SCANEA
SCANEA   ПБ     V1A                     ,переход на V1A
         МОДА   SCANER                  ,мод.адрес +1: SCANER
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
SCANEB   МОДА   INS26                   ,мод.адрес +1: INS26
SCANEC   ВЧ     0                       ,СМ -= 0
         РЖА    '22'                    ,РЖ := '22'
         ПО     SCANEB                  ,если СМ=0 → SCANEB
         ПБ     SCANEC                  ,переход на SCANEC
         ПБ     V1                      ,переход на V1
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     1(М7)                   ,СМ := 1(М7)
         МОДА   NBR                     ,мод.адрес +1: NBR
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
READNA   ПВ     READNB(М15)             ,вызов через М15
         СЧ     0(М7)                   ,СМ := 0(М7)
NBRA     МОДА   NBR                     ,мод.адрес +1: NBR
         ЗП     0                       ,0 := СМ
         РЖА    '3'                     ,РЖ := '3'
         МОДА   PAGE1                   ,мод.адрес +1: PAGE1
         СЧ     0                       ,СМ := 0
         МОДА   NUM2                    ,мод.адрес +1: NUM2
         ВЧ     0                       ,СМ -= 0
         ВЧ     3(М7)                   ,СМ -= 3(М7)
         ЗП     5(М7)                   ,5 := СМ
         СЧ     5(М7)                   ,СМ := 5(М7)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     0(М7)                   ,СМ += 0(М7)
         РЖА    '22'                    ,РЖ := '22'
         ПО     READNA                  ,если СМ=0 → READNA
         ПБ     NBRA                    ,переход на NBRA
         СЧ     1(М7)                   ,СМ := 1(М7)
         ЗП     5(М7)                   ,5 := СМ
V1       РЖА    '3'                     ,РЖ := '3'
V1A      РЖА    '22'                    ,РЖ := '22'
         УИА    WRIKOA(М16)             ,М16 := WRIKOA
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     GOTOPO(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
V1B      РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
V1C      УИА    V1C(М16)                ,М16 := V1C
V1D      СЧИМ   М16                     ,стек := М16, СМ := М16
V1E      УИА    V1E(М16)                ,М16 := V1E
V1F      СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V1F(М16)                ,М16 := V1F
         СЧИМ   М16                     ,стек := М16, СМ := М16
WRIKOA   ПВ     WRIKOR(М15)             ,вызов через М15
NUM2A    МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         СЧ     4(М7)                   ,СМ := 4(М7)
         РЖА    '3'                     ,РЖ := '3'
         МОДА   NUM2                    ,мод.адрес +1: NUM2
         ВЧ     0                       ,СМ -= 0
         СЛ     1(М7)                   ,СМ += 1(М7)
         ЗП     6(М7)                   ,6 := СМ
         УИА    NUM(М16)                ,М16 := NUM
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    NUM2A(М16)              ,М16 := NUM2A
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    NUM2(М16)               ,М16 := NUM2
         СЧИМ   М16                     ,стек := М16, СМ := М16
         РЖА    '22'                    ,РЖ := '22'
         ПВ     WRIKOR(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
         ПВ     ENDKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     V1B                     ,переход на V1B
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    V1D(М7)                 ,М7 := V1D
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

