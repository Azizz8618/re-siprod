***************************************************
* IPONUM - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 9408 образа SIPROD.BIN
*   Длина при загрузке: 52 слов, 88 команд
*   Вход: IPONUM
*   Выход: WRIIPO:SCANEA, F4A (возврат через М12), F4B (возврат через М10)
*   Внешние: NUM, SCANER, INS, PAGE, NBR, ENDKOR, WRIKOR, GOTOPO, READNB
*   Смещения в INS: 24, 25, 26
*   Смещения в NUM: 2, 3
*   Смещения в PAGE: 1
*   Смещения в SCANER: 1, 2
*   Смещения в кадре (М7): общие 0-1, 3-6, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 NUM
*   002 NUM2
*   003 NUM3
*   004 SCANER
*   005 SCANER1
*   006 SCANER2
*   007 INS
*   008 INS24
*   009 INS25
*   010 INS26
*   011 PAGE
*   012 NBR
*   013 ENDKOR
*   014 WRIKOR
*   015 GOTOPO
*   016 READNB
*   017 PAGE1
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     54
*   К1     55
*   К2     56
*   К3     57
*   V0     62
*   V1     63
*
*** КОД МОДУЛЯ
*
IPONUM   СТАРТ  0
         УИА    SCANEA(М16)             ,М16 := адрес SCANEA
         ПБ     F4A                     ,переход на F4A
*
SCANEA   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS26                   ,мод.адрес := INS26
         ВЧ     0                       ,СМ -= слово по адресу INS26
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     NBRA                    ,если СМ=0 → NBRA
         ПБ     NBRB                    ,переход на NBRB
*
NBRA     ПБ     F4                      ,переход на F4
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
NBRB     СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   NBR                     ,мод.адрес := NBR
         ЗП     0                       ,по адресу NBR := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     READNB(М15)             ,вызов через М15
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   NBR                     ,мод.адрес := NBR
         ЗП     0                       ,по адресу NBR := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   PAGE1                   ,мод.адрес := PAGE1
         СЧ     0                       ,СМ := слово по адресу PAGE1
         МОДА   NUM2                    ,мод.адрес := NUM2
         ВЧ     0                       ,СМ -= слово по адресу NUM2
         ВЧ     3(М7)                   ,СМ -= слот кадра 3
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         СЧ     5(М7)                   ,СМ := слот кадра 5
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     0(М7)                   ,СМ += слот кадра 0
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F1                      ,если СМ=0 → F1
         ПБ     F1A                     ,переход на F1A
*
F1       СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F1A      УИА    V0(М16)                 ,М16 := адрес V0
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     GOTOPO(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         УИА    К0(М16)                 ,М16 := адрес К0
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     WRIKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     4(М7)                   ,СМ := слот кадра 4
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   NUM2                    ,мод.адрес := NUM2
         ВЧ     0                       ,СМ -= слово по адресу NUM2
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         УИА    NUM(М16)                ,М16 := адрес NUM
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    NUM2(М16)               ,М16 := адрес NUM2
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     WRIKOR(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ENDKOR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F4       ПБ     F4B                     ,переход на F4B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F4A      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F4B      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

