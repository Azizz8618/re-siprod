***************************************************
* HEADIN - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 20352 образа SIPROD.BIN
*   Длина при загрузке: 93 слов, 166 команд
*   Вход: HEADIN
*   Выход: F0A (возврат через М12), F0B (возврат через М10)
*   РАЗБОР ЗАГОЛОВКА ВХОДНОГО БЛОКА.
*   Внешние: INS, STR, HED, SCANER, NDAB, FORMA, REGIM, NUST, PAGE, KLAIDA, 
*   DOUBLE, BEGSTR, ENDSTR, TITLE, BEGPG, ENDPG
*   Смещения в FORMA: 10, 11
*   Смещения в HED: 1
*   Смещения в INS: 24, 25, 26
*   Смещения в NDAB: 1, 2
*   Смещения в NUST: 3
*   Смещения в PAGE: 3, 4
*   Смещения в REGIM: 8
*   Смещения в SCANER: 1, 2
*   Смещения в STR: 24, 25, 26
*   Смещения в кадре (М7): общие 0-6, 8-10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 INS
*   002 INS24
*   003 INS25
*   004 INS26
*   005 STR
*   006 STR24
*   007 STR25
*   008 STR26
*   009 HED
*   010 HED1
*   011 SCANER
*   012 SCANER1
*   013 SCANER2
*   014 NDAB
*   015 NDAB1
*   016 NDAB2
*   017 FORMA
*   018 REGIM
*   019 NUST
*   020 PAGE
*   021 KLAIDA
*   022 DOUBLE
*   023 BEGSTR
*   024 ENDSTR
*   025 TITLE
*   026 BEGPG
*   027 ENDPG
*   028 PAGE3
*   029 PAGE4
*   030 REGIM8
*   031 NUST3
*   032 FORMA10
*   033 FORMA11
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     123
*   V1     133
*   V2     134
*
*** КОД МОДУЛЯ
*
HEADIN   СТАРТ  0
         УИА    HEDA(М16)               ,М16 := адрес HEDA
         ПБ     F0A                     ,переход на F0A
*
HEDA     СЧ     5(М7)                   ,СМ := слот кадра 5
         МОДА   HED                     ,мод.адрес := HED
         ЗП     0                       ,по адресу HED := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     2(М7)                   ,СМ := слот кадра 2
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   HED1                    ,мод.адрес := HED1
         СЧ     0                       ,СМ := слово по адресу HED1
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     SCANEA                  ,если СМ=0 → SCANEA
         ПБ     SCANEB                  ,переход на SCANEB
*
SCANEA   ПБ     ENDSTA                  ,переход на ENDSTA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SCANEB   МОДА   SCANER                  ,мод.адрес := SCANER
         СЧ     0                       ,СМ := слово по адресу SCANER
         МОДА   INS24                   ,мод.адрес := INS24
         ЗП     0                       ,по адресу INS24 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     ENDPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     BEGPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     TITLE(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     HEDB                    ,переход на HEDB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ENDSTA   ПВ     ENDSTR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     BEGSTR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         МОДА   NDAB                    ,мод.адрес := NDAB
         СЧ     0                       ,СМ := слово по адресу NDAB
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     2(М7)                   ,СМ += слот кадра 2
         МОДА   NDAB                    ,мод.адрес := NDAB
         ЗП     0                       ,по адресу NDAB := СМ
         МОДА   NDAB                    ,мод.адрес := NDAB
         СЧ     0                       ,СМ := слово по адресу NDAB
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         МОДА   PAGE3                   ,мод.адрес := PAGE3
         СЛ     0                       ,СМ += слово по адресу PAGE3
         МОДА   PAGE4                   ,мод.адрес := PAGE4
         СЛ     0                       ,СМ += слово по адресу PAGE4
         ВЧ     5(М7)                   ,СМ -= слот кадра 5
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F2                      ,если СМ=0 → F2
         ПБ     ENDPGA                  ,переход на ENDPGA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F2       ПБ     REGIMA                  ,переход на REGIMA
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ENDPGA   ПВ     ENDPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     BEGPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
REGIMA   СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   REGIM8                  ,мод.адрес := REGIM8
         ЗП     0                       ,по адресу REGIM8 := СМ
         СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   NUST3                   ,мод.адрес := NUST3
         ЗП     0                       ,по адресу NUST3 := СМ
         МОДА   STR25                   ,мод.адрес := STR25
         СЧ     0                       ,СМ := слово по адресу STR25
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     2(М7)                   ,СМ += слот кадра 2
         МОДА   FORMA10                 ,мод.адрес := FORMA10
         ЗП     0                       ,по адресу FORMA10 := СМ
         МОДА   FORMA11                 ,мод.адрес := FORMA11
         СЧ     0                       ,СМ := слово по адресу FORMA11
         ВЧ     4(М7)                   ,СМ -= слот кадра 4
         МОДА   FORMA11                 ,мод.адрес := FORMA11
         ЗП     0                       ,по адресу FORMA11 := СМ
         МОДА   FORMA11                 ,мод.адрес := FORMA11
         СЧ     0                       ,СМ := слово по адресу FORMA11
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         СЛ     3(М7)                   ,СМ += слот кадра 3
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     F0                      ,если СМ≠0 → F0
         ПБ     F6                      ,переход на F6
*
F0       ПБ     INS26A                  ,переход на INS26A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F6       СЧ     6(М7)                   ,СМ := слот кадра 6
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F1B                     ,переход на F1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
INS26A   МОДА   INS26                   ,мод.адрес := INS26
         СЧ     0                       ,СМ := слово по адресу INS26
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         УИА    SCANER(М16)             ,М16 := адрес SCANER
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     DOUBLE(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         МОДА   REGIM8                  ,мод.адрес := REGIM8
         ЗП     0                       ,по адресу REGIM8 := СМ
         ПВ     ENDSTR(М15)             ,вызов через М15
         ПВ     BEGSTR(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         МОДА   NDAB                    ,мод.адрес := NDAB
         СЧ     0                       ,СМ := слово по адресу NDAB
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     2(М7)                   ,СМ += слот кадра 2
         МОДА   NDAB                    ,мод.адрес := NDAB
         ЗП     0                       ,по адресу NDAB := СМ
         МОДА   NDAB                    ,мод.адрес := NDAB
         СЧ     0                       ,СМ := слово по адресу NDAB
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         МОДА   PAGE3                   ,мод.адрес := PAGE3
         СЛ     0                       ,СМ += слово по адресу PAGE3
         МОДА   PAGE4                   ,мод.адрес := PAGE4
         СЛ     0                       ,СМ += слово по адресу PAGE4
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     F1                      ,если СМ=0 → F1
         ПБ     ENDPGB                  ,переход на ENDPGB
*
F1       ПБ     F1A                     ,переход на F1A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
ENDPGB   ПВ     ENDPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     BEGPG(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1A      ПБ     HEDB                    ,переход на HEDB
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1B      УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     KLAIDA(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
HEDB     СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   HED                     ,мод.адрес := HED
         ЗП     0                       ,по адресу HED := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   INS26                   ,мод.адрес := INS26
         СЧ     0                       ,СМ := слово по адресу INS26
         СЛ     1(М7)                   ,СМ += слот кадра 1
         МОДА   SCANER                  ,мод.адрес := SCANER
         ЗП     0                       ,по адресу SCANER := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F0B                     ,переход на F0B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0A      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0B      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*

