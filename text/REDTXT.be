***************************************************
* REDTXT - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 16096 образа SIPROD.BIN
*   Длина при загрузке: 32 слов, 52 команд
*   Вход: REDTXT
*   Выход: смещение 56, через М12, смещение 63, через М10
*   ОБРАБОТКА ТЕКСТА *RED: ПЕРЕДАЁТ УПРАВЛЕНИЕ РАЗБОРУ
*   КОМАНД SPAUD.
*   Внешние: FIN, REGIM, NUST, RUSIS, SPAUD
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 FIN
*   002 REGIM
*   003 NUST
*   004 RUSIS
*   005 SPAUD
*
* ПЕРЕДАЧА ТЕКСТА РАЗБОРУ КОМАНД SPAUD.
REDTXT   СТАРТ  0
* ПЕРЕДАЧА ТЕКСТА РАЗБОРУ КОМАНД SPAUD.
         УИА    RUSISA(М16)             ,М16 := RUSISA
RUSISA   ПБ     FINB                    ,переход на FINB
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   RUSIS                   ,мод.адрес +1: RUSIS
         ЗП     0                       ,0 := СМ
RUSISB   РЖА    '3'                     ,РЖ := '3'
         СЧ     1(М7)                   ,СМ := 1(М7)
         ЗП     3(М7)                   ,3 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         УИА    V3(М16)                 ,М16 := V3
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V3A(М16)                ,М16 := V3A
RUSISC   СЧИМ   М16                     ,стек := М16, СМ := М16
SPAUDA   ПВ     SPAUD(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
FINA     СЧ     1(М7)                   ,СМ := 1(М7)
FINB     СЧИМ                           ,СЧИ + магазин
         МОДА   FIN                     ,мод.адрес +1: FIN
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     RUSISC                  ,если СМ=0 → RUSISC
FINC     ПБ     SPAUDA                  ,переход на SPAUDA
         МОДА   0                       ,мод.адрес +1: 0
V1       ПБ     FINA                    ,переход на FINA
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     3(М7)                   ,СМ := 3(М7)
         РЖА    '3'                     ,РЖ := '3'
V3       СЛ     1(М7)                   ,СМ += 1(М7)
V3A      ЗП     3(М7)                   ,3 := СМ
         ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := '22'
         ПО     RUSISB                  ,если СМ=0 → RUSISB
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     FINC                    ,переход на FINC
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    V1(М7)                  ,М7 := V1
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

