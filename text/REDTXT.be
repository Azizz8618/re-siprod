***************************************************
* REDTXT - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 16096 образа SIPROD.BIN
*   Длина при загрузке: 32 слов, 52 команд
*   Вход: REDTXT
*   Внешние: FIN, REGIM, NUST, RUSIS, SPAUD
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 FIN
*   002 REGIM
*   003 NUST
*   004 RUSIS
*   005 SPAUD
*
REDTXT   СТАРТ  0
         УИА    RUSISA(М16)             ,М16 := RUSISA
RUSISA   ПБ     FINA                    ,переход на FINA
         СЧ     0(М7)                   ,СМ := 0(М7)
         МОДА   RUSIS                   ,мод.адрес +1: RUSIS
         ЗП     0                       ,0 := СМ
V0       РЖА    '3'                     ,РЖ := '3'
         СЧ     1(М7)                   ,СМ := 1(М7)
         ЗП     3(М7)                   ,3 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОДА   0                       ,мод.адрес +1: 0
         УИА    L0036(М16)              ,М16 := L0036
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    V3(М16)                 ,М16 := V3
L0015    СЧИМ   М16                     ,стек := М16, СМ := М16
SPAUDA   ПВ     SPAUD(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес +1: 0
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '22'                    ,РЖ := '22'
L0022    СЧ     1(М7)                   ,СМ := 1(М7)
FINA     СЧИМ                           ,СЧИ + магазин
         МОДА   FIN                     ,мод.адрес +1: FIN
         СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     L0015                   ,если СМ=0 → L0015
V1       ПБ     SPAUDA                  ,переход на SPAUDA
         МОДА   0                       ,мод.адрес +1: 0
V1A      ПБ     L0022                   ,переход на L0022
         МОДА   0                       ,мод.адрес +1: 0
         СЧ     3(М7)                   ,СМ := 3(М7)
         РЖА    '3'                     ,РЖ := '3'
L0036    СЛ     1(М7)                   ,СМ += 1(М7)
V3       ЗП     3(М7)                   ,3 := СМ
         ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := '22'
         ПО     V0                      ,если СМ=0 → V0
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     V1                      ,переход на V1
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    V1A(М7)                 ,М7 := V1A
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

