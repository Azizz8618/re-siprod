***************************************************
* REDTXT - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 16096 образа SIPROD.BIN
*   Длина при загрузке: 32 слов, 52 команд
*   Вход: REDTXT
*   Внешние: *FIN*, *REGIM*, *NUST*, *RUSIS*, SPAUD
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
REDTXT  СТАРТ  0
        УИА    RUSIS(М16)               ,М16 := RUSIS
RUSIS   ПБ     FIN                      ,переход на FIN
        СЧ     REDTXT(М7)               ,СМ := REDTXT(М7)
        МОДА   *RUSIS*                  ,мод.адрес +1: *RUSIS*
        ЗП     REDTXT                   ,REDTXT := СМ
L0005   РЖА    '3'                      ,РЖ := '3'
        СЧ     1(М7)                    ,СМ := 1(М7)
        ЗП     3(М7)                    ,3 := СМ
V1      РЖА    '22'                     ,РЖ := '22'
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
L0012   УИА    L0036(М16)               ,М16 := L0036
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    V3(М16)                  ,М16 := V3
L0015   СЧИМ   М16                      ,стек := М16, СМ := М16
SPAUD   ПВ     SPAUD(М15)               ,вызов через М15
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0022   СЧ     1(М7)                    ,СМ := 1(М7)
FIN     СЧИМ                            ,СЧИ + магазин
        МОДА   *FIN*                    ,мод.адрес +1: *FIN*
        СЧ     REDTXT                   ,СМ := REDTXT
        НТЖ    REDTXT(М17)              ,СМ ^= REDTXT(М17)
        ПО     L0015                    ,если СМ=0 → L0015
V12     ПБ     SPAUD                    ,переход на SPAUD
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
V13     ПБ     L0022                    ,переход на L0022
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        СЧ     3(М7)                    ,СМ := 3(М7)
        РЖА    '3'                      ,РЖ := '3'
L0036   СЛ     RUSIS(М7)                ,СМ += RUSIS(М7)
V3      ЗП     3(М7)                    ,3 := СМ
        ВЧОБ   2(М7)                    ,СМ := (адрес) - СМ
        РЖА    '22'                     ,РЖ := '22'
        ПО     L0005                    ,если СМ=0 → L0005
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        ПБ     V12                      ,переход на V12
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    V13(М7)                  ,М7 := V13
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     REDTXT(М12)              ,переход через М12
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     REDTXT(М10)              ,переход через М10

