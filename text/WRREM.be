***************************************************
* WRREM - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18368 образа SIPROD.BIN
*   Длина при загрузке: 50 слов, 94 команд
*   Вход: WRREM
*   Внешние: *SEK*, *LYG*, *SEP*, *EGO*, PILDYK
*   Смещения в *EGO*: 2400, 4800, 7200
*   Смещения в *LYG*: 1, 2
*   Смещения в *SEK*: 3
*   Смещения в *SEP*: 1, 2, 3, 4, 5
*   Регистры: М1, М7, М10, М12, М15, М16, М17
***************************************************
WRREM   СТАРТ  0
        УИА    LYG2(М16)                ,М16 := LYG2
LYG2    ПБ     PILDYK                   ,переход на PILDYK
        МОДА   *LYG*+2                  ,мод.адрес +1: *LYG*+2
        СЧ     WRREM                    ,СМ := WRREM
        РЖА    '3'                      ,РЖ := '3'
        СЛ     WRREM(М7)                ,СМ += WRREM(М7)
        ЗП     2(М7)                    ,2 := СМ
        СЧ     1(М7)                    ,СМ := 1(М7)
SEP     СЧИМ                            ,СЧИ + магазин
        МОДА   *SEP*                    ,мод.адрес +1: *SEP*
L0012   СЧ     WRREM                    ,СМ := WRREM
L0013   РЖА    '22'                     ,РЖ := '22'
        НТЖ    WRREM(М17)               ,СМ ^= WRREM(М17)
        ПО     SEP                      ,если СМ=0 → SEP
        ПБ     L0013                    ,переход на L0013
SEK3    МОДА   WRREM                    ,мод.адрес +1: WRREM
        МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
        СЧ     WRREM                    ,СМ := WRREM
        РЖА    '3'                      ,РЖ := '3'
        СЛ     WRREM(М7)                ,СМ += WRREM(М7)
        ЗП     2(М7)                    ,2 := СМ
        РЖА    '22'                     ,РЖ := '22'
        МОД    PILDYA                   ,мод.адрес по коду: PILDYA
SEP4    ПБ     L0013                    ,переход на L0013
        ПБ     SEK3                     ,переход на SEK3
        МОДА   WRREM                    ,мод.адрес +1: WRREM
        ПБ     SEP4                     ,переход на SEP4
        МОДА   WRREM                    ,мод.адрес +1: WRREM
        ПБ     EGO777                   ,переход на EGO777
        МОДА   WRREM                    ,мод.адрес +1: WRREM
        МОД    *SEP*+4                  ,мод.адрес по коду: *SEP*+4
EGO777  УИА    WRREM(М1)                ,М1 := WRREM
        МОДА   *EGO*+77777(М1)          ,мод.адрес +1: *EGO*+77777(
        УИА    WRREM(М16)               ,М16 := WRREM
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+1(М16)             ,М16 := *SEP*+1
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+2(М16)             ,М16 := *SEP*+2
L0046   СЧИМ   М16                      ,стек := М16, СМ := М16
PILDYK  УИА    *SEP*+3(М16)             ,М16 := *SEP*+3
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+5(М16)             ,М16 := *SEP*+5
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     PILDYK(М15)              ,вызов через М15
SEP42   ПБ     L0046                    ,переход на L0046
        МОДА   WRREM                    ,мод.адрес +1: WRREM
        МОД    *SEP*+4                  ,мод.адрес по коду: *SEP*+4
СИМ22   УИА    WRREM(М1)                ,М1 := WRREM
        МОДА   СИМ22(М1)                ,мод.адрес +1: СИМ22(М1)
PILDYA  УИА    WRREM(М16)               ,М16 := WRREM
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+1(М16)             ,М16 := *SEP*+1
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+2(М16)             ,М16 := *SEP*+2
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+3(М16)             ,М16 := *SEP*+3
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+5(М16)             ,М16 := *SEP*+5
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     PILDYK(М15)              ,вызов через М15
        ПБ     L0046                    ,переход на L0046
        МОДА   WRREM                    ,мод.адрес +1: WRREM
        МОД    *SEP*+4                  ,мод.адрес по коду: *SEP*+4
        УИА    WRREM(М1)                ,М1 := WRREM
        МОДА   СИМ23(М1)                ,мод.адрес +1: СИМ23(М1)
        УИА    WRREM(М16)               ,М16 := WRREM
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+1(М16)             ,М16 := *SEP*+1
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+2(М16)             ,М16 := *SEP*+2
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+3(М16)             ,М16 := *SEP*+3
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *SEP*+5(М16)             ,М16 := *SEP*+5
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     PILDYK(М15)              ,вызов через М15
        ПБ     SEP42                    ,переход на SEP42
        МОДА   WRREM                    ,мод.адрес +1: WRREM
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    СИМ22(М7)                ,М7 := СИМ22
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М1                       ,стек := М1, СМ := М1
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     WRREM(М12)               ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М1                       ,М1 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     WRREM(М10)               ,переход через М10
        МОДА   WRREM                    ,мод.адрес +1: WRREM

