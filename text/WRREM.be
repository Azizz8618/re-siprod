***************************************************
* WRREM - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18368 образа SIPROD.BIN
*   Длина при загрузке: 50 слов, 94 команд
*   Вход: WRREM
*   Выход: SEKGIR:SEPF, SEKGIR:F7I, F1A (возврат через М12), 
*   POP (возврат через М10)
*   ВЫВОД ЗАМЕЧАНИЙ (ПРИМЕЧАНИЙ К ТАБЛИЦЕ).
*   Внешние: SEK, LYG, SEP, EGO, PILDYK
*   Смещения в EGO: 2400, 4800, 7200
*   Смещения в LYG: 1, 2
*   Смещения в SEK: 3
*   Смещения в SEP: 1, 2, 3, 4, 5
*   Смещения в кадре (М7): общие 0-2, 10
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес), 
*   М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 SEK
*   002 LYG
*   003 LYG1
*   004 LYG2
*   005 SEP
*   006 SEP1
*   007 SEP2
*   008 SEP3
*   009 SEP4
*   010 SEP5
*   011 EGO
*   012 EGO2400
*   013 EGO4800
*   014 EGO7200
*   015 PILDYK
*   016 SEK3
*   017 EGO32767
*   018 EGO35167
*   019 EGO37567
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     57
*   V0     61
*
*** КОД МОДУЛЯ
*
WRREM    СТАРТ  0
         УИА    LYG2A(М16)              ,М16 := адрес LYG2A
         ПБ     F1A                     ,переход на F1A
*
LYG2A    МОДА   LYG2                    ,мод.адрес := LYG2
         СЧ     0                       ,СМ := слово по адресу LYG2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     2(М7)                   ,слот кадра 2 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SEP                     ,мод.адрес := SEP
         СЧ     0                       ,СМ := слово по адресу SEP
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     SEK3A                   ,если СМ=0 → SEK3A
         ПБ     SEK3B                   ,переход на SEK3B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK3A    МОДА   SEK3                    ,мод.адрес := SEK3
         СЧ     0                       ,СМ := слово по адресу SEK3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     2(М7)                   ,слот кадра 2 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
SEK3B    МОД    V0                      ,мод.адрес := код из V0
         ПБ     SEK3B                   ,переход на SEK3B
*
         ПБ     SEP4A                   ,переход на SEP4A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     SEP4B                   ,переход на SEP4B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     SEP4C                   ,переход на SEP4C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEP4A    МОД    SEP4                    ,мод.адрес := код из SEP4
         УИА    0(М1)                   ,М1 := код из SEP4
         МОДА   EGO32767(М1)            ,мод.адрес := EGO32767(М1)
         УИА    0(М16)                  ,М16 := адрес EGO32767+М1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP1(М16)               ,М16 := адрес SEP1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP2(М16)               ,М16 := адрес SEP2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP3(М16)               ,М16 := адрес SEP3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP5(М16)               ,М16 := адрес SEP5
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     PILDYK(М15)             ,вызов через М15
         ПБ     F1                      ,переход на F1
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEP4B    МОД    SEP4                    ,мод.адрес := код из SEP4
         УИА    0(М1)                   ,М1 := код из SEP4
         МОДА   EGO35167(М1)            ,мод.адрес := EGO35167(М1)
         УИА    0(М16)                  ,М16 := адрес EGO35167+М1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP1(М16)               ,М16 := адрес SEP1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP2(М16)               ,М16 := адрес SEP2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP3(М16)               ,М16 := адрес SEP3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP5(М16)               ,М16 := адрес SEP5
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     PILDYK(М15)             ,вызов через М15
         ПБ     F1                      ,переход на F1
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEP4C    МОД    SEP4                    ,мод.адрес := код из SEP4
         УИА    0(М1)                   ,М1 := код из SEP4
         МОДА   EGO37567(М1)            ,мод.адрес := EGO37567(М1)
         УИА    0(М16)                  ,М16 := адрес EGO37567+М1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP1(М16)               ,М16 := адрес SEP1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP2(М16)               ,М16 := адрес SEP2
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP3(М16)               ,М16 := адрес SEP3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    SEP5(М16)               ,М16 := адрес SEP5
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     PILDYK(М15)             ,вызов через М15
F1       ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1A      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)

