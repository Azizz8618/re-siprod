***************************************************
* WRREM - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 18368 образа SIPROD.BIN
*   Длина при загрузке: 50 слов, 94 команд
*   Вход: WRREM
*   ВЫВОД ЗАМЕЧАНИЙ (ПРИМЕЧАНИЙ К ТАБЛИЦЕ).
*   Внешние: SEK, LYG, SEP, EGO, PILDYK
*   Смещения в EGO: 2400, 4800, 7200
*   Смещения в LYG: 1, 2
*   Смещения в SEK: 3
*   Смещения в SEP: 1, 2, 3, 4, 5
*   Регистры: М1, М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 SEK
*   002 LYG
*   003 LYG1
*   004 LYG2
*   005 SEP
*   006 SEP1
*   007 SEP2
*   008 SEP3
*   009 SEP4
*   010 SEP5
*   011 EGO
*   012 EGO2400
*   013 EGO4800
*   014 EGO7200
*   015 PILDYK
*   016 SEK3
*   017 EGO32767
*   018 EGO35167
*   019 EGO37567
*
WRREM    СТАРТ  0
         УИА    LYG2A(М16)              ,М16 := LYG2A
LYG2A    ПБ     SEP4C                   ,переход на SEP4C
         МОДА   LYG2                    ,мод.адрес +1: LYG2
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     0(М7)                   ,СМ += 0(М7)
         ЗП     2(М7)                   ,2 := СМ
         СЧ     1(М7)                   ,СМ := 1(М7)
LYG2B    СЧИМ                           ,СЧИ + магазин
         МОДА   SEP                     ,мод.адрес +1: SEP
         СЧ     0                       ,СМ := 0
LYG2C    РЖА    '22'                    ,РЖ := '22'
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПО     LYG2B                   ,если СМ=0 → LYG2B
         ПБ     LYG2C                   ,переход на LYG2C
SEK3A    МОДА   0                       ,мод.адрес +1: 0
         МОДА   SEK3                    ,мод.адрес +1: SEK3
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         СЛ     0(М7)                   ,СМ += 0(М7)
         ЗП     2(М7)                   ,2 := СМ
         РЖА    '22'                    ,РЖ := '22'
         МОД    SEP4F                   ,мод.адрес по коду: SEP4F
SEK3B    ПБ     LYG2C                   ,переход на LYG2C
         ПБ     SEK3A                   ,переход на SEK3A
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     SEK3B                   ,переход на SEK3B
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     SEP4A                   ,переход на SEP4A
         МОДА   0                       ,мод.адрес +1: 0
         МОД    SEP4                    ,мод.адрес по коду: SEP4
SEP4A    УИА    0(М1)                   ,М1 := 0
         МОДА   EGO32767(М1)            ,мод.адрес +1: EGO32767(М1)
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP1(М16)               ,М16 := SEP1
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP2(М16)               ,М16 := SEP2
SEP4B    СЧИМ   М16                     ,стек := М16, СМ := М16
SEP4C    УИА    SEP3(М16)               ,М16 := SEP3
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP5(М16)               ,М16 := SEP5
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     PILDYK(М15)             ,вызов через М15
SEP4D    ПБ     SEP4B                   ,переход на SEP4B
         МОДА   0                       ,мод.адрес +1: 0
         МОД    SEP4                    ,мод.адрес по коду: SEP4
SEP4E    УИА    0(М1)                   ,М1 := 0
         МОДА   EGO35167(М1)            ,мод.адрес +1: EGO35167(М1)
SEP4F    УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP1(М16)               ,М16 := SEP1
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP2(М16)               ,М16 := SEP2
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP3(М16)               ,М16 := SEP3
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP5(М16)               ,М16 := SEP5
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     PILDYK(М15)             ,вызов через М15
         ПБ     SEP4B                   ,переход на SEP4B
         МОДА   0                       ,мод.адрес +1: 0
         МОД    SEP4                    ,мод.адрес по коду: SEP4
         УИА    0(М1)                   ,М1 := 0
         МОДА   EGO37567(М1)            ,мод.адрес +1: EGO37567(М1)
         УИА    0(М16)                  ,М16 := 0
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP1(М16)               ,М16 := SEP1
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP2(М16)               ,М16 := SEP2
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP3(М16)               ,М16 := SEP3
         СЧИМ   М16                     ,стек := М16, СМ := М16
         УИА    SEP5(М16)               ,М16 := SEP5
         СЧИМ   М16                     ,стек := М16, СМ := М16
         ПВ     PILDYK(М15)             ,вызов через М15
         ПБ     SEP4D                   ,переход на SEP4D
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    SEP4E(М7)               ,М7 := SEP4E
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М1                      ,стек := М1, СМ := М1
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М1                      ,М1 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10
         МОДА   0                       ,мод.адрес +1: 0

