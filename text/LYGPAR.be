***************************************************
* LYGPAR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 20960 образа SIPROD.BIN
*   Длина при загрузке: 39 слов, 76 команд
*   Вход: LYGPAR
*   Выход: RASTXT:NDAB1E, SEGTAB:TAB3A, F0 (возврат через М12), 
*   F0A (возврат через М10)
*   Внешние: LYG, NDAB, SEK, REGIM
*   Смещения в LYG: 1, 2
*   Смещения в NDAB: 1, 2
*   Смещения в SEK: 2, 3
*   Смещения в кадре (М7): общие 0, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 LYG
*   002 LYG1
*   003 LYG2
*   004 NDAB
*   005 NDAB1
*   006 NDAB2
*   007 SEK
*   008 REGIM
*   009 SEK3
*   010 LYG3
*   011 SEK2
*   012 LYG5
*   013 LYG4
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     46
*
*** КОД МОДУЛЯ
*
LYGPAR   СТАРТ  0
         УИА    SEK3A(М16)              ,М16 := адрес SEK3A
         ПБ     F0                      ,переход на F0
*
SEK3A    МОДА   SEK3                    ,мод.адрес := SEK3
         СЧ     0                       ,СМ := слово по адресу SEK3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОДА   LYG3                    ,мод.адрес := LYG3
         ВЧ     0                       ,СМ -= слово по адресу LYG3
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПЕ     LYG3A                   ,если СМ≠0 → LYG3A
         ПБ     LYG3B                   ,переход на LYG3B
*
LYG3A    ПБ     SEK3D                   ,переход на SEK3D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
LYG3B    МОДА   LYG3                    ,мод.адрес := LYG3
         СЧ     0                       ,СМ := слово по адресу LYG3
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   SEK3                    ,мод.адрес := SEK3
         СЧ     0                       ,СМ := слово по адресу SEK3
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     REGIMA                  ,если СМ≠0 → REGIMA
         ПБ     REGIMB                  ,переход на REGIMB
*
REGIMA   ПБ     SEK3C                   ,переход на SEK3C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
REGIMB   СЧ     0(М7)                   ,СМ := слот кадра 0
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   REGIM                   ,мод.адрес := REGIM
         СЧ     0                       ,СМ := слово по адресу REGIM
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПЕ     SEK2A                   ,если СМ≠0 → SEK2A
         ПБ     SEK2B                   ,переход на SEK2B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK2A    ПБ     SEK3D                   ,переход на SEK3D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK2B    МОДА   SEK2                    ,мод.адрес := SEK2
         СЧ     0                       ,СМ := слово по адресу SEK2
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         МОДА   LYG5                    ,мод.адрес := LYG5
         СЛ     0                       ,СМ += слово по адресу LYG5
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     SEK3B                   ,если СМ=0 → SEK3B
         ПБ     SEK3C                   ,переход на SEK3C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK3B    ПБ     SEK3D                   ,переход на SEK3D
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
SEK3C    МОДА   SEK3                    ,мод.адрес := SEK3
         СЧ     0                       ,СМ := слово по адресу SEK3
         МОДА   LYG3                    ,мод.адрес := LYG3
         ЗП     0                       ,по адресу LYG3 := СМ
         МОДА   SEK2                    ,мод.адрес := SEK2
         СЧ     0                       ,СМ := слово по адресу SEK2
         МОДА   LYG5                    ,мод.адрес := LYG5
         ЗП     0                       ,по адресу LYG5 := СМ
SEK3D    МОДА   LYG4                    ,мод.адрес := LYG4
         СЧ     0                       ,СМ := слово по адресу LYG4
         МОДА   SEK2                    ,мод.адрес := SEK2
         ЗП     0                       ,по адресу SEK2 := СМ
         МОДА   LYG2                    ,мод.адрес := LYG2
         СЧ     0                       ,СМ := слово по адресу LYG2
         МОДА   SEK3                    ,мод.адрес := SEK3
         ЗП     0                       ,по адресу SEK3 := СМ
         ПБ     F0A                     ,переход на F0A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F0A      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'6400000000000001'
	ФИНИШ

