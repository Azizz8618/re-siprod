***************************************************
* LYGPAR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 20960 образа SIPROD.BIN
*   Длина при загрузке: 39 слов, 76 команд
*   Вход: LYGPAR
*   Внешние: *LYG*, *NDAB*, *SEK*, *REGIM*
*   Смещения в *LYG*: 1, 2
*   Смещения в *NDAB*: 1, 2
*   Смещения в *SEK*: 2, 3
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
LYGPAR  СТАРТ  0
        УИА    SEK3(М16)                ,М16 := SEK3
SEK3    ПБ     SEK2                     ,переход на SEK2
        МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
        СЧ     LYGPAR                   ,СМ := LYGPAR
        РЖА    '3'                      ,РЖ := '3'
СИМ12   МОДА   СИМ12                    ,мод.адрес +1: СИМ12
L0006   ВЧ     LYGPAR                   ,СМ -= LYGPAR
        РЖА    '22'                     ,РЖ := '22'
L0010   ПЕ     СИМ12                    ,если СМ≠0 → СИМ12
        ПБ     L0006                    ,переход на L0006
L0012   ПБ     L0032                    ,переход на L0032
СИМ122  МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        МОДА   СИМ12                    ,мод.адрес +1: СИМ12
        СЧ     LYGPAR                   ,СМ := LYGPAR
        СЧИМ                            ,СЧИ + магазин
SEK32   МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
L0020   СЧ     LYGPAR                   ,СМ := LYGPAR
        НТЖ    LYGPAR(М17)              ,СМ ^= LYGPAR(М17)
        ПЕ     L0012                    ,если СМ≠0 → L0012
        ПБ     СИМ122                   ,переход на СИМ122
        ПБ     REGIM                    ,переход на REGIM
L0025   МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
REGIM   СЧ     LYGPAR(М7)               ,СМ := LYGPAR(М7)
        СЧИМ                            ,СЧИ + магазин
        МОДА   *REGIM*                  ,мод.адрес +1: *REGIM*
        СЧ     LYGPAR                   ,СМ := LYGPAR
L0032   НТЖ    LYGPAR(М17)              ,СМ ^= LYGPAR(М17)
        ПЕ     SEK32                    ,если СМ≠0 → SEK32
        ПБ     L0020                    ,переход на L0020
        МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        ПБ     L0032                    ,переход на L0032
SEK2    МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        МОДА   *SEK*+2                  ,мод.адрес +1: *SEK*+2
        СЧ     LYGPAR                   ,СМ := LYGPAR
        РЖА    '3'                      ,РЖ := '3'
        ВЧОБ   LYGPAR                   ,СМ := (адрес) - СМ
СИМ14   МОДА   СИМ14                    ,мод.адрес +1: СИМ14
        СЛ     LYGPAR                   ,СМ += LYGPAR
SEK33   РЖА    '22'                     ,РЖ := '22'
        ПО     L0025                    ,если СМ=0 → L0025
        ПБ     REGIM                    ,переход на REGIM
        МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        ПБ     L0032                    ,переход на L0032
        МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
        СЧ     LYGPAR                   ,СМ := LYGPAR
        МОДА   СИМ12                    ,мод.адрес +1: СИМ12
        ЗП     LYGPAR                   ,LYGPAR := СМ
        МОДА   *SEK*+2                  ,мод.адрес +1: *SEK*+2
        СЧ     LYGPAR                   ,СМ := LYGPAR
        МОДА   СИМ14                    ,мод.адрес +1: СИМ14
        ЗП     LYGPAR                   ,LYGPAR := СМ
        МОДА   СИМ15                    ,мод.адрес +1: СИМ15
        СЧ     LYGPAR                   ,СМ := LYGPAR
        МОДА   *SEK*+2                  ,мод.адрес +1: *SEK*+2
        ЗП     LYGPAR                   ,LYGPAR := СМ
        МОДА   *LYG*+2                  ,мод.адрес +1: *LYG*+2
        СЧ     LYGPAR                   ,СМ := LYGPAR
        МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
        ЗП     LYGPAR                   ,LYGPAR := СМ
        ПБ     СИМ14                    ,переход на СИМ14
        МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    SEK33(М7)                ,М7 := SEK33
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     LYGPAR(М12)              ,переход через М12
        МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     LYGPAR(М10)              ,переход через М10

