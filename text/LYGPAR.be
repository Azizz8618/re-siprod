***************************************************
* LYGPAR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 20960 образа SIPROD.BIN
*   Длина при загрузке: 39 слов, 76 команд
*   Вход: LYGPAR
*   Выход: смещение 106, через М12, смещение 113, через М10
*   Внешние: LYG, NDAB, SEK, REGIM
*   Смещения в LYG: 1, 2
*   Смещения в NDAB: 1, 2
*   Смещения в SEK: 2, 3
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
*
* СИМВОЛЫ МОДУЛЯ (номер - имя):
*   001 LYG
*   002 LYG1
*   003 LYG2
*   004 NDAB
*   005 NDAB1
*   006 NDAB2
*   007 SEK
*   008 REGIM
*   009 SEK3
*   010 LYG3
*   011 SEK2
*   012 LYG5
*   013 LYG4
*
LYGPAR   СТАРТ  0
         УИА    SEK3A(М16)              ,М16 := SEK3A
SEK3A    ПБ     SEK2A                   ,переход на SEK2A
         МОДА   SEK3                    ,мод.адрес +1: SEK3
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
SEK3B    МОДА   LYG3                    ,мод.адрес +1: LYG3
SEK3C    ВЧ     0                       ,СМ -= 0
         РЖА    '22'                    ,РЖ := '22'
         ПЕ     SEK3B                   ,если СМ≠0 → SEK3B
         ПБ     SEK3C                   ,переход на SEK3C
LYG3A    ПБ     REGIMC                  ,переход на REGIMC
LYG3B    МОДА   0                       ,мод.адрес +1: 0
         МОДА   LYG3                    ,мод.адрес +1: LYG3
         СЧ     0                       ,СМ := 0
         СЧИМ                           ,СЧИ + магазин
LYG3C    МОДА   SEK3                    ,мод.адрес +1: SEK3
LYG3D    СЧ     0                       ,СМ := 0
         НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     LYG3A                   ,если СМ≠0 → LYG3A
         ПБ     LYG3B                   ,переход на LYG3B
         ПБ     REGIMB                  ,переход на REGIMB
REGIMA   МОДА   0                       ,мод.адрес +1: 0
REGIMB   СЧ     0(М7)                   ,СМ := 0(М7)
         СЧИМ                           ,СЧИ + магазин
         МОДА   REGIM                   ,мод.адрес +1: REGIM
         СЧ     0                       ,СМ := 0
REGIMC   НТЖ    0(М17)                  ,СМ ^= 0(М17)
         ПЕ     LYG3C                   ,если СМ≠0 → LYG3C
         ПБ     LYG3D                   ,переход на LYG3D
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     REGIMC                  ,переход на REGIMC
SEK2A    МОДА   0                       ,мод.адрес +1: 0
         МОДА   SEK2                    ,мод.адрес +1: SEK2
         СЧ     0                       ,СМ := 0
         РЖА    '3'                     ,РЖ := '3'
         ВЧОБ   0                       ,СМ := (адрес) - СМ
SEK2B    МОДА   LYG5                    ,мод.адрес +1: LYG5
         СЛ     0                       ,СМ += 0
SEK2C    РЖА    '22'                    ,РЖ := '22'
         ПО     REGIMA                  ,если СМ=0 → REGIMA
         ПБ     REGIMB                  ,переход на REGIMB
         МОДА   0                       ,мод.адрес +1: 0
         ПБ     REGIMC                  ,переход на REGIMC
         МОДА   0                       ,мод.адрес +1: 0
         МОДА   SEK3                    ,мод.адрес +1: SEK3
         СЧ     0                       ,СМ := 0
         МОДА   LYG3                    ,мод.адрес +1: LYG3
         ЗП     0                       ,0 := СМ
         МОДА   SEK2                    ,мод.адрес +1: SEK2
         СЧ     0                       ,СМ := 0
         МОДА   LYG5                    ,мод.адрес +1: LYG5
         ЗП     0                       ,0 := СМ
         МОДА   LYG4                    ,мод.адрес +1: LYG4
         СЧ     0                       ,СМ := 0
         МОДА   SEK2                    ,мод.адрес +1: SEK2
         ЗП     0                       ,0 := СМ
         МОДА   LYG2                    ,мод.адрес +1: LYG2
         СЧ     0                       ,СМ := 0
         МОДА   SEK3                    ,мод.адрес +1: SEK3
         ЗП     0                       ,0 := СМ
         ПБ     SEK2B                   ,переход на SEK2B
         МОДА   0                       ,мод.адрес +1: 0
         УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    SEK2C(М7)               ,М7 := SEK2C
         СЧИМ   М15                     ,стек := М15, СМ := М15
         СЧИМ   М10                     ,стек := М10, СМ := М10
         СЧИМ                           ,СЧИ + магазин
         РЖА    '3'                     ,РЖ := '3'
         РЖА    '2'                     ,РЖ := '2'
         ПБ     0(М12)                  ,переход через М12
         МОДА   0                       ,мод.адрес +1: 0
         УИМ                            ,УИ + магазин
         УИМ    М7                      ,М7 := СМ + стек
         УИМ    М10                     ,М10 := СМ + стек
         ПБ     0(М10)                  ,переход через М10

