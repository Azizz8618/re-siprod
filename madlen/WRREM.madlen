CWRREM - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 18368 образа SIPROD.BIN
CДлина при загрузке: 50 слов, 94 команд
CВход: WRREM
CВыход: SEKGIR:SEPF, SEKGIR:F7I, F1A (возврат через М12),
CPOP (возврат через М10)
CВЫВОД ЗАМЕЧАНИЙ (ПРИМЕЧАНИЙ К ТАБЛИЦЕ).
CВнешние: SEK, LYG, SEP, EGO, PILDYK
CСмещения в EGO: 2400, 4800, 7200
CСмещения в LYG: 1, 2
CСмещения в SEK: 3
CСмещения в SEP: 1, 2, 3, 4, 5
CСмещения в кадре (М7): общие 0-2, 10
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес),
CМ17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 WRREM   :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C ОБЛАСТЬ SEK, 4 СЛОВА
 *SEK*   :,LC,4
C ОБЛАСТЬ LYG, 6 СЛОВ
 *LYG*   :,LC,6
C ОБЛАСТЬ SEP, 6 СЛОВ
 *SEP*   :,LC,6
C ОБЛАСТЬ EGO, 13401 СЛОВО
 *EGO*   :,LC,13401
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 PILDYK  :,SUBP,
C КОНСТАНТЫ: СМЕЩЕНИЯ В ОБЩИХ ОБЛАСТЯХ И ДРУГИЕ КОНСТАНТЫ
C КОНСТАНТА, ВЫРАЖЕНИЕ: *EGO*   -32767
 EGO32767:,EQU,*EGO*   -32767
C СМЕЩЕНИЕ 2400 В ОБЛАСТИ EGO
 EGO35167:,EQU,*EGO*+2400-32767
C СМЕЩЕНИЕ 4800 В ОБЛАСТИ EGO
 EGO37567:,EQU,*EGO*+4800-32767
 M16,VTM,LYG2A                          .М16 := адрес LYG2A
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F1A
C
 LYG2A:,UTC,*LYG*+2                     .мод.адрес := LYG2
 ,XTA,                                  .СМ := слово по адресу LYG2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,2                               .слот кадра 2 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SEP*                             .мод.адрес := SEP
 ,XTA,                                  .СМ := слово по адресу SEP
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,SEK3A                             .если СМ=0 → SEK3A
 ,UJ,SEK3B                              .переход на SEK3B
C
 SEK3A:,UTC,*SEK*+3                     .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,2                               .слот кадра 2 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 SEK3B:,WTC,ЗНАЧЕНИЕ_ЗАМЕЧАНИЯ_1        .мод.адрес := код из V0
 ,UJ,SEK3B                              .переход на SEK3B
C
 ,UJ,SEP4A                              .переход на SEP4A
C
  :,UJ,SEP4B                            .переход на SEP4B
C
  :,UJ,SEP4C                            .переход на SEP4C
C
 SEP4A:,WTC,*SEP*+4                     .мод.адрес := код из SEP4
 M1,VTM,                                .М1 := код из SEP4
 M1,UTC,EGO32767                        .мод.адрес := EGO32767(М1)
 M16,VTM,                               .М16 := адрес EGO32767+М1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+1                        .М16 := адрес SEP1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+2                        .М16 := адрес SEP2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+3                        .М16 := адрес SEP3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+5                        .М16 := адрес SEP5
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,PILDYK                         .вызов через М15
 ,UJ,ЦИКЛ_ПЕРЕХОД                       .переход на F1
C
 SEP4B:,WTC,*SEP*+4                     .мод.адрес := код из SEP4
 M1,VTM,                                .М1 := код из SEP4
 M1,UTC,EGO35167                        .мод.адрес := EGO35167(М1)
 M16,VTM,                               .М16 := адрес EGO35167+М1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+1                        .М16 := адрес SEP1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+2                        .М16 := адрес SEP2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+3                        .М16 := адрес SEP3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+5                        .М16 := адрес SEP5
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,PILDYK                         .вызов через М15
 ,UJ,ЦИКЛ_ПЕРЕХОД                       .переход на F1
C
 SEP4C:,WTC,*SEP*+4                     .мод.адрес := код из SEP4
 M1,VTM,                                .М1 := код из SEP4
 M1,UTC,EGO37567                        .мод.адрес := EGO37567(М1)
 M16,VTM,                               .М16 := адрес EGO37567+М1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+1                        .М16 := адрес SEP1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+2                        .М16 := адрес SEP2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+3                        .М16 := адрес SEP3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*SEP*+5                        .М16 := адрес SEP5
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,PILDYK                         .вызов через М15
 ЦИКЛ_ПЕРЕХОД:,UJ,POP                   .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_ЗАМЕЧАНИЯ_1            .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: НОМЕРА СЛОТОВ КАДРА: 1 - ТЕКСТ ЗАМЕЧАНИЯ, 2 - НОМЕР ЛИНЕЙКИ
C ЗНАЧЕНИЕ 1; ИСПОЛЬЗУЕТСЯ В КОДЕ
 ПАРАМЕТР_ЗАМЕЧАНИЯ_1:,INT,1
C ЗНАЧЕНИЕ 2; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 ДВОЙКА:,INT,2
C ПЕРЕМЕННЫЕ: ЯЧЕЙКА ЗНАЧЕНИЯ ЗАМЕЧАНИЯ, ПЕРЕДАВАЕМОГО В МОДУЛЬ SEKGIR
 ЗНАЧЕНИЕ_ЗАМЕЧАНИЯ_1:,BSS,1
 ,END,
