CWRIMAK - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 19584 образа SIPROD.BIN
CДлина при загрузке: 62 слов, 106 команд
CВход: WRIMAK
CВыход: SPAUD:SCAN30, F1E (возврат через М12), F1F (возврат через М10)
CВнешние: MKR, RMK, NRM, VIE, KLAIDA, RNSYMB, IMUI
CСмещения в MKR: 500, 501
CСмещения в VIE: 1
CСмещения в кадре (М7): общие 0-2, 4, 6-8, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 WRIMAK  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C MKR: КАРТА ЗАДАНИЯ: ЭЛЕМЕНТЫ КАТАЛОГА ЗАДАЧИ (502 СЛОВА)
 *MKR*   :,LC,502
C RMK: КАРТА: ОБЩАЯ ТАБЛИЦА (250 СЛОВ)
 *RMK*   :,LC,250
C ОБЛАСТЬ NRM, 1 СЛОВО
 *NRM*   :,LC,1
C VIE: ОБЩАЯ ОБЛАСТЬ ПАМЯТИ (2 СЛОВА)
 *VIE*   :,LC,2
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 KLAIDA  :,SUBP,
 RNSYMB  :,SUBP,
 I*MU*I  :,SUBP,
 M16,VTM,NRMA                           .М16 := адрес NRMA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F1E
C
 NRMA:,UTC,*NRM*                        .мод.адрес := NRM
 ,XTA,                                  .СМ := слово по адресу NRM
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 ,UTC,*MKR*+501                         .мод.адрес := MKR501
 ,A+X,                                  .СМ += слово по адресу MKR501
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F4
 ,UJ,ПЕР_4                              .переход на F4A
C
 ЦИКЛ_ПЕРЕХОД:,UJ,NRMB                  .переход на NRMB
C
 ПЕР_4:M7,XTA,4                         .СМ := слот кадра 4
 M7,ATX,6                               .слот кадра 6 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ADDR                               .переход на ADDR
C
 NRMB:,UTC,*NRM*                        .мод.адрес := NRM
 ,XTA,                                  .СМ := слово по адресу NRM
 M16,VTM,КОД_3                          .М16 := адрес К2
 M15,VJM,I*MU*I                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,7                               .слот кадра 7 := СМ
 M7,A-X,2                               .СМ -= слот кадра 2
 M7,ATX,10B                             .слот кадра 8 := СМ
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*VIE*                             .мод.адрес := VIE
 ,ATX,                                  .по адресу VIE := СМ
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*VIE*+1                           .мод.адрес := VIE1
 ,ATX,                                  .по адресу VIE1 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*NRM*                             .мод.адрес := NRM
 ,XTA,                                  .СМ := слово по адресу NRM
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,ЦИКЛ2_ПЕРЕХОД                     .если СМ≠0 → F1
 ,UJ,ЦИКЛ3_ПЕРЕХОД                      .переход на F1A
C
 ЦИКЛ2_ПЕРЕХОД:,UJ,ВЫЗОВ_RNSYMB         .переход на F1B
C
 ЦИКЛ3_ПЕРЕХОД:,UJ,ВЫЗОВ2_RNSYMB        .переход на F1C
C
 ВЫЗОВ_RNSYMB:M16,VTM,*RMK*             .М16 := адрес RMK
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_МАРК_3                      .М16 := адрес V3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*VIE*                          .М16 := адрес VIE
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_4                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ЗАПИСЬ СИМВОЛА В ТЕКСТ И ПРОДВИГ ПОЗИЦИИ
 ВЫЗОВ2_RNSYMB:M16,VTM,*RMK*            .М16 := адрес RMK
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_МАРК_2                      .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*VIE*+1                        .М16 := адрес VIE1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_4                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*VIE*                             .мод.адрес := VIE
 ,XTA,                                  .СМ := слово по адресу VIE
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*VIE*                             .мод.адрес := VIE
 ,ATX,                                  .по адресу VIE := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ЦИКЛ4_ПЕРЕХОД                      .переход на F1D
C
 ADDR:M16,VTM,ЯЧ_МАРК_1                 .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,KLAIDA                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ЦИКЛ4_ПЕРЕХОД:,UJ,ВОЗВРА2Т_В_БЛОК      .переход на F1F
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРА2Т_В_БЛОК:,STI,                  .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ: НОМЕРА МАКРОСОВ 2 И 5, ГРАНИЦА 92 И КОДЫ СИМВОЛОВ
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 2; ПЕРЕДАЁТСЯ В I*MU*I; ПАРАМЕТР ВЫЗОВА RNSYMB - 2 ССЫЛ.
 КОД_3:,INT,2
C ЗНАЧЕНИЕ 5; ПАРАМЕТР ВЫЗОВА RNSYMB - 2 ССЫЛ.
 КОД_4:,INT,5
C ЗНАЧЕНИЕ 92; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_5:,INT,92
C ЗАРЕЗЕРВИРОВАННАЯ ЯЧЕЙКА, КОДОМ МОДУЛЯ НЕ ИСПОЛЬЗУЕТСЯ
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ ВЫВОДА МАКРО: ЗНАЧЕНИЕ МАКРОСА И БУФЕР ТЕКСТА
 РЕЗЕРВ_ЯЧЕЕК_МОДУЛЯ:,BSS,1
 ЯЧ_МАРК_1:,BSS,1
 ЯЧ_МАРК_2:,BSS,1
 ЯЧ_МАРК_3:,BSS,1
 ,END,
