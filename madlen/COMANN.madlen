CCOMANN - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 11584 образа SIPROD.BIN
CДлина при загрузке: 46 слов, 82 команд
CВход: COMANN
CВыход: SPAUD:SCAN08, F0 (возврат через М12), F0A (возврат через М10)
CВнешние: INS, SCANER, LRE
CСмещения в INS: 24, 25, 26
CСмещения в LRE: 2, 3, 4, 5
CСмещения в SCANER: 1, 2
CСмещения в кадре (М7): общие 0-4, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 COMANN  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M16:,EQU,16B
 M17:,EQU,17B
 *INS*   :,LC,27
 *SCANER*:,LC,3
 *LRE*   :,LC,20
 M16,VTM,SCANEA                         .М16 := адрес SCANEA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F0
C
 SCANEA:M7,XTA,2                        .СМ := слот кадра 2
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,LRE5A                             .если СМ≠0 → LRE5A
 ,UJ,LRE5B                              .переход на LRE5B
C
 LRE5A:,UJ,SCANEB                       .переход на SCANEB
C
C СНЯТИЕ ЛИНЕЙКИ 5 У ЯЧЕЙКИ ТАБЛИЦЫ
 LRE5B:M7,XTA,                          .СМ := слот кадра 0
 ,UTC,*LRE*+5                           .мод.адрес := LRE5
 ,ATX,                                  .по адресу LRE5 := СМ
 ,UJ,SCANEF                             .переход на SCANEF
C
 SCANEB:M7,XTA,1                        .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,LRE3A                             .если СМ≠0 → LRE3A
 ,UJ,LRE3B                              .переход на LRE3B
C
 LRE3A:,UJ,SCANEC                       .переход на SCANEC
C
C СНЯТИЕ ЛИНЕЙКИ 3 У ЯЧЕЙКИ ТАБЛИЦЫ
 LRE3B:M7,XTA,                          .СМ := слот кадра 0
 ,UTC,*LRE*+3                           .мод.адрес := LRE3
 ,ATX,                                  .по адресу LRE3 := СМ
 ,UJ,SCANEF                             .переход на SCANEF
C
 SCANEC:M7,XTA,3                        .СМ := слот кадра 3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,LRE4A                             .если СМ≠0 → LRE4A
 ,UJ,LRE4B                              .переход на LRE4B
C
 LRE4A:,UJ,SCANED                       .переход на SCANED
C
C СНЯТИЕ ЛИНЕЙКИ 4 У ЯЧЕЙКИ ТАБЛИЦЫ
 LRE4B:M7,XTA,                          .СМ := слот кадра 0
 ,UTC,*LRE*+4                           .мод.адрес := LRE4
 ,ATX,                                  .по адресу LRE4 := СМ
 ,UJ,SCANEF                             .переход на SCANEF
C
 SCANED:M7,XTA,4                        .СМ := слот кадра 4
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,LRE2A                             .если СМ≠0 → LRE2A
 ,UJ,LRE2B                              .переход на LRE2B
C
 LRE2A:,UJ,SCANEE                       .переход на SCANEE
C
C СНЯТИЕ ЛИНЕЙКИ 2 У ЯЧЕЙКИ ТАБЛИЦЫ
 LRE2B:M7,XTA,                          .СМ := слот кадра 0
 ,UTC,*LRE*+2                           .мод.адрес := LRE2
 ,ATX,                                  .по адресу LRE2 := СМ
 ,UJ,SCANEF                             .переход на SCANEF
C
 SCANEE:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,                                .СМ -= слот кадра 0
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 SCANEF:,UJ,ВОЗВРАТ_В_БЛОК              .переход на F0A
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: КОДЫ БУКВ КОМАНД СНЯТИЯ ЛИНЕЕК ЯЧЕЙКИ ТАБЛИЦЫ И ЗНАЧЕНИЕ МАСКИ
 КОД_1:,INT,1
 КОД_2:,INT,11
 КОД_3:,INT,16
 КОД_4:,INT,21
 КОД_5:,INT,23
 ,END,
