 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ПЕРЕХОД_К_ЗАВЕРШЕНИЮ              .если СМ=0 → F0
 ,UJ,ЗАПИСЬ_ЧИСЛА_В_ФАЙЛ                .переход на F0A
C
 ПЕРЕХОД_К_ЗАВЕРШЕНИЮ:,UJ,ПЕРЕХОД_К_ВОЗВРАТУ.переход на F0B
C
 ЗАПИСЬ_ЧИСЛА_В_ФАЙЛ:M16,VTM,ПЕРВОЕ_ПОЛЕ.М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ВТОРОЕ_ПОЛЕ+2                  .М16 := адрес К6
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ПОСЛЕДНЕЕ_ПОЛЕ                 .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
