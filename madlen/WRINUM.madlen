CWRINUM - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6752 образа SIPROD.BIN
CДлина при загрузке: 81 слов, 136 команд
CВход: WRINUM
CВыход: ONEPLA:L0320, TWOPLA:NUM3E, F0C (возврат через М12),
CPOP (возврат через М10)
CВнешние: NUM, KOMA, ONE, WHO, HOWSMB, RASPS, WRIKOR
CСмещения в KOMA: 2, 7
CСмещения в NUM: 2, 3
CСмещения в ONE: 1, 2
CСмещения в WHO: 1
CСмещения в кадре (М7): общие 0-3, 6, 8-10, свои 11
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 WRINUM  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *NUM*   :,LC,4
 *KOMA*  :,LC,8
 *ONE*   :,LC,3
 *WHO*   :,LC,2
 HOWSMB  :,SUBP,
 RASPS   :,SUBP,
 WRIKOR  :,SUBP,
 M16,VTM,NUM2A                          .М16 := адрес NUM2A
 ,UJ,ЗАВЕРШЕНИЕ_МОДУЛЯ                  .переход на F0C
C
C ЧТЕНИЕ НОМЕРА ИЗ БЛОКА NUM И ПРОВЕРКА ФЛАГА
 NUM2A:,UTC,*NUM*+2                     .мод.адрес := NUM2
 ,XTA,                                  .СМ := слово по адресу NUM2
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,WTC,УКАЗАТЕЛЬ_КОНТЕКСТА               .мод.адрес := код из V3
 ,XTA,                                  .СМ := слово по адресу V3
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,NUM2B                             .если СМ≠0 → NUM2B
 ,UJ,NUM2C                              .переход на NUM2C
C
 NUM2B:,UTC,*NUM*+2                     .мод.адрес := NUM2
 ,XTA,                                  .СМ := слово по адресу NUM2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,2                               .СМ += слот кадра 2
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 NUM2C:,UTC,*ONE*+1                     .мод.адрес := ONE1
 ,XTA,                                  .СМ := слово по адресу ONE1
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
