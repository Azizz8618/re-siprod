 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,УКАЗАТЕЛЬ_КОНТЕКСТА               .мод.адрес := код из V3
 M16,VTM,                               .М16 := код из V3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ПОСЛЕДНЕЕ_ПОЛЕ                 .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ПЕРЕХОД_К_ВОЗВРАТУ:,UJ,POP             .переход на POP
C
C ВОЗВРАТ В ОС
 ЗАВЕРШЕНИЕ_МОДУЛЯ:M7,MTJ,8             .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_ЗАВЕРШЕНИЯ                  .М7 := адрес К1
 M7,STX,13B                             .ЗП + магазин: 11(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
 ПЕРВОЕ_ПОЛЕ:,ISO, 6H*2/*G.. . 052 062 057 052 107 056
 КОД_ЗАВЕРШЕНИЯ:,INT,0
 ПОСЛЕДНЕЕ_ПОЛЕ:,INT,1
 ПОСЛЕДНЕЕ_ПОЛЕ+2:,INT,2
 ТРОЙКА:,INT,3
 ВТОРОЕ_ПОЛЕ:,INT,5
 ВТОРОЕ_ПОЛЕ+2:,INT,6
 ДВЕНАДЦАТЬ:,INT,12
 РАЗДЕЛИТЕЛЬ:,INT,16
 V0:,BSS,1
 ПЕРВОЕ_ЗНАЧЕНИЕ:,BSS,1
 ВТОРОЕ_ЗНАЧЕНИЕ:,BSS,1
