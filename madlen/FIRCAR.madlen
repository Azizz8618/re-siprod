 ВОССТА2НОВЛЕНИЕ_КАДРА:,STI,            .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: МАСКА ИЗ ШЕСТИ ПРОБЕЛОВ - ОБРАЗЕЦ ПУСТОЙ СТРОКИ ПРИ СРАВНЕНИИ
 МАСКА_ПРОБЕЛОВ:,ISO,6H       .. 040 040 040 040 040 040
C РЕЖИМЫ: ОБРАЗЕЦ КЛЮЧЕВОГО СЛОВА ST ДЛЯ СРАВНЕНИЯ С НАЧАЛОМ КАРТЫ
 МАСКА_ST:,ISO,6HST     .. 123 124 040 040 040 040
C ЧИСЛА: КОДЫ СИМВОЛОВ И НОМЕРА ЭЛЕМЕНТОВ КАТАЛОГА ЗАДАЧИ 19 И 20
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; ПАРАМЕТР ВЫЗОВА RNSYMB - 3 ССЫЛ.
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 2; ПАРАМЕТР ВЫЗОВА RNSYMB - 2 ССЫЛ.
 КОД_3:,INT,2
C ЗНАЧЕНИЕ 3; ПАРАМЕТР ВЫЗОВА RNSYMB
 КОД_4:,INT,3
C ЗНАЧЕНИЕ 7; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_5:,INT,7
C ЗНАЧЕНИЕ 8; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_6:,INT,8
C ЗНАЧЕНИЕ 10; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_7:,INT,10
C ЗНАЧЕНИЕ 12; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_8:,INT,12
C ЗНАЧЕНИЕ 19; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_9:,INT,19
C ЯЧЕЙКИ РАЗБОРА СИМВОЛОВ ЗАГОЛОВКА ПЕРВОЙ КАРТЫ
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ РАЗБОРА СИМВОЛОВ ЗАГОЛОВКА И БУФЕР ВХОДНОЙ СТРОКИ
 ЯЧЕЙКИ_РАЗБОРА_ЗАГОЛОВКА:,BSS,4
 ПОЛЕ2_СКАНЕРА_2:,BSS,2
 ПОЛЕ3_СКАНЕРА_3:,BSS,1
 РЕЗЕРВ_ПЕРЕМЕННАЯ:,BSS,3
 ВХОДНАЯ_СТРОКА:,BSS,14
C ОБЛАСТЬ КАДРА: КОНСТАНТЫ, ЗАДАВАЕМЫЕ В ЯЧЕЙКИ КАДРА, И КОМАНДЫ РАЗБОРА
 ,DATA,
 ПЕРВОЕ_ЗНАЧЕНИЕ:,ISO, 6HRG     .. 122 107 040 040 040 040
 МАСКА_RU:,ISO,6HRU     .. 122 125 040 040 040 040
 ПОЛЕ_СКАНЕРА_1:,ISO, 6HMCP    .. 115 103 120 040 040 040
 M3,SET,ПЕРВОЕ_ЗНАЧЕНИЕ
 M1,   ,РЕЗЕРВ_ПЕРЕМЕННАЯ
 ,END,
