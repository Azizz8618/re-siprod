CBEGTUR - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 19968 образа SIPROD.BIN
CДлина при загрузке: 81 слов, 132 команд
CВход: BEGTUR
CВыход: WRITUR:FOR1A, F6 (возврат через М12), POP (возврат через М10)
CВнешние: JAU, EGO, FOR, STR, PAGE, REGIM, RNSYMB, BEGPUS, IDII, IMUI
CСмещения в EGO: 8601
CСмещения в FOR: 1, 2, 3, 4, 5, 6, 7
CСмещения в JAU: 1
CСмещения в PAGE: 3, 4, 5
CСмещения в STR: 24, 25, 26
CСмещения в кадре (М7): общие 0-4, 6-7, 9-10, свои 11-12
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес),
CМ17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 BEGTUR  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M2:,EQU,2B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *JAU*   :,LC,2
 *EGO*   :,LC,13401
 *FOR*   :,LC,8
 *STR*   :,LC,27
 *PAGE*  :,LC,6
 *REGIM* :,LC,16
 RNSYMB  :,SUBP,
 BEGPUS  :,SUBP,
 I*DI*I  :,SUBP,
 I*MU*I  :,SUBP,
 EGO41368:,EQU,*EGO*+8601-32767
 M16,VTM,FORA                           .М16 := адрес FORA
 ,UJ,ЗАВЕРШЕНИЕ_МОДУЛЯ                  .переход на F6
C
C РАСЧЁТ ПОЗИЦИЙ ЭЛЕМЕНТОВ СТРАНИЦЫ И НАЧАЛО ВЫВОДА
 FORA:M7,XTA,                           .СМ := слот кадра 0
 ,UTC,*FOR*                             .мод.адрес := FOR
 ,ATX,                                  .по адресу FOR := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*STR*+25                          .мод.адрес := STR25
 ,XTA,                                  .СМ := слово по адресу STR25
 ,UTC,*FOR*+2                           .мод.адрес := FOR2
 ,ATX,                                  .по адресу FOR2 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,FOR2A                             .если СМ≠0 → FOR2A
 ,UJ,FOR2B                              .переход на FOR2B
C
 FOR2A:,UJ,FOR2D                        .переход на FOR2D
C
 FOR2B:,UTC,*FOR*+2                     .мод.адрес := FOR2
 ,XTA,                                  .СМ := слово по адресу FOR2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,12B                             .СМ -= слот кадра 10
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,FOR2C                             .если СМ≠0 → FOR2C
 ,UJ,FOR2D                              .переход на FOR2D
C
 FOR2C:,UTC,*FOR*+2                     .мод.адрес := FOR2
 ,XTA,                                  .СМ := слово по адресу FOR2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,11B                             .СМ += слот кадра 9
 ,UTC,*FOR*+2                           .мод.адрес := FOR2
 ,ATX,                                  .по адресу FOR2 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 FOR2D:,UTC,*PAGE*+3                    .мод.адрес := PAGE3
 ,XTA,                                  .СМ := слово по адресу PAGE3
 ,UTC,*FOR*+3                           .мод.адрес := FOR3
 ,ATX,                                  .по адресу FOR3 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*PAGE*+3                          .мод.адрес := PAGE3
 ,XTA,                                  .СМ := слово по адресу PAGE3
 ,UTC,*PAGE*+4                          .мод.адрес := PAGE4
 ,A+X,                                  .СМ += слово по адресу PAGE4
 ,UTC,*FOR*+4                           .мод.адрес := FOR4
 ,ATX,                                  .по адресу FOR4 := СМ
 ,UTC,*STR*+26                          .мод.адрес := STR26
 ,XTA,                                  .СМ := слово по адресу STR26
 ,UTC,*STR*+25                          .мод.адрес := STR25
 ,A-X,                                  .СМ -= слово по адресу STR25
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*FOR*+5                           .мод.адрес := FOR5
 ,ATX,                                  .по адресу FOR5 := СМ
 ,UTC,*STR*+26                          .мод.адрес := STR26
 ,XTA,                                  .СМ := слово по адресу STR26
 M7,A-X,4                               .СМ -= слот кадра 4
 ,UTC,*FOR*+6                           .мод.адрес := FOR6
 ,ATX,                                  .по адресу FOR6 := СМ
 ,UTC,*PAGE*+5                          .мод.адрес := PAGE5
 ,XTA,                                  .СМ := слово по адресу PAGE5
 ,UTC,*FOR*+7                           .мод.адрес := FOR7
 ,ATX,                                  .по адресу FOR7 := СМ
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 ,UTC,*JAU*+1                           .мод.адрес := JAU1
 ,ATX,                                  .по адресу JAU1 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,BEGPUS                         .вызов через М15
 ,UTC,*FOR*+5                           .мод.адрес := FOR5
 ,XTA,                                  .СМ := слово по адресу FOR5
 M16,VTM,КОД_3                          .М16 := адрес К2
 M15,VJM,I*DI*I                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,3                               .СМ -= слот кадра 3
 M7,ATX,13B                             .слот кадра 11 := СМ
 ,UTC,*FOR*+2                           .мод.адрес := FOR2
 ,A+X,                                  .СМ += слово по адресу FOR2
 M7,ATX,13B                             .слот кадра 11 := СМ
 ,UTC,*FOR*+1                           .мод.адрес := FOR1
 ,XTA,                                  .СМ := слово по адресу FOR1
 M16,VTM,КОД_9                          .М16 := адрес К8
 M15,VJM,I*MU*I                         .вызов через М15
 M7,A-X,7                               .СМ -= слот кадра 7
 M7,ATX,14B                             .слот кадра 12 := СМ
 M16,VTM,ПЕРВОЕ_ЗНАЧЕНИЕ                .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_2                          .М16 := адрес К1
 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,ИНДЕКС_ТАБЛИЦЫ                    .мод.адрес := код из V1
 M1,VTM,                                .М1 := код из V1
 M1,UTC,EGO41368                        .мод.адрес := EGO41368(М1)
 M16,VTM,                               .М16 := адрес EGO41368+М1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,СРЕДНЕЕ_ЗНАЧЕНИЕ               .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_6                          .М16 := адрес К5
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*FOR*+1                           .мод.адрес := FOR1
 ,XTA,                                  .СМ := слово по адресу FOR1
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,2                               .СМ += слот кадра 2
 ,UTC,*FOR*+1                           .мод.адрес := FOR1
 ,ATX,                                  .по адресу FOR1 := СМ
 M7,XTA,6                               .СМ := слот кадра 6
 ,UTC,*JAU*                             .мод.адрес := JAU
 ,ATX,                                  .по адресу JAU := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ЗАВЕРШЕНИЕ_МОДУЛЯ:M7,MTJ,8             .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛА ПОЗИЦИЙ И СЧЁТЧИКОВ ТУРА ВЫВОДА СТРАНИЦЫ: 1, 2, 4, 7, 22, 64, 70
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 2; ПЕРЕДАЁТСЯ В I*DI*I
 КОД_3:,INT,2
C ЗНАЧЕНИЕ 3; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_4:,INT,3
C ЗНАЧЕНИЕ 4; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_5:,INT,4
C ЗНАЧЕНИЕ 7; ПАРАМЕТР ВЫЗОВА RNSYMB
 КОД_6:,INT,7
C ЗНАЧЕНИЕ 10; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_7:,INT,10
C ЗНАЧЕНИЕ 21; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_8:,INT,21
C ЗНАЧЕНИЕ 22; ПЕРЕДАЁТСЯ В I*MU*I
 КОД_9:,INT,22
C ЗНАЧЕНИЕ 64; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_10:,INT,64
C ЗНАЧЕНИЕ 70; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_11:,INT,70
C БУФЕР СИМВОЛА И КОД ЕГО ПРИЗНАКА
C ПЕРЕМЕННЫЕ: БУФЕР СИМВОЛА С КОДОМ ПРИЗНАКА И БУФЕР РАЗБОРА СИМВОЛА
 БУФЕР_И_КОД_СИМВОЛА:,BSS,2
 ПЕРВОЕ_ЗНАЧЕНИЕ:,BSS,2
C ОБЛАСТЬ КАДРА: КОНСТАНТЫ, ЗАДАВАЕМЫЕ В ЯЧЕЙКИ КАДРА, И КОМАНДЫ РАЗБОРА
 ,DATA,
C РЕЖИМЫ: ИМЕНА МОДУЛЕЙ-ГЕНЕРАТОРОВ РЕЖИМОВ
 СРЕДНЕЕ_ЗНАЧЕНИЕ:,ISO, 6HTURINY ... 124 125 122 111 116 131
 ИНДЕКС_ТАБЛИЦЫ:,ISO, 6HS      ... 123 040 040 040 040 040
 M2,SET,СРЕДНЕЕ_ЗНАЧЕНИЕ
 M1,   ,ПЕРВОЕ_ЗНАЧЕНИЕ
 ,END,
