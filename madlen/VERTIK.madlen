CVERTIK - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6944 образа SIPROD.BIN
CДлина при загрузке: 72 слов, 112 команд
CВход: VERTIK
CВыход: WRIVER:F1A, F15 (возврат через М12), POP (возврат через М10)
CВнешние: VER, RNSYMB, IDII, IMUI
CСмещения в VER: 4
CСмещения в кадре (М7): общие 0-2, 4-10, свои 11-15
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 VERTIK  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *VER*   :,LC,5
 RNSYMB  :,SUBP,
 I*DI*I  :,SUBP,
 I*MU*I  :,SUBP,
 M16,VTM,РАСЧЕТ_ДЛИНЫ_ВЕРТИКАЛИ         .М16 := адрес F5
 ,UJ,ЗАВЕРШЕНИЕ_МОДУЛЯ                  .переход на F15
C
 РАСЧЕТ_ДЛИНЫ_ВЕРТИКАЛИ:,WTC,УКАЗАТЕЛЬ_ПРОВЕРКИ.мод.адрес := код из V10
 ,XTA,                                  .СМ := слово по адресу V10
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,WTC,УКАЗАТЕЛЬ_ЭТАЛОНА                 .мод.адрес := код из V11
 ,A-X,                                  .СМ -= слово по адресу V11
 M7,ATX,5                               .слот кадра 5 := СМ
 ,WTC,УКАЗАТЕЛЬ_ЭТАЛОНА                 .мод.адрес := код из V11
 ,XTA,                                  .СМ := слово по адресу V11
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,4                               .слот кадра 4 := СМ
 M7,XTA,5                               .СМ := слот кадра 5
 M16,VTM,ПАРАМЕТР_ВЫЗОВА                .М16 := адрес V0
 M15,VJM,I*DI*I                         .вызов через М15
 M7,ATX,6                               .слот кадра 6 := СМ
 ,WTC,УКАЗАТЕЛЬ_ЭТАЛОНА                 .мод.адрес := код из V11
 ,XTA,                                  .СМ := слово по адресу V11
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,4                               .слот кадра 4 := СМ
 M7,XTA,6                               .СМ := слот кадра 6
 ,X-A,                                  .СМ := (адрес) - СМ
 M16,VTM,ПАРАМЕТР_ВЫЗОВА                .М16 := адрес V0
 M15,VJM,I*MU*I                         .вызов через М15
 M7,A+X,5                               .СМ += слот кадра 5
 M7,ATX,7                               .слот кадра 7 := СМ
 ,WTC,УКАЗАТЕЛЬ_ЭТАЛОНА                 .мод.адрес := код из V11
 ,XTA,                                  .СМ := слово по адресу V11
 M7,A-X,7                               .СМ -= слот кадра 7
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,WTC,УКАЗАТЕЛЬ_ЧТЕНИЯ                  .мод.адрес := код из V9
 ,XTA,                                  .СМ := слово по адресу V9
 M7,ATX,11B                             .слот кадра 9 := СМ
 M7,XTA,                                .СМ := слот кадра 0
 M7,ATX,12B                             .слот кадра 10 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 M7,ATX,13B                             .слот кадра 11 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ПРОВЕРКА_КОНЦА_ВЕРТИКАЛИ           .переход на F1B
C
C ВЫВОД ВЕРТИКАЛЬНОЙ ЛИНИИ СХЕМЫ ЧЕРЕЗ RNSYMB
 VER4A:,UTC,*VER*+4                     .мод.адрес := VER4
 ,XTA,                                  .СМ := слово по адресу VER4
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*VER*+4                           .мод.адрес := VER4
 ,ATX,                                  .по адресу VER4 := СМ
 M7,XTA,2                               .СМ := слот кадра 2
 M16,VTM,*VER*+4                        .М16 := адрес VER4
 M15,VJM,I*MU*I                         .вызов через М15
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,14B                             .слот кадра 12 := СМ
 M16,VTM,ПЕРВОЕ_ЗНАЧЕНИЕ                .М16 := адрес V5
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_4                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*VER*                          .М16 := адрес VER
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ВТОРОЕ_ЗНАЧЕНИЕ                .М16 := адрес V8
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,10B                             .СМ := слот кадра 8
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,13B                             .СМ := слот кадра 11
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,СБРОС_СЧЁТЧИКА_СТРОК              .если СМ=0 → F1
 ,UJ,СДВИГ_ПОЗИЦИИ_ВЕРТИКАЛИ            .переход на F1A
C
 СБРОС_СЧЁТЧИКА_СТРОК:M7,XTA,1          .СМ := слот кадра 1
 M7,ATX,12B                             .слот кадра 10 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 СДВИГ_ПОЗИЦИИ_ВЕРТИКАЛИ:M7,XTA,11B     .СМ := слот кадра 9
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,6                               .СМ += слот кадра 6
 M7,A+X,12B                             .СМ += слот кадра 10
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,11B                             .слот кадра 9 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
  :7,XTA,13B                            .СМ := слот кадра 11
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,13B                             .слот кадра 11 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ПРОВЕРКА ЧИСЛА НАРИСОВАННЫХ ВЕРТИКАЛЬНЫХ ЛИНИЙ
 ПРОВЕРКА_КОНЦА_ВЕРТИКАЛИ:,WTC,УКАЗАТЕЛЬ_ЭТАЛОНА.мод.адрес := код из V11
 ,X-A,                                  .СМ := слово по адресу V11 - СМ
 ,UZA,VER4A                             .если СМ=0 → VER4A
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ЗАВЕРШЕНИЕ_МОДУЛЯ:M7,MTJ,8             .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К0
 M7,STX,17B                             .ЗП + магазин: 15(М7)
 M7,STX,16B                             .ЗП + магазин: 14(М7)
 M7,STX,15B                             .ЗП + магазин: 13(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ: ЧИСЛО ЗНАКОВ ВЕРТИКАЛИ 5 И ЕЁ ПОЗИЦИЯ 2
 КОД_1:,INT,0
 КОД_2:,INT,1
 КОД_3:,INT,2
 КОД_4:,INT,5
C ПЕРЕМЕННЫЕ: ПАРАМЕТРЫ ВЫЗОВА ВЕРТИКАЛИ: ЗНАЧЕНИЯ СИМВОЛА И УКАЗАТЕЛИ ЧТЕНИЯ, ПРОВЕРКИ
 ПАРАМЕТР_ВЫЗОВА:,BSS,5
 ПЕРВОЕ_ЗНАЧЕНИЕ:,BSS,3
 ВТОРОЕ_ЗНАЧЕНИЕ:,BSS,1
 УКАЗАТЕЛЬ_ЧТЕНИЯ:,BSS,1
 УКАЗАТЕЛЬ_ПРОВЕРКИ:,BSS,1
 УКАЗАТЕЛЬ_ЭТАЛОНА:,BSS,1
 ,END,
