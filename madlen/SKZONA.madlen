CSKZONA - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 5120 образа SIPROD.BIN
CДлина при загрузке: 27 слов, 52 команд
CВход: SKZONA
CВыход: SKZOND (возврат через М15)
CАбсолютные символы: A31745 = 31745, A4096 = 4096
CРегистры: М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС),
CМ13 (счётчик), М15 (адрес возврата)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 SKZONA  :,NAME, NEW DTRAN
C ВХОДЫ МОДУЛЯ: в исходном объекте - ссылки на СК
C (таблица символов: СК+1024, СК+1024+16, СК+2)
 SKZONA1024:,EQU,SKZONA+1024           .вход: СК+1024
 SKZONA1040:,EQU,SKZONA+1040           .вход: СК+1040
 SKZONA2  :,EQU,SKZONA+2               .вход: СК+2
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M11:,EQU,11B
 M12:,EQU,12B
 M13:,EQU,13B
 M15:,EQU,15B
 ,STI,9                                 .М11 := СМ; СМ := из магазина
 ,STI,11                                .М13 := СМ; СМ := из магазина
 ,UTC,ЗНАЧЕНИЕ_1                        .мод.адрес := V0
 ,STX,                                  .по адресу V0 := СМ (в магазин)
 M12,VTM,                               .М12 := база модуля
 SKZONB:M13,XTA,                        .СМ := смещение в буфере 0
 ,ATI,11                                .М13 := СМ
 ,ITA,11                                .СМ := М13
 M12,UTC,GETA                           .мод.адрес := GETA(М12)
 ,AEX,                                  .СМ ^= слово по адресу GETA+М12
 ,UTC,GET                               .мод.адрес := GET
 ,ATX,                                  .по адресу GET := СМ
 M11,XTA,                               .СМ := смещение в буфере 0
 ,ASN,64-12
 ,UTC,GET                               .мод.адрес := GET
 ,AEX,                                  .СМ ^= слово по адресу GET
 ,UTC,GET                               .мод.адрес := GET
 ,CTX,
  :,UTC,GET
 ,*70,
 M12,V1M,SKZOND
 M13,VTM,76001B
 SKZONC:,UTC,SKZONA1024
 M13,XTA,1777B
