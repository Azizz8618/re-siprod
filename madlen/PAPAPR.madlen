CPAPAPR - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 9504 образа SIPROD.BIN
CДлина при загрузке: 34 слов, 54 команд
CВход: PAPAPR
CВыход: F5 (возврат через М12), POP (возврат через М10)
CГЕНЕРАТОР РЕЖИМА *SUB: ПАСПОРТ ПОДПРОГРАММЫ,
CРАЗДЕЛЫ 1-10, ШАПКИ ЧЕРЕЗ RMAKR.
CВнешние: COMCON, EGO, INS, NUST, RUSIS, PAPRAP, RMAKR, IMUI
CСмещения в COMCON: 19, 20
CСмещения в EGO: 7200, 8600, 8601
CСмещения в INS: 24, 25, 26
CАбсолютные символы: N1 = -1
CСмещения в кадре (М7): общие 0-1, 3-5, 10, вне кадра 2064
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 PAPAPR  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M14:,EQU,14B
 M15:,EQU,15B
 M16:,EQU,16B
 *COMCON*:,LC,21
 *EGO*   :,LC,13401
 *INS*   :,LC,27
 *NUST*  :,LC,10
 *RUSIS* :,LC,1
 PAPRAP  :,SUBP,
 RMAKR   :,SUBP,
 I*MU*I  :,SUBP,
 EGO39967:,EQU,*EGO*+7200-32767
 M16,VTM,EGO860                         .М16 := адрес EGO860
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F5
C
C РАСЧЕТ ПОЗИЦИЙ ПАСПОРТА И ВЫЗОВ ФОРМИРОВАНИЯ ШАПКИ
 EGO860:,UTC,*EGO*+8600                 .мод.адрес := EGO8600
 ,XTA,                                  .СМ := слово по адресу EGO8600
 M16,VTM,*COMCON*+20                    .М16 := адрес COMCON20
 M15,VJM,I*MU*I                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,4                               .слот кадра 4 := СМ
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,EGO39A                             .переход на EGO39A
C
 EGO399:M7,XTA,-1                       .СМ := каталог задачи: таблица страниц
 ,WTC,МЕТКА+1                           .мод.адрес := код из V1
 M1,VTM,                                .М1 := код из V1
 M1,UTC,EGO39967                        .мод.адрес := EGO39967(М1)
 ,ATX,                                  .по адресу EGO39967+М1 := СМ
  :7,XTA,5                              .СМ := слот кадра 5
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 EGO39A:M7,X-A,3                        .СМ := (адрес) - СМ
 ,UZA,EGO399                            .если СМ=0 → EGO399
 M16,VTM,СЧЁТ_18                        .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RMAKR                          .вызов через М15
 M16,VTM,СТРУК_РАЗД                     .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RMAKR                          .вызов через М15
 M15,VJM,PAPRAP                         .вызов через М15
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,СЧЁТ_1                          .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
  МАСКА_ПРОБЕЛОВ:,ISO,6H       ... 040 040 040 040 040 040
 СЧЁТ_1:,INT,1
 СЧЁТ_18:,INT,18
 СТРУК_РАЗД:,INT,19
 ТЫСЯЧА_ЧЕТЫРЕСТА:,INT,1400
 ОБЛАСТЬ_МОДУЛЯ:,BSS,2
 ,DATA,
 МЕТКА:,ISO, 6H0=     .. 060 075 040 040 040 040
 МЕТКА+1:,ISO, 6H1=     .. 061 075 040 040 040 040
 МАСКА_2:,ISO,6H2=     ... 062 075 040 040 040 040
 МАСКА_3:,ISO,6H3=     ... 063 075 040 040 040 040
 МАСКА_4:,ISO,6H4=     ... 064 075 040 040 040 040
 МАСКА_5:,ISO,6H5=     ... 065 075 040 040 040 040
 МАСКА_6:,ISO,6H6=     ... 066 075 040 040 040 040
 МАСКА_7:,ISO,6H7=     ... 067 075 040 040 040 040
 МАСКА_8:,ISO,6H8=     ... 070 075 040 040 040 040
 МАСКА_9:,ISO,6H9=     ... 071 075 040 040 040 040
 МАСКА_10:,ISO,6H10=    ... 061 060 075 040 040 040
 МАСКА_11:,ISO,6H11=    ... 061 061 075 040 040 040
 МЕТКА_УКАЗ:,ISO, 6H$$     ... 044 044 040 040 040 040
 СЧЁТ_14:,INT,14
 M14,SET,МЕТКА
 M1,   ,*COMCON*
 M1,SET,МЕТКА_УКАЗ
 M1,   ,*COMCON*+19
 M1,SET,СЧЁТ_14
 M1,   ,*COMCON*+20
 ,END,
