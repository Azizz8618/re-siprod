CLYGPAR - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 20960 образа SIPROD.BIN
CДлина при загрузке: 39 слов, 76 команд
CВход: LYGPAR
CВыход: RASTXT:NDAB1E, SEGTAB:TAB3A, F0 (возврат через М12),
CF0A (возврат через М10)
CВнешние: LYG, NDAB, SEK, REGIM
CСмещения в LYG: 1, 2
CСмещения в NDAB: 1, 2
CСмещения в SEK: 2, 3
CСмещения в кадре (М7): общие 0, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 LYGPAR  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M16:,EQU,16B
 M17:,EQU,17B
 *LYG*   :,LC,6
 *NDAB*  :,LC,4
 *SEK*   :,LC,4
 *REGIM* :,LC,16
 M16,VTM,SEK3A                          .М16 := адрес SEK3A
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F0
C
C СРАВНЕНИЕ НОМЕРА СЕКТОРА И ЛИНЕЙКИ (SEK3 И LYG3)
 SEK3A:,UTC,*SEK*+3                     .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,LYG2+1                            .мод.адрес := LYG3
 ,A-X,                                  .СМ -= слово по адресу LYG3
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,LYG3A                             .если СМ≠0 → LYG3A
 ,UJ,LYG3B                              .переход на LYG3B
C
 LYG3A:,UJ,SEK3D                        .переход на SEK3D
C
C УСТАНОВКА НАЧАЛА И КОНЦА ЛИНЕЙКИ ПО СЕКТОРУ
 LYG3B:,UTC,LYG2+1                      .мод.адрес := LYG3
 ,XTA,                                  .СМ := слово по адресу LYG3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SEK*+3                           .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,REGIMA                            .если СМ≠0 → REGIMA
 ,UJ,REGIMB                             .переход на REGIMB
C
 REGIMA:,UJ,SEK3C                       .переход на SEK3C
C
 REGIMB:M7,XTA,                         .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,SEK2A                             .если СМ≠0 → SEK2A
 ,UJ,SEK2B                              .переход на SEK2B
C
 SEK2A:,UJ,SEK3D                        .переход на SEK3D
C
 SEK2B:,UTC,*SEK*+2                     .мод.адрес := SEK2
 ,XTA,                                  .СМ := слово по адресу SEK2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 ,UTC,LYG2+3                            .мод.адрес := LYG5
 ,A+X,                                  .СМ += слово по адресу LYG5
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,SEK3B                             .если СМ=0 → SEK3B
 ,UJ,SEK3C                              .переход на SEK3C
C
 SEK3B:,UJ,SEK3D                        .переход на SEK3D
C
 SEK3C:,UTC,*SEK*+3                     .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 ,UTC,LYG2+1                            .мод.адрес := LYG3
 ,ATX,                                  .по адресу LYG3 := СМ
 ,UTC,*SEK*+2                           .мод.адрес := SEK2
 ,XTA,                                  .СМ := слово по адресу SEK2
 ,UTC,LYG2+3                            .мод.адрес := LYG5
 ,ATX,                                  .по адресу LYG5 := СМ
 SEK3D:,UTC,LYG2+2                      .мод.адрес := LYG4
 ,XTA,                                  .СМ := слово по адресу LYG4
 ,UTC,*SEK*+2                           .мод.адрес := SEK2
 ,ATX,                                  .по адресу SEK2 := СМ
 ,UTC,*LYG*+2                           .мод.адрес := LYG2
 ,XTA,                                  .СМ := слово по адресу LYG2
 ,UTC,*SEK*+3                           .мод.адрес := SEK3
 ,ATX,                                  .по адресу SEK3 := СМ
 ,UJ,ВОЗВРАТ_В_БЛОК                     .переход на F0A
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР+1                      .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
 ПАРАМЕТР+1:,INT,1
 ,END,
