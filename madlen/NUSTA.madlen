 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,23B                             .СМ := слот кадра 19
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,23B                             .слот кадра 19 := СМ
 M7,X-A,17B                             .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ВЫВОД_СТРОКИ_ТЕКСТА               .если СМ=0 → F1
 ,UTC,*NDAB*+1                          .мод.адрес := NDAB1
 ,XTA,                                  .СМ := слово по адресу NDAB1
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,NDAB1A                            .если СМ≠0 → NDAB1A
 ,UJ,BEGPGA                             .переход на BEGPGA
C
 NDAB1A:M7,XTA,                         .СМ := слот кадра 0
 ,UTC,*NDAB*+1                          .мод.адрес := NDAB1
 ,ATX,                                  .по адресу NDAB1 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 BEGPGA:M15,VJM,BEGPG                   .вызов через М15
 ПЕРЕХОД_К_ВОЗВРАТУ:,UJ,ВОССТАНОВЛЕНИЕ_КАДРА.переход на F0C
C
 ЗАВЕРШЕНИЕ_МОДУЛЯ:M7,MTJ,8             .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К1
