CREDTXT - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 16096 образа SIPROD.BIN
CДлина при загрузке: 32 слов, 52 команд
CВход: REDTXT
CВыход: SCHEMA:STVA, F3B (возврат через М12), F3C (возврат через М10)
CОБРАБОТКА ТЕКСТА *RED: ПЕРЕДАЁТ УПРАВЛЕНИЕ РАЗБОРУ
CКОМАНД SPAUD.
CВнешние: FIN, REGIM, NUST, RUSIS, SPAUD
CСмещения в кадре (М7): общие 0-3, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 REDTXT  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *FIN*   :,LC,1
 *REGIM* :,LC,16
 *NUST*  :,LC,10
 *RUSIS* :,LC,1
 SPAUD   :,SUBP,
 M16,VTM,ЧТЕНИЕ_РЕЖИМА                  .М16 := адрес RUSISA
 ,UJ,ЧТЕНИЕ_КОМАНДЫ                     .переход на F3B
C
 ЧТЕНИЕ_РЕЖИМА:M7,XTA,                  .СМ := слот кадра 0
 ,UTC,*RUSIS*                           .мод.адрес := RUSIS
 ,ATX,                                  .по адресу RUSIS := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,1                               .СМ := слот кадра 1
 M7,ATX,3                               .слот кадра 3 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ПЕРЕДАЧА_СКАНЕРУ:M16,VTM,ЗНАЧЕНИЕ      .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ+1                     .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,SPAUD                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*FIN*                             .мод.адрес := FIN
 ,XTA,                                  .СМ := слово по адресу FIN
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,БЛОК_ПРОДОЛЖЕНИЕ                  .если СМ=0 → F1
 ,UJ,ОШИБКА_ВЫВОДА                      .переход на F3
C
 БЛОК_ПРОДОЛЖЕНИЕ:,UJ,ПРОВЕРКА_КОМАНДЫ  .переход на F3A
C
 ОШИБКА_ВЫВОДА:M7,XTA,3                 .СМ := слот кадра 3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,3                               .слот кадра 3 := СМ
 M7,X-A,2                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ПЕРЕДАЧА_СКАНЕРУ                  .если СМ=0 → RUSISB
 ПРОВЕРКА_КОМАНДЫ:,UJ,ВОЗВРАТ_ИЗ_МОДУЛЯ .переход на F3C
C
 ЧТЕНИЕ_КОМАНДЫ:M7,MTJ,8                .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_1                      .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 ВОЗВРАТ_ИЗ_МОДУЛЯ:,STI,                .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
 ПАРАМЕТР_1:,INT,0
 ЕДИНИЦА:,INT,1
 КОНСТАНТА_25000:,INT,25000
C ЗАРЕЗЕРВИРОВАННАЯ ЯЧЕЙКА, КОДОМ МОДУЛЯ НЕ ИСПОЛЬЗУЕТСЯ
 РЕЗЕРВ_ЯЧЕЕК_МОДУЛЯ:,BSS,1
 ЗНАЧЕНИЕ:,BSS,2
 ,END,
