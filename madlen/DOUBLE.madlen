 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*TAB*+3                           .мод.адрес := TAB3
 ,XTA,                                  .СМ := слово по адресу TAB3
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,STR25A                            .если СМ≠0 → STR25A
 ,UJ,STR25B                             .переход на STR25B
C
 STR25A:,UJ,ЦИКЛ5_ПЕРЕХОД               .переход на F15
C
 STR25B:,UTC,*STR*+25                   .мод.адрес := STR25
 ,XTA,                                  .СМ := слово по адресу STR25
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*STR*+24                          .мод.адрес := STR24
 ,XTA,                                  .СМ := слово по адресу STR24
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,DDRH                              .если СМ=0 → DDRH
  :7,XTA,1                              .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*NUST*+1                          .мод.адрес := NUST1
 ,XTA,                                  .СМ := слово по адресу NUST1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,DDRH                              .если СМ≠0 → DDRH
 ,UJ,DDRI                               .переход на DDRI
C
 DDRH:,UJ,ЦИКЛ5_ПЕРЕХОД                 .переход на F15
C
C ПРОВЕРКА ДОСТИЖЕНИЯ КОНЦА ВХОДНОГО ТЕКСТА ПО *DDR*
 DDRI:,UTC,*DDR*                        .мод.адрес := DDR
 ,XTA,                                  .СМ := слово по адресу DDR
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A-X,                                  .СМ -= слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,NDAB1B                            .если СМ≠0 → NDAB1B
 ,UJ,NDAB1C                             .переход на NDAB1C
C
 NDAB1B:,UJ,ЦИКЛ5_ПЕРЕХОД               .переход на F15
C
 NDAB1C:,UTC,*NDAB*+1                   .мод.адрес := NDAB1
 ,XTA,                                  .СМ := слово по адресу NDAB1
 M7,ATX,17B                             .слот кадра 15 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,ENDSTR                         .вызов через М15
 M7,XTA,17B                             .СМ := слот кадра 15
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*NDAB*+1                          .мод.адрес := NDAB1
 ,XTA,                                  .СМ := слово по адресу NDAB1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,BEGSTB                            .если СМ=0 → BEGSTB
 ,UJ,ЦИКЛ5_ПЕРЕХОД                      .переход на F15
C
 BEGSTB:M15,VJM,BEGSTR                  .вызов через М15
 ЦИКЛ5_ПЕРЕХОД:,UJ,ВОЗВРАТ_В_БЛОК       .переход на F15B
C
 ПЕР_18:M7,MTJ,8                        .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К4
 M7,STX,22B                             .ЗП + магазин: 18(М7)
 M7,STX,21B                             .ЗП + магазин: 17(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: ОБРАЗЦЫ ТЕКСТА ФОРМАТА ДВОЙНОГО ПРОГОНА: '(  '47', 'OJU'47',1', '0I6)'
 МАСКА_47:,ISO,6H(  '47'   .. 050 040 040 047 040 040
C РЕЖИМЫ: ИМЯ РЕЖИМА ДВОЙНОГО ФОРМАТА: 'DUBLIU'
 МАСКА_DUBLIU:,ISO,6HDUBLIU .. 104 125 102 114 111 125
 МАСКА_OJU471:,ISO,6HOJU'47',1 .. 117 112 125 047 054 061
 МАСКА_0I6:,ISO,6H0I6)   .. 060 111 066 051 040 040
C ЧИСЛА: КОДЫ ПОЗИЦИЙ И ДЛИН ПРИ ФОРМИРОВАНИИ СТРОКИ В ДВОЙНОМ ФОРМАТЕ
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 8; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_3:,INT,8
C ЗНАЧЕНИЕ 10; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_4:,INT,10
C ПЕРЕМЕННЫЕ МОДУЛЯ, ИСПОЛЬЗУЮТСЯ В РАЗБОРЕ
C ПЕРЕМЕННЫЕ: РАБОЧИЕ ПОЛЯ, ЯЧЕЙКА ЗНАЧЕНИЯ I*MU*I, КОД СИМВОЛА, СМЕЩЕНИЕ, УКАЗАТЕЛЬ ПОЗИЦИИ
 РАБОЧИЕ_ПОЛЯ_МОДУЛЯ:,BSS,1
