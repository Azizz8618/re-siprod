 M12,ATX,25B                            .параметр вызова ОС 21 := СМ
 M12,WTC,24B                            .мод.адрес := код из 20(М12)
 ,XTA,                                  .СМ := слово по адресу 20+М12
 M10,A+X,3                              .СМ += поле блока вызывающего 3
 ,ATI,13                                .М15 := СМ
 ,X-A,                                  .СМ := (адрес) - СМ
 ,ATI,11                                .М13 := СМ
 M12,WTC,23B                            .мод.адрес := код из 19(М12)
 ,XTA,                                  .СМ := слово по адресу 19+М12
 M10,A+X,3                              .СМ += поле блока вызывающего 3
 ,ATI,9                                 .М11 := СМ
 M14,XTA,                               .СМ := смещение в буфере 0
 M13,UTC,                               .мод.адрес := 0(М13)
 M11,ASN,64+0
 M15,UTC,                               .мод.адрес := 0(М15)
 M10,AAX,11B                            .СМ &= поле блока вызывающего 9
 M7,UJ,                                 .переход через М7
C
 ПОЛЕ_БЛОКА_ВЫЗЫВАЮЩЕГО:M10,AOX,3       .СМ |= поле блока вызывающего 3
 M16,ATX,                               .ячейка мод.адреса 0 := СМ
C ПЕРЕДАЧА РЕЗУЛЬТАТА В ОС И ВЫЗОВ KONSTA ДЛЯ ПРОДОЛЖЕНИЯ
 ВЫЗОВ_KONSTA:M12,WTC,14B               .мод.адрес := код из 12(М12)
 M7,VTM,                                .М7 := код из 12+М12
 M17,XTA,                               .СМ := поле контекста 0
 ,NTR,6                                 .РЖ := 6 (обращение к ОС)
 M12,WTC,11B                            .мод.адрес := код из 9(М12)
 ,UJ,                                   .переход по адресу в мод.адресе
C
 ,ITS,13                                .в магазин; СМ := М15
 M15,VJM,KONSTA                         .вызов через М15
 M12,STX,11B                            .ЗП + магазин: 9(М12)
 M12,STX,13B                            .ЗП + магазин: 11(М12)
