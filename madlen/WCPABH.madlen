CWCPABH - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6048 образа SIPROD.BIN
CДлина при загрузке: 43 слов, 78 команд
CВход: WCPABH
CВыход: LOOPB (возврат через М15)
CВнешние: *WДЛИHA*, *W24*
CСмещения в *WДЛИHA*: 1, 2
CАбсолютные символы: N1 = -1, N24 = -24
CРегистры: М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС),
CМ14 (смещение в буфере), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 WCPABH  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M11:,EQU,11B
 M12:,EQU,12B
 M14:,EQU,14B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C ОБЛАСТЬ WДЛИHA, 3 СЛОВА
 *WДЛИHA*:,LC,3
C W24: МАСКА: 24-РАЗРЯДНАЯ БИТОВАЯ МАСКА (24 СЛОВА)
 *W24*   :,LC,24
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,STI,10                                .М12 := СМ; СМ := из магазина
 ,ATI,9                                 .М11 := СМ
 ,WTC,*WДЛИHA*                          .мод.адрес := код из WДЛИHA
 WДЛИHB:M16,VTM,                        .М16 := код из WДЛИHA
 M14,VTM,WДЛИHB                         .М14 := адрес WДЛИHB
 WДЛИHC:M11,XTA,                        .СМ := смещение в буфере 0
 M16,VZM,WДЛИHD                         .если ИР=0 → WДЛИHD(М16)
 ,ASN,64+12
 M14,AOX,47B                            .СМ |= смещение в буфере 39
 M12,XTS,                               .магазин + СЧ: 0(М12)
 ,ASN,64+12
 M14,AOX,47B                            .СМ |= смещение в буфере 39
 M17,X-A,                               .СМ := (адрес) - СМ
 ,U1A,LOOP                              .если СМ≠0 → LOOP
 M14,AEX,47B                            .СМ ^= смещение в буфере 39
 ,U1A,LOOPA                             .если СМ≠0 → LOOPA
 M11,XTA,                               .СМ := смещение в буфере 0
 M14,AAX,45B                            .СМ &= смещение в буфере 37
 M14,AOX,47B                            .СМ |= смещение в буфере 39
 M12,XTS,                               .магазин + СЧ: 0(М12)
 M14,AAX,45B                            .СМ &= смещение в буфере 37
 M14,AOX,47B                            .СМ |= смещение в буфере 39
 M17,X-A,                               .СМ := (адрес) - СМ
 ,U1A,LOOP                              .если СМ≠0 → LOOP
 M14,AEX,47B                            .СМ ^= смещение в буфере 39
 ,U1A,LOOPA                             .если СМ≠0 → LOOPA
 M12,UTM,1                              .М12 += 1
 M11,UTM,1                              .М11 += 1
 M16,UTM,-1                             .М16 += N1
 ,UJ,WДЛИHC                             .переход на WДЛИHC
C
C ПЕРЕДАЧА ПРИЗНАКА ИЗ БУФЕРА В РЕЗУЛЬТАТ
 LOOP:M14,XTA,46B                       .СМ := смещение в буфере 38
 ,UJ,LOOPB                              .переход на LOOPB
C
 LOOPA:M14,XTA,50B                      .СМ := смещение в буфере 40
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 LOOPB:,NTR,22B                         .РЖ := 18 (переходы по знаку)
 M15,UJ,                                .переход через М15
C
 WДЛИHD:,WTC,*WДЛИHA*+1                 .мод.адрес := код из WДЛИHA1
 M16,VTM,                               .М16 := код из WДЛИHA1
 M16,VZM,WДЛИHF                         .если ИР=0 → WДЛИHF(М16)
 ,ASN,64+24
 M14,AOX,47B                            .СМ |= смещение в буфере 39
 M12,XTS,                               .магазин + СЧ: 0(М12)
 ,ASN,64+24
 M14,AOX,47B                            .СМ |= смещение в буфере 39
 M17,X-A,                               .СМ := (адрес) - СМ
 ,U1A,LOOP                              .если СМ≠0 → LOOP
 M14,AEX,47B                            .СМ ^= смещение в буфере 39
 ,U1A,LOOPA                             .если СМ≠0 → LOOPA
 ,WTC,*WДЛИHA*+2                        .мод.адрес := код из WДЛИHA2
 M16,VTM,-24                            .М16 := адрес N24
 M11,XTA,                               .СМ := смещение в буфере 0
 M16,UTC,*W24*                          .мод.адрес := W24(М16)
 ,AAX,-1                                .СМ &= '4003'
 M14,AOX,47B                            .СМ |= смещение в буфере 39
 M12,XTS,                               .магазин + СЧ: 0(М12)
 WДЛИHE:M16,UTC,*W24*                   .мод.адрес := W24(М16)
 ,AAX,-1                                .СМ &= '4003'
 M14,AOX,47B                            .СМ |= смещение в буфере 39
 M17,X-A,                               .СМ := (адрес) - СМ
 ,U1A,LOOP                              .если СМ≠0 → LOOP
 M14,AEX,47B                            .СМ ^= смещение в буфере 39
 ,U1A,LOOPA                             .если СМ≠0 → LOOPA
 M14,XTA,47B                            .СМ := смещение в буфере 39
 ,UJ,LOOPB                              .переход на LOOPB
C
C ЗАПИСЬ СИМВОЛА В МАГАЗИН С МАСКИРОВАНИЕМ КОДА
 WДЛИHF:,WTC,*WДЛИHA*+2                 .мод.адрес := код из WДЛИHA2
 M16,VTM,                               .М16 := код из WДЛИHA2
 M11,XTA,                               .СМ := смещение в буфере 0
 ,ASN,64+24
 M16,UTC,*W24*                          .мод.адрес := W24(М16)
 ,AAX,-1                                .СМ &= '4003'
 M14,AOX,47B                            .СМ |= смещение в буфере 39
 M12,XTS,                               .магазин + СЧ: 0(М12)
 ,ASN,64+24
 ,UJ,WДЛИHE                             .переход на WДЛИHE
C
C МАСКИ: МАСКА 7777 - МЛАДШИЕ 12 РАЗРЯДОВ КОДА СИМВОЛА ПРИ ПОДСЧЁТЕ
 МАСКА_7777:,LOG,7777
C ЧИСЛА: ШАГ -1 ПРИ ПЕРЕБОРЕ ТАБЛИЦЫ МАСОК *W24* И ЗНАЧЕНИЯ СРАВНЕНИЙ
 КОНСТАНТА_1:,INT,-1
 НОЛЬ:,INT,0
 ЕДИНИЦА:,INT,1
 ,END,
