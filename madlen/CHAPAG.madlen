CCHAPAG - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 20736 образа SIPROD.BIN
CДлина при загрузке: 95 слов, 158 команд
CВход: CHAPAG
CВыход: FIRCAR:SCANEK, F11 (возврат через М12), POP (возврат через М10)
CРАЗБОР ЗАГОЛОВКА СТРАНИЦЫ.
CВнешние: NUST, REGIM, SCANER, INS, PAGE, SYTINT, KLAIDA, SCAN
CСмещения в INS: 24, 25, 26
CСмещения в NUST: 5, 6, 7
CСмещения в REGIM: 9
CСмещения в SCANER: 1, 2
CСмещения в кадре (М7): общие 0-3, 6-8, 10, свои 11-15
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 CHAPAG  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C NUST: СОСТОЯНИЕ ВХОДНОГО ПОТОКА: РЕЖИМ РАЗБОРА (10 СЛОВ)
 *NUST*  :,LC,10
C REGIM: ПАРАМЕТРЫ РЕЖИМА НАБОРА: МЕЖСТРОЧНЫЙ ИНТЕРВАЛ, РАЗРЯДКА, ПЕРЕНОС ПО СЛОВАМ, НОМЕРА СТРАНИЦ, РАМКА, ВЫРАЗНИВАНИЕ (16 СЛОВ)
 *REGIM* :,LC,16
C SCANER: СОСТОЯНИЕ РАЗБОРЩИКА: ТЕКУЩИЙ СИМВОЛ И КЛАСС (3 СЛОВА)
 *SCANER*:,LC,3
C INS: ВХОДНОЙ ПОТОК: УКАЗАТЕЛИ И ТЕКСТ ВХОДНЫХ ДАННЫХ (27 СЛОВ)
 *INS*   :,LC,27
C PAGE: ПАРАМЕТРЫ СТРАНИЦЫ: НОМЕР, ПОЛОСА (6 СЛОВ)
 *PAGE*  :,LC,6
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 SYTINT  :,SUBP,
 KLAIDA  :,SUBP,
 SCAN    :,SUBP,
 M16,VTM,REGIMA                         .М16 := адрес REGIMA
 ,UJ,ПЕР_15                             .переход на F11
C
C ЗАПОМНЕНИЕ РЕЖИМА И ЧТЕНИЕ СИМВОЛА ЗАГОЛОВКА
 REGIMA:M7,XTA,2                        .СМ := слот кадра 2
 ,UTC,*REGIM*+9                         .мод.адрес := REGIM9
 ,ATX,                                  .по адресу REGIM9 := СМ
 ,WTC,ЯЧ_ЗАГОЛ_3                        .мод.адрес := код из V6
 ,XTA,                                  .СМ := слово по адресу V6
 ,UTC,*NUST*+7                          .мод.адрес := NUST7
 ,ATX,                                  .по адресу NUST7 := СМ
 M7,XTA,                                .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*NUST*+7                          .мод.адрес := NUST7
 ,XTA,                                  .СМ := слово по адресу NUST7
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,NUST7A                            .если СМ≠0 → NUST7A
 ,UJ,NUST7B                             .переход на NUST7B
C
 NUST7A:,UTC,*NUST*+7                   .мод.адрес := NUST7
 ,XTA,                                  .СМ := слово по адресу NUST7
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*NUST*+7                          .мод.адрес := NUST7
 ,ATX,                                  .по адресу NUST7 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 NUST7B:M7,XTA,                         .СМ := слот кадра 0
 M7,ATX,12B                             .слот кадра 10 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 SCANA:M15,VJM,SCAN                     .вызов через М15
 M7,XTA,3                               .СМ := слот кадра 3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,ВЫЗОВ_KLAIDA                      .если СМ≠0 → F3
 ,UJ,SCANEA                             .переход на SCANEA
C
 ВЫЗОВ_KLAIDA:M16,VTM,КОД_5             .М16 := адрес К4
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,KLAIDA                         .вызов через М15
 SCANEA:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,13B                             .слот кадра 11 := СМ
 M16,VTM,*INS*                          .М16 := адрес INS
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_ЗАГОЛ_1                     .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_ЗАГОЛ_2                     .М16 := адрес V3
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,SYTINT                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,13B                             .СМ := слот кадра 11
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 M7,XTA,12B                             .СМ := слот кадра 10
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,12B                             .слот кадра 10 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,12B                             .СМ := слот кадра 10
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,NUST5A                            .если СМ≠0 → NUST5A
 ,UJ,NUST5B                             .переход на NUST5B
C
 NUST5A:,UJ,NUST6A                      .переход на NUST6A
C
C ЗАПОМНЕНИЕ СМЕЩЕНИЯ NUST5 И ПРОДОЛЖЕНИЕ РАЗБОРА
 NUST5B:M7,XTA,14B                      .СМ := слот кадра 12
 ,UTC,*NUST*+5                          .мод.адрес := NUST5
 ,ATX,                                  .по адресу NUST5 := СМ
 ,UJ,SCANA                              .переход на SCANA
C
C ЗАПОМНЕНИЕ ВТОРОГО СМЕЩЕНИЯ И ПРОВЕРКА РЕЖИМА
 NUST6A:M7,XTA,14B                      .СМ := слот кадра 12
 ,UTC,*NUST*+6                          .мод.адрес := NUST6
 ,ATX,                                  .по адресу NUST6 := СМ
 M7,XTA,6                               .СМ := слот кадра 6
 M7,ATX,15B                             .слот кадра 13 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,NUST5C                            .если СМ≠0 → NUST5C
 ,UJ,NUST5D                             .переход на NUST5D
C
 NUST5C:M7,XTA,10B                      .СМ := слот кадра 8
 M7,ATX,15B                             .слот кадра 13 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ПРОВЕРКА ВЫХОДА ЗАГОЛОВКА ЗА ГРАНИЦЫ ПОЛЯ
 NUST5D:M7,XTA,7                        .СМ := слот кадра 7
 M7,ATX,16B                             .слот кадра 14 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*NUST*+5                          .мод.адрес := NUST5
 ,XTA,                                  .СМ := слово по адресу NUST5
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,15B                             .СМ += слот кадра 13
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,ADDR                              .если СМ≠0 → ADDR
  :,UTC,*NUST*+6                        .мод.адрес := NUST6
 ,XTA,                                  .СМ := слово по адресу NUST6
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,16B                             .СМ += слот кадра 14
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,ADDR                              .если СМ≠0 → ADDR
 ,UJ,SCANEB                             .переход на SCANEB
C
 ADDR:M16,VTM,КОД_6                     .М16 := адрес К5
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,KLAIDA                         .вызов через М15
 SCANEB:M7,XTA,13B                      .СМ := слот кадра 11
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,XTA,                                  .СМ := слово по адресу INS26
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,SCANEC                            .если СМ=0 → SCANEC
 ,UJ,SCANED                             .переход на SCANED
C
 SCANEC:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 SCANED:,UJ,POP                         .переход на POP
C
C ВОЗВРАТ В ОС
 ПЕР_15:M7,MTJ,8                        .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К0
 M7,STX,17B                             .ЗП + магазин: 15(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ: КОДЫ ОШИБОК 20 И 40, ГРАНИЦЫ И НОМЕРА ПОЛЕЙ ЗАГОЛОВКА
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 10; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_3:,INT,10
C ЗНАЧЕНИЕ 19; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_4:,INT,19
C ЗНАЧЕНИЕ 20; ПАРАМЕТР ВЫЗОВА KLAIDA
 КОД_5:,INT,20
C ЗНАЧЕНИЕ 40; ПАРАМЕТР ВЫЗОВА KLAIDA
 КОД_6:,INT,40
C ЗНАЧЕНИЕ 64; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_7:,INT,64
C ЗНАЧЕНИЕ 66; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_8:,INT,66
C ЗНАЧЕНИЕ 128; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_9:,INT,128
C СЛУЖЕБНЫЕ ЯЧЕЙКИ РАЗБОРА ЗАГОЛОВКА СТРАНИЦЫ
C ПЕРЕМЕННЫЕ: СЛУЖЕБНЫЕ ЯЧЕЙКИ РАЗБОРА ЗАГОЛОВКА: БУФЕР СИМВОЛОВ И РЕЗУЛЬТАТ СРАВНЕНИЯ
 ЯЧЕЙКИ_ЗАГОЛОВКА:,BSS,2
 ЯЧ_ЗАГОЛ_1:,BSS,1
 ЯЧ_ЗАГОЛ_2:,BSS,3
 ЯЧ_ЗАГОЛ_3:,BSS,1
 ,END,
