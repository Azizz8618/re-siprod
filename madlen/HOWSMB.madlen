CHOWSMB - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6880 образа SIPROD.BIN
CДлина при загрузке: 37 слов, 58 команд
CВход: HOWSMB
CВыход: APNOTF:ENDKOA, CSTRIN:F8, CSTRIN:F8, GOTOPO:F5, RASKOM:F1B,
CTARNYB:NOTFH, TARNYB:F1, WRIHOR:L0166, WRIHOR:L0166, WRILIN:F7B,
CWRILIN:F7B, WRINUM:F0, WRIVER:F18, F6 (возврат через М12),
CPOP (возврат через М10)
CВнешние: WHO, RSYMB
CСмещения в WHO: 1
CАбсолютные символы: N1 = -1
CСмещения в кадре (М7): общие 0-1, 4-6, 10, вне кадра 2052
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 HOWSMB  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C ОБЛАСТЬ WHO, 2 СЛОВА
 *WHO*   :,LC,2
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 RSYMB   :,SUBP,
 M16,VTM,ВЫЗОВ_RSYMB                    .М16 := адрес F5
 ,UJ,ПЕР_6                              .переход на F6
C
 ВЫЗОВ_RSYMB:M7,XTA,-1                  .СМ := каталог задачи: элемент 4
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,WTC,ЗНАЧЕН2ИЕ_ВЫВОДА_2                .мод.адрес := код из V1
 M16,VTM,                               .М16 := код из V1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ_ВЫВОДА_1              .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_4                          .М16 := адрес К4
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,1                               .СМ := слот кадра 1
 ,UTC,*WHO*+1                           .мод.адрес := WHO1
 ,ATX,                                  .по адресу WHO1 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,-1                              .СМ := каталог задачи: элемент 4
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,5                               .СМ := слот кадра 5
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,WHO1A                             .если СМ=0 → WHO1A
 ,UJ,WHO1B                              .переход на WHO1B
C
 WHO1A:M7,XTA,                          .СМ := слот кадра 0
 ,UTC,*WHO*+1                           .мод.адрес := WHO1
 ,ATX,                                  .по адресу WHO1 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ЗАПИСЬ ПОЛНОГО ИМЕНИ ОБЪЕКТА В БЛОК WHO
 WHO1B:M7,XTA,4                         .СМ := слот кадра 4
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*WHO*+1                           .мод.адрес := WHO1
 ,A-X,                                  .СМ -= слово по адресу WHO1
 ,UTC,*WHO*                             .мод.адрес := WHO
 ,ATX,                                  .по адресу WHO := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ПЕР_6:M7,MTJ,8                         .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К1
 M7,STX,6                               .ЗП + магазин: 6(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: ЗАБИВКА БУФЕРА ИМЕНИ ОБЪЕКТА ПРОБЕЛАМИ
 МАСКА_ПРОБЕЛОВ:,ISO,6H       .. 040 040 040 040 040 040
C ЧИСЛА: ПОЗИЦИИ И ДЛИНЫ ИМЕНИ ОБЪЕКТА В БЛОКЕ WHO: 1, 2, 5, 6, 7
C ЗНАЧЕНИЕ 1; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,1
C ЗНАЧЕНИЕ 2; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_2:,INT,2
C ЗНАЧЕНИЕ 5; ПАРАМЕТР ВЫЗОВА RSYMB
 КОД_3:,INT,5
C ЗНАЧЕНИЕ 6; ПАРАМЕТР ВЫЗОВА RSYMB
 КОД_4:,INT,6
C ЗНАЧЕНИЕ 7; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_5:,INT,7
C ПЕРЕМЕННЫЕ: ЯЧЕЙКА, КУДА RSYMB ПИШЕТ КОД СИМВОЛА, И САМ КОД СИМВОЛА
 ЗНАЧЕНИЕ_ВЫВОДА_1:,BSS,1
 ЗНАЧЕН2ИЕ_ВЫВОДА_2:,BSS,1
 ,END,
