CREADMK - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 19424 образа SIPROD.BIN
CДлина при загрузке: 123 слов, 212 команд
CВход: READMK
CВыход: SPAUD:INS26Q, F2C (возврат через М12), F2D (возврат через М10)
CВнешние: INS, MKR, RMK, NRM, STV, SCANER, KLAIDA, GETSTR, RNSYMB, SCAN,
CIMUI
CСмещения в INS: 24, 25, 26
CСмещения в MKR: 500, 501
CСмещения в SCANER: 1, 2
CСмещения в кадре (М7): общие 0-2, 4-7, 9-10, свои 11-14, 16
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 READMK  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *INS*   :,LC,27
 *MKR*   :,LC,502
 *RMK*   :,LC,250
 *NRM*   :,LC,1
 *STV*   :,LC,1
 *SCANER*:,LC,3
 KLAIDA  :,SUBP,
 GETSTR  :,SUBP,
 RNSYMB  :,SUBP,
 SCAN    :,SUBP,
 I*MU*I  :,SUBP,
 M16,VTM,STVA                           .М16 := адрес STVA
 ,UJ,ЗАВЕРШЕНИЕ_МОДУЛЯ                  .переход на F2C
C
 STVA:M7,XTA,1                          .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*STV*                             .мод.адрес := STV
 ,XTA,                                  .СМ := слово по адресу STV
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,MKR50A                            .если СМ=0 → MKR50A
 ,UJ,MKR50B                             .переход на MKR50B
C
 MKR50A:,UJ,MKR50C                      .переход на MKR50C
C
 MKR50B:M7,XTA,                         .СМ := слот кадра 0
 ,UTC,*MKR*+500                         .мод.адрес := MKR500
 ,ATX,                                  .по адресу MKR500 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*MKR*+501                         .мод.адрес := MKR501
 ,ATX,                                  .по адресу MKR501 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,UTC,*STV*                             .мод.адрес := STV
 ,ATX,                                  .по адресу STV := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 MKR50C:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 M7,ATX,11B                             .слот кадра 9 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ПРОВЕРКА ОКОНЧАНИЯ КАРТЫ В МАКРООПРЕДЕЛЕНИИ
 MKR50D:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A-X,                                  .СМ -= слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,КОНЕЦ_ЧТЕНИЯ_МАКРОТЕКСТА          .если СМ=0 → F1
 ,UJ,SCANA                              .переход на SCANA
C
 КОНЕЦ_ЧТЕНИЯ_МАКРОТЕКСТА:,UJ,INS26A    .переход на INS26A
C
 SCANA:M15,VJM,SCAN                     .вызов через М15
 M7,XTA,4                               .СМ := слот кадра 4
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,SCANEA                            .если СМ≠0 → SCANEA
 ,UJ,SCANEB                             .переход на SCANEB
C
 SCANEA:,UJ,MKR50D                      .переход на MKR50D
C
 SCANEB:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,2                               .СМ -= слот кадра 2
 M7,ATX,12B                             .слот кадра 10 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 M7,ATX,13B                             .слот кадра 11 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,INS26B                             .переход на INS26B
C
 INS26A:,UTC,*INS*+26                   .мод.адрес := INS26
 ,XTA,                                  .СМ := слово по адресу INS26
 M7,ATX,12B                             .слот кадра 10 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 M7,ATX,13B                             .слот кадра 11 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 INS26B:M7,XTA,12B                      .СМ := слот кадра 10
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,11B                             .СМ -= слот кадра 9
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,14B                             .слот кадра 12 := СМ
 ,UTC,*MKR*+500                         .мод.адрес := MKR500
 ,XTA,                                  .СМ := слово по адресу MKR500
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,15B                             .слот кадра 13 := СМ
 ,UTC,*MKR*+500                         .мод.адрес := MKR500
 ,XTA,                                  .СМ := слово по адресу MKR500
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A-X,14B                             .СМ -= слот кадра 12
 M7,A+X,7                               .СМ += слот кадра 7
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ПЕРЕХОД_К_ЧТЕНИЮ_ЧИСЛА            .если СМ=0 → F10
 ,UJ,ОШИБКА_ДЛИНЫ_ИМЕНИ                 .переход на F5
C
 ПЕРЕХОД_К_ЧТЕНИЮ_ЧИСЛА:,UJ,ЧТЕНИЕ_ЧИСЛА_МАКРО.переход на F5A
C
 ОШИБКА_ДЛИНЫ_ИМЕНИ:M7,XTA,5            .СМ := слот кадра 5
 M7,ATX,16B                             .слот кадра 14 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВЫВОД_ОШИБКИ_МАКРО                 .переход на F2A
C
 ЧТЕНИЕ_ЧИСЛА_МАКРО:M16,VTM,*INS*       .М16 := адрес INS
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ПЕРВОЕ_ЗНАЧЕНИЕ                .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*MKR*                          .М16 := адрес MKR
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,СРЕДНЕЕ_ЗНАЧЕНИЕ               .М16 := адрес V5
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ВТОРОЕ_ЗНАЧЕНИЕ                .М16 := адрес V4
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*MKR*+500                         .мод.адрес := MKR500
 ,XTA,                                  .СМ := слово по адресу MKR500
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,14B                             .СМ += слот кадра 12
 ,UTC,*MKR*+500                         .мод.адрес := MKR500
 ,ATX,                                  .по адресу MKR500 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,13B                             .СМ := слот кадра 11
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ПЕРЕХО2Д_К_ПРОВЕРКЕ               .если СМ=0 → F11
 ,UJ,ЧТЕНИЕ_СТРОКИ_МАКРО                .переход на F11A
C
 ПЕРЕХО2Д_К_ПРОВЕРКЕ:,UJ,NRMA           .переход на NRMA
C
 ЧТЕНИЕ_СТРОКИ_МАКРО:M16,VTM,ВХОДНАЯ_СТРОКА.М16 := адрес V7
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,GETSTR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*INS*+25                          .мод.адрес := INS25
 ,XTA,                                  .СМ := слово по адресу INS25
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,MKR50C                             .переход на MKR50C
C
 NRMA:,UTC,*NRM*                        .мод.адрес := NRM
 ,XTA,                                  .СМ := слово по адресу NRM
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*MKR*+501                         .мод.адрес := MKR501
 ,XTA,                                  .СМ := слово по адресу MKR501
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ПЕРЕХО3Д_К_ИСПОЛНЕНИЮ             .если СМ=0 → F11B
 ,UJ,ОШИБКА_НОМЕРА_МАКРО                .переход на F6
C
 ПЕРЕХО3Д_К_ИСПОЛНЕНИЮ:,UJ,ВЫПОЛНЕНИЕ_МАКРО.переход на F2
C
 ОШИБКА_НОМЕРА_МАКРО:M7,XTA,6           .СМ := слот кадра 6
 M7,ATX,16B                             .слот кадра 14 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВЫВОД_ОШИБКИ_МАКРО                 .переход на F2A
C
 ВЫПОЛНЕНИЕ_МАКРО:M7,XTA,2              .СМ := слот кадра 2
 M16,VTM,*NRM*                          .М16 := адрес NRM
 M15,VJM,I*MU*I                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,20B                             .слот кадра 16 := СМ
 M16,VTM,*MKR*+500                      .М16 := адрес MKR500
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_4                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*RMK*                          .М16 := адрес RMK
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ_3                     .М16 := адрес V8
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*NRM*                             .мод.адрес := NRM
 ,XTA,                                  .СМ := слово по адресу NRM
 ,UTC,*MKR*+501                         .мод.адрес := MKR501
