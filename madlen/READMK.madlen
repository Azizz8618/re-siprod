 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ПЕРЕХО4Д_К_ВОЗВРАТУ                .переход на F2B
C
 ВЫВОД_ОШИБКИ_МАКРО:M16,VTM,КОД_ОШИБКИ  .М16 := адрес V6
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,KLAIDA                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ПЕРЕХО4Д_К_ВОЗВРАТУ:,UJ,ВОССТАНОВЛЕНИЕ_КАДРА.переход на F2D
C
 ЗАВЕРШЕНИЕ_МОДУЛЯ:M7,MTJ,8             .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОССТАНОВЛЕНИЕ_КАДРА:,STI,             .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: НОМЕРА ОШИБОК МАКРООПРЕДЕЛЕНИЯ (90, 91) И ПРЕДЕЛЬНЫЕ РАЗМЕРЫ ТЕЛА
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 2; ПАРАМЕТР ВЫЗОВА RNSYMB
 КОД_3:,INT,2
C ЗНАЧЕНИЕ 5; ПАРАМЕТР ВЫЗОВА RNSYMB
 КОД_4:,INT,5
C ЗНАЧЕНИЕ 22; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_5:,INT,22
C ЗНАЧЕНИЕ 90; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_6:,INT,90
C ЗНАЧЕНИЕ 91; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_7:,INT,91
C ЗНАЧЕНИЕ 3000; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_8:,INT,3000
C ПЕРЕМЕННАЯ МОДУЛЯ, В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
C ПЕРЕМЕННЫЕ: БУФЕРЫ ЧТЕНИЯ ТЕЛА МАКРОСА, СЧЁТЧИКИ И КОД ОШИБКИ
 НЕИСПОЛЬЗУЕМОЕ_ПОЛЕ:,BSS,1
 ПЕРВОЕ_ЗНАЧЕНИЕ:,BSS,3
 ВТОРОЕ_ЗНАЧЕНИЕ:,BSS,1
 СРЕДНЕЕ_ЗНАЧЕНИЕ:,BSS,1
 КОД_ОШИБКИ:,BSS,1
 ВХОДНАЯ_СТРОКА:,BSS,1
 ЗНАЧЕНИЕ_3:,BSS,1
 ,END,
