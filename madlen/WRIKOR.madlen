CWRIKOR - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6336 образа SIPROD.BIN
CДлина при загрузке: 55 слов, 90 команд
CВход: WRIKOR
CВыход: APNOTF:GOTA, APNOTF:F1B, APNOTF:F1B, APNOTF:PAGE1A,
CAPNOTF:PAGE1A, APNOTF:PAGE1A, APNOTF:ENDKOA, APNOTF:ENDKOA,
CAPNOTF:ENDKOA, APNOTF:ENDKOA, CSTRIN:F8, CSTRIN:F8, CSTRIN:F8,
CCSTRIN:F8, GOTOPO:F5, GOTOPO:F5, GOTOPO:F5, IPONUM:F4, IPONUM:F4,
CNAMENF:F7, NAMENF:F1, NAMENF:F1, NOTFOR:TYPEA, NOTFOR:F0, NOTFOR:F0,
CNOTFOR:NOTF1A, ONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320,
CONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320, ONEPLA:L0320,
CONEPLA:L0320, RASKOM:F10, RASKOM:F10, RASKOM:F10, RASKOM:F1, RASKOM:F1,
CRASKOM:ADDRA, RASKOM:F20, RASKOM:F6, RASKOM:F6, RASKOM:F6, RASKOM:F6,
CRASKOM:F6, RASKOM:F20A, RASKOM:F20A, RASKOM:F20A, SCHEMA:BLOE,
CSCHEMA:FOPF, SCHEMA:F5, SCHEMA:BLOG, SCHEMA:ENDKOA, SCHEMA:ENDKOA,
CSCHEMA:NUSTE, TARNYB:TYPE1A, TARNYB:TYPE1A, TARNYB:NOTF1A,
CTARNYB:KORT1A, TARNYB:NOTFH, TARNYB:NOTFH, TARNYB:NOTFH, TARNYB:NOTFH,
CTARNYB:NOTFH, TARNYB:F1, TARNYB:F1, TARNYB:F1, TARNYB:F1, TARNYB:F1,
CTARNYB:F1, TARNYB:F1, TWOPLA:F0, TWOPLA:F0, TWOPLA:NUM3A, TWOPLA:NUM3A,
CTWOPLA:F13A, TWOPLA:F13A, TWOPLA:F3, TWOPLA:F3, TWOPLA:F3,
CTWOPLA:NUM3F, TWOPLA:NUM3F, TWOPLA:NUM3F, TWOPLA:F13C, WRIHOR:L0166,
CWRIHOR:L0166, WRIHOR:L0166, WRIHOR:L0166, WRIHOR:L0166, WRIHOR:L0166,
CWRIIPO:IPONUA, WRIIPO:SCANEA, WRIIPO:INS26A, WRIIPO:INS26A,
CWRIIPO:INS26A, WRIIPO:SCANEG, WRIIPO:F11A, WRILIN:F7B, WRILIN:F7B,
CWRILIN:F7B, WRILIN:F7B, WRILIN:F7B, WRILIN:F7B, WRINUM:F0, WRINUM:F0,
CWRINUM:F0, WRINUM:F0, WRINUM:F0B, WRINUM:F0B, WRITEH:ONEPLB,
CWRIVER:CENA, WRIVER:F18, WRIVER:WHO1A, WRIVER:F18A,
CF3B (возврат через М12), POP (возврат через М10)
CЗАПИСЬ В БУФЕР ВЫВОДА.
CВнешние: KORT, ENDKOR, RNSYMB
CСмещения в KORT: 14
CСмещения в кадре (М7): общие 0-10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 WRIKOR  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *KORT*  :,LC,15
 ENDKOR  :,SUBP,
 RNSYMB  :,SUBP,
 M16,VTM,KORT1A                         .М16 := адрес KORT1A
 ,UJ,ПЕР+9                              .переход на F3B
C
 KORT1A:,WTC,ЯЧ_БУФ+3                   .мод.адрес := код из V5
 ,XTA,                                  .СМ := слово по адресу V5
 M7,ATX,3                               .слот кадра 3 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,WTC,ЯЧ_БУФ+4                          .мод.адрес := код из V6
 ,XTA,                                  .СМ := слово по адресу V6
 M7,ATX,4                               .слот кадра 4 := СМ
 M7,XTA,                                .СМ := слот кадра 0
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ВЫПИСКА СИМВОЛА В КОРРЕКТОР ЧЕРЕЗ RNSYMB
 KORT1B:M7,XTA,2                        .СМ := слот кадра 2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*KORT*+14                         .мод.адрес := KORT14
 ,A-X,                                  .СМ -= слово по адресу KORT14
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,6                               .слот кадра 6 := СМ
 M7,A-X,4                               .СМ -= слот кадра 4
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,ПЕР+6                             .если СМ≠0 → F6
 ,UJ,ВЫЗОВ_RNSYMB                       .переход на F6A
C
 ПЕР+6:M7,XTA,6                         .СМ := слот кадра 6
 M7,ATX,4                               .слот кадра 4 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ВЫЗОВ_RNSYMB:,WTC,ЯЧ_БУФ+2             .мод.адрес := код из V4
 M16,VTM,                               .М16 := код из V4
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_БУФ                         .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*KORT*                         .М16 := адрес KORT
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*KORT*+14                      .М16 := адрес KORT14
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_БУФ+1                       .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,5                               .СМ := слот кадра 5
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,4                               .СМ += слот кадра 4
 M7,ATX,5                               .слот кадра 5 := СМ
 ,UTC,*KORT*+14                         .мод.адрес := KORT14
 ,XTA,                                  .СМ := слово по адресу KORT14
 M7,A+X,4                               .СМ += слот кадра 4
 ,UTC,*KORT*+14                         .мод.адрес := KORT14
 ,ATX,                                  .по адресу KORT14 := СМ
 ,WTC,ЯЧ_БУФ+4                          .мод.адрес := код из V6
 ,XTA,                                  .СМ := слово по адресу V6
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,5                               .СМ := слот кадра 5
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F5
 ,UJ,ВЫЗОВ_ENDKOR                       .переход на F3
C
 ЦИКЛ_ПЕРЕХОД:,UJ,ЦИКЛ_ПЕРЕХОД_2        .переход на F3A
C
 ВЫЗОВ_ENDKOR:M7,XTA,3                  .СМ := слот кадра 3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,4                               .СМ += слот кадра 4
 M7,ATX,3                               .слот кадра 3 := СМ
 ,WTC,ЯЧ_БУФ+4                          .мод.адрес := код из V6
 ,XTA,                                  .СМ := слово по адресу V6
 M7,A-X,5                               .СМ -= слот кадра 5
 M7,ATX,4                               .слот кадра 4 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,ENDKOR                         .вызов через М15
 ,UJ,KORT1B                             .переход на KORT1B
C
 ЦИКЛ_ПЕРЕХОД_2:,UJ,POP                 .переход на POP
C
 ПЕР+9:M7,MTJ,8                         .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,СЧЁТ_БУФ                        .М7 := адрес К0
 M7,STX,11B                             .ЗП + магазин: 9(М7)
 M7,STX,10B                             .ЗП + магазин: 8(М7)
 M7,STX,7                               .ЗП + магазин: 7(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: СЧЁТ СИМВОЛОВ В БУФЕРЕ ВЫВОДА И ПРЕДЕЛ СТРОКИ 84 ПОЗИЦИИ
 СЧЁТ_БУФ:,INT,0
 ЕДИНИЦА:,INT,1
 КОНСТАНТА_84:,INT,84
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ БУФЕРА ВЫВОДА: УКАЗАТЕЛИ, СЧЁТЧИК И ТЕКСТ
 ЯЧ_БУФ:,BSS,5
 ,END,
