CNEWMAX - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 20864 образа SIPROD.BIN
CДлина при загрузке: 71 слов, 136 команд
CВход: NEWMAX
CВыход: ENDPG:STANDD, RASTXT:NDAB1E, SEGTAB:TAB3A,
CF0 (возврат через М12), POP (возврат через М10)
CВнешние: LYG, NDAB, SEK, REGIM
CСмещения в LYG: 1, 2
CСмещения в NDAB: 1, 2
CСмещения в SEK: 2, 3
CСмещения в кадре (М7): общие 0-2, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 NEWMAX  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M16:,EQU,16B
 M17:,EQU,17B
 *LYG*   :,LC,6
 *NDAB*  :,LC,4
 *SEK*   :,LC,4
 *REGIM* :,LC,16
 M16,VTM,БЛОК_V0                        .М16 := адрес F1
 ,UJ,ПЕР_2                              .переход на F0
C
 БЛОК_V0:M7,XTA,1                       .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,WTC,ЗНАЧЕНИЕ_1                        .мод.адрес := код из V0
 ,XTA,                                  .СМ := слово по адресу V0
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,NDABA                             .если СМ=0 → NDABA
 ,UJ,NDABB                              .переход на NDABB
C
 NDABA:,UJ,SEK3B                        .переход на SEK3B
C
 NDABB:,UTC,*NDAB*                      .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 ,UTC,*LYG*+1                           .мод.адрес := LYG1
 ,A+X,                                  .СМ += слово по адресу LYG1
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,SEK3A                             .если СМ=0 → SEK3A
 ,UJ,SEK3B                              .переход на SEK3B
C
 SEK3A:,UJ,LYG1B                        .переход на LYG1B
C
C СРАВНЕНИЕ ДЛИНЫ СЕГМЕНТА С МАКСИМАЛЬНОЙ ШИРИНОЙ
 SEK3B:,UTC,*SEK*+3                     .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,LYG2+1                            .мод.адрес := LYG3
 ,A-X,                                  .СМ -= слово по адресу LYG3
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,LYG3A                             .если СМ≠0 → LYG3A
 ,UJ,LYG3B                              .переход на LYG3B
C
 LYG3A:,UJ,LYG1B                        .переход на LYG1B
C
C ПРОВЕРКА ФЛАГА ОБНОВЛЕНИЯ МАКСИМАЛЬНОЙ ШИРИНЫ
 LYG3B:,UTC,LYG2+1                      .мод.адрес := LYG3
 ,XTA,                                  .СМ := слово по адресу LYG3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SEK*+3                           .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,REGIMA                            .если СМ≠0 → REGIMA
 ,UJ,REGIMB                             .переход на REGIMB
C
 REGIMA:,UJ,NDABD                       .переход на NDABD
C
 REGIMB:M7,XTA,                         .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,БЛОК_V0_2                         .если СМ≠0 → F1A
 ,UJ,REGIMD                             .переход на REGIMD
C
 БЛОК_V0_2:M7,XTA,1                     .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,WTC,ЗНАЧЕНИЕ_1                        .мод.адрес := код из V0
 ,XTA,                                  .СМ := слово по адресу V0
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,REGIMC                            .если СМ=0 → REGIMC
 ,UJ,REGIMD                             .переход на REGIMD
C
 REGIMC:,UJ,LYG1B                       .переход на LYG1B
C
 REGIMD:M7,XTA,                         .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,SEK2A                             .если СМ≠0 → SEK2A
 ,UJ,SEK2B                              .переход на SEK2B
C
 SEK2A:,UJ,NDABD                        .переход на NDABD
C
C СРАВНЕНИЕ ВТОРОГО СЕГМЕНТА С МАКСИМАЛЬНОЙ ШИРИНОЙ
 SEK2B:,UTC,*SEK*+2                     .мод.адрес := SEK2
 ,XTA,                                  .СМ := слово по адресу SEK2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,LYG2+3                            .мод.адрес := LYG5
 ,A-X,                                  .СМ -= слово по адресу LYG5
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,LYG5A                             .если СМ≠0 → LYG5A
 ,UJ,LYG5B                              .переход на LYG5B
C
 LYG5A:,UJ,LYG1B                        .переход на LYG1B
C
C ПРОВЕРКА ФЛАГА ОБНОВЛЕНИЯ ШИРИНЫ ПО ВТОРОМУ СЕГМЕНТУ
 LYG5B:,UTC,LYG2+3                      .мод.адрес := LYG5
 ,XTA,                                  .СМ := слово по адресу LYG5
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SEK*+2                           .мод.адрес := SEK2
 ,XTA,                                  .СМ := слово по адресу SEK2
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,БЛОК_V0_3                         .если СМ=0 → F1B
 ,UJ,NDABD                              .переход на NDABD
C
 БЛОК_V0_3:M7,XTA,1                     .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,WTC,ЗНАЧЕНИЕ_1                        .мод.адрес := код из V0
 ,XTA,                                  .СМ := слово по адресу V0
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,NDABC                             .если СМ=0 → NDABC
 ,UJ,NDABD                              .переход на NDABD
C
 NDABC:,UJ,LYG1B                        .переход на LYG1B
C
 NDABD:,UTC,*NDAB*                      .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 ,UTC,*LYG*+1                           .мод.адрес := LYG1
 ,ATX,                                  .по адресу LYG1 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,WTC,ЗНАЧЕНИЕ_1                        .мод.адрес := код из V0
 ,XTA,                                  .СМ := слово по адресу V0
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,LYG1A                             .если СМ=0 → LYG1A
 ,UJ,LYG1B                              .переход на LYG1B
C
 LYG1A:M7,XTA,                          .СМ := слот кадра 0
 ,UTC,*LYG*+1                           .мод.адрес := LYG1
 ,ATX,                                  .по адресу LYG1 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 LYG1B:,UJ,POP                          .переход на POP
C
C ВОЗВРАТ В ОС
 ПЕР_2:M7,MTJ,8                         .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_1                      .М7 := адрес К0
 M7,STX,2                               .ЗП + магазин: 2(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ: ЕДИНИЦА И ДВОЙКА ДЛЯ СРАВНЕНИЯ ДЛИН СЕГМЕНТОВ
C ЗНАЧЕНИЕ 1; ИСПОЛЬЗУЕТСЯ В КОДЕ
 ПАРАМЕТР_1:,INT,1
C ЗНАЧЕНИЕ 2; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 ДВОЙКА:,INT,2
C ПЕРЕМЕННЫЕ: КОД ПЕРЕХОДА ПО ЗАДАЧЕ ПРИ СРАВНЕНИИ МАКСИМАЛЬНОЙ ШИРИНЫ СЕГМЕНТА
 ЗНАЧЕНИЕ_1:,BSS,1
 ,END,
