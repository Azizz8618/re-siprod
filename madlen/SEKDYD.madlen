CSEKDYD - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 11488 образа SIPROD.BIN
CДлина при загрузке: 60 слов, 112 команд
CВход: SEKDYD
CВыход: RASTXT:NDAB1E, SEGTAB:TAB3A, SEKGIR:DYDA,
CF3 (возврат через М12), F3A (возврат через М10)
CВнешние: *SEK*, *LYG*, *DYD*, *REGIM*, I*MU*I
CСмещения в *DYD*: 1, 2
CСмещения в *LYG*: 1, 2
CСмещения в *SEK*: 2, 3
CСмещения в кадре (М7): общие 0-3, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 SEKDYD  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C SEK: ПАРАМЕТРЫ СЕГМЕНТОВ: СЧЁТЧИКИ И ГРАНИЦЫ (4 СЛОВА)
 *SEK*   :,LC,4
C LYG: ПАРАМЕТРЫ ЛИНЕЕК ТАБЛИЦЫ: СЧЁТЧИКИ И ГРАНИЦЫ (6 СЛОВ)
 *LYG*   :,LC,6
C DYD: ПАРАМЕТРЫ ВЫВОДА ДИАГРАММЫ: СЕТКА И ЛИНИИ (3 СЛОВА)
 *DYD*   :,LC,3
C REGIM: ПАРАМЕТРЫ РЕЖИМА НАБОРА: МЕЖСТРОЧНЫЙ ИНТЕРВАЛ, РАЗРЯДКА, ПЕРЕНОС ПО СЛОВАМ, НОМЕРА СТРАНИЦ, РАМКА, ВЫРАЗНИВАНИЕ (16 СЛОВ)
 *REGIM* :,LC,16
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 I*MU*I  :,SUBP,
 M16,VTM,SEK3A                          .М16 := адрес SEK3A
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F3
C
C ВЫБОР ВЕТВИ РАЗБОРА ПО ФЛАГУ LYG2
 SEK3A:M7,XTA,                          .СМ := слот кадра 0
 M7,ATX,3                               .слот кадра 3 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*SEK*+3                           .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*LYG*+2                           .мод.адрес := LYG2
 ,XTA,                                  .СМ := слово по адресу LYG2
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,SEK3B                             .если СМ=0 → SEK3B
 ,UJ,SEK3C                              .переход на SEK3C
C
 SEK3B:,UJ,REGIMB                       .переход на REGIMB
C
 SEK3C:M7,XTA,1                         .СМ := слот кадра 1
 M7,ATX,3                               .слот кадра 3 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*SEK*+3                           .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*LYG*+2                           .мод.адрес := LYG2
 ,XTA,                                  .СМ := слово по адресу LYG2
 M7,A+X,1                               .СМ += слот кадра 1
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,REGIMA                            .если СМ≠0 → REGIMA
 ,UJ,REGIMB                             .переход на REGIMB
C
 REGIMA:M7,XTA,2                        .СМ := слот кадра 2
 M7,ATX,3                               .слот кадра 3 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 REGIMB:M7,XTA,1                        .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,SEK2A                             .если СМ≠0 → SEK2A
 ,UJ,SEK2B                              .переход на SEK2B
C
 SEK2A:,UJ,DYDB                         .переход на DYDB
C
C ПРОВЕРКА ФЛАГА LYG4 ПРИ РАЗБОРЕ СЕГМЕНТА
 SEK2B:,UTC,*SEK*+2                     .мод.адрес := SEK2
 ,XTA,                                  .СМ := слово по адресу SEK2
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*LYG*+4                           .мод.адрес := LYG4
 ,XTA,                                  .СМ := слово по адресу LYG4
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F1
 ,UJ,ВЫЗОВ_IMUI                         .переход на F2
C
 ЦИКЛ_ПЕРЕХОД:,UJ,ВЫЗОВ3_IMUI           .переход на F2B
C
C ВЫЗОВ I*MU*I: РАСЧЁТ ПОЗИЦИИ КОНЦА СЕГМЕНТА
 ВЫЗОВ_IMUI:M7,XTA,2                    .СМ := слот кадра 2
 M16,VTM,ЗНАЧЕНИЕ_1                     .М16 := адрес V0
 M15,VJM,I*MU*I                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,2                               .СМ += слот кадра 2
 ,UTC,*DYD*                             .мод.адрес := DYD
 ,ATX,                                  .по адресу DYD := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*LYG*+4                           .мод.адрес := LYG4
 ,XTA,                                  .СМ := слово по адресу LYG4
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ВЫЗОВ2_IMUI                       .если СМ=0 → F2A
 ,UJ,DYDA                               .переход на DYDA
C
 ВЫЗОВ2_IMUI:M7,XTA,2                   .СМ := слот кадра 2
 M16,VTM,ЗНАЧЕНИЕ_1                     .М16 := адрес V0
 M15,VJM,I*MU*I                         .вызов через М15
 ,UTC,*DYD*                             .мод.адрес := DYD
 ,ATX,                                  .по адресу DYD := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 DYDA:,UJ,DYDC                          .переход на DYDC
C
C ВЫЗОВ I*MU*I: УТОЧНЕНИЕ ПОЗИЦИИ КОНЦА СЕГМЕНТА
 ВЫЗОВ3_IMUI:M7,XTA,2                   .СМ := слот кадра 2
 M16,VTM,ЗНАЧЕНИЕ_1                     .М16 := адрес V0
 M15,VJM,I*MU*I                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*DYD*                             .мод.адрес := DYD
 ,ATX,                                  .по адресу DYD := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,DYDC                               .переход на DYDC
C
 DYDB:M7,XTA,3                          .СМ := слот кадра 3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*DYD*                             .мод.адрес := DYD
 ,ATX,                                  .по адресу DYD := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 DYDC:,UJ,ВОЗВРА2Т_В_БЛОК               .переход на F3A
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_1                      .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРА2Т_В_БЛОК:,STI,                  .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛОВЫЕ КОДЫ ВЕТВЕЙ ОПРЕДЕЛЕНИЯ КОНЦА ТЕКСТОВОГО СЕГМЕНТА
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 ПАРАМЕТР_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 ЕДИНИЦА:,INT,1
C ЗНАЧЕНИЕ 2; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 ДВОЙКА:,INT,2
C ПЕРЕМЕННЫЕ: ЯЧЕЙКА С ПОЗИЦИЕЙ КОНЦА ТЕКСТОВОГО СЕГМЕНТА
 ЗНАЧЕНИЕ_1:,BSS,1
 ,END,
