CENDKOR - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6400 образа SIPROD.BIN
CДлина при загрузке: 54 слов, 90 команд
CВход: ENDKOR
CВыход: APNOTF:F1C, CSTRIN:F8, IPONUM:F4, NAMENF:F1, NOTFOR:INS25A,
CNOTFOR:TYPEA, NOTFOR:F0, NOTFOR:F0A, ONEPLA:L0320, ONEPLA:L0320,
CONEPLA:L0320, ONEPLA:L0320, RASKOM:F1, RASKOM:F20A, SCHEMA:FOPJ,
CSCHEMA:NUSTE, TARNYB:TYPEA, TARNYB:TYPE1A, TARNYB:NOTFE, TARNYB:F1A,
CTWOPLA:F0, TWOPLA:F13A, TWOPLA:F3, TWOPLA:NUM3F, TWOPLA:F13C,
CWRIIPO:IPONUA, WRIIPO:SCANEG, WRIIPO:F11A, WRIKOR:F3A, WRILIN:F7B,
CWRIVER:CENA, F0A (возврат через М12), F0B (возврат через М10)
CЗАКРЫТИЕ БУФЕРА ВЫВОДА.
CВнешние: EGO, KORT, KLAIDA, IMUI
CСмещения в EGO: 7200, 8600, 8601
CСмещения в KORT: 14
CАбсолютные символы: N1 = -1
CСмещения в кадре (М7): общие 0-2, 5-7, 10, вне кадра 2059
CРегистры: М1 (индекс: база модуля), М2 (рабочий регистр),
CМ7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 ENDKOR  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M2:,EQU,2B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *EGO*   :,LC,13401
 *KORT*  :,LC,15
 KLAIDA  :,SUBP,
 I*MU*I  :,SUBP,
 KORT32767:,EQU,*KORT*  -32767
 EGO39967:,EQU,*EGO*+7200-32767
 M16,VTM,KORT1A                         .М16 := адрес KORT1A
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F0A
C
 KORT1A:M7,XTA,                         .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*KORT*+14                         .мод.адрес := KORT14
 ,XTA,                                  .СМ := слово по адресу KORT14
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,EGO860                            .если СМ=0 → EGO860
 ,UJ,EGO86A                             .переход на EGO86A
C
 EGO860:,UJ,KORT3A                      .переход на KORT3A
C
 EGO86A:,UTC,*EGO*+8600                 .мод.адрес := EGO8600
 ,XTA,                                  .СМ := слово по адресу EGO8600
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,2                               .СМ -= слот кадра 2
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ВЫЗОВ_KLAIDA                      .если СМ=0 → F0
 ,UJ,EGO86B                             .переход на EGO86B
C
 ВЫЗОВ_KLAIDA:M16,VTM,КОД_4             .М16 := адрес К4
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,KLAIDA                         .вызов через М15
 EGO86B:,UTC,*EGO*+8600                 .мод.адрес := EGO8600
 ,XTA,                                  .СМ := слово по адресу EGO8600
 M16,VTM,КОД_2                          .М16 := адрес К2
 M15,VJM,I*MU*I                         .вызов через М15
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 M7,ATX,6                               .слот кадра 6 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 KORT32:M7,XTA,5                        .СМ := слот кадра 5
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,6                               .СМ += слот кадра 6
 M7,ATX,7                               .слот кадра 7 := СМ
 ,WTC,ЯЧ_БУФ_1                          .мод.адрес := код из V2
 M1,VTM,                                .М1 := код из V2
 M1,UTC,KORT32767                       .мод.адрес := KORT32767(М1)
 ,XTA,                                  .СМ := слово по адресу KORT32767+М1
 ,WTC,ЯЧ_БУФ_2                          .мод.адрес := код из V3
 M2,VTM,                                .М2 := код из V3
 M2,UTC,EGO39967                        .мод.адрес := EGO39967(М2)
 ,ATX,                                  .по адресу EGO39967+М2 := СМ
 M7,XTA,-1                              .СМ := каталог задачи: элемент 11
 ,WTC,ЯЧ_БУФ_1                          .мод.адрес := код из V2
 M1,VTM,                                .М1 := код из V2
 M1,UTC,KORT32767                       .мод.адрес := KORT32767(М1)
 ,ATX,                                  .по адресу KORT32767+М1 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,6                               .СМ := слот кадра 6
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,6                               .слот кадра 6 := СМ
 M7,X-A,1                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,KORT32                            .если СМ=0 → KORT32
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*KORT*+14                         .мод.адрес := KORT14
 ,ATX,                                  .по адресу KORT14 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*EGO*+8600                        .мод.адрес := EGO8600
 ,XTA,                                  .СМ := слово по адресу EGO8600
 M7,A+X,                                .СМ += слот кадра 0
 ,UTC,*EGO*+8600                        .мод.адрес := EGO8600
 ,ATX,                                  .по адресу EGO8600 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 KORT3A:,UJ,ВОЗВРА2Т_В_БЛОК             .переход на F0B
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,2                                 .в магазин; СМ := М2
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРА2Т_В_БЛОК:,STI,                  .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,2                                 .М2 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: ПРОБЕЛЫ ДЛЯ ЗАПОЛНЕНИЯ БУФЕРА ВЫВОДА ПРИ ЕГО ЗАКРЫТИИ
 МАСКА_ПРОБЕЛОВ:,ISO,6H       .. 040 040 040 040 040 040
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ: СМЕЩЕНИЕ 14 В БЛОКЕ KORT И КОД ОШИБКИ 101
C ЗНАЧЕНИЕ 1; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,1
C ЗНАЧЕНИЕ 14; ПЕРЕДАЁТСЯ В I*MU*I
 КОД_2:,INT,14
C ЗНАЧЕНИЕ 100; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_3:,INT,100
C ЗНАЧЕНИЕ 101; ПАРАМЕТР ВЫЗОВА KLAIDA
 КОД_4:,INT,101
C ПЕРЕМЕННЫЕ МОДУЛЯ, В КОДЕ НЕ ИСПОЛЬЗУЮТСЯ
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ ЗАКРЫТИЯ БУФЕРА: ИНДЕКС ПОЗИЦИИ ВЫВОДА И ЭЛЕМЕНТА EGO
 НЕИСПОЛЬЗУЕМЫЕ_ПОЛЯ:,BSS,2
 ЯЧ_БУФ_1:,BSS,1
 ЯЧ_БУФ_2:,BSS,1
 ,END,
