C
 TABK:,UTC,*TAB*                        .мод.адрес := TAB
 ,XTA,                                  .СМ := слово по адресу TAB
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*NRD*+24                          .мод.адрес := NRD24
 ,A-X,                                  .СМ -= слово по адресу NRD24
 M7,A+X,2                               .СМ += слот кадра 2
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,SUT1A                             .если СМ≠0 → SUT1A
 ,UJ,SUT1B                              .переход на SUT1B
C
 SUT1A:,UJ,TABC                         .переход на TABC
C
 SUT1B:M7,XTA,                          .СМ := слот кадра 0
 ,UTC,*SUT*+1                           .мод.адрес := SUT1
 ,ATX,                                  .по адресу SUT1 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*SUT*                             .мод.адрес := SUT
 ,ATX,                                  .по адресу SUT := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C СОХРАНЕНИЕ ГРАНИЦ ТАБЛИЦЫ И ГИРЛЯНДЫ ПЕРЕД ВЫХОДОМ
 SUT1C:M7,XTA,20B                       .СМ := слот кадра 16
 ,UTC,*TAB*                             .мод.адрес := TAB
 ,ATX,                                  .по адресу TAB := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,15B                             .СМ := слот кадра 13
 ,UTC,*LYG*+2                           .мод.адрес := LYG2
 ,ATX,                                  .по адресу LYG2 := СМ
 M7,XTA,16B                             .СМ := слот кадра 14
 ,UTC,LYG2+2                            .мод.адрес := LYG4
 ,ATX,                                  .по адресу LYG4 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_ГИРЛЯНДЫ               .М7 := адрес К2
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
  МАСКА_ПРОБЕЛОВ:,ISO,6H       ... 040 040 040 040 040 040
 МАСКА_ТИРЕ:,ISO,6H------ ... 055 055 055 055 055 055
 ПАРАМЕТР_ГИРЛЯНДЫ:,LOG,0
 НОЛЬ:,INT,0
 ЕДИНИЦА:,INT,1
 ДВОЙКА:,INT,2
 ТРОЙКА:,INT,3
 ЧЕТЫРЬ:,INT,4
 ПАРАМЕТР_ГИРЛЯНДЫ+1:,INT,6
 ДЕСЯТЬ:,INT,10
 ДВАДЦАТЬ_ОДИН:,INT,21
 ПАРАМЕТР_ГИРЛЯНДЫ+2:,INT,22
 ДВАДЦАТЬ_ЧЕТЫРЕ:,INT,24
 ШЕСТЬДЕСЯТ_ЧЕТЫРЕ:,INT,64
 V0:,BSS,1
 V1:,BSS,1
 V2:,BSS,1
 V3:,BSS,1
 V4:,BSS,1
 V5:,BSS,1
 V6:,BSS,1
 V7:,BSS,1
 V8:,BSS,1
 V9:,BSS,1
 ЗНАЧЕНИЕ_ГИРЛЯНДЫ+1:,BSS,3
 ,END,
