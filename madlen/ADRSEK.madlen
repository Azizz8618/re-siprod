CADRSEK - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 18656 образа SIPROD.BIN
CДлина при загрузке: 68 слов, 118 команд
CВход: ADRSEK
CВыход: SEKGIR:F9, SEKGIR:F9A, F4 (возврат через М12),
CF4A (возврат через М10)
CВнешние: LYG, ADR, TAB, NRD, PAGE, NDAB, REGIM, NDABL, RSYMB, IMUI
CСмещения в ADR: 1, 2, 3
CСмещения в LYG: 1, 2
CСмещения в NDAB: 1
CСмещения в NDABL: 1
CСмещения в NRD: 24
CСмещения в PAGE: 1
CСмещения в TAB: 1, 2, 3, 4
CСмещения в кадре (М7): общие 0-1, 3-8, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 ADRSEK  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *LYG*   :,LC,6
 *ADR*   :,LC,4
 *TAB*   :,LC,5
 *NRD*   :,LC,25
 *PAGE*  :,LC,6
 *NDAB*  :,LC,4
 *REGIM* :,LC,16
 *NDABL* :,LC,2
 RSYMB   :,SUBP,
 I*MU*I  :,SUBP,
 M16,VTM,ADR2A                          .М16 := адрес ADR2A
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F4
C
 ADR2A:M7,XTA,                          .СМ := слот кадра 0
 ,UTC,*ADR*+2                           .мод.адрес := ADR2
 ,ATX,                                  .по адресу ADR2 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*ADR*+3                           .мод.адрес := ADR3
 ,ATX,                                  .по адресу ADR3 := СМ
 ,UTC,*TAB*                             .мод.адрес := TAB
 ,XTA,                                  .СМ := слово по адресу TAB
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,6                               .слот кадра 6 := СМ
 M16,VTM,*NRD*                          .М16 := адрес NRD
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*TAB*                          .М16 := адрес TAB
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*ADR*+2                        .М16 := адрес ADR2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ГРАН_АДР                       .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,RSYMB                          .вызов через М15
 M16,VTM,*NRD*                          .М16 := адрес NRD
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_АДР                         .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*ADR*+3                        .М16 := адрес ADR3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ГРАН_АДР                       .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*ADR*+2                           .мод.адрес := ADR2
 ,XTA,                                  .СМ := слово по адресу ADR2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*PAGE*                            .мод.адрес := PAGE
 ,A+X,                                  .СМ += слово по адресу PAGE
 ,UTC,*ADR*+2                           .мод.адрес := ADR2
 ,ATX,                                  .по адресу ADR2 := СМ
 ,UTC,*ADR*+3                           .мод.адрес := ADR3
 ,XTA,                                  .СМ := слово по адресу ADR3
 ,UTC,*PAGE*                            .мод.адрес := PAGE
 ,A+X,                                  .СМ += слово по адресу PAGE
 ,UTC,*ADR*+3                           .мод.адрес := ADR3
 ,ATX,                                  .по адресу ADR3 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,LYG4A                             .если СМ≠0 → LYG4A
 ,UJ,LYG4B                              .переход на LYG4B
C
 LYG4A:,UJ,ADR2D                        .переход на ADR2D
C
 LYG4B:M7,XTA,                          .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,LYG2+2                            .мод.адрес := LYG4
 ,XTA,                                  .СМ := слово по адресу LYG4
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ADR2B                             .если СМ=0 → ADR2B
 ,UJ,ADR2C                              .переход на ADR2C
C
 ADR2B:,UJ,ADR2D                        .переход на ADR2D
C
 ADR2C:,UTC,*ADR*+2                     .мод.адрес := ADR2
 ,XTA,                                  .СМ := слово по адресу ADR2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,5                               .СМ += слот кадра 5
 ,UTC,*ADR*+2                           .мод.адрес := ADR2
 ,ATX,                                  .по адресу ADR2 := СМ
 ,UTC,*ADR*+3                           .мод.адрес := ADR3
 ,XTA,                                  .СМ := слово по адресу ADR3
 M7,A+X,5                               .СМ += слот кадра 5
 ,UTC,*ADR*+3                           .мод.адрес := ADR3
 ,ATX,                                  .по адресу ADR3 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ADR2D:,UTC,*LYG*                       .мод.адрес := LYG
 ,XTA,                                  .СМ := слово по адресу LYG
 M7,ATX,7                               .слот кадра 7 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*NDAB*                            .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 M7,ATX,10B                             .слот кадра 8 := СМ
 M7,XTA,4                               .СМ := слот кадра 4
 M16,VTM,ЯЧ_АДР+1                       .М16 := адрес V1
 M15,VJM,I*MU*I                         .вызов через М15
 M7,A-X,3                               .СМ -= слот кадра 3
 ,UTC,*ADR*                             .мод.адрес := ADR
 ,ATX,                                  .по адресу ADR := СМ
 M7,XTA,4                               .СМ := слот кадра 4
 M16,VTM,ЯЧ_АДР+2                       .М16 := адрес V2
 M15,VJM,I*MU*I                         .вызов через М15
 M7,A-X,3                               .СМ -= слот кадра 3
 ,UTC,*ADR*+1                           .мод.адрес := ADR1
 ,ATX,                                  .по адресу ADR1 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВОЗВРАТ_В_БЛОК                     .переход на F4A
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,СЧЁТ_0_1                        .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛА РАСЧЁТА АДРЕСА ЭЛЕМЕНТА СЕКЦИИ: 6, 21, 22 И ШИРИНА СТРАНИЦЫ 64
C ЧИСЛА: ЧИСЛА РАСЧЁТА АДРЕСА ЭЛЕМЕНТА СЕКЦИИ: 6, 21, 22 И ШИРИНА СТРАНИЦЫ 64
 КОД_1:,INT,0
 КОД_2:,INT,1
 КОД_3:,INT,6
 КОД_4:,INT,21
 КОД_5:,INT,22
 КОД_6:,INT,64
C ПЕРЕМЕННЫЕ: БУФЕР СИМВОЛА И ДВА БУФЕРА ИЗОБРАЖЕНИЯ ВЫЧИСЛЕННОГО ЧИСЛА
 ЯЧ_АДР:,BSS,3
 ,END,
