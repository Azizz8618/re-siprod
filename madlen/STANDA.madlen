CSTANDA - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 21472 образа SIPROD.BIN
CДлина при загрузке: 90 слов, 146 команд
CВход: STANDA
CВыход: STAATP:F10, F5B (возврат через М12), POP (возврат через М10)
CВнешние: *STAND*, *FORMA*, *PAGE*, *REGIM*, *LOL*, *NUST*, *NDAB*, *ARPI*, BEGPG,
CENDPG, I*DI*I, I*MU*I
CСмещения в *FORMA*: 7
CСмещения в *LOL*: 7
CСмещения в *NDAB*: 1, 2
CСмещения в *STAND*: 1, 2
CСмещения в кадре (М7): общие 0-1, 3-8, 10
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес),
CМ17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 STANDA  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C *STAND*: ПАРАМЕТРЫ ФОРМАТА СТРАНИЦЫ: ПОЛЯ И ЛИНИЕЙКИ (6 СЛОВ)
 *STAND* :,LC,6
C *FORMA*: ФАКТИЧЕСКИЙ ФОРМАТ: ПАРАМЕТРЫ ОФОРМЛЕНИЯ (16 СЛОВ)
 *FORMA* :,LC,16
C *PAGE*: ПАРАМЕТРЫ СТРАНИЦЫ: НОМЕР, ПОЛОСА (6 СЛОВ)
 *PAGE*  :,LC,6
C *REGIM*: ПАРАМЕТРЫ РЕЖИМА НАБОРА: МЕЖСТРОЧНЫЙ ИНТЕРВАЛ, РАЗРЯДКА, ПЕРЕНОС ПО СЛОВАМ, НОМЕРА СТРАНИЦ, РАМКА, ВЫРАЗНИВАНИЕ (16 СЛОВ)
 *REGIM* :,LC,16
C *LOL*: ОБЩАЯ ОБЛАСТЬ ПАМЯТИ (16 СЛОВ)
 *LOL*   :,LC,16
C *NUST*: СОСТОЯНИЕ ВХОДНОГО ПОТОКА: РЕЖИМ РАЗБОРА (10 СЛОВ)
 *NUST*  :,LC,10
C *NDAB*: СЧЁТЧИКИ ВХОДНЫХ ДАННЫХ: НОМЕР И ДЛИНА (4 СЛОВА)
 *NDAB*  :,LC,4
C *ARPI*: ОБЩАЯ ОБЛАСТЬ ПАМЯТИ (1 СЛОВО)
 *ARPI*  :,LC,1
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 BEGPG   :,SUBP,
 ENDPG   :,SUBP,
 I*DI*I  :,SUBP,
 I*MU*I  :,SUBP,
C КОНСТАНТЫ: СМЕЩЕНИЯ В ОБЩИХ ОБЛАСТЯХ И ДРУГИЕ КОНСТАНТЫ
C КОНСТАНТА, ВЫРАЖЕНИЕ: *PAGE*  -32767
 PAGE32767:,EQU,*PAGE*  -32767
C КОНСТАНТА, ВЫРАЖЕНИЕ: *LOL*   -32767
 LOL32767:,EQU,*LOL*   -32767
C КОНСТАНТА, ВЫРАЖЕНИЕ: *FORMA* -32767
 FORMA32767:,EQU,*FORMA* -32767
 M16,VTM,ARPIA                          .М16 := адрес ARPIA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F5B
C
 ARPIA:M7,XTA,5                         .СМ := слот кадра 5
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*ARPI*                            .мод.адрес := ARPI
 ,XTA,                                  .СМ := слово по адресу ARPI
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,STANDB                            .если СМ=0 → STANDB
 ,UJ,STANDC                             .переход на STANDC
C
 STANDB:,UJ,STANDD                      .переход на STANDD
C
 STANDC:,UTC,*STAND*+1                  .мод.адрес := STAND1
 ,XTA,                                  .СМ := слово по адресу STAND1
 M7,ATX,6                               .слот кадра 6 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*STAND*+1                         .мод.адрес := STAND1
 ,ATX,                                  .по адресу STAND1 := СМ
 ,UTC,*NDAB*+1                          .мод.адрес := NDAB1
 ,XTA,                                  .СМ := слово по адресу NDAB1
 M16,VTM,КОД_3                          .М16 := адрес К2
 M15,VJM,I*DI*I                         .вызов через М15
 M7,ATX,7                               .слот кадра 7 := СМ
 ,UTC,*NDAB*+1                          .мод.адрес := NDAB1
 ,XTA,                                  .СМ := слово по адресу NDAB1
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,7                               .СМ := слот кадра 7
 M16,VTM,КОД_3                          .М16 := адрес К2
 M15,VJM,I*MU*I                         .вызов через М15
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F5
  :7,XTA,5                              .СМ := слот кадра 5
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F5
 ,UJ,ENDPGA                             .переход на ENDPGA
C
 ЦИКЛ_ПЕРЕХОД:,UJ,ENDPGB                .переход на ENDPGB
C
 ENDPGA:M15,VJM,ENDPG                   .вызов через М15
 M15,VJM,BEGPG                          .вызов через М15
 ENDPGB:M15,VJM,ENDPG                   .вызов через М15
 M7,XTA,6                               .СМ := слот кадра 6
 ,UTC,*STAND*+1                         .мод.адрес := STAND1
 ,ATX,                                  .по адресу STAND1 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 STANDD:M7,XTA,1                        .СМ := слот кадра 1
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 STANDE:,WTC,КОД_9                      .мод.адрес := код из V2
 M1,VTM,                                .М1 := код из V2
 M1,UTC,КОД_11                          .мод.адрес := V4(М1)
 ,XTA,                                  .СМ := слово по адресу V4+М1
 M1,UTC,PAGE32767                       .мод.адрес := PAGE32767(М1)
 ,ATX,                                  .по адресу PAGE32767+М1 := СМ
 M7,XTA,10B                             .СМ := слот кадра 8
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,10B                             .слот кадра 8 := СМ
 M7,X-A,3                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,STANDE                            .если СМ=0 → STANDE
 M7,XTA,1                               .СМ := слот кадра 1
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 STANDF:,WTC,КОД_9                      .мод.адрес := код из V2
 M1,VTM,                                .М1 := код из V2
 M1,UTC,КОД_9                           .мод.адрес := V2(М1)
 ,XTA,                                  .СМ := слово по адресу V2+М1
 M1,UTC,LOL32767                        .мод.адрес := LOL32767(М1)
 ,ATX,                                  .по адресу LOL32767+М1 := СМ
 ,WTC,КОД_9                             .мод.адрес := код из V2
 M1,VTM,                                .М1 := код из V2
 M1,UTC,КОД_9                           .мод.адрес := V2(М1)
 ,XTA,                                  .СМ := слово по адресу V2+М1
 M1,UTC,FORMA32767                      .мод.адрес := FORMA32767(М1)
 ,ATX,                                  .по адресу FORMA32767+М1 := СМ
 M1,UTC,КОД_9                           .мод.адрес := V2(М1)
 ,XTA,                                  .СМ := слово по адресу V2+М1
 M1,UTC,*LOL*+7                         .мод.адрес := LOL7(М1)
 ,ATX,                                  .по адресу LOL7+М1 := СМ
 M1,UTC,КОД_9                           .мод.адрес := V2(М1)
 ,XTA,                                  .СМ := слово по адресу V2+М1
 M1,UTC,*FORMA*+7                       .мод.адрес := FORMA7(М1)
 ,ATX,                                  .по адресу FORMA7+М1 := СМ
 M7,XTA,10B                             .СМ := слот кадра 8
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,10B                             .слот кадра 8 := СМ
 M7,X-A,4                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,STANDF                            .если СМ=0 → STANDF
 M7,XTA,5                               .СМ := слот кадра 5
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,ATX,                                  .по адресу REGIM := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,5                               .СМ := слот кадра 5
 ,UTC,*NUST*                            .мод.адрес := NUST
 ,ATX,                                  .по адресу NUST := СМ
 M7,XTA,5                               .СМ := слот кадра 5
 ,UTC,*STAND*                           .мод.адрес := STAND
 ,ATX,                                  .по адресу STAND := СМ
 M7,XTA,5                               .СМ := слот кадра 5
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*ARPI*                            .мод.адрес := ARPI
 ,XTA,                                  .СМ := слово по адресу ARPI
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,BEGPGA                            .если СМ≠0 → BEGPGA
 ,UJ,ЦИКЛ2_ПЕРЕХОД                      .переход на F5A
C
 BEGPGA:M15,VJM,BEGPG                   .вызов через М15
 ЦИКЛ2_ПЕРЕХОД:,UJ,POP                  .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: СМЕЩЕНИЯ ПАРАМЕТРОВ ФОРМАТА А И ШТАМПА В БЛОКЕ *STAND*: 2, 6, 8, 10
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 2; ПЕРЕДАЁТСЯ В I*DI*I; ПЕРЕДАЁТСЯ В I*MU*I
 КОД_3:,INT,2
C ЗНАЧЕНИЕ 6; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_4:,INT,6
C ЗНАЧЕНИЕ 8; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_5:,INT,8
C ЗНАЧЕНИЕ 10; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_6:,INT,10
C БУФЕР СТАНДАРТНОГО ФОРМАТА ВЫВОДА
C ПЕРЕМЕННЫЕ: БУФЕР СТАНДАРТНОГО ФОРМАТА ВЫВОДА
 БУФЕР_СТАНДАРТНОГО_ФОРМА:,BSS,11
C ОБЛАСТЬ КАДРА: КОНСТАНТЫ, ЗАДАВАЕМЫЕ В ЯЧЕЙКИ КАДРА, И КОМАНДЫ РАЗБОРА
 ,DATA,
C ЗНАЧЕНИЕ 84; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_7:,INT,84
C ЗНАЧЕНИЕ 70; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_8:,INT,70
C ЗНАЧЕНИЕ 11; СМЕЩЕНИЕ В ОБЩЕЙ ОБЛАСТИ (МОДИФИКАТОР АДРЕСА) - 3 ССЫЛ.; ИСПОЛЬЗУЕТСЯ В КОД
 КОД_9:,INT,11
C ЗНАЧЕНИЕ 67; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_10:,INT,67
C ЗНАЧЕНИЕ 6; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_11:,INT,6
C ЗНАЧЕНИЕ 6; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_12:,INT,6
C ЗНАЧЕНИЕ 60; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_13:,INT,60
C ЗНАЧЕНИЕ 4; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_14:,INT,4
 M10,SET,КОД_7
 M1,   ,КОД_10
 ,END,
