CSCAKOD - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 19680 образа SIPROD.BIN
CДлина при загрузке: 82 слов, 130 команд
CВход: SCAKOD
CВыход: KODKOD:L0074, REGA (возврат через М14), F14 (возврат через М15),
CREGB (возврат через М15), L0160 (возврат через М12),
CF11A (возврат через М10)
CВнешние: NEW, REG, IMA, IMUI, IDII, IPOI
CСмещения в IMA: 32762
CАбсолютные символы: N1 = -1
CСмещения в кадре (М7): общие 0-4, 6, 8-10, свои 11-15, вне кадра 2057
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ14 (смещение в буфере), М15 (адрес возврата),
CМ16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 SCAKOD  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M14:,EQU,14B
 M15:,EQU,15B
 M16:,EQU,16B
 *NEW*   :,LC,1
 *REG*   :,LC,1
 *IMA*   :,LC,180
 I*MUI*  :,SUBP,
 I*DI*I  :,SUBP,
 I*MU*I  :,SUBP,
 IMA32762:,EQU,*IMA*   -32762
 I*PO*I  :,SUBP,
 M16,VTM,NEWA                           .М16 := адрес NEWA
 ,UJ,ЗАВЕРШЕНИЕ_МОДУЛЯ                  .переход на L0160
C
C РАСЧЁТ НАЧАЛА КОДА И ЧТЕНИЕ ПЕРВОГО СИМВОЛА
 NEWA:,UTC,*NEW*                        .мод.адрес := NEW
 ,XTA,                                  .СМ := слово по адресу NEW
 M16,VTM,КОД_7                          .М16 := адрес К6
 M15,VJM,I*DI*I                         .вызов через М15
 M7,ATX,11B                             .слот кадра 9 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,11B                             .СМ := слот кадра 9
 ,X-A,                                  .СМ := (адрес) - СМ
 M16,VTM,КОД_7                          .М16 := адрес К6
 M15,VJM,I*MU*I                         .вызов через М15
 ,UTC,*NEW*                             .мод.адрес := NEW
 ,A+X,                                  .СМ += слово по адресу NEW
 M7,ATX,12B                             .слот кадра 10 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 M16,VTM,ЧЕТВЕРТЫЙ_ПАРАМ_ВЫЗОВА         .М16 := адрес V1
 M15,VJM,I*MU*I                         .вызов через М15
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,13B                             .слот кадра 11 := СМ
 M15,VJM,ВЫВОД_СИМВОЛА_КОДА             .вызов через М15
 M7,XTA,12B                             .СМ := слот кадра 10
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,2                               .СМ += слот кадра 2
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ПЕРЕХОД_К_РАЗБОРУ_КОДА            .если СМ=0 → F10
 ,UJ,ВЫЗОВ_ВЫВОДА_СИМВОЛА               .переход на F11
C
 ПЕРЕХОД_К_РАЗБОРУ_КОДА:,UJ,IMA327      .переход на IMA327
C
 ВЫЗОВ_ВЫВОДА_СИМВОЛА:M7,XTA,13B        .СМ := слот кадра 11
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,13B                             .слот кадра 11 := СМ
 M15,VJM,ВЫВОД_СИМВОЛА_КОДА             .вызов через М15
 M7,XTA,12B                             .СМ := слот кадра 10
 M7,A-X,3                               .СМ -= слот кадра 3
 M7,ATX,12B                             .слот кадра 10 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ВЫБОР ЭЛЕМЕНТА ТАБЛИЦЫ IMA И СДВИГ ПО КОДУ
 IMA327:,WTC,КОД_1                      .мод.адрес := код из К0
 M1,VTM,                                .М1 := код из К0
 M1,UTC,IMA32762                        .мод.адрес := IMA32762(М1)
 ,XTA,                                  .СМ := слово по адресу IMA32762+М1
 M7,ATX,14B                             .слот кадра 12 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,3                               .СМ := слот кадра 3
 M7,A-X,12B                             .СМ -= слот кадра 10
 M7,ATX,10B                             .слот кадра 8 := СМ
 M7,XTA,6                               .СМ := слот кадра 6
 M16,VTM,ПАРАМЕТР_ВЫЗОВА                .М16 := адрес V0
 M15,VJM,I*MU*I                         .вызов через М15
 M7,ATX,10B                             .слот кадра 8 := СМ
 M16,VTM,КОД_3                          .М16 := адрес К2
 ,ITA,14                                .СМ := М16
 M16,VTM,ПАРАМЕТР_ВЫЗОВА                .М16 := адрес V0
 M15,VJM,I*PO*I                         .вызов через М15
 M7,ATX,15B                             .слот кадра 13 := СМ
 M7,XTA,14B                             .СМ := слот кадра 12
 M16,VTM,ПЯТЫЙ_ПАРАМ_ВЫЗОВА             .М16 := адрес V5
 M15,VJM,I*DI*I                         .вызов через М15
 ,UTC,*NEW*                             .мод.адрес := NEW
 ,ATX,                                  .по адресу NEW := СМ
 ,UTC,*NEW*                             .мод.адрес := NEW
 ,XTA,                                  .СМ := слово по адресу NEW
 ,X-A,                                  .СМ := (адрес) - СМ
 M16,VTM,ПЯТЫЙ_ПАРАМ_ВЫЗОВА             .М16 := адрес V5
 M15,VJM,I*MU*I                         .вызов через М15
 M7,A+X,14B                             .СМ += слот кадра 12
 ,UTC,*NEW*                             .мод.адрес := NEW
 ,ATX,                                  .по адресу NEW := СМ
 M7,XTA,15B                             .СМ := слот кадра 13
 M16,VTM,КОД_9                          .М16 := адрес К8
 M15,VJM,I*DI*I                         .вызов через М15
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,UTC,*NEW*                             .мод.адрес := NEW
 ,XTA,                                  .СМ := слово по адресу NEW
 M16,VTM,ПАРАМЕТР_ВЫЗОВА                .М16 := адрес V0
 M15,VJM,I*DI*I                         .вызов через М15
 ,UTC,*NEW*                             .мод.адрес := NEW
 ,ATX,                                  .по адресу NEW := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВОССТАНОВЛЕНИЕ_КАДРА               .переход на F11A
C
C ЧТЕНИЕ КОДА ИЗ ТАБЛИЦЫ REG
 REGA:M15,MTJ,12                        .М14 := М15
 ,UTC,*REG*                             .мод.адрес := REG
 ,XTA,                                  .СМ := слово по адресу REG
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M15,VJM,REGB                           .вызов через М15
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M14,UJ,                                .переход через М14
C
 ВЫВОД_СИМВОЛА_КОДА:M7,A-X,16B          .СМ -= слот кадра 14
 M7,ATX,16B                             .слот кадра 14 := СМ
 M7,XTS,4                               .магазин + СЧ: 4(М7)
 M16,VJM,I*MUI*                         .вызов через М16
 M7,A+X,-1                              .СМ += каталог задачи: элемент 9
 M7,ATX,-1                              .каталог задачи: элемент 9 := СМ
 M7,XTA,13B                             .СМ := слот кадра 11
 M7,ATX,16B                             .слот кадра 14 := СМ
 M15,UJ,                                .переход через М15
C
C ЗАПИСЬ ПРОЧИТАННОГО КОДА В БУФЕР И ВОЗВРАТ
 REGB:M7,A-X,17B                        .СМ -= слот кадра 15
 M7,ATX,17B                             .слот кадра 15 := СМ
 M7,A+X,-1                              .СМ += каталог задачи: элемент 9
 M7,ATX,-1                              .каталог задачи: элемент 9 := СМ
 ,UTC,*REG*                             .мод.адрес := REG
 ,XTA,                                  .СМ := слово по адресу REG
 M7,ATX,17B                             .слот кадра 15 := СМ
 M15,UJ,                                .переход через М15
C
 ЗАВЕРШЕНИЕ_МОДУЛЯ:M7,MTJ,8             .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_2                           .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 M15,VJM,REGA                           .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 ВОССТАНОВЛЕНИЕ_КАДРА:,STI,             .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: КОДЫ РАЗРЯДОВ ТАБЛИЦЫ КОДОВ И РАЗМЕР БУФЕРА СКАНИРОВАНИЯ (1024)
 КОД_1:,INT,0
 КОД_2:,INT,1
 КОД_3:,INT,2
 КОД_4:,INT,3
 КОД_5:,INT,4
 КОД_6:,INT,5
 КОД_7:,INT,8
 КОД_8:,INT,10
 КОД_9:,INT,1024
C ПЕРЕМЕННЫЕ: БУФЕР СКАНИРУЕМОГО КОДА И СЧЁТЧИКИ ПОЗИЦИЙ В ТАБЛИЦЕ КОДОВ
 ПАРАМЕТР_ВЫЗОВА:,BSS,1
 ЧЕТВЕРТЫЙ_ПАРАМ_ВЫЗОВА:,BSS,4
 ПЯТЫЙ_ПАРАМ_ВЫЗОВА:,BSS,3
 ,END,
