CTAMPYK - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 18912 образа SIPROD.BIN
CДлина при загрузке: 53 слов, 94 команд
CВход: TAMPYK
CВыход: DOUBLE:NDAB1A, F0B (возврат через М12), F0C (возврат через М10)
CРАЗБОР ТАБЛИЧНОГО РАЗДЕЛА ПУСКОВ.
CВнешние: REGIM, SCANER, STR, INS, BEN, DDR, TAMTXT, TARPOZ, RSYMB,
CSCAN
CСмещения в BEN: 2, 14
CСмещения в INS: 24, 25
CСмещения в SCANER: 1, 2
CСмещения в STR: 24, 25, 26
CАбсолютные символы: N1 = -1
CСмещения в кадре (М7): общие 0-4, 10, вне кадра 2067
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 TAMPYK  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *REGIM* :,LC,16
 *SCANER*:,LC,3
 *STR*   :,LC,27
 *INS*   :,LC,27
 *BEN*   :,LC,15
 *DDR*   :,LC,1
 TAMTXT  :,SUBP,
 TARPOZ  :,SUBP,
 RSYMB   :,SUBP,
 SCAN    :,SUBP,
 M16,VTM,BEN14A                         .М16 := адрес BEN14A
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F0B
C
C ЧТЕНИЕ СТРОКИ РАЗДЕЛА ПУСКОВ И ПРОВЕРКА ЕЕ ПРИЗНАКА
 BEN14A:M7,XTA,                         .СМ := слот кадра 0
 ,UTC,*BEN*+14                          .мод.адрес := BEN14
 ,ATX,                                  .по адресу BEN14 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,-1                              .СМ := каталог задачи: элемент 19
 M7,ATX,3                               .слот кадра 3 := СМ
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 M7,ATX,4                               .слот кадра 4 := СМ
 ,UTC,*DDR*                             .мод.адрес := DDR
 ,XTA,                                  .СМ := слово по адресу DDR
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,SCAN                           .вызов через М15
 M7,XTA,4                               .СМ := слот кадра 4
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,2                               .СМ := слот кадра 2
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,BEN14B                            .если СМ=0 → BEN14B
 ,UJ,BEN14C                             .переход на BEN14C
C
 BEN14B:M7,XTA,-1                       .СМ := каталог задачи: элемент 19
 ,UTC,*BEN*+14                          .мод.адрес := BEN14
 ,ATX,                                  .по адресу BEN14 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ЗАПИСЬ СИМВОЛА В ТЕКСТ И ПРОВЕРКА ПРИЗНАКА РАЗДЕЛА
 BEN14C:M16,VTM,*STR*                   .М16 := адрес STR
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*STR*+26                       .М16 := адрес STR26
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ_ПУСКА_1               .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ПАРАМЕТР_ПУСКА+1               .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,-1                              .СМ := каталог задачи: элемент 19
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,3                               .СМ := слот кадра 3
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,BEN14D                            .если СМ≠0 → BEN14D
 ,UJ,TARPOA                             .переход на TARPOA
C
 BEN14D:M7,XTA,-1                       .СМ := каталог задачи: элемент 19
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*BEN*+14                          .мод.адрес := BEN14
 ,XTA,                                  .СМ := слово по адресу BEN14
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F3
 ,UJ,TARPOA                             .переход на TARPOA
C
 ЦИКЛ_ПЕРЕХОД:,UJ,ЦИКЛ_ПЕРЕХОД+3        .переход на F0A
C
 TARPOA:M15,VJM,TARPOZ                  .вызов через М15
 M7,XTA,                                .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*BEN*+2                           .мод.адрес := BEN2
 ,XTA,                                  .СМ := слово по адресу BEN2
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ_ПЕРЕХОД+2                    .если СМ=0 → F0
 ,UJ,TAMTXA                             .переход на TAMTXA
C
 ЦИКЛ_ПЕРЕХОД+2:,UJ,ЦИКЛ_ПЕРЕХОД+3      .переход на F0A
C
 TAMTXA:M15,VJM,TAMTXT                  .вызов через М15
 ЦИКЛ_ПЕРЕХОД+3:,UJ,ВОЗВРАТ_В_БЛОК      .переход на F0C
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_ПУСКА                  .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
 МАСКА_ПРОБЕЛОВ:,ISO,6H       ... 040 040 040 040 040 040
 ПАРАМЕТР_ПУСКА:,INT,0
 ПАРАМЕТР_ПУСКА+1:,INT,6
 ВОСЕМЬ:,INT,8
 ЗНАЧЕНИЕ_ПУСКА_1:,BSS,2
 ,END,
