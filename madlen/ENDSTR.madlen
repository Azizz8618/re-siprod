CENDSTR - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 12032 образа SIPROD.BIN
CДлина при загрузке: 22 слов, 42 команд
CВход: ENDSTR
CВыход: BEGPG:STR25A, DOUBLE:BEGSTA, DOUBLE:BEGSTB, FILL:BEGSTA,
CHEADIN:F2, HEADIN:F1, NEWSTR:BEGSTA, RASTXT:BEGSTA, SEGTAB:F3,
CSEGTAB:BEGSTA, SPAUD:BEGSTA, SPAUD:BEGSTB, SPAUD:BEGSTC, SPAUD:BEGSTD,
CTITLE:STR26A, TITLE:MEDIUD, TITLE:F15B, L0034 (возврат через М12),
CPOP (возврат через М10)
CКОНЕЦ ТЕКСТОВОЙ СТРОКИ.
CВнешние: *NDAB*, *PAGE*, *REGIM*, TOPAGE, BEGPG, ENDPG
CСмещения в *NDAB*: 1
CСмещения в *PAGE*: 1, 2, 3, 4, 5
CСмещения в *REGIM*: 1
CСмещения в кадре (М7): общие 0, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 ENDSTR  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C NDAB: СЧЁТЧИКИ ВХОДНЫХ ДАННЫХ: НОМЕР И ДЛИНА (4 СЛОВА)
 *NDAB*  :,LC,4
C PAGE: ПАРАМЕТРЫ СТРАНИЦЫ: НОМЕР, ПОЛОСА (6 СЛОВ)
 *PAGE*  :,LC,6
C REGIM: ПАРАМЕТРЫ РЕЖИМА НАБОРА: МЕЖСТРОЧНЫЙ ИНТЕРВАЛ, РАЗРЯДКА, ПЕРЕНОС ПО СЛОВАМ, НОМЕРА СТРАНИЦ, РАМКА, ВЫРАЗНИВАНИЕ (16 СЛОВ)
 *REGIM* :,LC,16
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 TOPAGE  :,SUBP,
 BEGPG   :,SUBP,
 ENDPG   :,SUBP,
 M16,VTM,NDABA                          .М16 := адрес NDABA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на L0034
C
 NDABA:,UTC,*NDAB*                      .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*PAGE*+3                          .мод.адрес := PAGE3
 ,A-X,                                  .СМ -= слово по адресу PAGE3
 ,UTC,*PAGE*+4                          .мод.адрес := PAGE4
 ,A-X,                                  .СМ -= слово по адресу PAGE4
 ,UTC,*REGIM*+1                         .мод.адрес := REGIM1
 ,A+X,                                  .СМ += слово по адресу REGIM1
 M7,A-X,                                .СМ -= слот кадра 0
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,JMP                               .если СМ≠0 → JMP
 ,UJ,ENDPGA                             .переход на ENDPGA
C
 JMP:,UJ,TOPAGA                         .переход на TOPAGA
C
 ENDPGA:M15,VJM,ENDPG                   .вызов через М15
 M15,VJM,BEGPG                          .вызов через М15
 ,UJ,JMPA                               .переход на JMPA
C
 TOPAGA:M15,VJM,TOPAGE                  .вызов через М15
 JMPA:,UJ,POP                           .переход на POP
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_КОНЦА_СТРОКИ           .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЕДИНИЦА - АДРЕС КАДРА ВЫЗЫВАЮЩЕГО БЛОКА ПРИ ЗАКРЫТИИ ТЕКСТОВОЙ СТРОКИ
C ЗНАЧЕНИЕ 1; ИСПОЛЬЗУЕТСЯ В КОДЕ
 ПАРАМЕТР_КОНЦА_СТРОКИ:,INT,1
 ,END,
