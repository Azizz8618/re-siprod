CNOTA - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 5920 образа SIPROD.BIN
CДлина при загрузке: 12 слов, 20 команд
CВход: NOTA
CВыход: GET (возврат через М15)
CРегистры: М11 (буфер, счётчик), М12 (магазин, кадр параметров ОС),
CМ13 (счётчик), М15 (адрес возврата)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 NOTA    :,NAME, NEW DTRAN
 M11:,EQU,11B
 M12:,EQU,12B
 M13:,EQU,13B
 M15:,EQU,15B
 ,ATI,9                                 .М11 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M11,XTA,                               .СМ := смещение в буфере 0
 ,UTC,ПАРАМЕТР                          .мод.адрес := К0
 ,X-A,                                  .СМ := слово по адресу К0 - СМ
 ,STI,9                                 .М11 := СМ; СМ := из магазина
 ,STI,10                                .М12 := СМ; СМ := из магазина
 ,ATI,11                                .М13 := СМ
 M11,UTM,1                              .М11 += 1
C ВЫВОД СИМВОЛОВ БУФЕРА В ПАРАМЕТРЫ ВЫЗОВА ОС
 GET:M13,XTA,                           .СМ := смещение в буфере 0
 ,UTC,ПАРАМЕТР+1                        .мод.адрес := К1
 ,AEX,                                  .СМ ^= слово по адресу К1
 M13,UTM,1                              .М13 += 1
 M12,ATX,                               .параметр вызова ОС 0 := СМ
 M12,UTM,1                              .М12 += 1
 M11,VLM,GET                            .М11-- и если ≠0 → повтор
 ,STX,                                  .ЗП + магазин: 0
 ,NTR,6                                 .РЖ := 6 (обращение к ОС)
 M15,UJ,                                .переход через М15
C
C ЧИСЛА: НОМЕР СЛОТА КАДРА, КУДА ВЫПИСЫВАЮТСЯ СИМВОЛЫ БУФЕРА В ОС
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 ПАРАМЕТР:,INT,0
C МАСКИ: МАСКА 45 РАЗРЯДОВ ДЛЯ ПРИВЕДЕНИЯ КОДА СИМВОЛА К КОДУ ОС
 ПАРАМЕТР+1:,LOG,7777777777777777
 ,END,
