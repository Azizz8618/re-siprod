CMASVAL - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 10656 образа SIPROD.BIN
CДлина при загрузке: 27 слов, 44 команд
CВход: MASVAL
CВыход: PAPRAP:EGO86F, PAPRAP:F0, F4 (возврат через М12),
CF1A (возврат через М10)
CАбсолютные символы: N1 = -1
CСмещения в кадре (М7): общие 0-4, 10
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 MASVAL  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M16:,EQU,16B
 M16,VTM,ПЕР+0.М16 := адрес F0
 ,UJ,ПЕР+4.переход на F4
C
 ПЕР+0:M7,XTA,.СМ := слот кадра 0
 M7,ATX,1.слот кадра 1 := СМ
 ,NTR,3.РЖ := 3 (переходы по нулю)
 ,NTR,22B.РЖ := 18 (переходы по знаку)
 ,UJ,БЛОК_V2.переход на F1
C
 БЛОК_V3:,WTC,ЗНАЧЕНИЕ+3.мод.адрес := код из V3
 ,XTA,.СМ := слово по адресу V3
 ,WTC,ЗНАЧЕНИЕ.мод.адрес := код из V0
 M1,VTM,.М1 := код из V0
 ,WTC,ЗНАЧЕНИЕ+1.мод.адрес := код из V1
 M1,ATX,-1.каталог задачи: нулевое слово := СМ
 M7,XTA,1.СМ := слот кадра 1
 ,NTR,3.РЖ := 3 (переходы по нулю)
 M7,A+X,.СМ += слот кадра 0
 M7,ATX,1.слот кадра 1 := СМ
 ,NTR,22B.РЖ := 18 (переходы по знаку)
C ПРОВЕРКА ЗНАЧЕНИЯ V2 ПЕРЕД ЗАПИСЬЮ В КАТАЛОГ ЗАДАЧИ
 БЛОК_V2:,WTC,ЗНАЧЕНИЕ+2.мод.адрес := код из V2
 ,X-A,.СМ := слово по адресу V2 - СМ
 ,UZA,БЛОК_V3.если СМ=0 → F0A
 ,UJ,ВОЗВРАТ_В_БЛОК.переход на F1A
C
 ПЕР+4:M7,MTJ,8.М10 := М7
 M16,MTJ,10.М12 := М16
 M7,VTM,ПАРАМЕТР+1.М7 := адрес К0
 M7,STX,4.ЗП + магазин: 4(М7)
 M7,STX,3.ЗП + магазин: 3(М7)
 M7,STX,2.ЗП + магазин: 2(М7)
 ,ITS,13.в магазин; СМ := М15
 ,ITS,1.в магазин; СМ := М1
 ,ITS,8.в магазин; СМ := М10
 ,ITS,.в магазин; СМ := ИР
 ,NTR,3.РЖ := 3 (переходы по нулю)
 ,NTR,2.РЖ := 2 (переходы по нулю, округление
 M12,UJ,.переход через М12
C
 ВОЗВРАТ_В_БЛОК:,STI,.ИР := СМ; СМ := из магазина
 ,STI,7.М7 := СМ; СМ := из магазина
 ,STI,1.М1 := СМ; СМ := из магазина
 ,STI,8.М10 := СМ; СМ := из магазина
 M10,UJ,.переход через М10
C
 ПАРАМЕТР+1:,INT,1
 ЗНАЧЕНИЕ:,BSS,4
 ,END,
