CPILDYK - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 18784 образа SIPROD.BIN
CДлина при загрузке: 32 слов, 50 команд
CВход: PILDYK
CВыход: WRREM:SEP4B, WRREM:SEP4C, WRREM:F1, F6 (возврат через М12),
CPOP (возврат через М10)
CЗАПОЛНЕНИЕ ТАБЛИЧНЫХ ПОЛЕЙ.
CВнешние: RSYMB
CСмещения в кадре (М7): общие 0-6, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 PILDYK  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 RSYMB   :,SUBP,
 M16,VTM,БЛОК_V+2                       .М16 := адрес F1
 ,UJ,ПЕР_6                              .переход на F6
C
 БЛОК_V+2:,WTC,ЯЧ_ПОЛЕ+2                .мод.адрес := код из V2
 ,XTA,                                  .СМ := слово по адресу V2
 M7,ATX,1                               .слот кадра 1 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,БЛОК_V+3                           .переход на F1A
C
 LOOP:,WTC,ЯЧ_ПОЛЕ+5                    .мод.адрес := код из V5
 M16,VTM,                               .М16 := код из V5
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ШИР_ПОЛЯ                       .М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,ЯЧ_ПОЛЕ+1                         .мод.адрес := код из V1
 M16,VTM,                               .М16 := код из V1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_ПОЛЕ                        .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,1                               .СМ := слот кадра 1
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,WTC,ЯЧ_ПОЛЕ+4                         .мод.адрес := код из V4
 ,A+X,                                  .СМ += слово по адресу V4
 M7,ATX,1                               .слот кадра 1 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 БЛОК_V+3:,WTC,ЯЧ_ПОЛЕ+3                .мод.адрес := код из V3
 ,X-A,                                  .СМ := слово по адресу V3 - СМ
 ,UZA,LOOP                              .если СМ=0 → LOOP
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ПЕР_6:M7,MTJ,8                         .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ШИР_ПОЛЯ                        .М7 := адрес К0
 M7,STX,6                               .ЗП + магазин: 6(М7)
 M7,STX,5                               .ЗП + магазин: 5(М7)
 M7,STX,4                               .ЗП + магазин: 4(М7)
 M7,STX,3                               .ЗП + магазин: 3(М7)
 M7,STX,2                               .ЗП + магазин: 2(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛО ПОЛЕЙ ТАБЛИЦЫ, ЗАПОЛНЯЕМЫХ ЗА ОДИН ВЫЗОВ МОДУЛЯ
C ПАРАМЕТР ВЫЗОВА RSYMB (1); ИСПОЛЬЗУЕТСЯ В КОДЕ (1)
 ШИР_ПОЛЯ:,INT,6
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ С ПРИЗНАКОМ КОНЦА СПИСКА ПОЛЕЙ И ПАРАМЕТРАМИ ПОЛЯ
 ЯЧ_ПОЛЕ:,BSS,6
 ,END,
