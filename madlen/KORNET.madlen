CKORNET - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 10592 образа SIPROD.BIN
CДлина при загрузке: 41 слов, 70 команд
CВход: KORNET
CВыход: PAPRAP:EGO39A, PAPRAP:INS26A, PAPRAP:F32, PAPRAP:SCANA,
CPAPRAP:EGO86L, F5 (возврат через М12), F2 (возврат через М10)
CВнешние: INS, SCANER, GETSTR, SCAN
CСмещения в INS: 24, 25, 26
CСмещения в SCANER: 1, 2
CСмещения в кадре (М7): общие 0-2, 4-5, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 KORNET  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *INS*   :,LC,27
 *SCANER*:,LC,3
 GETSTR  :,SUBP,
 SCAN    :,SUBP,
 M16,VTM,SCANEA                         .М16 := адрес SCANEA
 ,UJ,ПЕР_5                              .переход на F5
C
C ЗАПОМНИНАНИЕ НАЧАЛА ТЕКСТА В SCANER И СЧЁТЧИКА
 SCANEA:,WTC,ЗНАЧЕНИЕ+1                 .мод.адрес := код из V2
 ,XTA,                                  .СМ := слово по адресу V2
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,WTC,ЗНАЧЕНИЕ+1                        .мод.адрес := код из V2
 ,XTA,                                  .СМ := слово по адресу V2
 M7,ATX,2                               .слот кадра 2 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,INS26C                             .переход на INS26C
C
 SCANA:M15,VJM,SCAN                     .вызов через М15
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,INS26A                            .если СМ≠0 → INS26A
 ,UJ,INS26B                             .переход на INS26B
C
 INS26A:,UJ,SCANEB                      .переход на SCANEB
C
 INS26B:M7,XTA,2                        .СМ := слот кадра 2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,2                               .слот кадра 2 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 INS26C:,UTC,*INS*+26                   .мод.адрес := INS26
 ,X-A,                                  .СМ := слово по адресу INS26 - СМ
 ,UZA,SCANA                             .если СМ=0 → SCANA
 M16,VTM,ЗНАЧЕНИЕ                       .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,GETSTR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*INS*+25                          .мод.адрес := INS25
 ,XTA,                                  .СМ := слово по адресу INS25
 ,WTC,ЗНАЧЕНИЕ+2                        .мод.адрес := код из V3
 ,ATX,                                  .по адресу V3 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВОЗВРАТ_В_БЛОК                     .переход на F2
C
C ЗАПИСЬ ОСТАТКА ТЕКСТА В V3 И ВЫХОД ИЗ МОДУЛЯ
 SCANEB:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,                                .СМ -= слот кадра 0
 ,WTC,ЗНАЧЕНИЕ+2                        .мод.адрес := код из V3
 ,ATX,                                  .по адресу V3 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВОЗВРАТ_В_БЛОК                     .переход на F2
C
 ПЕР_5:M7,MTJ,8                         .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_1                      .М7 := адрес К0
 M7,STX,5                               .ЗП + магазин: 5(М7)
 M7,STX,4                               .ЗП + магазин: 4(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
 ПАРАМЕТР_1:,INT,1
 ВОСЕМЬ:,INT,8
C ПЕРЕМЕННАЯ МОДУЛЯ, В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 НЕИСПОЛЬЗУЕМОЕ_ПОЛЕ:,BSS,1
 ЗНАЧЕНИЕ:,BSS,3
 ,END,
