CTXTRED - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 16160 образа SIPROD.BIN
CДлина при загрузке: 38 слов, 64 команд
CВход: TXTRED
CВыход: PAPRAP:EGO86F, F5 (возврат через М12), POP (возврат через М10)
CВнешние: RPT, EGO, RUSIS, SPAUD
CСмещения в EGO: 7200, 8600, 8601
CСмещения в кадре (М7): общие 0-2, 5, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 TXTRED  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 *RPT*   :,LC,1
 *EGO*   :,LC,13401
 *RUSIS* :,LC,1
 SPAUD   :,SUBP,
 M16,VTM,RPTA                           .М16 := адрес RPTA
 ,UJ,ПЕР+5                              .переход на F5
C
C УСТАНОВКА УКАЗАТЕЛЕЙ ТЕКСТА RPT И RUSIS
 RPTA:,WTC,ЗНАЧЕНИЕ+2                   .мод.адрес := код из V2
 ,XTA,                                  .СМ := слово по адресу V2
 ,UTC,*RPT*                             .мод.адрес := RPT
 ,ATX,                                  .по адресу RPT := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*RPT*                             .мод.адрес := RPT
 ,XTA,                                  .СМ := слово по адресу RPT
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,2                               .СМ += слот кадра 2
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,RPTB                              .если СМ≠0 → RPTB
 ,UJ,RPTC                               .переход на RPTC
C
 RPTB:M7,XTA,2                          .СМ := слот кадра 2
 ,UTC,*RPT*                             .мод.адрес := RPT
 ,ATX,                                  .по адресу RPT := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 RPTC:M7,XTA,1                          .СМ := слот кадра 1
 ,UTC,*RUSIS*                           .мод.адрес := RUSIS
 ,ATX,                                  .по адресу RUSIS := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ОБРАБОТКА ТЕКСТА ОТЧЕТА ЧЕРЕЗ SPAUD
 RPTD:M16,VTM,ЗНАЧЕНИЕ                  .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ+1                     .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,SPAUD                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*EGO*+8600                        .мод.адрес := EGO8600
 ,XTA,                                  .СМ := слово по адресу EGO8600
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,                                .СМ += слот кадра 0
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,RUSISA                            .если СМ≠0 → RUSISA
 ,UJ,RUSISB                             .переход на RUSISB
C
 RUSISA:,UJ,RPTD                        .переход на RPTD
C
C ЗАПИСЬ УКАЗАТЕЛЯ RUSIS ПОСЛЕ ОБРАБОТКИ ТЕКСТА
 RUSISB:M7,XTA,                         .СМ := слот кадра 0
 ,UTC,*RUSIS*                           .мод.адрес := RUSIS
 ,ATX,                                  .по адресу RUSIS := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,POP                                .переход на POP
C
 ПЕР+5:M7,MTJ,8                         .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР+1                      .М7 := адрес К0
 M7,STX,5                               .ЗП + магазин: 5(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
 ПАРАМЕТР+1:,INT,0
 ЕДИНИЦА:,INT,1
 ДЕСЯТЬ:,INT,10
 ЗНАЧЕНИЕ:,BSS,3
 ,END,
