CHEADIN - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 20352 образа SIPROD.BIN
CДлина при загрузке: 93 слов, 166 команд
CВход: HEADIN
CВыход: F0A (возврат через М12), F0B (возврат через М10)
CРАЗБОР ЗАГОЛОВКА ВХОДНОГО БЛОКА.
CВнешние: INS, STR, HED, SCANER, NDAB, FORMA, REGIM, NUST, PAGE, KLAIDA,
CDOUBLE, BEGSTR, ENDSTR, TITLE, BEGPG, ENDPG
CСмещения в FORMA: 10, 11
CСмещения в HED: 1
CСмещения в INS: 24, 25, 26
CСмещения в NDAB: 1, 2
CСмещения в NUST: 3
CСмещения в PAGE: 3, 4
CСмещения в REGIM: 8
CСмещения в SCANER: 1, 2
CСмещения в STR: 24, 25, 26
CСмещения в кадре (М7): общие 0-6, 8-10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 HEADIN  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *INS*   :,LC,27
 *STR*   :,LC,27
 *HED*   :,LC,2
 *SCANER*:,LC,3
 *NDAB*  :,LC,4
 *FORMA* :,LC,16
 *REGIM* :,LC,16
 *NUST*  :,LC,10
 *PAGE*  :,LC,6
 KLAIDA  :,SUBP,
 DOUBLE  :,SUBP,
 BEGSTR  :,SUBP,
 ENDSTR  :,SUBP,
 TITLE   :,SUBP,
 BEGPG   :,SUBP,
 ENDPG   :,SUBP,
 M16,VTM,HEDA                           .М16 := адрес HEDA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F0A
C
C СОХРАНЕНИЕ ЗАГОЛОВКА В HED И ПРОВЕРКА ПРИЗНАКА КОНЦА
 HEDA:M7,XTA,5                          .СМ := слот кадра 5
 ,UTC,*HED*                             .мод.адрес := HED
 ,ATX,                                  .по адресу HED := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,2                               .СМ := слот кадра 2
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*HED*+1                           .мод.адрес := HED1
 ,XTA,                                  .СМ := слово по адресу HED1
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,SCANEA                            .если СМ=0 → SCANEA
 ,UJ,SCANEB                             .переход на SCANEB
C
 SCANEA:,UJ,ENDSTA                      .переход на ENDSTA
C
 SCANEB:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,UTC,*INS*+24                          .мод.адрес := INS24
 ,ATX,                                  .по адресу INS24 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,ENDPG                          .вызов через М15
 M15,VJM,BEGPG                          .вызов через М15
 M15,VJM,TITLE                          .вызов через М15
 ,UJ,HEDB                               .переход на HEDB
C
 ENDSTA:M15,VJM,ENDSTR                  .вызов через М15
 M15,VJM,BEGSTR                         .вызов через М15
 ,UTC,*NDAB*                            .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,2                               .СМ += слот кадра 2
 ,UTC,*NDAB*                            .мод.адрес := NDAB
 ,ATX,                                  .по адресу NDAB := СМ
 ,UTC,*NDAB*                            .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 ,X-A,                                  .СМ := (адрес) - СМ
 ,UTC,*PAGE*+3                          .мод.адрес := PAGE3
 ,A+X,                                  .СМ += слово по адресу PAGE3
 ,UTC,*PAGE*+4                          .мод.адрес := PAGE4
 ,A+X,                                  .СМ += слово по адресу PAGE4
 M7,A-X,5                               .СМ -= слот кадра 5
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F2
 ,UJ,ENDPGA                             .переход на ENDPGA
C
 ЦИКЛ_ПЕРЕХОД:,UJ,REGIMA                .переход на REGIMA
C
 ENDPGA:M15,VJM,ENDPG                   .вызов через М15
 M15,VJM,BEGPG                          .вызов через М15
C РАСЧЁТ ПАРАМЕТРОВ РЕЖИМА НАБОРА И ПОЛЯ ФОРМАТА
 REGIMA:M7,XTA,                         .СМ := слот кадра 0
 ,UTC,*REGIM*+8                         .мод.адрес := REGIM8
 ,ATX,                                  .по адресу REGIM8 := СМ
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*NUST*+3                          .мод.адрес := NUST3
 ,ATX,                                  .по адресу NUST3 := СМ
 ,UTC,*STR*+25                          .мод.адрес := STR25
 ,XTA,                                  .СМ := слово по адресу STR25
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,2                               .СМ += слот кадра 2
 ,UTC,*FORMA*+10                        .мод.адрес := FORMA10
 ,ATX,                                  .по адресу FORMA10 := СМ
 ,UTC,*FORMA*+11                        .мод.адрес := FORMA11
 ,XTA,                                  .СМ := слово по адресу FORMA11
 M7,A-X,4                               .СМ -= слот кадра 4
 ,UTC,*FORMA*+11                        .мод.адрес := FORMA11
 ,ATX,                                  .по адресу FORMA11 := СМ
 ,UTC,*FORMA*+11                        .мод.адрес := FORMA11
 ,XTA,                                  .СМ := слово по адресу FORMA11
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,3                               .СМ += слот кадра 3
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,ЦИКЛ_ПЕРЕХОД_2                    .если СМ≠0 → F0
 ,UJ,ПЕР+6                              .переход на F6
C
 ЦИКЛ_ПЕРЕХОД_2:,UJ,INS26A              .переход на INS26A
C
 ПЕР+6:M7,XTA,6                         .СМ := слот кадра 6
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВЫЗОВ_KLAIDA                       .переход на F1B
C
C ДВОЙНОЙ ПРОГОН ЗАГОЛОВКА И ПРОВЕРКА ГРАНИЦЫ СТРАНИЦЫ
 INS26A:,UTC,*INS*+26                   .мод.адрес := INS26
 ,XTA,                                  .СМ := слово по адресу INS26
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,11B                             .слот кадра 9 := СМ
 M16,VTM,*SCANER*                       .М16 := адрес SCANER
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ_ЗАГОЛОВКА+1           .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,DOUBLE                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,1                               .СМ := слот кадра 1
 ,UTC,*REGIM*+8                         .мод.адрес := REGIM8
 ,ATX,                                  .по адресу REGIM8 := СМ
 M15,VJM,ENDSTR                         .вызов через М15
 M15,VJM,BEGSTR                         .вызов через М15
 ,UTC,*NDAB*                            .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,2                               .СМ += слот кадра 2
 ,UTC,*NDAB*                            .мод.адрес := NDAB
 ,ATX,                                  .по адресу NDAB := СМ
 ,UTC,*NDAB*                            .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 ,X-A,                                  .СМ := (адрес) - СМ
 ,UTC,*PAGE*+3                          .мод.адрес := PAGE3
 ,A+X,                                  .СМ += слово по адресу PAGE3
 ,UTC,*PAGE*+4                          .мод.адрес := PAGE4
 ,A+X,                                  .СМ += слово по адресу PAGE4
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ЦИКЛ_ПЕРЕХОД_3                    .если СМ=0 → F1
 ,UJ,ENDPGB                             .переход на ENDPGB
C
 ЦИКЛ_ПЕРЕХОД_3:,UJ,ЦИКЛ_ПЕРЕХОД_4      .переход на F1A
C
 ENDPGB:M15,VJM,ENDPG                   .вызов через М15
 M15,VJM,BEGPG                          .вызов через М15
 ЦИКЛ_ПЕРЕХОД_4:,UJ,HEDB                .переход на HEDB
C
 ВЫЗОВ_KLAIDA:M16,VTM,ЗНАЧЕНИЕ_ЗАГОЛОВКА.М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,KLAIDA                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 HEDB:M7,XTA,                           .СМ := слот кадра 0
 ,UTC,*HED*                             .мод.адрес := HED
 ,ATX,                                  .по адресу HED := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,XTA,                                  .СМ := слово по адресу INS26
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВОЗВРАТ_В_БЛОК                     .переход на F0B
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_ЗАГОЛОВКА+1            .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
 ПАРАМЕТР_ЗАГОЛОВКА+1:,INT,0
 ЕДИНИЦА:,INT,1
 ДВОЙКА:,INT,2
 ПЯТЬ:,INT,5
 СЕМЬ:,INT,7
 ДЕСЯТЬ:,INT,10
 КОНСТАНТА_110:,INT,110
 V0:,BSS,1
 ЗНАЧЕНИЕ_ЗАГОЛОВКА:,BSS,2
 ,END,
