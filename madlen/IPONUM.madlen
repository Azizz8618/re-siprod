CIPONUM - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 9408 образа SIPROD.BIN
CДлина при загрузке: 52 слов, 88 команд
CВход: IPONUM
CВыход: WRIIPO:SCANEA, F4A (возврат через М12), F4B (возврат через М10)
CВнешние: NUM, SCANER, INS, PAGE, NBR, ENDKOR, WRIKOR, GOTOPO, READNB
CСмещения в INS: 24, 25, 26
CСмещения в NUM: 2, 3
CСмещения в PAGE: 1
CСмещения в SCANER: 1, 2
CСмещения в кадре (М7): общие 0-1, 3-6, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 IPONUM  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C NUM: ЧИСЛО: СЧЁТЧИК ЧИСЕЛ (4 СЛОВА)
 *NUM*   :,LC,4
C SCANER: СОСТОЯНИЕ РАЗБОРЩИКА: ТЕКУЩИЙ СИМВОЛ И КЛАСС (3 СЛОВА)
 *SCANER*:,LC,3
C INS: ВХОДНОЙ ПОТОК: УКАЗАТЕЛИ И ТЕКСТ ВХОДНЫХ ДАННЫХ (27 СЛОВ)
 *INS*   :,LC,27
C PAGE: ПАРАМЕТРЫ СТРАНИЦЫ: НОМЕР, ПОЛОСА (6 СЛОВ)
 *PAGE*  :,LC,6
C ОБЛАСТЬ NBR, 1 СЛОВО
 *NBR*   :,LC,1
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 ENDKOR  :,SUBP,
 WRIKOR  :,SUBP,
 GOTOPO  :,SUBP,
 READNB  :,SUBP,
 M16,VTM,SCANEA                         .М16 := адрес SCANEA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F4A
C
C ПРОВЕРКА КОНЦА ВХОДНОГО ТЕКСТА ПЕРЕД ЧТЕНИЕМ НОМЕРА
 SCANEA:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A-X,                                  .СМ -= слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,NBRA                              .если СМ=0 → NBRA
 ,UJ,NBRB                               .переход на NBRB
C
 NBRA:,UJ,ЦИКЛ_ПЕРЕХОД                  .переход на F4
C
C ЧТЕНИЕ НОМЕРА ДИАГРАММЫ И РАСЧЁТ ЕГО ПОЗИЦИИ
 NBRB:M7,XTA,1                          .СМ := слот кадра 1
 ,UTC,*NBR*                             .мод.адрес := NBR
 ,ATX,                                  .по адресу NBR := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,READNB                         .вызов через М15
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*NBR*                             .мод.адрес := NBR
 ,ATX,                                  .по адресу NBR := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*PAGE*+1                          .мод.адрес := PAGE1
 ,XTA,                                  .СМ := слово по адресу PAGE1
 ,UTC,*NUM*+2                           .мод.адрес := NUM2
 ,A-X,                                  .СМ -= слово по адресу NUM2
 M7,A-X,3                               .СМ -= слот кадра 3
 M7,ATX,5                               .слот кадра 5 := СМ
 M7,XTA,5                               .СМ := слот кадра 5
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,                                .СМ += слот кадра 0
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ПЕР_1                             .если СМ=0 → F1
 ,UJ,ВЫЗОВ_GOTOPO                       .переход на F1A
C
 ПЕР_1:M7,XTA,1                         .СМ := слот кадра 1
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ВЫЗОВ_GOTOPO:M16,VTM,ЯЧ_НОМЕР          .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,GOTOPO                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M16,VTM,МЕТКА_НОМЕР                    .М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_2                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,4                               .СМ := слот кадра 4
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*NUM*+2                           .мод.адрес := NUM2
 ,A-X,                                  .СМ -= слово по адресу NUM2
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,6                               .слот кадра 6 := СМ
 M16,VTM,*NUM*                          .М16 := адрес NUM
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_БУФЕР                       .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*NUM*+2                        .М16 := адрес NUM2
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,ENDKOR                         .вызов через М15
 ЦИКЛ_ПЕРЕХОД:,UJ,ВОЗВРА2Т_В_БЛОК       .переход на F4B
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРА2Т_В_БЛОК:,STI,                  .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: МЕТКА ДИАГРАММЫ IPO, ПЕЧАТАЕМАЯ В ШАПКЕ ЧЕРТЕЖА HIPO
 МЕТКА_НОМЕР:,ISO, 6HI P O  .. 111 040 120 040 117 040
C ЧИСЛА: ЧИСЛОВЫЕ ПАРАМЕТРЫ ВЫВОДА НОМЕРА ДИАГРАММЫ: РАЗРЯДЫ И ПОЗИЦИЯ
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; ПАРАМЕТР ВЫЗОВА WRIKOR
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 6; ПАРАМЕТР ВЫЗОВА WRIKOR
 КОД_3:,INT,6
C ЗНАЧЕНИЕ 8; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_4:,INT,8
C ЗНАЧЕНИЕ 12; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_5:,INT,12
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ С ПРОЧИТАННЫМ НОМЕРОМ ДИАГРАММЫ И ЕГО ПОЗИЦИЕЙ
 ЯЧ_НОМЕР:,BSS,1
 ЯЧ_БУФЕР:,BSS,1
 ,END,
