  :,ITS,1                               .в магазин; СМ := М1
 ,ITS,7                                 .в магазин; СМ := М7
 ,ITS,13                                .в магазин; СМ := М15
 M15,VJM,KONSTA                         .вызов через М15
 M12,STX,11B                            .ЗП + магазин: 9(М12)
 M12,STX,14B                            .ЗП + магазин: 12(М12)
 M12,STX,24B                            .ЗП + магазин: 20(М12)
 ,STI,2                                 .М2 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,9                                 .М11 := СМ; СМ := из магазина
 ,ATI,11                                .М13 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M13,XTA,                               .СМ := смещение в буфере 0
 M10,X-A,3                              .СМ := (адрес) - СМ
 ,STI,11                                .М13 := СМ; СМ := из магазина
 ,STI,12                                .М14 := СМ; СМ := из магазина
 M7,VTM,-5                              .М7 := адрес N5
C ЗАПИСЬ СИМВОЛА В БУФЕР ВЫВОДА И ЧТЕНИЕ СЛЕДУЮЩЕГО
 PUSH:M7,ITS,6                          .в магазин; СМ := М6
 M7,VLM,PUSH                            .М7-- и если ≠0 → повтор
 M13,UTM,1                              .М13 += 1
 M7,VTM,60B                             .М7 := адрес 48
 M16,VTM,                               .М16 := база модуля
 M11,XTS,                               .магазин + СЧ: 0(М11)
 M5,VTM,                                .М5 := база модуля
 M11,UTM,1                              .М11 += 1
 M17,UTM,1                              .М17 += 1
 ,ASN,64+32
 ,U1A,ВЫЗОВ_INCA                        .если СМ≠0 → L0124
 ,UJ,ЗАПИСЬ_БАЙТА_В_БУФЕР               .переход на L12A
C
 ВЫЗОВ_INCA:M15,VJM,INCA                .вызов через М15
 ADDR:M6,VTM,-47                        .М6 := адрес N47
 M14,XTA,                               .СМ := смещение в буфере 0
 M14,UTM,1                              .М14 += 1
  :,XTS,                                .магазин + СЧ: 0
 M17,ATX,-2                             .каталог задачи: элемент 4 := СМ
 INC:M5,UTM,-1                          .М5 += N1
 M5,MTJ,4                               .М4 := М5
 M3,J+M,4
 M4,VZM,GET
C ЦИКЛ НАКОПЛЕНИЯ СИМВОЛОВ ТЕКСТА И ПЕРЕХОД К РАЗБОРУ
 LOOP:M6,VLM,INC
 ,UJ,GETA
C
 GET:M10,XTA,
 M15,VJM,INCA
 M6,ASN,64+0
 M17,AAX,-1
 ,UZA,LOOP
 M17,AOX,-2
 M17,ATX,-2
 M16,UTM,1
 ,UJ,LOOP
C
C ЗАПИСЬ ПРИЗНАКА КАТАЛОГА ЗАДАЧИ И ПЕРЕХОД К ВЫВОДУ
 GETA:M17,XTA,-2
 M1,UTM,1
 M1,ATX,-1
 M17,UTM,-1
 M13,VLM,ADDR
 ,UJ,ЧТЕНИЕ_ПОЛЯ_БЛОКА_ВЫЗЫВАЮЩЕГО
C
 INCA:M7,UTM,-16
 M11,XTS,
 M7,ASN,64+0
 ,STI,3
 M7,V1M,ВОЗВРАТ_ПОСЛЕ_РАЗБОРА
 M11,UTM,1
 M7,VTM,60B
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 ВОЗВРАТ_ПОСЛЕ_РАЗБОРА:M3,VZM,ЧТЕНИЕ_ПРИЗНАКА_ИЗ_КОНТЕКСТА
 M15,UJ,
C
 ЧТЕНИЕ_ПРИЗНАКА_ИЗ_КОНТЕКСТА:M17,XTA,-2
 ЗАПИСЬ_БАЙТА_В_БУФЕР:M1,ATX,
 M17,UTM,-1
 M13,VZM,ЧТЕНИЕ_ПОЛЯ_БЛОКА_ВЫЗЫВАЮЩЕГО
 ,XTA,
 СЧЁТ_АДРЕСА_В_БУФЕРЕ:M1,UTM,1
 M1,ATX,
 M13,VLM,СЧЁТ_АДРЕСА_В_БУФЕРЕ
 ЧТЕНИЕ_ПОЛЯ_БЛОКА_ВЫЗЫВАЮЩЕГО:,ITA,14
 M10,AOX,3
 M2,ATX,
 M17,UTM,-1
 M17,XTA,
 M15,VTM,6
C ПОДГОТОВКА ВОЗВРАТА В ОС ПО МОДИФИЦИРОВАННОМУ АДРЕСУ
 БЛОК_С12:M15,STI,
 M15,UTM,-1
 M15,V1M,БЛОК_С12
 M12,WTC,14B
 M7,VTM,
 M12,WTC,24B
 M1,VTM,
 ,NTR,6
 M12,WTC,11B
 ,UJ,
C
 ,END,
