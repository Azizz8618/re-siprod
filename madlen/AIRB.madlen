CAIRB - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 5824 образа SIPROD.BIN
CДлина при загрузке: 75 слов, 150 команд
CВход: AIRB
CВыход: L9 (возврат через ячейка 0), L9A (возврат через ячейка 0),
CL0172 (возврат через М15), L12D (возврат через ячейка 0)
CВнешние: KONSTA
CАбсолютные символы: N1 = -1, N16 = -16, N2 = -2, N47 = -47, N5 = -5
CСмещения в кадре (М7): общие 0, 5-6, свои 16, 48, 64, 172
CРегистры: М1 (индекс: база модуля), М2 (рабочий регистр),
CМ3 (рабочий регистр), М4 (рабочий регистр), М5 (рабочий регистр),
CМ6 (рабочий регистр), М7 (указатель кадра), М10 (блок вызывающего),
CМ11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), М13 (счётчик),
CМ14 (смещение в буфере), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 AIRB    :,NAME, NEW DTRAN
 M1:,EQU,1B
 M2:,EQU,2B
 M3:,EQU,3B
 M4:,EQU,4B
 M5:,EQU,5B
 M6:,EQU,6B
 M7:,EQU,7B
 M10:,EQU,10B
 M11:,EQU,11B
 M12:,EQU,12B
 M13:,EQU,13B
 M14:,EQU,14B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 KONSTA  :,SUBP,
 ,ITS,13                                .в магазин; СМ := М15
 M15,VJM,KONSTA                         .вызов через М15
 M12,STX,11B                            .ЗП + магазин: 9(М12)
 ,STI,14                                .М16 := СМ; СМ := из магазина
 ,STI,11                                .М13 := СМ; СМ := из магазина
 ,STI,9                                 .М11 := СМ; СМ := из магазина
 ,ATI,12                                .М14 := СМ
 ,XTA,                                  .СМ := 0
 M13,XTS,                               .магазин + СЧ: 0(М13)
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M10,X-A,3                              .СМ := (адрес) - СМ
 ,STI,11                                .М13 := СМ; СМ := из магазина
 M13,UTM,1                              .М13 += 1
 ВЫЗОВ_KONSTA:M14,XTS,                  .магазин + СЧ: 0(М14)
 M11,AAX,                               .СМ &= смещение в буфере 0
 M14,UTM,1                              .М14 += 1
 M17,ACX,                               .СМ := кол-во единиц в поле контекста
 M11,UTM,1                              .М11 += 1
 M13,VLM,ВЫЗОВ_KONSTA                   .М13-- и если ≠0 → повтор
 M10,AOX,3                              .СМ |= поле блока вызывающего 3
 M16,STX,                               .ЗП + магазин: 0(М16)
 ,NTR,6                                 .РЖ := 6 (обращение к ОС)
 M12,WTC,11B                            .мод.адрес := код из 9(М12)
 ,UJ,                                   .переход по адресу в мод.адресе
C
  :,ITS,13                              .в магазин; СМ := М15
 M15,VJM,KONSTA                         .вызов через М15
 M12,STX,11B                            .ЗП + магазин: 9(М12)
 ,STI,14                                .М16 := СМ; СМ := из магазина
 ,ATI,11                                .М13 := СМ
 M13,XTA,                               .СМ := смещение в буфере 0
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M10,X-A,3                              .СМ := (адрес) - СМ
 ,STI,11                                .М13 := СМ; СМ := из магазина
 ,STI,13                                .М15 := СМ; СМ := из магазина
 M13,UTM,1                              .М13 += 1
 ,STI,9                                 .М11 := СМ; СМ := из магазина
 ,ATI,12                                .М14 := СМ
 ,XTA,                                  .СМ := 0
 ВЫЗОВ_KONSTA_2:M14,XTS,                .магазин + СЧ: 0(М14)
 M11,AAX,                               .СМ &= смещение в буфере 0
 M14,UTM,1                              .М14 += 1
 M15,ATX,                               .смещение в магазине 0 := СМ
 M11,UTM,1                              .М11 += 1
 M17,ACX,                               .СМ := кол-во единиц в поле контекста
 M15,UTM,1                              .М15 += 1
 M13,VLM,ВЫЗОВ_KONSTA_2                 .М13-- и если ≠0 → повтор
 M10,AOX,3                              .СМ |= поле блока вызывающего 3
 M16,STX,                               .ЗП + магазин: 0(М16)
 ,NTR,6                                 .РЖ := 6 (обращение к ОС)
 M12,WTC,11B                            .мод.адрес := код из 9(М12)
 ,UJ,                                   .переход по адресу в мод.адресе
