CAPNOTF - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 8448 образа SIPROD.BIN
CДлина при загрузке: 109 слов, 188 команд
CВход: APNOTF
CВыход: NOTFOR:ENDKOA, F1C (возврат через М12), F1D (возврат через М10)
CВнешние: PAGE, INS, SCANER, TYPE, WHO, GOT, NAMENF, ENDKOR, HOWSMB,
CRASPS, WRIKOR, WHATYP
CСмещения в INS: 24, 25, 26
CСмещения в PAGE: 1
CСмещения в SCANER: 1, 2
CСмещения в TYPE: 1, 11, 13
CСмещения в WHO: 1
CСмещения в кадре (М7): общие 0-2, 6, 8-10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 APNOTF  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *PAGE*  :,LC,6
 *INS*   :,LC,27
 *SCANER*:,LC,3
 *TYPE*  :,LC,14
 *WHO*   :,LC,2
 *GOT*   :,LC,1
 NAMENF  :,SUBP,
 ENDKOR  :,SUBP,
 HOWSMB  :,SUBP,
 RASPS   :,SUBP,
 WRIKOR  :,SUBP,
 WHATYP  :,SUBP,
 M16,VTM,SCANEA                         .М16 := адрес SCANEA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F1C
C
 SCANEA:M7,XTA,                         .СМ := слот кадра 0
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ПРОВЕРКА ОКОНЧАНИЯ ВВОДА В БЛОКЕ ПСЕВДОКОДА
 SCANEB:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A-X,                                  .СМ -= слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F0
 ,UJ,WHATYA                             .переход на WHATYA
C
 ЦИКЛ_ПЕРЕХОД:,UJ,ENDKOA                .переход на ENDKOA
C
C ОПОЗНАНИЕ ТИПА КЛЮЧЕВОГО СЛОВА И ВЫВОД СТРОКИ
