CCSTRIN - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 9248 образа SIPROD.BIN
CДлина при загрузке: 63 слов, 106 команд
CВход: CSTRIN
CВыход: NAMENF:F9B, NOTFOR:TYPEA, NOTFOR:F0, NOTFOR:ENDKOB,
CTARNYB:TYPEA, TARNYB:NOTFE, TARNYB:F1A, F8 (возврат через М12),
CPOP (возврат через М10)
CВнешние: WHO, ENDKOR, HOWSMB, RASPS, WRIKOR
CСмещения в WHO: 1
CСмещения в кадре (М7): общие 1, 7-8, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 CSTRIN  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 *WHO*   :,LC,2
 ENDKOR  :,SUBP,
 HOWSMB  :,SUBP,
 RASPS   :,SUBP,
 WRIKOR  :,SUBP,
 M16,VTM,ADDR                           .М16 := адрес ADDR
 ,UJ,ЗАВЕРШЕНИЕ_МОДУЛЯ                  .переход на F8
C
 ADDR:M16,VTM,ПЕРВОЕ_ПОЛЕ               .М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_1                          .М16 := адрес К1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,WTC,КОД_ПОЛЯ                          .мод.адрес := код из V2
 M16,VTM,                               .М16 := код из V2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_5                          .М16 := адрес К5
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_5                          .М16 := адрес К5
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ                       .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_2                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RASPS                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M16,VTM,ЗНАЧЕНИЕ                       .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,HOWSMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M16,VTM,ЗНАЧЕНИЕ                       .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*WHO*                          .М16 := адрес WHO
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*WHO*+1                        .М16 := адрес WHO1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M16,VTM,ПЕРВОЕ_ПОЛЕ                    .М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_4                          .М16 := адрес К4
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_1                          .М16 := адрес К1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,WTC,КОД_ПОЛЯ+1                        .мод.адрес := код из V3
 M16,VTM,                               .М16 := код из V3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_5                          .М16 := адрес К5
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_5                          .М16 := адрес К5
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ+1                     .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_2                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RASPS                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M16,VTM,ЗНАЧЕНИЕ+1                     .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,HOWSMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M16,VTM,ЗНАЧЕНИЕ+1                     .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*WHO*                          .М16 := адрес WHO
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*WHO*+1                        .М16 := адрес WHO1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,ENDKOR                         .вызов через М15
 ,UJ,POP                                .переход на POP
C
 ЗАВЕРШЕНИЕ_МОДУЛЯ:M7,MTJ,8             .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К1
 M7,STX,10B                             .ЗП + магазин: 8(М7)
 M7,STX,7                               .ЗП + магазин: 7(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C КОМАНДЫ: КОМАНДА *0MCS - ЗАДАНИЕ ПОЛЯ И ШИРИНЫ СТРОКИ В ТЕКСТЕ ПСЕВДОКОДА
 ПЕРВОЕ_ПОЛЕ:,ISO, 6H*0MCS  ... 052 060 115 103 123 040
C ЧИСЛА: КОДЫ ПОЛЕЙ И КОД_5 ПРИ СБОРКЕ ЧИСЕЛ В КОМАНДУ *0MCS
C ЗНАЧЕНИЕ 1; ПАРАМЕТР ВЫЗОВА WRIKOR - 2 ССЫЛ.; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,1
C ЗНАЧЕНИЕ 2; ПАРАМЕТР ВЫЗОВА RASPS - 2 ССЫЛ.
 КОД_2:,INT,2
C ЗНАЧЕНИЕ 5; ПАРАМЕТР ВЫЗОВА WRIKOR; ПАРАМЕТР ВЫЗОВА RASPS - 2 ССЫЛ.
 КОД_3:,INT,5
C ЗНАЧЕНИЕ 6; ПАРАМЕТР ВЫЗОВА WRIKOR
 КОД_4:,INT,6
C ЗНАЧЕНИЕ 16; ПАРАМЕТР ВЫЗОВА RASPS - 4 ССЫЛ.
 КОД_5:,INT,16
C ПЕРЕМЕННЫЕ: РАЗБИРАЕМЫЕ ЗНАЧЕНИЯ ПОЛЯ И ШИРИНЫ СТРОКИ И ИХ КОДЫ В РАЗБОРЕ
 ЗНАЧЕНИЕ:,BSS,2
 КОД_ПОЛЯ:,BSS,2
 ,END,
