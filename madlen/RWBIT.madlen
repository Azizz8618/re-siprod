CRWBIT - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6016 образа SIPROD.BIN
CДлина при загрузке: 15 слов, 24 команд
CВход: RWBIT
CВыход: RWINF:INF2A, RWBIT (возврат через М15)
CРегистры: М10 (блок вызывающего), М11 (буфер, счётчик),
CМ12 (магазин, кадр параметров ОС), М13 (счётчик),
CМ14 (смещение в буфере), М15 (адрес возврата), М17 (контекст задачи)
C
 RWBIT   :,NAME, NEW DTRAN
 M10:,EQU,10B
 M11:,EQU,11B
 M12:,EQU,12B
 M13:,EQU,13B
 M14:,EQU,14B
 M15:,EQU,15B
 M17:,EQU,17B
 ,STI,11                                .М13 := СМ; СМ := из магазина
 M10,VTM,ПАРАМЕТР_1                     .М10 := адрес К0
 ,STI,12                                .М14 := СМ; СМ := из магазина
 ,STI,10                                .М12 := СМ; СМ := из магазина
 ,ATI,9                                 .М11 := СМ
 M11,XTA,                               .СМ := смещение в буфере 0
 M12,XTS,                               .магазин + СЧ: 0(М12)
 ,STI,10                                .М12 := СМ; СМ := из магазина
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M12,ASN,64-1
 M10,AAX,1                              .СМ &= поле блока вызывающего 1
 M13,XTS,                               .магазин + СЧ: 0(М13)
 M10,X-A,                               .СМ := (адрес) - СМ
 ,STI,11                                .М13 := СМ; СМ := из магазина
 M13,ASN,64+0
 M10,XTS,1                              .магазин + СЧ: 1(М10)
 M13,ASN,64+0
 M10,AEX,2                              .СМ ^= поле блока вызывающего 2
 M14,XTS,                               .магазин + СЧ: 0(М14)
 M17,AAX,                               .СМ &= поле контекста 0
 M17,AOX,                               .СМ |= поле контекста 0
 M14,STX,                               .ЗП + магазин: 0(М14)
 ,NTR,6                                 .РЖ := 6 (обращение к ОС)
 M15,UJ,                                .переход через М15
C
C ЧИСЛА: НОМЕР УСТАНАВЛИВАЕМОГО БИТА ИНФОРМАЦИОННОГО ПОЛЯ
C ЗНАЧЕНИЕ 1; ИСПОЛЬЗУЕТСЯ В КОДЕ
 ПАРАМЕТР_1:,INT,1
C МАСКИ: МАСКИ ОТДЕЛЕНИЯ ОДНОГО БИТА: 1 И ПОЛНАЯ 48-БИТНАЯ
 МАСКА_1:,LOG,1
 МАСКА_7777777777777777:,LOG,7777777777777777
 ,END,
