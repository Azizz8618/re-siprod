CKOKSEK - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 18592 образа SIPROD.BIN
CДлина при загрузке: 35 слов, 62 команд
CВход: KOKSEK
CВыход: RASTXT:INS25A, SEKGIR:F9, F1 (возврат через М12),
CPOP (возврат через М10)
CВнешние: SEK, SLY, LYG, TAB, NUST, NDAB, NDABL
CСмещения в LYG: 1, 2
CСмещения в NDAB: 1
CСмещения в NDABL: 1
CСмещения в SEK: 1
CСмещения в SLY: 1
CСмещения в TAB: 1, 3, 4
CСмещения в кадре (М7): общие 0-3, 10
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес),
CМ17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 KOKSEK  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M16:,EQU,16B
 M17:,EQU,17B
 *SEK*   :,LC,4
 *SLY*   :,LC,2
 *LYG*   :,LC,6
 *TAB*   :,LC,5
 *NUST*  :,LC,10
 *NDAB*  :,LC,4
 *NDABL* :,LC,2
 SEK32767:,EQU,*SEK*   -32767
 M16,VTM,SEK327                         .М16 := адрес SEK327
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F1
C
 SEK327:M7,XTA,1                        .СМ := слот кадра 1
 M7,ATX,3                               .слот кадра 3 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C КОПИРОВАНИЕ СЛОВ ТЕКСТА В БУФЕР СЕГМЕНТА
 SEK32A:M7,XTA,                         .СМ := слот кадра 0
 ,WTC,ЗНАЧЕНИЕ+1                        .мод.адрес := код из V0
 M1,VTM,                                .М1 := код из V0
 M1,UTC,SEK32767                        .мод.адрес := SEK32767(М1)
 ,ATX,                                  .по адресу SEK32767+М1 := СМ
  :7,XTA,3                              .СМ := слот кадра 3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,3                               .слот кадра 3 := СМ
 M7,X-A,2                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,SEK32A                            .если СМ=0 → SEK32A
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SLY*+1                           .мод.адрес := SLY1
 ,XTA,                                  .СМ := слово по адресу SLY1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,SEKA                              .если СМ=0 → SEKA
 ,UJ,SEKB                               .переход на SEKB
C
 SEKA:M7,XTA,1                          .СМ := слот кадра 1
 ,UTC,*SEK*                             .мод.адрес := SEK
 ,ATX,                                  .по адресу SEK := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 SEKB:M7,XTA,1                          .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*TAB*                             .мод.адрес := TAB
 ,XTA,                                  .СМ := слово по адресу TAB
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,SEK1A                             .если СМ=0 → SEK1A
 ,UJ,SEK1B                              .переход на SEK1B
C
 SEK1A:M7,XTA,1                         .СМ := слот кадра 1
 ,UTC,*SEK*+1                           .мод.адрес := SEK1
 ,ATX,                                  .по адресу SEK1 := СМ
 SEK1B:,UJ,POP                          .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР+1                      .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
 ПАРАМЕТР+1:,INT,0
 ЕДИНИЦА:,INT,1
 ДВОЙКА:,INT,2
 ЗНАЧЕНИЕ+1:,BSS,1
 ,END,
