CSYTOBIN - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 5696 образа SIPROD.BIN
CДлина при загрузке: 59 слов, 116 команд
CВход: SYTOBIN
CВыход: RINT:L9, GET (возврат через М15), SETR (возврат через М15),
CADDR (возврат через М15), L58A (возврат через М15),
CWAIT (возврат через М15), ADDRB (возврат через М15),
CL58B (возврат через М15), L101B (возврат через М15)
CАбсолютные символы: N1 = -1, N10 = -10, N48 = -48, N6 = -6, N7 = -7
CСмещения в кадре (М7): общие 0-1, 10, свои 48
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ11 (буфер, счётчик), М12 (магазин, кадр параметров ОС), М13 (счётчик),
CМ14 (смещение в буфере), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 SYTOBIN :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M11:,EQU,11B
 M12:,EQU,12B
 M13:,EQU,13B
 M14:,EQU,14B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 ,UJ,GET                                .переход на GET
C
  :,UJ,СДВИГ_СЧЁТЧИКА_НА_7              .переход на L58
C
  :,UJ,БЛОК_С58_2                       .переход на L58B
C
  :,UJ,БЛОК_С101                        .переход на L101
C
  :,UJ,SETR                             .переход на SETR
C
  :,UJ,WAIT                             .переход на WAIT
C
 GET:M12,XTA,10B                        .СМ := параметр вызова ОС 8
 M10,AAX,5                              .СМ &= поле блока вызывающего 5
 M12,XTS,7                              .магазин + СЧ: 7(М12)
 ,ASN,64-2
 M12,ARX,7                              .СМ += параметр вызова ОС 7 [цикли.]
 ,ASN,64-1
 M17,ARX,                               .СМ += поле контекста 0 [цикли.]
 M12,ATX,7                              .параметр вызова ОС 7 := СМ
 M15,UJ,                                .переход через М15
C
 SETR:,ATI,7                            .М7 := СМ
 M7,UTM,-48                             .М7 += N48
 ,ITA,7                                 .СМ := М7
 M10,AAX,4                              .СМ &= поле блока вызывающего 4
 ,U1A,ADDR                              .если СМ≠0 → ADDR
 M7,UTM,-10                             .М7 += N10
 ,ITA,7                                 .СМ := М7
 M10,AAX,4                              .СМ &= поле блока вызывающего 4
 ,UZA,ADDR                              .если СМ=0 → ADDR
 M7,VTM,                                .М7 := база модуля
 M15,UJ,                                .переход через М15
C
C ВОЗВРАТ В ОС С АДРЕСОМ ВОЗВРАТА В М7
 ADDR:M7,VTM,1                          .М7 := адрес 1
 M15,UJ,                                .переход через М15
C
 СДВИГ_СЧЁТЧИКА_НА_7:M11,UTM,7          .М11 += 7
 M11,VZM,ADDRA                          .если ИР=0 → ADDRA(М11)
 БЛОК_С58:M14,XTA,                      .СМ := смещение в буфере 0
 M11,UTM,-7                             .М11 += N7
 M10,UTC,72B                            .мод.адрес := 58(М10)
 M11,ASX,6                              .сдвиг СМ на М11
 ,YTA,                                  .СМ := РМР (результат мантиссы)
 M10,AAX,1                              .СМ &= поле блока вызывающего 1
 M11,UTM,-1                             .М11 += N1
 M12,ATX,10B                            .параметр вызова ОС 8 := СМ
 M15,UJ,                                .переход через М15
C
 ADDRA:M11,VTM,6                        .М11 := адрес 6
 M14,UTM,1                              .М14 += 1
 ,UJ,БЛОК_С58                           .переход на L58A
C
 WAIT:,NTR,3                            .РЖ := 3 (переходы по нулю)
 M10,A+X,3                              .СМ += поле блока вызывающего 3
 M17,ATX,                               .поле контекста 0 := СМ
 ,ATI,9                                 .М11 := СМ
 ,U1A,ADDRB                             .если СМ≠0 → ADDRB
 M11,VZM,ADDRB                          .если ИР=0 → ADDRB(М11)
 ,NTR,6                                 .РЖ := 6 (обращение к ОС)
 ,UTC,ПАРАМЕТР+1                        .мод.адрес := К0
 ,A-X,                                  .СМ -= слово по адресу К0
 M10,A/X,114B                           .СМ /= поле блока вызывающего 76
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M10,A+X,3                              .СМ += поле блока вызывающего 3
 ,ATI,7                                 .М7 := СМ
 ,NTR,6                                 .РЖ := 6 (обращение к ОС)
 M10,A*X,114B                           .СМ *= поле блока вызывающего 76
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M17,X-A,-1                             .СМ := (адрес) - СМ
 ,STI,9                                 .М11 := СМ; СМ := из магазина
 M15,UJ,                                .переход через М15
C
C ВОЗВРАТ В ОС С ПРИЗНАКОМ ОШИБКИ
 ADDRB:M7,VTM,-1                        .М7 := адрес N1
 M15,UJ,                                .переход через М15
C
 БЛОК_С58_2:M13,VZM,ADDRC               .если ИР=0 → ADDRC(М13)
 M10,XTA,1                              .СМ := поле блока вызывающего 1
 M10,UTC,72B                            .мод.адрес := 58(М10)
 M13,ASX,7                              .сдвиг СМ на М13
 M10,AEX,2                              .СМ ^= поле блока вызывающего 2
 M16,AAX,                               .СМ &= ячейка мод.адреса 0
 M12,XTS,10B                            .магазин + СЧ: 8(М12)
 M10,UTC,72B                            .мод.адрес := 58(М10)
 M13,ASX,7                              .сдвиг СМ на М13
 M13,UTM,1                              .М13 += 1
 M17,AOX,                               .СМ |= поле контекста 0
 M16,ATX,                               .ячейка мод.адреса 0 := СМ
 M15,UJ,                                .переход через М15
C
 ADDRC:M13,VTM,-6                       .М13 := адрес N6
 M16,UTM,1                              .М16 += 1
 ,UJ,БЛОК_С58_2                         .переход на L58B
C
 БЛОК_С101:M10,UTC,101B                 .мод.адрес := '101'(М10)
 M11,VTM,                               .М11 := адрес '101'+М10
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 ,A+X,                                  .СМ += 0
 ,E-N,64+32                             .порядок -= 64+32
 ДЕЛЕНИЕ_В_ЦИКЛЕ:M17,ATX,               .поле контекста 0 := СМ
 M10,A/X,115B                           .СМ /= поле блока вызывающего 77
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M11,A+X,                               .СМ += смещение в буфере 0
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M10,A*X,114B                           .СМ *= поле блока вызывающего 76
 ,NTR,7                                 .РЖ := 7 (исключение, нормализация)
 ,UZA,ЗАВЕРШЕНИЕ_ПРЕОБРАЗОВАНИЯ         .если СМ=0 → L101B
 M17,A+X,                               .СМ += поле контекста 0
 M11,VLM,ДЕЛЕНИЕ_В_ЦИКЛЕ                .М11-- и если ≠0 → повтор
 ЗАВЕРШЕНИЕ_ПРЕОБРАЗОВАНИЯ:M17,XTA,     .СМ := поле контекста 0
 ,E+N,64+32                             .порядок += 64+32
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M10,A+X,3                              .СМ += поле блока вызывающего 3
 M10,AAX,10B                            .СМ &= поле блока вызывающего 8
 M12,ATX,10B                            .параметр вызова ОС 8 := СМ
 M15,UJ,                                .переход через М15
C
 ПАРАМЕТР+1:,LOG,4050000000000000
 ,END,
