CFILLS - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 15072 образа SIPROD.BIN
CДлина при загрузке: 20 слов, 34 команд
CВход: FILLS
CВыход: SPAUD:SCANEW, F2 (возврат через М12), POP (возврат через М10)
CЗАПОЛНЕНИЕ НЕСКОЛЬКИХ СТРОК.
CВнешние: STR, FILL
CСмещения в STR: 24, 25, 26
CСмещения в кадре (М7): общие 0-2, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 FILLS   :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 *STR*   :,LC,27
 FILL    :,SUBP,
 M16,VTM,STR26A                         .М16 := адрес STR26A
 ,UJ,ПЕР_2                              .переход на F2
C
 STR26A:,UTC,*STR*+26                   .мод.адрес := STR26
 ,XTA,                                  .СМ := слово по адресу STR26
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*STR*+24                          .мод.адрес := STR24
 ,A-X,                                  .СМ -= слово по адресу STR24
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,1                               .слот кадра 1 := СМ
 M16,VTM,ЗНАЧЕНИЕ_ЗАПОЛНЕНИЯ            .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,ЗНАЧЕНИЕ_ЗАПОЛНЕНИЯ+1             .мод.адрес := код из V1
 M16,VTM,                               .М16 := код из V1
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,FILL                           .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ПЕР_2:M7,MTJ,8                         .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_ЗАПОЛНЕНИЯ_1           .М7 := адрес К0
 M7,STX,2                               .ЗП + магазин: 2(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ МОДУЛЬ
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ПРИРАЩЕНИЕ ШИРИНЫ ЗАПОЛНЯЕМОЙ ПОЛОСЫ НА ОДИН ЗНАК
C ЗНАЧЕНИЕ 1; ИСПОЛЬЗУЕТСЯ В КОДЕ
 ПАРАМЕТР_ЗАПОЛНЕНИЯ_1:,INT,1
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ ДЛЯ ЗАПОЛНЯЕМОГО СИМВОЛА И ДЛИНЫ ПОЛОСЫ
 ЗНАЧЕНИЕ_ЗАПОЛНЕНИЯ:,BSS,2
 ,END,
