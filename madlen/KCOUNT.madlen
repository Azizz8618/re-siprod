CKCOUNT - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6144 образа SIPROD.BIN
CДлина при загрузке: 10 слов, 18 команд
CВход: KCOUNT
CВыход: PUSH (возврат через М15)
CРегистры: М11 (буфер, счётчик), М13 (счётчик), М15 (адрес возврата),
CМ17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 KCOUNT  :,NAME, NEW DTRAN
 M11:,EQU,11B
 M13:,EQU,13B
 M15:,EQU,15B
 M17:,EQU,17B
 ,ATI,9                                 .М11 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M11,XTA,                               .СМ := смещение в буфере 0
 ,UTC,ПАРАМЕТР_1                        .мод.адрес := К0
 ,X-A,                                  .СМ := слово по адресу К0 - СМ
 ,STI,9                                 .М11 := СМ; СМ := из магазина
 ,ATI,11                                .М13 := СМ
 M11,UTM,1                              .М11 += 1
 ,XTA,                                  .СМ := 0
 PUSH:M13,XTS,                          .магазин + СЧ: 0(М13)
 M17,ACX,                               .СМ := кол-во единиц в поле контекста
 M13,UTM,1                              .М13 += 1
 M11,VLM,PUSH                           .М11-- и если ≠0 → повтор
 ,UTC,ПАРАМЕТР_1                        .мод.адрес := К0
 ,AOX,                                  .СМ |= слово по адресу К0
 M15,UJ,                                .переход через М15
C
C ЧИСЛА: НУЛЕВАЯ КОНСТАНТА ДЛЯ СБРОСА СЧЁТЧИКА И ПРИЗНАКА В СЛОВЕ
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ - 2 ССЫЛ.
 ПАРАМЕТР_1:,INT,0
 ,END,
