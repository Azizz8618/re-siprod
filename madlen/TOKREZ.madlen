CTOKREZ - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 18464 образа SIPROD.BIN
CДлина при загрузке: 87 слов, 142 команд
CВход: TOKREZ
CВыход: SPAUD:F1C, F6B (возврат через М12), POP (возврат через М10)
CВнешние: SCANER, INS, KLAIDA, RSYMB, SYTINT, SCAN
CСмещения в INS: 24, 25, 26
CСмещения в SCANER: 1, 2
CАбсолютные символы: N1 = -1
CСмещения в кадре (М7): общие 0-1, 3-6, 8-10, свои 12-14,
Cвне кадра 2060
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес),
CМ17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 TOKREZ  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *SCANER*:,LC,3
 *INS*   :,LC,27
 KLAIDA  :,SUBP,
 RSYMB   :,SUBP,
 SYTINT  :,SUBP,
 SCAN    :,SUBP,
 M16,VTM,ЗАПОМНИТЬ_ПОЗИЦИЮ_СТАРТА       .М16 := адрес F1
 ,UJ,ЗАВЕРШЕНИЕ_МОДУЛЯ                  .переход на F6B
C
 ЗАПОМНИТЬ_ПОЗИЦИЮ_СТАРТА:M7,XTA,1      .СМ := слот кадра 1
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ПОДСЧЁТ_СИМВОЛОВ_ТОКЕНА:M7,XTA,-1      .СМ := каталог задачи: элемент 12
 ,WTC,ИНДЕКС_КАТАЛОГА                   .мод.адрес := код из V1
 M1,VTM,                                .М1 := код из V1
 ,WTC,БАЗА_АДРЕСА                       .мод.адрес := код из V6
 M1,ATX,-1                              .каталог задачи: элемент 12 := СМ
  :7,XTA,10B                            .СМ := слот кадра 8
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,10B                             .слот кадра 8 := СМ
 M7,X-A,4                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ПОДСЧЁТ_СИМВОЛОВ_ТОКЕНА           .если СМ=0 → F1A
 M7,XTA,                                .СМ := слот кадра 0
 ,WTC,УКАЗАТЕЛЬ_БУФЕРА                  .мод.адрес := код из V7
 ,ATX,                                  .по адресу V7 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 SCANA:M15,VJM,SCAN                     .вызов через М15
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,11B                             .слот кадра 9 := СМ
 M7,XTA,3                               .СМ := слот кадра 3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,SCANEA                            .если СМ=0 → SCANEA
 ,UJ,SCANEC                             .переход на SCANEC
C
C ПРОВЕРКА КОНЦА СТРОКИ ПРИ ВЫВОДЕ СИМВОЛОВ
 SCANEA:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A-X,                                  .СМ -= слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,SCANEB                            .если СМ≠0 → SCANEB
 ,UJ,SCANEC                             .переход на SCANEC
C
 SCANEB:,UJ,SCANA                       .переход на SCANA
C
 SCANEC:M7,XTA,5                        .СМ := слот кадра 5
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,SCANED                            .если СМ≠0 → SCANED
 ,UJ,SCANEE                             .переход на SCANEE
C
 SCANED:,UJ,ВЫВОД_ОШИБКИ_ТОКЕНА         .переход на F6
C
C ВЫВОД СИМВОЛОВ СТРОКИ ЧЕРЕЗ SYTINT И RSYMB
 SCANEE:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,12B                             .слот кадра 10 := СМ
 M16,VTM,*INS*                          .М16 := адрес INS
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ВТОРОЕ_ЗНАЧЕНИЕ                .М16 := адрес V3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ                       .М16 := адрес V4
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,SYTINT                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,12B                             .СМ := слот кадра 10
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,WTC,УКАЗАТЕЛЬ_БУФЕРА                  .мод.адрес := код из V7
 ,XTA,                                  .СМ := слово по адресу V7
 M7,A+X,1                               .СМ += слот кадра 1
 ,WTC,УКАЗАТЕЛЬ_БУФЕРА                  .мод.адрес := код из V7
 ,ATX,                                  .по адресу V7 := СМ
 M16,VTM,ЗНАЧЕНИЕ                       .М16 := адрес V4
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,БАЗА_АДРЕСА                       .мод.адрес := код из V6
 M16,VTM,                               .М16 := код из V6
 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,УКАЗАТЕЛЬ_БУФЕРА                  .мод.адрес := код из V7
 M16,VTM,                               .М16 := код из V7
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A-X,                                  .СМ -= слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,ПРОДОЛЖЕНИЕ_ЧТЕНИЯ                .если СМ≠0 → F10
 ,UJ,ПЕРЕХОД_К_ЗАВЕРШЕНИЮ               .переход на F10A
C
 ПРОДОЛЖЕНИЕ_ЧТЕНИЯ:,UJ,SCANA           .переход на SCANA
C
 ПЕРЕХОД_К_ЗАВЕРШЕНИЮ:,UJ,ПЕРЕХОД_К_ВОЗВРАТУ.переход на F6A
C
 ВЫВОД_ОШИБКИ_ТОКЕНА:M7,XTA,6           .СМ := слот кадра 6
 M7,ATX,14B                             .слот кадра 12 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M16,VTM,ЗНАЧЕНИЕ+1                     .М16 := адрес V5
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,KLAIDA                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ПЕРЕХОД_К_ВОЗВРАТУ:,UJ,POP             .переход на POP
C
C ВОЗВРАТ В ОС
 ЗАВЕРШЕНИЕ_МОДУЛЯ:M7,MTJ,8             .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К1
 M7,STX,16B                             .ЗП + магазин: 14(М7)
 M7,STX,15B                             .ЗП + магазин: 13(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: ПРОБЕЛЫ ДЛЯ ОЧИСТКИ БУФЕРА ВЫВОДА ТОКЕНА
  МАСКА_ПРОБЕЛОВ:,ISO,6H       ... 040 040 040 040 040 040
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ РАЗБОРА ТОКЕНА: НОМЕР ПОЛЯ 6 И КОД ОШИБКИ 61
 КОД_1:,INT,0
 КОД_2:,INT,1
 КОД_3:,INT,6
 КОД_4:,INT,8
 КОД_5:,INT,10
 КОД_6:,INT,19
 КОД_7:,INT,61
C ПЕРЕМЕННЫЕ МОДУЛЯ, ИСПОЛЬЗУЮТСЯ В РАЗБОРЕ
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ РАЗБОРА ТОКЕНА: ИНДЕКС КАТАЛОГА, БАЗА АДРЕСА И УКАЗАТЕЛЬ БУФЕРА
 РАБОЧИЕ_ПОЛЯ_МОДУЛЯ:,BSS,1
 ИНДЕКС_КАТАЛОГА:,BSS,2
 ВТОРОЕ_ЗНАЧЕНИЕ:,BSS,1
 ЗНАЧЕНИЕ:,BSS,2
 БАЗА_АДРЕСА:,BSS,1
 УКАЗАТЕЛЬ_БУФЕРА:,BSS,1
 ,END,
