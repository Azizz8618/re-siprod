CREADNB - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6176 образа SIPROD.BIN
CДлина при загрузке: 115 слов, 202 команд
CВход: READNB
CВыход: IPONUM:F1, ONEPLA:PAGE1A, F1C (возврат через М12),
CF1D (возврат через М10)
CВнешние: INS, NUM, SCANER, NBR, KLAIDA, SYTINT, RNSYMB, SCAN
CСмещения в INS: 24, 25, 26
CСмещения в NUM: 1, 2, 3
CСмещения в SCANER: 1, 2
CАбсолютные символы: N1 = -1
CСмещения в кадре (М7): общие 0-6, 8-10, свои 11-12, вне кадра 2064
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 READNB  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *INS*   :,LC,27
 *NUM*   :,LC,4
 *SCANER*:,LC,3
 *NBR*   :,LC,1
 KLAIDA  :,SUBP,
 SYTINT  :,SUBP,
 RNSYMB  :,SUBP,
 SCAN    :,SUBP,
 M16,VTM,ПЕР_0                          .М16 := адрес F0
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F1C
C
 ПЕР_0:M7,XTA,                          .СМ := слот кадра 0
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 SCANA:M15,VJM,SCAN                     .вызов через М15
 M7,XTA,3                               .СМ := слот кадра 3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,SCANEA                            .если СМ=0 → SCANEA
 ,UJ,SCANEC                             .переход на SCANEC
C
C ПРОВЕРКА КОНЦА ЧИСЛА ПРИ ЧТЕНИИ ВХОДНОГО ПОТОКА
 SCANEA:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A-X,                                  .СМ -= слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,SCANEB                            .если СМ≠0 → SCANEB
 ,UJ,SCANEC                             .переход на SCANEC
C
 SCANEB:,UJ,SCANA                       .переход на SCANA
C
C ПРОВЕРКА КОНЦА ЧИСЛА ПОСЛЕ ЧТЕНИЯ СИМВОЛА
 SCANEC:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A-X,                                  .СМ -= слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,SCANED                            .если СМ≠0 → SCANED
 ,UJ,SCANEE                             .переход на SCANEE
C
 SCANED:,UJ,ПЕР_8                       .переход на F8
C
 SCANEE:M7,XTA,3                        .СМ := слот кадра 3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,ЦИКЛ_ПЕРЕХОД                      .если СМ≠0 → F3
 ,UJ,ПЕР_6                              .переход на F6
C
 ЦИКЛ_ПЕРЕХОД:,UJ,ПЕР_8                 .переход на F8
C
 ПЕР_6:M7,XTA,6                         .СМ := слот кадра 6
 M7,ATX,11B                             .слот кадра 9 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВЫЗОВ_KLAIDA                       .переход на F1A
C
 ПЕР_8:M7,XTA,10B                       .СМ := слот кадра 8
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,10B                             .слот кадра 8 := СМ
 M7,XTA,2                               .СМ := слот кадра 2
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,10B                             .СМ := слот кадра 8
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,NUM2A                             .если СМ=0 → NUM2A
 ,UJ,NUM2B                              .переход на NUM2B
C
 NUM2A:,UJ,SCANEH                       .переход на SCANEH
C
 NUM2B:M7,XTA,                          .СМ := слот кадра 0
 ,UTC,*NUM*+2                           .мод.адрес := NUM2
 ,ATX,                                  .по адресу NUM2 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,12B                             .слот кадра 10 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 NUM2C:,UTC,*NUM*+2                     .мод.адрес := NUM2
 ,XTA,                                  .СМ := слово по адресу NUM2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 ,UTC,*NUM*+2                           .мод.адрес := NUM2
 ,ATX,                                  .по адресу NUM2 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,SCAN                           .вызов через М15
 M7,XTA,3                               .СМ := слот кадра 3
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SCANER*+1                        .мод.адрес := SCANER1
 ,XTA,                                  .СМ := слово по адресу SCANER1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,SCANEF                            .если СМ≠0 → SCANEF
 ,UJ,NUM2E                              .переход на NUM2E
C
 SCANEF:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 ,UTC,*INS*+26                          .мод.адрес := INS26
 ,A+X,                                  .СМ += слово по адресу INS26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,NUM2D                             .если СМ=0 → NUM2D
 ,UJ,NUM2E                              .переход на NUM2E
C
 NUM2D:,UJ,NUM2C                        .переход на NUM2C
C
C ПРОВЕРКА СОВПАДЕНИЯ ПРОЧИТАННОГО ЧИСЛА С ЗАДАННЫМ
 NUM2E:,UTC,*NUM*+2                     .мод.адрес := NUM2
 ,XTA,                                  .СМ := слово по адресу NUM2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,4                               .СМ += слот кадра 4
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,NUM2F                             .если СМ≠0 → NUM2F
 ,UJ,NUM2G                              .переход на NUM2G
C
 NUM2F:M7,XTA,4                         .СМ := слот кадра 4
 ,UTC,*NUM*+2                           .мод.адрес := NUM2
 ,ATX,                                  .по адресу NUM2 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ФОРМИРОВАНИЕ ТЕКСТА ОШИБКИ ОБ ОТСУТСТВИИ ЧИСЕЛ
 NUM2G:M7,XTA,-1                        .СМ := каталог задачи: таблица страниц
 ,UTC,*NUM*                             .мод.адрес := NUM
 ,ATX,                                  .по адресу NUM := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,-1                              .СМ := каталог задачи: таблица страниц
 ,UTC,*NUM*+1                           .мод.адрес := NUM1
 ,ATX,                                  .по адресу NUM1 := СМ
 M7,XTA,5                               .СМ := слот кадра 5
 ,UTC,*NUM*+2                           .мод.адрес := NUM2
 ,A-X,                                  .СМ -= слово по адресу NUM2
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,13B                             .слот кадра 11 := СМ
 M16,VTM,*INS*                          .М16 := адрес INS
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕН2ИЕ_ЧТЕНИЯ_2             .М16 := адрес V3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*NUM*                          .М16 := адрес NUM
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕН3ИЕ_ЧТЕНИЯ_3             .М16 := адрес V4
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*NUM*+2                        .М16 := адрес NUM2
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 ,UTC,*SCANER*                          .мод.адрес := SCANER
 ,ATX,                                  .по адресу SCANER := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*NBR*                             .мод.адрес := NBR
 ,XTA,                                  .СМ := слово по адресу NBR
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ2_ПЕРЕХОД                     .если СМ=0 → F1
 ,UJ,SCANEG                             .переход на SCANEG
C
 ЦИКЛ2_ПЕРЕХОД:,UJ,ЦИКЛ3_ПЕРЕХОД        .переход на F1B
C
 SCANEG:,UJ,SCANA                       .переход на SCANA
C
 SCANEH:,UTC,*SCANER*                   .мод.адрес := SCANER
 ,XTA,                                  .СМ := слово по адресу SCANER
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,14B                             .слот кадра 12 := СМ
 M16,VTM,*INS*                          .М16 := адрес INS
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕН4ИЕ_ЧТЕНИЯ_4             .М16 := адрес V5
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*NUM*+3                        .М16 := адрес NUM3
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,SYTINT                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ЦИКЛ3_ПЕРЕХОД                      .переход на F1B
C
 ВЫЗОВ_KLAIDA:M16,VTM,ЗНАЧЕНИЕ_ЧТЕНИЯ_1 .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,KLAIDA                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ЦИКЛ3_ПЕРЕХОД:,UJ,ВОЗВРА2Т_В_БЛОК      .переход на F1D
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРА2Т_В_БЛОК:,STI,                  .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: МАСКА ИЗ ШЕСТИ ПРОБЕЛОВ - ОБРАЗЕЦ ПРОБЕЛА ПРИ ЧТЕНИИ ЧИСЛА
 МАСКА_ПРОБЕЛОВ:,ISO,6H       .. 040 040 040 040 040 040
C ЧИСЛА: КОДЫ СИМВОЛОВ ЧИСЛА И НОМЕР ОШИБКИ 102 - В БЛОКЕ *HCH НЕТ ЧИСЕЛ
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 2; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_3:,INT,2
C ЗНАЧЕНИЕ 8; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_4:,INT,8
C ЗНАЧЕНИЕ 11; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_5:,INT,11
C ЗНАЧЕНИЕ 12; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_6:,INT,12
C ЗНАЧЕНИЕ 102; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_7:,INT,102
C РАБОЧИЕ ЯЧЕЙКИ ЧТЕНИЯ: ПОЗИЦИЯ В ПОТОКЕ И СЧЁТЧИК
C ПЕРЕМЕННЫЕ: ПОЗИЦИЯ В ПОТОКЕ, СЧЁТЧИК И ЗНАЧЕНИЕ ПРОЧИТАННОГО ЧИСЛА
 ЯЧЕЙКИ_ЧТЕНИЯ:,BSS,2
 ЗНАЧЕНИЕ_ЧТЕНИЯ_1:,BSS,1
 ЗНАЧЕН2ИЕ_ЧТЕНИЯ_2:,BSS,1
 ЗНАЧЕН3ИЕ_ЧТЕНИЯ_3:,BSS,1
 ЗНАЧЕН4ИЕ_ЧТЕНИЯ_4:,BSS,1
 ,END,
