CRWINF - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 17440 образа SIPROD.BIN
CДлина при загрузке: 42 слов, 74 команд
CВход: RWINF
CВыход: ANATXT:SCANEC, SEGTAB:STR25A, SEKGIR:F7D, SEKGIR:LRE32B,
CSEKGIR:F2B, SEKLYG:NUST8A, F1A (возврат через М12),
CF1B (возврат через М10)
CВнешние: INF, RWBIT, IBIT
CСмещения в INF: 1, 2
CСмещения в кадре (М7): общие 0-1, 3-4, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 RWINF   :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *INF*   :,LC,3
 RWBIT   :,SUBP,
 IBIT    :,SUBP,
 M16,VTM,INF1A                          .М16 := адрес INF1A
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F1A
C
C ПРОВЕРКА НАЛИЧИЯ ДАННЫХ В БУФЕРЕ INF
 INF1A:,UTC,*INF*+1                     .мод.адрес := INF1
 ,XTA,                                  .СМ := слово по адресу INF1
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,                                .СМ += слот кадра 0
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,JMP                               .если СМ=0 → JMP
 ,UJ,ADDR                               .переход на ADDR
C
 JMP:,UJ,INF2B                          .переход на INF2B
C
 ADDR:M16,VTM,*INF*                     .М16 := адрес INF
 ,ITA,14                                .СМ := М16
 M16,VTM,*INF*+1                        .М16 := адрес INF1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,IBIT                           .вызов через М15
 M7,ATX,3                               .слот кадра 3 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,1                               .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,3                               .СМ := слот кадра 3
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F3
 ,UJ,ВЫЗОВ_RWBIT                        .переход на F1
C
 ЦИКЛ_ПЕРЕХОД:,UJ,INF2A                 .переход на INF2A
C
C ЗАПИСЬ ОЧЕРЕДНОГО РАЗРЯДА В БУФЕР INF
 ВЫЗОВ_RWBIT:M7,XTA,1                   .СМ := слот кадра 1
 M7,ATX,4                               .слот кадра 4 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M16,VTM,ЗНАЧЕНИЕ_1                     .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ_1                     .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*INF*                          .М16 := адрес INF
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*INF*+1                        .М16 := адрес INF1
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,RWBIT                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*INF*+2                           .мод.адрес := INF2
 ,ATX,                                  .по адресу INF2 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,INF2B                              .переход на INF2B
C
 INF2A:M7,XTA,1                         .СМ := слот кадра 1
 ,UTC,*INF*+2                           .мод.адрес := INF2
 ,ATX,                                  .по адресу INF2 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 INF2B:,UJ,ВОЗВРАТ_В_БЛОК               .переход на F1B
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_1                      .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ ПРОВЕРКИ: НОЛЬ И ЕДИНИЦА ДЛЯ БУФЕРА INF
C ИСПОЛЬЗУЕТСЯ В КОДЕ (1)
 ПАРАМЕТР_1:,INT,0
C В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 ЕДИНИЦА:,INT,1
C ПЕРЕМЕННЫЕ МОДУЛЯ, ИСПОЛЬЗУЮТСЯ В РАЗБОРЕ
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ ЗАПИСИ РАЗРЯДА В INF: СЧЁТЧИК И ЗНАЧЕНИЕ СИМВОЛА
 РАБОЧИЕ_ПОЛЯ_МОДУЛЯ:,BSS,2
 ЗНАЧЕНИЕ_1:,BSS,1
 ,END,
