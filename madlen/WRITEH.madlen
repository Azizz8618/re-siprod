CWRITEH - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 7488 образа SIPROD.BIN
CДлина при загрузке: 27 слов, 48 команд
CВход: WRITEH
CВыход: F0B (возврат через М12), F0C (возврат через М10)
CГЕНЕРАТОР РЕЖИМА *HCH: ИЕРАРХИЧЕСКАЯ СХЕМА,
CУЗЕЛ И 2-5 ПОДЧИНЁННЫХ УЗЛОВ.
CВнешние: NUNU, NUST, GOT, REGIM, TWOPLA, WRIVER, WRIHOR, WRILIN,
CONEPLA, WRIKOR
CСмещения в кадре (М7): общие 0-1, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 WRITEH  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *NUNU*  :,LC,1
 *NUST*  :,LC,10
 *GOT*   :,LC,1
 *REGIM* :,LC,16
 TWOPLA  :,SUBP,
 WRIVER  :,SUBP,
 WRIHOR  :,SUBP,
 WRILIN  :,SUBP,
 ONEPLA  :,SUBP,
 WRIKOR  :,SUBP,
 M16,VTM,GOTA                           .М16 := адрес GOTA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F0B
C
 GOTA:M7,XTA,                           .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*GOT*                             .мод.адрес := GOT
 ,XTA,                                  .СМ := слово по адресу GOT
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F0
 ,UJ,ВЫЗОВ_WRIKOR                       .переход на F0A
C
 ЦИКЛ_ПЕРЕХОД:,UJ,ONEPLB                .переход на ONEPLB
C
 ВЫЗОВ_WRIKOR:M16,VTM,ПАРАМЕТР_СХЕМЫ    .М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ПАРАМЕТР_СХЕМЫ+1               .М16 := адрес К1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ПАРАМЕТР_СХЕМЫ+2               .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ONEPLB:M15,VJM,ONEPLA                  .вызов через М15
 M15,VJM,WRILIN                         .вызов через М15
 M15,VJM,WRIHOR                         .вызов через М15
 M15,VJM,WRIVER                         .вызов через М15
 M15,VJM,TWOPLA                         .вызов через М15
 ,UJ,ВОЗВРАТ_В_БЛОК                     .переход на F0C
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_СХЕМЫ+1                .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C КОМАНДЫ: КОМАНДА *P - НОВАЯ СТРАНИЦА, С КОТОРОЙ НАЧИНАЕТСЯ СХЕМА *HCH
 ПАРАМЕТР_СХЕМЫ:,ISO, 6H*P     . 052 120 040 040 040 040
C ЧИСЛА: ЧИСЛА ПАРАМЕТРОВ ВЫПИСКИ КОМАНДЫ *P В БУФЕР ВЫВОДА СХЕМЫ
C ПАРАМЕТР ВЫЗОВА WRIKOR (1); ИСПОЛЬЗУЕТСЯ В КОДЕ (1)
 ПАРАМЕТР_СХЕМЫ+1:,INT,1
C ПАРАМЕТР ВЫЗОВА WRIKOR (1)
 ПАРАМЕТР_СХЕМЫ+2:,INT,2
 ,END,
