CWTBACK - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 18816 образа SIPROD.BIN
CДлина при загрузке: 54 слов, 98 команд
CВход: WTBACK
CВыход: BEGPG:PAGE3D, RASTXT:STR25A, F2 (возврат через М12),
CF2A (возврат через М10)
CВнешние: PUS, REGIM, STR
CСмещения в STR: 24, 25, 26
CСмещения в кадре (М7): общие 0-4, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 WTBACK  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M16:,EQU,16B
 M17:,EQU,17B
 *PUS*   :,LC,1
 *REGIM* :,LC,16
 *STR*   :,LC,27
 M16,VTM,REGIMA                         .М16 := адрес REGIMA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F2
C
 REGIMA:M7,XTA,1                        .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*REGIM*                           .мод.адрес := REGIM
 ,XTA,                                  .СМ := слово по адресу REGIM
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,PUSA                              .если СМ≠0 → PUSA
 ,UJ,PUSB                               .переход на PUSB
C
 PUSA:,UJ,STR25E                        .переход на STR25E
C
 PUSB:M7,XTA,                           .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*PUS*                             .мод.адрес := PUS
 ,XTA,                                  .СМ := слово по адресу PUS
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,STR25A                            .если СМ=0 → STR25A
 ,UJ,PUSD                               .переход на PUSD
C
 STR25A:,UTC,*STR*+25                   .мод.адрес := STR25
 ,XTA,                                  .СМ := слово по адресу STR25
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,3                               .СМ -= слот кадра 3
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,PUSC                              .если СМ≠0 → PUSC
 ,UJ,PUSD                               .переход на PUSD
C
 PUSC:,UJ,STR25E                        .переход на STR25E
C
 PUSD:M7,XTA,1                          .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*PUS*                             .мод.адрес := PUS
 ,XTA,                                  .СМ := слово по адресу PUS
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,STR25B                            .если СМ=0 → STR25B
 ,UJ,PUSF                               .переход на PUSF
C
 STR25B:,UTC,*STR*+25                   .мод.адрес := STR25
 ,XTA,                                  .СМ := слово по адресу STR25
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,3                               .СМ -= слот кадра 3
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,PUSE                              .если СМ=0 → PUSE
 ,UJ,PUSF                               .переход на PUSF
C
 PUSE:,UJ,STR25E                        .переход на STR25E
C
 PUSF:M7,XTA,2                          .СМ := слот кадра 2
 M7,ATX,4                               .слот кадра 4 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*PUS*                             .мод.адрес := PUS
 ,XTA,                                  .СМ := слово по адресу PUS
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,STR25C                            .если СМ=0 → STR25C
 ,UJ,STR25D                             .переход на STR25D
C
 STR25C:M7,XTA,2                        .СМ := слот кадра 2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,ATX,4                               .слот кадра 4 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 STR25D:,UTC,*STR*+25                   .мод.адрес := STR25
 ,XTA,                                  .СМ := слово по адресу STR25
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,4                               .СМ += слот кадра 4
 ,UTC,*STR*+25                          .мод.адрес := STR25
 ,ATX,                                  .по адресу STR25 := СМ
 ,UTC,*STR*+26                          .мод.адрес := STR26
 ,XTA,                                  .СМ := слово по адресу STR26
 M7,A+X,4                               .СМ += слот кадра 4
 ,UTC,*STR*+26                          .мод.адрес := STR26
 ,ATX,                                  .по адресу STR26 := СМ
 ,UTC,*STR*+25                          .мод.адрес := STR25
 ,XTA,                                  .СМ := слово по адресу STR25
 ,UTC,*STR*+24                          .мод.адрес := STR24
 ,ATX,                                  .по адресу STR24 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 STR25E:,UJ,ВОЗВРАТ_В_БЛОК              .переход на F2A
C
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛА ПОЗИЦИЙ ТЕКСТА ПРИ ВОЗВРАТЕ УКАЗАТЕЛЯ НАЗАД: 1, 64, 70
 КОД_1:,INT,0
 КОД_2:,INT,1
 КОД_3:,INT,64
 КОД_4:,INT,70
C ПЕРЕМЕННЫЕ МОДУЛЯ, ИСПОЛЬЗУЮТСЯ В РАЗБОРЕ
C ПЕРЕМЕННЫЕ: РАБОЧИЕ ПОЛЯ МОДУЛЯ ВОЗВРАТА УКАЗАТЕЛЯ ТЕКСТА
 РАБОЧИЕ_ПОЛЯ_МОДУЛЯ:,BSS,1
 ,END,
