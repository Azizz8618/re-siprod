CFILL - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 14976 образа SIPROD.BIN
CДлина при загрузке: 75 слов, 128 команд
CВход: FILL
CВыход: FILLS:F2, SPAUD:NUST4A, SPAUD:SCAN46, F3C (возврат через М12),
CF3D (возврат через М10)
CЗАПОЛНЕНИЕ СТРОКИ СИМВОЛОМ ПО ШИРИНЕ ПОЛЯ.
CВнешние: *STR*, *NDAB*, BEGSTR, ENDSTR, RSYMB
CСмещения в *NDAB*: 1, 2
CСмещения в *STR*: 24, 25, 26
CСмещения в кадре (М7): общие 0-1, 3-10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес), М17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 FILL    :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C STR: СТРОКА ТЕКСТА: ТЕКУЩАЯ СТРОКА И ЕЁ ГРАНИЦЫ (27 СЛОВ)
 *STR*   :,LC,27
C NDAB: СЧЁТЧИКИ ВХОДНЫХ ДАННЫХ: НОМЕР И ДЛИНА (4 СЛОВА)
 *NDAB*  :,LC,4
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 BEGSTR  :,SUBP,
 ENDSTR  :,SUBP,
 RSYMB   :,SUBP,
 M16,VTM,STR26A                         .М16 := адрес STR26A
 ,UJ,ПЕР_10                             .переход на F3C
C
 STR26A:,WTC,ЯЧ_СЧЁТ                    .мод.адрес := код из V6
 ,XTA,                                  .СМ := слово по адресу V6
 M7,ATX,3                               .слот кадра 3 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 STR26B:,UTC,*STR*+26                   .мод.адрес := STR26
 ,XTA,                                  .СМ := слово по адресу STR26
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*STR*+24                          .мод.адрес := STR24
 ,A-X,                                  .СМ -= слово по адресу STR24
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,4                               .слот кадра 4 := СМ
 M7,XTA,3                               .СМ := слот кадра 3
 M7,ATX,5                               .слот кадра 5 := СМ
 M7,XTA,3                               .СМ := слот кадра 3
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,4                               .СМ += слот кадра 4
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,STR24A                            .если СМ≠0 → STR24A
 ,UJ,STR24B                             .переход на STR24B
C
 STR24A:M7,XTA,4                        .СМ := слот кадра 4
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 STR24B:,UTC,*STR*+24                   .мод.адрес := STR24
 ,XTA,                                  .СМ := слово по адресу STR24
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,1                               .СМ -= слот кадра 1
 M7,ATX,6                               .слот кадра 6 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 M7,ATX,7                               .слот кадра 7 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,STR24C                             .переход на STR24C
C
 ВЫЗОВ_RSYMB:M7,XTA,6                   .СМ := слот кадра 6
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,6                               .слот кадра 6 := СМ
 ,WTC,ЯЧ_ПОЛЯ                           .мод.адрес := код из V7
 M16,VTM,                               .М16 := код из V7
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ШИР_ПОЛЯ                       .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*STR*                          .М16 := адрес STR
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,БУФ_ЗНАКА                      .М16 := адрес V3
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,7                               .СМ := слот кадра 7
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,7                               .слот кадра 7 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 STR24C:M7,X-A,5                        .СМ := (адрес) - СМ
 ,UZA,ВЫЗОВ_RSYMB                       .если СМ=0 → F6
 ,UTC,*STR*+24                          .мод.адрес := STR24
 ,XTA,                                  .СМ := слово по адресу STR24
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,5                               .СМ += слот кадра 5
 ,UTC,*STR*+24                          .мод.адрес := STR24
 ,ATX,                                  .по адресу STR24 := СМ
 M7,XTA,3                               .СМ := слот кадра 3
 M7,A-X,5                               .СМ -= слот кадра 5
 M7,ATX,3                               .слот кадра 3 := СМ
 ,UTC,*STR*+24                          .мод.адрес := STR24
 ,XTA,                                  .СМ := слово по адресу STR24
 ,X-A,                                  .СМ := (адрес) - СМ
 ,UTC,*STR*+26                          .мод.адрес := STR26
 ,A+X,                                  .СМ += слово по адресу STR26
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,NDAB1A                            .если СМ=0 → NDAB1A
 ,UJ,NDAB1B                             .переход на NDAB1B
C
 NDAB1A:,UJ,ПЕР_3                       .переход на F3
C
 NDAB1B:,UTC,*NDAB*+1                   .мод.адрес := NDAB1
 ,XTA,                                  .СМ := слово по адресу NDAB1
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,ENDSTR                         .вызов через М15
 M7,XTA,10B                             .СМ := слот кадра 8
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*NDAB*+1                          .мод.адрес := NDAB1
 ,XTA,                                  .СМ := слово по адресу NDAB1
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,BEGSTA                            .если СМ=0 → BEGSTA
 ,UJ,ПЕР_3                              .переход на F3
C
 BEGSTA:M15,VJM,BEGSTR                  .вызов через М15
 ПЕР_3:M7,XTA,3                         .СМ := слот кадра 3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,                                .СМ += слот кадра 0
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,ЦИКЛ_ПЕРЕХОД                      .если СМ≠0 → F3A
 ,UJ,ЦИКЛ2_ПЕРЕХОД                      .переход на F3B
C
 ЦИКЛ_ПЕРЕХОД:,UJ,STR26B                .переход на STR26B
C
 ЦИКЛ2_ПЕРЕХОД:,UJ,ВОЗВРАТ_В_БЛОК       .переход на F3D
C
 ПЕР_10:M7,MTJ,8                        .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,СЧЁТ_0_1                        .М7 := адрес К0
 M7,STX,12B                             .ЗП + магазин: 10(М7)
 M7,STX,11B                             .ЗП + магазин: 9(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ: ШИРИНА ПОЛЯ 6 И КОДЫ СЧЁТЧИКОВ ЗАПОЛНЕНИЯ
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 СЧЁТ_0_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 ЕДИНИЦА:,INT,1
C ЗНАЧЕНИЕ 6; ПАРАМЕТР ВЫЗОВА RSYMB
 ШИР_ПОЛЯ:,INT,6
C ПЕРЕМЕННЫЕ МОДУЛЯ, ИСПОЛЬЗУЮТСЯ В РАЗБОРЕ
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ ЗАПОЛНЕНИЯ: БУФЕР ЗНАКА, СЧЁТЧИК И ГРАНИЦЫ ПОЛЯ
 РАБОЧИЕ_ПОЛЯ_МОДУЛЯ:,BSS,3
 БУФ_ЗНАКА:,BSS,3
 ЯЧ_СЧЁТ:,BSS,1
 ЯЧ_ПОЛЯ:,BSS,1
 ,END,
