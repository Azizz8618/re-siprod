CGOSTAS - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 21024 образа SIPROD.BIN
CДлина при загрузке: 32 слов, 42 команд
CВход: GOSTAS
CВыход: SCHEMA:NUSTB, SCHEMA:F2B, L0032 (возврат через М12),
CPOP (возврат через М10)
CПРИВЕДЕНИЕ ТЕКСТА К КОДИРОВКЕ ГОСТ.
CВнешние: LOL
CСмещения в LOL: 7
CСмещения в кадре (М7): общие 0-2, 10
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 GOSTAS  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M16:,EQU,16B
 *LOL*   :,LC,16
 LOL32767:,EQU,*LOL*   -32767
 M16,VTM,LOL327                         .М16 := адрес LOL327
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на L0032
C
 LOL327:M7,XTA,                         .СМ := слот кадра 0
 M7,ATX,2                               .слот кадра 2 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C КОПИРОВАНИЕ СЛОВ ТЕКСТА В ТАБЛИЦЫ КОДИРОВКИ ГОСТ
 LOL32A:,WTC,ЗНАЧЕНИЕ_ГОСТ              .мод.адрес := код из V0
 M1,VTM,                                .М1 := код из V0
 M1,UTC,ЗНАЧЕНИЕ_ГОСТ                   .мод.адрес := V0(М1)
 ,XTA,                                  .СМ := слово по адресу V0+М1
 M1,UTC,LOL32767                        .мод.адрес := LOL32767(М1)
 ,ATX,                                  .по адресу LOL32767+М1 := СМ
 ,WTC,ЗНАЧЕНИЕ_ГОСТ                     .мод.адрес := код из V0
 M1,VTM,                                .М1 := код из V0
 M1,UTC,ЗНАЧЕНИЕ_ГОСТ                   .мод.адрес := V0(М1)
 ,XTA,                                  .СМ := слово по адресу V0+М1
 M1,UTC,*LOL*+7                         .мод.адрес := LOL7(М1)
 ,ATX,                                  .по адресу LOL7+М1 := СМ
 M7,XTA,2                               .СМ := слот кадра 2
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,2                               .слот кадра 2 := СМ
 M7,X-A,1                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,LOL32A                            .если СМ=0 → LOL32A
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_ГОСТ_1                 .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
 ПАРАМЕТР_ГОСТ_1:,INT,1
 ВОСЕМЬ:,INT,8
C БУФЕР ПРИВЕДЕНИЯ ТЕКСТА К КОДИРОВКЕ ГОСТ
 БУФЕР_ПРИВЕДЕНИЯ_К_ГОСТ:,BSS,9
 ,DATA,
 ЗНАЧЕНИЕ_ГОСТ:,INT,64
 ЗНАЧЕНИЕ_ГОСТ+1:,INT,66
 ПЯТЬ:,INT,5
 КОНСТАНТА_56:,INT,56
 ТРОЙКА:,INT,3
 ТРОЙКА_2:,INT,3
 ШЕСТЬДЕСЯТ:,INT,60
 ТРОЙКА_3:,INT,3
 M10,SET,ЗНАЧЕНИЕ_ГОСТ
 M1,   ,ЗНАЧЕНИЕ_ГОСТ+1
 ,END,
