 ВОЗВРАТ_В_БЛОК:,STI,                   .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C КОМАНДЫ: КОМАНДЫ ВЫВОДА УЗЛА СХЕМЫ: *MD - ПО ЦЕНТРУ, *NU*ND - БЕЗ ЛИНЕЙ
 МЕТКА_ЧИСЛА:,ISO, 6H*NU*ND .. 052 116 125 052 116 104
 МЕТКА_РЕЖИМА:,ISO, 6H*MD    .. 052 115 104 040 040 040
C ЧИСЛА: КОДЫ ЭЛЕМЕНТОВ СХЕМЫ 1-6, РАЗМЕРЫ ПЛАНА 12 И 16 И СЧЁТЧИКИ
C ЧИСЛА: КОДЫ ЭЛЕМЕНТОВ СХЕМЫ 1-6, РАЗМЕРЫ ПЛАНА 12 И 16 И СЧЁТЧИКИ
 КОД_1:,INT,0
 КОД_2:,INT,1
 КОД_3:,INT,3
 КОД_4:,INT,2
 КОД_5:,INT,5
 КОД_6:,INT,4
 КОД_7:,INT,6
 КОД_8:,INT,12
 КОД_9:,INT,16
C РАБОЧИЕ ЯЧЕЙКИ ПОСТРОЕНИЯ ПЛАНА СХЕМЫ
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ ПЛАНА, СЧЁТЧИК СТРОК, УКАЗАТЕЛИ И БУФЕР ВХОДНОЙ СТРОКИ
 ЯЧЕЙКИ_ПЛАНА:,BSS,2
C СМЕЩЕНИЕ ВЫВОДИМОЙ ЧАСТИ ПЛАНА
 ПОЛЕ_СМЕЩЕНИЯ:,BSS,1
C ЯЧЕЙКИ ВЕРТИКАЛЬНОГО РАЗМЕЩЕНИЯ ЭЛЕМЕНТОВ ПЛАНА
 ЯЧЕЙКИ_ВЕРТИКАЛИ:,BSS,2
C ЯЧЕЙКА РЕЗУЛЬТАТА РАЗБОРА, ПЕРЕДАЁТСЯ В RNSYMB
 РЕЗУЛЬТАТ_РАЗБОРА_1:,BSS,1
C ВТОРАЯ ЯЧЕЙКА РЕЗУЛЬТАТА РАЗБОРА, ПЕРЕДАЁТСЯ В RNSYMB
 РЕЗУЛЬТАТ_РАЗБОРА_2:,BSS,1
C СЧЁТЧИК СТРОК ПЛАНА
 СЧЁТЧИК_СТРОК:,BSS,1
C ЗНАЧЕНИЕ, ОПРЕДЕЛЯЮЩЕЕ ПОСТРОЕНИЕ ПЛАНА
 ЗНАЧЕНИЕ_ПЛАНА:,BSS,1
C УКАЗАТЕЛЬ НА ДАННЫЕ ВЕРТИКАЛЬНОГО РАЗМЕЩЕНИЯ
 УКАЗАТЕЛЬ_ВЕРТИКАЛИ:,BSS,1
C УКАЗАТЕЛЬ НА ТЕКУЩИЙ ТЕКСТ ПЛАНА
 УКАЗАТЕЛЬ_ТЕКСТА:,BSS,1
C ДЛИНА ВЫВОДИМОЙ ЧАСТИ ПЛАНА
 ПОЛЕ_ДЛИНЫ:,BSS,1
C БУФЕР ВХОДНОЙ СТРОКИ, ЧИТАЕМОЙ МОДУЛЕМ GETSTR
 БУФЕР_СТРОКИ:,BSS,14
 ,END,
