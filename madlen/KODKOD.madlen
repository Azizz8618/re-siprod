CKODKOD - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 19776 образа SIPROD.BIN
CДлина при загрузке: 44 слов, 76 команд
CВход: KODKOD
CВыход: L0074 (возврат через М12), POP (возврат через М10)
CВнешние: NEW, NEWST, SCAKOD, RSYMB
CСмещения в кадре (М7): общие 0-5, 10
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 KODKOD  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 *NEW*   :,LC,1
 *NEWST* :,LC,24
 SCAKOD  :,SUBP,
 RSYMB   :,SUBP,
 NEWST32767:,EQU,*NEWST* -32767
 M16,VTM,NEWA                           .М16 := адрес NEWA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на L0074
C
 NEWA:M7,XTA,                           .СМ := слот кадра 0
 ,UTC,*NEW*                             .мод.адрес := NEW
 ,ATX,                                  .по адресу NEW := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,1                               .СМ := слот кадра 1
 M7,ATX,4                               .слот кадра 4 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 NEWB:M7,XTA,1                          .СМ := слот кадра 1
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C КОДИРОВАНИЕ СИМВОЛА ТЕКСТА ЧЕРЕЗ RSYMB И SCAKOD
 NEWC:,WTC,ЗНАЧЕНИЕ_КОДА                .мод.адрес := код из V0
 M1,VTM,                                .М1 := код из V0
 M1,UTC,NEWST32767                      .мод.адрес := NEWST32767(М1)
 M16,VTM,                               .М16 := адрес NEWST32767+М1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ_КОДА+1                .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*NEW*                          .М16 := адрес NEW
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,SCAKOD                         .вызов через М15
 M16,VTM,*NEW*                          .М16 := адрес NEW
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,ЗНАЧЕНИЕ_КОДА                     .мод.адрес := код из V0
 M1,VTM,                                .М1 := код из V0
 M1,UTC,NEWST32767                      .мод.адрес := NEWST32767(М1)
 M16,VTM,                               .М16 := адрес NEWST32767+М1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЗНАЧЕНИЕ_КОДА+1                .М16 := адрес V1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,5                               .СМ := слот кадра 5
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,5                               .слот кадра 5 := СМ
 M7,X-A,2                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,NEWC                              .если СМ=0 → NEWC
  :7,XTA,4                              .СМ := слот кадра 4
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,4                               .слот кадра 4 := СМ
 M7,X-A,3                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,NEWB                              .если СМ=0 → NEWB
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К0
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ: ПАРАМЕТР РАЗБОРА СИМВОЛА RSYMB (6) И РАЗМЕР ТАБЛИЦЫ
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_2:,INT,1
C ЗНАЧЕНИЕ 6; ПАРАМЕТР ВЫЗОВА RSYMB - 2 ССЫЛ.
 КОД_3:,INT,6
C ЗНАЧЕНИЕ 24; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_4:,INT,24
C ПЕРЕМЕННЫЕ: КОД СИМВОЛА ТЕКСТА И БУФЕР РАЗБОРА СИМВОЛА ПРИ КОДИРОВАНИИ
 ЗНАЧЕНИЕ_КОДА:,BSS,2
 ,END,
