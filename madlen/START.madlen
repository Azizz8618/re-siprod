CSTART - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 6496 образа SIPROD.BIN
CДлина при загрузке: 31 слов, 52 команд
CВход: START
CВыход: SCHEMA:GOTA, F1 (возврат через М12), POP (возврат через М10)
CНАЧАЛО ОБРАБОТКИ ВХОДНОГО ПОТОКА.
CВнешние: KORT, EGO, FOP, KOMA, NUNU
CСмещения в EGO: 7200, 8600, 8601
CСмещения в KOMA: 2, 7
CСмещения в KORT: 14
CАбсолютные символы: N1 = -1
CСмещения в кадре (М7): общие 0-3, 10, вне кадра 2060
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 START   :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M1:,EQU,1B
 M2:,EQU,2B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M16:,EQU,16B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C KORT: КАРТА: ТАБЛИЦА КАРТЫ (15 СЛОВ)
 *KORT*  :,LC,15
C EGO: ОБЩАЯ РАБОЧАЯ ОБЛАСТЬ: БУФЕРЫ ВЫВОДА, ТАБЛИЦЫ И ПРОЧИЕ ПРОМЕЖУТОЧНЫЕ ДАННЫЕ (13401 СЛОВО)
 *EGO*   :,LC,13401
C FOP: ПРИЗНАК ФОРМАТА ВЫВОДА (1 СЛОВО)
 *FOP*   :,LC,1
C KOMA: ПАРАМЕТРЫ: НАСТРОЙКИ КОМАНДЫ (8 СЛОВ)
 *KOMA*  :,LC,8
C NUNU: ОБЩАЯ ОБЛАСТЬ ПАМЯТИ (1 СЛОВО)
 *NUNU*  :,LC,1
C КОНСТАНТЫ: СМЕЩЕНИЯ В ОБЩИХ ОБЛАСТЯХ И ДРУГИЕ КОНСТАНТЫ
C КОНСТАНТА, ВЫРАЖЕНИЕ: *KORT*  -32767
 KORT32767:,EQU,*KORT*  -32767
 M16,VTM,FOPA                           .М16 := адрес FOPA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F1
C
 FOPA:M7,XTA,                           .СМ := слот кадра 0
 ,UTC,*FOP*                             .мод.адрес := FOP
 ,ATX,                                  .по адресу FOP := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,1                               .СМ := слот кадра 1
 M7,ATX,3                               .слот кадра 3 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 FOPB:M7,XTA,-1                         .СМ := каталог задачи: элемент 12
 ,WTC,ЗНАЧЕНИЕ_ПОТОКА_1                 .мод.адрес := код из V0
 M1,VTM,                                .М1 := код из V0
 M1,UTC,KORT32767                       .мод.адрес := KORT32767(М1)
 ,ATX,                                  .по адресу KORT32767+М1 := СМ
  :7,XTA,3                              .СМ := слот кадра 3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,1                               .СМ += слот кадра 1
 M7,ATX,3                               .слот кадра 3 := СМ
 M7,X-A,2                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,FOPB                              .если СМ=0 → FOPB
 M7,XTA,1                               .СМ := слот кадра 1
 ,UTC,*KORT*+14                         .мод.адрес := KORT14
 ,ATX,                                  .по адресу KORT14 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 ,UTC,*EGO*+8600                        .мод.адрес := EGO8600
 ,ATX,                                  .по адресу EGO8600 := СМ
 M7,XTA,1                               .СМ := слот кадра 1
 ,UTC,*NUNU*                            .мод.адрес := NUNU
 ,ATX,                                  .по адресу NUNU := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,ПАРАМЕТР_ПОТОКА_1               .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: ПРОБЕЛЫ ДЛЯ ОЧИСТКИ НАЧАЛЬНОГО БУФЕРА ВХОДНОГО ПОТОКА
  МАСКА_ПРОБЕЛОВ:,ISO,6H       .. 040 040 040 040 040 040
C ЧИСЛА: ЧИСЛОВЫЕ КОНСТАНТЫ ИНИЦИАЛИЗАЦИИ: НОЛЬ, ЕДИНИЦА И СМЕЩЕНИЕ 14 В KORT
C ЗНАЧЕНИЕ 0; ИСПОЛЬЗУЕТСЯ В КОДЕ
 ПАРАМЕТР_ПОТОКА_1:,INT,0
C ЗНАЧЕНИЕ 1; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 ЕДИНИЦА:,INT,1
C ЗНАЧЕНИЕ 14; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 ЧЕТЫРНАДЦАТЬ:,INT,14
C ПЕРЕМЕННЫЕ: ЯЧЕЙКА НАЧАЛЬНОГО ЗНАЧЕНИЯ ПОТОКА (АДРЕС БУФЕРА ВВОДА KORT)
 V0:,BSS,1
C ОБЛАСТЬ КАДРА: КОНСТАНТЫ, ЗАДАВАЕМЫЕ В ЯЧЕЙКИ КАДРА, И КОМАНДЫ РАЗБОРА
 ,DATA,
 ЗНАЧЕНИЕ_ПОТОКА_1:,ISO, 6H123456 .. 061 062 063 064 065 066
 МАСКА_7890:,ISO,6H7890   .. 067 070 071 060 040 040
C КОМАНДЫ: КОМАНДНЫЕ СТРОКИ УПРАВЛЕНИЯ РАЗБОРОМ
 ЗНАЧЕН2ИЕ_ПОТОКА_2:,ISO, 6H*)$(I- .. 052 051 044 050 111 055
 ЗНАЧЕН3ИЕ_ПОТОКА_3:,ISO, 6HSLFGC/ .. 123 114 106 107 103 057
 M2,SET,ЗНАЧЕНИЕ_ПОТОКА_1
 M1,   ,*KOMA*
 M1,SET,ЗНАЧЕН2ИЕ_ПОТОКА_2
 M1,   ,*KOMA*+7
 M1,SET,ЗНАЧЕН3ИЕ_ПОТОКА_3
 M1,   ,*KOMA*+2
 ,END,
