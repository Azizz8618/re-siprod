CKLAIDA - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 15104 образа SIPROD.BIN
CДлина при загрузке: 48 слов, 60 команд
CВход: KLAIDA
CВыход: BEGPUS:FORA, BEGSTR:NDAB1A, CHAPAG:SCANEA, CHAPAG:SCANEB,
CENDKOR:EGO86B, ENDPG:SEK3C, HEADIN:HEDB, PAPRAP:F15, RASTXT:TXT2A,
CREADMK:F2B, READNB:F1B, SCAN:F9A, SCHEMA:SCANEB, SEGTAB:STR327,
CSEKLYG:SEK3A, SPAUD:SCANEQ, SPAUD:SCANES, SPAUD:SCANET, SPAUD:SCANEU,
CSPAUD:F1B, SPAUD:SEGTAA, SPAUD:SCANE1, SPAUD:SCAN00, SPAUD:SCAN01,
CSPAUD:SCAN02, SPAUD:REGIMH, SPAUD:SCANI, SPAUD:REGIMI, SPAUD:SCAN18,
CSPAUD:SCAN19, SPAUD:NUST1A, SPAUD:REGIMM, SPAUD:SCAN23, SPAUD:SCAN24,
CSPAUD:STR24C, SPAUD:REGIMV, SPAUD:L5544, TOKREZ:F6A, WRIIPO:F11B,
CWRILIN:F7C, WRIMAK:F1D, F2 (возврат через М12),
CF2A (возврат через М10)
CВЫВОД СООБЩЕНИЯ ОБ ОШИБКЕ: 'ERROR NR. N' И ОБРАЗ
CПЕРФОКАРТЫ, ПОСЛЕ ЧЕГО ЗАДАЧА ОСТАНАВЛИВАЕТСЯ.
CВнешние: INS, FT571, FT002, FT003, STOP
CСмещения в INS: 24, 25, 26
CСмещения в кадре (М7): общие 0-3, 10, свои 14
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 KLAIDA  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 *INS*   :,LC,27
 INS24:,EQU,*INS*   +24
 INS25:,EQU,*INS*   +25
 INS26:,EQU,*INS*   +26
 FT*571  :,SUBP,
 FT*002  :,SUBP,
 FT*003  :,SUBP,
 STOP*   :,SUBP,
 INS32767:,EQU,*INS*   -32767
 M16,VTM,ПОДГОТОВКА_СООБЩЕНИЯ.М16 := адрес ADDR
 ,UJ,ПЕР+3.переход на F2
C
 ПОДГОТОВКА_СООБЩЕНИЯ:M16,VTM,ПАРАМЕТР.М16 := адрес К0
 ,ITS,14.в магазин; СМ := М16
 M15,VJM,FT*571.вызов через М15
 ,WTC,ЗНАЧЕНИЕ+1.мод.адрес := код из V1
 M16,VTM,.М16 := код из V1
 ,ITS,14.в магазин; СМ := М16
 M15,VJM,FT*002.вызов через М15
 ,WTC,ЗНАЧЕНИЕ+1.мод.адрес := код из V1
 ,XTA,.СМ := слово по адресу V1
 ,NTR,3.РЖ := 3 (переходы по нулю)
 ,NTR,22B.РЖ := 18 (переходы по знаку)
 M15,VJM,FT*003.вызов через М15
 M16,VTM,ПАРАМЕТР+1.М16 := адрес К5
 ,ITS,14.в магазин; СМ := М16
 M15,VJM,FT*571.вызов через М15
 M7,XTA,.СМ := слот кадра 0
 M7,ATX,2.слот кадра 2 := СМ
 ,NTR,3.РЖ := 3 (переходы по нулю)
 ,NTR,22B.РЖ := 18 (переходы по знаку)
 INS327:,WTC,ЗНАЧЕНИЕ.мод.адрес := код из V0
 M1,VTM,.М1 := код из V0
 M1,UTC,INS32767.мод.адрес := INS32767(М1)
 M16,VTM,.М16 := адрес INS32767+М1
 ,ITS,14.в магазин; СМ := М16
 M15,VJM,FT*002.вызов через М15
 M7,XTA,2.СМ := слот кадра 2
 ,NTR,3.РЖ := 3 (переходы по нулю)
 M7,A+X,.СМ += слот кадра 0
 M7,ATX,2.слот кадра 2 := СМ
 M7,X-A,1.СМ := (адрес) - СМ
 ,NTR,22B.РЖ := 18 (переходы по знаку)
 ,UZA,INS327.если СМ=0 → INS327
 M15,VJM,FT*003.вызов через М15
 M15,VJM,STOP*.вызов через М15
 ,UJ,ВОЗВРАТ_В_БЛОК.переход на F2A
C
 ПЕР+3:M7,MTJ,8.М10 := М7
 M16,MTJ,10.М12 := М16
 M7,VTM,ПАРАМЕТР+2.М7 := адрес К14
 M7,STX,3.ЗП + магазин: 3(М7)
 ,ITS,13.в магазин; СМ := М15
 ,ITS,1.в магазин; СМ := М1
 ,ITS,8.в магазин; СМ := М10
 ,ITS,.в магазин; СМ := ИР
 ,NTR,3.РЖ := 3 (переходы по нулю)
 ,NTR,2.РЖ := 2 (переходы по нулю, округление
 M12,UJ,.переход через М12
C
 ВОЗВРАТ_В_БЛОК:,STI,.ИР := СМ; СМ := из магазина
 ,STI,7.М7 := СМ; СМ := из магазина
 ,STI,1.М1 := СМ; СМ := из магазина
 ,STI,8.М10 := СМ; СМ := из магазина
 M10,UJ,.переход через М10
C
