CENDTUR - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 20256 образа SIPROD.BIN
CДлина при загрузке: 77 слов, 128 команд
CВход: ENDTUR
CВыход: F5B (возврат через М12), POP (возврат через М10)
CВнешние: EGO, FOR, JAU, FT571, FT002, FT003, IDII, IMUI
CСмещения в EGO: 8601
CСмещения в FOR: 1
CСмещения в JAU: 1
CСмещения в кадре (М7): общие 0-1, 3-10, свои 11
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес),
CМ17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 ENDTUR  :,NAME, NEW DTRAN
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
 *EGO*   :,LC,13401
 *FOR*   :,LC,8
 *JAU*   :,LC,2
 FT*571  :,SUBP,
 FT*002  :,SUBP,
 FT*003  :,SUBP,
 I*DI*I  :,SUBP,
 I*MU*I  :,SUBP,
 EGO41368:,EQU,*EGO*+8601-32767
 M16,VTM,FORA                           .М16 := адрес FORA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F5B
C
C ЧТЕНИЕ ПАРАМЕТРА БЛОКА FOR И ПРОВЕРКА ПРИЗНАКА ПО JAU
 FORA:,UTC,*FOR*                        .мод.адрес := FOR
 ,XTA,                                  .СМ := слово по адресу FOR
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,XTA,                                .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*JAU*+1                           .мод.адрес := JAU1
 ,XTA,                                  .СМ := слово по адресу JAU1
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,FORB                              .если СМ≠0 → FORB
 ,UJ,FORC                               .переход на FORC
C
 FORB:,UJ,FOR3B                         .переход на FOR3B
C
 FORC:,UTC,*FOR*                        .мод.адрес := FOR
 ,XTA,                                  .СМ := слово по адресу FOR
 M16,VTM,СЧЁТ+2                         .М16 := адрес К2
 M15,VJM,I*DI*I                         .вызов через М15
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M16,VTM,СЧЁТ+2                         .М16 := адрес К2
 M15,VJM,I*MU*I                         .вызов через М15
 M7,ATX,6                               .слот кадра 6 := СМ
 ,UTC,*FOR*                             .мод.адрес := FOR
 ,XTA,                                  .СМ := слово по адресу FOR
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,6                               .СМ := слот кадра 6
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,FOR3A                             .если СМ≠0 → FOR3A
 ,UJ,FOR3B                              .переход на FOR3B
C
 FOR3A:M7,XTA,5                         .СМ := слот кадра 5
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,5                               .слот кадра 5 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 FOR3B:,UTC,FOR1+2                      .мод.адрес := FOR3
 ,XTA,                                  .СМ := слово по адресу FOR3
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,FOR1+3                            .мод.адрес := FOR4
 ,A+X,                                  .СМ += слово по адресу FOR4
 ,UTC,FOR1+6                            .мод.адрес := FOR7
 ,A+X,                                  .СМ += слово по адресу FOR7
 M16,VTM,СЧЁТ+22                        .М16 := адрес К3
 M15,VJM,I*MU*I                         .вызов через М15
 M7,ATX,7                               .слот кадра 7 := СМ
 M7,XTA,                                .СМ := слот кадра 0
 M7,ATX,10B                             .слот кадра 8 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ВЫЗОВ_IMUI:M7,XTA,10B                  .СМ := слот кадра 8
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,                                .СМ -= слот кадра 0
 M7,ATX,4                               .слот кадра 4 := СМ
 M7,XTA,3                               .СМ := слот кадра 3
 M16,VTM,БУФЕР_ТЕКСТ                    .М16 := адрес V0
 M15,VJM,I*MU*I                         .вызов через М15
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,11B                             .слот кадра 9 := СМ
 M7,A+X,7                               .СМ += слот кадра 7
 M7,A-X,                                .СМ -= слот кадра 0
 M7,ATX,12B                             .слот кадра 10 := СМ
 M16,VTM,ФОРМАТ_А6                      .М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M15,VJM,FT*571                         .вызов через М15
 M7,XTA,11B                             .СМ := слот кадра 9
 M7,ATX,13B                             .слот кадра 11 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,ВЫЗОВ_FT003                        .переход на F11
C
 EGO413:,WTC,ЯЧ_РЕЗУЛЬ                  .мод.адрес := код из V7
 M1,VTM,                                .М1 := код из V7
 M1,UTC,EGO41368                        .мод.адрес := EGO41368(М1)
 M16,VTM,                               .М16 := адрес EGO41368+М1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,FT*002                         .вызов через М15
 M7,XTA,13B                             .СМ := слот кадра 11
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,13B                             .слот кадра 11 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C ВЫЗОВ ПОДПРОГРАММЫ FT003 И КОРРЕКЦИЯ СЧЁТЧИКОВ БУФЕРА
 ВЫЗОВ_FT003:M7,X-A,12B                 .СМ := (адрес) - СМ
 ,UZA,EGO413                            .если СМ=0 → EGO413
 M15,VJM,FT*003                         .вызов через М15
 M7,XTA,10B                             .СМ := слот кадра 8
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,10B                             .слот кадра 8 := СМ
 M7,XTA,5                               .СМ := слот кадра 5
 M7,A-X,                                .СМ -= слот кадра 0
 M7,ATX,5                               .слот кадра 5 := СМ
 M7,XTA,                                .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 M7,XTA,5                               .СМ := слот кадра 5
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ЦИКЛ_ПЕРЕХОД                      .если СМ=0 → F5
 ,UJ,ЦИКЛ_ПЕРЕХОД_2                     .переход на F5A
C
 ЦИКЛ_ПЕРЕХОД:,UJ,ВЫЗОВ_IMUI            .переход на F8
C
 ЦИКЛ_ПЕРЕХОД_2:,UJ,POP                 .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,СЧЁТ+1                          .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: ОПИСАНИЕ ФОРМАТА ВЫВОДА ДЛЯ ВЫЗОВА ОС ПРИ ЗАВЕРШЕНИИ ТУРА: '(22A6)'
 ФОРМАТ_А6:,ISO, 6H(22A6) .. 050 062 062 101 066 051
C ЧИСЛА: ПАРАМЕТРЫ ТУРА: 2, 22 И ПРЕДЕЛ ЧИСЛА ТУРОВ 2400
C ЧИСЛА: ПАРАМЕТРЫ ТУРА: 2, 22 И ПРЕДЕЛ ЧИСЛА ТУРОВ 2400
 СЧЁТ+1:,INT,1
 СЧЁТ+2:,INT,2
 СЧЁТ+22:,INT,22
 КОД_4:,INT,2400
C ПЕРЕМЕННЫЕ: БУФЕР ИЗОБРАЖЕНИЯ ЧИСЛА И КОД СМЕЩЕНИЯ ДЛЯ ВЫБОРА ЭЛЕМЕНТА ТАБЛИЦЫ EGO
 БУФЕР_ТЕКСТ:,BSS,7
 ЯЧ_РЕЗУЛЬ:,BSS,1
 ,END,
