CGOTOPO - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 9344 образа SIPROD.BIN
CДлина при загрузке: 42 слов, 70 команд
CВход: GOTOPO
CВыход: IPONUM:F4, NOTFOR:ENDKOB, TARNYB:TYPE1A, TARNYB:NOTFE,
CF5 (возврат через М12), POP (возврат через М10)
CВнешние: WHO, HOWSMB, RASPS, WRIKOR
CСмещения в WHO: 1
CСмещения в кадре (М7): общие 1, 5, 10
CРегистры: М7 (указатель кадра), М10 (блок вызывающего),
CМ12 (магазин, кадр параметров ОС), М15 (адрес возврата),
CМ16 (модифицированный адрес)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 GOTOPO  :,NAME, NEW DTRAN
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 *WHO*   :,LC,2
 HOWSMB  :,SUBP,
 RASPS   :,SUBP,
 WRIKOR  :,SUBP,
 M16,VTM,ADDR                           .М16 := адрес ADDR
 ,UJ,ПЕР_5                              .переход на F5
C
 ADDR:M16,VTM,МЕТКА_ПЕРЕХ               .М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_1                          .М16 := адрес К1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_1                          .М16 := адрес К1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,WTC,ЯЧ_БУФЕР                          .мод.адрес := код из V1
 M16,VTM,                               .М16 := код из V1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_4                          .М16 := адрес К4
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_4                          .М16 := адрес К4
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_АДРЕС                       .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_3                          .М16 := адрес К3
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_2                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RASPS                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M16,VTM,ЯЧ_АДРЕС                       .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,HOWSMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M16,VTM,ЯЧ_АДРЕС                       .М16 := адрес V0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*WHO*                          .М16 := адрес WHO
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*WHO*+1                        .М16 := адрес WHO1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M16,VTM,МЕТКА_ПЕРЕХ                    .М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_2                          .М16 := адрес К2
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_1                          .М16 := адрес К1
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,WRIKOR                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,POP                                .переход на POP
C
C ВОЗВРАТ В ОС
 ПЕР_5:M7,MTJ,8                         .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К1
 M7,STX,5                               .ЗП + магазин: 5(М7)
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C КОМАНДЫ: КОМАНДА *G ПЕРЕХОДА К ПОЗИЦИИ, ВЫПИСЫВАЕМАЯ В ТЕКСТ
 МЕТКА_ПЕРЕХ:,ISO, 6H*G     .. 052 107 040 040 040 040
C ЧИСЛА: ЧИСЛОВЫЕ ПАРАМЕТРЫ КОМАНДЫ ПЕРЕХОДА: НОМЕР ПОЗИЦИИ И ЧИСЛО ЗНАКОВ
C ПАРАМЕТР ВЫЗОВА WRIKOR (3); ИСПОЛЬЗУЕТСЯ В КОДЕ (1)
 КОД_1:,INT,1
C ПАРАМЕТР ВЫЗОВА RASPS (1); ПАРАМЕТР ВЫЗОВА WRIKOR (1)
 КОД_2:,INT,2
C ПАРАМЕТР ВЫЗОВА RASPS (1)
 КОД_3:,INT,5
C ПАРАМЕТР ВЫЗОВА RASPS (2)
 КОД_4:,INT,16
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ ДЛЯ НОМЕРА ПОЗИЦИИ И ПРОМЕЖУТОЧНЫХ ЗНАЧЕНИЙ
 ЯЧ_АДРЕС:,BSS,1
 ЯЧ_БУФЕР:,BSS,1
 ,END,
