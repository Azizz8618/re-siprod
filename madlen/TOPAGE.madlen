CTOPAGE - МОДУЛЬ СИПРОДА
CИсточник: личная библиотека (PERSO, зона 2702,
Cтом 2248), слово 14304 образа SIPROD.BIN
CДлина при загрузке: 94 слов, 170 команд
CВход: TOPAGE
CВыход: ENDPG:STANDC, ENDSTR:JMPA, SCHEMA:TXT3A, SPAUD:LOOPA,
CVIAPUZ:STANDA, VIAPUZ:STANDC, F7 (возврат через М12),
CPOP (возврат через М10)
CНАЧАЛО НОВОЙ СТРАНИЦЫ.
CВнешние: REGIM, SEK, TXT, EGO, NUST, STR, NDAB, RSYMB, RNSYMB, IMUI
CСмещения в EGO: 2400, 4800, 7200
CСмещения в NDAB: 1, 2, 3
CСмещения в REGIM: 1
CСмещения в SEK: 3
CСмещения в STR: 24, 25, 26
CСмещения в TXT: 3
CСмещения в кадре (М7): общие 0-2, 5-7, 10
CРегистры: М1 (индекс: база модуля), М7 (указатель кадра),
CМ10 (блок вызывающего), М12 (магазин, кадр параметров ОС),
CМ15 (адрес возврата), М16 (модифицированный адрес),
CМ17 (контекст задачи)
CМодификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
C
 TOPAGE  :,NAME, NEW DTRAN
C РЕГИСТРЫ: КОДЫ РЕГИСТРОВ МАШИНЫ, ИСПОЛЬЗУЕМЫХ В МОДУЛЕ
 M1:,EQU,1B
 M7:,EQU,7B
 M10:,EQU,10B
 M12:,EQU,12B
 M15:,EQU,15B
 M16:,EQU,16B
 M17:,EQU,17B
C ВНЕШНИЕ ОБЛАСТИ: ОБЩИЕ ДЛЯ ВСЕХ МОДУЛЕЙ ОБЛАСТИ ПАМЯТИ
C REGIM: ПАРАМЕТРЫ РЕЖИМА НАБОРА: МЕЖСТРОЧНЫЙ ИНТЕРВАЛ, РАЗРЯДКА, ПЕРЕНОС ПО СЛОВАМ, НОМЕРА СТРАНИЦ, РАМКА, ВЫРАЗНИВАНИЕ (16 СЛОВ)
 *REGIM* :,LC,16
C SEK: ПАРАМЕТРЫ СЕГМЕНТОВ: СЧЁТЧИКИ И ГРАНИЦЫ (4 СЛОВА)
 *SEK*   :,LC,4
C TXT: ТЕКСТОВЫЙ ПОТОК: УКАЗАТЕЛИ НА ТЕКСТ (4 СЛОВА)
 *TXT*   :,LC,4
C EGO: ОБЩАЯ РАБОЧАЯ ОБЛАСТЬ: БУФЕРЫ ВЫВОДА, ТАБЛИЦЫ И ПРОЧИЕ ПРОМЕЖУТОЧНЫЕ ДАННЫЕ (13401 СЛОВО)
 *EGO*   :,LC,13401
C NUST: СОСТОЯНИЕ ВХОДНОГО ПОТОКА: РЕЖИМ РАЗБОРА (10 СЛОВ)
 *NUST*  :,LC,10
C STR: СТРОКА ТЕКСТА: ТЕКУЩАЯ СТРОКА И ЕЁ ГРАНИЦЫ (27 СЛОВ)
 *STR*   :,LC,27
C NDAB: СЧЁТЧИКИ ВХОДНЫХ ДАННЫХ: НОМЕР И ДЛИНА (4 СЛОВА)
 *NDAB*  :,LC,4
C ВНЕШНИЕ МОДУЛИ: ВЫЗЫВАЕМЫЕ ПРОЦЕДУРЫ
 RSYMB   :,SUBP,
 RNSYMB  :,SUBP,
 I*MU*I  :,SUBP,
C КОНСТАНТЫ: СМЕЩЕНИЯ В ОБЩИХ ОБЛАСТЯХ И ДРУГИЕ КОНСТАНТЫ
C СМЕЩЕНИЕ 2400 В ОБЛАСТИ EGO
 EGO35167:,EQU,*EGO*+2400-32767
C СМЕЩЕНИЕ 4800 В ОБЛАСТИ EGO
 EGO37567:,EQU,*EGO*+4800-32767
C КОНСТАНТА, ВЫРАЖЕНИЕ: *EGO*   -32767
 EGO32767:,EQU,*EGO*   -32767
 M16,VTM,NDABA                          .М16 := адрес NDABA
 ,UJ,ВОЗВРАТ_В_ОС                       .переход на F7
C
C РАСЧЁТ РАЗМЕРА СТРОКИ И ВЫБОР ВЕТВИ ФОРМАТА
 NDABA:,UTC,*NDAB*                      .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A-X,                                .СМ -= слот кадра 0
 M16,VTM,КОД_4                          .М16 := адрес К4
 M15,VJM,I*MU*I                         .вызов через М15
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,5                               .слот кадра 5 := СМ
 ,UTC,*STR*+26                          .мод.адрес := STR26
 ,XTA,                                  .СМ := слово по адресу STR26
 ,UTC,*STR*+25                          .мод.адрес := STR25
 ,A-X,                                  .СМ -= слово по адресу STR25
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,6                               .слот кадра 6 := СМ
 M7,XTA,2                               .СМ := слот кадра 2
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*TXT*+3                           .мод.адрес := TXT3
 ,XTA,                                  .СМ := слово по адресу TXT3
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,SEK3A                             .если СМ=0 → SEK3A
 ,UJ,SEK3B                              .переход на SEK3B
C
 SEK3A:,UJ,EGO_327                      .переход на EGO327
C
 SEK3B:M7,XTA,                          .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SEK*+3                           .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,SEK3C                             .если СМ≠0 → SEK3C
 ,UJ,SEK3E                              .переход на SEK3E
C
 SEK3C:M7,XTA,1                         .СМ := слот кадра 1
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SEK*+3                           .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,SEK3D                             .если СМ≠0 → SEK3D
 ,UJ,SEK3E                              .переход на SEK3E
C
 SEK3D:,UJ,EGO_327                      .переход на EGO327
C
 SEK3E:M7,XTA,                          .СМ := слот кадра 0
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*SEK*+3                           .мод.адрес := SEK3
 ,XTA,                                  .СМ := слово по адресу SEK3
 M17,AEX,                               .СМ ^= поле контекста 0
 ,U1A,EGO_351                           .если СМ≠0 → EGO351
 ,UJ,EGO35A                             .переход на EGO35A
C
 EGO_351:,UJ,EGO_375                    .переход на EGO375
C
 EGO35A:M16,VTM,*STR*                   .М16 := адрес STR
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*STR*+25                       .М16 := адрес STR25
 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,ЯЧ_СТРАН_1                        .мод.адрес := код из V1
 M1,VTM,                                .М1 := код из V1
 M1,UTC,EGO35167                        .мод.адрес := EGO35167(М1)
 M16,VTM,                               .М16 := адрес EGO35167+М1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*STR*+25                       .М16 := адрес STR25
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_СТРАН_2                     .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,STR25A                             .переход на STR25A
C
 EGO_375:M16,VTM,*STR*                  .М16 := адрес STR
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*STR*+25                       .М16 := адрес STR25
 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,ЯЧ_СТРАН_1                        .мод.адрес := код из V1
 M1,VTM,                                .М1 := код из V1
 M1,UTC,EGO37567                        .мод.адрес := EGO37567(М1)
 M16,VTM,                               .М16 := адрес EGO37567+М1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*STR*+25                       .М16 := адрес STR25
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_СТРАН_2                     .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,STR25A                             .переход на STR25A
C
 EGO_327:M16,VTM,*STR*                  .М16 := адрес STR
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*STR*+25                       .М16 := адрес STR25
 ,ITS,14                                .в магазин; СМ := М16
 ,WTC,ЯЧ_СТРАН_1                        .мод.адрес := код из V1
 M1,VTM,                                .М1 := код из V1
 M1,UTC,EGO32767                        .мод.адрес := EGO32767(М1)
 M16,VTM,                               .М16 := адрес EGO32767+М1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*STR*+25                       .М16 := адрес STR25
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_СТРАН_2                     .М16 := адрес V2
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RNSYMB                         .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
C СОХРАНЕНИЕ КОНЦА ТЕКСТА СТРАНИЦЫ В КАДРЕ
 STR25A:,UTC,*STR*+25                   .мод.адрес := STR25
 ,XTA,                                  .СМ := слово по адресу STR25
 M7,ATX,7                               .слот кадра 7 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UJ,STR26A                             .переход на STR26A
C
 LOOP:M16,VTM,ПРОБЕЛЫ                   .М16 := адрес К0
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,КОД_1                          .М16 := адрес К1
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,*STR*                          .М16 := адрес STR
 ,ITS,14                                .в магазин; СМ := М16
 M16,VTM,ЯЧ_СТРАН_3                     .М16 := адрес V3
 ,ITS,14                                .в магазин; СМ := М16
 M15,VJM,RSYMB                          .вызов через М15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 M7,XTA,7                               .СМ := слот кадра 7
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,7                               .слот кадра 7 := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 STR26A:,UTC,*STR*+26                   .мод.адрес := STR26
 ,X-A,                                  .СМ := слово по адресу STR26 - СМ
 ,UZA,LOOP                              .если СМ=0 → LOOP
 ,UTC,*REGIM*+1                         .мод.адрес := REGIM1
 ,XTA,                                  .СМ := слово по адресу REGIM1
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,X-A,                                  .СМ := (адрес) - СМ
 M7,A+X,                                .СМ += слот кадра 0
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,U1A,NDABB                             .если СМ≠0 → NDABB
 ,UJ,NDABC                              .переход на NDABC
C
 NDABB:,UTC,*NDAB*                      .мод.адрес := NDAB
 ,XTA,                                  .СМ := слово по адресу NDAB
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,UTC,*REGIM*+1                         .мод.адрес := REGIM1
 ,A+X,                                  .СМ += слово по адресу REGIM1
 M7,A-X,                                .СМ -= слот кадра 0
 ,UTC,*NDAB*                            .мод.адрес := NDAB
 ,ATX,                                  .по адресу NDAB := СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 NDABC:,UJ,POP                          .переход на POP
C
C ВОЗВРАТ В ОС
 ВОЗВРАТ_В_ОС:M7,MTJ,8                  .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К1
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,1                                 .в магазин; СМ := М1
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
 POP:,STI,                              .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,1                                 .М1 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C ШАБЛОНЫ: ОБРАЗЕЦ ПУСТОЙ СТРОКИ ИЗ ШЕСТИ ПРОБЕЛОВ ДЛЯ НАЧАЛА НОВОЙ СТРАНИЦЫ
 ПРОБЕЛЫ:,ISO, 6H       .. 040 040 040 040 040 040
C ЧИСЛА: ЧИСЛОВЫЕ ПАРАМЕТРЫ РАЗМЕТКИ СТРАНИЦЫ: ОТСТУП, ШИРИНА И ЧИСЛО СТРОК
C ЗНАЧЕНИЕ 1; ПАРАМЕТР ВЫЗОВА RSYMB; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,1
C ЗНАЧЕНИЕ 2; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_2:,INT,2
C ЗНАЧЕНИЕ 10; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_3:,INT,10
C ЗНАЧЕНИЕ 22; ПЕРЕДАЁТСЯ В I*MU*I
 КОД_4:,INT,22
C ПЕРЕМЕННАЯ МОДУЛЯ, В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
C ПЕРЕМЕННЫЕ: ЯЧЕЙКИ С КОНЦОМ ТЕКСТА СТРАНИЦЫ И РАЗМЕРАМИ ПОЛОСЫ НАБОРА
 НЕИСПОЛЬЗУЕМОЕ_ПОЛЕ:,BSS,1
 ЯЧ_СТРАН_1:,BSS,1
 ЯЧ_СТРАН_2:,BSS,1
 ЯЧ_СТРАН_3:,BSS,1
 ,END,
