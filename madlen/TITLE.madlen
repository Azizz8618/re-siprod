 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,MEDIUD                            .если СМ=0 → MEDIUD
 ,UJ,MEDIUE                             .переход на MEDIUE
C
 MEDIUD:,UJ,STR26B                      .переход на STR26B
C
 MEDIUE:M7,XTA,4                        .СМ := слот кадра 4
 ,ITS,                                  .в магазин; СМ := ИР
 ,UTC,*MEDIUM*                          .мод.адрес := MEDIUM
 ,XTA,                                  .СМ := слово по адресу MEDIUM
 M17,AEX,                               .СМ ^= поле контекста 0
 ,UZA,ПЕРЕХО8Д_К_ЗАВЕРШЕНИЮ_2           .если СМ=0 → F4B
 ,UJ,СБРОС_СЧЁТЧИКА_СТРОКИ              .переход на F0
C
 ПЕРЕХО8Д_К_ЗАВЕРШЕНИЮ_2:,UJ,ПЕРЕХО9Д_К_ВОЗВРАТУ.переход на F15B
C
 СБРОС_СЧЁТЧИКА_СТРОКИ:M7,XTA,          .СМ := слот кадра 0
 M7,ATX,17B                             .слот кадра 15 := СМ
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ENDSTB:M15,VJM,ENDSTR                  .вызов через М15
 M15,VJM,BEGSTR                         .вызов через М15
 M7,XTA,17B                             .СМ := слот кадра 15
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M7,A+X,                                .СМ += слот кадра 0
 M7,ATX,17B                             .слот кадра 15 := СМ
 M7,X-A,1                               .СМ := (адрес) - СМ
 ,NTR,22B                               .РЖ := 18 (переходы по знаку)
 ,UZA,ENDSTB                            .если СМ=0 → ENDSTB
 ПЕРЕХО9Д_К_ВОЗВРАТУ:,UJ,ВОССТАНОВЛЕНИЕ_КАДРА.переход на F15D
C
 ЗАВЕРШЕНИЕ_МОДУЛЯ:M7,MTJ,8             .М10 := М7
 M16,MTJ,10                             .М12 := М16
 M7,VTM,КОД_1                           .М7 := адрес К2
 ,ITS,13                                .в магазин; СМ := М15
 ,ITS,8                                 .в магазин; СМ := М10
 ,ITS,                                  .в магазин; СМ := ИР
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 ,NTR,2                                 .РЖ := 2 (переходы по нулю, округление
 M12,UJ,                                .переход через М12
C
C ВОЗВРАТ В ВЫЗЫВАЮЩИЙ БЛОК
 ВОССТАНОВЛЕНИЕ_КАДРА:,STI,             .ИР := СМ; СМ := из магазина
 ,STI,7                                 .М7 := СМ; СМ := из магазина
 ,STI,8                                 .М10 := СМ; СМ := из магазина
 M10,UJ,                                .переход через М10
C
C МАСКИ: МАСКИ ПРИЗНАКОВ СИМВОЛА ЗАГОЛОВКА: НУЛЕВАЯ И БИТ 40
 МАСКА_0:,LOG,0
 МАСКА_40:,LOG,40
C ЧИСЛА: ПОЗИЦИИ И ДЛИНЫ ЭЛЕМЕНТОВ ЗАГОЛОВКА ДОКУМЕНТА: 1, 2, 5, 6, 10
C ЗНАЧЕНИЕ 1; ИСПОЛЬЗУЕТСЯ В КОДЕ
 КОД_1:,INT,1
C ЗНАЧЕНИЕ 2; ПЕРЕДАЁТСЯ В I*DI*I
 КОД_2:,INT,2
C ЗНАЧЕНИЕ 5; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_3:,INT,5
C ЗНАЧЕНИЕ 6; ПАРАМЕТР ВЫЗОВА RSYMB - 3 ССЫЛ.
 КОД_4:,INT,6
C ЗНАЧЕНИЕ 10; В КОДЕ НЕ ИСПОЛЬЗУЕТСЯ
 КОД_5:,INT,10
C ЗАРЕЗЕРВИРОВАННЫЕ ЯЧЕЙКИ, КОДОМ МОДУЛЯ НЕ ИСПОЛЬЗУЮТСЯ
C ПЕРЕМЕННЫЕ: БУФЕРЫ СИМВОЛОВ И БУФЕР ПРИЗНАКОВ ДЛЯ ВЫВОДА ЗАГОЛОВКА
 РЕЗЕРВ_ЯЧЕЕК_МОДУЛЯ:,BSS,2
 ЗНАЧЕНИЕ_1:,BSS,2
 ТРЕТЬЕ_ЗНАЧЕНИЕ:,BSS,3
 ЗНАЧЕН2ИЕ_3:,BSS,2
 ЗНАЧЕН3ИЕ_2:,BSS,3
 ЗНАЧЕН4ИЕ_4:,BSS,1
 ,END,
