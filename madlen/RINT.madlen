 ,ATI,9                                 .М11 := СМ
 M12,STX,22B                            .ЗП + магазин: 18(М12)
 ,ATI,12                                .М14 := СМ
 M12,ATX,25B                            .параметр вызова ОС 21 := СМ
 M12,WTC,21B                            .мод.адрес := код из 17(М12)
 ,XTA,                                  .СМ := слово по адресу 17+М12
 ,NTR,3                                 .РЖ := 3 (переходы по нулю)
 M10,A+X,3                              .СМ += поле блока вызывающего 3
 M10,AAX,10B                            .СМ &= поле блока вызывающего 8
 M12,ATX,12B                            .параметр вызова ОС 10 := СМ
 ,X-A,                                  .СМ := (адрес) - СМ
 ,UZA,ЧТЕНИЕ_ПОЛЯ_8_БЛОКА               .если СМ=0 → L14
 ,ATI,11                                .М13 := СМ
 M11,XTA,                               .СМ := смещение в буфере 0
 M15,VJM,SYTOBIN+5                      .вызов через М15
 ,ITA,7                                 .СМ := М7
 M10,AAX,4                              .СМ &= поле блока вызывающего 4
 ,U1A,GET                               .если СМ≠0 → GET
