***************************************************
* REDTXT - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 16096 образа SIPROD.BIN
*   Длина при загрузке: 32 слов, 52 команд
*   Вход: REDTXT
*   Выход: SCHEMA:STVA, F3B (возврат через М12), F3C (возврат через М10)
*   ОБРАБОТКА ТЕКСТА *RED: ПЕРЕДАЁТ УПРАВЛЕНИЕ РАЗБОРУ
*   КОМАНД SPAUD.
*   Внешние: FIN, REGIM, NUST, RUSIS, SPAUD
*   Смещения в кадре (М7): общие 0-3, 10
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 FIN
*   002 REGIM
*   003 NUST
*   004 RUSIS
*   005 SPAUD
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     32
*   V1     36
*   V2     37
*
*** КОД МОДУЛЯ
*
* ПЕРЕДАЧА ТЕКСТА РАЗБОРУ КОМАНД SPAUD.
REDTXT   СТАРТ  0
         УИА    RUSISA(М16)             ,М16 := адрес RUSISA
         ПБ     F3B                     ,переход на F3B
*
RUSISA   СЧ     0(М7)                   ,СМ := слот кадра 0
         МОДА   RUSIS                   ,мод.адрес := RUSIS
         ЗП     0                       ,по адресу RUSIS := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
RUSISB   УИА    V1(М16)                 ,М16 := адрес V1
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V2(М16)                 ,М16 := адрес V2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     SPAUD(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     1(М7)                   ,СМ := слот кадра 1
         СЧИМ                           ,в магазин; СМ := ИР
         МОДА   FIN                     ,мод.адрес := FIN
         СЧ     0                       ,СМ := слово по адресу FIN
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F1                      ,если СМ=0 → F1
         ПБ     F3                      ,переход на F3
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1       ПБ     F3A                     ,переход на F3A
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3       СЧ     3(М7)                   ,СМ := слот кадра 3
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     3(М7)                   ,слот кадра 3 := СМ
         ВЧОБ   2(М7)                   ,СМ := (адрес) - СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПО     RUSISB                  ,если СМ=0 → RUSISB
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3A      ПБ     F3C                     ,переход на F3C
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3B      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F3C      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'6400000000000000'
V0       ПАМ    1
V1       ПАМ    1
V2       ПАМ    1
	ФИНИШ

