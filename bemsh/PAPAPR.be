***************************************************
* PAPAPR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 9504 образа SIPROD.BIN
*   Длина при загрузке: 34 слов, 54 команд
*   Вход: PAPAPR
*   Выход: F5 (возврат через М12), POP (возврат через М10)
*   ГЕНЕРАТОР РЕЖИМА *SUB: ПАСПОРТ ПОДПРОГРАММЫ,
*   РАЗДЕЛЫ 1-10, ШАПКИ ЧЕРЕЗ RMAKR.
*   Внешние: COMCON, EGO, INS, NUST, RUSIS, PAPRAP, RMAKR, IMUI
*   Смещения в COMCON: 19, 20
*   Смещения в EGO: 7200, 8600, 8601
*   Смещения в INS: 24, 25, 26
*   Абсолютные символы: N1 = -1
*   Смещения в кадре (М7): общие 0-1, 3-5, 10, вне кадра 2064
*   Регистры: М1 (индекс: база модуля), М7 (указатель кадра), 
*   М10 (блок вызывающего), М12 (магазин, кадр параметров ОС), 
*   М15 (адрес возврата), М16 (модифицированный адрес)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 COMCON
*   002 COMCON20
*   003 EGO
*   004 EGO7200
*   005 EGO8600
*   006 EGO8601
*   007 INS
*   008 INS24
*   009 INS25
*   010 INS26
*   011 NUST
*   012 RUSIS
*   013 PAPRAP
*   014 RMAKR
*   015 IMUI
*   016 N1
*   017 EGO39967
*   020 COMCON19
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К1     34
*   К2     35
*   К3     36
*   V0     40
*   V1     41
*   V12    54
*   V13    55
*
*** КОД МОДУЛЯ
*
PAPAPR   СТАРТ  0
         УИА    EGO860(М16)             ,М16 := адрес EGO860
         ПБ     F5                      ,переход на F5
*
EGO860   МОДА   EGO8600                 ,мод.адрес := EGO8600
         СЧ     0                       ,СМ := слово по адресу EGO8600
         УИА    COMCON20(М16)           ,М16 := адрес COMCON20
         ПВ     IMUI(М15)               ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     EGO39A                  ,переход на EGO39A
*
EGO399   СЧ     '4020'(М7)              ,СМ := каталог задачи: таблица страниц
         МОД    V1                      ,мод.адрес := код из V1
         УИА    0(М1)                   ,М1 := код из V1
         МОДА   EGO39967(М1)            ,мод.адрес := EGO39967(М1)
         ЗП     0                       ,по адресу EGO39967+М1 := СМ
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     5(М7)                   ,СМ := слот кадра 5
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     0(М7)                   ,СМ += слот кадра 0
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
EGO39A   ВЧОБ   3(М7)                   ,СМ := (адрес) - СМ
         ПО     EGO399                  ,если СМ=0 → EGO399
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RMAKR(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         ПВ     RMAKR(М15)              ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПВ     PAPRAP(М15)             ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ПБ     POP                     ,переход на POP
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F5       УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К1(М7)                  ,М7 := адрес К1
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М1                      ,в магазин; СМ := М1
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М1                      ,М1 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
К1       КОНД   В'6400000000000001'
К2       КОНД   В'6400000000000022'
К3       КОНД   В'6400000000000023'
V0       ПАМ    1
V1       ПАМ    1
	ФИНИШ

