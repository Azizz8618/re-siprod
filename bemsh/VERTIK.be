***************************************************
* VERTIK - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6944 образа SIPROD.BIN
*   Длина при загрузке: 72 слов, 112 команд
*   Вход: VERTIK
*   Выход: WRIVER:F1A, F15 (возврат через М12), POP (возврат через М10)
*   Внешние: VER, RNSYMB, IDII, IMUI
*   Смещения в VER: 4
*   Смещения в кадре (М7): общие 0-2, 4-10, свои 11-15
*   Регистры: М7 (указатель кадра), М10 (блок вызывающего), 
*   М12 (магазин, кадр параметров ОС), М15 (адрес возврата), 
*   М16 (модифицированный адрес), М17 (контекст задачи)
*   Модификатор адреса: МОДА/МОД задают М16, адрес следующей команды += М16
***************************************************
*** СИМВОЛЫ МОДУЛЯ
*   001 VER
*   002 VER4
*   003 RNSYMB
*   004 IDII
*   005 IMUI
*
* ЛОКАЛЬНЫЕ СИМВОЛЫ (имя - смещение в словах от начала модуля):
*   К0     70
*   К2     72
*   К3     73
*   V0     74
*   V5     101
*   V8     104
*   V9     105
*   V10    106
*   V11    107
*
*** КОД МОДУЛЯ
*
VERTIK   СТАРТ  0
         УИА    F5(М16)                 ,М16 := адрес F5
         ПБ     F15                     ,переход на F15
*
F5       МОД    V10                     ,мод.адрес := код из V10
         СЧ     0                       ,СМ := слово по адресу V10
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         МОД    V11                     ,мод.адрес := код из V11
         ВЧ     0                       ,СМ -= слово по адресу V11
         ЗП     5(М7)                   ,слот кадра 5 := СМ
         МОД    V11                     ,мод.адрес := код из V11
         СЧ     0                       ,СМ := слово по адресу V11
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         СЧ     5(М7)                   ,СМ := слот кадра 5
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IDII(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ЗП     6(М7)                   ,слот кадра 6 := СМ
         МОД    V11                     ,мод.адрес := код из V11
         СЧ     0                       ,СМ := слово по адресу V11
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     4(М7)                   ,слот кадра 4 := СМ
         СЧ     6(М7)                   ,СМ := слот кадра 6
         ВЧОБ   0                       ,СМ := (адрес) - СМ
         УИА    V0(М16)                 ,М16 := адрес V0
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЛ     5(М7)                   ,СМ += слот кадра 5
         ЗП     7(М7)                   ,слот кадра 7 := СМ
         МОД    V11                     ,мод.адрес := код из V11
         СЧ     0                       ,СМ := слово по адресу V11
         ВЧ     7(М7)                   ,СМ -= слот кадра 7
         ЗП     8(М7)                   ,слот кадра 8 := СМ
         МОД    V9                      ,мод.адрес := код из V9
         СЧ     0                       ,СМ := слово по адресу V9
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         СЧ     0(М7)                   ,СМ := слот кадра 0
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПБ     F1B                     ,переход на F1B
*
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
VER4A    МОДА   VER4                    ,мод.адрес := VER4
         СЧ     0                       ,СМ := слово по адресу VER4
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         МОДА   VER4                    ,мод.адрес := VER4
         ЗП     0                       ,по адресу VER4 := СМ
         СЧ     2(М7)                   ,СМ := слот кадра 2
         УИА    VER4(М16)               ,М16 := адрес VER4
         ПВ     IMUI(М15)               ,вызов через М15
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         ВЧ     1(М7)                   ,СМ -= слот кадра 1
         ЗП     12(М7)                  ,слот кадра 12 := СМ
         УИА    V5(М16)                 ,М16 := адрес V5
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К3(М16)                 ,М16 := адрес К3
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    VER(М16)                ,М16 := адрес VER
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    V8(М16)                 ,М16 := адрес V8
         СЧИМ   М16                     ,в магазин; СМ := М16
         УИА    К2(М16)                 ,М16 := адрес К2
         СЧИМ   М16                     ,в магазин; СМ := М16
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         ПВ     RNSYMB(М15)             ,вызов через М15
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         СЧ     8(М7)                   ,СМ := слот кадра 8
         СЧИМ                           ,в магазин; СМ := ИР
         СЧ     11(М7)                  ,СМ := слот кадра 11
         НТЖ    0(М17)                  ,СМ ^= поле контекста 0
         ПО     F1                      ,если СМ=0 → F1
         ПБ     F1A                     ,переход на F1A
*
F1       СЧ     1(М7)                   ,СМ := слот кадра 1
         ЗП     10(М7)                  ,слот кадра 10 := СМ
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
F1A      СЧ     9(М7)                   ,СМ := слот кадра 9
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     6(М7)                   ,СМ += слот кадра 6
         СЛ     10(М7)                  ,СМ += слот кадра 10
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     9(М7)                   ,слот кадра 9 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
         СЧ     11(М7)                  ,СМ := слот кадра 11
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         СЛ     1(М7)                   ,СМ += слот кадра 1
         ЗП     11(М7)                  ,слот кадра 11 := СМ
         РЖА    '22'                    ,РЖ := 18 (переходы по знаку)
         МОДА   0                       ,мод.адрес := 0 (сброс модификации)
F1B      МОД    V11                     ,мод.адрес := код из V11
         ВЧОБ   0                       ,СМ := слово по адресу V11 - СМ
         ПО     VER4A                   ,если СМ=0 → VER4A
         ПБ     POP                     ,переход на POP
*
F15      УИИ    М10(М7)                 ,М10 := М7
         УИИ    М12(М16)                ,М12 := М16
         УИА    К0(М7)                  ,М7 := адрес К0
         ЗПМ    15(М7)                  ,ЗП + магазин: 15(М7)
         ЗПМ    14(М7)                  ,ЗП + магазин: 14(М7)
         ЗПМ    13(М7)                  ,ЗП + магазин: 13(М7)
         СЧИМ   М15                     ,в магазин; СМ := М15
         СЧИМ   М10                     ,в магазин; СМ := М10
         СЧИМ                           ,в магазин; СМ := ИР
         РЖА    '3'                     ,РЖ := 3 (переходы по нулю)
         РЖА    '2'                     ,РЖ := 2 (переходы по нулю, округление
         ПБ     0(М12)                  ,переход через М12
*
POP      УИМ                            ,ИР := СМ; СМ := из магазина
         УИМ    М7                      ,М7 := СМ; СМ := из магазина
         УИМ    М10                     ,М10 := СМ; СМ := из магазина
         ПБ     0(М10)                  ,переход через М10
*
К0       КОНД   В'6400000000000000'
К2       КОНД   В'6400000000000002'
К3       КОНД   В'6400000000000005'
V0       ПАМ    1
V1       ПАМ    1
V2       ПАМ    1
V3       ПАМ    1
V4       ПАМ    1
V5       ПАМ    1
V6       ПАМ    1
V7       ПАМ    1
V8       ПАМ    1
V9       ПАМ    1
V10      ПАМ    1
V11      ПАМ    1
	ФИНИШ

