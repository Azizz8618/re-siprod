***************************************************
* WRIKOR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6336 образа SIPROD.BIN
*   Длина при загрузке: 55 слов, 90 команд
*   Вход: WRIKOR
*   Внешние: *KORT*, ENDKOR, RNSYMB
*   Смещения в *KORT*: 14
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
WRIKOR  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0045                    ,переход на L0045
        МОД    L0065                    ,мод.адрес по коду: L0065
        СЧ     WRIKOR                   ,СМ := WRIKOR
L0004   ЗП     3(М7)                    ,3 := СМ
        РЖА    '3'                      ,РЖ := '3'
L0006   МОД    L0066                    ,мод.адрес по коду: L0066
        СЧ     WRIKOR                   ,СМ := WRIKOR
L0010   ЗП     4(М7)                    ,4 := СМ
        СЧ     WRIKOR(М7)               ,СМ := WRIKOR(М7)
L0012   ЗП     5(М7)                    ,5 := СМ
L0013   РЖА    '22'                     ,РЖ := '22'
        СЧ     2(М7)                    ,СМ := 2(М7)
L0015   РЖА    '3'                      ,РЖ := '3'
        МОДА   *KORT*+16                ,мод.адрес +1: *KORT*+16
        ВЧ     WRIKOR                   ,СМ -= WRIKOR
        СЛ     L0001(М7)                ,СМ += L0001(М7)
        ЗП     6(М7)                    ,6 := СМ
        ВЧ     4(М7)                    ,СМ -= 4(М7)
        РЖА    '22'                     ,РЖ := '22'
        ПЕ     L0013                    ,если СМ≠0 → L0013
        ПБ     L0015                    ,переход на L0015
        СЧ     6(М7)                    ,СМ := 6(М7)
        ЗП     4(М7)                    ,4 := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОД    L0064                    ,мод.адрес по коду: L0064
        УИА    WRIKOR(М16)              ,М16 := WRIKOR
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0035   УИА    L0060(М16)               ,М16 := L0060
L0036   СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *KORT*(М16)              ,М16 := *KORT*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *KORT*+16(М16)           ,М16 := *KORT*+16
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0061(М16)               ,М16 := L0061
L0044   СЧИМ   М16                      ,стек := М16, СМ := М16
L0045   ПВ     RNSYMB(М15)              ,вызов через М15
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        СЧ     5(М7)                    ,СМ := 5(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     L0004(М7)                ,СМ += L0004(М7)
L0053   ЗП     5(М7)                    ,5 := СМ
        МОДА   *KORT*+16                ,мод.адрес +1: *KORT*+16
L0055   СЧ     WRIKOR                   ,СМ := WRIKOR
        СЛ     L0004(М7)                ,СМ += L0004(М7)
        МОДА   *KORT*+16                ,мод.адрес +1: *KORT*+16
L0060   ЗП     WRIKOR                   ,WRIKOR := СМ
L0061   МОД    L0066                    ,мод.адрес по коду: L0066
        СЧ     WRIKOR                   ,СМ := WRIKOR
        СЧИМ                            ,СЧИ + магазин
L0064   СЧ     5(М7)                    ,СМ := 5(М7)
L0065   РЖА    '22'                     ,РЖ := '22'
L0066   НТЖ    WRIKOR(М17)              ,СМ ^= WRIKOR(М17)
        ПО     L0035                    ,если СМ=0 → L0035
        ПБ     L0036                    ,переход на L0036
        МОДА   WRIKOR                   ,мод.адрес +1: WRIKOR
        ПБ     L0044                    ,переход на L0044
        МОДА   WRIKOR                   ,мод.адрес +1: WRIKOR
        СЧ     3(М7)                    ,СМ := 3(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     L0004(М7)                ,СМ += L0004(М7)
        ЗП     3(М7)                    ,3 := СМ
        МОД    L0066                    ,мод.адрес по коду: L0066
        СЧ     WRIKOR                   ,СМ := WRIKOR
        ВЧ     5(М7)                    ,СМ -= 5(М7)
        ЗП     4(М7)                    ,4 := СМ
        РЖА    '22'                     ,РЖ := '22'
        ПВ     ENDKOR(М15)              ,вызов через М15
        ПБ     L0006                    ,переход на L0006
        МОДА   WRIKOR                   ,мод.адрес +1: WRIKOR
        ПБ     L0053                    ,переход на L0053
        МОДА   WRIKOR                   ,мод.адрес +1: WRIKOR
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0055(М7)                ,М7 := L0055
        ЗПМ    9(М7)                    ,ЗП + магазин: 9(М7)
        ЗПМ    8(М7)                    ,ЗП + магазин: 8(М7)
        ЗПМ    7(М7)                    ,ЗП + магазин: 7(М7)
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     WRIKOR(М12)              ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     WRIKOR(М10)              ,переход через М10

