***************************************************
* HOWSMB - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 6880 образа SIPROD.BIN
*   Длина при загрузке: 37 слов, 58 команд
*   Вход: HOWSMB
*   Внешние: *WHO*, RSYMB
*   Смещения в *WHO*: 1
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
HOWSMB  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0026                    ,переход на L0026
        СЧ     '4004'(М7)               ,СМ := '4004'(М7)
        ЗП     5(М7)                    ,5 := СМ
        РЖА    '3'                      ,РЖ := '3'
        МОД    L0044                    ,мод.адрес по коду: L0044
        УИА    HOWSMB(М16)              ,М16 := HOWSMB
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0010   УИА    L0040(М16)               ,М16 := L0040
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0012   УИА    L0043(М16)               ,М16 := L0043
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0041(М16)               ,М16 := L0041
        СЧИМ   М16                      ,стек := М16, СМ := М16
        РЖА    '22'                     ,РЖ := '22'
L0017   ПВ     RSYMB(М15)               ,вызов через М15
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0022   СЧ     1(М7)                    ,СМ := 1(М7)
        МОДА   *WHO*+1                  ,мод.адрес +1: *WHO*+1
        ЗП     HOWSMB                   ,HOWSMB := СМ
        РЖА    '3'                      ,РЖ := '3'
L0026   СЧ     '4004'(М7)               ,СМ := '4004'(М7)
        СЧИМ                            ,СЧИ + магазин
        СЧ     5(М7)                    ,СМ := 5(М7)
        РЖА    '22'                     ,РЖ := '22'
        НТЖ    HOWSMB(М17)              ,СМ ^= HOWSMB(М17)
L0033   ПО     L0017                    ,если СМ=0 → L0017
        ПБ     L0022                    ,переход на L0022
        МОДА   HOWSMB                   ,мод.адрес +1: HOWSMB
L0036   СЧ     HOWSMB(М7)               ,СМ := HOWSMB(М7)
        МОДА   *WHO*+1                  ,мод.адрес +1: *WHO*+1
L0040   ЗП     HOWSMB                   ,HOWSMB := СМ
L0041   РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0043   МОДА   HOWSMB                   ,мод.адрес +1: HOWSMB
L0044   СЧ     4(М7)                    ,СМ := 4(М7)
        РЖА    '3'                      ,РЖ := '3'
        МОДА   *WHO*+1                  ,мод.адрес +1: *WHO*+1
        ВЧ     HOWSMB                   ,СМ -= HOWSMB
        МОДА   *WHO*                    ,мод.адрес +1: *WHO*
        ЗП     HOWSMB                   ,HOWSMB := СМ
        РЖА    '22'                     ,РЖ := '22'
        ПБ     L0033                    ,переход на L0033
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0036(М7)                ,М7 := L0036
        ЗПМ    6(М7)                    ,ЗП + магазин: 6(М7)
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     HOWSMB(М12)              ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     HOWSMB(М10)              ,переход через М10

