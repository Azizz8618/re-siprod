***************************************************
* WRITEH - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 7488 образа SIPROD.BIN
*   Длина при загрузке: 27 слов, 48 команд
*   Вход: WRITEH
*   Внешние: *NUNU*, *NUST*, *GOT*, *REGIM*, TWOPLA, WRIVER, WRIHOR, 
*   WRILIN, ONEPLA, WRIKOR
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
WRITEH  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0021                    ,переход на L0021
        СЧ     WRITEH(М7)               ,СМ := WRITEH(М7)
        СЧИМ                            ,СЧИ + магазин
        МОДА   *GOT*                    ,мод.адрес +1: *GOT*
L0005   СЧ     WRITEH                   ,СМ := WRITEH
L0006   НТЖ    WRITEH(М17)              ,СМ ^= WRITEH(М17)
        ПО     L0005                    ,если СМ=0 → L0005
L0010   ПБ     L0006                    ,переход на L0006
        МОДА   WRITEH                   ,мод.адрес +1: WRITEH
L0012   ПБ     L0013                    ,переход на L0013
L0013   МОДА   WRITEH                   ,мод.адрес +1: WRITEH
        УИА    L0030(М16)               ,М16 := L0030
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0031(М16)               ,М16 := L0031
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0032(М16)               ,М16 := L0032
L0021   СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     WRIKOR(М15)              ,вызов через М15
        МОДА   WRITEH                   ,мод.адрес +1: WRITEH
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0026   ПВ     ONEPLA(М15)              ,вызов через М15
        МОДА   WRITEH                   ,мод.адрес +1: WRITEH
L0030   ПВ     WRILIN(М15)              ,вызов через М15
L0031   МОДА   WRITEH                   ,мод.адрес +1: WRITEH
L0032   ПВ     WRIHOR(М15)              ,вызов через М15
        МОДА   WRITEH                   ,мод.адрес +1: WRITEH
        ПВ     WRIVER(М15)              ,вызов через М15
        МОДА   WRITEH                   ,мод.адрес +1: WRITEH
        ПВ     TWOPLA(М15)              ,вызов через М15
        МОДА   WRITEH                   ,мод.адрес +1: WRITEH
        ПБ     L0026                    ,переход на L0026
        МОДА   WRITEH                   ,мод.адрес +1: WRITEH
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0031(М7)                ,М7 := L0031
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     WRITEH(М12)              ,переход через М12
        МОДА   WRITEH                   ,мод.адрес +1: WRITEH
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     WRITEH(М10)              ,переход через М10

