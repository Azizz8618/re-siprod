***************************************************
* KORNET - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 10592 образа SIPROD.BIN
*   Длина при загрузке: 41 слов, 70 команд
*   Вход: KORNET
*   Внешние: *INS*, *SCANER*, GETSTR, ZD.Ю C Ж
*   Смещения в *INS*: 24, 25, 26
*   Смещения в *SCANER*: 1, 2
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
KORNET  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0033                    ,переход на L0033
        МОД    L0047                    ,мод.адрес по коду: L0047
        СЧ     KORNET                   ,СМ := KORNET
        МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
        ЗП     KORNET                   ,KORNET := СМ
L0006   РЖА    '3'                      ,РЖ := '3'
        МОД    L0047                    ,мод.адрес по коду: L0047
L0010   СЧ     KORNET                   ,СМ := KORNET
        ЗП     2(М7)                    ,2 := СМ
L0012   РЖА    '22'                     ,РЖ := '22'
L0013   ПБ     L0017                    ,переход на L0017
L0014   ПВ     ZD.Ю C Ж(М15)            ,вызов через М15
        МОДА   KORNET                   ,мод.адрес +1: KORNET
        СЧ     1(М7)                    ,СМ := 1(М7)
L0017   СЧИМ                            ,СЧИ + магазин
        МОДА   *SCANER*+1               ,мод.адрес +1: *SCANER*+1
        СЧ     KORNET                   ,СМ := KORNET
        НТЖ    KORNET(М17)              ,СМ ^= KORNET(М17)
        ПЕ     L0013                    ,если СМ≠0 → L0013
        ПБ     L0014                    ,переход на L0014
        МОДА   KORNET                   ,мод.адрес +1: KORNET
        ПБ     L0027                    ,переход на L0027
L0027   МОДА   KORNET                   ,мод.адрес +1: KORNET
        СЧ     2(М7)                    ,СМ := 2(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     KORNET(М7)               ,СМ += KORNET(М7)
L0033   ЗП     2(М7)                    ,2 := СМ
        РЖА    '22'                     ,РЖ := '22'
        МОДА   KORNET                   ,мод.адрес +1: KORNET
        МОДА   *INS*+32                 ,мод.адрес +1: *INS*+32
        ВЧОБ   KORNET                   ,СМ := (адрес) - СМ
        ПО     L0006                    ,если СМ=0 → L0006
L0041   УИА    L0046(М16)               ,М16 := L0046
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0043   ПВ     GETSTR(М15)              ,вызов через М15
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0046   МОДА   *INS*+31                 ,мод.адрес +1: *INS*+31
L0047   СЧ     KORNET                   ,СМ := KORNET
L0050   МОД    L0050                    ,мод.адрес по коду: L0050
        ЗП     KORNET                   ,KORNET := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПБ     L0041                    ,переход на L0041
        МОДА   KORNET                   ,мод.адрес +1: KORNET
        МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
        СЧ     KORNET                   ,СМ := KORNET
        РЖА    '3'                      ,РЖ := '3'
        ВЧ     KORNET(М7)               ,СМ -= KORNET(М7)
        МОД    L0050                    ,мод.адрес по коду: L0050
        ЗП     KORNET                   ,KORNET := СМ
        РЖА    '22'                     ,РЖ := '22'
        ПБ     L0041                    ,переход на L0041
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0043(М7)                ,М7 := L0043
        ЗПМ    5(М7)                    ,ЗП + магазин: 5(М7)
        ЗПМ    4(М7)                    ,ЗП + магазин: 4(М7)
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     KORNET(М12)              ,переход через М12
        МОДА   KORNET                   ,мод.адрес +1: KORNET
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     KORNET(М10)              ,переход через М10

