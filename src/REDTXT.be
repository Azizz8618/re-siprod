***************************************************
* REDTXT - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 16096 образа SIPROD.BIN
*   Длина при загрузке: 32 слов, 52 команд
*   Вход: REDTXT
*   Внешние: *FIN*, *REGIM*, *NUST*, *RUSIS*, SPAUD
*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
REDTXT  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0023                    ,переход на L0023
        СЧ     REDTXT(М7)               ,СМ := REDTXT(М7)
        МОДА   *RUSIS*                  ,мод.адрес +1: *RUSIS*
        ЗП     REDTXT                   ,REDTXT := СМ
L0005   РЖА    '3'                      ,РЖ := '3'
        СЧ     1(М7)                    ,СМ := 1(М7)
        ЗП     3(М7)                    ,3 := СМ
L0010   РЖА    '22'                     ,РЖ := '22'
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
L0012   УИА    L0036(М16)               ,М16 := L0036
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0037(М16)               ,М16 := L0037
L0015   СЧИМ   М16                      ,стек := М16, СМ := М16
L0016   ПВ     SPAUD(М15)               ,вызов через М15
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0022   СЧ     1(М7)                    ,СМ := 1(М7)
L0023   СЧИМ                            ,СЧИ + магазин
        МОДА   *FIN*                    ,мод.адрес +1: *FIN*
        СЧ     REDTXT                   ,СМ := REDTXT
        НТЖ    REDTXT(М17)              ,СМ ^= REDTXT(М17)
        ПО     L0015                    ,если СМ=0 → L0015
L0030   ПБ     L0016                    ,переход на L0016
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
L0032   ПБ     L0022                    ,переход на L0022
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        СЧ     3(М7)                    ,СМ := 3(М7)
        РЖА    '3'                      ,РЖ := '3'
L0036   СЛ     L0001(М7)                ,СМ += L0001(М7)
L0037   ЗП     3(М7)                    ,3 := СМ
        ВЧОБ   2(М7)                    ,СМ := (адрес) - СМ
        РЖА    '22'                     ,РЖ := '22'
        ПО     L0005                    ,если СМ=0 → L0005
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        ПБ     L0030                    ,переход на L0030
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0032(М7)                ,М7 := L0032
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     REDTXT(М12)              ,переход через М12
        МОДА   REDTXT                   ,мод.адрес +1: REDTXT
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     REDTXT(М10)              ,переход через М10

