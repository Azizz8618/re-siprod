        МОДА   *SEK*+2                  ,мод.адрес +1: *SEK*+2
        ЗП     LYGPAR                   ,LYGPAR := СМ
        МОДА   *LYG*+2                  ,мод.адрес +1: *LYG*+2
        СЧ     LYGPAR                   ,СМ := LYGPAR
        МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
        ЗП     LYGPAR                   ,LYGPAR := СМ
        ПБ     L0044                    ,переход на L0044
        МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0046(М7)                ,М7 := L0046
        СЧИМ   М15                      ,стек := М15, СМ := М15
