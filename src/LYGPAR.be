L0012   ПБ     L0032                    ,переход на L0032
L0013   МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        МОДА   СИМ12                    ,мод.адрес +1: СИМ12
        СЧ     LYGPAR                   ,СМ := LYGPAR
        СЧИМ                            ,СЧИ + магазин
L0017   МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
L0020   СЧ     LYGPAR                   ,СМ := LYGPAR
        НТЖ    LYGPAR(М17)              ,СМ ^= LYGPAR(М17)
