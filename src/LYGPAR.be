        СЧ     LYGPAR                   ,СМ := LYGPAR
L0032   НТЖ    LYGPAR(М17)              ,СМ ^= LYGPAR(М17)
        ПЕ     L0017                    ,если СМ≠0 → L0017
        ПБ     L0020                    ,переход на L0020
        МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        ПБ     L0032                    ,переход на L0032
L0037   МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        МОДА   *SEK*+2                  ,мод.адрес +1: *SEK*+2
        СЧ     LYGPAR                   ,СМ := LYGPAR
        РЖА    '3'                      ,РЖ := '3'
        ВЧОБ   LYGPAR                   ,СМ := (адрес) - СМ
L0044   МОДА   СИМ14                    ,мод.адрес +1: СИМ14
        СЛ     LYGPAR                   ,СМ += LYGPAR
L0046   РЖА    '22'                     ,РЖ := '22'
        ПО     L0025                    ,если СМ=0 → L0025
        ПБ     L0026                    ,переход на L0026
        МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        ПБ     L0032                    ,переход на L0032
        МОДА   LYGPAR                   ,мод.адрес +1: LYGPAR
        МОДА   *SEK*+3                  ,мод.адрес +1: *SEK*+3
        СЧ     LYGPAR                   ,СМ := LYGPAR
        МОДА   СИМ12                    ,мод.адрес +1: СИМ12
        ЗП     LYGPAR                   ,LYGPAR := СМ
        МОДА   *SEK*+2                  ,мод.адрес +1: *SEK*+2
