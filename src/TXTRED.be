***************************************************
* TXTRED - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 16160 образа SIPROD.BIN
*   Длина при загрузке: 38 слов, 64 команд
*   Вход: TXTRED
*   Внешние: *RPT*, *EGO*, *RUSIS*, SPAUD
*   Смещения в *EGO*: 7200, 8600, 8601
*   Регистры: М7, М10, М12, М15, М16
***************************************************
TXTRED  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0031                    ,переход на L0031
L0002   МОД    L0045                    ,мод.адрес по коду: L0045
        СЧ     TXTRED                   ,СМ := TXTRED
        МОДА   *RPT*                    ,мод.адрес +1: *RPT*
        ЗП     TXTRED                   ,TXTRED := СМ
        РЖА    '3'                      ,РЖ := '3'
L0007   МОДА   *RPT*                    ,мод.адрес +1: *RPT*
L0010   СЧ     TXTRED                   ,СМ := TXTRED
        ВЧОБ   TXTRED                   ,СМ := (адрес) - СМ
L0012   СЛ     L0002(М7)                ,СМ += L0002(М7)
        РЖА    '22'                     ,РЖ := '22'
        ПЕ     L0007                    ,если СМ≠0 → L0007
L0015   ПБ     L0012                    ,переход на L0012
        СЧ     2(М7)                    ,СМ := 2(М7)
        МОДА   *RPT*                    ,мод.адрес +1: *RPT*
        ЗП     TXTRED                   ,TXTRED := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОДА   TXTRED                   ,мод.адрес +1: TXTRED
        СЧ     1(М7)                    ,СМ := 1(М7)
L0025   МОДА   *RUSIS*                  ,мод.адрес +1: *RUSIS*
L0026   ЗП     TXTRED                   ,TXTRED := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0031   МОДА   TXTRED                   ,мод.адрес +1: TXTRED
        УИА    L0043(М16)               ,М16 := L0043
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0044(М16)               ,М16 := L0044
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0036   ПВ     SPAUD(М15)               ,вызов через М15
        МОДА   TXTRED                   ,мод.адрес +1: TXTRED
L0040   РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОДА   *EGO*+20630              ,мод.адрес +1: *EGO*+20630
L0043   СЧ     TXTRED                   ,СМ := TXTRED
L0044   РЖА    '3'                      ,РЖ := '3'
L0045   ВЧОБ   TXTRED                   ,СМ := (адрес) - СМ
        СЛ     TXTRED(М7)               ,СМ += TXTRED(М7)
        РЖА    '22'                     ,РЖ := '22'
        ПЕ     L0025                    ,если СМ≠0 → L0025
        ПБ     L0026                    ,переход на L0026
        ПБ     L0015                    ,переход на L0015
        МОДА   TXTRED                   ,мод.адрес +1: TXTRED
        СЧ     TXTRED(М7)               ,СМ := TXTRED(М7)
        МОДА   *RUSIS*                  ,мод.адрес +1: *RUSIS*
        ЗП     TXTRED                   ,TXTRED := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПБ     L0036                    ,переход на L0036
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0040(М7)                ,М7 := L0040
        ЗПМ    5(М7)                    ,ЗП + магазин: 5(М7)
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     TXTRED(М12)              ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     TXTRED(М10)              ,переход через М10

