***************************************************
* IPONUM - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 9408 образа SIPROD.BIN
*   Длина при загрузке: 52 слов, 88 команд
*   Вход: IPONUM
*   Внешние: *NUM*, *SCANER*, *INS*, *PAGE*, *NBR*, ENDKOR, WRIKOR, GOTOPO, 
*   READNB
*   Смещения в *INS*: 24, 25, 26
*   Смещения в *NUM*: 2, 3
*   Смещения в *PAGE*: 1
*   Смещения в *SCANER*: 1, 2
*   Регистры: М7, М10, М12, М15, М16
***************************************************
IPONUM  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0045                    ,переход на L0045
        МОДА   *SCANER*                 ,мод.адрес +1: *SCANER*
        СЧ     IPONUM                   ,СМ := IPONUM
        РЖА    '3'                      ,РЖ := '3'
L0005   МОДА   *INS*+32                 ,мод.адрес +1: *INS*+32
L0006   ВЧ     IPONUM                   ,СМ -= IPONUM
        РЖА    '22'                     ,РЖ := '22'
L0010   ПО     L0005                    ,если СМ=0 → L0005
        ПБ     L0006                    ,переход на L0006
L0012   ПБ     L0044                    ,переход на L0044
        МОДА   IPONUM                   ,мод.адрес +1: IPONUM
        СЧ     1(М7)                    ,СМ := 1(М7)
        МОДА   *NBR*                    ,мод.адрес +1: *NBR*
        ЗП     IPONUM                   ,IPONUM := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0021   ПВ     READNB(М15)              ,вызов через М15
        СЧ     IPONUM(М7)               ,СМ := IPONUM(М7)
L0023   МОДА   *NBR*                    ,мод.адрес +1: *NBR*
        ЗП     IPONUM                   ,IPONUM := СМ
        РЖА    '3'                      ,РЖ := '3'
        МОДА   *PAGE*+1                 ,мод.адрес +1: *PAGE*+1
        СЧ     IPONUM                   ,СМ := IPONUM
        МОДА   *NUM*+2                  ,мод.адрес +1: *NUM*+2
        ВЧ     IPONUM                   ,СМ -= IPONUM
        ВЧ     3(М7)                    ,СМ -= 3(М7)
        ЗП     5(М7)                    ,5 := СМ
        СЧ     5(М7)                    ,СМ := 5(М7)
        ВЧОБ   IPONUM                   ,СМ := (адрес) - СМ
        СЛ     IPONUM(М7)               ,СМ += IPONUM(М7)
        РЖА    '22'                     ,РЖ := '22'
        ПО     L0021                    ,если СМ=0 → L0021
        ПБ     L0023                    ,переход на L0023
        СЧ     1(М7)                    ,СМ := 1(М7)
        ЗП     5(М7)                    ,5 := СМ
L0044   РЖА    '3'                      ,РЖ := '3'
L0045   РЖА    '22'                     ,РЖ := '22'
        УИА    L0062(М16)               ,М16 := L0062
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     GOTOPO(М15)              ,вызов через М15
        МОДА   IPONUM                   ,мод.адрес +1: IPONUM
L0052   РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
L0054   УИА    L0054(М16)               ,М16 := L0054
L0055   СЧИМ   М16                      ,стек := М16, СМ := М16
L0056   УИА    L0056(М16)               ,М16 := L0056
L0057   СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0057(М16)               ,М16 := L0057
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0062   ПВ     WRIKOR(М15)              ,вызов через М15
L0063   МОДА   IPONUM                   ,мод.адрес +1: IPONUM
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        СЧ     4(М7)                    ,СМ := 4(М7)
        РЖА    '3'                      ,РЖ := '3'
        МОДА   *NUM*+2                  ,мод.адрес +1: *NUM*+2
        ВЧ     IPONUM                   ,СМ -= IPONUM
        СЛ     L0001(М7)                ,СМ += L0001(М7)
        ЗП     6(М7)                    ,6 := СМ
        УИА    *NUM*(М16)               ,М16 := *NUM*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0063(М16)               ,М16 := L0063
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *NUM*+2(М16)             ,М16 := *NUM*+2
        СЧИМ   М16                      ,стек := М16, СМ := М16
        РЖА    '22'                     ,РЖ := '22'
        ПВ     WRIKOR(М15)              ,вызов через М15
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПВ     ENDKOR(М15)              ,вызов через М15
        МОДА   IPONUM                   ,мод.адрес +1: IPONUM
        ПБ     L0052                    ,переход на L0052
        МОДА   IPONUM                   ,мод.адрес +1: IPONUM
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0055(М7)                ,М7 := L0055
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     IPONUM(М12)              ,переход через М12
        МОДА   IPONUM                   ,мод.адрес +1: IPONUM
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     IPONUM(М10)              ,переход через М10

