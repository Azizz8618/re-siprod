***************************************************
* PAPAPR - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 9504 образа SIPROD.BIN
*   Длина при загрузке: 34 слов, 54 команд
*   Вход: PAPAPR
*   Внешние: *COMCON*, *EGO*, *INS*, *NUST*, *RUSIS*, PAPRAP, RMAKR, 
*   I*MU*I
*   Смещения в *COMCON*: 19, 20
*   Смещения в *EGO*: 7200, 8600, 8601
*   Смещения в *INS*: 24, 25, 26
*   Регистры: М1, М7, М10, М12, М15, М16
***************************************************
PAPAPR  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0023                    ,переход на L0023
        МОДА   *EGO*+20630              ,мод.адрес +1: *EGO*+20630
        СЧ     PAPAPR                   ,СМ := PAPAPR
        УИА    *COMCON*+24(М16)         ,М16 := *COMCON*+24
        ПВ     I*MU*I(М15)              ,вызов через М15
L0006   РЖА    '3'                      ,РЖ := '3'
        СЛ     PAPAPR(М7)               ,СМ += PAPAPR(М7)
L0010   ЗП     4(М7)                    ,4 := СМ
        ЗП     5(М7)                    ,5 := СМ
L0012   РЖА    '22'                     ,РЖ := '22'
        ПБ     L0014                    ,переход на L0014
L0014   СЧ     '4020'(М7)               ,СМ := '4020'(М7)
        МОД    L0041                    ,мод.адрес по коду: L0041
        УИА    PAPAPR(М1)               ,М1 := PAPAPR
        МОДА   СИМ21(М1)                ,мод.адрес +1: СИМ21(М1)
        ЗП     PAPAPR                   ,PAPAPR := СМ
        МОДА   PAPAPR                   ,мод.адрес +1: PAPAPR
        СЧ     5(М7)                    ,СМ := 5(М7)
L0023   РЖА    '3'                      ,РЖ := '3'
        СЛ     PAPAPR(М7)               ,СМ += PAPAPR(М7)
        ЗП     5(М7)                    ,5 := СМ
        РЖА    '22'                     ,РЖ := '22'
        МОДА   PAPAPR                   ,мод.адрес +1: PAPAPR
L0030   ВЧОБ   3(М7)                    ,СМ := (адрес) - СМ
        ПО     L0006                    ,если СМ=0 → L0006
        УИА    L0035(М16)               ,М16 := L0035
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0034   ПВ     RMAKR(М15)               ,вызов через М15
L0035   МОДА   PAPAPR                   ,мод.адрес +1: PAPAPR
L0036   УИА    L0036(М16)               ,М16 := L0036
        СЧИМ   М16                      ,стек := М16, СМ := М16
L0040   ПВ     RMAKR(М15)               ,вызов через М15
L0041   МОДА   PAPAPR                   ,мод.адрес +1: PAPAPR
        ПВ     PAPRAP(М15)              ,вызов через М15
        МОДА   PAPAPR                   ,мод.адрес +1: PAPAPR
        ПБ     L0030                    ,переход на L0030
        МОДА   PAPAPR                   ,мод.адрес +1: PAPAPR
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0034(М7)                ,М7 := L0034
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М1                       ,стек := М1, СМ := М1
        СЧИМ   М10                      ,стек := М10, СМ := М10
L0054   СЧИМ                            ,СЧИ + магазин
L0055   РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     PAPAPR(М12)              ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М1                       ,М1 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     PAPAPR(М10)              ,переход через М10
        МОДА   PAPAPR                   ,мод.адрес +1: PAPAPR

