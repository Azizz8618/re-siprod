***************************************************
* KODKOD - МОДУЛЬ СИПРОДА
*   Источник: личная библиотека (PERSO, зона 2702,
*   том 2248), слово 19776 образа SIPROD.BIN
*   Длина при загрузке: 44 слов, 76 команд
*   Вход: KODKOD
*   Внешние: *NEW*, *NEWST*, SCAKOD, RSYMB
*   Регистры: М1, М7, М10, М12, М15, М16
***************************************************
KODKOD  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0036                    ,переход на L0036
        СЧ     KODKOD(М7)               ,СМ := KODKOD(М7)
        МОДА   *NEW*                    ,мод.адрес +1: *NEW*
        ЗП     KODKOD                   ,KODKOD := СМ
L0005   РЖА    '3'                      ,РЖ := '3'
        СЧ     1(М7)                    ,СМ := 1(М7)
L0007   ЗП     4(М7)                    ,4 := СМ
L0010   РЖА    '22'                     ,РЖ := '22'
        МОДА   KODKOD                   ,мод.адрес +1: KODKOD
L0012   СЧ     1(М7)                    ,СМ := 1(М7)
        ЗП     5(М7)                    ,5 := СМ
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        МОД    L0052                    ,мод.адрес по коду: L0052
        УИА    KODKOD(М1)               ,М1 := KODKOD
        МОДА   *NEWST*+77777(М1)        ,мод.адрес +1: *NEWST*+7777
        УИА    KODKOD(М16)              ,М16 := KODKOD
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0053(М16)               ,М16 := L0053
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    *NEW*(М16)               ,М16 := *NEW*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0050(М16)               ,М16 := L0050
        СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     RSYMB(М15)               ,вызов через М15
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '22'                     ,РЖ := '22'
        ПВ     SCAKOD(М15)              ,вызов через М15
        МОДА   KODKOD                   ,мод.адрес +1: KODKOD
L0036   УИА    *NEW*(М16)               ,М16 := *NEW*
        СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0050(М16)               ,М16 := L0050
        СЧИМ   М16                      ,стек := М16, СМ := М16
        МОД    L0052                    ,мод.адрес по коду: L0052
L0043   УИА    KODKOD(М1)               ,М1 := KODKOD
        МОДА   *NEWST*+77777(М1)        ,мод.адрес +1: *NEWST*+7777
        УИА    KODKOD(М16)              ,М16 := KODKOD
L0046   СЧИМ   М16                      ,стек := М16, СМ := М16
        УИА    L0053(М16)               ,М16 := L0053
L0050   СЧИМ   М16                      ,стек := М16, СМ := М16
        ПВ     RSYMB(М15)               ,вызов через М15
L0052   РЖА    '3'                      ,РЖ := '3'
L0053   РЖА    '22'                     ,РЖ := '22'
        СЧ     5(М7)                    ,СМ := 5(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     L0001(М7)                ,СМ += L0001(М7)
        ЗП     5(М7)                    ,5 := СМ
        ВЧОБ   2(М7)                    ,СМ := (адрес) - СМ
        РЖА    '22'                     ,РЖ := '22'
        ПО     L0007                    ,если СМ=0 → L0007
        МОДА   KODKOD                   ,мод.адрес +1: KODKOD
        СЧ     4(М7)                    ,СМ := 4(М7)
        РЖА    '3'                      ,РЖ := '3'
        СЛ     L0001(М7)                ,СМ += L0001(М7)
        ЗП     4(М7)                    ,4 := СМ
        ВЧОБ   3(М7)                    ,СМ := (адрес) - СМ
        РЖА    '22'                     ,РЖ := '22'
        ПО     L0005                    ,если СМ=0 → L0005
        ПБ     L0043                    ,переход на L0043
        УИИ    М10(М7)                  ,М10 := М7
        УИИ    М12(М16)                 ,М12 := М16
        УИА    L0046(М7)                ,М7 := L0046
        СЧИМ   М15                      ,стек := М15, СМ := М15
        СЧИМ   М1                       ,стек := М1, СМ := М1
        СЧИМ   М10                      ,стек := М10, СМ := М10
        СЧИМ                            ,СЧИ + магазин
        РЖА    '3'                      ,РЖ := '3'
        РЖА    '2'                      ,РЖ := '2'
        ПБ     KODKOD(М12)              ,переход через М12
        УИМ                             ,УИ + магазин
        УИМ    М7                       ,М7 := СМ + стек
        УИМ    М1                       ,М1 := СМ + стек
        УИМ    М10                      ,М10 := СМ + стек
        ПБ     KODKOD(М10)              ,переход через М10
        МОДА   KODKOD                   ,мод.адрес +1: KODKOD

