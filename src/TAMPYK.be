*   Регистры: М7, М10, М12, М15, М16, М17
***************************************************
TAMPYK  СТАРТ  0
        УИА    L0001(М16)               ,М16 := L0001
L0001   ПБ     L0050                    ,переход на L0050
        СЧ     TAMPYK(М7)               ,СМ := TAMPYK(М7)
