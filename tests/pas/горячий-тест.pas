(* Тест кодогенерации горячих мест редактора: посчитать команды.
   1) копия неупакованной строки (sv := r)
   2) запись непробельных литер в упакованную строку
   3) чтение упакованной строки в распакованную
   4) извлечение 6 литер слова машинной вставкой (besm): АТI + АСН + ААХ
   5) постройка множества для посылки Э64 *)
(*=Y+*,p+*)
program hot(input, output);
type
  rowty = array [1..128] of char;
  prow = packed array [1..128] of char;
  слово = record case integer of
    0: (ц: integer);
    1: (м: set of 0..47)
  end;
var
  r, sv: rowty;
  h: array [1..66] of prow;
  i, k, n: integer;
  c1, c2, c3, c4, c5, c6: char;
  сл: слово;
  маска, сл2: слово;
  пробелы: prow;
  падр: ^слово;
begin
  i := 1;
  маска.м := [0..5];
  (* 1) копия неупакованной строки *)
  for k := 1 to 128 do sv[k] := r[k];
  (* 2) запись непробельных литер в упакованную строку *)
  for k := 1 to 128 do
    if r[k] <> ' ' then h[i][k] := r[k];
  (* 3) чтение упакованной строки в распакованную *)
  for k := 1 to 128 do r[k] := h[i][k];
  (* 4) извлечение литер слова машинной вставкой:
     сл в М6 (АТI), сдвиги АСН, маска ААХ через М7, забор А *)
  сл.м := сл.м;
  падр := REF(маска);
  besm(00400006B);
  besm(70600000B);
  besm(00360026B);
  сл.ц := ;
  besm(70600000B);
  besm(00110006B);
  c1 := chr(сл.ц mod 64);
  besm(00360152B);
  сл.ц := ;
  besm(70600000B);
  besm(00110006B);
  c2 := chr(сл.ц mod 64);
  (* 5) постройка множества посылки Э64 (как в прогоне) *)
  сл2.м := [0..2,22,24..26,46];
  (* 6) присваивание упакованной строки целиком (заливка пробелами) *)
  h[2] := пробелы;
  (* 7) поэлементная заливка упакованной строки *)
  for k := 1 to 128 do h[3][k] := ' ';
  (* 8) присваивание неупакованной строки целиком *)
  sv := r;
  writeln(n, c1:1, c2:1)
end.
