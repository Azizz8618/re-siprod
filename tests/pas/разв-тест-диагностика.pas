(*=l2*)
(* Пошаговая диагностика вставок: что делает каждая команда. *)
program рпт2(input, output);
type
  слово = record case integer of
    0: (ц: integer);
    1: (м: set of 0..47)
  end;
var
  сл: слово;
  маска: слово;
  рбyф: array [1..2] of integer;
  падр: ^слово;
  v: integer;
begin
  (* 0: представление слова из множества *)
  сл.м := [40..47];
  writeln('маска[40..47].ц=', сл.ц);
  маска.м := [40..47];
  (* 1: АТI + СЧ + АТХ без обработки: слово маски через машину *)
  v := 0;
  рбyф[1] := 777;
  падр := REF(маска);
  besm(00000400003B);              (* АТI3: М3 := адрес маски *)
  падр := REF(рбyф[1]);
  besm(00000400004B);              (* АТI4: М4 := адрес буфера *)
  besm(00014100000B);              (* СЧ М3: А := слово маски *)
  besm(00020000000B);              (* ЗП (М4): буфер[1] := А *)
  writeln('1: буфер=', рбyф[1], ' (ждём ', маска.ц, ')');
  (* 2: сдвиг АСН 104 от константы *)
  сл.м := [];
  сл.м := [0..47];                 (* слово = 2^48-1 *)
  v := сл.ц;
  writeln('2a: слово всех единиц ц=', v);
  рбyф[1] := 0;
  падр := REF(сл);
  besm(00000400003B);              (* М3 := адрес сл *)
  besm(00014100000B);              (* А := сл *)
  besm(00000360150B);              (* АСН 104: >>40 *)
  besm(00020000000B);              (* буфер[1] := А *)
  writeln('2b: >>40 =', рбyф[1], ' (ждём 255)');
  (* 3: ААХ М2 *)
  рбyф[1] := 0;
  сл.м := [0..47];
  падр := REF(сл);
  besm(00000400003B);
  besm(00014100000B);
  besm(00000360150B);
  besm(00010110000B);              (* ААХ М2: А := А И маска *)
  besm(00020000000B);
  writeln('3: >>40 И маска =', рбyф[1], ' (ждём 255)');
  (* 4: то же с чужой маской - видно, жива ли М2 *)
  маска.м := [39..39];             (* бит 47-39=8: маска 0x100 *)
  рбyф[1] := 0;
  сл.м := [0..47];
  падр := REF(сл);
  besm(00000400003B);
  besm(00014100000B);
  besm(00000360150B);
  besm(00010110000B);
  besm(00020000000B);
  writeln('4: с маской[39] =', рбyф[1], ' (256, если М2 жива)')
end.
